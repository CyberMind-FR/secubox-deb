{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(.venv/bin/ruff format --check *)",
      "Bash(shellcheck *)",
      "Bash(sh -n *)",
      "Bash(bash -n *)",
      "Bash(lintian *)",
      "Bash(go test -mod=vendor *)",
      "Bash(go vet -mod=vendor *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh issue close *)",
      "Bash(gh pr merge *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sshpass *)",
      "Read(//etc/secubox/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(//etc/secubox/secrets/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
