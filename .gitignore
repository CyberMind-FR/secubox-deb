*.swp
*.swo
*~
.wiki/
*.egg-info/

# Tow-Boot (Nix build artifacts)
tools/Tow-Boot/result
tools/Tow-Boot/output/

# Kernel build (ignore outputs, keep docs and patches)
kernel-build/*
!kernel-build/README.md
!kernel-build/patches/
!kernel-build/build-kernel.sh
backups/*.img.xz

# APT staging artifacts (regenerated by scripts/stage-apt-repo.sh)
/output/repo/db/
/output/repo/pool/
/output/repo/dists/
/output/repo/gpg/
/output/repo/conf/
/output/test-chroot/
/output/manifests/
/output/chroot-update.log
/output/build.log

# MetaBlogizer ingest artifacts (regenerated each run)
/output/ingest-report.json
/output/ingest-full.log
/output/ingest-full-run.out
/output/broken-repos.txt
/output/test-ingest-*/

# Streamlit ingest artifacts (regenerated each run)
/output/streamlit-ingest-report.json
/output/streamlit-ingest.log
/output/streamlit-ingest-full.out
/output/broken-streamlit-repos.txt

# MetaBlogizer site backfill artifacts (regenerated each run)
/output/metablog-backfill-report.json
/output/metablog-backfill.log
.superpowers/sdd/
packages/*/debian/*.postinst.debhelper

# Caches de construction Go — jamais dans le dépôt.
# Ils y étaient : 556 Mo et 14 895 fichiers suivis, recopiés dans CHAQUE
# worktree, au point de saturer le disque et d'empêcher d'en créer un nouveau.
# Ce sont des artefacts reproductibles, pas du code.
packages/*/.gopath/
packages/*/.gocache/
# Binaires construits déposés dans debian/ par dpkg-buildpackage.
packages/*/debian/secubox-*d
img/

# Go build artifacts (secubox-toolbox-ng) — binaries are built by debian/rules
/packages/secubox-toolbox-ng/sbxdpi
/packages/secubox-toolbox-ng/sbxmitm
/packages/secubox-toolbox-ng/sbx-sentinel
/packages/secubox-toolbox-ng/sbx-authwatch
/packages/secubox-toolbox-ng/_gocache/
/packages/secubox-toolbox-ng/_gopath/
