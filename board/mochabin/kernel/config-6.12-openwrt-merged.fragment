# SecuBox MOCHAbin Kernel Config Fragment
# Based on OpenWrt MVEBU/Cortex-A72 + Debian systemd compatibility
# Target: Marvell Armada 7040 (MOCHAbin)
# 
# Usage: 
#   cd /path/to/linux-6.12.x
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m .config THIS_FILE
#   make ARCH=arm64 olddefconfig
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j$(nproc)

#=============================================================================
# ARCHITECTURE - ARM64 Cortex-A72
#=============================================================================
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_VA_BITS=39
CONFIG_ARM64_PA_BITS_48=y
CONFIG_ARM64_PA_BITS=48
CONFIG_CPU_LITTLE_ENDIAN=y

#=============================================================================
# MARVELL ARMADA 8K / 7040 PLATFORM (from OpenWrt cortexa72)
#=============================================================================
CONFIG_ARCH_MVEBU=y
CONFIG_ARMADA_AP806_SYSCON=y
CONFIG_ARMADA_AP_CPU_CLK=y
CONFIG_ARMADA_AP_CP_HELPER=y
CONFIG_ARMADA_CP110_SYSCON=y
CONFIG_ARMADA_37XX_CLK=y

# GIC (Interrupt Controller)
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_ARM_GIC_V3_ITS_PCI=y
CONFIG_ARM_GIC_V2M=y
CONFIG_MVEBU_GICP=y
CONFIG_MVEBU_ICU=y
CONFIG_MVEBU_ODMI=y
CONFIG_MVEBU_PIC=y
CONFIG_MVEBU_SEI=y

# CPU Frequency
CONFIG_ARM_ARMADA_8K_CPUFREQ=y

# Timer
CONFIG_ARM_ARCH_TIMER=y

# Pin Control
CONFIG_PINCTRL_ARMADA_37XX=y
CONFIG_PINCTRL_ARMADA_AP806=y
CONFIG_PINCTRL_ARMADA_CP110=y
CONFIG_GENERIC_PINCONF=y

#=============================================================================
# BOOT CRITICAL - STORAGE (must be =y for root mount)
#=============================================================================
# eMMC/SD (MOCHAbin boot device)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_XENON=y

# SATA (WD Blue connected)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_AHCI_MVEBU=y
CONFIG_BLK_DEV_SD=y

# USB Storage
CONFIG_USB_STORAGE=y

#=============================================================================
# BOOT CRITICAL - FILESYSTEMS (must be =y)
#=============================================================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

#=============================================================================
# BOOT CRITICAL - PHY DRIVERS (must be =y to avoid deferred probe)
#=============================================================================
CONFIG_PHY_MVEBU_CP110_COMPHY=y
CONFIG_PHY_MVEBU_CP110_UTMI=y
CONFIG_GENERIC_PHY=y

#=============================================================================
# NETWORK - ETHERNET (from OpenWrt - built-in)
#=============================================================================
# Marvell PPv2 (eth0/eth1/eth2)
CONFIG_MVPP2=y
CONFIG_MVMDIO=y
CONFIG_PHYLINK=y
CONFIG_LIBPHY=y
CONFIG_FIXED_PHY=y
CONFIG_OF_MDIO=y
CONFIG_MDIO_BUS=y
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_DEVRES=y
CONFIG_FWNODE_MDIO=y
CONFIG_ACPI_MDIO=y
CONFIG_MDIO_I2C=y

# PHYs
CONFIG_MARVELL_PHY=y
CONFIG_MARVELL_10G_PHY=y
CONFIG_AQUANTIA_PHY=y

#=============================================================================
# NETWORK - DSA SWITCH (from OpenWrt - built-in!)
#=============================================================================
CONFIG_NET_DSA=y
CONFIG_NET_DSA_TAG_DSA_COMMON=y
CONFIG_NET_DSA_TAG_DSA=y
CONFIG_NET_DSA_TAG_EDSA=y
CONFIG_NET_DSA_MV88E6XXX=y
CONFIG_NET_SWITCHDEV=y

# Bridge support for DSA
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_MRP=y
CONFIG_BRIDGE_CFM=y

#=============================================================================
# NETWORK - GENERAL
#=============================================================================
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# VLAN
CONFIG_VLAN_8021Q=y
CONFIG_VLAN_8021Q_GVRP=y
CONFIG_VLAN_8021Q_MVRP=y

# Bonding/Team
CONFIG_BONDING=m
CONFIG_NET_TEAM=m

# WireGuard
CONFIG_WIREGUARD=y

#=============================================================================
# USB HOST (MOCHAbin has USB 3.0)
#=============================================================================
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y

#=============================================================================
# PCIe (Armada 8K PCIe controller)
#=============================================================================
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCIE_DW=y
CONFIG_PCIE_DW_HOST=y
CONFIG_PCIE_ARMADA_8K=y
CONFIG_PCI_BRIDGE_EMUL=y

#=============================================================================
# I2C (for SFP, sensors, etc.)
#=============================================================================
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MV64XXX=y
CONFIG_SFP=y

#=============================================================================
# SPI
#=============================================================================
CONFIG_SPI=y
CONFIG_SPI_ARMADA_3700=y
CONFIG_SPI_ORION=y

#=============================================================================
# SERIAL CONSOLE (critical for debug)
#=============================================================================
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

#=============================================================================
# DMA
#=============================================================================
CONFIG_DMADEVICES=y
CONFIG_MV_XOR=y
CONFIG_MV_XOR_V2=y

#=============================================================================
# CLOCK / RESET
#=============================================================================
CONFIG_COMMON_CLK=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_MVEBU_CP110=y

#=============================================================================
# POWER / REGULATOR
#=============================================================================
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_POWER_SUPPLY=y

#=============================================================================
# RTC
#=============================================================================
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_ARMADA38X=y

#=============================================================================
# HWMON / THERMAL
#=============================================================================
CONFIG_HWMON=y
CONFIG_SENSORS_ARMADA_THERMAL=y
CONFIG_THERMAL=y
CONFIG_ARMADA_THERMAL=y

#=============================================================================
# WATCHDOG
#=============================================================================
CONFIG_WATCHDOG=y
CONFIG_ARMADA_37XX_WATCHDOG=y

#=============================================================================
# LED SUPPORT (for status LEDs)
#=============================================================================
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_NETDEV=y

#=============================================================================
# GPIO
#=============================================================================
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_GENERIC=y
CONFIG_GPIO_MVEBU=y

#=============================================================================
# SYSTEMD COMPATIBILITY (Debian requirement)
#=============================================================================
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y

CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

CONFIG_FHANDLE=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y

CONFIG_DMIID=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

CONFIG_SYSFS_DEPRECATED=n
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_UNIX=y
CONFIG_POSIX_MQUEUE=y

CONFIG_AUTOFS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Audit (for security)
CONFIG_AUDIT=y

#=============================================================================
# KERNEL DEBUG / CONFIG (optional but useful)
#=============================================================================
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_MAGIC_SYSRQ=y

#=============================================================================
# CRYPTO (for WireGuard, TLS, etc.)
#=============================================================================
CONFIG_CRYPTO=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CURVE25519=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# Hardware crypto (Marvell CESA)
CONFIG_CRYPTO_DEV_MARVELL_CESA=y

#=============================================================================
# SQUASHFS / OVERLAYFS (for containers)
#=============================================================================
CONFIG_SQUASHFS=m
CONFIG_OVERLAYFS_FS=m

#=============================================================================
# DISABLE UNNECESSARY (reduce attack surface)
#=============================================================================
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set

#=============================================================================
# DEVICE TREE OVERLAYS (for runtime LED/GPIO config)
#=============================================================================
CONFIG_OF_OVERLAY=y
CONFIG_OF_CONFIGFS=y


#=============================================================================
# I2C LED CONTROLLER (IS31FL3199 on MOCHAbin)
#=============================================================================
CONFIG_LEDS_IS31FL319X=y


#=============================================================================
# USB HOST NETWORK (for Eye Remote USB Gadget)
#=============================================================================
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y

