# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Noyau stock Debian 6.12 + chaîne WAN de la MOCHAbin intégrée au noyau (#2004).
#
# POURQUOI. Sur le noyau Debian, les cages SFP de eth0 et eth2 restent en
# « deferred probe pending: wait for supplier …/i2c@701000/pca9554@39 » : le
# contrôleur I2C (I2C_MV64XXX), l'expandeur de broches, le pilote SFP, MDIO_I2C
# et PHYLINK sont des MODULES, chargés trop tard ; eth2 (le WAN) n'obtient jamais
# de porteuse. Les intégrer au noyau rend la séquence de démarrage déterministe.
#
# Le reste de la configuration Debian est conservé tel quel (modules, sécurité).
CONFIG_I2C_MV64XXX=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PCA954x=y
CONFIG_GPIO_PCA953X=y
CONFIG_MDIO_I2C=y
CONFIG_MDIO_BUS_MUX=y
CONFIG_OF_MDIO=y
CONFIG_PHYLINK=y
CONFIG_SFP=y
CONFIG_MARVELL_PHY=y
CONFIG_MARVELL_10G_PHY=y
CONFIG_MVPP2=y
CONFIG_PHY_MVEBU_CP110_COMPHY=y
CONFIG_PHY_MVEBU_CP110_UTMI=y
# Commutateur DSA (ports lan0..lan3) INTEGRE au noyau, comme BRIDGE dont il depend.
# Charge en module, il arrive apres que networkd a ouvert eth2 : mvpp2 bascule alors ses
# tampons (« all ports have a low MTU, switching to per-cpu buffers »), ferme et rouvre
# tous les ports, et le PHY 88E1510 de eth2 est rattache une 2e fois sans jamais
# remonter (constate au boot du 2026-10-05, aucune porteuse pendant 3 min). Integre, le
# commutateur est pret avant userspace : eth2 n'est ouvert qu'une fois.
CONFIG_BRIDGE=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_TAG_DSA=y
CONFIG_NET_DSA_TAG_EDSA=y
CONFIG_NET_DSA_MV88E6XXX=y
# Démarrage de secours sans initrd : eMMC et racine ext4 intégrés.
CONFIG_MMC_SDHCI_XENON=y
CONFIG_MMC_BLOCK=y
CONFIG_EXT4_FS=y
# Conteneurs LXC avec limite de processeur (lxc.cgroup2.cpu.max) : sans cela ils
# refusent de démarrer. Déjà y chez Debian, redit ici pour que ça ne régresse pas.
CONFIG_CFS_BANDWIDTH=y
# Compilation plus rapide et moins gourmande en disque sur le runner.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
