# SecuBox MOCHAbin FULL Built-in Fragment
# Kernel 6.12.85 - Boot-critical drivers for MOCHAbin (Armada 8040)
# Created: 2026-05-07
#
# Usage:
#   ./scripts/kconfig/merge_config.sh -m .config this-fragment
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j$(nproc) Image

# MMC/eMMC (boot device)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_XENON=y

# SATA/AHCI
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_AHCI_MVEBU=y

# SCSI disk (required for /dev/sda block devices)
CONFIG_BLK_DEV_SD=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y

# NLS charsets (required for VFAT mount)
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y

# USB PHY for Marvell CP110
CONFIG_PHY_MVEBU_CP110_UTMI=y
CONFIG_PHY_MVEBU_CP110_COMPHY=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_OF_SIMPLE=y

# Network (mvpp2)
CONFIG_MVPP2=y
CONFIG_MVMDIO=y
CONFIG_PHYLINK=y
CONFIG_FIXED_PHY=y
CONFIG_MARVELL_PHY=y
CONFIG_SFP=y

# DSA Switch (mv88e6xxx)
CONFIG_NET_DSA=y
CONFIG_NET_DSA_MV88E6XXX=y
CONFIG_LLC=y
CONFIG_STP=y
CONFIG_BRIDGE=y

# USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_STORAGE=y

# I2C/LED
CONFIG_I2C_MV64XXX=y
CONFIG_LEDS_IS31FL319X=y
CONFIG_LEDS_CLASS=y

# PCIe
CONFIG_PCI=y
CONFIG_PCIE_ARMADA_8K=y

# GPIO/Pinctrl
CONFIG_GPIO_MVEBU=y
CONFIG_PINCTRL_ARMADA_CP110=y
CONFIG_PINCTRL_ARMADA_AP806=y
