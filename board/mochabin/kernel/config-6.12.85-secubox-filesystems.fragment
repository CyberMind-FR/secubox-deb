# SecuBox — systemes de fichiers des supports externes
#
# POURQUOI CE FRAGMENT EXISTE
#
# Le noyau secubox etait construit a partir de `make ARCH=arm64 defconfig`, qui
# n'active presque aucun systeme de fichiers en dehors de ext4/vfat. Resultat
# constate sur la board le 2026-08-06 : un disque USB Apple (HFS+) branche par
# l'utilisateur etait detecte mais IMPOSSIBLE a monter —
#
#   mount: unknown filesystem type 'hfsplus'
#   modprobe: FATAL: Module hfsplus not found in /lib/modules/6.12.85
#
# Le noyau Debian 6.12.85+deb12-arm64, installe sur la meme machine, les a tous.
# Un appareil dont le role est de recevoir des supports externes ne peut pas
# refuser exFAT (format courant des disques > 32 Go) ni HFS+ ni NTFS.
#
# TOUT EN MODULE (=m), jamais =y : ces pilotes ne servent qu'au branchement d'un
# support, ils n'ont pas a occuper la memoire en permanence sur une machine a
# 4 Go, et un pilote de systeme de fichiers etranger est une surface d'attaque
# qu'on ne charge qu'a la demande.
#
# Reference : issue #995 (module secubox-media).

# ── Supports amovibles courants ─────────────────────────────────────────────
CONFIG_EXFAT_FS=m
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y

# Apple — le cas qui a revele le probleme.
CONFIG_HFS_FS=m
CONFIG_HFSPLUS_FS=m

# ── Optique et images disque ────────────────────────────────────────────────
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m

# ── Autres systemes de fichiers Linux rencontres sur supports externes ──────
CONFIG_F2FS_FS=m
CONFIG_XFS_FS=m
CONFIG_JFS_FS=m
CONFIG_NILFS2_FS=m
CONFIG_EROFS_FS=m

# ── Jeux de caracteres ──────────────────────────────────────────────────────
#
# Sans eux, une etiquette ou un nom de fichier accentue remonte casse — et le
# nom de volume compose un chemin de montage dans mediactl.
CONFIG_NLS_CODEPAGE_850=m
CONFIG_NLS_ISO8859_15=m
CONFIG_NLS_MAC_ROMAN=m

# ── Partage SMB : serveur DANS le noyau (ksmbd) + client CIFS ───────────────
#
# ksmbd sert les fichiers depuis l'espace noyau : pas d'aller-retour vers un
# processus utilisateur a chaque lecture, la ou smbd (Samba) copie les donnees
# entre noyau et espace utilisateur. Sur cette board — 4 coeurs Armada — c'est
# la difference entre saturer le lien et le sous-employer.
#
# ksmbd ne REMPLACE pas Samba : la configuration, les comptes et la decouverte
# restent geres par les outils userspace (`ksmbd-tools`). Seul le service des
# fichiers descend dans le noyau.
#
# SMB1 reste desactive — protocole obsolete et non chiffre, hors de question
# sur une machine visant la CSPN. SMB3 uniquement, avec chiffrement disponible.
CONFIG_SMB_SERVER=m
CONFIG_SMB_SERVER_SMBDIRECT=y
CONFIG_SMB_SERVER_CHECK_CAP_NET_ADMIN=y
CONFIG_SMB_SERVER_KERBEROS5=y

# Client CIFS — monter un partage distant depuis la board.
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=n
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_DFS_UPCALL=y
CONFIG_CIFS_SWN_UPCALL=y
CONFIG_CIFS_FSCACHE=y

# Chiffrement exige par SMB3.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CCM=y
