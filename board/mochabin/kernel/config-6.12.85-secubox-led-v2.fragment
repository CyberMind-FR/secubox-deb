# SecuBox MOCHAbin Kernel Config Fragment
# Apply on top of Debian arm64 config with:
#   scripts/kconfig/merge_config.sh -m .config this-file.fragment
#   make olddefconfig

# === LED Driver (IS31FL3199 on MOCHAbin) ===
CONFIG_LEDS_IS31FL319X=y
CONFIG_LEDS_IS31FL32XX=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# === LED Triggers ===
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_CPU=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_NETDEV=y

# === I2C (for LED controller) ===
CONFIG_I2C_MV64XXX=y
CONFIG_I2C_CHARDEV=y
CONFIG_REGMAP_I2C=y

# === Network (MOCHAbin PPv2.2) ===
CONFIG_MVPP2=y
CONFIG_MVMDIO=y
CONFIG_MVNETA=y
CONFIG_PHYLINK=y
CONFIG_FIXED_PHY=y
CONFIG_MARVELL_PHY=y
CONFIG_SFP=y

# === MMC/eMMC (Xenon controller) ===
CONFIG_MMC_SDHCI_XENON=y

# === GPIO (for LED shutdown pin) ===
CONFIG_GPIO_MVEBU=y
CONFIG_PINCTRL_MVEBU=y
CONFIG_PINCTRL_ARMADA_CP110=y
CONFIG_PINCTRL_ARMADA_AP806=y

# === Debug: /proc/config.gz ===
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# === Built-in for faster boot ===
CONFIG_MDIO_BUS=y
CONFIG_MDIO_DEVICE=y
CONFIG_FWNODE_MDIO=y
