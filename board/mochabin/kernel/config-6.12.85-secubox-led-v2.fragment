# SecuBox MOCHAbin Kernel Config Fragment
# Apply on top of Debian arm64 config with:
#   scripts/kconfig/merge_config.sh -m .config this-file.fragment
#   make olddefconfig

# === LED Driver (IS31FL3199 on MOCHAbin) ===
CONFIG_LEDS_IS31FL319X=y
CONFIG_LEDS_IS31FL32XX=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# === LED Triggers ===
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_CPU=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_NETDEV=y

# === I2C (for LED controller) ===
CONFIG_I2C_MV64XXX=y
CONFIG_I2C_CHARDEV=y
CONFIG_REGMAP_I2C=y

# === Network (MOCHAbin PPv2.2) ===
CONFIG_MVPP2=y
CONFIG_MVMDIO=y
CONFIG_MVNETA=y
CONFIG_PHYLINK=y
CONFIG_FIXED_PHY=y
CONFIG_MARVELL_PHY=y
CONFIG_SFP=y

# === MMC/eMMC (Xenon controller) ===
# Full dependency chain - all must be =y for built-in
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_XENON=y

# === GPIO (for LED shutdown pin) ===
CONFIG_GPIO_MVEBU=y
CONFIG_PINCTRL_MVEBU=y
CONFIG_PINCTRL_ARMADA_CP110=y
CONFIG_PINCTRL_ARMADA_AP806=y

# === Filesystems (must be built-in to boot) ===
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# === DSA Switch (lan0-lan3 ports) ===
# BRIDGE and its dependencies must be built-in for DSA to be built-in
# HSR must be disabled or built-in for DSA to be built-in
CONFIG_LLC=y
CONFIG_STP=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
# CONFIG_HSR is not set
CONFIG_NET_DSA=y
CONFIG_NET_DSA_TAG_DSA_COMMON=y
CONFIG_NET_DSA_TAG_DSA=y
CONFIG_NET_DSA_TAG_EDSA=y
CONFIG_NET_DSA_MV88E6XXX=y

# === USB (XHCI for USB3) ===
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_XHCI_MVEBU=y
CONFIG_USB_STORAGE=y

# === SATA/AHCI ===
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_AHCI_MVEBU=y

# === PCIe ===
CONFIG_PCI=y
CONFIG_PCIE_ARMADA_8K=y

# === Debug: /proc/config.gz ===
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# === Built-in for faster boot ===
CONFIG_MDIO_BUS=y
CONFIG_MDIO_DEVICE=y
CONFIG_FWNODE_MDIO=y
