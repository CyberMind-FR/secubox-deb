#!/bin/bash
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
set -e

# L'utilisateur `secubox` est partagé par tout le parc ; on ne le crée que s'il
# manque, et on ne touche jamais à ses propriétés s'il existe.
if ! getent passwd secubox >/dev/null; then
    adduser --system --group --no-create-home --home /var/lib/secubox secubox
fi
install -d -o secubox -g secubox -m 0750 /var/lib/secubox/gabriel-mood

# Automatically added by dh_installtmpfiles/13.14.1ubuntu5
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -x "$(command -v systemd-tmpfiles)" ]; then
		systemd-tmpfiles ${DPKG_ROOT:+--root="$DPKG_ROOT"} --create gabriel-mood.conf || true
	fi
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.14.1ubuntu5
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	# The following line should be removed in trixie or trixie+1
	deb-systemd-helper unmask 'gabriel-mood.service' >/dev/null || true

	# was-enabled defaults to true, so new installations run enable.
	if deb-systemd-helper --quiet was-enabled 'gabriel-mood.service'; then
		# Enables the unit on first installation, creates new
		# symlinks on upgrades if the unit file has changed.
		deb-systemd-helper enable 'gabriel-mood.service' >/dev/null || true
	else
		# Update the statefile to add new symlinks (if any), which need to be
		# cleaned up on purge. Also remove old symlinks.
		deb-systemd-helper update-state 'gabriel-mood.service' >/dev/null || true
	fi
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.14.1ubuntu5
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			_dh_action=restart
		else
			_dh_action=start
		fi
		deb-systemd-invoke $_dh_action 'gabriel-mood.service' >/dev/null || true
	fi
fi
# End automatically added section


# ── LE VHOST DÉDIÉ ET SA ROUTE ────────────────────────────────────────────
#
# UN SERVICE DÉCLARE SA PROPRE ROUTE, comme il déclare son vhost et son unité.
# Le 421 n'a qu'une cause : sbxwaf reçoit un nom qu'il ne connaît pas, et cette
# table n'appartenait longtemps à aucun paquet.
HOTE=mood.gk2.secubox.in

mkdir -p /etc/nginx/snippets/exposure
if [ ! -f "/etc/nginx/snippets/exposure/$HOTE.conf" ]; then
    cat > "/etc/nginx/snippets/exposure/$HOTE.conf" <<'EXPO'
# Filtre d'exposition de gabriel-mood — OUVERT, à la demande de l'operateur.
# Edite par le module secubox-exposure, qui fait autorite une fois le fichier
# cree : ce contenu n'est que la valeur de depart, et n'est jamais reecrit.
#
# CE QUI REND L'OUVERTURE ACCEPTABLE. La page demande le micro, mais c'est
# CELUI DU VISITEUR, sur SA machine, et son navigateur le lui demande
# explicitement : rien du micro de la box ne circule. Surtout,
# `GET /api/mood` ne rend plus « la session la plus recente » quand aucune
# n'est nommee — sans quoi un passant aurait lu en direct l'humeur de qui
# utilisait la page.
#
# CE QUI RESTE OUVERT, ET QU'IL FAUT SAVOIR : n'importe qui peut ouvrir une
# session et faire travailler la board. Un plafond CPU est pose dans l'unite
# (CPUQuota), mais il n'y a pas d'authentification ici.
#
# Pour refermer : remplacer par les quatre `allow` prives + `deny all`.
allow all;
EXPO
fi

if command -v nginx >/dev/null 2>&1; then
    ln -sf ../sites-available/$HOTE.conf /etc/nginx/sites-enabled/$HOTE.conf
    # La route ne vaut que si nginx accepte la configuration : poser l'une sans
    # l'autre échange un 421 contre un 502, ce qui n'est pas un progrès.
    if nginx -t >/dev/null 2>&1; then
        systemctl reload nginx 2>/dev/null || true
        if command -v secubox-waf-route >/dev/null 2>&1; then
            secubox-waf-route "$HOTE" 9080 || true
        fi
    else
        echo "gabriel-mood : nginx -t a échoué, vhost NON activé" >&2
        rm -f /etc/nginx/sites-enabled/$HOTE.conf
    fi
fi
exit 0
