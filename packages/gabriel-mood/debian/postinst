set -e

# L'utilisateur `secubox` est partagé par tout le parc ; on ne le crée que s'il
# manque, et on ne touche jamais à ses propriétés s'il existe.
if ! getent passwd secubox >/dev/null; then
    adduser --system --group --no-create-home --home /var/lib/secubox secubox
fi
install -d -o secubox -g secubox -m 0750 /var/lib/secubox/gabriel-mood

#DEBHELPER#

# La route nginx n'est utile que si nginx accepte la configuration : recharger
# à l'aveugle propagerait une erreur au lieu de la signaler.
if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
    systemctl reload nginx 2>/dev/null || true
fi
exit 0
