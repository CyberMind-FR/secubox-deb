#!/usr/bin/make -f
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
export DH_VERBOSE = 1
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
GOARCH_amd64 = amd64
GOARCH_arm64 = arm64
GOARCH_armhf = arm
export GOARCH = $(or $(GOARCH_$(DEB_HOST_ARCH)),$(DEB_HOST_ARCH))
# CGO_ENABLED=0 : tout le dépôt se croise vers arm64 sans chaîne C. C'est aussi
# ce qui a décidé la FFT, le VAD et le pitch en Go pur, et ce qui renvoie ONNX
# dans un processus séparé (cf. internal/ser/externe.go).
export CGO_ENABLED = 0
# PAS DE TÉLÉCHARGEMENT DE COMPILATEUR PENDANT LA CONSTRUCTION. Sans cela, une
# dépendance qui exige une version plus récente fait silencieusement récupérer
# toute une chaîne Go dans le GOPATH du paquet — un build qui dépend du réseau,
# et un cache en lecture seule qui fait ensuite échouer `clean`.
export GOTOOLCHAIN = local
export GOFLAGS = -mod=vendor -trimpath
export GOCACHE = $(CURDIR)/.gocache
export GOPATH  = $(CURDIR)/.gopath
VERSION := $(shell dpkg-parsechangelog -S Version | cut -d- -f1)

%:
	dh $@

override_dh_auto_build:
	go vet ./...
	go build -ldflags "-s -w -X main.version=$(VERSION)" -o debian/sbxos-audio-moodd ./cmd/server

override_dh_auto_test:
	if [ "$(GOARCH)" = "$$(go env GOHOSTARCH)" ]; then go test ./...; else \
	  echo "tests ignores : construction croisee vers $(GOARCH)"; fi

override_dh_auto_clean:
	# Le cache de modules est déposé en lecture seule : sans ce chmod, `clean`
	# échoue et le paquet ne se reconstruit plus.
	chmod -R u+w .gocache .gopath 2>/dev/null || true
	rm -rf .gocache .gopath debian/sbxos-audio-moodd

override_dh_auto_install:
	install -D -m 0755 debian/sbxos-audio-moodd \
	  debian/sbxos-audio-mood/usr/sbin/sbxos-audio-moodd
	install -D -m 0644 systemd/sbxos-audio-mood.service \
	  debian/sbxos-audio-mood/lib/systemd/system/sbxos-audio-mood.service
	install -D -m 0644 tmpfiles/sbxos-audio-mood.conf \
	  debian/sbxos-audio-mood/usr/lib/tmpfiles.d/sbxos-audio-mood.conf
	install -D -m 0644 nginx/sbxos-audio-mood.conf \
	  debian/sbxos-audio-mood/etc/nginx/secubox-routes.d/sbxos-audio-mood.conf
	# Vhost dédié : dans sites-available, JAMAIS sites-enabled — nginx y fait
	# un glob, et le `.dpkg-dist` déposé sur un fichier modifié localement y
	# entrerait, faisant refuser TOUTE la configuration. Lien par le postinst.
	install -D -m 0644 nginx/mood.vhost.conf \
	  debian/sbxos-audio-mood/etc/nginx/sites-available/mood.gk2.secubox.in.conf
	install -D -m 0644 debian/secubox.yaml \
	  debian/sbxos-audio-mood/usr/share/secubox/modules.d/sbxos-audio-mood.yaml
	install -D -m 0644 menu.d/54-sbxos-audio-mood.json \
	  debian/sbxos-audio-mood/usr/share/secubox/menu.d/54-sbxos-audio-mood.json
	install -D -m 0644 docs/modules/sbxos-audio-mood.md \
	  debian/sbxos-audio-mood/usr/share/doc/sbxos-audio-mood/sbxos-audio-mood.md
	# LE COCKPIT EST CONSTRUIT EN AMONT (npm/vite), comme secubox-soc-web : la
	# chaîne de construction du paquet n'a pas node, et l'y ajouter ferait
	# dépendre un paquet Go d'un écosystème entier.
	#
	# ET SON ABSENCE ARRÊTE LA CONSTRUCTION (#1335). Il y avait ici un `echo
	# ATTENTION` qui laissait le paquet réussir. `dist/` étant gitignoré — à
	# juste titre, c'est un produit de construction — un worktree neuf ne l'a
	# jamais : la 0.8.0 a donc été livrée avec un répertoire web VIDE, par
	# dessus une installation qui marchait. Résultat sur la board : 403 sur
	# « / » faute d'index, et 500 sur « /micro.html » parce que le repli SPA
	# boucle sur un `/index.html` absent.
	#
	# UN AVERTISSEMENT QUI N'ARRÊTE RIEN N'EST PAS UNE GARDE, c'est une ligne
	# de journal au milieu de plusieurs centaines. Le paquet ANNONCE servir un
	# cockpit — l'option `--www`, la route nginx, la carte du Hall : le livrer
	# vide n'est pas une dégradation gracieuse, c'est une régression muette.
	if [ ! -d dist ] || [ ! -f dist/index.html ] || [ ! -f dist/micro.html ]; then \
	  echo "ERREUR : le cockpit n'est pas construit." >&2; \
	  echo "  dist/index.html et dist/micro.html sont attendus ici." >&2; \
	  echo "  Construire d'abord :  cd packages/sbxos-audio-mood && npm ci && npm run build" >&2; \
	  exit 1; \
	fi
	install -d debian/sbxos-audio-mood/usr/share/secubox/www/sbxos-audio-mood
	cp -r dist/. debian/sbxos-audio-mood/usr/share/secubox/www/sbxos-audio-mood/
	# Panneau d'administration (#1371) : statique, sans étape de construction.
	install -D -m 0644 admin/index.html \
	  debian/sbxos-audio-mood/usr/share/secubox/www/sbxos-audio-mood-admin/index.html
	install -D -m 0644 admin/admin.js \
	  debian/sbxos-audio-mood/usr/share/secubox/www/sbxos-audio-mood-admin/admin.js

override_dh_installsystemd:
	dh_installsystemd --name=sbxos-audio-mood
