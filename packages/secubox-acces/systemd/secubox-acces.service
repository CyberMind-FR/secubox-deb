[Unit]
Description=SecuBox Accès — admission des appareils et ouverture de sessions [#1344]
After=network-online.target secubox-runtime.service
Wants=secubox-runtime.service

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/acces
Environment=PYTHONPATH=/usr/lib/secubox/acces
# Le prefixe `+` execute en root malgre User= : sans lui la ligne echouerait
# quand le socket appartient a un tour precedent.
ExecStartPre=+/bin/rm -f /run/secubox/acces.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/acces.sock --workers 1 --log-level warning
# L'ATTENTE DU SOCKET NE DOIT JAMAIS TUER LE SERVICE.
#
# La première version attendait 15 s puis lançait `chmod`. Sur cette carte à
# charge 38, uvicorn met plus longtemps à ouvrir le socket : le `chmod` échouait
# sur un fichier absent, systemd comptait l'échec du ExecStartPost comme un
# échec de l'unité, tuait un service qui était en train de démarrer
# correctement, et relançait — en boucle. Un garde-fou qui empêche le démarrage
# qu'il surveille est pire que pas de garde-fou.
#
# On attend donc BEAUCOUP plus longtemps, et l'on sort toujours en succès :
# l'absence de socket se verra à l'usage, pas en empêchant le service d'exister.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 600); do [ -S /run/secubox/acces.sock ] && { chmod 660 /run/secubox/acces.sock; break; }; sleep 0.2; done; exit 0'
Restart=on-failure
# Trois secondes suffisaient quand le démarrage prenait une seconde. Sous
# charge, relancer trop vite empile les tentatives et aggrave ce qu'on subit.
RestartSec=15
# La file des demandes est le seul etat : rien d'autre a ecrire.
ReadWritePaths=/var/lib/secubox/acces /run/secubox
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
