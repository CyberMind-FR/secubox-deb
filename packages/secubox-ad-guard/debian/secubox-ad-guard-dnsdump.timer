[Unit]
Description=SecuBox Ad Guard — instantané des réponses d'Unbound, toutes les 5 minutes (#2240)

[Timer]
OnBootSec=4min
OnUnitActiveSec=300s
AccuracySec=15s

[Install]
WantedBy=timers.target
