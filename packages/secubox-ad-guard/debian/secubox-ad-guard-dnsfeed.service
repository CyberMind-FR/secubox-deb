[Unit]
Description=SecuBox Ad Guard — compteurs DNS par appareil depuis le journal d'Unbound (POC DNS AdBlock TV, #1943)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/1943
After=unbound.service
Wants=unbound.service

[Service]
Type=simple
User=secubox
Group=secubox
# Lit le journal d'Unbound (#3446) : sans ce groupe, « No journal files were opened » et redémarrage en boucle sur une box neuve.
SupplementaryGroups=systemd-journal
# SBX TV Privacy est toujours actif (#3674) : le postinst applique puis active ce collecteur à chaque configuration.
ExecStart=/usr/sbin/secubox-adguard-dnsfeed
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/secubox/ad-guard -/run/secubox/ad-guard-tri
# `secubox` appartient au groupe systemd-journal : il lit le journal d'Unbound sans privilège.

[Install]
WantedBy=multi-user.target
