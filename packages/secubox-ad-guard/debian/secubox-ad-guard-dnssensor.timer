[Unit]
Description=SecuBox Ad Guard — capteur DNS d'Actor Intelligence, chaque minute (#2240)

[Timer]
OnBootSec=3min
OnUnitActiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target
