[Unit]
Description=SecuBox Ad Guard — tri Netflix : fermeture des ouvertures et retrait des autorisations échues (#3226)

[Timer]
OnBootSec=2min
# Chaque minute : une ouverture de zone (démarrage d'épisode, 3 min) se referme à l'heure.
OnUnitActiveSec=1min
AccuracySec=5s
Unit=secubox-ad-guard-tri.service

[Install]
WantedBy=timers.target
