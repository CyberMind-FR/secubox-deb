"""
SecuBox-Deb :: secubox-adblock-sync (#740)
CyberMind — https://cybermind.fr

Board-wide DNS ad/tracker sinkhole. Compiles the modular filter-list resource
(secubox_filterlists, shipped by secubox-core) then renders the DNS-blockable domain set as
`local-zone "<domain>." always_nxdomain` lines — so EVERY device on the LAN (not just R3 MITM
clients) gets ads/trackers NXDOMAIN'd at resolve time.

#3205 : the render is DEPOSITED as a source of secubox-dns-listes (secubox-core), which compiles
webfilter, adblock and adult lists into one tagged file, checks, reloads and rolls back as one
transaction. This script no longer touches the resolver or its configuration.

Whitelisted domains are already removed by the compiler. IPs in the operator IP
allowlist are exempted via an Unbound *view* with no local-zones (best effort;
requires `views:` support).

Usage:
  secubox-adblock-sync sync     # compile lists + render + deposit the source
  secubox-adblock-sync disable  # withdraw the source
  secubox-adblock-sync status   # print JSON status

Runs as root (writes /var/lib/secubox/dns-listes/sources). Driven by a weekly
systemd timer and on-demand from the dns-guard WebUI.
"""
from __future__ import annotations

import json
import re
import sys
import time
from pathlib import Path

# #3205 : dépôt de la source ; secubox-dns-listes compile, vérifie, recharge et revient en arrière.
from secubox_unbound import depot as _depot

# ── Locate the shared filter-list resource ────────────────────────────────
# #2863 : secubox_filterlists est livré par secubox-core (comme secubox_unbound) — secubox-toolbox n'est PAS nécessaire (profil minimal). Repli sur l'ancien
# chemin pour un secubox-core plus ancien.
for _p in ("/usr/lib/python3/dist-packages", "/usr/lib/secubox/toolbox", "/usr/lib/secubox/toolbox/lib"):
    if _p not in sys.path:
        sys.path.append(_p)
try:
    import secubox_filterlists as F
except Exception:
    try:
        from secubox_toolbox import filterlists as F
    except Exception as e:  # pragma: no cover
        print(json.dumps({"ok": False, "error": f"filterlists import failed: {e}"}))
        sys.exit(2)

SOURCE = _depot.SOURCES / "95-secubox-adblock.conf"
STATUS = Path("/var/lib/secubox/ad-guard/sinkhole-status.json")
IP_ALLOWLIST = Path("/var/lib/secubox/ad-guard/ip-allowlist.txt")
# DOMAINES EXEMPTÉS (#1819) : ceux dont la BOX ELLE-MÊME a besoin — une liste
# de blocage qui les contient casse un service de la box (db-ip.com bloqué :
# secubox-geoipupdate ne pouvait plus rafraîchir la base ASN). Plus ceux qu'un
# administrateur ajoute, un par ligne.
DOMAIN_ALLOWLIST = Path("/var/lib/secubox/ad-guard/domain-allowlist.txt")
DOMAINES_DE_LA_BOX = ("download.db-ip.com",)
STATE = Path("/var/lib/secubox/ad-guard/sinkhole.enabled")


def _write_status(d: dict) -> None:
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    d["ts"] = int(time.time())
    tmp = STATUS.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=2))
    tmp.replace(STATUS)


def _ip_allowlist() -> list:
    out = []
    if IP_ALLOWLIST.exists():
        for line in IP_ALLOWLIST.read_text().splitlines():
            ip = line.strip()
            if ip and not ip.startswith("#"):
                out.append(ip)
    return out


def _domain_allowlist() -> list:
    out = list(DOMAINES_DE_LA_BOX)
    if DOMAIN_ALLOWLIST.exists():
        for line in DOMAIN_ALLOWLIST.read_text().splitlines():
            d = line.split("#", 1)[0].strip().lower().rstrip(".")
            if d and re.fullmatch(r"[a-z0-9.-]{1,253}", d) and d not in out:
                out.append(d)
    return out


def _render(domains: list) -> str:
    """Render the source. Domains → always_nxdomain. IP allowlist → a view with
    no local-zone (view-first: global zones still apply to those clients)."""
    lines = [
        "# Managed by secubox-adblock-sync (#740). DO NOT EDIT BY HAND.",
        "# Regenerate: secubox-adblock-sync sync",
        "server:",
    ]
    ips = _ip_allowlist()
    if ips:
        # Tag allowlisted clients onto a permissive view.
        for ip in ips:
            lines.append(f'    access-control-view: {ip} sbx-allow')
    exemptes = _domain_allowlist()
    for d in domains:
        if d in exemptes:
            continue                      # même nom, deux local-zone : unbound refuse
        lines.append(f'    local-zone: "{d}." always_nxdomain')
    # Le plus précis l'emporte : un exempté reste résolu même sous un parent bloqué.
    for d in exemptes:
        lines.append(f'    local-zone: "{d}." always_transparent')
    if ips:
        lines.append("")
        lines.append('view:')
        lines.append('    name: "sbx-allow"')
        lines.append('    view-first: yes')
        # empty view → falls through to normal resolution, no local-zones
    return "\n".join(lines) + "\n"


def do_sync(force: bool = False) -> dict:
    stats = F.compile_lists(force=force)
    domains = []
    if F.OUT_DNS.exists():
        domains = [d for d in F.OUT_DNS.read_text().splitlines() if d.strip()]
    if not domains:
        st = {"ok": False, "error": "no domains compiled", "compile": stats}
        _write_status(st)
        return st

    # Dépôt atomique ; secubox-dns-listes.path déclenche la compilation et le rechargement.
    try:
        etat = _depot.deposer_source(SOURCE.name, _render(domains), SOURCE.parent)
    except (_depot.ErreurDepot, OSError) as e:
        st = {"ok": False, "error": str(e), "blocked": len(domains)}
        _write_status(st)
        return st

    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text("1\n")
    st = {"ok": True, "enabled": True, "blocked": len(domains), "ip_allowlist": len(_ip_allowlist()),
          "source": etat, "application": "secubox-dns-listes", "compile": stats}
    _write_status(st)
    return st


def do_disable() -> dict:
    try:
        etat = _depot.retirer_source(SOURCE.name, SOURCE.parent)
    except (_depot.ErreurDepot, OSError) as e:
        st = {"ok": False, "enabled": False, "error": str(e)}
        _write_status(st)
        return st
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text("0\n")
    st = {"ok": True, "enabled": False, "source": etat, "application": "secubox-dns-listes", "error": None}
    _write_status(st)
    return st


def do_status() -> dict:
    if STATUS.exists():
        try:
            return json.loads(STATUS.read_text())
        except Exception:
            pass
    return {"ok": True, "enabled": STATE.exists() and STATE.read_text().strip() == "1",
            "blocked": 0}


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    force = "--force" in sys.argv
    if cmd == "sync":
        st = do_sync(force=force)
    elif cmd == "disable":
        st = do_disable()
    elif cmd == "status":
        st = do_status()
    else:
        print(f"unknown command: {cmd}", file=sys.stderr)
        return 2
    print(json.dumps(st, indent=2))
    return 0 if st.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main())
