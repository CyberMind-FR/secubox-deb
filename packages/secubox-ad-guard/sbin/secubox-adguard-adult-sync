"""
SecuBox-Deb :: secubox-adguard-adult-sync (#2964, suite de #2962)
CyberMind — https://cybermind.fr

Sinkhole DNS DÉDIÉ au contenu adulte, séparé du sinkhole général
(secubox-adblock-sync, #740). Pourquoi un second sinkhole plutôt qu'une
simple entrée dans `ip-allowlist.txt` : celui-ci fait un bypass COMPLET par
vue Unbound (pubs/trackers compris) — trop large pour « cet appareil garde
le filtrage normal, seuls les domaines adultes lui restent ouverts ».

Exception PAR DOMAINE ET PAR IP via `local-zone-override` (#2969), jamais
une `view:` Unbound : une vue redéclarant tout le sinkhole général pour
chaque IP exemptée a fait grossir le drop-in à 49 Mo sur gk2, avec un
rechargement d'~1 min qui a laissé DNS indisponible pour tout le réseau.
`local-zone-override` cible UN domaine pour UNE IP, sans dupliquer le
reste — l'appareil reste filtré pubs/trackers (il n'est inscrit nulle part
ailleurs), seuls les domaines adultes lui sont ouverts.

Ne modifie JAMAIS `secubox_filterlists` (bibliothèque commune, utilisée
aussi par ad_ghost MITM) : source et compilation sont propres à ce script.

Usage:
  secubox-adguard-adult-sync sync     # fetch + compile + render + reload
  secubox-adguard-adult-sync disable  # drop the drop-in + reload
  secubox-adguard-adult-sync status   # print JSON status

Runs as root (writes /etc/unbound, reloads the resolver).
"""
from __future__ import annotations

import json
import re
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

import secubox_unbound as _unbound

# Importé en lecture seule : la liste générale déjà compilée par
# secubox-adblock-sync (#740), pour savoir quels domaines adultes sont DÉJÀ
# bloqués (éviter un doublon de `local-zone`, qu'Unbound refuse) et pour
# redéclarer le sinkhole général dans la vue d'exception.
for _p in ("/usr/lib/python3/dist-packages", "/usr/lib/secubox/toolbox", "/usr/lib/secubox/toolbox/lib"):
    if _p not in sys.path:
        sys.path.append(_p)
try:
    import secubox_filterlists as _F
    GENERAL_DNS = _F.OUT_DNS
except Exception:  # pragma: no cover — absent en profil minimal sans ad-guard général
    GENERAL_DNS = Path("/var/lib/secubox/filterlists/dns-domains.txt")

# Liste NSFW dédiée, maintenue séparément du reste (StevenBlack, variante
# « porn-only » — un seul fichier hosts, pas de parsing supplémentaire).
SOURCE_URL = "https://raw.githubusercontent.com/StevenBlack/hosts/master/alternates/porn-only/hosts"
CACHE_TTL = 6 * 3600

DATA_DIR = Path("/var/lib/secubox/ad-guard")
CACHE = DATA_DIR / "adult-source-cache.txt"
ADULT_DOMAINS = DATA_DIR / "adult-domains.txt"
EXEMPT_IP = DATA_DIR / "adult-exempt-ip.txt"
# Identifiant STABLE (#2967) : les extensions de confidentialité IPv6 (RFC
# 4941) font tourner l'adresse source d'un appareil environ chaque jour —
# une IP figée dans adult-exempt-ip.txt tombe en panne à la rotation
# suivante (constaté sur gk2 le 2026-10-19, chaturbate.com resté bloqué
# malgré l'IPv4 exemptée : la requête partait d'une IPv6 temporaire). La
# MAC, elle, ne change pas ; on résout ses adresses COURANTES (IPv4 ET
# IPv6, table de voisinage du noyau) à chaque synchronisation.
EXEMPT_MAC = DATA_DIR / "adult-exempt-mac.txt"
DROPIN = Path("/etc/unbound/unbound.conf.d/96-secubox-adult.conf")
UNBOUND_CONF = Path("/etc/unbound/unbound.conf")
STATUS = DATA_DIR / "adult-sinkhole-status.json"
STATE = DATA_DIR / "adult-sinkhole.enabled"

_DOMAIN_RE = re.compile(r"^(?!-)[a-z0-9-]{1,63}(?<!-)(\.[a-z0-9-]{1,63})+$")


def _valid_domain(d: str) -> bool:
    d = d.strip().lower().rstrip(".")
    return bool(d) and len(d) <= 253 and " " not in d and bool(_DOMAIN_RE.match(d))


def parse_hosts(text: str) -> set[str]:
    """Format hosts : ``0.0.0.0 domaine`` / ``127.0.0.1 domaine``."""
    out: set[str] = set()
    for line in text.splitlines():
        line = line.strip()
        if not line or line[0] in "#!":
            continue
        parts = line.split()
        if len(parts) >= 2 and parts[0] in ("0.0.0.0", "127.0.0.1", "::"):
            cand = parts[1].strip().lower()
            if cand not in ("localhost", "localhost.localdomain") and _valid_domain(cand):
                out.add(cand)
    return out


def _write_status(d: dict) -> None:
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    d["ts"] = int(time.time())
    tmp = STATUS.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=2))
    tmp.replace(STATUS)


def _fetch(force: bool = False) -> str | None:
    if not force and CACHE.exists() and (time.time() - CACHE.stat().st_mtime) < CACHE_TTL:
        return CACHE.read_text(encoding="utf-8", errors="replace")
    try:
        req = urllib.request.Request(SOURCE_URL, headers={"User-Agent": "SecuBox-Deb/adult-sync"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = resp.read().decode("utf-8", errors="replace")
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(data, encoding="utf-8")
        return data
    except Exception:
        if CACHE.exists():
            return CACHE.read_text(encoding="utf-8", errors="replace")
        return None


def _general_domains() -> set[str]:
    if GENERAL_DNS.exists():
        return {d.strip() for d in GENERAL_DNS.read_text().splitlines() if d.strip()}
    return set()


def _exempt_macs() -> list[str]:
    out = []
    if EXEMPT_MAC.exists():
        for line in EXEMPT_MAC.read_text().splitlines():
            mac = line.split("#", 1)[0].strip().lower()
            if mac:
                out.append(mac)
    return out


_MAC_RE = re.compile(r"^[0-9a-f]{2}(:[0-9a-f]{2}){5}$")


def _voisinage_brut() -> str:
    """La table de voisinage du noyau (ARP + NDP), IPv4 et IPv6 en un seul
    texte. Un appel système absent ou en échec rend une chaîne vide — on ne
    lève jamais ici, une MAC introuvable est juste ignorée."""
    sortie = ""
    for args in (["ip", "-4", "neigh", "show"], ["ip", "-6", "neigh", "show"]):
        try:
            r = subprocess.run(args, capture_output=True, text=True, timeout=10, check=False)
            sortie += r.stdout
        except (OSError, subprocess.TimeoutExpired):
            pass
    return sortie


def _parse_voisinage(texte: str) -> dict[str, set[str]]:
    """`ip neigh show` → {mac: {ip, ...}}. Ignore les liens locaux (fe80::,
    inutiles comme source DNS LAN) et les entrées sans `lladdr` (FAILED)."""
    out: dict[str, set[str]] = {}
    for line in texte.splitlines():
        parts = line.split()
        if not parts or parts[0].startswith("fe80:"):
            continue
        ip = parts[0]
        if "lladdr" not in parts:
            continue
        mac = parts[parts.index("lladdr") + 1].lower()
        if not _MAC_RE.match(mac):
            continue
        out.setdefault(mac, set()).add(ip)
    return out


def _ips_des_macs(macs: list[str], lire=None) -> list[str]:
    # `lire` se résout au nom, pas par défaut lié à la définition : un test
    # qui remplace `m._voisinage_brut` doit être pris en compte sans devoir
    # aussi patcher cette fonction-ci.
    if not macs:
        return []
    voisinage = _parse_voisinage((lire or _voisinage_brut)())
    out: set[str] = set()
    for mac in macs:
        out |= voisinage.get(mac.lower(), set())
    return sorted(out)


def _exempt_ips() -> list[str]:
    out = []
    if EXEMPT_IP.exists():
        for line in EXEMPT_IP.read_text().splitlines():
            ip = line.split("#", 1)[0].strip()
            if ip:
                out.append(ip)
    out.extend(_ips_des_macs(_exempt_macs()))
    # Dédoublonne en gardant l'ordre (une IP figée ET résolue par MAC ne
    # doit pas produire deux `access-control-view` pour le même nom).
    vus: set[str] = set()
    dedup = []
    for ip in out:
        if ip not in vus:
            vus.add(ip)
            dedup.append(ip)
    return dedup


def _zone_effective(domaine: str, zones: set[str]) -> str:
    """La zone qu'Unbound consulte RÉELLEMENT pour `domaine` (#2973) : une
    `local-zone` couvre tout son sous-arbre — `chaturbate.com.` en
    always_nxdomain bloque AUSSI `www.chaturbate.com.` sans déclaration
    propre. Constaté en direct sur gk2 (log Unbound) : la requête
    `www.chaturbate.com.` matche la zone `chaturbate.com.`, jamais un
    `local-zone-override` posé sur `www.chaturbate.com.` lui-même — ce nom
    n'est simplement jamais consulté. On cherche donc le suffixe le PLUS
    COURT (l'ancêtre le plus haut) déjà présent dans `zones` — Unbound
    retient celui-là pour toute la branche, même quand un nom plus précis a
    AUSSI sa propre déclaration (constaté : chaturbate.com ET
    www.chaturbate.com étaient tous deux déclarés, Unbound n'a consulté que
    chaturbate.com). Jamais le TLD seul (une étiquette) ; à défaut
    d'ancêtre déclaré, le nom reste sa propre zone."""
    etiquettes = domaine.split(".")
    for i in range(len(etiquettes) - 1, -1, -1):
        candidat = ".".join(etiquettes[i:])
        if len(etiquettes) - i >= 2 and candidat in zones:
            return candidat
    return domaine


def _render(adult: set[str], general: set[str]) -> str:
    """Rend le drop-in Unbound. `adult` → always_nxdomain pour tout le monde
    (sauf ce que le sinkhole général bloque déjà — un seul `local-zone` par
    nom, Unbound refuse les doublons).

    Par IP exemptée : une `view:` PARTAGÉE avec `view-first: yes` (#2976,
    reprend le motif déjà éprouvé par le moteur TV auto, #1954/#1959) —
    PAS `local-zone-override` dupliqué par IP (#2969/#2971/#2973 : fichier
    monté à 26 Mo rien que pour 5 adresses, rechargement lent). Avec
    `view-first: yes`, un domaine ABSENT de la vue retombe automatiquement
    sur le puits général — nul besoin de le redéclarer dans la vue (l'ERREUR
    de #2969, qui redéclarait `général - adulte` en pure perte). La vue ne
    contient donc QUE les domaines adultes, déclarés UNE SEULE FOIS (jamais
    par IP) : fichier proportionnel aux domaines adultes, pas à (domaines ×
    IP exemptées). Zone EFFECTIVE (#2973) : pas le nom exact du domaine, qui
    peut n'être jamais consulté si un ancêtre couvre déjà son sous-arbre."""
    lines = [
        "# Managed by secubox-adguard-adult-sync (#2964, #2976). DO NOT EDIT BY HAND.",
        "# Regenerate: secubox-adguard-adult-sync sync",
        "server:",
    ]
    nouveaux = sorted(adult - general)
    for d in nouveaux:
        lines.append(f'    local-zone: "{d}." always_nxdomain')

    ips = _exempt_ips()
    if ips:
        tous = general | adult
        zones_effectives = sorted({_zone_effective(d, tous) for d in adult})
        for ip in ips:
            lines.append(f"    access-control-view: {ip} sbx-adult-allow")
        lines.append("")
        lines.append("view:")
        lines.append('    name: "sbx-adult-allow"')
        lines.append("    view-first: yes")
        for zone in zones_effectives:
            lines.append(f'    local-zone: "{zone}." always_transparent')
    return "\n".join(lines) + "\n"


# Combien de temps attendre, après `unbound-control reload`, que le
# service repasse réellement « active » (#2969). `unbound-control reload`
# rend la main dès que le signal est accepté, PAS quand le rechargement est
# terminé — avec un gros drop-in, Unbound reste en `reloading` une bonne
# minute, DNS indisponible le temps que ça dure. Ne pas attendre fait
# croire « reloaded: true » alors que le service est encore en train de
# ré-analyser sa config.
_ATTENTE_RECHARGEMENT_S = 90
_PAS_ATTENTE_S = 2


class Systeme(_unbound.SystemeUnbound):
    MODULE = "adguard-adult-sync"
    ERREUR = RuntimeError

    def verifier_unbound(self):
        return _unbound.commande(["unbound-checkconf", str(UNBOUND_CONF)], 300)

    def recharger_unbound(self):
        super().recharger_unbound()
        # `unbound-control reload` rend la main dès le signal accepté : on
        # attend `systemctl is-active` (reload-notify, cf. l'unité) pour
        # confirmer que le service est VRAIMENT repassé actif, pas juste
        # que la commande a été envoyée.
        fin = time.time() + _ATTENTE_RECHARGEMENT_S
        while time.time() < fin:
            ok, sortie = _unbound.commande(["systemctl", "is-active", "unbound"], 10)
            if ok and sortie.strip() == "active":
                return
            time.sleep(_PAS_ATTENTE_S)
        raise self.ERREUR(
            f"unbound n'est pas revenu actif {_ATTENTE_RECHARGEMENT_S}s après le rechargement"
        )


def do_sync(force: bool = False, systeme=None) -> dict:
    s = systeme or Systeme()
    text = _fetch(force=force)
    if text is None:
        st = {"ok": False, "error": "adult source unreachable and no cache"}
        _write_status(st)
        return st
    adult = parse_hosts(text)
    if not adult:
        st = {"ok": False, "error": "no domains parsed from adult source"}
        _write_status(st)
        return st
    ADULT_DOMAINS.parent.mkdir(parents=True, exist_ok=True)
    ADULT_DOMAINS.write_text("\n".join(sorted(adult)) + "\n")

    general = _general_domains()
    try:
        etat = _unbound.poser_vue(DROPIN, _render(adult, general), s)
    except RuntimeError as e:
        st = {"ok": False, "error": str(e), "adult": len(adult)}
        _write_status(st)
        return st

    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text("1\n")
    st = {"ok": True, "enabled": True, "adult": len(adult),
          "exempt_ip": len(_exempt_ips()), "reloaded": etat == "applique"}
    _write_status(st)
    return st


def do_disable(systeme=None) -> dict:
    s = systeme or Systeme()
    try:
        etat = _unbound.retirer_vue(DROPIN, s)
    except RuntimeError as e:
        st = {"ok": False, "enabled": False, "reloaded": False, "error": str(e)}
        _write_status(st)
        return st
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text("0\n")
    st = {"ok": True, "enabled": False, "reloaded": etat == "retire", "error": None}
    _write_status(st)
    return st


def do_status() -> dict:
    if STATUS.exists():
        try:
            return json.loads(STATUS.read_text())
        except Exception:
            pass
    return {"ok": True, "enabled": STATE.exists() and STATE.read_text().strip() == "1", "adult": 0}


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    force = "--force" in sys.argv
    if cmd == "sync":
        st = do_sync(force=force)
    elif cmd == "disable":
        st = do_disable()
    elif cmd == "status":
        st = do_status()
    else:
        print(f"unknown command: {cmd}", file=sys.stderr)
        return 2
    print(json.dumps(st, indent=2))
    return 0 if st.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main())
