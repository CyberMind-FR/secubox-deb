"""SecuBox-Deb :: secubox-adguard-auto — un passage du moteur du mode « auto » du POC DNS AdBlock TV (#1954).

Lancé chaque minute par `secubox-ad-guard-auto.timer`, sous l'utilisateur `secubox`. Sort aussitôt, sans rien faire, si aucun appareil n'est en mode
`auto` : la minuterie ne coûte rien tant que le mode n'est pas utilisé. Il ne touche JAMAIS Unbound : il met à jour `regles.json` puis demande au seul
contrôleur privilégié (`sudo -n secubox-adguard-tv regles-appliquer`, argument exact) d'appliquer la différence.
"""
from __future__ import annotations

import subprocess
import sys
import time
from pathlib import Path

for _p in ("/usr/lib/secubox/ad-guard", str(Path(__file__).resolve().parents[1])):
    if _p not in sys.path:
        sys.path.insert(0, _p)
from api import dnstv, dnstv_auto, dnstv_regles  # noqa: E402

CTL = "/usr/sbin/secubox-adguard-tv"


def classeur() -> dnstv.Classifieur:
    perso = dnstv.DOSSIER_ETAT / "custom.txt"
    return dnstv.Classifieur(dnstv.charger_listes(dnstv.DOSSIER_LISTES, perso if perso.is_file() and not perso.is_symlink() else None))


def main(sudo=None, maintenant=None) -> int:
    etat, erreur = dnstv.lire_etat()
    if erreur:
        print(erreur, file=sys.stderr)
        return 1
    if not etat["actif"] or not dnstv_auto.appareils(etat):
        return 0
    cl = classeur()
    try:
        with dnstv_regles.verrou():                           # lecture-modification-écriture exclusives avec l'API
            regles = dnstv_regles.charger()
            res = dnstv_auto.tick(etat, regles, dnstv.Magasin(dnstv.DOSSIER_ETAT / "dnstv.db"), lambda d: cl.classer(d)[0] or "",
                                  dnstv_auto.reglage_depuis(etat), maintenant or int(time.time()))
            if res["changements"]:
                dnstv_regles.ecrire(regles)
    except dnstv_regles.ErreurRegle as e:
        print(f"règles illisibles, rien n'est changé : {e}", file=sys.stderr)
        return 1
    for c in res["changements"]:
        print(f"{c['appareil']} {c['domaine']} {c['de'] or '-'}→{c['vers']} ({c['motif']})")
    # Le contrôleur est appelé dès qu'une règle change d'état autrement que par sa simple proposition : il applique ET audite.
    if res["applique"] or any(c["de"] for c in res["changements"]):
        r = (sudo or (lambda: subprocess.run(["sudo", "-n", CTL, "regles-appliquer"], capture_output=True, text=True, timeout=180)))()
        if r.returncode != 0:
            print("application refusée : " + (r.stderr or r.stdout).strip()[:200], file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
