"""SecuBox-Deb :: secubox-adguard-auto — un passage du moteur du mode « auto » du POC DNS AdBlock TV (#1954).

Lancé chaque minute par `secubox-ad-guard-auto.timer`, sous l'utilisateur `secubox`. Sort aussitôt, sans rien faire, si aucun appareil n'est en mode
`auto` : la minuterie ne coûte rien tant que le mode n'est pas utilisé. Il ne touche JAMAIS Unbound : il met à jour `regles.json` puis demande au seul
contrôleur privilégié (`sudo -n secubox-adguard-tv regles-appliquer`, argument exact) d'appliquer la différence.
"""
from __future__ import annotations

import contextlib
import os
import subprocess
import sys
import time
from pathlib import Path

for _p in ("/usr/lib/secubox/ad-guard", str(Path(__file__).resolve().parents[1])):
    if _p not in sys.path:
        sys.path.insert(0, _p)
from api import dnstv, dnstv_analyse, dnstv_assistant, dnstv_contournement, dnstv_dpi, dnstv_journal, dnstv_protection, dnstv_ajout, dnstv_appareils, dnstv_auto, dnstv_detecteur, dnstv_dpifeed, dnstv_indices, dnstv_profil, dnstv_regles, dnstv_taxonomie  # noqa: E402

CTL = "/usr/sbin/secubox-adguard-tv"


def classeur() -> dnstv.Classifieur:
    perso = dnstv.DOSSIER_ETAT / "custom.txt"
    return dnstv.Classifieur(dnstv.charger_listes(dnstv.DOSSIER_LISTES, perso if perso.is_file() and not perso.is_symlink() else None))


def services() -> dnstv.ClasseurServices:
    f = dnstv.DOSSIER_LISTES / "services.txt"
    return dnstv.ClasseurServices(dnstv.charger_services(f) if f.is_file() else [])


CACHE_CLASSIFICATION_S = 300


def ecrire_cache_classification(etat, taxo, magasin, regles, maintenant) -> None:
    """Cache de GET /adblock-tv/classification (#3374) : recalculé au plus toutes les 5 min ; un échec ne fait jamais échouer le moteur."""
    try:
        g = dnstv_analyse.genere()                                # lot 3 : l'horodatage seul, sans relire le cache
        if g is not None and 0 <= maintenant - g < CACHE_CLASSIFICATION_S:
            return
        obs = magasin.observations(dnstv._jour(maintenant - 30 * 86400))
        dnstv_analyse.ecrire_cache(dnstv_taxonomie.construire_classification(etat, taxo, obs, regles.liste()), maintenant,
                                   etat=etat, regles=regles.liste())
    except Exception as e:                                       # noqa: BLE001
        print(f"cache de classification non écrit : {type(e).__name__}", file=sys.stderr)


class _SansMoteur(Exception):
    """Rien à faire pour le moteur, mais une reprise de pause a changé l'état : l'application reste due."""


def audit_reprise(noms: list, executer=None) -> None:
    """Reprise automatique dans audit.log (origine auto, acteur « moteur ») par le verbe borné `audit-protection` ; au mieux : la reprise
    RÉTABLIT la protection, elle n'est jamais empêchée par l'audit (le changement de mode est aussi tracé par regles-appliquer)."""
    import json
    corps = json.dumps({"acteur": "moteur", "origine": "auto", "geste": "reprise", "cibles": sorted(noms)[:64], "minutes": None,
                        "domaine": None, "type": None})
    try:
        r = (executer or (lambda: subprocess.run(["sudo", "-n", CTL, "audit-protection"], input=corps, capture_output=True, text=True,
                                                 timeout=30)))()
        if r.returncode != 0:
            print("audit de la reprise refusé : " + (r.stderr or "").strip()[:120], file=sys.stderr)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"audit de la reprise impossible : {type(e).__name__}", file=sys.stderr)


def reprendre_pauses(etat: dict, now: int) -> list:
    """Lot 3 (#3374) : reprise AUTOMATIQUE des pauses échues (modes d'avant restaurés, sauf adresse changée entre-temps par
    l'administrateur), journal « reprise ». Sous le verrou des règles. Fichier des pauses illisible : rien n'est repris (tracé)."""
    try:
        pauses = dnstv_protection.charger_pauses()
    except dnstv_protection.ErreurProtection as e:
        print(f"pauses illisibles, aucune reprise : {e}", file=sys.stderr)
        return []
    repris = dnstv_protection.reprendre(etat, pauses, None, now, echues=True)
    if repris:
        audit_reprise(repris)
        dnstv.ecrire_etat(etat)
        (dnstv.DOSSIER_ETAT / ".a-appliquer").touch()          # l'état restauré DOIT être appliqué, même si la suite échoue
        try:
            dnstv_protection.ecrire_pauses(pauses)
        except (OSError, dnstv_protection.ErreurProtection) as e:
            # la pause restée inscrite sera oubliée au passage suivant : ses adresses ne sont plus en observe
            print(f"pauses non réécrites après reprise : {type(e).__name__}", file=sys.stderr)
        try:
            macs = {c["nom"]: c.get("mac") for c in etat["clients"] if c.get("mac")}
            dnstv_journal.ajouter([dnstv_journal.entree(now, n, macs.get(n), "", "", "reprise", "auto", "fin de pause") for n in repris])
        except (OSError, ValueError) as e:
            print(f"journal des décisions non écrit : {type(e).__name__}", file=sys.stderr)
    return repris


def appliquer_assistant(etat: dict, now: int) -> bool:
    """Lot 5b (#3374) : consomme la file de l'assistant (choix de l'administrateur dans la vue « En direct »), sous le verrou des règles
    déjà tenu. `bloquer` / `legitime` = exceptions du lot 3 (décision manuelle, origine admin) ; `plus-tard` ne touche pas au DNS.
    Ordre : règles, état, exceptions, puis la file ; un échec laisse les actions EN ATTENTE (nouvel essai au passage suivant).
    Rend vrai si l'état DNS doit être appliqué. Ne fait jamais échouer le moteur."""
    try:
        c = dnstv_assistant.charger()
    except dnstv_assistant.ErreurAssistant as e:
        print(f"file de l'assistant illisible, rien n'est appliqué : {e}", file=sys.stderr)
        return False
    if not any(x["etat"] == "en-attente" for x in c["file"]) and not c.get("vus"):
        avant = len(c["file"])
        dnstv_assistant.purger(c, now)
        if len(c["file"]) != avant:
            try:
                dnstv_assistant.ecrire(c)
            except (OSError, dnstv_assistant.ErreurAssistant) as e:
                print(f"file de l'assistant non purgée : {type(e).__name__}", file=sys.stderr)
        return False
    try:
        regles = dnstv_regles.charger()
        ex = dnstv_protection.charger_exceptions()
        pauses = dnstv_protection.charger_pauses()
        taxo = dnstv_assistant.taxonomie(regles=regles)        # I1 : la même fonction que l'API
    except (dnstv_regles.ErreurRegle, dnstv_protection.ErreurProtection, dnstv_taxonomie.ErreurTaxonomie, OSError) as e:
        print(f"assistant : lecture impossible, actions laissées en attente : {e}", file=sys.stderr)
        return False
    avant_regles = regles.liste()
    res = dnstv_assistant.consommer(c, etat, regles, ex, pauses, taxo, now)
    try:
        if res["dns"]:
            dnstv_regles.ecrire(regles)
            dnstv.ecrire_etat(etat)
            dnstv_protection.ecrire_exceptions(res["exceptions"])
        dnstv_assistant.ecrire(c)
    except (OSError, dnstv.ErreurTV, dnstv_protection.ErreurProtection, dnstv_assistant.ErreurAssistant) as e:
        print(f"assistant : écriture impossible ({type(e).__name__})", file=sys.stderr)
        return bool(res["dns"])                               # règles peut-être écrites : l'application reste due
    try:
        dnstv_journal.ajouter(dnstv_journal.depuis_regles(avant_regles, regles.liste(), etat)
                              + [dnstv_journal.entree(now, x["appareil"], x["mac"], x["domaine"], "", "exception", "admin",
                                                      f"assistant : {x['choix']}")
                                 for x in c["file"] if x["id"] in res["appliquees"] and x["choix"] != "plus-tard"])   # m2 : jamais en double
    except (OSError, ValueError) as e:
        print(f"journal des décisions non écrit (assistant) : {type(e).__name__}", file=sys.stderr)
    if res["marques"]:
        try:
            mag = dnstv_dpi.MagasinDPI(dnstv.DOSSIER_ETAT / "dpi-appareils.db")
            for ident, marque, mac, domaine in res["marques"]:
                mag.marquer_id(ident, marque, mac, domaine)
        except Exception as e:                               # noqa: BLE001 — l'état affiché des découvertes n'arrête jamais le moteur
            print(f"découvertes non marquées : {type(e).__name__}", file=sys.stderr)
    return bool(res["dns"])


def guides_du_passage(etat: dict) -> set:
    try:
        return dnstv_assistant.slugs_guides(dnstv_assistant.charger(), etat)
    except dnstv_assistant.ErreurAssistant as e:
        print(f"apprentissage guidé illisible : {e}", file=sys.stderr)
        return set()


def voisins_du_lan() -> dict:
    """Voisins de l'interface du LAN SEULEMENT (ni br-lxc ni wg*) ; interface inconnue : rien (jamais d'ajout à l'aveugle)."""
    itf = dnstv.interface_lan()
    return dnstv.lire_voisins(interface=itf) if itf else {}


PERIODE_FEED_S = 300           # le fichier d'échange pour le DPI est recalculé au plus toutes les 5 minutes (#1960)


def rafraichir_feed(now: int, voisins=None, locales=None, passerelles=None) -> bool:
    """Écrit `dpi-feed.json` (résumé par appareil du LAN pour le DPI) s'il a plus de 5 minutes ou s'il manque. Rend vrai s'il l'a écrit.
    Hors verrou des règles : lecture seule de la base, écriture de SON propre fichier. Une erreur ne fait JAMAIS échouer le moteur."""
    etat, erreur = dnstv.lire_etat()
    if erreur or not etat["actif"]:
        return False
    try:
        actuel = dnstv_dpifeed.charger_feed()
        if actuel is not None and 0 <= now - actuel["genere"] < PERIODE_FEED_S:
            return False
    except Exception as e:                                   # noqa: BLE001
        print(f"fichier d'échange dpi-feed illisible : {type(e).__name__}: {e}", file=sys.stderr)
    try:
        magasin = dnstv.Magasin(dnstv.DOSSIER_ETAT / "dnstv.db")
        exclus = (locales or dnstv.adresses_locales)() | (passerelles or dnstv.passerelles)()
        feed = dnstv_dpifeed.construire(magasin.compteurs_detail(dnstv._jour(now)), (voisins or voisins_du_lan)(), etat, services(), exclus, now)
        dnstv_dpifeed.ecrire_feed(feed)
    except Exception as e:                                   # noqa: BLE001 — le moteur de #1954 ne doit JAMAIS échouer à cause du fichier d'échange (revue #1960)
        print(f"fichier d'échange dpi-feed non écrit : {type(e).__name__}: {e}", file=sys.stderr)
        return False
    return True


class _Echec:
    returncode, stdout, stderr = 1, "", "contrôleur absent"


def _verbe_root(verbe: str):
    """Un verbe EXACT du contrôleur root (sudoers : arguments fixes). Contrôleur absent (banc, tests) : échec silencieux."""
    if not Path(CTL).exists():
        return _Echec()
    try:
        return subprocess.run(["sudo", "-n", CTL, verbe], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return _Echec()


def rafraichir_dpi(now: int, voisins=None, executer=None) -> None:
    """Lot 4 (#3374) : passage DPI par appareil (sources, découvertes, garde de charge). Ne fait JAMAIS échouer le moteur."""
    try:
        dnstv_dpi.moteur(now, executer or _verbe_root, (voisins or voisins_du_lan)())
    except Exception as e:                                   # noqa: BLE001
        print(f"passage DPI : {type(e).__name__}: {e}", file=sys.stderr)


def replis_du_passage(etat: dict):
    """I3 : découvertes `repli` nouvelles rangées par le passage DPI, par appareil (slug) ; jamais recalculées ici."""
    try:
        mag = dnstv_dpi.MagasinDPI(dnstv.DOSSIER_ETAT / "dpi-appareils.db", lecture_seule=True)
        slugs = {c["mac"]: dnstv._slug(c["nom"]) for c in etat["clients"] if c.get("mac")}
        out, vus = {}, []
        for d in mag.decouvertes(type_="repli", etat="nouvelle", limite=500):     # filtré en SQL : jamais masqué par les anciennes
            if d["mac"] in slugs:
                out.setdefault(slugs[d["mac"]], []).append(d)
                vus.append((d["mac"], d["domaine"]))
        return out, vus
    except Exception as e:                                   # noqa: BLE001 — jamais de panne du moteur par le DPI
        print(f"replis illisibles : {type(e).__name__}", file=sys.stderr)
        return {}, []


def marquer_replis(vus: list) -> None:
    if not vus:
        return
    try:
        mag = dnstv_dpi.MagasinDPI(dnstv.DOSSIER_ETAT / "dpi-appareils.db")
        for mac, domaine in vus:
            mag.marquer(mac, domaine, "candidat")
    except Exception as e:                                   # noqa: BLE001
        print(f"replis non marqués : {type(e).__name__}", file=sys.stderr)


def suspendre_forcage(changements: list, etat: dict, now: int) -> bool:
    """Lecture cassée (contenu habituel plus demandé) sur un appareil forcé : forçage du DNS suspendu 24 h (lot 4). Rend vrai si écrit."""
    macs = dnstv_contournement.a_suspendre(changements, etat)
    if not macs:
        return False
    f = dnstv.DOSSIER_ETAT / dnstv_contournement.FICHIER_SUSPENSIONS
    try:
        ancien = f.read_text(encoding="utf-8") if f.is_file() and not f.is_symlink() else ""
    except OSError:
        ancien = ""
    import tempfile
    fd, tmp = tempfile.mkstemp(dir=f.parent, prefix="." + f.name + ".")    # nom aléatoire, créé en O_EXCL : jamais suivi
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as h:
            os.fchmod(h.fileno(), 0o640)
            h.write(dnstv_contournement.suspendre(ancien, macs, now))
        os.replace(tmp, f)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    try:
        dnstv_journal.ajouter([dnstv_journal.entree(now, c["nom"], c.get("mac"), "", "", "pause", "auto", "forçage DNS suspendu 24 h : lecture cassée")
                               for c in etat["clients"] if c.get("mac") in macs])
    except (OSError, ValueError) as e:
        print(f"journal des décisions non écrit (suspension du forçage) : {type(e).__name__}: {e}", file=sys.stderr)
    return True


def indices_du_passage(etat):
    """#3666 : indices du maillage pour ce passage. Réception coupée = index vide LISIBLE (le moteur retire alors ses règles nées d'indices) ;
    sinon la lecture des livraisons (non lisible = le moteur ne retire rien). Ne lève jamais."""
    try:
        return dnstv_indices.charger(dnstv_indices.LIVRAISONS) if etat.get("indices_recevoir", True) else dnstv_indices.Index()
    except Exception as e:                                           # noqa: BLE001 — jamais de panne du passage par les indices
        print(f"indices du maillage non lus : {type(e).__name__}", file=sys.stderr)
        return dnstv_indices.Index(lisible=False)


def publier_indices(etat, regles, taxo):
    """#3666 : écrit le fichier lu par MirrorNet (seulement s'il change). Ne lève jamais ; exceptions illisibles = rien n'est écrit."""
    try:
        c = dnstv_indices.contenu(regles, dnstv_protection.charger_exceptions(), taxo)
        dnstv_indices.ecrire_publication(etat.get("indices_publier", True), etat.get("indices_recevoir", True), c, dnstv_indices.PUBLICATION)
    except Exception as e:                                           # noqa: BLE001
        print(f"publication des indices non écrite : {type(e).__name__}", file=sys.stderr)


def main(sudo=None, maintenant=None, voisins=None, locales=None, passerelles=None, dpi=None) -> int:
    now = maintenant or int(time.time())
    dnstv_analyse.menage(maintenant=now)                      # lot 3 : ancien JSON de 16 Mo et temporaires orphelins, même moteur inactif
    try:
        rafraichir_feed(now, voisins, locales, passerelles)               # avant toute sortie anticipée : utile même sans appareil en mode auto
    except Exception as e:                                           # noqa: BLE001 — ceinture et bretelles : jamais de panne du moteur par le fichier d'échange
        print(f"fichier d'échange dpi-feed : {type(e).__name__}: {e}", file=sys.stderr)
    rafraichir_dpi(now, voisins, dpi)
    cl = classeur()
    magasin = dnstv.Magasin(dnstv.DOSSIER_ETAT / "dnstv.db")
    etat_modifie, ajouts, res = False, [], {"changements": [], "applique": False}
    try:
        with dnstv_regles.verrou():                           # lecture-modification-écriture exclusives avec l'API ; l'ÉTAT est lu ICI, sous le verrou
            etat, erreur = dnstv.lire_etat()
            if erreur:
                print(erreur, file=sys.stderr)
                return 1
            if reprendre_pauses(etat, now):
                etat_modifie = True
            if appliquer_assistant(etat, now):                # lot 5b : avant tout, même sans appareil en AUTO (PROTECT reçoit l'exception)
                etat_modifie = True
            if not etat["actif"] or (not dnstv_auto.appareils(etat) and not etat.get("ajout_auto")):
                if not etat_modifie:
                    return 0
                raise _SansMoteur
            # #3374 : état v1 -> v2 (par MAC), une seule fois, sans rien perdre ni changer un mode ; seulement quand le moteur travaille (inactif = il n'écrit rien)
            try:
                migration = dnstv_appareils.migrer_fichier()
            except (OSError, dnstv.ErreurTV) as e:
                migration = None
                print(f"migration #3374 non faite : {e}", file=sys.stderr)
            if migration:                                     # n'ajoute que schema et appareils : aucun effet DNS, rien à appliquer
                etat, erreur = dnstv.lire_etat()
                if erreur:
                    print(erreur, file=sys.stderr)
                    return 1
            reglage = dnstv_auto.reglage_depuis(etat)
            regles = dnstv_regles.charger()
            avant_regles = regles.liste()                         # lot 3 : le journal des décisions se déduit de l'historique des règles
            # #3374 : taxonomie unique (référence TV, listes, services, profil, corrections manuelles) ; la garde du moteur s'y appuie.
            # Fermé en cas d'échec : corrections illisibles = ni ajout automatique (ni profil posé), ni essai, ni confirmation automatiques.
            corrections_lisibles = True
            try:
                manuelles = dnstv_taxonomie.charger_manuelles()
            except dnstv_taxonomie.ErreurTaxonomie as e:
                manuelles, corrections_lisibles = {}, False
                reglage.auto_essai = reglage.confirmation_auto = False
                print(f"corrections de classification illisibles, ajout, essai et confirmation automatiques suspendus : {e}", file=sys.stderr)
            taxo = dnstv_taxonomie.Taxonomie.depuis_dossier(classer=cl.table, manuelles=manuelles, regles=regles)
            if etat.get("ajout_auto") and corrections_lisibles:
                # 1. détection (compteurs des 2 derniers jours, regroupés par MAC) puis ajout automatique, garde-fous compris
                try:
                    vois = (voisins or voisins_du_lan)()
                    exclus = (locales or dnstv.adresses_locales)() | (passerelles or dnstv.passerelles)()
                    detections = dnstv_detecteur.detecter(magasin.compteurs_clients(dnstv._jour(now - 86400)), vois, services(), reglage.declencheurs, exclus,
                                                          reglage.min_declencheurs, reglage.min_services)
                    vues = {c["client"]: c["derniere_vue"] for c in magasin.par_client()}
                    suivi = dnstv_ajout.charger_suivi()
                    res_a = dnstv_ajout.appliquer(etat, regles, detections, vois, vues, dnstv_profil.profil_effectif(dnstv_profil.graine(), dnstv_profil.charger_agrege()),
                                                  suivi, reglage, now, exclus, taxo=taxo)
                    ajouts = res_a["changements"]
                    if res_a["etat_modifie"]:
                        dnstv_regles.ecrire(regles)       # règles d'abord, puis le suivi, puis l'état : un échec au milieu ne laisse pas un appareil sans son profil
                        dnstv_ajout.ecrire_suivi(suivi)
                        dnstv.ecrire_etat(etat)
                        etat_modifie = True
                except dnstv_regles.ErreurRegle as e:
                    print(f"ajout automatique impossible : {e}", file=sys.stderr)     # plafond de règles : l'expiration et les signaux ci-dessous continuent
            # 2. règles : candidats, essais, signaux, agrégation
            replis, a_marquer = replis_du_passage(etat)
            res = dnstv_auto.tick(etat, regles, magasin, lambda d: cl.classer(d)[0] or "", reglage, now, taxo=taxo, replis=replis,
                                  guides=guides_du_passage(etat), indices=indices_du_passage(etat))
            marquer_replis(a_marquer)
            if res["changements"]:
                dnstv_regles.ecrire(regles)
                try:
                    if suspendre_forcage(res["changements"], etat, now):
                        etat_modifie = True                       # le contrôleur doit relever le forçage de cet appareil
                except OSError as e:
                    print(f"suspension du forçage non écrite : {type(e).__name__}", file=sys.stderr)
            if res["agrege"] != dnstv_profil.charger_agrege():
                dnstv_profil.ecrire_agrege(res["agrege"])
            ecrire_cache_classification(etat, taxo, magasin, regles, now)
            publier_indices(etat, regles, taxo)
            try:
                dnstv_journal.ajouter(dnstv_journal.depuis_regles(avant_regles, regles.liste(), etat, lambda d: taxo.classer(d)["categorie"]))
            except (OSError, ValueError) as e:
                print(f"journal des décisions non écrit : {type(e).__name__}", file=sys.stderr)
    except _SansMoteur:
        pass
    except dnstv_regles.ErreurRegle as e:
        print(f"règles illisibles, rien n'est changé : {e}", file=sys.stderr)
        return 1
    for c in ajouts:
        print(f"appareil {c['type']} {c['nom']} {c['detail']}")
    for c in res["changements"]:
        print(f"{c['appareil']} {c['domaine']} {c['de'] or '-'}→{c['vers']} ({c['motif']})")
    # Le contrôleur est appelé dès que le périmètre change ou qu'une règle change d'état autrement que par sa simple proposition : il applique ET audite.
    # Une application qui a échoué reste DUE (marque `.a-appliquer`) et est relancée au passage suivant : les fichiers sont déjà à jour,
    # sans relance le DNS resterait périmé jusqu'à la prochaine transition.
    due = (dnstv.DOSSIER_ETAT / ".a-appliquer")
    if etat_modifie:
        due.touch()                                           # posée dès l'état écrit : même un arrêt brutal avant l'appel laisse l'application due
    if etat_modifie or res["applique"] or any(c["de"] for c in res["changements"]) or due.exists():
        r = (sudo or (lambda: subprocess.run(["sudo", "-n", CTL, "regles-appliquer"], capture_output=True, text=True, timeout=180)))()
        if r.returncode != 0:
            due.touch()
            print("application refusée : " + (r.stderr or r.stdout).strip()[:200], file=sys.stderr)
            return 1
        due.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
