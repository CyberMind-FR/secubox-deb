"""SecuBox-Deb :: secubox-adguard-tv — la seule porte privilégiée du POC « DNS AdBlock TV » (#1943).

  secubox-adguard-tv apply      lit l'état (périmètre + modes), écrit le drop-in Unbound, le VÉRIFIE, recharge Unbound
  secubox-adguard-tv regles-appliquer   applique À CHAUD les seules différences de règles du mode auto (#1954) ; sinon rechargement complet
  secubox-adguard-tv disable    retire le drop-in et recharge Unbound : tout est remis en l'état
  secubox-adguard-tv status     JSON : drop-in présent, état, configuration valide
  secubox-adguard-tv cache-dump  écrit sur la SORTIE STANDARD les seuls couples « nom<TAB>adresse » (A/AAAA) du cache d'Unbound (#2240) : lecture
                                seule, rien n'est écrit sur le disque par root ; le capteur DNS les range lui-même, sous son compte
  secubox-adguard-tv conntrack-dump  lot 4 (#3374) : lignes de /proc/net/nf_conntrack dont la source est un appareil du périmètre (lecture seule)
  secubox-adguard-tv dpi-cibles       lot 4 : filtre BPF par MAC de nDPId et cibles de sbxdpi, reconstruits par root depuis l'état revalidé
  secubox-adguard-tv ndpid-arreter    lot 4 : garde de charge, arrête nDPId (reprise manuelle : ndpid-reprendre)

Lancé en root par sudo depuis l'API (utilisateur `secubox`) : l'état et la liste personnalisée sont donc écrits par un compte NON privilégié.
Le contrôleur ne leur fait aucune confiance : il les relit en refusant les liens symboliques, valide chaque champ (adresse IP, mode, nom
de domaine) et n'écrit dans Unbound que des valeurs qu'il a lui-même reconstruites. Un état invalide ne change RIEN.

La configuration écrite est contrôlée par `unbound-checkconf` AVANT d'être gardée ; si le contrôle échoue, la version précédente est
remise et la commande échoue : le DNS du réseau n'est jamais laissé avec une configuration cassée.
"""
from __future__ import annotations

import contextlib
import fcntl
import json
import os
import re
import stat
import subprocess
import tempfile
import sys
import time
from pathlib import Path

for _p in ("/usr/lib/secubox/ad-guard", str(Path(__file__).resolve().parents[1])):
    if _p not in sys.path:
        sys.path.insert(0, _p)
from api import dnstv, dnstv_regles  # noqa: E402
import secubox_unbound as _unbound  # noqa: E402   # D4 (#2050) : pose, vérification, rechargement — un seul code pour toutes les vues Unbound

CHECKCONF = os.environ.get("SECUBOX_ADGUARD_TV_CHECKCONF", "unbound-checkconf")
CONTROL = os.environ.get("SECUBOX_ADGUARD_TV_CONTROL", "unbound-control")
# Dossier de ROOT, hors de l'arbre de `secubox` (le postinst fait `chown -R secubox /var/lib/secubox/ad-guard`) : tout ce que root y écrit
# (instantané, marque « désactivé », verrou) ne peut pas être détourné par un lien symbolique posé par un compte non privilégié.
APPLIQUE = Path(os.environ.get("SECUBOX_ADGUARD_TV_APPLIQUE", "/var/lib/secubox-adguard-tv/applique.json"))
AUDIT = Path(os.environ.get("SECUBOX_ADGUARD_TV_AUDIT", "/var/log/secubox/audit.log"))


def audit(action: str, detail: str = "") -> None:
    try:
        AUDIT.parent.mkdir(parents=True, exist_ok=True)
        with open(AUDIT, "a", encoding="utf-8") as h:
            h.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "module": "ad-guard-tv",
                                "action": action, "detail": detail[:200]}, ensure_ascii=False) + "\n")
    except OSError:
        pass                                                           # le journal d'audit ne doit jamais bloquer l'opération


def lire_sans_suivre(chemin: Path) -> str:
    """Lecture d'un fichier écrit par un compte non privilégié : jamais à travers un lien symbolique."""
    fd = os.open(chemin, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        with os.fdopen(fd, "r", encoding="utf-8") as h:
            return h.read(1024 * 1024)
    except Exception:
        raise


def charger() -> tuple[dict, dict]:
    f = dnstv.DOSSIER_ETAT / "etat.json"
    try:
        etat = dnstv.valider_etat(json.loads(lire_sans_suivre(f)))
    except FileNotFoundError:
        etat = dict(dnstv.ETAT_DEFAUT, clients=[])
    except (OSError, ValueError, dnstv.ErreurTV) as e:
        raise SystemExit(f"état refusé ({type(e).__name__}) — rien n'est changé")
    table: dict = {}
    for cat in dnstv.CATEGORIES:
        if cat == "custom":
            continue
        p = dnstv.DOSSIER_LISTES / f"{cat}.txt"
        if p.is_file():
            for d in dnstv.lire_liste(p)[0]:
                table[d] = cat
    perso = dnstv.DOSSIER_ETAT / "custom.txt"
    if perso.exists() or perso.is_symlink():
        try:
            texte = lire_sans_suivre(perso)
        except OSError:
            raise SystemExit("liste personnalisée refusée (lien symbolique ou illisible) — rien n'est changé")
        for ligne in texte.splitlines():
            d = dnstv.valider_domaine(ligne.split("#", 1)[0])
            if d:
                table[d] = "custom"                                    # une ligne invalide est ignorée, jamais recopiée
    return etat, table


def charger_avec_regles() -> tuple[dict, dict, dict]:
    """État + table + règles actives par appareil. Les règles ne sont lues QUE si un appareil est en mode auto : un fichier de règles
    absent ou corrompu ne doit pas empêcher d'appliquer ou de retirer les modes observe/block."""
    etat, table = charger()
    auto = any(c["mode"] == "auto" for c in etat["clients"])
    if not auto and not any(c["mode"] == "block" for c in etat["clients"]):
        return etat, table, {}
    try:
        actives = dnstv_regles.charger(dnstv.DOSSIER_ETAT).par_appareil()
    except dnstv_regles.ErreurRegle as e:
        if auto:
            raise SystemExit(f"règles refusées ({e}) — rien n'est changé")
        audit("regles-refusees", f"PROTECT sans exceptions de blocage ({e})"[:200])   # lot 3 : PROTECT s'applique quand même, avec ses listes
        return etat, table, {}
    return etat, table, actives


def dossier_root() -> Path:
    """Le dossier de root, créé en 0700 au besoin ; refusé s'il est un lien, n'appartient pas à root ou est ouvert en écriture à d'autres."""
    d = APPLIQUE.parent
    try:
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
        st = os.lstat(d)
    except OSError as e:
        raise SystemExit(f"dossier du contrôleur inutilisable ({type(e).__name__})")
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise SystemExit("dossier du contrôleur refusé (lien symbolique, propriétaire ou droits inattendus) — rien n'est changé")
    return d


@contextlib.contextmanager
def verrou_controleur():
    """Un seul contrôleur à la fois (minuterie et API) : même drop-in, même instantané."""
    fd = os.open(dossier_root() / "verrou", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def _control(*args: str) -> None:
    """Une commande unbound-control, sans shell ; un code ≠ 0 est une erreur (le repli est décidé par l'appelant)."""
    r = subprocess.run([CONTROL, *args], capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        raise RuntimeError("unbound-control " + args[0] + " a échoué : " + (r.stderr or r.stdout).strip()[:120])


def instantane(etat: dict, actives: dict, regles: dict | None = None) -> dict:
    """Ce que le DNS a RÉELLEMENT chargé : modes + domaines de chaque vue auto + état de chaque règle (pour l'audit)."""
    vues = {f"sbx-tv-auto-{dnstv._slug(c['nom'])}": sorted(set(actives.get(dnstv._slug(c["nom"]), [])))
            for c in etat["clients"] if c["mode"] == "auto"}
    vues.update({f"sbx-tv-block-{s}": [d for d in bl if d not in aut] for s, (aut, bl) in dnstv.vues_protect(etat, actives).items()})   # lot 3 : PROTECT avec exceptions
    return {"actif": etat["actif"], "auto_essai": bool(etat.get("auto_essai")), "ajout_auto": bool(etat.get("ajout_auto")), "mode_defaut": etat.get("mode_defaut", "auto"),
            "modes": sorted([c["ip"], c["mode"], c["nom"], c.get("puits", True)] for c in etat["clients"]), "vues": vues, "etats": regles or {},
            "autorisations": etat.get("autorisations", {}),
            "ignores": sorted(etat.get("ignores", []))}


def ecrire_instantane(inst: dict) -> None:
    """Écriture atomique dans le dossier de root : nom aléatoire créé en O_EXCL (jamais un nom prévisible qu'un lien pourrait occuper)."""
    d = dossier_root()
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".applique.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as h:
            os.fchmod(h.fileno(), 0o600)
            h.write(json.dumps(inst))
        os.replace(tmp, d / APPLIQUE.name)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def lire_instantane() -> dict | None:
    """L'instantané précédent, REVALIDÉ : toute structure inattendue vaut « inconnu » (rechargement complet), jamais un argument d'unbound-control."""
    try:
        brut = json.loads(lire_sans_suivre(dossier_root() / APPLIQUE.name))
    except (OSError, ValueError):
        return None
    try:
        if not isinstance(brut, dict) or not isinstance(brut.get("vues"), dict) or not isinstance(brut.get("modes"), list):
            return None
        for vue, doms in brut["vues"].items():
            if not re.fullmatch(r"sbx-tv-auto-[a-z0-9-]{1,40}", str(vue)) or not isinstance(doms, list) \
                    or any(dnstv.valider_domaine(d) != d for d in doms):
                return None
        if not isinstance(brut.get("etats", {}), dict) or not isinstance(brut.get("autorisations", {}), dict):
            return None
    except (TypeError, AttributeError):
        return None
    return brut


class Systeme(_unbound.SystemeUnbound):
    """Les effets de bord sur Unbound. Les chemins des outils restent réglables par l'environnement (tests, bancs) ; ni redémarrage ni repli."""
    MODULE = "ad-guard-tv"
    ERREUR = RuntimeError

    def verifier_unbound(self):
        return _unbound.commande([CHECKCONF], 120)

    def recharger_unbound(self):
        ok, sortie = _unbound.commande([CONTROL, "reload"], 120)
        if not ok:
            raise self.ERREUR("unbound-control reload a échoué : " + sortie[:200])


def ecrire_verifier(contenu: str) -> None:
    """Écrit le drop-in puis le VÉRIFIE ; en cas de refus, remet l'ancien et s'arrête (comportement du POC conservé)."""
    try:
        _unbound.ecrire_verifier(dnstv.CONF_UNBOUND, contenu, Systeme())
    except RuntimeError as e:
        audit("apply-refuse", str(e)[:200])
        raise SystemExit("unbound-checkconf refuse la configuration — version précédente remise")


def recharger() -> None:
    try:
        Systeme().recharger_unbound()
    except RuntimeError as e:
        raise SystemExit(str(e))


def etats_regles() -> dict:
    """{ "appareil|domaine": état } de TOUTES les règles : l'audit compare deux instantanés pour tracer chaque transition effective."""
    try:
        return {f"{r['appareil']}|{r['domaine']}": r["etat"] for r in dnstv_regles.charger(dnstv.DOSSIER_ETAT).liste()}
    except dnstv_regles.ErreurRegle:
        return {}


def appliquer() -> int:
    etat, table, actives = charger_avec_regles()
    voulu = instantane(etat, actives, etats_regles())
    avant = lire_instantane()
    ecrire_verifier(dnstv.rendre_unbound(etat, table, actives))
    recharger()
    ecrire_instantane(voulu)
    audit_appareils(avant, etat)                                         # `apply` trace AUSSI les changements de périmètre (revue #1959)
    audit_transitions(avant, voulu)
    audit("apply", f"actif={etat['actif']} appareils={len(etat['clients'])} domaines={len(table)}")
    cont = _contournement_au_mieux(etat) if etat["actif"] else (contournement_retirer() or "retire")
    print(json.dumps({"ok": True, "actif": etat["actif"], "appareils": len(etat["clients"]), "domaines": len(table), "contournement": cont}))
    return 0


def audit_appareils(avant: dict | None, etat: dict) -> None:
    """Une ligne d'audit par appareil (adresse) ajouté, retiré ou MODIFIÉ (mode, puits, nom) entre deux instantanés, avec son origine et sa preuve (#1959).
    Sans instantané précédent (première application, ou réactivation après `disable`), tout le périmètre est tracé comme ajouté."""
    anciennes = {m[0]: m for m in avant.get("modes", []) if isinstance(m, list) and len(m) >= 3} if avant else {}
    courants = {c["ip"]: c for c in etat["clients"]}
    n = 0
    for ip, c in sorted(courants.items()):
        if n >= 50:
            break
        vieux = anciennes.get(ip)
        if vieux is None:
            audit("appareil", f"+ {c['nom']} {ip} mode={c['mode']} puits={c.get('puits', True)} origine={c.get('origine', 'admin')} mac={c.get('mac', '-')} preuve={c.get('preuve', '')}"[:200])
            n += 1
        elif vieux[1] != c["mode"] or vieux[2] != c["nom"] or (len(vieux) > 3 and vieux[3] != c.get("puits", True)):
            audit("appareil", f"~ {c['nom']} {ip} mode={c['mode']} puits={c.get('puits', True)}"[:200])
            n += 1
    for ip in sorted(set(anciennes) - set(courants)):
        if n < 50:
            audit("appareil", f"- {ip} retiré du périmètre")
            n += 1


def audit_transitions(avant: dict, voulu: dict) -> None:
    """Une ligne d'audit par transition EFFECTIVE (essai, confirmation, retrait, rejet) et par changement d'« essai automatique »."""
    regles = {}
    try:
        regles = {f"{r['appareil']}|{r['domaine']}": r for r in dnstv_regles.charger(dnstv.DOSSIER_ETAT).liste()}
    except dnstv_regles.ErreurRegle:
        pass
    ancien = avant.get("etats", {}) if avant else {}
    n = 0
    for cle, nouvel in sorted(voulu["etats"].items()):
        vieux = ancien.get(cle, "")
        if vieux == nouvel or (nouvel == "candidat" and not vieux):
            continue
        r = regles.get(cle, {})
        derniere = (r.get("historique") or [{}])[-1]                       # l'origine de la TRANSITION, pas celle de la création de la règle
        audit("regle", f"{cle.replace('|', ' ')} {vieux or '-'}→{nouvel} origine={derniere.get('origine', r.get('origine', '?'))} motif={r.get('motif', '')}"[:200])
        n += 1
        if n >= 50:
            break
    if avant is not None and bool(avant.get("auto_essai")) != voulu["auto_essai"]:
        audit("auto_essai", f"actif={voulu['auto_essai']}")
    ancien_aa, ancien_md = (bool(avant.get("ajout_auto")), avant.get("mode_defaut", "auto")) if avant else (False, "auto")
    if ancien_aa != voulu["ajout_auto"] or ancien_md != voulu["mode_defaut"]:
        audit("ajout_auto", f"actif={voulu['ajout_auto']} mode_defaut={voulu['mode_defaut']}")      # décision de sécurité : ajoute des appareils sans clic
    ancien_aut = {(s, d) for s, ds in (avant or {}).get("autorisations", {}).items() for d in ds}
    nouveau_aut = {(s, d) for s, ds in voulu.get("autorisations", {}).items() for d in ds}
    for s, d in sorted(nouveau_aut - ancien_aut)[:50]:
        audit("autorisation", f"+ {s} {d} : exempté du puits global pour cet appareil")
    for s, d in sorted(ancien_aut - nouveau_aut)[:50]:
        audit("autorisation", f"- {s} {d} : autorisation retirée")
    nouveaux_ignores = sorted(set(voulu.get("ignores", [])) - set((avant or {}).get("ignores", [])))
    retires_ignores = sorted(set((avant or {}).get("ignores", [])) - set(voulu.get("ignores", [])))
    for mac in nouveaux_ignores[:20]:
        audit("ignore", f"+ {mac} : ne sera plus jamais ajouté automatiquement")
    for mac in retires_ignores[:20]:
        audit("ignore", f"- {mac} : peut de nouveau être ajouté")


def regles_appliquer() -> int:
    """Applique les seules différences de règles À CHAUD (unbound-control view_local_zone) : aucune coupure du DNS.
    Ordre : (1) drop-in écrit et VÉRIFIÉ — s'il est refusé, RIEN n'est appliqué ; (2) zones ajoutées/retirées en mémoire ; (3) instantané.
    Tout autre changement (appareils, modes, vues) ou tout échec à chaud → rechargement complet depuis le drop-in déjà vérifié."""
    if (dossier_root() / "desactive").exists():
        print(json.dumps({"ok": True, "mode": "desactive"}))                # `disable` est durable : seule une demande `apply` explicite réactive
        return 0
    etat, table, actives = charger_avec_regles()
    voulu = instantane(etat, actives, etats_regles())
    avant = lire_instantane()
    ecrire_verifier(dnstv.rendre_unbound(etat, table, actives))
    if etat["actif"]:
        _contournement_au_mieux(etat)                                    # lot 4 : modes, pauses et suspensions suivis à chaque passage
    else:
        contournement_retirer()
    if (avant is None or avant.get("actif") != voulu["actif"] or avant.get("modes") != voulu["modes"]
            or set(avant.get("vues", {})) != set(voulu["vues"]) or avant.get("autorisations", {}) != voulu["autorisations"]):
        recharger()
        ecrire_instantane(voulu)
        audit_appareils(avant, etat)
        audit_transitions(avant or {}, voulu)
        audit("regles-appliquer", "mode=rechargement")
        print(json.dumps({"ok": True, "ajoutes": 0, "retires": 0, "mode": "rechargement"}))
        return 0
    ajoutes = retires = 0
    try:
        for vue, doms in voulu["vues"].items():
            anciens = set(avant["vues"].get(vue, []))
            for d in sorted(set(doms) - anciens):
                _control("view_local_zone", vue, d + ".", "always_nxdomain")
                ajoutes += 1
            for d in sorted(anciens - set(doms)):
                _control("view_local_zone_remove", vue, d + ".")
                retires += 1
    except (OSError, subprocess.SubprocessError, RuntimeError) as e:
        audit("regles-chaud-echec", str(e)[:150])
        recharger()                                                          # repli : le drop-in est déjà à jour et vérifié
        ecrire_instantane(voulu)
        audit_transitions(avant, voulu)
        print(json.dumps({"ok": True, "ajoutes": 0, "retires": 0, "mode": "rechargement"}))
        return 0
    ecrire_instantane(voulu)
    audit_transitions(avant, voulu)
    audit("regles-appliquer", f"ajoutes={ajoutes} retires={retires} mode=chaud")
    print(json.dumps({"ok": True, "ajoutes": ajoutes, "retires": retires, "mode": "chaud"}))
    return 0


def desactiver() -> int:
    """Retire le drop-in ET l'instantané, et pose la marque « désactivé » : la minuterie ne le réactive pas (seul `apply` le fait)."""
    existait = dnstv.CONF_UNBOUND.is_file()
    dnstv.CONF_UNBOUND.unlink(missing_ok=True)
    racine = dossier_root()
    (racine / APPLIQUE.name).unlink(missing_ok=True)
    (racine / "desactive").touch(mode=0o600)
    contournement_retirer()
    if existait:
        recharger()
    audit("disable", "drop-in retiré" if existait else "rien à retirer")
    print(json.dumps({"ok": True, "retire": existait}))
    return 0


def cache_dump() -> int:
    """Instantané des RÉPONSES A/AAAA du cache d'Unbound, sur la sortie standard (#2240). `unbound-control dump_cache` seul : aucun argument libre,
    sortie filtrée par une expression stricte, adresses revalidées. Root n'écrit RIEN : l'appelant (secubox) range le texte dans son propre dossier."""
    from api import dnstv_reponses
    try:
        r = subprocess.run([CONTROL, "dump_cache"], capture_output=True, text=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired) as e:
        audit("cache-dump-echec", type(e).__name__)
        print("cache-dump : unbound-control injoignable ou trop lent", file=sys.stderr)
        return 1
    if r.returncode != 0:
        audit("cache-dump-echec", (r.stderr or r.stdout).strip()[:120])
        print("cache-dump : unbound-control a refusé : " + (r.stderr or r.stdout).strip()[:120], file=sys.stderr)
        return 1
    couples = dnstv_reponses.parse_dump(r.stdout)
    sys.stdout.write("".join(f"{nom}\t{ip}\n" for nom, ip in couples))
    return 0


def etat_courant() -> int:
    ok = subprocess.run([CHECKCONF], capture_output=True, text=True, timeout=120).returncode == 0
    etat, erreur = dnstv.lire_etat()
    print(json.dumps({"dropin": dnstv.CONF_UNBOUND.is_file(), "config_valide": ok, "etat": etat, "erreur": erreur}))
    return 0


# Correction de catégorie (#3374) : l'API (compte secubox) ne peut pas écrire audit.log ; elle passe ici UN enregistrement sur l'entrée
# standard, revalidé champ par champ. Rien d'autre n'est écrit, rien n'est exécuté.
AUDIT_ENTREE_MAX = 4096
ACTEUR_RE = re.compile(r"^[A-Za-z0-9_.@-]{1,64}$")
MAC_TRONQUEE_RE = re.compile(r"^[0-9a-f]{2}:[0-9a-f]{2}:[0-9a-f]{2}:…:[0-9a-f]{2}$")
CATEGORIES_TV = ("PUBLICITE", "TRACKING", "TELEMETRIE", "STREAMING", "CDN", "DRM", "AUTHENTIFICATION", "MISE_A_JOUR",
                 "SERVICES_CONSTRUCTEUR", "INCONNU")      # = dnstv_taxonomie.CATEGORIES (le contrôleur root n'importe que dnstv)


def audit_classification(entree: str) -> int:
    try:
        r = json.loads(entree[:AUDIT_ENTREE_MAX + 1]) if len(entree) <= AUDIT_ENTREE_MAX else None
    except ValueError:
        r = None
    ok = (isinstance(r, dict) and set(r) == {"acteur", "domaine", "mac", "ancienne", "nouvelle"}
          and isinstance(r["acteur"], str) and ACTEUR_RE.match(r["acteur"])
          and isinstance(r["domaine"], str) and dnstv.valider_domaine(r["domaine"]) == r["domaine"]
          and isinstance(r["mac"], str) and (r["mac"] == "maison" or MAC_TRONQUEE_RE.match(r["mac"]))
          and all(r[k] is None or r[k] in CATEGORIES_TV for k in ("ancienne", "nouvelle")))
    if not ok:
        print("enregistrement d'audit refusé", file=sys.stderr)
        return 2
    ligne = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "module": "ad-guard-tv", "action": "classification", **r}
    try:
        AUDIT.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o640)
        with os.fdopen(fd, "a", encoding="utf-8") as h:
            h.write(json.dumps(ligne, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"audit.log non écrit ({type(e).__name__})", file=sys.stderr)
        return 1                                                        # l'API refuse alors la correction : jamais de décision non tracée
    return 0


# Gestes de protection (#3374 lot 3) : pause, retour en observation, reprise, exception. L'API (ou le moteur) passe UN enregistrement
# sur l'entrée standard ; root le revalide champ par champ et l'ajoute à audit.log avec l'ORIGINE (usager, admin, auto) et l'ACTEUR.
GESTES_PROTECTION = ("pause", "observe", "reprise", "exception", "annule")      # annule : retour arrière après un échec
ORIGINES_PROTECTION = ("usager", "admin", "auto")
TYPES_EXCEPTION = ("autoriser", "bloquer", "autoriser-retire", "bloquer-retire")


def _enregistrement_protection(r) -> bool:
    if not isinstance(r, dict) or set(r) != {"acteur", "origine", "geste", "cibles", "minutes", "domaine", "type", "force"}:
        return False
    if not isinstance(r["force"], bool):                                 # blocage confirmé d'une catégorie protégée (passe 3)
        return False
    if not (isinstance(r["acteur"], str) and ACTEUR_RE.match(r["acteur"]) and r["origine"] in ORIGINES_PROTECTION
            and r["geste"] in GESTES_PROTECTION):
        return False
    c = r["cibles"]
    if not isinstance(c, list) or not 1 <= len(c) <= 64 or not all(isinstance(x, str) and dnstv.NOM_RE.match(x) for x in c):
        return False
    m = r["minutes"]
    if m is not None and (not isinstance(m, int) or isinstance(m, bool) or not 1 <= m <= 1440):
        return False
    if r["geste"] == "exception":
        return (isinstance(r["domaine"], str) and dnstv.valider_domaine(r["domaine"]) == r["domaine"] and r["type"] in TYPES_EXCEPTION
                and m is None)
    if r["geste"] == "annule":                                          # reprend le geste annulé, domaine et type compris s'il y en a
        return ((r["domaine"] is None or (isinstance(r["domaine"], str) and dnstv.valider_domaine(r["domaine"]) == r["domaine"]))
                and (r["type"] is None or r["type"] in TYPES_EXCEPTION))
    return r["domaine"] is None and r["type"] is None


def audit_protection(entree: str) -> int:
    try:
        r = json.loads(entree) if len(entree) <= AUDIT_ENTREE_MAX else None
    except ValueError:
        r = None
    if not _enregistrement_protection(r):
        print("enregistrement d'audit refusé", file=sys.stderr)
        return 2
    ligne = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "module": "ad-guard-tv", "action": "protection", **r}
    try:
        AUDIT.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o640)
        with os.fdopen(fd, "a", encoding="utf-8") as h:
            h.write(json.dumps(ligne, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"audit.log non écrit ({type(e).__name__})", file=sys.stderr)
        return 1                                                        # l'API refuse alors le geste : jamais de décision non tracée
    return 0


# ── lot 4 (#3374) : DPI par appareil ───────────────────────────────────────────────────────────────────────
CONNTRACK = os.environ.get("SECUBOX_ADGUARD_TV_CONNTRACK", "/proc/net/nf_conntrack")
SYSTEMCTL = os.environ.get("SECUBOX_ADGUARD_TV_SYSTEMCTL", "systemctl")
IP_CMD = os.environ.get("SECUBOX_ADGUARD_TV_IP", "ip")
CIBLES = Path(os.environ.get("SECUBOX_ADGUARD_TV_CIBLES", "/run/secubox/sbxdpi-cibles.json"))
BPF_ENV = Path(os.environ.get("SECUBOX_ADGUARD_TV_BPF_ENV", "/etc/secubox/ndpid-engine.d/tv-privacy.env"))
UNITE_NDPID = "secubox-ndpid-engine.service"
CONNTRACK_MAX = 64 * 1024 * 1024


def _voisins_root() -> dict:
    """Table de voisinage lue par root lui-même (jamais un fichier écrit par `secubox`)."""
    def executer(cmd, **kw):
        return subprocess.run([IP_CMD, *cmd[1:]], **kw)
    return dnstv.lire_voisins(executer=executer)


def _perimetre_root() -> tuple[dict, dict]:
    """(état revalidé, voisins) ; le périmètre DPI = appareils hors OFF qui ont une MAC."""
    etat, _ = charger()
    return etat, _voisins_root()


def conntrack_dump() -> int:
    from api import dnstv_dpi
    etat, vois = _perimetre_root()
    adresses = set().union(*[set(a["adresses"]) for a in dnstv_dpi.cibles(etat, vois)["appareils"]] or [set()])
    try:
        with open(CONNTRACK, encoding="utf-8", errors="replace") as h:
            texte = h.read(CONNTRACK_MAX)
    except OSError:
        return 0                                                         # pas de conntrack (rien de transféré) : rien à rendre
    for ligne in texte.splitlines():
        f = dnstv_dpi.lire_conntrack(ligne, adresses)
        if f:
            sys.stdout.write(ligne.strip()[:400] + "\n")
    return 0


def _ecrire_root(chemin: Path, contenu: str, mode: int) -> bool:
    """Écriture atomique par root ; rend vrai si le contenu a changé."""
    try:
        if chemin.read_text(encoding="utf-8") == contenu and not chemin.is_symlink():
            return False
    except OSError:
        pass
    chemin.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=chemin.parent, prefix="." + chemin.name + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as h:
            os.fchmod(h.fileno(), mode)
            h.write(contenu)
        os.replace(tmp, chemin)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    return True


def dpi_cibles() -> int:
    from api import dnstv_dpi
    etat, vois = _perimetre_root()
    c = dnstv_dpi.cibles(etat, vois)
    macs = [a["mac"] for a in c["appareils"] if dnstv.MAC_RE.match(a["mac"])]
    filtre = " or ".join(f"ether host {m}" for m in macs) or "ether host 00:00:00:00:00:00"     # périmètre vide : nDPId n'analyse rien
    _ecrire_root(CIBLES, json.dumps(c, sort_keys=True), 0o644)
    env = ("# Généré par secubox-adguard-tv dpi-cibles (SBX TV Privacy lot 4, #3374) : ne pas modifier à la main.\n"
           f'FILTRE_BPF="{filtre}"\n')
    if _ecrire_root(BPF_ENV, env, 0o644):
        subprocess.run([SYSTEMCTL, "try-restart", UNITE_NDPID], capture_output=True, text=True, timeout=60)
        audit("dpi-cibles", f"appareils={len(macs)} filtre mis à jour")
    print(json.dumps({"ok": True, "appareils": len(macs)}))
    return 0


def ndpid(geste: str) -> int:
    r = subprocess.run([SYSTEMCTL, "stop" if geste == "arreter" else "start", UNITE_NDPID], capture_output=True, text=True, timeout=60)
    audit("ndpid-arret" if geste == "arreter" else "ndpid-reprise", "garde de charge" if geste == "arreter" else "reprise manuelle")
    print(json.dumps({"ok": r.returncode == 0}))
    return 0 if r.returncode == 0 else 1


# ── lot 4 (#3374), arbitrage 2 : forçage du DNS (nftables, double tampon, retour arrière) ─────────────────────
NFT = os.environ.get("SECUBOX_ADGUARD_TV_NFT", "nft")
NFT_FICHIER = Path(os.environ.get("SECUBOX_ADGUARD_TV_NFT_FICHIER", "/etc/nftables.d/zz-secubox-adguard-contournement.nft"))


def _nft(*args: str) -> bool:
    try:
        return subprocess.run([NFT, *args], capture_output=True, text=True, timeout=60).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def contournement_appliquer(etat: dict) -> str:
    """Reconstruit le forçage depuis l'état REVALIDÉ (jamais un texte de l'API). Fantôme -> `nft -c` -> échange -> `nft -f` ; un chargement
    refusé remet la version précédente. Ne fait jamais échouer l'application du DNS : le refus est audité et rendu (`refuse`, `retour`)."""
    from api import dnstv_contournement as C, dnstv_dpi
    try:
        texte = lire_sans_suivre(dnstv.DOSSIER_ETAT / C.FICHIER_SUSPENSIONS)
    except OSError:
        texte = ""
    suspendus = C.lire_suspensions(texte, int(time.time()))
    doh, _ = dnstv_dpi.charger_resolveurs(dnstv.DOSSIER_LISTES / "resolveurs-doh.txt")
    contenu = C.rendre(etat, doh, suspendus)
    try:
        precedent = NFT_FICHIER.read_text(encoding="utf-8") if NFT_FICHIER.is_file() and not NFT_FICHIER.is_symlink() else None
    except OSError:
        precedent = None
    if precedent == contenu:
        return "inchange"
    if precedent is None and not C.forces(etat, suspendus):
        return "aucun"                                                   # rien à forcer et rien de posé : aucune table, aucun bruit
    fantome = dossier_root() / "contournement.nft.new"
    fantome.unlink(missing_ok=True)
    fd = os.open(fantome, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as h:
        h.write(contenu)
    if not _nft("-c", "-f", str(fantome)):
        fantome.unlink(missing_ok=True)
        audit("contournement-refuse", "nft -c refuse le jeu de règles — version précédente gardée")
        return "refuse"
    fantome.unlink(missing_ok=True)
    _ecrire_root(NFT_FICHIER, contenu, 0o644)
    if not _nft("-f", str(NFT_FICHIER)):
        if precedent is not None:
            _ecrire_root(NFT_FICHIER, precedent, 0o644)
            _nft("-f", str(NFT_FICHIER))
        else:
            NFT_FICHIER.unlink(missing_ok=True)
            _nft("delete", "table", "inet", C.TABLE)
        audit("contournement-retour", "chargement refusé — version précédente remise")
        return "retour"
    audit("contournement", f"appareils={len(C.forces(etat, suspendus))} doh={len(doh)} suspendus={len(suspendus)}")
    return "ok"


def contournement_retirer() -> None:
    from api import dnstv_contournement as C
    if NFT_FICHIER.exists() or NFT_FICHIER.is_symlink():
        NFT_FICHIER.unlink(missing_ok=True)
        _nft("delete", "table", "inet", C.TABLE)
        audit("contournement", "forçage retiré")


def _contournement_au_mieux(etat: dict) -> str:
    try:
        return contournement_appliquer(etat)
    except Exception as e:                                               # noqa: BLE001 — le DNS reste appliqué quoi qu'il arrive
        audit("contournement-refuse", f"{type(e).__name__}"[:120])
        return "refuse"


def main(argv: list[str], entree: str | None = None) -> int:
    if len(argv) != 2 or argv[1] not in ("apply", "disable", "status", "regles-appliquer", "cache-dump", "audit-classification",
                                         "audit-protection", "conntrack-dump", "dpi-cibles", "ndpid-arreter", "ndpid-reprendre"):
        print(__doc__.split("\n\n")[0], file=sys.stderr)
        return 2
    if os.geteuid() != 0 and not os.environ.get("SECUBOX_ADGUARD_TV_SANS_ROOT"):
        print("secubox-adguard-tv : root requis (sudo)", file=sys.stderr)
        return 3
    if argv[1] == "status":
        return etat_courant()
    if argv[1] == "audit-classification":
        return audit_classification(sys.stdin.read(AUDIT_ENTREE_MAX + 1) if entree is None else entree)
    if argv[1] == "audit-protection":
        return audit_protection(sys.stdin.read(AUDIT_ENTREE_MAX + 1) if entree is None else entree)
    if argv[1] == "cache-dump":
        return cache_dump()                                              # lecture seule : ni verrou, ni écriture
    if argv[1] == "conntrack-dump":
        return conntrack_dump()                                          # lecture seule
    if argv[1] in ("ndpid-arreter", "ndpid-reprendre"):
        return ndpid(argv[1].split("-")[1])
    if argv[1] == "dpi-cibles":
        with verrou_controleur():
            return dpi_cibles()
    with verrou_controleur():
        if argv[1] == "apply":
            (dossier_root() / "desactive").unlink(missing_ok=True)         # une demande explicite lève la désactivation
        return {"apply": appliquer, "disable": desactiver, "regles-appliquer": regles_appliquer}[argv[1]]()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
