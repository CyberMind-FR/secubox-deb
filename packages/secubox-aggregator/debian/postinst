#!/bin/bash
set -e

case "$1" in
  configure)
    # Default config — copy example if no admin-provided file present.
    if [ ! -f /etc/secubox/aggregator.toml ]; then
        install -m 0644 /etc/secubox/aggregator.toml.example \
            /etc/secubox/aggregator.toml
        echo "secubox-aggregator: installed default config (pilot mounts: cookies, avatar)"
        # Un conffile reste en .dpkg-new jusqu'à la configuration de ce paquet : dans une image, hub, premier-pas et ad-guard,
        # configurés avant lui, n'ont pas pu se déclarer (API 404, #3503). On déclare ceux qui sont déjà installés.
        for module in ad-guard hub premier-pas; do
            if [ -f "/usr/lib/secubox/$module/api/main.py" ]; then
                sed -i "0,/modules = \[/s//modules = [\n    \"$module\",/" /etc/secubox/aggregator.toml
            fi
        done
    fi

    # Ensure /run/secubox exists with the right ownership/mode (#471 invariant).
    install -d -o root -g root -m 1777 /run/secubox 2>/dev/null || true

    systemctl daemon-reload
    systemctl enable secubox-aggregator.service
    systemctl start secubox-aggregator.service || true

    # Auto-heal watchdog (#727): restart the aggregator if its socket wedges
    # under load (the hub/auth/menu SPOF). Respect operator masking.
    if [ "$(systemctl is-enabled secubox-aggregator-watchdog.timer 2>/dev/null)" != "masked" ]; then
        systemctl enable --now secubox-aggregator-watchdog.timer 2>/dev/null || true
    fi

    # #2748 : sert les modules declares groupables (ad-guard...) si l'operateur n'a aucun groupe.
    /usr/sbin/secubox-groupe-declares-activer || true

    echo "secubox-aggregator: to migrate all installed SecuBox modules into"
    echo "  the aggregator (replaces per-module uvicorn processes) run :"
    echo "    sudo /usr/sbin/secubox-aggregator-migrate"
    ;;
esac
#DEBHELPER#
