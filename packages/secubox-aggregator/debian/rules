#!/usr/bin/make -f
%:
	dh $@ --with python3

override_dh_auto_install:
	install -d $(CURDIR)/debian/secubox-aggregator/usr/lib/python3/dist-packages/aggregator
	install -m 644 aggregator/__init__.py \
	  $(CURDIR)/debian/secubox-aggregator/usr/lib/python3/dist-packages/aggregator/
	install -m 644 aggregator/main.py \
	  $(CURDIR)/debian/secubox-aggregator/usr/lib/python3/dist-packages/aggregator/
	install -d $(CURDIR)/debian/secubox-aggregator/etc/secubox
	install -m 644 debian/aggregator.toml.example \
	  $(CURDIR)/debian/secubox-aggregator/etc/secubox/aggregator.toml.example
	install -d $(CURDIR)/debian/secubox-aggregator/lib/systemd/system
	install -m 644 systemd/secubox-aggregator.service \
	  $(CURDIR)/debian/secubox-aggregator/lib/systemd/system/
	install -m 644 systemd/secubox-aggregator-watchdog.service \
	  $(CURDIR)/debian/secubox-aggregator/lib/systemd/system/
	install -m 644 systemd/secubox-aggregator-watchdog.timer \
	  $(CURDIR)/debian/secubox-aggregator/lib/systemd/system/
	install -d $(CURDIR)/debian/secubox-aggregator/usr/sbin
	install -m 755 sbin/secubox-aggregator-migrate \
	  $(CURDIR)/debian/secubox-aggregator/usr/sbin/
	install -m 755 sbin/secubox-aggregator-watchdog.sh \
	  $(CURDIR)/debian/secubox-aggregator/usr/sbin/
	# Hote de groupe (absorbe secubox-groupd, #2050 N1) : plusieurs modules dans UN interpreteur.
	install -m 755 sbin/secubox-groupd \
	  $(CURDIR)/debian/secubox-aggregator/usr/sbin/
	install -m 644 systemd/secubox-group@.service \
	  $(CURDIR)/debian/secubox-aggregator/lib/systemd/system/
	install -m 644 systemd/secubox-group-root@.service \
	  $(CURDIR)/debian/secubox-aggregator/lib/systemd/system/
	# Les repertoires de declaration existent des l'installation : un module qui arrive apres n'a
	# qu'a y deposer son nom (groupable.d, groupable-root.d, groups.d).
	install -d $(CURDIR)/debian/secubox-aggregator/usr/share/secubox/groupable.d
	install -d $(CURDIR)/debian/secubox-aggregator/usr/share/secubox/groupable-root.d
	install -d $(CURDIR)/debian/secubox-aggregator/etc/secubox/groups.d
