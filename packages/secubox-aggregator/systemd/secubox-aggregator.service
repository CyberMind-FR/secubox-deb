[Unit]
Description=SecuBox API gateway (master ASGI uvicorn) [Phase 7 #496]
After=network.target
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/498

[Service]
Type=simple
User=secubox
Group=secubox

# Ensure runtime socket directory exists with correct ownership.
# RuntimeDirectory=secubox RETIRE (#1022) : /run/secubox est partage par ~95
# unites, et systemd EFFACE le contenu d'un RuntimeDirectory au redemarrage —
# une seule unite qui le declare emporte les sockets de toutes les autres, et
# la board rend des 502 sur des modules qui n'avaient rien demande. Le parent
# reste root:root 1777, cree hors des unites.
RuntimeDirectoryMode=1777
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONOPTIMIZE=1"
Environment="PYTHONUNBUFFERED=1"

# Single worker handles all mounted modules via asyncio. Bounded backlog +
# concurrency keep memory predictable. Log level intentionally low to avoid
# duplicating each sub-app's own logging.
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/aggregator.sock
ExecStart=/usr/bin/python3 -m uvicorn aggregator.main:app \
    --uds /run/secubox/aggregator.sock \
    --workers 1 \
    --backlog 400 \
    --limit-concurrency 200 \
    --log-level warning

# Service is in critical path — restart fast on crash.
Restart=on-failure
RestartSec=2

# Reasonable bounds on a multi-module process.
MemoryMax=1G
MemoryHigh=768M

# Hardening basics — read-only system + private tmp.
# Phase 7 follow-up (#498) : NoNewPrivileges was true but blocked the
# in-process modules' tightly-scoped sudoers grants (exact-command,
# read-only matches in /etc/sudoers.d/secubox-*). Relaxed to false ;
# the sudoers entries are the real defense in depth.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Phase 7 (#498) : /etc/secubox added for module config reads/writes
# (toolbox, dpi, etc.).
ReadWritePaths=/run/secubox /var/lib/secubox /var/log/secubox /etc/secubox

[Install]
WantedBy=multi-user.target
