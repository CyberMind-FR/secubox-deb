"""Paire Ed25519 du compte `ai-lecture` de l'atelier des émissions sur gk0 (#4063). SANS root.

    secubox-ai-emissions-cle [--cle CHEMIN]

Crée `~/.config/secubox-ai-jeton/ai-lecture.key` (PKCS8 PEM, 0600, dossier 0700) si elle MANQUE (jamais écrasée),
puis AFFICHE la clé publique, son `kid` (SHA-256 hex du DER SubjectPublicKeyInfo, `compte_service.empreinte`) et la
commande à lancer EN ROOT sur gk2 pour la déposer (`wafctl cle-ai-lecture ajouter`, qui la pose sous
`/etc/secubox-comptes-service/ai-lecture/<kid>.pub`, root 0644, deux clés au plus). Ne contacte jamais gk2.
"""
import argparse
import os
import stat
import sys
from pathlib import Path

from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

CLE_DEFAUT = Path.home() / ".config/secubox-ai-jeton/ai-lecture.key"


def _empreinte():
    """`compte_service.empreinte` du code installé, sinon du dépôt (même calcul que gk2)."""
    ici = Path(__file__).resolve()
    depot = ici.parents[3] / "common" if len(ici.parents) > 3 else ici.parent
    for d in (Path.home() / ".local/lib/secubox-ai-emissions/src", depot):
        if (d / "secubox_core/compte_service.py").is_file() and str(d) not in sys.path:
            sys.path.insert(0, str(d))
    from secubox_core.compte_service import DOSSIER_COMPTES_SERVICE, empreinte
    return empreinte, DOSSIER_COMPTES_SERVICE


def creer_si_absente(chemin: Path) -> bool:
    """Vrai si la clé vient d'être créée. Refuse une clé existante qui n'est pas un fichier 0600 du compte courant."""
    chemin.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        fd = os.open(chemin, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    except FileExistsError:
        st = os.lstat(chemin)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or stat.S_IMODE(st.st_mode) & 0o077:
            raise SystemExit(f"{chemin} existe mais n'est pas un fichier 0600 du compte courant : refusée")
        return False
    try:
        prive = Ed25519PrivateKey.generate().private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8,
                                                           serialization.NoEncryption())
        os.write(fd, prive)
        os.fsync(fd)
    except BaseException:
        os.close(fd)
        os.unlink(chemin)
        raise
    os.close(fd)
    return True


def main(argv=None) -> int:
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    p.add_argument("--cle", type=Path, default=CLE_DEFAUT)
    a = p.parse_args(argv)
    if os.geteuid() == 0:
        print("à lancer SANS root (clé du compte qui fait tourner l'atelier)", file=sys.stderr)
        return 2
    empreinte, dossier = _empreinte()
    creee = creer_si_absente(a.cle)
    cle = serialization.load_pem_private_key(a.cle.read_bytes(), password=None)
    if not isinstance(cle, Ed25519PrivateKey):
        print(f"{a.cle} : pas une clé privée Ed25519", file=sys.stderr)
        return 1
    pub = cle.public_key().public_bytes(serialization.Encoding.PEM,
                                        serialization.PublicFormat.SubjectPublicKeyInfo).decode("ascii")
    kid = empreinte(pub.encode("ascii"))
    print(f"Clé privée : {a.cle} ({'créée' if creee else 'existante, inchangée'}, 0600)")
    print(f"kid        : {kid}")
    print(pub, end="")
    print(f"""
À lancer EN ROOT sur gk2 (rien n'est fait d'ici) ; deux clés ai-lecture au plus (celle de gk3 comprise) :

cat > /root/ai-lecture-gk0.pub <<'CLE'
{pub}CLE
wafctl cle-ai-lecture lister
wafctl cle-ai-lecture ajouter /root/ai-lecture-gk0.pub && rm -f /root/ai-lecture-gk0.pub
wafctl cle-ai-lecture lister    # doit montrer {kid}

(Effet attendu : {dossier}/ai-lecture/{kid}.pub, root:root 0644, dossiers root 0755.)""")
    return 0


if __name__ == "__main__":
    sys.exit(main())
