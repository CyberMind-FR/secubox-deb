#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    systemctl daemon-reload
    systemctl enable secubox-ai-gateway.service || true
    systemctl start secubox-ai-gateway.service || true
fi
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/ai-gateway/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "ai-gateway : postinst de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/ai-gateway/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "ai-gateway : postinst de $(basename "$_s") en échec" >&2; }
done
exit 0
