# Configuration fixe de secubox-ai : /etc/secubox/ai.toml (root, lue seulement par le module).
# Aucun secret ici : la clé du moteur distant vit dans /etc/secubox/secrets/ai/distant.key.

[distant]
# Adresse du moteur distant compatible OpenAI (vide = moteur distant non configuré).
url = ""

[gk2]
# Passerelle SecuBox de gk2 pour le relevé des menaces et les sources.
menaces_url = "https://admin.gk2.secubox.in/api/v1"
sources_url = "https://hall.gk2.secubox.in/api/v1/zia/objets"

# [searxng]
# SearXNG local de la box, essayé avant celui de gk0 (vide = aucun). Adresse du conteneur créé par
# `searxngctl install` ; à ajouter aussi à IPAddressAllow — fait par l'empaquetage.
# url = "http://10.100.0.85:8888"

[moteur_local]
# Modèle GGUF servi par le moteur local (llama-server de secubox-zia-llm) quand aucun n'est activé dans la page.
# Entrée du catalogue (Llama 3.2 3B, Q4_K_M, 2 Go) : la télécharger depuis l'onglet Modèles suffit au premier usage.
modele = "Llama-3.2-3B-Instruct-Q4_K_M.gguf"
