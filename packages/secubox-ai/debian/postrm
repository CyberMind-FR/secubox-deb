# secubox-ai (#3583) : motif debhelper pour l'activation des unités (le postinst l'a posée par deb-systemd-helper).
# La purge retire la configuration fixe et les fichiers d'exécution ; les DONNÉES (/var/lib/secubox/ai : mémoire,
# historique, modèles) et la clé du moteur distant restent : elles ne se retirent qu'à la main, jamais par apt.
set -e
case "$1" in
  remove)
    for _u in secubox-ai-preparer.service secubox-ai-demandes.path secubox-ai.service; do
      deb-systemd-helper mask "$_u" >/dev/null 2>&1 || true
    done
    rm -f /run/systemd/system/secubox-ai.service.d/50-adresses.conf
    rmdir /run/systemd/system/secubox-ai.service.d 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    ;;
  purge)
    for _u in secubox-ai-preparer.service secubox-ai-demandes.path secubox-ai.service; do
      deb-systemd-helper purge "$_u" >/dev/null 2>&1 || true
      deb-systemd-helper unmask "$_u" >/dev/null 2>&1 || true
    done
    rm -f /etc/secubox/ai.toml
    rm -rf /run/secubox-ai
    ;;
esac
exit 0
