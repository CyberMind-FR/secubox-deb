"""secubox-ai-veille — processus de veille de secubox-ai V2 (#3719), User=secubox-ai.

Seul écrivain régulier de /var/lib/secubox/ai/veille.db : migrations, rétention quotidienne, garde d'espace, et
collecte de gk2 (#3720) par le compte de lecture `ai-lecture` (clé remise par LoadCredential=, jamais lue ailleurs).
Sans clé ou sans configuration lisible, la collecte reste éteinte et le dit ; le reste tourne.
"""
import asyncio
import logging
import signal
import os
import sys
import tomllib
from datetime import datetime, timezone

sys.path.insert(0, "/usr/lib/secubox/ai")

from veille import base, collecte, retention  # noqa: E402
from veille.client import ClientGk2, routes  # noqa: E402
from veille.sources import toutes  # noqa: E402
from veille.service import Boucle, Veille  # noqa: E402

DB = "/var/lib/secubox/ai/veille.db"
CONF = "/etc/secubox/ai.toml"
PAS_COLLECTE_S = 10           # chaque source garde son propre intervalle (collecte.passe ne lit que les sources dues)
log = logging.getLogger("secubox-ai-veille")


def _client():
    """Client de gk2, ou None (journalisé) sans clé ou sans configuration."""
    try:
        with open(CONF, "rb") as f:
            cfg = tomllib.load(f)
    except FileNotFoundError:
        cfg = {}
    except (OSError, tomllib.TOMLDecodeError) as e:
        log.error("%s illisible (%s) : collecte éteinte", CONF, e.__class__.__name__)
        return None
    base_url = str((cfg.get("gk2") or {}).get("menaces_url") or "https://admin.gk2.secubox.in/api/v1")
    aud = str((cfg.get("veille") or {}).get("aud") or "gk2")
    dossier = os.environ.get("CREDENTIALS_DIRECTORY")
    try:
        with open(os.path.join(dossier or "/nonexistent", "ai-lecture"), "rb") as f:
            cle = f.read(8192)
    except OSError:
        log.error("clé ai-lecture absente (secubox-aictl cle-ai-lecture generer) : collecte éteinte")
        return None
    return ClientGk2(base_url, aud, cle, routes(cfg))


def _maintenant():
    return datetime.now(timezone.utc)


async def _main():
    db = await asyncio.to_thread(base.ouvrir, DB)
    async def purge():
        res = await veille.sql(retention.purger, _maintenant())
        logging.getLogger("secubox-ai-veille").info("purge : %s", res)

    boucles = [Boucle("retention", 86400, purge)]
    client = _client()
    if client is not None:
        sources = toutes()

        async def collecter():
            etats = await collecte.passe(db, client, sources, _maintenant(), suspendu=veille.suspendue,
                                         sql=lambda f: veille.sql(lambda _db: f()))
            if any(e != "ok" for e in etats.values()):
                log.info("collecte : %s", etats)
        boucles.append(Boucle("collecte", PAS_COLLECTE_S, collecter))
    veille = Veille(db, _maintenant, boucles)
    boucle = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        boucle.add_signal_handler(sig, veille.arreter)
    await veille.executer()


def main():
    logging.basicConfig(level=logging.INFO, format="%(name)s %(levelname)s %(message)s")
    asyncio.run(_main())
    return 0


if __name__ == "__main__":
    sys.exit(main())
