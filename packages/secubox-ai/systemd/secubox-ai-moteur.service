# SecuBox IA — moteur local (#3583) : llama-server de secubox-zia-llm sur la socket /run/secubox-ai/moteur.sock.
# Démarré et arrêté UNIQUEMENT par « secubox-aictl » (aucune section [Install]) : il calcule le contexte sur la
# mémoire réellement disponible, écrit /run/secubox-ai/moteur.env (MODELE, CTX, MEMMAX) et pose MemoryMax par
# « systemctl set-property --runtime » avant chaque démarrage, ou refuse de démarrer (mémoire insuffisante).
[Unit]
Description=SecuBox IA — moteur local (llama-server)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3583
After=secubox-ai-preparer.service

[Service]
Type=simple
User=secubox-ai-moteur
# Groupe secubox-ai : la socket (UMask 0007 : 0770) est joignable par l'API, et les modèles (0640
# secubox-ai:secubox-ai, dossier 0750) sont lisibles par le moteur.
Group=secubox-ai
UMask=0007
# Absent si le démarrage ne vient pas de secubox-aictl : l'unité refuse alors de partir.
EnvironmentFile=/run/secubox-ai/moteur.env
# Socket laissée par un moteur tombé (ou posée par un autre compte du groupe) : retirée en root.
ExecStartPre=+/bin/rm -f /run/secubox-ai/moteur.sock
ExecStart=/usr/lib/secubox/zia-llm/llama-server -m ${MODELE} -c ${CTX} -t 4 --jinja --no-webui --host /run/secubox-ai/moteur.sock
# llama-server peut ignorer SIGTERM en pleine génération : tué au bout de 8 s (comme le POC).
TimeoutStopSec=8
# Jamais relancé tout seul : un échec de chargement doit remonter à secubox-aictl (état « erreur »).
Restart=no
# Plafond de repli pour un démarrage à la main ; secubox-aictl le remplace (poids + cache du contexte + 300 Mo).
MemoryMax=512M
# Pas d'échange : le plafond mémoire est le budget réel (le zram prendrait sur la mémoire du poste).
MemorySwapMax=0
Nice=10

# Durcissement : socle commun (RULES-CODE § 10), aucune capacité, aucun réseau (la socket Unix suffit).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# Le moteur est du groupe secubox-ai : il ne voit, des données du module, QUE le dossier des modèles (ni
# memoire.db, ni les préférences), ni la clé du moteur distant (0640 root:secubox-ai), ni les sockets des autres
# modules, ni leurs journaux.
TemporaryFileSystem=/var/lib/secubox:ro
BindReadOnlyPaths=/var/lib/secubox/ai/modeles
InaccessiblePaths=-/etc/secubox/secrets -/run/secubox -/var/log/secubox
# Seule écriture : sa socket.
ReadWritePaths=/run/secubox-ai
