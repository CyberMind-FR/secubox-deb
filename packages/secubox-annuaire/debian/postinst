#!/bin/sh
set -e
case "$1" in
    configure)
        # Runtime data directories
        install -d -m 0755 /var/lib/secubox/annuaire /var/log/secubox/annuaire 2>/dev/null || true
        chown -R secubox:secubox /var/lib/secubox/annuaire /var/log/secubox/annuaire 2>/dev/null || true

        # Fleet metrics store (fleet-metrics, Task 5): secubox-metrics-publish.timer
        # runs sbx-fleetctl publish as User=secubox, so this specific leaf dir
        # (never the shared /var/lib/secubox parent) must be secubox-owned for
        # it to write self.json.
        install -d -o secubox -g secubox -m 0755 /var/lib/secubox/annuaire/fleet 2>/dev/null || true

        # Node-key secret dir (annuairectl init writes node.key here, 0600 secubox).
        # CSPN: secrets under /etc/secubox/secrets/, 0700, owned by the service user.
        install -d -m 0700 /etc/secubox/secrets/annuaire 2>/dev/null || true
        chown secubox:secubox /etc/secubox/secrets/annuaire 2>/dev/null || true

        # The parent must be TRAVERSABLE by the service user (#952). Six
        # packages write the mode of this shared directory and the last one
        # installed wins; on gk2 it ended up 0700 root:root, so `secubox` could
        # not reach its own key and secubox-metrics-publish failed for good
        # with a misleading "no box key" — the key was there, the path was not.
        #
        # o+x only: traversal, never listing. Sub-directories keep their 0700
        # and the secrets their 0600, so crossing this directory grants
        # nothing. Same geste as secubox-assist, which hit this before us.
        chmod o+x /etc/secubox/secrets 2>/dev/null || true

        # Allow nginx to bind the wg-mesh IP even when the interface is down at
        # boot (wg-quick@wg-mesh may start after nginx). Without this, a
        # specific-IP `listen` fails and takes nginx down board-wide. This is
        # the canonical VIP/non-local-bind sysctl (HAProxy uses it too).
        if [ -f /etc/sysctl.d/30-secubox-nonlocal-bind.conf ]; then
            sysctl -p /etc/sysctl.d/30-secubox-nonlocal-bind.conf >/dev/null 2>&1 || true
        fi

        # Écouteur maillage :8799, règle nft wg-mesh, identité du nœud (#1530) :
        # un seul script, rejoué aussi par sbx-mesh-up à chaque jonction.
        /usr/sbin/secubox-annuaire-maillage || true

        # Satellite dashboards (#768): the legacy nginx vhost
        # (/etc/nginx/sites-available/secubox) includes /etc/nginx/secubox.d/
        # but NOT secubox-routes.d/, so the Annuaire dashboard's
        # /api/v1/annuaire/ calls fall through to the SPA shell (empty UI). Drop
        # the API route into secubox.d/ (included by that vhost). `nginx -t` is
        # the sole arbiter: if this DUPLICATES a location already active in the
        # same server (a hub vhost that includes both dirs), the test fails and
        # we drop it back — leaving nginx valid either way. Starts from a valid
        # baseline so a pre-existing error is never blamed on us.
        API_DROPIN=/etc/nginx/secubox.d/annuaire-api.conf
        ROUTES_SRC=/etc/nginx/secubox-routes.d/annuaire-routes.conf
        if [ -f "$ROUTES_SRC" ] && command -v nginx >/dev/null 2>&1 \
           && nginx -t >/dev/null 2>&1; then
            cp "$ROUTES_SRC" "$API_DROPIN"
            nginx -t >/dev/null 2>&1 || rm -f "$API_DROPIN"
        fi

        # Invalidate hub menu cache so Annuaire appears in the navbar
        rm -f /var/cache/secubox/menu.json 2>/dev/null || true
        # P2 config-apply (#768): seed the opt-in allow-list (empty = no-op) and
        # enable the timer. With no scopes configured the periodic apply does
        # nothing, so enabling it by default is safe; the operator opts in by
        # listing scopes in /etc/secubox/annuaire-apply.conf.
        if [ ! -f /etc/secubox/annuaire-apply.conf ] \
           && [ -f /etc/secubox/annuaire-apply.conf.example ]; then
            cp /etc/secubox/annuaire-apply.conf.example /etc/secubox/annuaire-apply.conf
            chmod 644 /etc/secubox/annuaire-apply.conf
        fi

        systemctl daemon-reload 2>/dev/null || true
        systemctl enable --now secubox-annuaire.service 2>/dev/null || true
        systemctl try-restart secubox-annuaire.service 2>/dev/null || true
        systemctl enable --now secubox-annuaire-apply.timer 2>/dev/null || true
        # Threatmesh: enforce the federated ban union (empty set = empty nft
        # table, so enabling by default is safe). Bans a node under attack
        # shares reach every peer within ~1 min.
        systemctl enable --now secubox-annuaire-bans-apply.timer 2>/dev/null || true
        # Fleet metrics publish (fleet-metrics, Task 5): signs + persists this
        # box's own MetricSnapshot every 60s. [metrics] fleet_publish=false in
        # secubox.conf makes sbx-fleetctl publish a documented no-op, so
        # enabling the timer by default is safe.
        systemctl enable --now secubox-metrics-publish.timer 2>/dev/null || true
        # Bonjour + noms <box>.lan/.mesh.<zone> (#1556) : tout de suite, puis toutes les 5 min.
        systemctl enable --now secubox-annuaire-noms.timer 2>/dev/null || true
        systemctl start --no-block secubox-annuaire-noms.service 2>/dev/null || true
        if systemctl is-active --quiet nginx 2>/dev/null; then
            nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
        fi
        ;;
esac
#DEBHELPER#
exit 0
