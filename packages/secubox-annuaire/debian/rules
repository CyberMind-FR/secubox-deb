#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	# Core annuaire library
	install -d $(CURDIR)/debian/secubox-annuaire/usr/lib/secubox/annuaire/annuaire
	cp -r $(CURDIR)/annuaire/* $(CURDIR)/debian/secubox-annuaire/usr/lib/secubox/annuaire/annuaire/

	# API module (uvicorn api.main:app)
	install -d $(CURDIR)/debian/secubox-annuaire/usr/lib/secubox/annuaire/api
	cp -r $(CURDIR)/api/* $(CURDIR)/debian/secubox-annuaire/usr/lib/secubox/annuaire/api/

	# nginx static UI route (secubox.d)
	install -d $(CURDIR)/debian/secubox-annuaire/etc/nginx/secubox.d
	install -m 644 $(CURDIR)/nginx/annuaire.conf $(CURDIR)/debian/secubox-annuaire/etc/nginx/secubox.d/
	install -m 644 $(CURDIR)/nginx/centers.conf $(CURDIR)/debian/secubox-annuaire/etc/nginx/secubox.d/
	install -m 644 $(CURDIR)/nginx/fleet.conf $(CURDIR)/debian/secubox-annuaire/etc/nginx/secubox.d/

	# Authoritative API route (secubox-routes.d)
	install -d $(CURDIR)/debian/secubox-annuaire/etc/nginx/secubox-routes.d
	install -m 644 $(CURDIR)/nginx/annuaire-routes.conf $(CURDIR)/debian/secubox-annuaire/etc/nginx/secubox-routes.d/

	# Mesh federation listener template (rendered with the wg-mesh IP by postinst)
	install -d $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/annuaire
	install -m 644 $(CURDIR)/nginx/annuaire-mesh.conf.tpl $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/annuaire/

	# Operator CLI
	install -d $(CURDIR)/debian/secubox-annuaire/usr/sbin
	install -m 755 $(CURDIR)/sbin/annuairectl $(CURDIR)/debian/secubox-annuaire/usr/sbin/annuairectl
	install -m 755 $(CURDIR)/sbin/secubox-annuaire-maillage $(CURDIR)/debian/secubox-annuaire/usr/sbin/secubox-annuaire-maillage
	install -m 755 $(CURDIR)/sbin/secubox-annuaire-noms $(CURDIR)/debian/secubox-annuaire/usr/sbin/secubox-annuaire-noms

	# Box operator CLI — delegated center grants (Centres & Grants, Task 7)
	install -m 755 $(CURDIR)/sbin/sbx-centersctl $(CURDIR)/debian/secubox-annuaire/usr/sbin/sbx-centersctl

	# Box operator CLI — fleet metrics publish (fleet-metrics, Task 5)
	install -m 755 $(CURDIR)/sbin/sbx-fleetctl $(CURDIR)/debian/secubox-annuaire/usr/sbin/sbx-fleetctl

	# Non-local bind sysctl (nginx binds the wg-mesh IP even if iface is late)
	install -d $(CURDIR)/debian/secubox-annuaire/etc/sysctl.d
	install -m 644 $(CURDIR)/sysctl/30-secubox-nonlocal-bind.conf $(CURDIR)/debian/secubox-annuaire/etc/sysctl.d/

		# Web UI (static)
	install -d $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/www/annuaire
	cp -r $(CURDIR)/www/annuaire/* $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/www/annuaire/

	# Web UI (static) — Centres & Grants panel
	install -d $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/www/centers
	cp -r $(CURDIR)/www/centers/* $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/www/centers/

	# Web UI (static) — Flotte / fleet metrics panel (fleet-metrics, Task 5)
	install -d $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/www/fleet
	install -m 644 $(CURDIR)/www/fleet/* $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/www/fleet/
	# Composant absorbé : openpgp (#2050)
	install -d debian/secubox-annuaire/usr/lib/secubox/openpgp/api \
	           debian/secubox-annuaire/usr/lib/secubox/openpgp/secubox_openpgp
	install -m 644 composants/openpgp/api/__init__.py composants/openpgp/api/main.py debian/secubox-annuaire/usr/lib/secubox/openpgp/api/
	install -m 644 composants/openpgp/secubox_openpgp/*.py debian/secubox-annuaire/usr/lib/secubox/openpgp/secubox_openpgp/
	install -D -m 755 composants/openpgp/sbin/sbx-openpgp debian/secubox-annuaire/usr/sbin/sbx-openpgp
	install -D -m 644 composants/openpgp/conf/openpgp.toml debian/secubox-annuaire/etc/secubox/openpgp.toml
	install -D -m 644 composants/openpgp/nginx/openpgpkey.conf.tpl \
	        debian/secubox-annuaire/usr/share/secubox/openpgp/openpgpkey.conf.tpl
	install -D -m 644 composants/openpgp/systemd/secubox-openpgp.service \
	        debian/secubox-annuaire/lib/systemd/system/secubox-openpgp.service
	install -D -m 755 composants/openpgp/debian/postinst debian/secubox-annuaire/usr/lib/secubox/annuaire/maintscripts/openpgp.postinst
	install -D -m 755 composants/openpgp/debian/prerm debian/secubox-annuaire/usr/lib/secubox/annuaire/maintscripts/openpgp.prerm

# Hub menu entry
	install -d $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/menu.d
	install -m 644 $(CURDIR)/menu.d/575-annuaire.json $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/menu.d/
	install -m 644 $(CURDIR)/menu.d/570-centers.json $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/menu.d/
	install -m 644 $(CURDIR)/menu.d/595-fleet.json $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/menu.d/

	# systemd service
	install -d $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system
	install -m 644 $(CURDIR)/debian/secubox-annuaire.service $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/

	# P2 config-apply timer + oneshot (#768) + opt-in allow-list config
	install -m 644 $(CURDIR)/systemd/secubox-annuaire-apply.service $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/
	install -m 644 $(CURDIR)/systemd/secubox-annuaire-apply.timer $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/
	# Threatmesh ban-apply timer + oneshot (#768)
	install -m 644 $(CURDIR)/systemd/secubox-annuaire-bans-apply.service $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/
	install -m 644 $(CURDIR)/systemd/secubox-annuaire-bans-apply.timer $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/
	# Fleet metrics publish timer + oneshot (fleet-metrics, Task 5)
	install -m 644 $(CURDIR)/systemd/secubox-metrics-publish.service $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/
	install -m 644 $(CURDIR)/systemd/secubox-metrics-publish.timer $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/
	install -m 644 $(CURDIR)/systemd/secubox-annuaire-noms.service $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/
	install -m 644 $(CURDIR)/systemd/secubox-annuaire-noms.timer $(CURDIR)/debian/secubox-annuaire/usr/lib/systemd/system/
	install -d $(CURDIR)/debian/secubox-annuaire/etc/secubox
	install -m 644 $(CURDIR)/conf/annuaire-apply.conf.example $(CURDIR)/debian/secubox-annuaire/etc/secubox/

	# Module manifest
	install -d $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/modules
	install -m 644 $(CURDIR)/debian/secubox.yaml $(CURDIR)/debian/secubox-annuaire/usr/share/secubox/modules/secubox-annuaire.yaml

	# Runtime dir placeholder
	install -d $(CURDIR)/debian/secubox-annuaire/run/secubox

override_dh_installsystemd:
	# L unité du composant openpgp est gérée par son postinst (clé et liaison AVANT le démarrage) : dh ne doit pas
	# l activer. On liste donc les unités propres à annuaire (#2050).
	dh_installsystemd secubox-annuaire.service secubox-annuaire-apply.timer secubox-annuaire-bans-apply.timer secubox-annuaire-noms.timer secubox-metrics-publish.timer
