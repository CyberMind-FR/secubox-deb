[Unit]
Description=SecuBox Annuaire — periodic config apply (gondwana P2, #768)

[Timer]
OnBootSec=90s
# #2917 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=90s
OnUnitActiveSec=120s
RandomizedDelaySec=20s
Persistent=true

[Install]
WantedBy=timers.target
