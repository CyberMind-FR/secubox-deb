[Unit]
Description=SecuBox — rafraîchir l'annonce Bonjour et les noms du maillage (#1556)

[Timer]
OnBootSec=2min
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
