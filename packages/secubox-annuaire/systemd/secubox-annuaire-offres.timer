[Unit]
Description=SecuBox Annuaire — offres de services réelles, chaque jour (#3021)

[Timer]
OnBootSec=5min
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redéclenche pas après une réactivation.
OnActiveSec=5min
OnUnitActiveSec=1d
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
