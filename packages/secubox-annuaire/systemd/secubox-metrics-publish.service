[Unit]
# #1497 : pas de cle de noeud (box neuve, `annuairectl init` non fait) = rien a publier.
ConditionPathExists=/etc/secubox/secrets/annuaire/node.key
Description=SecuBox Annuaire — publish this node's signed fleet metrics snapshot (fleet-metrics)
Documentation=file:///usr/share/doc/secubox-annuaire/README
After=secubox-annuaire.service
Wants=secubox-annuaire.service

[Service]
Type=oneshot
User=secubox
Group=secubox
# Signs with the box's own node.key (owned by secubox) — never root. A
# missing/disabled config degrades to a no-op (see sbx-fleetctl --help).
ExecStart=/usr/sbin/sbx-fleetctl publish
# Relevé de validation des modules (#3212) : « - » — un relevé absent ou refusé ne fait pas échouer l'unité.
ExecStart=-/usr/sbin/sbx-fleetctl publish-modules
# Status Live v2 (#3626) : relevé d'état signé de cette box ; sur l'agrégateur (status.toml), collecte des pairs vérifiés.
ExecStart=-/usr/sbin/sbx-fleetctl publish-status
ExecStart=-/usr/sbin/sbx-fleetctl collect-status
# Socle § 10 (relecture #3626 : l'unité lit désormais les pairs du maillage) ; jamais plus de 2 min par tour.
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
ReadWritePaths=/var/lib/secubox/annuaire
