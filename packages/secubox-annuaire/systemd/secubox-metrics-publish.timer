[Unit]
Description=SecuBox Annuaire — periodic fleet metrics publish (fleet-metrics)

[Timer]
OnBootSec=90s
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=90s
OnUnitActiveSec=60s
RandomizedDelaySec=10s
Persistent=true

[Install]
WantedBy=timers.target
