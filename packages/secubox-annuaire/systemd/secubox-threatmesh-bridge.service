[Unit]
Description=SecuBox threatmesh bridge — federate local crowdsec bans (#768)
After=secubox-annuaire.service crowdsec.service
# Dependance CrowdSec (#1218). Ce service lit les decisions de CrowdSec via
# cscli : sans le moteur, il tourne pour rien. Requisite echoue IMMEDIATEMENT si
# crowdsec n'est pas deja actif, sans tenter de le demarrer — c'est la semantique
# voulue : ne rien faire tant que CrowdSec n'est pas la, plutot que shell un
# binaire qui rendra une liste vide ou une erreur a chaque declenchement.
Requisite=crowdsec.service
Wants=secubox-annuaire.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/sbx-threatmesh-bridge
