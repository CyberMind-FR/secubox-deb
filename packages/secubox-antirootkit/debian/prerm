#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        systemctl stop sbx-antirootkitd.service 2>/dev/null || true
        systemctl disable sbx-antirootkitd.service 2>/dev/null || true
        systemctl stop secubox-antirootkit.service 2>/dev/null || true
        systemctl disable secubox-antirootkit.service 2>/dev/null || true
        systemctl stop sbx-untrusted.slice 2>/dev/null || true
        ;;
esac

#DEBHELPER#

exit 0
