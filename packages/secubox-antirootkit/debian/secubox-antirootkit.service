[Unit]
Description=SecuBox Anti-Rootkit API (exec forensic log, alerts, quarantine-prep)
After=network.target

# /run/secubox N'EST PAS UN RuntimeDirectory (#1022).
#
# Il est PARTAGE par une centaine de modules. `RuntimeDirectory=` est concu pour
# un repertoire PROPRE a un service : systemd le recree a chaque demarrage avec
# le mode de l'unite, donc le dernier service demarre imposait le sien. Huit
# unites le posaient en 0755, ce qui privait tous les autres du droit d'y creer
# leur socket — « bind: permission denied », et un 502 dont la cause etait le
# redemarrage d'un module sans rapport, survenu entre-temps.
#
# Le meme mecanisme effacait le repertoire a l'arret d'un service, emportant les
# sockets des quatre-vingt-dix autres.
#
# Il est desormais declare une seule fois, en 1777, par le tmpfiles.d de
# secubox-core — un seul proprietaire, une seule verite.
[Service]
Type=simple
User=secubox-antirootkit
Group=secubox-antirootkit
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/antirootkit.sock --workers 1
WorkingDirectory=/usr/lib/secubox/antirootkit
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening. NoNewPrivileges stays default (yes): this service only
# reads the forensic log/alerts and computes the quarantine plan — it never
# shells out to sudo (unlike sbx-antirootkitd.service, which jails pids).
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/secubox /var/lib/secubox/antirootkit

[Install]
WantedBy=multi-user.target
