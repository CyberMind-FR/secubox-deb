[Unit]
Description=SecuBox Anti-Rootkit exec-watcher (auditd sbx_exec -> jail unknown execs)
After=auditd.service network.target
Requires=auditd.service

[Service]
Type=simple
User=secubox-antirootkit
Group=secubox-antirootkit
# NoNewPrivileges=no: the daemon jails unbacked execs via
# `sudo -n secubox-antirootkitctl jail <pid>` (api/cgroup.py), scoped by the
# exact-path sudoers rule shipped in sudoers/secubox-antirootkit. NNP=yes
# would block that sudo call.
NoNewPrivileges=no
ExecStart=/usr/bin/python3 -m api.daemon
WorkingDirectory=/usr/lib/secubox/antirootkit
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
