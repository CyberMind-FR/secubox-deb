#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	# API module (uvicorn api.main:app)
	install -d $(CURDIR)/debian/secubox-appstore/usr/lib/secubox/appstore/api
	cp -r $(CURDIR)/api/* $(CURDIR)/debian/secubox-appstore/usr/lib/secubox/appstore/api/

	# Web UI
	install -d $(CURDIR)/debian/secubox-appstore/usr/share/secubox/www/appstore
	cp -r $(CURDIR)/www/appstore/* $(CURDIR)/debian/secubox-appstore/usr/share/secubox/www/appstore/

	# nginx route + static
	install -d $(CURDIR)/debian/secubox-appstore/etc/nginx/secubox.d
	install -m 644 $(CURDIR)/nginx/appstore.conf $(CURDIR)/debian/secubox-appstore/etc/nginx/secubox.d/

	# Hub menu entry
	install -d $(CURDIR)/debian/secubox-appstore/usr/share/secubox/menu.d
	install -m 644 $(CURDIR)/menu.d/580-appstore.json $(CURDIR)/debian/secubox-appstore/usr/share/secubox/menu.d/

	# systemd service
	install -d $(CURDIR)/debian/secubox-appstore/usr/lib/systemd/system
	install -m 644 $(CURDIR)/debian/secubox-appstore.service $(CURDIR)/debian/secubox-appstore/usr/lib/systemd/system/

	# Authoritative API route (secubox-routes.d)
	install -d $(CURDIR)/debian/secubox-appstore/etc/nginx/secubox-routes.d
	install -m 644 $(CURDIR)/nginx/appstore-routes.conf $(CURDIR)/debian/secubox-appstore/etc/nginx/secubox-routes.d/

	# Privileged controller + narrow sudoers rule
	install -d $(CURDIR)/debian/secubox-appstore/usr/sbin
	install -m 755 $(CURDIR)/sbin/secubox-appstorectl $(CURDIR)/debian/secubox-appstore/usr/sbin/
	# P2P apt: install SecuBox packages from the rendezvous over the wg-mesh (#768 P5)
	install -m 755 $(CURDIR)/sbin/sbx-apt-mesh $(CURDIR)/debian/secubox-appstore/usr/sbin/
	install -d $(CURDIR)/debian/secubox-appstore/etc/sudoers.d
	install -m 440 $(CURDIR)/debian/secubox-appstore.sudoers $(CURDIR)/debian/secubox-appstore/etc/sudoers.d/secubox-appstore

	# Generate the catalog index from every sibling module's debian/secubox.yaml
	install -d $(CURDIR)/debian/secubox-appstore/usr/share/secubox/appstore
	python3 $(CURDIR)/scripts/gen-appstore-catalog.py \
		$(CURDIR)/debian/secubox-appstore/usr/share/secubox/appstore/catalog.json

	# Runtime dir
	install -d $(CURDIR)/debian/secubox-appstore/run/secubox
	# Composant absorbé : metacatalog (#2050)
	install -d debian/secubox-appstore/usr/lib/secubox/metacatalog/
	cp -r composants/metacatalog/api debian/secubox-appstore/usr/lib/secubox/metacatalog/
	install -d debian/secubox-appstore/usr/share/secubox/www
	[ -d composants/metacatalog/www ] && cp -r composants/metacatalog/www/. debian/secubox-appstore/usr/share/secubox/www/ || true
	install -d debian/secubox-appstore/usr/share/secubox/menu.d
	[ -d composants/metacatalog/menu.d ] && cp -r composants/metacatalog/menu.d/. debian/secubox-appstore/usr/share/secubox/menu.d/ || true
	# Modular composants/metacatalog/nginx composants/metacatalog/config
	install -d debian/secubox-appstore/etc/nginx/secubox.d
	[ -f composants/metacatalog/nginx/metacatalog.conf ] && cp composants/metacatalog/nginx/metacatalog.conf debian/secubox-appstore/etc/nginx/secubox.d/ || true
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d debian/secubox-appstore/etc/nginx/secubox-routes.d
	[ -f composants/metacatalog/nginx/metacatalog.conf ] && cp composants/metacatalog/nginx/metacatalog.conf debian/secubox-appstore/etc/nginx/secubox-routes.d/ || true
	# Cache directory
	install -d debian/secubox-appstore/var/cache/secubox/metacatalog
	install -D -m 644 composants/metacatalog/debian/secubox-metacatalog.service debian/secubox-appstore/usr/lib/systemd/system/secubox-metacatalog.service
	install -D -m 755 composants/metacatalog/debian/postinst debian/secubox-appstore/usr/lib/secubox/appstore/maintscripts/metacatalog.postinst
	install -D -m 755 composants/metacatalog/debian/prerm debian/secubox-appstore/usr/lib/secubox/appstore/maintscripts/metacatalog.prerm

