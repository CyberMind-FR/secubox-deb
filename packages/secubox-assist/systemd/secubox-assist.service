[Unit]
Description=SecuBox Assist — WebSocket data-plane (wg-mesh only)
After=network-online.target wg-quick@wg-mesh.service
Wants=network-online.target
# Une vraie panne ne boucle pas indéfiniment : au plus 10 démarrages en 5 minutes (#2740). Dans [Unit] : dans [Service] systemd ignore ces clés.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=secubox-assist
Group=secubox-assist
# ATTENDRE wg-mesh au lieu d'échouer (#2740). Sans l'interface du maillage le démon refuse de servir (fail-closed, voulu) ; avant, `Restart=on-failure` le relançait toutes les 5 s
# (619 redémarrages en une heure sur un RPi400 qui n'avait pas encore rejoint le maillage). Un `sleep` en boucle ne coûte rien ; aucun délai de démarrage ne le tue.
ExecStartPre=/bin/sh -c 'until [ -e /sys/class/net/wg-mesh ]; do sleep 15; done'
TimeoutStartSec=infinity
ExecStart=/usr/bin/python3 -m assist.daemon
Environment=PYTHONPATH=/usr/lib/secubox/assist:/usr/lib/secubox/annuaire
Restart=on-failure
RestartSec=5
# NNP MUST be false: catalog.resolve() dispatches service/config actions as
# `sudo -n /usr/sbin/secubox-assistctl ...` (scoped sudoers, see
# sudoers/secubox-assist) run by THIS unit's User=. NoNewPrivileges=true
# blocks sudo's setuid transition outright, silently failing every
# privileged catalog action. secubox-assist-api.service never sudoes and
# keeps NoNewPrivileges=true.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/secubox
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
