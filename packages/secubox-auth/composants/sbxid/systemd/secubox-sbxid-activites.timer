[Unit]
Description=SecuBox SBX OS — collecte des activités chaque minute (#1560)

[Timer]
OnBootSec=2min
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=2min
OnUnitActiveSec=1min
AccuracySec=15s

[Install]
WantedBy=timers.target
