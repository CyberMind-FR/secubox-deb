#!/bin/sh
set -e

case "$1" in
    configure)
        # Create secubox system user/group if missing (idempotent, matches sibling packages)
        getent group secubox >/dev/null || groupadd --system secubox
        getent passwd secubox >/dev/null || useradd --system --gid secubox \
            --home /var/lib/secubox --no-create-home --shell /usr/sbin/nologin secubox
        install -d -o secubox -g secubox -m 755 /etc/secubox

        # Run v1 → v2 migration (idempotent).
        #
        # NOT tolerant of failure (#945). This step rewrites the credential
        # store; swallowing its exit code with `|| echo WARN` is how an upgrade
        # can leave a box with no password hashes and still report success.
        # A failure here must stop the install so the operator sees it while
        # the pre-migrate snapshot is still fresh.
        python3 - <<'PYEOF'
import sys
sys.path.insert(0, '/usr/lib/secubox/users')
from api.migrate_v1_to_v2 import migrate
from pathlib import Path
migrate(Path('/etc/secubox/users.json'), auth_toml_path=Path('/etc/secubox/auth.toml'))
PYEOF

        # Comptes semés : admin, et le compte au nom de la machine SEULEMENT tant qu'aucun administrateur n'a de mot de
        # passe (#3708 : un renommage en ajoutait un, sans mot de passe, revendicable depuis le LAN et le maillage).
        HOSTNAME_SHORT="$(hostname -s 2>/dev/null || hostname)"
        # Dans une construction d'image, ce nom est celui de la machine de CI : jamais un compte (#3518).
        if ischroot 2>/dev/null || [ -n "${SECUBOX_IMAGE_BUILD:-}" ]; then HOSTNAME_SHORT=""; fi
        /usr/sbin/usersctl semer --machine="$HOSTNAME_SHORT" || echo "WARN: comptes non semés" >&2

        # Marque durable (#3708) : une box déjà configurée ne rouvre plus jamais la revendication d'elle-même.
        /usr/sbin/usersctl marquer-configure || echo "WARN: box non marquée configurée" >&2

        # Migration (#3708) : désactive (jamais de suppression) tout admin sans mot de passe dès qu'un AUTRE admin actif
        # en a choisi un ; une ligne d'audit par compte. Retour : usersctl set-password NOM && usersctl enable NOM.
        /usr/sbin/usersctl desactiver-admins-sans-mot-de-passe --origine=postinst \
            || echo "WARN: comptes admin sans mot de passe non désactivés" >&2

        # Ownership + permissions on users.json + auth.toml (Phase 7 #498).
        # Both files are read by the aggregator (running as `secubox`) via
        # secubox_core.user_store. Without root:secubox 0640 they're
        # invisible to non-root services and every login returns
        # "Identifiants incorrects" because user_store falls through to
        # the auth.toml fallback which is then ALSO unreadable.
        if [ -f /etc/secubox/users.json ]; then
            chown root:secubox /etc/secubox/users.json
            chmod 0640 /etc/secubox/users.json
        fi
        # Verrou des écrivains (#3708) : illisible par le service, il fermerait toute écriture.
        if [ -f /etc/secubox/.users.json.verrou ] && [ ! -L /etc/secubox/.users.json.verrou ]; then
            chown root:secubox /etc/secubox/.users.json.verrou
            chmod 0640 /etc/secubox/.users.json.verrou
        fi
        if [ -f /etc/secubox/auth.toml ]; then
            chown root:secubox /etc/secubox/auth.toml
            chmod 0640 /etc/secubox/auth.toml
        fi

        # Restart the service so it picks up the new users.json
        systemctl daemon-reload 2>/dev/null || true
        systemctl enable secubox-users.service 2>/dev/null || true
        systemctl restart secubox-users.service 2>/dev/null || true
        ;;
esac

exit 0
