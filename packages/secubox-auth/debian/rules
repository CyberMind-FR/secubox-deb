#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-auth/usr/lib/secubox/auth/
	cp -r api debian/secubox-auth/usr/lib/secubox/auth/
	install -d debian/secubox-auth/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-auth/usr/share/secubox/www/ || true
	install -d debian/secubox-auth/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-auth/usr/share/secubox/menu.d/ || true
	# Modular nginx config
	install -d debian/secubox-auth/etc/nginx/secubox.d
	[ -f nginx/auth.conf ] && cp nginx/auth.conf debian/secubox-auth/etc/nginx/secubox.d/ || true
	# Composant absorbé : users (#2050)
	# API
	install -d debian/secubox-auth/usr/lib/secubox/users
	cp -r composants/users/api debian/secubox-auth/usr/lib/secubox/users/
	# CLI controller
	install -d debian/secubox-auth/usr/sbin
	install -m 755 composants/users/sbin/usersctl debian/secubox-auth/usr/sbin/
	# Comptes dans les services (#1375) : helper root + composants/users/sudoers exact + réglages.
	install -m 755 composants/users/sbin/secubox-usersctl-services debian/secubox-auth/usr/sbin/
	install -D -m 0440 composants/users/sudoers/secubox-users debian/secubox-auth/etc/sudoers.d/secubox-users
	install -D -m 0644 composants/users/conf/users.toml debian/secubox-auth/etc/secubox/users.toml
	# Frontend
	install -d debian/secubox-auth/usr/share/secubox/www/users
	cp -r composants/users/www/users/. debian/secubox-auth/usr/share/secubox/www/users/
	# Menu
	install -d debian/secubox-auth/usr/share/secubox/menu.d
	[ -d composants/users/menu.d ] && cp -r composants/users/menu.d/. debian/secubox-auth/usr/share/secubox/menu.d/ || true
	# Nginx composants/users/config
	install -d debian/secubox-auth/etc/nginx/secubox.d
	[ -f composants/users/nginx/users.conf ] && cp composants/users/nginx/users.conf debian/secubox-auth/etc/nginx/secubox.d/ || true
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d debian/secubox-auth/etc/nginx/secubox-routes.d
	[ -f composants/users/nginx/users.conf ] && cp composants/users/nginx/users.conf debian/secubox-auth/etc/nginx/secubox-routes.d/ || true
	# Users composants/users/data directory
	install -d debian/secubox-auth/etc/secubox
	install -D -m 755 composants/users/debian/postinst debian/secubox-auth/usr/lib/secubox/auth/maintscripts/users.postinst
	install -D -m 755 composants/users/debian/prerm debian/secubox-auth/usr/lib/secubox/auth/maintscripts/users.prerm
	install -D -m 644 composants/users/debian/secubox-users.service debian/secubox-auth/usr/lib/systemd/system/secubox-users.service
	# Composant absorbé : sbxid (#2050)
	install -d debian/secubox-auth/usr/lib/secubox/sbxid/api
	install -m 644 composants/sbxid/api/*.py debian/secubox-auth/usr/lib/secubox/sbxid/api/
	install -D -m 755 composants/sbxid/sbin/secubox-sbxid-activites debian/secubox-auth/usr/sbin/secubox-sbxid-activites
	install -D -m 644 composants/sbxid/systemd/secubox-sbxid-activites.service debian/secubox-auth/usr/lib/systemd/system/secubox-sbxid-activites.service
	install -D -m 644 composants/sbxid/systemd/secubox-sbxid-activites.timer debian/secubox-auth/usr/lib/systemd/system/secubox-sbxid-activites.timer
	install -d debian/secubox-auth/usr/share/secubox/www/identite
	install -m 644 composants/sbxid/www/identite/index.html debian/secubox-auth/usr/share/secubox/www/identite/
	install -d debian/secubox-auth/etc/secubox/nginx-available
	install -m 644 composants/sbxid/nginx/identity.vhost.conf debian/secubox-auth/etc/secubox/nginx-available/identity.conf
	# ── ACCÈS, ABSORBÉ (#1424) — mêmes chemins qu'avant : aucune rupture ──
	install -d debian/secubox-auth/usr/lib/secubox/acces/api
	install -m 644 composants/sbxid/acces/api/*.py debian/secubox-auth/usr/lib/secubox/acces/api/
	install -d debian/secubox-auth/usr/share/secubox/www/acces
	install -m 644 composants/sbxid/acces/www/acces/index.html composants/sbxid/acces/www/acces/micro.html composants/sbxid/acces/www/acces/appareil.js composants/sbxid/acces/www/acces/moi.js \
		composants/sbxid/acces/www/acces/maquette.html debian/secubox-auth/usr/share/secubox/www/acces/
	install -d debian/secubox-auth/usr/share/secubox/menu.d
	install -m 644 composants/sbxid/acces/menu.d/26-acces.json debian/secubox-auth/usr/share/secubox/menu.d/
	install -m 644 composants/sbxid/menu.d/124-identite.json debian/secubox-auth/usr/share/secubox/menu.d/
	install -d debian/secubox-auth/usr/share/secubox/www/sbxid
	install -m 644 composants/sbxid/www/sbxid/index.html debian/secubox-auth/usr/share/secubox/www/sbxid/
	install -d debian/secubox-auth/etc/nginx/secubox-routes.d
	install -m 644 composants/sbxid/nginx/sbxid-routes.conf debian/secubox-auth/etc/nginx/secubox-routes.d/sbxid.conf
	install -d debian/secubox-auth/etc/secubox
	install -m 644 composants/sbxid/acces/conf/acces.toml debian/secubox-auth/etc/secubox/
	install -d debian/secubox-auth/etc/nginx/secubox.d
	install -m 644 composants/sbxid/acces/nginx/acces.conf debian/secubox-auth/etc/nginx/secubox.d/
	install -m 644 composants/sbxid/acces/nginx/acces.vhost.conf debian/secubox-auth/etc/secubox/nginx-available/acces.conf
	install -D -m 755 composants/sbxid/debian/postinst debian/secubox-auth/usr/lib/secubox/auth/maintscripts/sbxid.postinst
	# Composant absorbé : oidc (#2050)
	install -d debian/secubox-auth/usr/lib/secubox/oidc/api
	install -m 644 composants/oidc/api/*.py debian/secubox-auth/usr/lib/secubox/oidc/api/
	install -D -m 755 composants/oidc/sbin/secubox-oidcctl debian/secubox-auth/usr/sbin/secubox-oidcctl
	install -D -m 644 composants/oidc/conf/oidc.toml debian/secubox-auth/etc/secubox/oidc.toml
	install -D -m 755 composants/oidc/debian/postinst debian/secubox-auth/usr/lib/secubox/auth/maintscripts/oidc.postinst

