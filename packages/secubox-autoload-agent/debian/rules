#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-autoload-agent/usr/lib/secubox/autoload-agent/autoload_agent
	install -m 644 autoload_agent/*.py debian/secubox-autoload-agent/usr/lib/secubox/autoload-agent/autoload_agent/
	install -D -m 644 provisioning.gpg debian/secubox-autoload-agent/usr/share/secubox/autoload/provisioning.gpg
	install -D -m 644 reponses-autoload.toml debian/secubox-autoload-agent/usr/share/doc/secubox-autoload-agent/examples/reponses-autoload.toml
	install -D -m 755 sbin/autoload-agentctl debian/secubox-autoload-agent/usr/sbin/autoload-agentctl

override_dh_auto_test:
	true
