"""ExecStartPre de secubox-autoload-agent.service : installe le jeton déposé par l'atelier sur /boot (voir autoload_agent/demarrage.py)."""
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/secubox/autoload-agent")
_ici = Path(__file__).resolve().parents[1]
if (_ici / "autoload_agent").is_dir():
    sys.path.insert(0, str(_ici))

from autoload_agent import demarrage as D  # noqa: E402

etat = D.installer_jeton()
print(f"autoload-agent-demarrage : jeton {etat}")
sys.exit(0)                                       # un jeton absent ou refusé n'arrête pas l'unité : le moteur le dira, avec sa raison, à l'étape d'enrôlement
