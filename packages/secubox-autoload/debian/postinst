#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    getent group secubox-autoload >/dev/null || addgroup --system secubox-autoload
    id secubox-autoload >/dev/null 2>&1 || adduser --system --ingroup secubox-autoload --no-create-home \
        --home /var/lib/secubox/autoload --shell /usr/sbin/nologin secubox-autoload
    # Le groupe secubox : la socket lui appartient (nginx la traverse) et la lecture des sessions d'authentification en dépend.
    getent group secubox >/dev/null && adduser secubox-autoload secubox >/dev/null 2>&1 || true
    install -d -o secubox-autoload -g secubox-autoload -m 0750 /var/lib/secubox/autoload
    # Journal d'audit dans SON sous-dossier (#2489) : la règle logrotate générale de secubox-core ne s'applique qu'au dossier plat. Migration : l'ancien fichier (plat)
    # est déplacé tel quel s'il porte des lignes ; vide ou absent, un journal neuf.
    install -d -o secubox-autoload -g secubox -m 0750 /var/log/secubox/autoload
    if [ -s /var/log/secubox/autoload-audit.log ] && [ ! -e /var/log/secubox/autoload/audit.log ]; then
        mv /var/log/secubox/autoload-audit.log /var/log/secubox/autoload/audit.log
    fi
    rm -f /var/log/secubox/autoload-audit.log
    [ -e /var/log/secubox/autoload/audit.log ] || install -m 0640 -o secubox-autoload -g secubox /dev/null /var/log/secubox/autoload/audit.log
    chown secubox-autoload:secubox /var/log/secubox/autoload/audit.log

    # AppArmor : profil ENFORCE, chargé seulement si le noyau le permet.
    if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
        apparmor_parser -r /etc/apparmor.d/secubox-autoload-api >/dev/null 2>&1 \
            || echo "secubox-autoload : profil AppArmor non chargé" >&2
    fi

    # La clé du hub est créée UNE fois, sur l'infrastructure ; elle n'est jamais remplacée.
    if [ ! -f /var/lib/secubox/autoload/hub.pub ]; then
        /usr/sbin/autoloadctl tunnel-init >/dev/null 2>&1 || echo "secubox-autoload : clé du hub non créée (tunnel-init)" >&2
    fi

    # Pare-feu : udp/51830 et tcp/8470 depuis wg-autoload seulement, sans doublon à la réinstallation.
    if command -v nft >/dev/null 2>&1 && nft list chain inet filter input >/dev/null 2>&1; then
        nft list chain inet filter input 2>/dev/null | grep -q "secubox autoload hub" || nft -f /etc/nftables.d/zz-secubox-autoload.nft 2>/dev/null || true
    fi

    # Dossier du verrou de tunnel-sync (#3126, R-L2-6) : à root seul (0700), jamais dans /run/secubox (1777). Créé avant le démarrage du service
    # pour que ReadWritePaths le monte en écriture (au démarrage de la machine, systemd-tmpfiles-setup le crée).
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/secubox-autoload.conf >/dev/null 2>&1 || install -d -m 0700 -o root -g root /run/secubox-autoload || true

    # Projection publique des pairs (#3126) : root la publie ici, HORS du bac à sable du service. Son dossier doit exister avant le démarrage
    # pour que ReadWritePaths le monte en écriture : sans lui, tunnel-sync lancé par le service (minuterie, révocations) n'exporte rien.
    /usr/sbin/autoloadctl exporter-pairs >/dev/null 2>&1 || echo "secubox-autoload : projection publique des pairs non exportée" >&2

    # #3305 : sur le maître, les pairs enrôlés à la PREMIÈRE installation sont les box de l'atelier (décision du propriétaire) ;
    # une seule fois (marque en base), audité ; republie les droits.
    if [ -r /var/lib/secubox/p2p-public/pairs-enroles.json ]; then
        /usr/sbin/autoloadctl maillage-atelier >/dev/null 2>&1 || echo "secubox-autoload : inscription de l'atelier non faite" >&2
    fi

    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ -f /var/lib/secubox/autoload/hub.pub ]; then
        systemctl enable secubox-autoload.service >/dev/null 2>&1 || true
        # try-restart : une mise à jour ne démarre pas un service que l'exploitant a arrêté.
        systemctl is-active --quiet secubox-autoload.service && systemctl try-restart secubox-autoload.service || systemctl start secubox-autoload.service || true
    fi
fi
#DEBHELPER#
exit 0
