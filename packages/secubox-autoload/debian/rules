#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-autoload/usr/lib/secubox/autoload/autoload
	install -m 644 autoload/*.py debian/secubox-autoload/usr/lib/secubox/autoload/autoload/
	install -D -m 755 sbin/autoloadctl debian/secubox-autoload/usr/sbin/autoloadctl

override_dh_auto_test:
	true
