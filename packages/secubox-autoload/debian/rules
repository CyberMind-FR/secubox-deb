#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-autoload/usr/lib/secubox/autoload/autoload debian/secubox-autoload/usr/lib/secubox/autoload/api
	install -m 644 autoload/*.py debian/secubox-autoload/usr/lib/secubox/autoload/autoload/
	install -m 644 api/*.py debian/secubox-autoload/usr/lib/secubox/autoload/api/
	install -d debian/secubox-autoload/usr/share/secubox/www/autoload debian/secubox-autoload/usr/share/secubox/menu.d
	cp -r www/autoload/. debian/secubox-autoload/usr/share/secubox/www/autoload/
	cp menu.d/*.json debian/secubox-autoload/usr/share/secubox/menu.d/
	install -D -m 755 sbin/autoloadctl debian/secubox-autoload/usr/sbin/autoloadctl
	install -D -m 755 sbin/secubox-autoload-api debian/secubox-autoload/usr/sbin/secubox-autoload-api
	install -d debian/secubox-autoload/usr/lib/systemd/system
	install -m 644 systemd/secubox-autoload.service debian/secubox-autoload/usr/lib/systemd/system/
	install -D -m 0440 sudoers.d/secubox-autoload debian/secubox-autoload/etc/sudoers.d/secubox-autoload
	install -D -m 644 nft/zz-secubox-autoload.nft debian/secubox-autoload/etc/nftables.d/zz-secubox-autoload.nft
	install -D -m 644 logrotate.d/secubox-autoload debian/secubox-autoload/etc/logrotate.d/secubox-autoload
	install -D -m 644 apparmor/secubox-autoload-api debian/secubox-autoload/etc/apparmor.d/secubox-autoload-api

override_dh_auto_test:
	true

# Activation choisie par le postinst.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
