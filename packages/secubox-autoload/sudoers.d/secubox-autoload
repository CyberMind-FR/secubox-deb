# secubox-autoload (#2190) : le service d'enrôlement (secubox-autoload) applique le tunnel par DEUX argv exacts, rien d'autre :
# tunnel-sync (enrôlement, révocation, abonnement) et tunnel-sync --horaire (minuterie : ne relance pas une interface désactivée, #3126).
secubox-autoload ALL=(root) NOPASSWD: /usr/sbin/autoloadctl tunnel-sync
secubox-autoload ALL=(root) NOPASSWD: /usr/sbin/autoloadctl tunnel-sync --horaire
