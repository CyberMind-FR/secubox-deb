# SecuBox-Deb :: secubox-autoload (#2190) — le service d'enrôlement (non root) dépose `sync.demande` ; cette unité lance la synchronisation en root.
[Unit]
Description=SecuBox Auto-Load — une synchronisation du tunnel est demandée

[Path]
PathChanged=/var/lib/secubox/autoload/sync.demande
Unit=secubox-autoload-sync.service

[Install]
WantedBy=multi-user.target
