# SecuBox-Deb :: secubox-autoload (#2190) — applique les pairs actifs au hub WireGuard (wg syncconf). Root, confiné : seul wireguard et le dossier du module sont inscriptibles.
[Unit]
Description=SecuBox Auto-Load — synchronise le tunnel WireGuard (root, confiné)

[Service]
Type=oneshot
User=root
ExecStart=/usr/sbin/autoloadctl tunnel-sync
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
ReadWritePaths=/etc/wireguard /var/lib/secubox/autoload /var/log/secubox/autoload-audit.log
