# SecuBox-Deb :: secubox-autoload (#2190) — enrôlement et panel du provisionnement Auto-Load.
# Un utilisateur À LUI : il ne lit que ses propres jetons ; le tunnel est appliqué par sudo à argv exacts (autoloadctl tunnel-sync [--horaire]), aucune unité root.
[Unit]
Description=SecuBox Auto-Load — enrôlement et panel (#2190)
After=network.target secubox-core.service

[Service]
Type=simple
User=secubox-autoload
Group=secubox-autoload
SupplementaryGroups=secubox
WorkingDirectory=/usr/lib/secubox/autoload
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SECUBOX_AUTOLOAD_AUDIT=/var/log/secubox/autoload/audit.log
# En root (« + ») : une socket périmée d'un autre utilisateur dans /run/secubox (sticky) ne se retire pas autrement.
ExecStartPre=+/bin/rm -f /run/secubox/autoload.sock
ExecStart=/usr/sbin/secubox-autoload-api
Restart=on-failure
RestartSec=3
UMask=0027
LimitCORE=0
# NoNewPrivileges=no est requis ICI : le sudoers du module accorde à secubox-autoload DEUX argv exacts (autoloadctl tunnel-sync [--horaire], qui applique les pairs
# WireGuard en root) ; avec NoNewPrivileges=yes sudo serait neutralisé. ATTENTION — NE PAS AJOUTER ProtectKernelTunables, ProtectKernelModules,
# ProtectKernelLogs, RestrictSUIDSGID, LockPersonality, RestrictNamespaces, RestrictAddressFamilies, PrivateDevices, SystemCallFilter ni
# MemoryDenyWriteExecute : chacun impose implicitement NoNewPrivileges=yes via seccomp et ferme la porte du helper (précédent voicestudio, #1917).
# Le bac à sable se resserre par le profil AppArmor (enforce) et les chemins : l'assistant root hérite de ce système de fichiers en lecture seule.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_ADMIN CAP_AUDIT_WRITE CAP_DAC_READ_SEARCH
# L'assistant root (sudo) hérite de CET espace de montage : il écrit la configuration du tunnel (/etc/wireguard), son verrou (/run/secubox) et la
# projection publique des pairs (#3126). Le dossier de la projection est créé par le postinst (autoloadctl exporter-pairs) avant le démarrage ;
# « - » : absent, il est ignoré au lieu d'empêcher le service de démarrer (l'export échoue alors jusqu'au prochain démarrage).
ReadWritePaths=/var/lib/secubox/autoload /var/log/secubox/autoload /run/secubox /etc/wireguard -/var/lib/secubox/autoload-public

[Install]
WantedBy=multi-user.target
