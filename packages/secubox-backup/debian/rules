#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-backup/usr/lib/secubox/backup
	cp -r api debian/secubox-backup/usr/lib/secubox/backup/
	# #1903 : outil root de chiffrement / restauration des sauvegardes
	install -d debian/secubox-backup/usr/sbin
	install -m 0755 sbin/backupctl debian/secubox-backup/usr/sbin/backupctl
	install -d debian/secubox-backup/usr/share/secubox/www/backup
	cp -r www/backup/. debian/secubox-backup/usr/share/secubox/www/backup/
	install -d debian/secubox-backup/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-backup/usr/share/secubox/menu.d/ || true

	# Install nginx config
	install -d $(CURDIR)/debian/secubox-backup/etc/nginx/secubox.d
	install -m 644 nginx/backup.conf $(CURDIR)/debian/secubox-backup/etc/nginx/secubox.d/backup.conf
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul
	# repertoire que le vhost principal inclut (#989). Livree dans
	# secubox.d/ uniquement, elle n etait jamais lue.
	install -d $(CURDIR)/debian/secubox-backup/etc/nginx/secubox-routes.d
	install -m 644 nginx/backup.conf $(CURDIR)/debian/secubox-backup/etc/nginx/secubox-routes.d/backup.conf
	# Composant absorbé : cloner (#2050)
	install -d $(CURDIR)/debian/secubox-backup/usr/lib/secubox/cloner/api
	install -m 644 composants/cloner/api/main.py $(CURDIR)/debian/secubox-backup/usr/lib/secubox/cloner/api/
	touch $(CURDIR)/debian/secubox-backup/usr/lib/secubox/cloner/api/__init__.py
	install -d $(CURDIR)/debian/secubox-backup/usr/share/secubox/www/cloner
	install -m 644 composants/cloner/www/cloner/index.html $(CURDIR)/debian/secubox-backup/usr/share/secubox/www/cloner/
	install -d $(CURDIR)/debian/secubox-backup/etc/nginx/secubox.d
	install -m 644 composants/cloner/nginx/cloner.conf $(CURDIR)/debian/secubox-backup/etc/nginx/secubox.d/
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d $(CURDIR)/debian/secubox-backup/etc/nginx/secubox-routes.d
	install -m 644 composants/cloner/nginx/cloner.conf $(CURDIR)/debian/secubox-backup/etc/nginx/secubox-routes.d/
	install -d $(CURDIR)/debian/secubox-backup/usr/share/secubox/menu.d
	install -m 644 composants/cloner/menu.d/902-cloner.json $(CURDIR)/debian/secubox-backup/usr/share/secubox/menu.d/
	install -d $(CURDIR)/debian/secubox-backup/usr/lib/systemd/system
	install -m 644 debian/secubox-backup.service $(CURDIR)/debian/secubox-backup/usr/lib/systemd/system/
	install -D -m 755 composants/cloner/debian/postinst debian/secubox-backup/usr/lib/secubox/backup/maintscripts/cloner.postinst
	install -D -m 644 composants/cloner/debian/secubox-cloner.service debian/secubox-backup/usr/lib/systemd/system/secubox-cloner.service

