"""
SecuBox-Deb :: backupctl — chiffrement des sauvegardes (#1903), outil ROOT
CyberMind — https://cybermind.fr

  backupctl etat                         destinataire, clé privée, archives en clair
  backupctl init-key                     génère une paire age ; publique dans la config, privée
                                         dans /etc/secubox/secrets (root) — à COPIER HORS de la box
  backupctl chiffrer-existantes [--supprimer-clair]
                                         chiffre les archives en clair ; le clair n'est supprimé
                                         qu'après un déchiffrement vérifié, et seulement si demandé
  backupctl restaurer FICHIER.age [-C /] déchiffre puis extrait (tar), avec la clé privée
  backupctl restaurer --liste FICHIER.age  liste le contenu, sans rien extraire
  backupctl archiver config|services chiffre|clair
  backupctl archiver conteneur NOM chiffre|clair
                                         CRÉE l'archive (#3064) : tar de /etc, des données ou d'un conteneur (arrêté puis
                                         toujours relancé), chiffrée avec la clé publique de la box ; JSON sur stdout.
                                         Seul acte d'écriture que l'API (utilisateur secubox) obtient, par sudoers exact.
"""
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, os.environ.get("SECUBOX_BACKUP_LIB", "/usr/lib/secubox/backup/api"))
import chiffrement as c   # noqa: E402

RACINE = Path(os.environ.get("SECUBOX_BACKUP_PATH", "/srv/backups"))
SOUS = ("config", "containers", "services")

# Ce que l'on sauvegarde (#3064) : les mêmes chemins qu'avant, mais lus par ROOT.
CONFIG_PATHS = ["/etc/secubox", "/etc/nginx", "/etc/wireguard", "/etc/haproxy", "/etc/nftables.conf"]
SERVICE_PATHS = ["/var/lib/secubox", "/srv/nextcloud/data", "/srv/gitea/data"]
LXC_PATH = Path(os.environ.get("SECUBOX_BACKUP_LXC", "/srv/lxc"))
NOM = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
# Réserve d'espace (#3064) : une sauvegarde ne remplit JAMAIS le disque de la box. On ne commence pas sous RESERVE, et on
# interrompt tar (archive partielle supprimée) si l'espace libre passe sous la moitié. Sur gk2 (disque racine à 91 %), la
# sauvegarde des services (3,8 Go de données) a rempli le disque à 100 % avant d'être arrêtée à la main.
MO = 1024 * 1024
RESERVE = int(os.environ.get("SECUBOX_BACKUP_RESERVE_MB", "1024")) * MO


def etat() -> int:
    rec = c.destinataire()
    print(f"destinataire : {rec or 'AUCUN — backupctl init-key'}")
    print(f"clé privée   : {c.CLE_PRIVEE} ({'présente' if c.existe(c.CLE_PRIVEE) else 'absente'})")
    n = 0
    for s in SOUS:
        for f in c.en_clair(RACINE / s):
            n += 1
            print(f"  EN CLAIR : {f}")
    print(f"archives en clair : {n}")
    return 0


def init_key() -> int:
    if c.destinataire() and c.existe(c.CLE_PRIVEE):
        print("une clé existe déjà — rien à faire (supprimer les deux fichiers pour en régénérer une)")
        return 0
    sortie = subprocess.run(["age-keygen"], capture_output=True, text=True)
    if sortie.returncode != 0:
        sys.exit("age-keygen indisponible : apt install age")
    privee = "".join(l + "\n" for l in sortie.stdout.splitlines() if not l.startswith("#") and l.strip())
    pub = next((l.split(": ", 1)[1].strip() for l in (sortie.stdout + sortie.stderr).splitlines()
                if "public key:" in l), None)
    if not pub:
        sys.exit("clé publique introuvable dans la sortie d'age-keygen")
    c.CLE_PRIVEE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(c.CLE_PRIVEE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as h:
        h.write(privee)
    c.CONFIG.parent.mkdir(parents=True, exist_ok=True)
    c.CONFIG.write_text(json.dumps({"recipient": pub}, indent=1))
    os.chmod(c.CONFIG, 0o644)          # la clé publique n'est pas un secret : l'API sans privilège la lit
    print(f"destinataire : {pub}")
    print(f"clé privée   : {c.CLE_PRIVEE} (root, 0600)")
    print("→ COPIEZ cette clé privée HORS de cette box (clé USB, gestionnaire de secrets) : sans elle une"
          "\n  sauvegarde chiffrée n'est pas restaurable, et gardée ici elle ne protège que les copies qui sortent.")
    return 0


def chiffrer_existantes(supprimer: bool) -> int:
    rec = c.destinataire()
    if not rec:
        sys.exit("aucun destinataire : backupctl init-key")
    fait = 0
    for s in SOUS:
        for f in c.en_clair(RACINE / s):
            dest = Path(str(f) + ".age")
            r = subprocess.run(c.commande_chiffrer(f, dest, rec), capture_output=True, text=True)
            if r.returncode != 0 or not dest.exists() or dest.stat().st_size == 0:
                print(f"ÉCHEC {f}: {r.stderr[:120]}"); dest.unlink(missing_ok=True); continue
            os.chmod(dest, c.MODE_FICHIER)
            if supprimer:
                # Le clair ne part qu'après un déchiffrement qui rend EXACTEMENT les mêmes octets
                # (vers un fichier temporaire distinct : on compare l'original au déchiffré).
                try:
                    verif = c.dechiffrer(dest)
                except c.ErreurChiffrement as e:
                    print(f"CLAIR CONSERVÉ {f} : {e}"); continue
                try:
                    identique = verif.stat().st_size == f.stat().st_size and _memes_octets(verif, f)
                finally:
                    c.detruire_clair(verif)
                if identique:
                    f.unlink()
                    print(f"chiffrée, clair supprimé : {f.name}")
                else:
                    print(f"CLAIR CONSERVÉ {f} : la vérification diffère")
            else:
                print(f"chiffrée (clair conservé) : {f.name}")
            fait += 1
    print(f"{fait} archive(s) chiffrée(s)")
    return 0


def _memes_octets(a: Path, b: Path) -> bool:
    with open(a, "rb") as x, open(b, "rb") as y:
        while True:
            u, v = x.read(1 << 20), y.read(1 << 20)
            if u != v:
                return False
            if not u:
                return True


def restaurer(args) -> int:
    liste = "--liste" in args
    args = [a for a in args if a != "--liste"]
    if not args:
        sys.exit("usage : backupctl restaurer [--liste] FICHIER.age [-C RACINE]")
    f = Path(args[0])
    racine = args[args.index("-C") + 1] if "-C" in args else "/"
    if not f.exists():
        for s in SOUS:
            if (RACINE / s / f.name).exists():
                f = RACINE / s / f.name
                break
    if not f.exists():
        sys.exit(f"introuvable : {args[0]}")
    try:
        clair = c.dechiffrer(f)
    except c.ErreurChiffrement as e:
        sys.exit(str(e))
    try:
        r = subprocess.run(["tar", "-tzf" if liste else "-xzf", str(clair)] + ([] if liste else ["-C", racine]))
    finally:
        c.detruire_clair(clair)             # le temporaire, jamais une archive d'origine
    return r.returncode


def _donne_a_secubox(chemin: Path, mode: int) -> None:
    """Dossiers et archives appartiennent à `secubox` (l'API les liste, les vérifie, les nettoie) ; les droits restent 0750 / 0640."""
    try:
        pw = pwd.getpwnam("secubox")
        os.chown(chemin, pw.pw_uid, pw.pw_gid)
    except (KeyError, OSError):
        pass
    try:
        os.chmod(chemin, mode)
    except OSError:
        pass


def _json(ok: bool, fichier=None, erreur=None, chiffre=False) -> dict:
    return {"ok": ok, "fichier": fichier, "erreur": erreur, "chiffre": chiffre}


def archiver(kind, nom, chiffre, racine=None, chemins=None, run=subprocess.run, proprietaire=True,
             libre=shutil.disk_usage, popen=subprocess.Popen, intervalle=1.0) -> dict:
    """Crée UNE archive (config, services, ou un conteneur) sous racine/<sous-dossier>/ et la chiffre (ou, sur choix
    explicite, la laisse en clair en 0640). Échec = rien ne reste : ni archive tronquée, ni clair. Un conteneur arrêté
    pour la sauvegarde est TOUJOURS relancé, même si tar échoue."""
    racine = Path(racine) if racine else RACINE
    horodatage = time.strftime("%Y%m%d-%H%M%S")
    if kind == "config":
        sous, base, liste = "config", f"config-{horodatage}", chemins if chemins is not None else CONFIG_PATHS
    elif kind == "services":
        sous, base, liste = "services", f"services-{horodatage}", chemins if chemins is not None else SERVICE_PATHS
    elif kind == "conteneur":
        if not nom or not NOM.match(nom):
            return _json(False, erreur="nom de conteneur invalide (lettres, chiffres, . _ -)")
        sous, base, liste = "containers", f"{nom}-{horodatage}", None
        if not (LXC_PATH / nom / "config").exists():
            return _json(False, erreur=f"conteneur introuvable : {nom}")
    else:
        return _json(False, erreur="type inconnu")

    dossier = racine / sous
    dossier.mkdir(parents=True, exist_ok=True)
    if proprietaire:
        _donne_a_secubox(dossier, c.MODE_DOSSIER)
    archive = dossier / f"{base}.tar.gz"

    if libre(str(dossier)).free < RESERVE:
        return _json(False, erreur=f"espace disque insuffisant : moins de {RESERVE // MO} Mo libres sous {dossier}")

    if liste is not None:
        existants = [x for x in liste if os.path.exists(x)]
        if not existants:
            return _json(False, erreur="rien à sauvegarder : aucun des chemins n'existe")
        cmd = ["tar", "-czf", str(archive)] + existants
        arrete = False
    else:
        cmd = ["tar", "-czf", str(archive), "-C", str(LXC_PATH), nom]
        info = run(["lxc-info", "-P", str(LXC_PATH), "-n", nom, "-s"], capture_output=True, text=True, timeout=30)
        arrete = info.returncode == 0 and "RUNNING" in (info.stdout or "")
        if arrete:
            run(["lxc-stop", "-P", str(LXC_PATH), "-n", nom], capture_output=True, text=True, timeout=120)
    plein = False
    try:
        proc = popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        debut = time.time()
        while proc.poll() is None:
            if libre(str(dossier)).free < RESERVE // 2:
                plein = True
                proc.kill()
                break
            if time.time() - debut > 3600:
                proc.kill()
                break
            time.sleep(intervalle)
        proc.wait()
        stderr = ""
        try:
            stderr = proc.stderr.read() if getattr(proc, "stderr", None) else ""
        except (OSError, ValueError):
            pass
        code = proc.returncode
    finally:
        if arrete:
            run(["lxc-start", "-P", str(LXC_PATH), "-n", nom], capture_output=True, text=True, timeout=120)
    if plein:
        archive.unlink(missing_ok=True)
        return _json(False, erreur=f"espace disque insuffisant : sauvegarde interrompue sous {RESERVE // 2 // MO} Mo libres, archive partielle supprimée")
    # tar rend 1 pour « un fichier a changé pendant la lecture » : archive utilisable ; 2 et plus = échec
    if code not in (0, 1) or not archive.exists() or archive.stat().st_size == 0:
        archive.unlink(missing_ok=True)
        return _json(False, erreur=((stderr or "").strip()[-300:] or f"tar a échoué (code {code})"))

    if chiffre:
        try:
            final = c.chiffrer(archive)
        except c.ErreurChiffrement as e:
            return _json(False, erreur=str(e))
    else:
        final = archive
        try:
            os.chmod(final, c.MODE_FICHIER)
        except OSError:
            pass
    if proprietaire:
        _donne_a_secubox(final, c.MODE_FICHIER)
    return _json(True, fichier=final.name, chiffre=chiffre)


def main() -> int:
    a = sys.argv[1:]
    if not a or a[0] == "etat":
        return etat()
    if a[0] == "init-key":
        return init_key()
    if a[0] == "chiffrer-existantes":
        return chiffrer_existantes("--supprimer-clair" in a)
    if a[0] == "restaurer":
        return restaurer(a[1:])
    if a[0] == "archiver":
        # archiver config|services chiffre|clair   ou   archiver conteneur NOM chiffre|clair
        if len(a) == 3 and a[1] in ("config", "services") and a[2] in ("chiffre", "clair"):
            r = archiver(a[1], None, a[2] == "chiffre")
        elif len(a) == 4 and a[1] == "conteneur" and a[3] in ("chiffre", "clair"):
            r = archiver("conteneur", a[2], a[3] == "chiffre")
        else:
            print("usage : backupctl archiver {config|services} {chiffre|clair} | conteneur NOM {chiffre|clair}", file=sys.stderr)
            return 2
        print(json.dumps(r))
        return 0 if r["ok"] else 1
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main())
