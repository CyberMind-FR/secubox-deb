#!/bin/sh
# SecuBox-Deb :: secubox-bbs — postinst
set -e

# MIGRATION #3117 : le vhost était livré sous le nom de gk2. Idempotent.
#   $1 ancien nom de fichier  $2 nouveau nom  $3 ancien filtre d'exposition
#   (ou vide)  $4 nouveau filtre. L'ancien lien d'activation part ; l'ancien
# fichier part s'il est celui que le paquet avait livré (somme dpkg), sinon il
# est archivé dans /var/backups/nginx (0600) avec un avertissement : le fichier
# livré fait foi. Retourne 0 si l'ancien vhost était activé.
sbx_migrer_vhost() {
    _o="$1"; _n="$2"; _os="$3"; _ns="$4"; _act=1
    _av=/etc/nginx/sites-available; _en=/etc/nginx/sites-enabled
    _sn=/etc/nginx/snippets/exposure
    if [ -e "$_en/$_o" ] || [ -L "$_en/$_o" ]; then
        rm -f "$_en/$_o"; _act=0
    fi
    # Un lien posé à la main sous un AUTRE nom vers l'ancien fichier pendrait
    # une fois celui-ci retiré, et nginx -t échouerait pour toute la box.
    for _l in "$_en"/*; do
        [ -L "$_l" ] || continue
        case "$(readlink "$_l")" in
            "$_o"|*/"$_o") rm -f "$_l"; _act=0 ;;
        esac
    done
    if [ -f "$_av/$_o" ]; then
        _livre=$(dpkg-query -W -f='${Conffiles}\n' secubox-bbs 2>/dev/null \
                 | awk -v f="$_av/$_o" '$1 == f { print $2 }')
        _actuel=$(md5sum "$_av/$_o" | cut -d' ' -f1)
        if [ "$_livre" != "$_actuel" ]; then
            # Retouché par l'administrateur (ou origine inconnue) : ses lignes
            # sont ARCHIVÉES, jamais recopiées sur le fichier livré — elles
            # citeraient l'ancien nom (et l'ancien filtre d'exposition) et
            # nginx -t échouerait. Le fichier livré fait foi.
            _arch="/var/backups/nginx/$_o.$(date +%Y%m%d-%H%M%S)"
            mkdir -p /var/backups/nginx
            if cp -p "$_av/$_o" "$_arch" && chmod 0600 "$_arch"; then
                echo "secubox-bbs : l'ancien vhost $_o avait été modifié ; archivé dans $_arch, le fichier livré $_n est utilisé. Reportez-y vos retouches si besoin." >&2
            fi
        fi
        rm -f "$_av/$_o"
    fi
    # Le filtre d'exposition de l'opérateur suit le vhost.
    if [ -n "$_os" ] && [ -f "$_sn/$_os" ]; then
        if [ ! -f "$_sn/$_ns" ]; then mv -f "$_sn/$_os" "$_sn/$_ns"; else rm -f "$_sn/$_os"; fi
    fi
    return $_act
}

case "$1" in
  configure)
    # Compte de service dedie, sans shell ni repertoire personnel : le BBS ne
    # tourne pas en root, et son compte ne doit pas pouvoir servir a se
    # connecter a la machine.
    if ! getent passwd secubox-bbs >/dev/null; then
        adduser --system --group --no-create-home --home /var/lib/secubox/bbs \
                --shell /usr/sbin/nologin secubox-bbs >/dev/null
    fi
    # Le groupe `secubox` est partage : nginx doit pouvoir lire la socket.
    if getent group secubox >/dev/null; then
        adduser secubox-bbs secubox >/dev/null 2>&1 || true
    fi

    systemd-tmpfiles --create /usr/lib/tmpfiles.d/zz-secubox-bbs.conf >/dev/null 2>&1 || true

    # Cache des vignettes-snapshot d'URL (#1120). systemd-tmpfiles REFUSE de le
    # creer : il detecte une transition de propriete « non sure »
    # /var/cache/secubox (secubox) -> /bbs (secubox-bbs) et abandonne. On le pose
    # donc directement — le parent existe deja, la transition est voulue (chaque
    # module possede son sous-arbre, cf. RuntimeDirectory partage).
    if [ -d /var/cache/secubox/bbs ] || mkdir -p /var/cache/secubox/bbs 2>/dev/null; then
        mkdir -p /var/cache/secubox/bbs/urlshots
        chown secubox-bbs:secubox /var/cache/secubox/bbs/urlshots 2>/dev/null || true
        chmod 0750 /var/cache/secubox/bbs/urlshots 2>/dev/null || true
    fi

    # /etc/secubox/secrets est ferme : `group::---`, seuls le proprietaire et
    # des identifiants NOMMES par ACL peuvent le traverser. C'est voulu — le
    # repertoire contient les secrets de tous les modules.
    #
    # Notre service tourne sous son propre compte (separation de privileges),
    # il n'est donc ni le proprietaire ni membre utile du groupe. On lui ajoute
    # une ACL de TRAVERSEE SEULE (--x) : il peut descendre dans son propre
    # sous-repertoire sans pouvoir LISTER le contenu du parent, donc sans
    # apprendre quels autres modules y rangent quoi.
    #
    # L'alternative — desserrer le mode du parent, ou faire tourner le service
    # sous `secubox` — ouvrirait les secrets des autres modules pour resoudre
    # un probleme qui ne concerne que le notre.
    if [ -d /etc/secubox/secrets ] && command -v setfacl >/dev/null 2>&1; then
        # LE MASQUE, PAS SEULEMENT L'ENTREE (#1255). Une dizaine de paquets
        # font `install -d -m 0700` sur ce dossier PARTAGE, et tout chmod
        # ecrase le masque ACL a `---` : chaque entree nommee devient alors
        # `#effective:---` et cesse d'agir, sans que rien ne le signale. Le
        # service ne peut plus traverser et refuse de demarrer -- panne
        # constatee en production sur le BBS. On repose donc explicitement le
        # masque en meme temps que l'entree.
        setfacl -m u:secubox-bbs:--x,m::x /etc/secubox/secrets 2>/dev/null || \
            echo "secubox-bbs : ACL de traversee non posee sur /etc/secubox/secrets"
    fi
    if [ -d /etc/secubox/secrets/bbs ]; then
        chown secubox-bbs:secubox /etc/secubox/secrets/bbs
        chmod 0700 /etc/secubox/secrets/bbs
    fi

    # AUTO-REPARATION DES CORPS ILLISIBLES (#1114). Un `bbsctl ingest` lance A
    # LA MAIN en root cree des dossiers de fils et des corps en root:root :
    # intraversables/illisibles par le service, ils s'affichent comme « ce
    # message diverge de l'index » sur des fils entiers. On re-aligne tout ce qui
    # n'appartient pas au service sous son arborescence de donnees. Idempotent :
    # ne touche QUE le mal-possede, ne fait rien sur une installation neuve.
    for sous in content files; do
        d="/var/lib/secubox/bbs/$sous"
        [ -d "$d" ] || continue
        find "$d" \! -user secubox-bbs -exec chown secubox-bbs:secubox {} + \
            2>/dev/null || true
    done

    systemctl daemon-reload >/dev/null 2>&1 || true

    # PRESERVER L'ETAT : dpkg a envoye SIGTERM au service pendant la mise a
    # jour. `try-restart` le relance s'il tournait, et ne le demarre pas s'il
    # etait volontairement arrete. Un `start` inconditionnel ressusciterait un
    # service que l'operateur avait coupe.
    if systemctl is-enabled secubox-bbs.service >/dev/null 2>&1; then
        systemctl try-restart secubox-bbs.service >/dev/null 2>&1 || true
    fi

    # Vignettes urlshot (#1120) : contrairement au service principal et a
    # l'import (aucun compte requis), ce timer ne fait rien de nuisible sur
    # un BBS vide — il lit une file qui n'a pas encore de lignes. On l'active
    # et le demarre donc d'office, mais JAMAIS au prix de l'installation :
    # l'unite peut manquer (mise a jour partielle) ou systemd etre absent
    # (chroot de build) sans que `dpkg -i` echoue pour autant.
    systemctl enable --now secubox-bbs-urlshot.timer >/dev/null 2>&1 || true

    # LE VHOST EST ACTIVÉ PAR LE PAQUET (#1727). Il était livré dans
    # sites-available sans être activé (« activer demande HAProxy et le DNS »)
    # : gk2 l'avait par un lien posé à la main, gk3 rendait « Wrong Domain ».
    # Depuis #1682, l'exposition des nœuds relayés est la règle (vhosts x.*,
    # joker DNS-01, relais synchronisé). Service arrêté = 502, et le Hall garde
    # alors son repli sur le BBS d'un autre nœud. Un lien existant est laissé.
    #
    # #3117 : le vhost s'appelait bbs.gk2.conf (nom de gk2 livré à toutes les
    # boxes). L'ancien lien et l'ancien fichier partent ici, juste avant que le
    # nouveau lien soit posé : aucun `nginx -t` ne passe entre les deux.
    MIGRE=0
    sbx_migrer_vhost bbs.gk2.conf bbs.conf "" "" && MIGRE=1 || true
    if [ -f /etc/nginx/sites-available/bbs.conf ] && [ -d /etc/nginx/sites-enabled ] \
       && [ ! -e /etc/nginx/sites-enabled/bbs.conf ] && command -v nginx >/dev/null 2>&1; then
        ln -s ../sites-available/bbs.conf /etc/nginx/sites-enabled/bbs.conf
        if NT=$(nginx -t 2>&1); then
            :
        elif [ "$MIGRE" = 1 ]; then
            # Lien migré à l'instant : il ne doit PAS disparaître sur un échec
            # qui peut venir d'ailleurs ; le prochain rechargement réussi le prendra.
            echo "secubox-bbs: nginx -t a échoué, vhost laissé activé (migration #3117) : $NT" >&2
        else
            rm -f /etc/nginx/sites-enabled/bbs.conf
            echo "secubox-bbs: vhost refusé par nginx -t, non activé" >&2
        fi
    fi

    # La route nginx n'est rechargee que si la configuration est valide : un
    # `reload` sur une configuration cassee coupe TOUS les vhosts de la board.
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
        systemctl reload nginx >/dev/null 2>&1 || true
    fi

    if [ -z "$2" ]; then
        cat <<'FIN'

  secubox-bbs installe — le service n'est PAS demarre.

  Il n'a encore aucun compte : le demarrer ouvrirait un BBS ou personne ne
  peut entrer. Creez un sysop, puis activez :

    printf '%s' 'une phrase de passe assez longue' | bbsctl user-add gk2 sysop
    bbsctl salon atelier 'Atelier' 'Ce qui se repare le samedi'
    systemctl enable --now secubox-bbs

  L'inscription des autres se fait sur invitation :  bbsctl invite

FIN
    fi

    # ROUTE SBXWAF — POSEE PAR CE PAQUET (#1323), comme son vhost et son unite.
    # Sans elle, sbxwaf recoit un nom qu'il ne connait pas et rend 421, meme
    # si HAProxy dirige bien et que nginx sert bien. Cette table n'appartenait
    # a aucun paquet : 275 routes posees a la main, invisibles tant qu'elles
    # tiennent, fatales le jour ou l'une saute (vu sur podcaster).
    # L'outil vient de secubox-core, dont ce paquet depend deja ; le garde
    # `command -v` couvre l'ordre de configuration a la premiere installation.
    if command -v secubox-waf-route >/dev/null 2>&1; then
      secubox-waf-route "$(secubox-domaine bbs)" 9080 || true
    fi

    ;;
esac

#DEBHELPER#
exit 0
