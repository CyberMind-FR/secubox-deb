[Unit]
Description=SecuBox BBS — passerelles (billets, PeerTube, podcaster)
Documentation=file:///usr/share/doc/secubox-bbs/README.md
After=secubox-bbs.service

[Service]
Type=oneshot
User=secubox-bbs
Group=secubox
ExecStart=/usr/sbin/bbsctl ingest all
# Un import qui echoue ne doit pas alerter comme une panne : la source peut
# etre simplement arretee. Le journal d'import garde la trace, consultable par
# `bbsctl ingest-log`.
SuccessExitStatus=0 1

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/secubox/bbs /run/secubox
# La base du podcaster est lue EN LECTURE SEULE (mode=ro dans la connexion) ;
# aucun droit d'ecriture n'est accorde sur son repertoire.
