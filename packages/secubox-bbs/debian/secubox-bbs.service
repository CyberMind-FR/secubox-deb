[Unit]
Description=SecuBox BBS — forums, bibliotheque, publication
Documentation=file:///usr/share/doc/secubox-bbs/README.md
After=network.target
# `Wants` et non `Requires` : billets peut etre arrete sans que le BBS cesse de
# fonctionner. Seule la publication devient indisponible, et elle le dit.
Wants=secubox-billets.service

# AUCUNE OPTION DE BANNIERE ICI.
#
# La banniere de sante est ecartee A LA SOURCE par un `<meta
# name="sbx-no-health-banner">` dans le gabarit — le mecanisme prevu par
# sbxwaf pour « une page publique ou la banniere de l'operateur est du bruit ».
#
# Les options --banniere-* existent toujours pour un deploiement qui la
# voudrait, mais elles ne sont pas posees : sur une surface publique la
# banniere interroge des API d'administration, et autoriser ses empreintes
# lierait notre politique a SA version.

[Service]
Type=exec

# LE « + » FAIT TOURNER CETTE LIGNE EN ROOT, malgre User= plus bas.
#
# /run/secubox porte le bit collant (1777) et est partage par une centaine
# d'unites : dans un tel repertoire, seul le PROPRIETAIRE d'un fichier peut
# l'effacer. Une socket morte laissee par un autre compte — l'agregateur, une
# version anterieure — ne peut donc pas etre retiree par notre service, qui
# echoue alors sur « address already in use » sans pouvoir rien y faire.
#
# Constate au deploiement : le service redemarrait en boucle a cause d'un
# fichier de socket sans aucun processus derriere.
#
# Le « - » supplementaire tolere l'absence du fichier, cas normal.
ExecStartPre=+-/bin/rm -f /run/secubox/bbs.sock
User=secubox-bbs
Group=secubox
ExecStart=/usr/sbin/secubox-bbsd \
    --media-origines https://peertube.gk2.secubox.in,https://radio.gk2.secubox.in,https://podcaster.gk2.secubox.in,https://billets.gk2.secubox.in \
    --frame-origines https://radio.gk2.secubox.in,https://podcaster.gk2.secubox.in \
    --root /var/lib/secubox/bbs \
    --secrets /etc/secubox/secrets/bbs \
    --socket /run/secubox/bbs.sock \
    --backup-dir /var/backups/secubox \
    --auth-socket /run/secubox/auth.sock \
    --peertube-origine https://peertube.gk2.secubox.in \
    --podcast-racine /var/lib/secubox/podcaster/media,/data/secubox/podcaster
Restart=on-failure
RestartSec=5

# RuntimeDirectory n'est PAS declare : /run/secubox est partage par une
# centaine d'unites, et un `RuntimeDirectory=secubox` ici effacerait au
# redemarrage les sockets de toutes les autres. Le repertoire est pose par
# tmpfiles.d.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
# SORTIE RESEAU : ouverte a contrecoeur, et compensee (#1044).
#
# Jusqu'a la passerelle Mastodon, `AF_UNIX` seul suffisait : le service parlait a
# billets et a l'authentification par des sockets de fichier, et recevait ses
# requetes de nginx par la sienne. Aucune socket reseau, donc aucune surface.
#
# La passerelle change cela : relier un compte demande d'appeler l'instance —
# resolution de noms comprise, donc UDP. Sans AF_INET, l'appel echoue sur
# « address family not supported by protocol », un message qui designe le DNS
# alors que le refus vient d'ici. C'est precisement ce qui s'est produit au
# premier essai.
#
# CE QUI COMPENSE, ET POURQUOI C'EST A DEUX ETAGES. L'instance est TAPEE PAR LE
# MEMBRE : la surface ouverte est donc dirigeable depuis un formulaire. Le
# paquet `internal/mastodon` refuse deja toute adresse interne sauf l'instance
# configuree, et ne suit aucune redirection. Les regles ci-dessous rejouent la
# meme politique DANS LE NOYAU, ou aucune erreur de code applicatif ne peut la
# contourner.
#
# Volontairement SYMBOLIQUES et non chiffrees : une unite de paquet ne doit
# porter aucune adresse de site. `localhost` ferme les services d'administration
# qui n'ecoutent que sur la boucle ; `link-local` ferme 169.254.169.254, la
# cible classique de ce genre d'attaque. Les plages privees restent joignables
# — l'instance de la maison y vit — et c'est le controle applicatif qui tranche
# la, puisque lui seul sait laquelle est configuree.
#
# Un site plus strict pose un drop-in avec ses propres `IPAddressAllow=`.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=any
IPAddressDeny=localhost link-local multicast
ReadWritePaths=/var/lib/secubox/bbs /run/secubox /var/backups/secubox
# Les secrets sont montes EN LECTURE SEULE : le service verifie des mots de
# passe, il n'a pas a reecrire le fichier hors d'une action explicite.
ReadWritePaths=/etc/secubox/secrets/bbs
# Le parc du podcaster est lu, jamais ecrit : les episodes sont deja
# telecharges, on les sert. ProtectSystem=strict laisse le reste du systeme
# lisible, aucune declaration supplementaire n'est necessaire — mais ce
# commentaire dit ou l'on va chercher, pour que personne ne l'oublie en
# durcissant davantage.

[Install]
WantedBy=multi-user.target
