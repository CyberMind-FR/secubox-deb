#!/bin/bash
set -e
PREFIX=/usr/lib/secubox/billets
DATA=/var/lib/secubox/billets
case "$1" in
  configure)
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home --home /var/lib/secubox \
        --shell /usr/sbin/nologin secubox

    install -d -o root -g root -m 1777 /run/secubox
    install -d -o secubox -g secubox -m 0755 "$DATA" "$DATA/revisions"
    # Parent 0755 (traversable), secrets dir 0700 secubox.
    install -d -o secubox -g secubox -m 0755 /etc/secubox
    install -d -o secubox -g secubox -m 0700 /etc/secubox/secrets

    # Signing secret, once, 0600 secubox.
    if [ ! -s /etc/secubox/secrets/billets ]; then
      ( umask 077; head -c 48 /dev/urandom | base64 | tr -d '\n' > /etc/secubox/secrets/billets )
      chown secubox:secubox /etc/secubox/secrets/billets
      chmod 0600 /etc/secubox/secrets/billets
    fi

    # Python venv with pinned deps (needs network or a local wheelhouse).
    if [ ! -x "$PREFIX/venv/bin/python" ]; then
      python3 -m venv "$PREFIX/venv"
    fi
    "$PREFIX/venv/bin/pip" install --upgrade pip >/dev/null 2>&1 || true
    "$PREFIX/venv/bin/pip" install -r "$PREFIX/requirements.txt" \
      || echo "billets: pip install failed — install deps into $PREFIX/venv then 'systemctl restart secubox-billets'" >&2

    # Expose the system-installed secubox_core (shared lib, .deb-managed) to the
    # isolated venv so the JWT admin surface (api/routes/jwt_admin.py) can import
    # require_jwt. A sorted-last .pth APPENDS dist-packages: venv wheels keep
    # precedence (fastapi/pydantic are NOT shadowed by the older system copies).
    SITEPKG="$("$PREFIX/venv/bin/python" -c 'import site; print(site.getsitepackages()[0])' 2>/dev/null)"
    if [ -n "$SITEPKG" ] && [ -d "$SITEPKG" ]; then
      echo /usr/lib/python3/dist-packages > "$SITEPKG/zz-secubox-system.pth"
    fi
    chown -R secubox:secubox "$PREFIX"

    # nginx must read the uvicorn socket (group secubox).
    getent group secubox >/dev/null && adduser www-data secubox >/dev/null 2>&1 || true
    if [ ! -e /etc/nginx/sites-enabled/billets.conf ] && [ -e /etc/nginx/sites-available/billets.conf ]; then
      ln -s ../sites-available/billets.conf /etc/nginx/sites-enabled/billets.conf 2>/dev/null || true
    fi

    # ── LE PAQUET DÉCLARE SA PROPRE ROUTE (#1356) ────────────────────────
    #
    # `billets.gk2.secubox.in` n'avait AUCUNE entrée dans la table de sbxwaf.
    # Le nom lui était donc inconnu, et il l'envoyait dans son fourre-tout —
    # lequel aboutit sur un « / » gardé. Résultat : un 401 qui accuse le mode
    # tableau de bord, alors que le vhost de billets répondait parfaitement
    # 200 sur son port. On cherche le défaut dans l'authentification pendant
    # que la cause est dans le routage.
    #
    # La table n'appartenait à aucun paquet : des centaines de routes posées à
    # la main au fil des années, invisibles tant que ça tient, fatales le jour
    # où une entrée manque. `secubox-waf-route` (secubox-core) fait la fusion
    # idempotente — le paquet qui possède le service possède sa route.
    HOTE=billets.gk2.secubox.in

    # PAS DE FILTRE D'EXPOSITION SEMÉ ICI, ET C'EST UN CHOIX (#1356).
    # J'en avais posé un, puis mesuré : `billets.conf` ne l'inclut nulle part.
    # Un fichier que personne ne lit est une déclaration morte — elle rassure
    # à la lecture et ne protège rien, ce qui est pire que son absence.
    #
    # Et l'inclure changerait la donne sans qu'on l'ait demandé : billets est
    # déclaré `enabled`, `ssl` et `cadrable` dans haproxy.toml, c'est un site
    # PUBLIÉ. Le restreindre au LAN casserait sa raison d'être. L'exposition de
    # ce domaine se décide dans HAProxy, pas dans un snippet inerte.

    # ON NE ROUTE QUE SI NGINX ACCEPTE SA CONFIGURATION. Router vers un vhost
    # que nginx refuse de charger échange un 421 contre un 502, ce qui n'est
    # pas un progrès.
    if nginx -t >/dev/null 2>&1; then
        systemctl reload nginx 2>/dev/null || true
        if command -v secubox-waf-route >/dev/null 2>&1; then
            secubox-waf-route "$HOTE" 8910 || true
        fi
    else
        echo "secubox-billets: nginx -t echoue — route sbxwaf NON posee" >&2
    fi
    ;;
esac
#DEBHELPER#
case "$1" in
  configure)
    systemctl reload nginx 2>/dev/null || true
    echo "billets: create the first author with:" >&2
    echo "  sudo -u secubox $PREFIX/venv/bin/python -m api.manage create-author admin  (run in $PREFIX)" >&2
    ;;
esac
exit 0
