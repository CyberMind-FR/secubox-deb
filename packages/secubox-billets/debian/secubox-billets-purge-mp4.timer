[Unit]
Description=SecuBox billets — purge quotidienne des MP4 anciens (#4058)

[Timer]
OnCalendar=*-*-* 04:20:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
