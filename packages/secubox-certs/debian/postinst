#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    install -d -o root -g root -m 1777 /run/secubox
    install -d -m 0755 /var/cache/secubox/certs
    systemctl daemon-reload || true
    systemctl enable --now secubox-certs.service || true
    # Minuteur de deploiement (#991) : le maillon qui manquait entre acme.sh et
    # les pem servis par HAProxy. `--now` pour que le premier passage ramasse
    # tout ce qu'acme.sh a deja renouvele sans avoir jamais pu le livrer.
    systemctl enable --now secubox-certs-deploy.timer || true
fi
# #1819 : le renouvellement passe par secubox-certbot ; un échec passé
# (dérive pip) n'a plus à rester affiché.
if [ "$1" = configure ]; then
    systemctl daemon-reload 2>/dev/null || true
    systemctl reset-failed certbot.service 2>/dev/null || true
fi

#DEBHELPER#
exit 0
