#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	# Host control plane (FastAPI)
	install -d debian/secubox-certs/usr/lib/secubox/certs
	cp -r api debian/secubox-certs/usr/lib/secubox/certs/
	# Web UI
	install -d debian/secubox-certs/usr/share/secubox/www/certs
	cp -r www/certs/. debian/secubox-certs/usr/share/secubox/www/certs/
	# Menu entry
	install -d debian/secubox-certs/usr/share/secubox/menu.d
	install -m 644 menu.d/36-certs.json debian/secubox-certs/usr/share/secubox/menu.d/36-certs.json
	# nginx snippet (canonical hub vhost — installed to both secubox.d/ and
	# secubox-routes.d/ per the v2.11.1 convention)
	install -d debian/secubox-certs/etc/nginx/secubox.d
	install -m 644 nginx/certs.conf debian/secubox-certs/etc/nginx/secubox.d/certs.conf
	install -d debian/secubox-certs/etc/nginx/secubox-routes.d
	install -m 644 nginx/certs.conf debian/secubox-certs/etc/nginx/secubox-routes.d/certs.conf
	# Deploiement des certificats vers HAProxy (#991) : le maillon qui
	# manquait entre acme.sh et les pem servis.
	install -d debian/secubox-certs/usr/sbin
	install -m 0755 sbin/certsctl debian/secubox-certs/usr/sbin/certsctl
	install -d debian/secubox-certs/usr/lib/systemd/system
	install -m 0644 debian/secubox-certs-deploy.service debian/secubox-certs/usr/lib/systemd/system/
	install -m 0644 debian/secubox-certs-deploy.timer debian/secubox-certs/usr/lib/systemd/system/
