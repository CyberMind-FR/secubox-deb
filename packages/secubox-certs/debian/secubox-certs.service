[Unit]
Description=SecuBox Certificate Manager API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/lib/secubox/certs
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/certs.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/certs.sock
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
