# Profil AppArmor ENFORCE de secubox-dns-listes (#3205), attaché au chemin de la commande. Il LIT les sources et
# unbound.conf.d, n'ÉCRIT que 92-secubox-listes.conf (et ne retire que les trois anciens fichiers de listes), son état,
# son verrou et l'audit ; vérifie puis recharge Unbound. Aucun shell, aucun sudo, aucun secret.

#include <tunables/global>

/usr/sbin/secubox-dns-listes {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>      # unbound-checkconf résout l'utilisateur « unbound »

  /usr/sbin/secubox-dns-listes r,
  /usr/bin/python3* rix,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,

  /etc/secubox/dns-listes.toml r,
  deny /etc/secubox/secrets/** r,

  /var/lib/secubox/dns-listes/ rw,
  /var/lib/secubox/dns-listes/** rwk,
  /run/lock/secubox-dns-listes.lock rwk,
  /var/log/secubox/audit.log w,

  /etc/unbound/** r,
  /etc/unbound/unbound.conf.d/ r,
  /etc/unbound/unbound.conf.d/92-secubox-listes.conf rw,
  /etc/unbound/unbound.conf.d/93-secubox-webfilter.conf rw,
  /etc/unbound/unbound.conf.d/95-secubox-adblock.conf rw,
  /etc/unbound/unbound.conf.d/96-secubox-adult.conf rw,
  /etc/unbound/unbound.conf.d/.sbx-* rw,
  /var/lib/unbound/** r,

  /usr/sbin/unbound-checkconf rix,
  /usr/sbin/unbound-control rix,

  capability dac_override,
  capability dac_read_search,
  network inet stream,
  network inet6 stream,
  network unix stream,
}
