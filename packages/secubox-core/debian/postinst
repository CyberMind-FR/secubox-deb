#!/bin/bash
set -e

case "$1" in
  configure)
    # /run/secubox PARTAGÉ (#1022, #1682). L'image « live USB » posait sur ~30
    # unités une surcharge `RuntimeDirectory=secubox` et un
    # /etc/tmpfiles.d/secubox.conf en 0775 secubox : chaque démarrage d'unité
    # réattribuait TOUT le répertoire à son utilisateur, et les sockets 0660
    # des autres devenaient illisibles pour nginx (502). On ne retire QUE les
    # fichiers identiques à ce qu'écrivait l'image (sauvegardés), puis on relance
    # les unités concernées pour qu'elles recréent leurs sockets à leur nom.
    RT_SAUVE=/var/backups/secubox-runtime-conf
    RT_UNITES=""
    for f in /etc/systemd/system/secubox-*.service.d/runtime.conf; do
      [ -f "$f" ] || continue
      grep -q "Fix for namespace issues with /run/secubox" "$f" || continue
      corps="$(grep -vE '^[[:space:]]*(#|$)' "$f" | tr -d ' \t' | LC_ALL=C sort | tr '\n' ';')"
      [ "$corps" = "RuntimeDirectory=secubox;RuntimeDirectoryMode=0775;RuntimeDirectoryPreserve=yes;[Service];" ] || continue
      d="$(dirname "$f")"; u="$(basename "$d" .d)"
      mkdir -p "$RT_SAUVE"
      cp -p "$f" "$RT_SAUVE/$u.runtime.conf"
      rm -f "$f"
      rmdir "$d" 2>/dev/null || true
      RT_UNITES="$RT_UNITES $u"
    done
    if [ -f /etc/tmpfiles.d/secubox.conf ] \
       && [ "$(grep -vE '^[[:space:]]*(#|$)' /etc/tmpfiles.d/secubox.conf | tr -s ' ')" = "d /run/secubox 0775 secubox secubox -" ]; then
      mkdir -p "$RT_SAUVE"
      mv /etc/tmpfiles.d/secubox.conf "$RT_SAUVE/tmpfiles-secubox.conf"
      RT_UNITES="$RT_UNITES "
    fi
    # SOCKETS MAL ATTRIBUÉS (#1682). Dans /run/secubox redevenu 1777, un service
    # ne peut plus effacer un socket qu'une autre unité s'est vu attribuer : il
    # échoue à se lier et redémarre en boucle. On retire (a) les sockets sans
    # processus à l'écoute — morts — et (b) ceux dont le propriétaire n'est pas
    # le processus qui les écoute, en relançant son unité. Rien d'autre.
    RT_SOCK=""
    if [ -d /run/secubox ] && command -v ss >/dev/null && command -v python3 >/dev/null; then
      RT_SOCK="$(python3 - <<'PY'
import os, re, socket, stat, subprocess, sys

def abandon(motif):
    print(f"secubox-core : sockets de /run/secubox non vérifiées ({motif}) : rien n'est retiré", file=sys.stderr)
    raise SystemExit(0)

presentes = {}
for n in os.listdir("/run/secubox"):
    p = os.path.join("/run/secubox", n)
    try:
        st = os.lstat(p)
    except OSError:
        continue
    if stat.S_ISSOCK(st.st_mode):
        presentes[p] = st
if not any(st.st_uid for st in presentes.values()):
    raise SystemExit(0)
# #3938 : sans relevé SÛR, rien n'est retiré (un ss muet faisait passer toutes les sockets pour mortes : 502 partout).
try:
    res = subprocess.run(["ss", "-xlpn"], capture_output=True, text=True, timeout=20)
except (OSError, subprocess.SubprocessError) as e:
    abandon(f"ss : {e.__class__.__name__}")
if res.returncode != 0:
    abandon(f"ss : code {res.returncode}")
listees, ecoute = set(), {}
for l in res.stdout.splitlines():
    m = re.search(r"(/run/secubox/[^\s]+\.sock)\s", l)
    if m:
        listees.add(m.group(1))
        q = re.search(r"pid=(\d+)", l[m.end():])
        if q:
            ecoute.setdefault(m.group(1), int(q.group(1)))
if not listees & set(presentes):
    abandon("ss ne montre aucune socket connue à l'écoute")

def refusee(p):
    """Vrai si personne n'écoute : le noyau lui-même refuse la connexion."""
    c = socket.socket(socket.AF_UNIX)
    c.settimeout(2)
    try:
        c.connect(p)
    except ConnectionRefusedError:
        return True
    except OSError:
        return False
    finally:
        c.close()
    return False

unites = set()
for p, st in presentes.items():
    if st.st_uid == 0:
        continue
    pid = ecoute.get(p)
    try:
        if pid is None:
            if p not in listees and refusee(p):
                os.unlink(p)                       # mort : personne n'écoute
            continue
        uid = int(open(f"/proc/{pid}/status").read().split("Uid:")[1].split()[0])
        cg = open(f"/proc/{pid}/cgroup").read()
        if uid != 0 and uid != st.st_uid:
            m = re.search(r"/([^/\n]+\.service)", cg)
            # l'agrégateur (4 à 8 min d'arrêt) : seulement pour SA socket
            if m and (m.group(1) != "secubox-aggregator.service" or p == "/run/secubox/aggregator.sock"):
                os.unlink(p)
                unites.add(m.group(1))
    except (OSError, IndexError, ValueError):
        continue
print(" ".join(sorted(unites)))
PY
)" || RT_SOCK=""
      RT_UNITES="$RT_UNITES $RT_SOCK"
    fi
    if [ -n "${RT_UNITES// /}" ] || [ "$(stat -c %a /run/secubox 2>/dev/null)" != 1777 ]; then
      systemctl daemon-reload 2>/dev/null || true
      if [ -d /run/secubox ]; then chown root:root /run/secubox; chmod 1777 /run/secubox; fi
      # --no-block : la relance ne doit pas suspendre dpkg. SEULEMENT les unités dont une socket vient d'être retirée
      # (#3938) : les autres, dont l'agrégateur, gardent la leur et continuent de servir.
      # shellcheck disable=SC2086
      [ -n "${RT_SOCK// /}" ] && systemctl --no-block try-restart $RT_SOCK 2>/dev/null || true
    fi

    # CADENCE (#1650) : des copies MANUELLES des surcharges de cadence, posées
    # dans /etc lors de l'incident du 2026-08-12, masquent celles du paquet
    # (même nom de fichier) — sans la remise à zéro. On ne retire QUE ces
    # copies-là, reconnaissables à leur marque ; le reste de /etc est à l'opérateur.
    for f in /etc/systemd/system/*.timer.d/10-cadence.conf; do
        [ -f "$f" ] || continue
        u="$(basename "$(dirname "$f")")"
        if grep -q "incident de charge du 2026-08-12" "$f" \
           && [ -f "/lib/systemd/system/$u/10-cadence.conf" ]; then
            rm -f "$f"; rmdir --ignore-fail-on-non-empty "$(dirname "$f")" 2>/dev/null || true
        fi
    done
    systemctl daemon-reload 2>/dev/null || true
    # ── Utilisateur système ──
    if ! id -u secubox >/dev/null 2>&1; then
      adduser --system --group --no-create-home \
        --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    fi

    # ── Répertoires ──
    # /etc/secubox MUST be world-traversable (0755): non-secubox daemons
    # need to read their conf files under it (dnsmasq for secubox-eye-remote,
    # hostapd/wpa_supplicant for secubox-mesh, etc.). 0750 blocks traversal
    # even with world-readable files inside, causing daemon startup failures
    # (see #468). Sensitive content lives in /etc/secubox/secrets (0700
    # secubox:secubox), so opening the parent dir does NOT leak secrets.
    install -d -o secubox -g secubox -m 755 /etc/secubox
    install -d -m 1777 /run/secubox  # World-writable for all service sockets
    # Same reasoning as /etc/secubox above: these SHARED parents must be 0755 so
    # every secubox-* daemon (running as its own user, not in group secubox) can
    # traverse to its own subtree. 0750 here broke kbin/toolbox repeatedly
    # (#626/#630). Per-module leaves + secrets stay restricted.
    install -d -o secubox -g secubox -m 755 /var/lib/secubox
    install -d -o secubox -g secubox -m 755 /usr/share/secubox/www

    # ── tmpfiles.d for persistent /run/secubox ──
    # #494: drop a stale, non-dpkg-owned /etc/tmpfiles.d/secubox.conf left over
    # from an old manual fix — it declares /run/secubox as 0775 secubox secubox
    # and, because /etc overrides /usr/lib, it contradicts the canonical rule
    # (/usr/lib/tmpfiles.d/secubox.conf: 1777 root root). Only remove it if it
    # is NOT owned by any package and carries that bad declaration.
    if [ -f /etc/tmpfiles.d/secubox.conf ] \
       && ! dpkg -S /etc/tmpfiles.d/secubox.conf >/dev/null 2>&1 \
       && grep -qE '/run/secubox[[:space:]]+0?775[[:space:]]+secubox' /etc/tmpfiles.d/secubox.conf; then
      rm -f /etc/tmpfiles.d/secubox.conf
    fi
    systemd-tmpfiles --create 2>/dev/null || true

    # ── Config initiale si absente ──
    if [ ! -f /etc/secubox/secubox.conf ]; then
      install -o secubox -g secubox -m 640 \
        /usr/share/secubox-core/secubox.conf.example \
        /etc/secubox/secubox.conf
    fi

    # ── Identité de la box (absorbe secubox-defaults, #2050 N1) ──
    # L'aligneur nomme CETTE box d'après secubox-domaine (#1841, #1845). Le déclencheur ne part QUE si le
    # fichier a changé : sinon haproxy régénérerait sa configuration à chaque montée de core.
    if [ -x /usr/sbin/secubox-defaults-aligner ]; then
      _avant=$(cksum < /etc/default/secubox 2>/dev/null || true)
      /usr/sbin/secubox-defaults-aligner || true
      _apres=$(cksum < /etc/default/secubox 2>/dev/null || true)
      if [ "$_avant" != "$_apres" ]; then
        dpkg-trigger secubox-defaults-changed || true
      fi
    fi

    # ── Nginx ──
    # The /etc/nginx/sites-available/secubox file ships with three server
    # blocks bound to 80/443 — fine for standalone-nginx topologies, fatal
    # on HAProxy-fronted boards where HAProxy already owns 80/443.
    # Only install it on first install (when the file doesn't exist).
    # Subsequent installs/upgrades keep the operator-tuned variant intact.
    # See issue #162.
    if [ -d /etc/nginx/sites-available ]; then
      if [ ! -f /etc/nginx/sites-available/secubox ]; then
        install -m 644 /usr/share/secubox-core/nginx/secubox.conf \
          /etc/nginx/sites-available/secubox
      fi
      # SNIPPET COMMUN DES RELAIS (#3938) — CONTENU FINAL POSÉ D'UN COUP, directive du verdict LAN comprise (#1256).
      #
      # Il était réécrit SANS la directive, puis elle n'était remise que si `nginx -t` passait, motif caché : un refus
      # sans rapport la perdait (plus de mode tableau de bord). Renommage atomique, `nginx -t`, et l'ancien fichier
      # revient s'il est refusé.
      #
      # `$lan_client` vient de conf.d/secubox-lan-geo.conf, livre par secubox-hub. hub depend de core, donc core ne peut
      # pas dependre de hub : sur une board sans ce fichier, la ligne ferait echouer `nginx -t` et casserait TOUTE la
      # configuration nginx. Dans ce cas SEULEMENT (variable inconnue, dit par nginx) le modèle est posé sans elle ;
      # require_lecture ne voit alors aucune marque LAN et exige un jeton : on perd un affichage, pas une barriere.
      # La directive, pas la chaine (#1351) : le modele la nomme dans un commentaire.
      _modele=/usr/share/secubox-core/nginx/secubox-proxy.conf
      _snip=/etc/nginx/snippets/secubox-proxy.conf
      _sbx_neuf="$(mktemp /etc/nginx/snippets/.secubox-proxy.XXXXXX)"
      cat "$_modele" > "$_sbx_neuf"
      if ! grep -qE '^[[:space:]]*proxy_set_header[[:space:]]+X-SecuBox-LAN' "$_sbx_neuf"; then
        printf 'proxy_set_header   X-SecuBox-LAN     $lan_client;\n' >> "$_sbx_neuf"
      fi
      chmod 644 "$_sbx_neuf"
      if [ -f "$_snip" ] && cmp -s "$_sbx_neuf" "$_snip"; then
        rm -f "$_sbx_neuf"
      else
        _sbx_avant=""
        if [ -f "$_snip" ]; then
          _sbx_avant="$(mktemp /etc/nginx/snippets/.secubox-proxy.XXXXXX)"
          cp -p "$_snip" "$_sbx_avant"
        fi
        mv -f "$_sbx_neuf" "$_snip"
        if ! _sbx_motif="$(nginx -t 2>&1)"; then
          echo "secubox-core : nginx refuse le nouveau secubox-proxy.conf : $(printf '%s\n' "$_sbx_motif" | grep -m1 emerg || printf '%s\n' "$_sbx_motif" | tail -n 1)" >&2
          _sbx_sans=0
          if [ -z "$_sbx_avant" ]; then
            _sbx_sans=1
          elif printf '%s' "$_sbx_motif" | grep -q 'unknown "lan_client" variable'; then
            _sbx_sans=1
          fi
          if [ "$_sbx_sans" = 1 ]; then
            _sbx_neuf="$(mktemp /etc/nginx/snippets/.secubox-proxy.XXXXXX)"
            cat "$_modele" > "$_sbx_neuf"
            chmod 644 "$_sbx_neuf"
            mv -f "$_sbx_neuf" "$_snip"
            if [ -z "$_sbx_avant" ] || nginx -t >/dev/null 2>&1; then
              echo "secubox-core : secubox-proxy.conf posé sans le verdict LAN (\$lan_client) : mode tableau de bord inactif," \
                   "les lectures exigeront un jeton (secubox-hub le remet)" >&2
              if [ -n "$_sbx_avant" ]; then rm -f "$_sbx_avant"; _sbx_avant=""; fi
            fi
          fi
          if [ -n "$_sbx_avant" ]; then
            mv -f "$_sbx_avant" "$_snip"
            _sbx_avant=""
            echo "secubox-core : ancien secubox-proxy.conf gardé tel quel" >&2
          fi
        fi
        if [ -n "$_sbx_avant" ]; then rm -f "$_sbx_avant"; fi
      fi
      install -m 644 /usr/share/secubox-core/nginx/secubox-api-aggregator.conf \
        /etc/nginx/snippets/secubox-api-aggregator.conf

      # ROUTE /api/ DES SITES DÉJÀ INSTALLÉS (#1537). Le site « secubox » n'est
      # posé qu'à la première installation ; ceux d'avant ne routaient aucune
      # API agrégée. On ajoute l'include après chaque secubox.d/*.conf, on teste,
      # et on revient en arrière si nginx refuse (ex. une route /api/ existe déjà).
      _site=/etc/nginx/sites-available/secubox
      if [ -f "$_site" ] && ! grep -q 'secubox-api-aggregator.conf' "$_site" \
         && grep -q 'include /etc/nginx/secubox.d/\*.conf;' "$_site"; then
        cp -a "$_site" "$_site.sbxbak"
        sed -i 's|^\([[:space:]]*\)include /etc/nginx/secubox.d/\*.conf;|&\n\1include /etc/nginx/snippets/secubox-api-aggregator.conf;   # #1537|' "$_site"
        if nginx -t 2>/dev/null; then
          rm -f "$_site.sbxbak"
          systemctl reload nginx 2>/dev/null || true
          echo "secubox-core : route /api/ vers l'agrégateur ajoutée au site secubox"
        else
          mv -f "$_site.sbxbak" "$_site"
          echo "secubox-core : route /api/ non ajoutée (nginx -t refuse) — site inchangé" >&2
        fi
      fi

      # Symlink only on first install — never overwrite an existing one
      # (which may point at an HAProxy-aware variant like secubox-local).
      # JAMAIS derriere HAProxy (#2050) : un lien absent y est voulu par l'operateur ;
      # la vhost standard ecoute sur 80/443, HAProxy les tient, et nginx ne peut plus
      # recharger aucune configuration (bind() failed) — constate sur gk3.
      _haproxy_devant=0
      if command -v haproxy >/dev/null 2>&1 || [ -f /etc/haproxy/haproxy.cfg ]; then
        _haproxy_devant=1
      fi
      if [ ! -e /etc/nginx/sites-enabled/secubox ] && [ "$_haproxy_devant" = 0 ]; then
        ln -s /etc/nginx/sites-available/secubox \
              /etc/nginx/sites-enabled/secubox
      fi
      rm -f /etc/nginx/sites-enabled/default

      install -d -m 755 /etc/nginx/secubox.d

      # RETIRER LES RESIDUS dpkg DE sites-enabled (#1294).
      #
      # Le nginx.conf de Debian fait `include /etc/nginx/sites-enabled/*;` —
      # un glob NU. Il avale donc les `.dpkg-new` / `.dpkg-old` qu'un conflit
      # de conffile depose a cote du fichier actif. Nos propres inclusions
      # (`secubox.d/*.conf`) y echappent grace au suffixe ; celle de Debian,
      # non.
      #
      # UN SEUL de ces residus suffit a empecher nginx de demarrer, et il
      # survit au retrait du paquet qui l'a engendre : plus personne ne le
      # possede, donc aucun postrm ne le nettoie. Constate sur une image
      # trixie, ou un hall.gk2.net.conf.dpkg-new orphelin referencait un
      # `$lan_client` dont le bloc geo etait parti avec son paquet :
      #   [emerg] unknown "lan_client" variable — configuration test failed
      # nginx etait installe ET active, et refusait simplement de demarrer.
      #
      # On ARCHIVE au lieu de supprimer : un fichier qu'aucun paquet ne
      # possede peut porter une configuration qu'un operateur voudra relire.
      _residus=""
      for _f in /etc/nginx/sites-enabled/*.dpkg-new \
                /etc/nginx/sites-enabled/*.dpkg-old \
                /etc/nginx/sites-enabled/*.dpkg-dist; do
        [ -e "$_f" ] || continue
        install -d -m 755 /var/backups/secubox/nginx-residus
        if mv -f "$_f" /var/backups/secubox/nginx-residus/ 2>/dev/null; then
          _residus="${_residus} $(basename "$_f")"
        fi
      done
      if [ -n "$_residus" ]; then
        echo "secubox-core: residus dpkg ecartes de sites-enabled :${_residus}" >&2
        echo "secubox-core: archives dans /var/backups/secubox/nginx-residus/" >&2
      fi

      # Only reload nginx if the resulting config is valid. On HAProxy
      # boards the operator-tuned file is preserved, so this passes; on
      # standalone boards the freshly-installed file is also valid.
      if nginx -t 2>/dev/null; then
        systemctl reload nginx 2>/dev/null || true
      else
        echo "secubox-core: nginx -t failed, skipping reload (preserving running config)" >&2
      fi
    fi

    # JETONS DÉJÀ ÉCRITS DANS LES JOURNAUX (#3691) : le format masque les jetons à partir du rechargement ci-dessus ;
    # ce qui a été journalisé avant est masqué ici, à longueur égale (idempotent, sans effet sur un journal propre).
    # Hors de dpkg (#3938) : toutes les archives .gz sont relues ; l'unité (Nice, E/S au repos) s'en charge, résultat au journal.
    if [ -d /run/systemd/system ]; then
      systemctl start --no-block secubox-masquer-jetons-journaux.service \
        || echo "secubox-core : masquage des jetons des journaux nginx non lancé (repris par la minuterie horaire)" >&2
    else
      /usr/sbin/secubox-masquer-jetons-journaux || echo "secubox-core : masquage des jetons des journaux nginx incomplet (voir ci-dessus)" >&2
    fi
    # puis toutes les heures : journaux d'erreurs et sites au format « combined », hors de portée du format masqué
    systemctl enable --now secubox-masquer-jetons-journaux.timer 2>/dev/null || true

    systemctl daemon-reload

    # Enable runtime directory service (ensures /run/secubox exists before other services)
    systemctl enable --now secubox-runtime.service 2>/dev/null || true
    # ACTIVÉE, PAS DÉMARRÉE : l'initialisation appartient au démarrage, pas à
    # l'installation d'un paquet. Sur une box déjà initialisée le
    # `ConditionPathExists=!` la rend inerte, donc l'activation est sûre ici.
    systemctl enable secubox-firstboot.service 2>/dev/null || true
    systemctl enable secubox-secrets-premier.service 2>/dev/null || true

    # SSH (#2528) : le drop-in sshd_config.d vient d'etre pose ou mis a jour ; on ne recharge ssh QUE si la configuration
    # entiere est valide (un fichier defectueux ne doit jamais couper l'acces distant).
    if [ -x /usr/sbin/sshd ] && [ -f /etc/ssh/sshd_config.d/20-secubox-root-lan.conf ]; then
        if /usr/sbin/sshd -t 2>/dev/null; then
            systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
        else
            echo "secubox-core: sshd -t refuse la configuration, ssh non recharge" >&2
        fi
    fi

    # Shared-dir traversal guard (#630): self-heals the recurring 0750 clobber
    # (from this and other module postinsts) that breaks kbin/toolbox.
    systemctl enable --now secubox-dirs-guard.timer 2>/dev/null || true

    # GARDE DES MINUTERIES (#3692) : dh_installsystemd --no-start arrête les unités d'un paquet pendant sa mise à jour et
    # ne les relance pas ; trois minuteries de gk2 sont restées mortes des jours sans un mot. Le garde relance toute
    # minuterie SecuBox ACTIVÉE restée arrêtée (audit), maintenant puis toutes les 10 min.
    systemctl enable --now secubox-minuteries-garde.timer 2>/dev/null || true
    /usr/sbin/secubox-minuteries-garde || echo "secubox-core : garde des minuteries : relance incomplète (voir ci-dessus)" >&2
    systemctl start secubox-dirs-guard.service 2>/dev/null || true

    # Listes DNS compilees par etiquettes (#3205). Le profil AppArmor AVANT le service ; la premiere passe (adoption des
    # anciens fichiers webfilter/adblock/adult, compilation de quelques minutes) est lancee SANS l'attendre : apt ne bloque pas.
    # L'arbre est à root et HORS de /var/lib/secubox (compte partagé « secubox » : il pourrait renommer un sous-dossier
    # root et le remplacer). Seul 1.8.0 l'avait mis sous /var/lib/secubox/dns-listes : en montant DEPUIS 1.8.0, ses sources
    # sont reprises en descendant dossier par dossier (O_DIRECTORY|O_NOFOLLOW, root, fermé en écriture), fichier ouvert
    # O_NONBLOCK|O_NOFOLLOW (une FIFO posée là ne bloque pas dpkg), ordinaire, de root ; puis l'ancien arbre est retiré.
    install -d -m 0755 -o root -g root /var/lib/secubox-dns-listes /var/lib/secubox-dns-listes/sources
    if [ -n "$2" ] && dpkg --compare-versions "$2" ge 1.8.0~ && dpkg --compare-versions "$2" lt 1.8.1~; then
        python3 -I - <<'REPRISE' || echo "secubox-core : reprise des sources de /var/lib/secubox/dns-listes incomplète" >&2
import os, stat
from secubox_unbound import depot

def dossier(parent_fd, nom):
    fd = os.open(nom, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
    st = os.fstat(fd)
    if st.st_uid != 0 or st.st_mode & 0o022:
        os.close(fd)
        raise PermissionError(nom)
    return fd

racine = os.open("/var/lib/secubox", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    ancien = dossier(racine, "dns-listes")
    sources = dossier(ancien, "sources")
except OSError:
    raise SystemExit(0)
for n in ("93-secubox-webfilter.conf", "95-secubox-adblock.conf", "96-secubox-adult.conf"):
    if os.path.lexists(depot.SOURCES / n):
        continue
    try:
        fd = os.open(n, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=sources)
    except OSError:
        continue
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if stat.S_ISREG(st.st_mode) and st.st_uid == 0 and st.st_size <= 512 * 1024 * 1024:
            depot.deposer_source(n, f.read().decode("utf-8", "replace"))
REPRISE
        rm -rf /var/lib/secubox/dns-listes || true
    fi
    if [ -d /run/systemd/system ] && [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1 \
       && [ -f /etc/apparmor.d/secubox-dns-listes ]; then
        apparmor_parser -r /etc/apparmor.d/secubox-dns-listes \
          || echo "secubox-core : profil AppArmor secubox-dns-listes non charge (apparmor_parser -r /etc/apparmor.d/secubox-dns-listes)" >&2
    fi
    # #3411 : activation HORS du test systemd — dans le chroot d'une image il est faux et l'unite restait
    # desactivee sur la box flashee ; deb-systemd-helper travaille sur le systeme de fichiers. Le demarrage reste conditionne.
    # Motif debhelper : un disable manuel de l'operateur survit a la mise a jour.
    # #3592 : la minuterie de reprise de 1.8.24 est retirée ; on l'arrête et on efface son activation.
    if [ -d /run/systemd/system ]; then systemctl stop secubox-dns-listes-contexte.timer 2>/dev/null || true; fi
    deb-systemd-helper purge secubox-dns-listes-contexte.timer >/dev/null 2>&1 || true
    for _u in secubox-dns-listes.path secubox-dns-listes.timer; do
      if deb-systemd-helper --quiet was-enabled "$_u"; then
        deb-systemd-helper enable "$_u" >/dev/null || true
      else
        deb-systemd-helper update-state "$_u" >/dev/null || true
      fi
    done
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload 2>/dev/null || true
        systemctl start secubox-dns-listes.path secubox-dns-listes.timer 2>/dev/null || true
        [ -d /etc/unbound/unbound.conf.d ] && systemctl start --no-block secubox-dns-listes.service 2>/dev/null || true
    fi

    # ACCUEIL DU NOM DE NŒUD (#3821, #3824), dans le cœur depuis #3883 : il vivait dans secubox-webos (le Hall,
    # optionnel) ; une box sans webos ne servait ni son accueil public ni la carte « Nom du nœud » de /system/.
    # Réglages : MIGRATION UNE FOIS, par `secubox-noeud migrer` (root, tout par descripteur). Ils vivent dans un dossier
    # ROOT, /etc/secubox/noeud/ (root:root 0755) : /etc/secubox appartient au compte secubox, qui pourrait y remplacer un
    # fichier. Un chemin noeud/ qui n'est pas un vrai dossier de root est REFUSÉ bruyamment (rien n'est créé).
    # noeud.toml (root:root 0640) absent : repris des clés booléennes de [noeud] de webos.toml, sinon les défauts ;
    # relais_api = true n'est repris que si le mot de passe admin par défaut est prouvé changé (audité : migre /
    # refuse-migration). webos.toml présent mais illisible : rien n'est créé, nouvel essai au prochain configure.
    if [ -x /usr/sbin/secubox-noeud ]; then
        /usr/sbin/secubox-noeud migrer || echo "secubox-core : /etc/secubox/noeud/noeud.toml non créé (voir ci-dessus ; défauts : accueil posé, relais fermé)" >&2
    fi
    # État (route reprise, ancienne cible) : celui de secubox-webos repris une fois, s'il est un vrai dossier de root.
    if [ -d /var/lib/secubox-webos-noeud ] && [ ! -L /var/lib/secubox-webos-noeud ] \
       && [ "$(stat -c %u /var/lib/secubox-webos-noeud)" = 0 ] \
       && [ ! -e /var/lib/secubox-noeud ] && [ ! -L /var/lib/secubox-noeud ]; then
        mv /var/lib/secubox-webos-noeud /var/lib/secubox-noeud
        chmod 0700 /var/lib/secubox-noeud
        echo "secubox-core : état du nom de nœud repris de /var/lib/secubox-webos-noeud"
    fi
    # Le vhost /etc/nginx/conf.d/secubox-noeud.conf garde son nom ; celui de webos (ancien en-tête) est reconnu et
    # régénéré. L'existant gagne ; route par sbxwaf, jamais de contournement ; aucune nouvelle exposition tant que le
    # mot de passe admin par défaut est actif (#3401). Un échec n'arrête pas l'installation.
    if [ -x /usr/sbin/secubox-noeud ]; then
        /usr/sbin/secubox-noeud appliquer || echo "secubox-core : accueil du nom de nœud non posé (voir ci-dessus)" >&2
        /usr/sbin/secubox-noeud prepare || echo "secubox-core : dépôt des demandes du relais non préparé" >&2
    fi
    # Unités : activées sur le système de fichiers (deb-systemd-helper, valable dans le chroot d'une image, #3411) ;
    # un disable de l'opérateur survit à la mise à jour. Le .path n'est démarré que sous systemd.
    for _u in secubox-noeud.path secubox-noeud.service; do
      if deb-systemd-helper --quiet was-enabled "$_u"; then
        deb-systemd-helper enable "$_u" >/dev/null || true
      else
        deb-systemd-helper update-state "$_u" >/dev/null || true
      fi
    done
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload 2>/dev/null || true
        if deb-systemd-helper --quiet is-enabled secubox-noeud.path 2>/dev/null; then
            systemctl start secubox-noeud.path 2>/dev/null || true
        fi
    fi

    # HAProxy tire par network-online.target, pas seulement par
    # multi-user.target (#998). Un [Install] pose en drop-in n'est pas honore
    # par `systemctl enable` : le lien doit etre cree explicitement.
    #
    # Sans cela, un seul service lent (le 2026-08-07, ou une boucle
    # netboot la veille) empeche multi-user.target d'etre atteint, et le job
    # d'HAProxy n'est jamais tente — journal vide, 443 muet.
    if [ -f /lib/systemd/system/haproxy.service ]; then
        mkdir -p /etc/systemd/system/network-online.target.wants
        ln -sf /lib/systemd/system/haproxy.service \
               /etc/systemd/system/network-online.target.wants/haproxy.service
        echo "secubox-core: HAProxy rattache a network-online.target" >&2
    fi

    # ── Fiabilite du demarrage : reprise de la derive (#998) ──
    #
    # Ces trois fichiers ont ete poses a la main sur les boards, hors de tout
    # paquet. Ils ne sont pas simplement obsoletes : ceux d'/etc MASQUENT ceux
    # que ce paquet installe dans /usr/lib, donc sans cette reprise la
    # correction n'aurait aucun effet.
    #
    # Ce qu'ils cassaient : HAProxy dependait par `Requires=` d'un assistant
    # d'attente ecrit pour une autre topologie (il attendait l'adresse de
    # gestion sur `lan0`, un port sans porteuse sur cette board). L'assistant
    # echouait, le job d'HAProxy etait abandonne SANS AUCUNE TRACE, et la
    # board restait sans HTTPS apres chaque redemarrage.
    for stale in \
        /etc/systemd/system/secubox-network-ready.service \
        /etc/systemd/system/haproxy.service.d/wait-network.conf \
        /usr/local/bin/secubox-wait-network.sh
    do
        if [ -e "$stale" ]; then
            mv -f "$stale" "$stale.remplace-par-secubox-core" 2>/dev/null || rm -f "$stale"
            echo "secubox-core: derive reprise -> $stale" >&2
        fi
    done

    systemctl daemon-reload 2>/dev/null || true
    systemctl enable secubox-network-ready.service 2>/dev/null || true

    # HAProxy a pu rester mort depuis le dernier redemarrage sans que rien ne
    # le signale : le relancer s'il est active mais arrete.
    if systemctl is-enabled --quiet haproxy 2>/dev/null \
       && ! systemctl is-active --quiet haproxy 2>/dev/null; then
        echo "secubox-core: HAProxy etait arrete — demarrage" >&2
        systemctl start haproxy 2>/dev/null || true
    fi

    # ── Plus rien d'inscriptible par tous (#1416) ──
    # 73 unités tournaient en UMask=0000 : leurs fichiers d'état étaient en
    # 0666, dont le réglage « TOTP admin obligatoire » et la garde anti-rejeu
    # TOTP. On retire SEULEMENT l'écriture « autres » (les lectures restent),
    # sur fichiers et dossiers réguliers — jamais les sockets ni les liens.
    # Idempotent : ne touche que ce qui est encore o+w.
    for d in /etc/secubox /var/lib/secubox; do
      [ -d "$d" ] || continue
      find "$d" -xdev \( -type f -o -type d \) -perm -0002 ! -perm -1000 \
        -exec chmod o-w {} + 2>/dev/null || true
    done

    # ── Python dependencies (minima) ──
    # #3938 : pip ne complète QUE ce qui manque ou est trop ancien, jamais de --upgrade. Le relever à chaque configure
    # posait dans /usr/local une version qui masquait celle d'apt sous un agrégateur en marche (voir debian/control).
    if ! python3 -I - <<'MINIMA' 2>/dev/null
import importlib
import re
import sys
from importlib.metadata import version

for nom, mini in (("pydantic", (2, 0)), ("fastapi", (0, 100)), ("uvicorn", (0, 25))):
    importlib.import_module(nom)
    vue = tuple(int(x) for x in re.findall(r"\d+", version(nom))[:2])
    if vue < mini:
        sys.exit(1)
MINIMA
    then
      if command -v pip3 >/dev/null 2>&1; then
        echo "secubox-core : pydantic, fastapi ou uvicorn absent ou trop ancien : complété par pip"
        pip3 install --break-system-packages --quiet --timeout 20 --retries 2 \
          'pydantic>=2.0' 'fastapi>=0.100' 'uvicorn>=0.25' \
          || echo "secubox-core : pip n'a pas complété les dépendances Python (voir ci-dessus)" >&2
      else
        echo "secubox-core : pydantic, fastapi ou uvicorn absent ou trop ancien, et pip3 absent" >&2
      fi
    fi
    ;;
esac

#DEBHELPER#

# PLAGE D'IDENTIFIANTS DES CONTENEURS NON PRIVILÉGIÉS (#1718). Tous les
# install-lxc du parc mappent root du conteneur sur 100000–165535 de l'hôte
# (lxc.idmap = u/g 0 100000 65536). newuidmap ne l'accepte que si
# /etc/subuid et /etc/subgid l'accordent à root. gk2 avait la ligne, posée à la
# main ; une box neuve (gk3) ne l'avait pas : TOUS ses conteneurs non
# privilégiés refusaient de démarrer. Idempotent ; les autres lignes ne sont
# jamais touchées.
if [ "$1" = "configure" ]; then
    for _f in /etc/subuid /etc/subgid; do
        [ -e "$_f" ] || install -m 0644 /dev/null "$_f"
        if ! grep -qE '^root:100000:65536$' "$_f"; then
            printf 'root:100000:65536\n' >> "$_f"
            echo "secubox-core : plage root:100000:65536 déclarée dans $_f"
        fi
    done
fi

# RÈGLE SUDO lxc-* POSÉE À LA MAIN (#1785). gk2 portait un
# /etc/sudoers.d/secubox-lxc hors paquet : lxc-info/-attach/-start/-stop/-ls à
# argument libre pour le compte secubox (`lxc-start -f` exécute des crochets en
# root sur l'hôte). secubox-lxcctl le remplace. Retiré SEULEMENT s'il n'est à
# aucun paquet et ne contient que des règles lxc-* ou streamlitctl ; sauvegardé.
if [ "$1" = "configure" ] && [ -f /etc/sudoers.d/secubox-lxc ] \
   && ! dpkg -S /etc/sudoers.d/secubox-lxc >/dev/null 2>&1; then
    if ! grep -vE '^[[:space:]]*(#|$)' /etc/sudoers.d/secubox-lxc \
         | grep -vqE '^secubox ALL=\(root\) NOPASSWD: (/usr/bin/lxc-(info|attach|start|stop|ls)(, )?)+$|^secubox ALL=\(root\) NOPASSWD: /usr/sbin/streamlitctl$'; then
        install -d -m 0700 /var/backups/secubox/sudoers-avant-1785
        cp -p /etc/sudoers.d/secubox-lxc /var/backups/secubox/sudoers-avant-1785/secubox-lxc
        rm -f /etc/sudoers.d/secubox-lxc
        echo "secubox-core : règle sudo lxc-* manuelle retirée (sauvegarde /var/backups/secubox/sudoers-avant-1785)"
    fi
fi

# CONTENEURS LÀ OÙ IL Y A LA PLACE (#1716). Mode automatique : n'agit que si
# /data est une petite partition, / une grande, ET /data/lxc vide — des
# conteneurs existants ne sont jamais déplacés sans `secubox-lxc-racine --migrer`.
if [ "$1" = "configure" ] && [ -x /usr/sbin/secubox-lxc-racine ]; then
    /usr/sbin/secubox-lxc-racine || true
fi

# LES CONTENEURS SORTENT (#1721). Une box installée par l'image avait la chaîne
# forward en drop sans rien pour br-lxc, pas de NAT persistant, et
# 99-secubox-hardening.conf remettait ip_forward à 0 au démarrage : aucun
# conteneur n'atteignait un dépôt. Le routage d'abord (fichier livré en
# /usr/lib/sysctl.d, qui passe après le durcissement), puis le pare-feu —
# seulement sur un nftables.conf de génération firstboot, validé par nft -c,
# appliqué règle par règle sans rechargement complet.
if [ "$1" = "configure" ]; then
    sysctl -q -p /usr/lib/sysctl.d/99-secubox-zz-lxc-forward.conf 2>/dev/null || true
    if [ -x /usr/sbin/secubox-lxc-reseau ]; then /usr/sbin/secubox-lxc-reseau || true; fi
fi

# 192.168.255.1 en /32 sur lo, /32 posé avant de retirer l'ancien /24 (#3189).
if [ "$1" = "configure" ]; then
    if [ -x /usr/sbin/secubox-lo-alias ]; then /usr/sbin/secubox-lo-alias || true; fi
fi

# TRACE DE L'ADMINISTRATION DÉLÉGUÉE (#1720). Chaque requête d'une session
# ouverte par délégation (compte <aidant>.<centre>) y est écrite : qui, depuis
# quel nœud, au titre de quelle session, quelle route. Les modules tournent
# sous `secubox` et ne peuvent pas créer un fichier dans /var/log/secubox : sans
# lui, la trace — promise des deux côtés — échouait en silence.
if [ "$1" = "configure" ]; then
    install -d -m 0755 /var/log/secubox
    # 0660 groupe secubox : chaque module trace dans SON processus, et tous ne
    # tournent pas sous `secubox` (secubox-openpgp…) — en 0640, leurs lignes
    # se perdaient sans bruit.
    [ -e /var/log/secubox/delegation.log ] || install -m 0660 -o secubox -g secubox /dev/null /var/log/secubox/delegation.log
    chgrp secubox /var/log/secubox/delegation.log && chmod 0660 /var/log/secubox/delegation.log || true
fi

# LE DOMAINE DE CETTE BOX (#1723). Trente paquets prenaient *.gk2.secubox.in
# pour défaut : une box qui n'est pas gk2 (gk3) a écrit des noms de gk2 dans
# ses réglages — jitsi pour meet.gk2, la carlette d'accès vers hall.gk2… Sur
# une telle box, ces noms deviennent <x>.<son domaine> (copie de chaque
# fichier, commentaires intacts). Sur gk2 : rien.
if [ "$1" = "configure" ] && [ -x /usr/bin/secubox-domaine ]; then
    /usr/bin/secubox-domaine --migrer || true
fi

# CONSOLE EN UTF-8 (#3412). Les images RPi/arm64 installaient console-setup sans le régler : debconf choisissait
# CHARMAP="ISO-8859-15" alors que LANG est en UTF-8 — les cadres du message d'accueil (╭─╮) s'affichaient illisibles.
# On ne corrige QUE cette valeur-là, et seulement si la locale du système est en UTF-8.
if [ "$1" = "configure" ] && [ -f /etc/default/console-setup ] && [ ! -L /etc/default/console-setup ] \
   && grep -q '^CHARMAP="\{0,1\}ISO-8859-15"\{0,1\}$' /etc/default/console-setup \
   && grep -qi '^LANG=.*utf-\{0,1\}8' /etc/default/locale 2>/dev/null; then
    sed -i 's/^CHARMAP=.*/CHARMAP="UTF-8"/' /etc/default/console-setup
    # debconf aussi : sans cela, un dpkg-reconfigure console-setup reviendrait à ISO-8859-15.
    echo "console-setup console-setup/charmap47 select UTF-8" | debconf-set-selections >/dev/null 2>&1 || true
    echo "secubox-core : console-setup passé en CHARMAP=UTF-8"
    [ -d /run/systemd/system ] && systemctl try-restart console-setup.service >/dev/null 2>&1 || true
fi
