#!/bin/bash
set -e

case "$1" in
  configure)
    # ── Utilisateur système ──
    if ! id -u secubox >/dev/null 2>&1; then
      adduser --system --group --no-create-home \
        --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    fi

    # ── Répertoires ──
    # /etc/secubox MUST be world-traversable (0755): non-secubox daemons
    # need to read their conf files under it (dnsmasq for secubox-eye-remote,
    # hostapd/wpa_supplicant for secubox-mesh, etc.). 0750 blocks traversal
    # even with world-readable files inside, causing daemon startup failures
    # (see #468). Sensitive content lives in /etc/secubox/secrets (0700
    # secubox:secubox), so opening the parent dir does NOT leak secrets.
    install -d -o secubox -g secubox -m 755 /etc/secubox
    install -d -m 1777 /run/secubox  # World-writable for all service sockets
    # Same reasoning as /etc/secubox above: these SHARED parents must be 0755 so
    # every secubox-* daemon (running as its own user, not in group secubox) can
    # traverse to its own subtree. 0750 here broke kbin/toolbox repeatedly
    # (#626/#630). Per-module leaves + secrets stay restricted.
    install -d -o secubox -g secubox -m 755 /var/lib/secubox
    install -d -o secubox -g secubox -m 755 /usr/share/secubox/www

    # ── tmpfiles.d for persistent /run/secubox ──
    # #494: drop a stale, non-dpkg-owned /etc/tmpfiles.d/secubox.conf left over
    # from an old manual fix — it declares /run/secubox as 0775 secubox secubox
    # and, because /etc overrides /usr/lib, it contradicts the canonical rule
    # (/usr/lib/tmpfiles.d/secubox.conf: 1777 root root). Only remove it if it
    # is NOT owned by any package and carries that bad declaration.
    if [ -f /etc/tmpfiles.d/secubox.conf ] \
       && ! dpkg -S /etc/tmpfiles.d/secubox.conf >/dev/null 2>&1 \
       && grep -qE '/run/secubox[[:space:]]+0?775[[:space:]]+secubox' /etc/tmpfiles.d/secubox.conf; then
      rm -f /etc/tmpfiles.d/secubox.conf
    fi
    systemd-tmpfiles --create 2>/dev/null || true

    # ── Config initiale si absente ──
    if [ ! -f /etc/secubox/secubox.conf ]; then
      install -o secubox -g secubox -m 640 \
        /usr/share/secubox-core/secubox.conf.example \
        /etc/secubox/secubox.conf
    fi

    # ── Nginx ──
    # The /etc/nginx/sites-available/secubox file ships with three server
    # blocks bound to 80/443 — fine for standalone-nginx topologies, fatal
    # on HAProxy-fronted boards where HAProxy already owns 80/443.
    # Only install it on first install (when the file doesn't exist).
    # Subsequent installs/upgrades keep the operator-tuned variant intact.
    # See issue #162.
    if [ -d /etc/nginx/sites-available ]; then
      if [ ! -f /etc/nginx/sites-available/secubox ]; then
        install -m 644 /usr/share/secubox-core/nginx/secubox.conf \
          /etc/nginx/sites-available/secubox
      fi
      install -m 644 /usr/share/secubox-core/nginx/secubox-proxy.conf \
        /etc/nginx/snippets/secubox-proxy.conf

      # VERDICT LAN POUR LA LECTURE GARDEE (#1256) — ajoute SI nginx l'accepte.
      #
      # `$lan_client` vient de conf.d/secubox-lan-geo.conf, livre par
      # secubox-hub. hub depend de core, donc core ne peut pas dependre de hub :
      # sur une board sans ce fichier, la ligne ferait echouer `nginx -t` et
      # casserait TOUTE la configuration, pas seulement la lecture gardee.
      #
      # On l'ajoute, on teste, on la retire si le test echoue. Sans elle,
      # require_lecture ne voit aucune marque LAN et exige un jeton : on perd
      # un affichage, pas une barriere.
      _snip=/etc/nginx/snippets/secubox-proxy.conf
      # LE GARDE RECONNAIT LA DIRECTIVE, PAS LA CHAINE (#1351).
      #
      # Il valait `grep -q 'X-SecuBox-LAN'`, et le snippet contient ce nom DANS
      # LE COMMENTAIRE qui explique la ligne. grep le trouvait, le postinst
      # concluait « deja posee », et la directive n'etait jamais ajoutee : le
      # commentaire qui documente la ligne etait precisement ce qui l'empechait
      # d'exister. Resultat sur gk2 : le verdict LAN n'arrivait a aucun module,
      # le mode tableau de bord ne s'appliquait jamais, et toute lecture du
      # Hall rendait 401 — 6586 refus en une heure.
      if ! grep -qE '^[[:space:]]*proxy_set_header[[:space:]]+X-SecuBox-LAN' "$_snip"; then
        cp -a "$_snip" "$_snip.sbxbak"
        printf 'proxy_set_header   X-SecuBox-LAN     $lan_client;\n' >> "$_snip"
        if nginx -t 2>/dev/null; then
          rm -f "$_snip.sbxbak"
        else
          mv -f "$_snip.sbxbak" "$_snip"
          echo "secubox-core: \$lan_client indisponible (secubox-hub absent ?) —" \
               "mode tableau de bord inactif, les lectures exigeront un jeton" >&2
        fi
      fi

      # Symlink only on first install — never overwrite an existing one
      # (which may point at an HAProxy-aware variant like secubox-local).
      if [ ! -e /etc/nginx/sites-enabled/secubox ]; then
        ln -s /etc/nginx/sites-available/secubox \
              /etc/nginx/sites-enabled/secubox
      fi
      rm -f /etc/nginx/sites-enabled/default

      install -d -m 755 /etc/nginx/secubox.d

      # RETIRER LES RESIDUS dpkg DE sites-enabled (#1294).
      #
      # Le nginx.conf de Debian fait `include /etc/nginx/sites-enabled/*;` —
      # un glob NU. Il avale donc les `.dpkg-new` / `.dpkg-old` qu'un conflit
      # de conffile depose a cote du fichier actif. Nos propres inclusions
      # (`secubox.d/*.conf`) y echappent grace au suffixe ; celle de Debian,
      # non.
      #
      # UN SEUL de ces residus suffit a empecher nginx de demarrer, et il
      # survit au retrait du paquet qui l'a engendre : plus personne ne le
      # possede, donc aucun postrm ne le nettoie. Constate sur une image
      # trixie, ou un hall.gk2.net.conf.dpkg-new orphelin referencait un
      # `$lan_client` dont le bloc geo etait parti avec son paquet :
      #   [emerg] unknown "lan_client" variable — configuration test failed
      # nginx etait installe ET active, et refusait simplement de demarrer.
      #
      # On ARCHIVE au lieu de supprimer : un fichier qu'aucun paquet ne
      # possede peut porter une configuration qu'un operateur voudra relire.
      _residus=""
      for _f in /etc/nginx/sites-enabled/*.dpkg-new \
                /etc/nginx/sites-enabled/*.dpkg-old \
                /etc/nginx/sites-enabled/*.dpkg-dist; do
        [ -e "$_f" ] || continue
        install -d -m 755 /var/backups/secubox/nginx-residus
        if mv -f "$_f" /var/backups/secubox/nginx-residus/ 2>/dev/null; then
          _residus="${_residus} $(basename "$_f")"
        fi
      done
      if [ -n "$_residus" ]; then
        echo "secubox-core: residus dpkg ecartes de sites-enabled :${_residus}" >&2
        echo "secubox-core: archives dans /var/backups/secubox/nginx-residus/" >&2
      fi

      # Only reload nginx if the resulting config is valid. On HAProxy
      # boards the operator-tuned file is preserved, so this passes; on
      # standalone boards the freshly-installed file is also valid.
      if nginx -t 2>/dev/null; then
        systemctl reload nginx 2>/dev/null || true
      else
        echo "secubox-core: nginx -t failed, skipping reload (preserving running config)" >&2
      fi
    fi

    systemctl daemon-reload

    # Enable runtime directory service (ensures /run/secubox exists before other services)
    systemctl enable --now secubox-runtime.service 2>/dev/null || true
    # ACTIVÉE, PAS DÉMARRÉE : l'initialisation appartient au démarrage, pas à
    # l'installation d'un paquet. Sur une box déjà initialisée le
    # `ConditionPathExists=!` la rend inerte, donc l'activation est sûre ici.
    systemctl enable secubox-firstboot.service 2>/dev/null || true

    # Shared-dir traversal guard (#630): self-heals the recurring 0750 clobber
    # (from this and other module postinsts) that breaks kbin/toolbox.
    systemctl enable --now secubox-dirs-guard.timer 2>/dev/null || true
    systemctl start secubox-dirs-guard.service 2>/dev/null || true

    # HAProxy tire par network-online.target, pas seulement par
    # multi-user.target (#998). Un [Install] pose en drop-in n'est pas honore
    # par `systemctl enable` : le lien doit etre cree explicitement.
    #
    # Sans cela, un seul service lent (le 2026-08-07, ou une boucle
    # netboot la veille) empeche multi-user.target d'etre atteint, et le job
    # d'HAProxy n'est jamais tente — journal vide, 443 muet.
    if [ -f /lib/systemd/system/haproxy.service ]; then
        mkdir -p /etc/systemd/system/network-online.target.wants
        ln -sf /lib/systemd/system/haproxy.service \
               /etc/systemd/system/network-online.target.wants/haproxy.service
        echo "secubox-core: HAProxy rattache a network-online.target" >&2
    fi

    # ── Fiabilite du demarrage : reprise de la derive (#998) ──
    #
    # Ces trois fichiers ont ete poses a la main sur les boards, hors de tout
    # paquet. Ils ne sont pas simplement obsoletes : ceux d'/etc MASQUENT ceux
    # que ce paquet installe dans /usr/lib, donc sans cette reprise la
    # correction n'aurait aucun effet.
    #
    # Ce qu'ils cassaient : HAProxy dependait par `Requires=` d'un assistant
    # d'attente ecrit pour une autre topologie (il attendait l'adresse de
    # gestion sur `lan0`, un port sans porteuse sur cette board). L'assistant
    # echouait, le job d'HAProxy etait abandonne SANS AUCUNE TRACE, et la
    # board restait sans HTTPS apres chaque redemarrage.
    for stale in \
        /etc/systemd/system/secubox-network-ready.service \
        /etc/systemd/system/haproxy.service.d/wait-network.conf \
        /usr/local/bin/secubox-wait-network.sh
    do
        if [ -e "$stale" ]; then
            mv -f "$stale" "$stale.remplace-par-secubox-core" 2>/dev/null || rm -f "$stale"
            echo "secubox-core: derive reprise -> $stale" >&2
        fi
    done

    systemctl daemon-reload 2>/dev/null || true
    systemctl enable secubox-network-ready.service 2>/dev/null || true

    # HAProxy a pu rester mort depuis le dernier redemarrage sans que rien ne
    # le signale : le relancer s'il est active mais arrete.
    if systemctl is-enabled --quiet haproxy 2>/dev/null \
       && ! systemctl is-active --quiet haproxy 2>/dev/null; then
        echo "secubox-core: HAProxy etait arrete — demarrage" >&2
        systemctl start haproxy 2>/dev/null || true
    fi

    # ── Python dependencies (ensure compatible versions) ──
    # Debian bookworm ships old pydantic v1 and fastapi, upgrade via pip
    if command -v pip3 >/dev/null 2>&1; then
      pip3 install --break-system-packages --quiet --upgrade \
        'pydantic>=2.0' 'fastapi>=0.100' 'uvicorn>=0.25' 2>/dev/null || true
    fi
    ;;
esac

#DEBHELPER#
