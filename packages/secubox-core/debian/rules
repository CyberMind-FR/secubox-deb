#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@ --with python3

override_dh_auto_install:
	# Installer la lib Python
	install -d debian/secubox-core/usr/lib/python3/dist-packages/
	cp -r ../../common/secubox_core \
	      debian/secubox-core/usr/lib/python3/dist-packages/

	# Ressources partagées
	install -d debian/secubox-core/usr/share/secubox-core/nginx
	cp ../../common/nginx/secubox.conf \
	   debian/secubox-core/usr/share/secubox-core/nginx/
	cp ../../common/nginx/secubox-proxy.conf \
	   debian/secubox-core/usr/share/secubox-core/nginx/

	# Styled nginx error page (5xx) — served via error_page alias in secubox.conf
	install -d debian/secubox-core/usr/share/secubox-core/www
	cp ../../common/nginx/errors/50x.html \
	   debian/secubox-core/usr/share/secubox-core/www/

	# Config example
	cp ../../secubox.conf.example \
	   debian/secubox-core/usr/share/secubox-core/

	# Script firstboot
	install -d debian/secubox-core/usr/bin
	install -m 755 ../../image/firstboot.sh \
	               debian/secubox-core/usr/bin/secubox-firstboot

	# SecuBox CLI
	install -m 755 usr/bin/secubox \
	               debian/secubox-core/usr/bin/secubox

	# Systemd services
	install -d debian/secubox-core/usr/lib/systemd/system
	install -m 644 debian/secubox-core.service \
	               debian/secubox-core/usr/lib/systemd/system/
	install -m 644 systemd/secubox-runtime.service \
	               debian/secubox-core/usr/lib/systemd/system/
	# Drop-in override for nftables.service: tolerate missing nf_nat /
	# nft_chain_nat kernel modules when those are BUILT-IN on the MOCHAbin
	# custom kernel (#150 + lyrion-slimproto-after-reboot).
	install -d debian/secubox-core/etc/systemd/system/nftables.service.d
	install -m 644 systemd/nftables.service.d/override.conf \
	               debian/secubox-core/etc/systemd/system/nftables.service.d/override.conf
	# lxc.service drop-in: wait for /data before LXC autostart. Without
	# this, lxc-autostart ran in 2s at boot and found nothing because
	# the /data ext4 mount hadn't happened yet — 12+ LXCs stayed STOPPED
	# despite lxc.start.auto = 1. RequiresMountsFor=/data lets systemd
	# resolve the right mount unit and order lxc.service after it.
	# Fiabilite du demarrage (#998). Une board redemarree restait sans HTTPS :
	# HAProxy dependait par Requires= d'un assistant d'attente qui echouait,
	# et son job etait abandonne sans la moindre trace au journal.
	install -m 755 usr/bin/secubox-wait-network.sh \
	               debian/secubox-core/usr/bin/secubox-wait-network.sh
	install -m 644 systemd/secubox-network-ready.service \
	               debian/secubox-core/usr/lib/systemd/system/
	install -d debian/secubox-core/etc/systemd/system/haproxy.service.d
	install -m 644 systemd/haproxy.service.d/secubox-wait-network.conf \
	               debian/secubox-core/etc/systemd/system/haproxy.service.d/secubox-wait-network.conf
	install -d debian/secubox-core/etc/systemd/system/systemd-networkd-wait-online.service.d
	install -m 644 systemd/systemd-networkd-wait-online.service.d/secubox-any.conf \
	               debian/secubox-core/etc/systemd/system/systemd-networkd-wait-online.service.d/secubox-any.conf
	install -d debian/secubox-core/etc/systemd/system/lxc.service.d
	install -m 644 systemd/lxc.service.d/wait-for-data.conf \
	               debian/secubox-core/etc/systemd/system/lxc.service.d/wait-for-data.conf
	# Create modular nginx directory (modules install their snippets here)
	install -d debian/secubox-core/etc/nginx/secubox.d

	# tmpfiles.d for /run/secubox socket directory (world-writable for all services)
	install -d debian/secubox-core/usr/lib/tmpfiles.d
	install -m 644 tmpfiles.d/secubox.conf \
	               debian/secubox-core/usr/lib/tmpfiles.d/

	# Shared-dir traversal guard (#630): keep /var/{lib,log,cache} + /etc +
	# /usr/share /secubox parents at 0755 so every secubox-* user can traverse.
	# Counters the recurring `install -d -m 0750 …/secubox` clobber in module
	# postinsts that breaks kbin/toolbox.
	install -d debian/secubox-core/usr/sbin
	install -m 755 usr/sbin/secubox-dirs-guard.sh \
	               debian/secubox-core/usr/sbin/secubox-dirs-guard.sh
	install -m 644 systemd/secubox-dirs-guard.service \
	               debian/secubox-core/usr/lib/systemd/system/
	install -m 644 systemd/secubox-dirs-guard.timer \
	               debian/secubox-core/usr/lib/systemd/system/

	# LED scripts and services
	install -d debian/secubox-core/usr/sbin
	install -m 755 usr/sbin/secubox-led-heartbeat \
	               debian/secubox-core/usr/sbin/
	install -m 755 usr/sbin/secubox-led-k2000 \
	               debian/secubox-core/usr/sbin/
	# User provisioning push (gk2/admin → Nextcloud/PhotoPrism, #410)
	install -m 755 usr/sbin/secubox-user-sync \
	               debian/secubox-core/usr/sbin/
	install -m 644 systemd/secubox-led-heartbeat.service \
	               debian/secubox-core/usr/lib/systemd/system/
