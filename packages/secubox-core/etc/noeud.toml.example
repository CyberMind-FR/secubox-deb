# /etc/secubox/noeud/noeud.toml — accueil du nom de nœud (#3821, #3824), géré par secubox-core (#3883).
# Dossier root:root 0755, fichier root:root 0640 : un fichier lié, d'un autre propriétaire ou inscriptible par groupe
# ou autres est IGNORÉ (relais fermé). Créé une fois par `secubox-noeud migrer` (postinst), repris de la section
# [noeud] de webos.toml s'il y en avait une (relais_api = true seulement si le mot de passe admin est changé).

# <nœud>.<zone> (ex. gk2.secubox.in) montre le dé SecuBox en plein écran sur « / ».
# false = rien n'est posé (et ce qui l'avait été est retiré) ; appliquer : secubox-noeud appliquer
[noeud]
accueil = true
# Relais des AUTRES chemins de ce nom vers l'ancienne cible de sa route (#3824 ; sur gk2 : l'API admin, metrics…).
# FERMÉ par défaut : le nom public ne sert que le dé (« / », /_noeud/) et /api/v1/health, tout le reste rend 404.
# À ouvrir ou fermer depuis la page Système (panneau « Nom du nœud »), ou : secubox-noeud relais activer|desactiver
relais_api = false
