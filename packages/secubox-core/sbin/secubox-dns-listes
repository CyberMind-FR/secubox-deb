"""secubox-dns-listes — compile les listes DNS (webfilter, adblock, adult) en un fichier Unbound à étiquettes (#3205).

  secubox-dns-listes appliquer          une passe : adoption des anciens fichiers, compilation, pose, rechargement
  secubox-dns-listes etat               le dernier état noté (/var/lib/secubox-dns-listes/etat.json)
  secubox-dns-listes compiler FICHIER   compile vers FICHIER sans rien poser ni recharger (diagnostic)

Lancé par secubox-dns-listes.service (root, profil AppArmor), lui-même déclenché par secubox-dns-listes.path dès qu'un
générateur dépose sa source. Codes : 0 appliqué ou inchangé ; 1 erreur (l'état précédent est remis) ; 2 usage."""
import json
import os
import signal
import sys
from pathlib import Path

from secubox_unbound import depot, listes


def _terminer(signum, _frame):
    """SIGTERM (arrêt, délai de systemd) devient SystemExit : la transaction en cours remet tout en place avant de sortir.
    Python ne fait rien de tel sur SIGTERM par défaut (relecture #3205)."""
    raise SystemExit(128 + signum)


def main(argv=None) -> int:
    signal.signal(signal.SIGTERM, _terminer)
    args = list(sys.argv[1:] if argv is None else argv)
    cmd = args[0] if args else "appliquer"
    if cmd == "etat":
        print(json.dumps(depot.lire_etat() or {"etat": "inconnu"}, ensure_ascii=False, indent=1))
        return 0
    if os.geteuid() != 0:
        print("secubox-dns-listes : à lancer en root (écrit /etc/unbound)", file=sys.stderr)
        return 2
    if cmd == "appliquer" and len(args) <= 1:
        r = depot.appliquer(depot.SystemeListes())
        print(json.dumps(r, ensure_ascii=False))
        return 1 if r.get("etat") == "erreur" else 0
    if cmd == "compiler" and len(args) == 2:
        sources = [depot.SOURCES / n for n in listes.SOURCES_CONNUES if (depot.SOURCES / n).is_file()]
        try:
            texte, stats = listes.compiler(sources, depot.fichiers_contexte(depot.CONF_D))
        except listes.ErreurListes as e:
            print(json.dumps({"erreur": str(e)}, ensure_ascii=False), file=sys.stderr)
            return 1
        Path(args[1]).write_text(texte, encoding="utf-8")
        print(json.dumps(stats, ensure_ascii=False))
        return 0
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
