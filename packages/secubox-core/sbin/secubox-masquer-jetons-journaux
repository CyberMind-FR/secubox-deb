"""SecuBox-Deb :: secubox-masquer-jetons-journaux — efface les jetons écrits dans les journaux nginx (#3691).

Les formats sbx_host et sbx_masque masquent les jetons passés dans l'URL (`?accessToken=` de PeerTube, `?jeton=` du
Hall…). Restent en clair : ce qui a été écrit avant, les journaux d'erreurs (nginx y recopie la requête, aucun format
ne s'y applique) et les sites qui gardent le format « combined ». Ce programme repasse sur /var/log/nginx, au postinst
puis toutes les heures (secubox-masquer-jetons-journaux.timer) :

- journal en clair : réécrit EN PLACE, à LONGUEUR ÉGALE (la valeur devient des « X ») : même inode, même taille, même
  position de chaque ligne, un lecteur qui suit le journal par décalage (secubox-metrics) ne voit rien bouger ; seule la
  partie écrite depuis le dernier passage est relue (état par inode) ;
- archive .gz : réécrite en flux dans un temporaire (O_EXCL), droits, propriétaire et dates conservés, fsync, renommage.

Programme root dans un dossier où www-data écrit : rien n'y est suivi. Le dossier est ouvert une fois (O_DIRECTORY), chaque
fichier par descripteur relatif en O_NOFOLLOW|O_NONBLOCK, puis vérifié par fstat (fichier ordinaire, un seul lien) — un
lien symbolique, une FIFO ou un lien dur posés entre-temps sont ignorés.
"""
import errno
import gzip
import json
import os
import re
import stat
import sys

DOSSIER = "/var/log/nginx"
ETAT = "/var/lib/secubox-core/masquer-jetons.json"   # StateDirectory=secubox-core de l'unité
# Un nom de paramètre qui porte un secret, quelle que soit la casse ; la valeur ne doit être ni vide ni déjà masquée
# (MASQUE du format nginx, ou des X de ce programme). Même liste que common/nginx/secubox-hosts-log.conf.
MOTIF = re.compile(
    rb"([?&;][A-Za-z0-9_.-]*(?:token|jeton|jwt|api_?key|secret|passw(?:or)?d|auth|sig|signature|session)=)"
    rb"(?!MASQUE)(?!X+(?:[&;\s\"]|$))([^&;\s\"]+)", re.I)
LIGNE_MAX = 1 << 20          # une ligne de journal plus longue est laissée telle quelle (bornée en mémoire)
MARGE_DISQUE = 64 << 20      # place libre exigée en plus de l'archive avant de la réécrire


def masquer(contenu: bytes) -> bytes:
    return MOTIF.sub(lambda m: m.group(1) + b"X" * len(m.group(2)), contenu)


def ouvrir(dfd: int, nom: str, flags: int):
    """(fd, stat) d'un fichier ordinaire à un seul lien, ouvert sans suivre de lien ; None sinon."""
    try:
        fd = os.open(nom, flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
    except OSError as e:
        if e.errno in (errno.ELOOP, errno.ENOENT, errno.ENXIO, errno.EISDIR):
            return None
        raise
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
        os.close(fd)
        return None
    return fd, st


def traiter_clair(dfd: int, nom: str, etat_avant: dict):
    """Réécrit en place à longueur égale à partir de l'octet déjà vu pour CET inode ; renvoie (clé d'état, lu, changé)."""
    o = ouvrir(dfd, nom, os.O_RDWR)
    if o is None:
        return None
    fd, st = o
    cle = f"{st.st_ino}:{nom}"
    depuis = etat_avant.get(cle, 0)
    change = False
    with os.fdopen(fd, "r+b") as f:
        pos = depuis if 0 <= depuis <= st.st_size else 0   # tronqué ou nouveau fichier : depuis le début
        f.seek(pos)
        while True:
            ligne = f.readline(LIGNE_MAX)
            if not ligne:
                break
            if not ligne.endswith(b"\n"):
                break            # ligne en cours d'écriture : reprise au prochain passage
            nouvelle = masquer(ligne)
            if nouvelle != ligne:
                fin = f.tell()
                f.seek(pos)
                f.write(nouvelle)
                f.seek(fin)
                change = True
            pos += len(ligne)
        if change:
            f.flush()
            os.fsync(f.fileno())
    return cle, pos, change


def traiter_gz(dfd: int, nom: str) -> bool:
    o = ouvrir(dfd, nom, os.O_RDONLY)
    if o is None:
        return False
    fd, st = o
    with os.fdopen(fd, "rb") as brut, gzip.GzipFile(fileobj=brut, mode="rb") as z:
        if not any(MOTIF.search(ligne) for ligne in iter(lambda: z.readline(LIGNE_MAX), b"")):
            return False
    libre = os.statvfs(f"/proc/self/fd/{dfd}")
    if libre.f_bavail * libre.f_frsize < st.st_size * 2 + MARGE_DISQUE:
        print(f"secubox-masquer-jetons-journaux : {nom} : place insuffisante, archive laissée", file=sys.stderr)
        return False
    tmp = f".{nom}.masque-{os.getpid()}"
    tfd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dfd)
    try:
        o = ouvrir(dfd, nom, os.O_RDONLY)
        if o is None:
            raise FileNotFoundError(nom)
        sfd, st2 = o
        if st2.st_ino != st.st_ino:
            os.close(sfd)
            raise FileNotFoundError(nom)
        with os.fdopen(sfd, "rb") as src, gzip.GzipFile(fileobj=src, mode="rb") as zin, \
                os.fdopen(os.dup(tfd), "wb") as dst, gzip.GzipFile(fileobj=dst, mode="wb", mtime=int(st.st_mtime)) as zout:
            for ligne in iter(lambda: zin.readline(LIGNE_MAX), b""):
                zout.write(masquer(ligne))
        os.fchown(tfd, st.st_uid, st.st_gid)
        os.fchmod(tfd, stat.S_IMODE(st.st_mode))
        os.utime(tfd, ns=(st.st_atime_ns, st.st_mtime_ns))
        os.fsync(tfd)
        os.rename(tmp, nom, src_dir_fd=dfd, dst_dir_fd=dfd)
        tmp = None
    finally:
        os.close(tfd)
        if tmp is not None:
            try:
                os.unlink(tmp, dir_fd=dfd)
            except OSError:
                pass
    return True


def lire_etat(chemin):
    try:
        with open(chemin) as f:
            d = json.load(f)
        return {str(k): int(v) for k, v in d.items()} if isinstance(d, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def ecrire_etat(chemin, etat):
    if not chemin:
        return
    try:
        os.makedirs(os.path.dirname(chemin), mode=0o755, exist_ok=True)
        tmp = f"{chemin}.tmp-{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(etat, f)
        os.replace(tmp, chemin)
    except OSError as e:
        print(f"secubox-masquer-jetons-journaux : état non écrit ({e.__class__.__name__})", file=sys.stderr)


def main(dossier: str = DOSSIER, etat_chemin: str = ETAT) -> int:
    try:
        dfd = os.open(dossier, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return 0
    etat_avant, etat = lire_etat(etat_chemin), {}
    traites, erreurs = 0, 0
    try:
        for nom in sorted(os.listdir(dfd)):
            if nom.startswith("."):
                continue
            try:
                if re.fullmatch(r"[A-Za-z0-9_.-]+\.log(?:\.\d+)?", nom):
                    r = traiter_clair(dfd, nom, etat_avant)
                    if r is not None:
                        cle, lu, change = r
                        etat[cle] = lu
                        traites += change
                elif re.fullmatch(r"[A-Za-z0-9_.-]+\.log\.\d+\.gz", nom):
                    traites += traiter_gz(dfd, nom)
            except (OSError, EOFError, gzip.BadGzipFile) as e:
                erreurs += 1
                print(f"secubox-masquer-jetons-journaux : {nom} : {e.__class__.__name__}", file=sys.stderr)
    finally:
        os.close(dfd)
    ecrire_etat(etat_chemin, etat)
    if traites:
        print(f"secubox-masquer-jetons-journaux : jetons masqués dans {traites} journal(aux) nginx")
    return 1 if erreurs else 0


if __name__ == "__main__":
    sys.exit(main())
