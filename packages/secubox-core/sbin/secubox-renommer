"""SecuBox-Deb :: secubox-renommer — LE renommage d'une box (#3126 L2 tâche 5, D3 ; corrige #3242).

Usage : secubox-renommer [--acteur <login>] <nom>        (root)

Un seul chemin pour renommer une box : la page Système (par l'unité root secubox-systeme-renommer@<nom>.service),
premier-pas et le pilotage distant (secubox-pilotagectl renommer). hostnamectl seul ne suffit pas : l'ancien nom
restait sur la ligne 127.0.1.1 de /etc/hosts (« sudo: unable to resolve host gk3 », #1544), dans
/etc/secubox/secubox.conf ([global] hostname), et Avahi l'annonçait encore (#1556).

Étapes, dans l'ordre, chacune défaite si une suivante échoue (état précédent rétabli) :
  1. /etc/hosts : ligne 127.0.1.1 (ancien nom et ses formes « ancien.domaine » remplacés, nom ajouté s'il manque) ;
     les autres lignes ne sont jamais touchées ;
  2. /etc/secubox/secubox.conf : clé hostname de la section [global] seulement (fichier gardé tel quel sans elle) ;
  3. hostnamectl set-hostname <nom> ;
  4. audit box_renommee {ancien, nouveau, acteur} dans /var/log/secubox/audit.log — une décision non auditée n'a pas
     lieu : audit impossible ⇒ tout est rétabli ;
  5. systemctl try-restart avahi-daemon.service (Avahi absent ou en échec : dit sur stderr, sans bloquer).
Idempotent : un nom déjà posé partout ne change rien (« inchange ») et n'est pas audité.

Refus : nom hors libellé DNS ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ (le motif du ctl) ; nom réservé (admin, www,
secubox, localhost) ; nom déjà pris au maillage (pair ENRÔLÉ de /var/lib/secubox/p2p/peers.json, s'il existe :
empreinte et jonction présentes ; une découverte mDNS ne réserve rien). Les refus de fond sont audités
(box_renommage_refuse), jamais l'argv brut.

Écritures : fichier temporaire exclusif dans le même dossier, fsync, renommage atomique ; dossiers et fichiers ouverts
sans suivre de lien (O_NOFOLLOW), fichier ordinaire à un seul lien exigé ; droits et propriétaire d'origine gardés.
Aucun shell : chaque commande est un argv à chemin absolu, environnement réduit, délai borné.

Sortie : une ligne JSON. Codes : 0 réussite ({"ok": true, "ancien", "nouveau"[, "inchange"]}) ; 1 erreur (audit
impossible, verrou) ; 2 argv invalide ou lancé hors root ; 3 nom réservé ; 4 nom déjà pris au maillage ; 5 écriture
impossible (lien, fichier non ordinaire, disque) ; 6 hostnamectl en échec. 5 et 6 : état précédent rétabli.

SBX_RACINE (tests) : racine substituée, hostnamectl et systemctl cherchés dans le PATH, honorée SEULEMENT si elle est
non vide et que l'appelant est le processus lui-même (jamais sous une élévation par sudo, R-L2-8).
"""
import datetime
import fcntl
import json
import os
import pwd
import re
import secrets
import shutil
import socket
import stat
import subprocess
import sys

RE_NOM = re.compile(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?")
RE_ACTEUR = re.compile(r"[a-z_][a-z0-9_.-]{0,63}")
RESERVES = frozenset({"admin", "www", "secubox", "localhost"})
PATH_SUR = "/usr/sbin:/usr/bin:/sbin:/bin"
TAILLE_MAX = 1 << 20
DELAI_HOSTNAMECTL = 30
DELAI_AVAHI = 30

MESSAGES = {
    2: "argv invalide",
    3: "nom réservé",
    4: "nom déjà pris au maillage",
    5: "écriture impossible (état précédent rétabli)",
    6: "hostnamectl en échec (état précédent rétabli)",
}


class Echec(Exception):
    """Refus ou échec rendu au code donné."""

    def __init__(self, code, message=None):
        super().__init__(message or MESSAGES.get(code, "erreur"))
        self.code = code


def err(msg):
    try:
        print(f"[secubox-renommer] {msg}", file=sys.stderr)
    except OSError:
        pass


def sortie(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


class Ctx:
    def __init__(self, acteur):
        racine = os.environ.get("SBX_RACINE", "")
        sudo_uid = os.environ.get("SUDO_UID", "")
        try:
            appelant = int(sudo_uid) if sudo_uid else os.getuid()
        except ValueError:
            appelant = -1
        if racine and appelant != os.geteuid():
            err("SBX_RACINE ignorée : l'appelant n'est pas le compte effectif (élévation par sudo)")
            racine = ""
        if not racine and os.geteuid() != 0:
            raise Echec(2, "à lancer en root")
        self.r = racine.rstrip("/")
        self.substitue = bool(racine)
        if self.substitue:
            self.hostnamectl = shutil.which("hostnamectl") or "hostnamectl"
            self.systemctl = shutil.which("systemctl") or "systemctl"
            self.env = dict(os.environ)
        else:
            # Vraie box : l'environnement ne choisit jamais une commande lancée en root.
            self.hostnamectl, self.systemctl = "/usr/bin/hostnamectl", "/usr/bin/systemctl"
            self.env = {"PATH": PATH_SUR, "LC_ALL": "C"}
        if acteur is None:
            sudo_user = os.environ.get("SUDO_USER", "")
            if RE_ACTEUR.fullmatch(sudo_user):
                acteur = sudo_user
            else:
                try:
                    acteur = pwd.getpwuid(appelant).pw_name
                except (KeyError, OverflowError):
                    acteur = str(appelant)
                acteur = acteur if RE_ACTEUR.fullmatch(acteur) else "inconnu"
        self.acteur = acteur


# --- Fichiers, sans suivre de lien --------------------------------------------------------------------------------

def ouvrir_dossier(ctx, relatif):
    """Descripteur du dossier {racine}/relatif, chaque composant ouvert sans suivre de lien."""
    fd = os.open(ctx.r or "/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for partie in [p for p in relatif.split("/") if p]:
            suivant = os.open(partie, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = suivant
    except OSError:
        os.close(fd)
        raise
    return fd


class Fichier:
    """Contenu d'origine (None si absent) et droits d'un fichier, lus par le descripteur de son dossier."""

    def __init__(self, ctx, dossier, nom):
        self.dossier, self.nom = dossier, nom
        self.dfd = ouvrir_dossier(ctx, dossier)
        self.contenu, self.mode, self.uid, self.gid = None, 0o644, None, None
        try:
            f = os.open(nom, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=self.dfd)
        except FileNotFoundError:
            return
        try:
            st = os.fstat(f)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size > TAILLE_MAX:
                raise OSError(f"{dossier}/{nom} n'est pas un fichier ordinaire")
            self.mode, self.uid, self.gid = stat.S_IMODE(st.st_mode), st.st_uid, st.st_gid
            self.contenu = os.read(f, TAILLE_MAX + 1)
        finally:
            os.close(f)

    def ecrire(self, donnees):
        """Écriture atomique (temporaire exclusif, fsync, renommage), droits et propriétaire d'origine gardés."""
        tmp = f".{self.nom}.renommer.{secrets.token_hex(4)}"
        f = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=self.dfd)
        try:
            try:
                if self.uid is not None:
                    try:
                        os.fchown(f, self.uid, self.gid)
                    except PermissionError:
                        pass                                      # tests sans root : propriétaire inchangeable
                os.fchmod(f, self.mode)
                os.write(f, donnees)
                os.fsync(f)
            finally:
                os.close(f)
            os.replace(tmp, self.nom, src_dir_fd=self.dfd, dst_dir_fd=self.dfd)
            os.fsync(self.dfd)
        except OSError:
            try:
                os.unlink(tmp, dir_fd=self.dfd)
            except OSError:
                pass
            raise

    def retablir(self):
        if self.contenu is None:
            try:
                os.unlink(self.nom, dir_fd=self.dfd)
            except FileNotFoundError:
                pass
        else:
            self.ecrire(self.contenu)

    def fermer(self):
        os.close(self.dfd)


# --- Contenus ------------------------------------------------------------------------------------------------------

def hosts_renomme(texte, ancien, nouveau):
    """Seules les lignes 127.0.1.1 changent : l'ancien nom (et « ancien.domaine ») devient le nouveau ; une ligne
    127.0.1.1 qui ne porte pas le nouveau nom est remplacée par « 127.0.1.1<TAB>nouveau »."""
    lignes = texte.splitlines()
    sortie_l, vue = [], False
    for ligne in lignes:
        m = re.match(r"^(\s*127\.0\.1\.1)(\s+)([^#]*?)(\s*(#.*)?)$", ligne)
        if not m:
            sortie_l.append(ligne)
            continue
        noms = m.group(3).split()
        if ancien and ancien != nouveau:
            noms = [nouveau if n == ancien else (nouveau + n[len(ancien):] if n.startswith(ancien + ".") else n)
                    for n in noms]
        if nouveau in noms and not vue:
            sortie_l.append(f"{m.group(1)}{m.group(2)}{' '.join(noms)}{m.group(4) or ''}")
            vue = True
    if not vue:
        sortie_l.append(f"127.0.1.1\t{nouveau}")
    return "\n".join(sortie_l) + "\n"


def conf_renomme(texte, nouveau):
    """hostname de la section [global] seulement ; sans section ni clé, texte inchangé."""
    lignes = texte.split("\n")
    section = None
    for i, ligne in enumerate(lignes):
        s = ligne.strip()
        if s.startswith("["):
            section = s
            continue
        if section == "[global]" and re.match(r'^\s*hostname\s*=\s*"[^"]*"\s*(#.*)?$', ligne):
            lignes[i] = re.sub(r'^(\s*hostname\s*=\s*)"[^"]*"', rf'\g<1>"{nouveau}"', ligne, count=1)
            break
    return "\n".join(lignes)


def nom_actuel(ctx):
    try:
        fd = ouvrir_dossier(ctx, "etc")
        try:
            f = os.open("hostname", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
            try:
                brut = os.read(f, 512).decode("utf-8", "replace")
            finally:
                os.close(f)
        finally:
            os.close(fd)
        nom = brut.strip().splitlines()[0].strip() if brut.strip() else ""
    except OSError:
        nom = ""
    if not nom and not ctx.substitue:
        nom = socket.gethostname()
    return nom if RE_NOM.fullmatch(nom or "") else ""


def noms_pris(ctx):
    """Noms des pairs ENRÔLÉS du maillage vus par la box (peers.json, s'il existe)."""
    try:
        fd = ouvrir_dossier(ctx, "var/lib/secubox/p2p")
    except OSError:
        return set()
    try:
        try:
            f = os.open("peers.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        except OSError:
            return set()
        try:
            st = os.fstat(f)
            if not stat.S_ISREG(st.st_mode) or st.st_size > TAILLE_MAX:
                return set()
            doc = json.loads(os.read(f, TAILLE_MAX + 1).decode("utf-8"))
        except (OSError, ValueError):
            return set()
        finally:
            os.close(f)
    finally:
        os.close(fd)
    liste = doc.get("peers") if isinstance(doc, dict) else doc
    if not isinstance(liste, list):
        return set()
    return {p["name"].strip().lower() for p in liste
            if isinstance(p, dict) and isinstance(p.get("name"), str)
            and all(isinstance(p.get(c), str) and p.get(c).strip() for c in ("fingerprint", "joined_via"))}


# --- Audit et commandes --------------------------------------------------------------------------------------------

def auditer(ctx, evenement, **champs):
    """Une ligne JSON dans audit.log (dossier et journal sans lien, fichier ordinaire à un seul lien)."""
    ligne = {"ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"), "module": "renommer",
             "evenement": evenement, "acteur": ctx.acteur}
    ligne.update({k: v for k, v in champs.items() if v is not None})
    donnees = (json.dumps(ligne, ensure_ascii=False) + "\n").encode("utf-8")
    dfd = ouvrir_dossier(ctx, "var/log/secubox")
    try:
        try:
            fd = os.open("audit.log", os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
        except FileNotFoundError:
            fd = os.open("audit.log", os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640,
                         dir_fd=dfd)
            if not ctx.substitue:
                try:
                    pw = pwd.getpwnam("secubox")
                    os.fchown(fd, pw.pw_uid, pw.pw_gid)
                except (KeyError, OSError):
                    pass
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                raise OSError("journal d'audit qui n'est pas un fichier ordinaire")
            os.write(fd, donnees)
        finally:
            os.close(fd)
    finally:
        os.close(dfd)


def auditer_refus(ctx, nom, motif):
    try:
        auditer(ctx, "box_renommage_refuse", nom=nom, refus=motif)
    except OSError as e:
        err(f"refus non audité ({e.__class__.__name__})")


def lancer(ctx, argv, delai):
    try:
        r = subprocess.run(argv, env=ctx.env, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=delai)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, e.__class__.__name__
    return r.returncode == 0, (r.stderr or r.stdout or "").strip()[:200]


def verrou(ctx):
    dfd = ouvrir_dossier(ctx, "run")
    try:
        fd = os.open("secubox-renommer.lock", os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600, dir_fd=dfd)
    finally:
        os.close(dfd)
    fcntl.flock(fd, fcntl.LOCK_EX)                                 # un renommage à la fois (borné par l'appelant)
    return fd


# --- Renommage -----------------------------------------------------------------------------------------------------

def renommer(ctx, nouveau):
    if nouveau in RESERVES:
        auditer_refus(ctx, nouveau, MESSAGES[3])
        raise Echec(3)
    ancien = nom_actuel(ctx)
    if nouveau != ancien and nouveau in noms_pris(ctx):
        auditer_refus(ctx, nouveau, MESSAGES[4])
        raise Echec(4)
    fichiers, ecrits = [], []
    try:
        try:
            hosts = Fichier(ctx, "etc", "hosts")
            fichiers.append(hosts)
            conf = Fichier(ctx, "etc/secubox", "secubox.conf")
            fichiers.append(conf)
            neuf_hosts = hosts_renomme((hosts.contenu or b"127.0.0.1\tlocalhost\n").decode("utf-8"), ancien,
                                       nouveau).encode("utf-8")
            neuf_conf = (conf_renomme(conf.contenu.decode("utf-8"), nouveau).encode("utf-8")
                         if conf.contenu is not None else None)
        except (OSError, UnicodeDecodeError) as e:
            err(f"lecture refusée ({e.__class__.__name__}) : rien n'est changé")
            auditer_refus(ctx, nouveau, MESSAGES[5])
            raise Echec(5) from None
        if ancien == nouveau and neuf_hosts == hosts.contenu and neuf_conf == conf.contenu:
            return {"ok": True, "ancien": ancien, "nouveau": nouveau, "inchange": True}
        try:
            if neuf_hosts != hosts.contenu:
                hosts.ecrire(neuf_hosts)
                ecrits.append(hosts)
            if neuf_conf is not None and neuf_conf != conf.contenu:
                conf.ecrire(neuf_conf)
                ecrits.append(conf)
        except OSError as e:
            err(f"écriture impossible ({e.__class__.__name__}) : état précédent rétabli")
            retablir(ctx, ecrits, None)
            auditer_refus(ctx, nouveau, MESSAGES[5])
            raise Echec(5) from None
        ok, detail = lancer(ctx, [ctx.hostnamectl, "set-hostname", nouveau], DELAI_HOSTNAMECTL)
        if not ok:
            err(f"hostnamectl en échec ({detail}) : état précédent rétabli")
            retablir(ctx, ecrits, None)
            auditer_refus(ctx, nouveau, MESSAGES[6])
            raise Echec(6)
        try:
            auditer(ctx, "box_renommee", ancien=ancien or None, nouveau=nouveau)
        except OSError as e:
            err(f"audit impossible ({e.__class__.__name__}) : état précédent rétabli")
            retablir(ctx, ecrits, ancien)
            raise Echec(1, "audit impossible (état précédent rétabli)") from None
    finally:
        for f in fichiers:
            f.fermer()
    ok, detail = lancer(ctx, [ctx.systemctl, "try-restart", "avahi-daemon.service"], DELAI_AVAHI)
    if not ok:
        err(f"Avahi non relancé ({detail}) : le nom .local suivra au prochain démarrage d'avahi-daemon")
    return {"ok": True, "ancien": ancien, "nouveau": nouveau}


def retablir(ctx, ecrits, ancien):
    """Défait, dans l'ordre inverse : le nom (si ancien est donné), puis les fichiers écrits."""
    if ancien:
        ok, detail = lancer(ctx, [ctx.hostnamectl, "set-hostname", ancien], DELAI_HOSTNAMECTL)
        if not ok:
            err(f"rétablissement du nom « {ancien} » en échec ({detail})")
    for f in reversed(ecrits):
        try:
            f.retablir()
        except OSError as e:
            err(f"rétablissement de {f.dossier}/{f.nom} en échec ({e.__class__.__name__})")


def analyser(argv):
    acteur = None
    if argv[:1] == ["--acteur"]:
        if len(argv) < 2 or not RE_ACTEUR.fullmatch(argv[1]):
            raise Echec(2)
        acteur, argv = argv[1], argv[2:]
    if len(argv) != 1 or not RE_NOM.fullmatch(argv[0]):
        raise Echec(2)
    return acteur, argv[0]


def main(argv):
    os.umask(0o022)
    try:
        acteur, nom = analyser(argv)
        ctx = Ctx(acteur)
        fd = verrou(ctx)
        try:
            res = renommer(ctx, nom)
        finally:
            os.close(fd)
    except Echec as e:
        err(str(e))
        sortie({"ok": False, "erreur": str(e), "code": e.code})
        return e.code
    except OSError as e:
        err(f"erreur : {e.__class__.__name__}")
        sortie({"ok": False, "erreur": "erreur système", "code": 1})
        return 1
    sortie(res)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
