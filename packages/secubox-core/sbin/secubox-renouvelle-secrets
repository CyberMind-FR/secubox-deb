#!/usr/bin/env bash
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
# Source-Disclosed License — All rights reserved except as expressly granted.
# See LICENCE-CMSD-1.0.md for terms.
#
# SecuBox-Deb :: secubox-renouvelle-secrets — les secrets d'une box sont générés SUR la box (#3243)
#
# POURQUOI. Les images construites en CI embarquaient des secrets générés dans le chroot : clés d'hôte SSH (commentaire
# root@runnervm…), clé de signature OIDC, clé TLS du frontal, clé WireGuard du p2p éphémère, jeton d'appairage,
# machine-id, et un compte admin au nom du runner. Leurs générateurs étant du type « crée si absent », le premier
# démarrage les gardait : toutes les box d'une image partageaient ces secrets, téléchargeables avec l'image publique.
#
#   secubox-renouvelle-secrets                     constat : chaque secret, sa date, l'origine de la clé d'hôte (rien ne change)
#   secubox-renouvelle-secrets --absents           crée ceux qui manquent (premier démarrage d'une image nettoyée)
#   secubox-renouvelle-secrets --tout --oui        les régénère TOUS (box installée depuis une image publiée)
#                              [--machine-id]      … et l'identifiant de machine (redémarrage conseillé, bail DHCP neuf possible)
#                              [--desactiver NOM]  … et ce compte admin (répétable). D'office : les comptes runnervm*, et celui
#                                                  au nom de la machine de la clé d'hôte s'il n'a jamais servi (sans mot de
#                                                  passe, sans connexion, mot de passe à changer) ; jamais un compte légitime.
#
# À lancer à l'abri d'une coupure de la session SSH (RSA est lent sur Armada) :
#   systemd-run --wait --pipe --collect secubox-renouvelle-secrets --tout --oui
# Chaque secret est généré à part (dossier root 0700), validé, puis posé par renommage ; l'ancien est gardé de côté et remis
# si le générateur ou la validation échoue : jamais de box sans clé d'hôte. Le postinst de secubox-p2p est relancé : il
# REDÉMARRE les unités p2p ; refusé pendant qu'apt ou dpkg tourne ; sa sortie va dans /var/log/secubox/renouvelle-secrets.log.
# Une copie HAProxy de l'ancienne clé TLS (crt de /etc/haproxy, ex. 000-defaut.pem) est remplacée, haproxy -c puis reload.
# Code 1 si un secret n'a pas pu être renouvelé : il est nommé, et l'ancien reste en place.
#
# Chaque secret passe par le générateur de son paquet : ssh-keygen -A, secubox-oidcctl init, postinst de secubox-p2p
# (le jeton est interpolé dans nginx), openssl comme l'étape 9 de secubox-firstboot, systemd-id128. L'audit nomme les
# secrets renouvelés, jamais leur valeur. Les sessions SSH ouvertes restent ; les clients oublient l'ancienne empreinte
# (ssh-keygen -R <box>).
#
# Variables de substitution (tests), honorées SEULEMENT si SBX_RACINE est non vide ; sans elle (vraie box) elles sont
# ignorées et nommées : SBX_HOSTNAME, SBX_SYSTEMCTL, SBX_NGINX, SBX_SSHD, SBX_OIDCCTL, SBX_USERSCTL, SBX_P2P_POSTINST,
# SBX_DPKG_QUERY, SBX_WG, SBX_HAPROXY, SBX_HAPROXY_CFG.
set -Eeuo pipefail
umask 077

log() { echo "[secrets] $*" 2>/dev/null || true; }        # la session peut être tombée : une sortie perdue n'arrête rien
err() { echo "[secrets] $*" >&2 2>/dev/null || true; }
derniere_ligne() { tail -n 1 | LC_ALL=C tr -cd '[:print:]' | cut -c 1-200; }

R="${SBX_RACINE:-}"
if [ -n "$R" ]; then
    # Racine de substitution (tests) : chemins sous $R, commandes surchargeables.
    SYSTEMCTL="${SBX_SYSTEMCTL:-systemctl}"
    NGINX="${SBX_NGINX:-nginx}"
    SSHD="${SBX_SSHD:-/usr/sbin/sshd}"
    OIDCCTL="${SBX_OIDCCTL:-/usr/sbin/secubox-oidcctl}"
    USERSCTL="${SBX_USERSCTL:-/usr/sbin/usersctl}"
    P2P_POSTINST="${SBX_P2P_POSTINST:-/var/lib/dpkg/info/secubox-p2p.postinst}"
    DPKG_QUERY="${SBX_DPKG_QUERY:-dpkg-query}"
    WG="${SBX_WG:-wg}"
    HAPROXY="${SBX_HAPROXY:-haproxy}"
    HAPROXY_CFG="${SBX_HAPROXY_CFG:-$R/etc/haproxy/haproxy.cfg}"
    HOTE="${SBX_HOSTNAME:-$(hostname)}"
else
    # Vraie box : l'environnement ne choisit jamais une commande lancée en root. On nomme ce qu'on ignore (jamais la valeur).
    SYSTEMCTL=systemctl NGINX=nginx SSHD=/usr/sbin/sshd OIDCCTL=/usr/sbin/secubox-oidcctl USERSCTL=/usr/sbin/usersctl
    P2P_POSTINST=/var/lib/dpkg/info/secubox-p2p.postinst DPKG_QUERY=dpkg-query WG=wg HAPROXY=haproxy
    HAPROXY_CFG=/etc/haproxy/haproxy.cfg
    HOTE="$(hostname)"
    mapfile -t _sbx < <(compgen -e -X '!SBX_*' || true)
    _ignorees=()
    for _v in "${_sbx[@]}"; do [ "$_v" = SBX_RACINE ] || _ignorees+=("$_v"); done
    [ "${#_ignorees[@]}" -eq 0 ] || err "surcharges ignorées sans SBX_RACINE (vraie box) : ${_ignorees[*]}"
fi

SSH_DIR="$R/etc/ssh"
OIDC="$R/etc/secubox/secrets/oidc/signing.pem"
P2P_DIR="$R/etc/secubox/secrets/p2p"
P2P_NGX="$R/etc/nginx/secubox-p2p-pair.conf"
TLS_DIR="$R/etc/secubox/tls"
USERS="$R/etc/secubox/users.json"
MID="$R/etc/machine-id"
MID_DBUS="$R/var/lib/dbus/machine-id"
JOURNAUX="$R/var/log/secubox"
AUDIT="$JOURNAUX/audit.log"
DPKG_VERROU="$R/var/lib/dpkg/lock-frontend"

MODE=constat OUI=0 AVEC_MID=0 A_DESACTIVER=()
while [ $# -gt 0 ]; do case "$1" in
    --absents) MODE=absents; shift ;;
    --tout) MODE=tout; shift ;;
    --oui) OUI=1; shift ;;
    --machine-id) AVEC_MID=1; shift ;;
    --desactiver)
        if [ $# -lt 2 ] || [[ ! "$2" =~ ^[a-z0-9][a-z0-9_.-]{0,63}$ ]]; then
            echo "--desactiver NOM : nom de compte attendu ([a-z0-9][a-z0-9_.-]*)" >&2; exit 2
        fi
        A_DESACTIVER+=("$2"); shift 2 ;;
    -h|--help) awk 'NR >= 7 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
    *) echo "argument inconnu : $1" >&2; exit 2 ;;
esac; done
if [ -z "$R" ] && [ "$(id -u)" -ne 0 ]; then echo "à lancer en root" >&2; exit 2; fi
if [ "$MODE" = tout ] && [ "$OUI" -ne 1 ]; then
    echo "--tout régénère clés d'hôte SSH, OIDC, TLS et p2p (jetons OIDC en cours invalidés, empreinte SSH changée) : ajouter --oui" >&2
    exit 2
fi
if [ "$AVEC_MID" -eq 1 ] && [ "$MODE" != tout ]; then echo "--machine-id va avec --tout" >&2; exit 2; fi
if [ "${#A_DESACTIVER[@]}" -gt 0 ] && [ "$MODE" != tout ]; then echo "--desactiver va avec --tout" >&2; exit 2; fi

# Nom de la box en minuscules (GK5 → gk5) ; « secubox » seulement s'il reste invalide.
HOTE="${HOTE,,}"
[[ "$HOTE" =~ ^[a-z0-9][a-z0-9.-]{0,62}$ ]] || HOTE=secubox
ACTEUR="$(printf '%s' "${SUDO_USER:-root}" | LC_ALL=C tr -cd 'a-z0-9_.-')"
[ -n "$ACTEUR" ] || ACTEUR=root

date_de() { if [ -e "$1" ]; then date -r "$1" '+%Y-%m-%d %H:%M'; else echo "absent"; fi; }

AUDIT_OK=1
audit() { # EVENEMENT CLE VALEUR — identifiants seulement, jamais une valeur secrète
    if [ ! -d "$JOURNAUX" ]; then      # jamais créé ici : son propriétaire et son mode sont ceux de secubox-core
        err "audit impossible (${JOURNAUX#"$R"} absent) : « $1 $3 » non tracé"; AUDIT_OK=0; return 0
    fi
    if [ ! -e "$AUDIT" ]; then
        local -a proprio=()
        if [ -z "$R" ] && getent passwd secubox >/dev/null; then proprio=(-o secubox -g secubox); fi
        if ! install -m 0640 "${proprio[@]}" /dev/null "$AUDIT"; then
            err "audit : création de ${AUDIT#"$R"} impossible"; AUDIT_OK=0; return 0
        fi
    fi
    if ! printf '{"ts": "%s", "module": "core", "evenement": "%s", "%s": "%s", "mode": "%s", "acteur": "%s"}\n' \
            "$(date -u -Iseconds)" "$1" "$2" "$3" "$MODE" "$ACTEUR" >> "$AUDIT"; then
        err "audit : écriture impossible dans ${AUDIT#"$R"}"; AUDIT_OK=0
    fi
}

ECHECS=()
echec() { ECHECS+=("$1"); err "$1 : $2"; }   # SECRET MOTIF — nommé dans le résumé final, code de retour 1

# Commentaire de la clé d'hôte (root@<machine>), en minuscules et réduit à [a-z0-9.@-] : jamais affiché brut.
commentaire_cle() {
    local c
    c="$(awk '{print $3}' "$SSH_DIR/ssh_host_ed25519_key.pub" 2>/dev/null || true)"
    printf '%s' "${c,,}" | LC_ALL=C tr -cd 'a-z0-9.@-'
}

# Machine qui a généré la clé d'hôte, d'après son commentaire ; vide si absent.
machine_de_la_cle() {
    local c
    c="$(commentaire_cle)"
    case "$c" in *@*) c="${c#*@}"; printf '%s' "${c//@/}" ;; esac
}

# Comptes admin à désactiver d'office : un runner de CI (runnervm*), ou le compte au nom de la machine de la clé d'hôte
# s'il n'a jamais servi (sans mot de passe, jamais connecté, mot de passe à changer). Un compte légitime sans mot de
# passe (OTP, Google…) n'est pas touché : --desactiver NOM pour le reste. Code 3 si users.json est illisible.
comptes_de_construction() { # MACHINE
    [ -e "$USERS" ] || return 0
    python3 -I - "$USERS" "$1" "$HOTE" <<'PY'
import json, re, sys
chemin, machine, hote = sys.argv[1:4]
try:
    with open(chemin, encoding="utf-8") as f:
        users = json.load(f).get("users", [])
    if not isinstance(users, list):
        raise ValueError("users n'est pas une liste")
except (OSError, ValueError, AttributeError) as e:
    print(f"users.json illisible ({type(e).__name__})", file=sys.stderr)
    sys.exit(3)
for u in users:
    if not isinstance(u, dict):
        continue
    n = u.get("username")
    if not isinstance(n, str) or not re.fullmatch(r"[a-z0-9][a-z0-9_.-]{0,63}", n) or u.get("password_hash"):
        continue
    if u.get("enabled") is False:
        continue
    if re.fullmatch(r"runnervm[a-z0-9]+", n):
        print(n)
    elif machine and n == machine and n != hote and u.get("must_change_password") is True and not u.get("last_login"):
        print(n)
PY
}

# apt ou dpkg tient-il son verrou ? (verrou fcntl : flock(1) ne le verrait pas)
dpkg_occupe() {
    [ -e "$DPKG_VERROU" ] || return 1
    python3 -I - "$DPKG_VERROU" <<'PY'
import fcntl, os, sys
try:
    fd = os.open(sys.argv[1], os.O_RDWR | os.O_NOFOLLOW)
except OSError:
    sys.exit(1)
try:
    fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)
sys.exit(1)
PY
}

constat() {
    local m c
    m="$(machine_de_la_cle)"
    printf '%-11s %-17s %s %s\n' ssh-hote "$(date_de "$SSH_DIR/ssh_host_ed25519_key")" \
        "$(ssh-keygen -lf "$SSH_DIR/ssh_host_ed25519_key.pub" 2>/dev/null | awk '{print $2}' || true)" "$(commentaire_cle)"
    if [ -n "$m" ] && [ "$m" != "$HOTE" ]; then
        log "  la clé d'hôte porte « root@$m », pas « $HOTE » : générée ailleurs (image) ou avant un renommage"
    fi
    case "$m" in runnervm*) log "  « $m » est une machine de CI : clé d'hôte d'une image publiée, à renouveler (--tout --oui)" ;; esac
    printf '%-11s %-17s\n' tls "$(date_de "$TLS_DIR/key.pem")"
    printf '%-11s %-17s\n' oidc "$(date_de "$OIDC")"
    printf '%-11s %-17s jeton %s\n' p2p "$(date_de "$P2P_DIR/wg-ephemeral.key")" "$(date_de "$P2P_DIR/pair.token")"
    printf '%-11s %-17s\n' machine-id "$(date_de "$MID")"
    if c="$(comptes_de_construction "$m" | paste -sd' ')"; then
        [ -z "$c" ] || log "comptes admin d'une machine de construction, désactivés d'office par --tout : $c"
    else
        log "users.json illisible : --tout refusera de tourner"
    fi
}

# ── Mise de côté et retour arrière ─────────────────────────────────────────────────────────────────────────────────
# TRAVAIL : dossier root 0700 sous /etc (même système de fichiers que /etc/ssh et /etc/secubox) ; on y génère, on y
# garde les anciens. Un ancien est gardé par lien dur (même inode : rien n'est copié, aucun lien symbolique suivi) ; la
# neuve le remplace par renommage. EN_ATTENTE liste les anciens de l'étape en cours : remis si elle échoue ou si l'outil
# s'arrête ; vidée quand l'étape est finie (les anciens partent avec TRAVAIL, à la fin).
TRAVAIL="" GARDER_TRAVAIL=0 N_COTE=0 DE_COTE="" TEMPO=""   # TEMPO : temporaire hors de TRAVAIL, retiré à l'arrêt
EN_ATTENTE=() HAPROXY_EN_ATTENTE=()

de_cote() { # CHEMIN
    DE_COTE="$TRAVAIL/avant.$((N_COTE += 1))"
    ln -P -- "$1" "$DE_COTE"
    EN_ATTENTE+=("$DE_COTE|$1")
}

copie_de_cote() { # CHEMIN — pour un fichier que son générateur peut réécrire sur place (un lien dur suivrait l'écriture)
    DE_COTE="$TRAVAIL/avant.$((N_COTE += 1))"
    cp -p -P -- "$1" "$DE_COTE"
    EN_ATTENTE+=("$DE_COTE|$1")
}

retour_arriere() { # remet les anciens de l'étape, du dernier au premier ; 1 si l'un n'a pas pu l'être
    local i s o rc=0
    for (( i = ${#EN_ATTENTE[@]} - 1; i >= 0; i-- )); do
        s="${EN_ATTENTE[i]%%|*}" o="${EN_ATTENTE[i]#*|}"
        if [ "$s" -ef "$o" ]; then rm -f -- "$s" || rc=1          # jamais remplacé : rien à remettre
        else mv -fT -- "$s" "$o" || rc=1; fi
    done
    EN_ATTENTE=()
    [ "$rc" -eq 0 ] || GARDER_TRAVAIL=1
    return "$rc"
}

remet_haproxy() { # remet les .pem d'HAProxy gardés (copies : /srv ou /data peut être un autre disque)
    local e s f t rc=0
    for e in "${HAPROXY_EN_ATTENTE[@]}"; do
        s="${e%%|*}" f="${e#*|}"
        t="$(mktemp "$(dirname "$f")/.renouvelle.XXXXXX")" || { rc=1; continue; }
        TEMPO="$t"
        if ! { cp -p -- "$s" "$t" && mv -fT -- "$t" "$f"; }; then rm -f -- "$t"; rc=1; fi
        TEMPO=""
    done
    HAPROXY_EN_ATTENTE=()
    [ "$rc" -eq 0 ] || GARDER_TRAVAIL=1
    return "$rc"
}

fin() {
    local rc=$?
    trap - ERR
    [ -z "$TEMPO" ] || rm -f -- "$TEMPO"
    if [ "${#EN_ATTENTE[@]}" -gt 0 ] || [ "${#HAPROXY_EN_ATTENTE[@]}" -gt 0 ]; then
        err "arrêt en cours d'étape : anciens secrets remis en place"
        retour_arriere || err "remise incomplète"
        remet_haproxy || err "remise HAProxy incomplète"
    fi
    if [ -n "$TRAVAIL" ]; then
        if [ "$GARDER_TRAVAIL" -eq 1 ]; then err "anciens secrets gardés dans ${TRAVAIL#"$R"} (root 0700) : à remettre à la main"
        else rm -rf -- "$TRAVAIL"; fi
    fi
    exit "$rc"
}

# ── Générateurs ──────────────────────────────────────────────────────────────────────────────────────────────────────
desactive_comptes() { # MACHINE — en PREMIER : un échec ici arrête tout, avant qu'un secret ne change
    local liste n
    local -a noms=()
    local -A vus=()
    if ! liste="$(comptes_de_construction "$1")"; then
        err "${USERS#"$R"} illisible : aucun secret renouvelé (corriger le fichier, puis relancer)"; exit 1
    fi
    [ -z "$liste" ] || mapfile -t noms <<< "$liste"
    for n in "${noms[@]}" "${A_DESACTIVER[@]}"; do
        [ -z "${vus[$n]:-}" ] || continue
        vus[$n]=1
        if ! "$USERSCTL" disable "$n" >/dev/null; then
            err "usersctl disable $n a échoué : aucun secret renouvelé"; exit 1
        fi
        audit compte_desactive compte "$n"
        log "compte admin « $n » désactivé"
    done
}

sshd_teste() { # [-h CLÉ]… — sshd -t ; sa dernière ligne sur la sortie s'il refuse
    local s
    if s="$("$SSHD" -t -f "$SSH_DIR/sshd_config" "$@" 2>&1)"; then return 0; fi
    derniere_ligne <<< "$s"
    return 1
}

SSH_NEUF=0
renouvelle_ssh() {
    local neuf="$TRAVAIL/ssh" k f nom motif ssh_actif=0
    local -a cles=() h=()
    local -A neufs=()
    if [ "$MODE" != tout ] && [ -f "$SSH_DIR/ssh_host_ed25519_key" ]; then return 0; fi
    if ! command -v ssh-keygen >/dev/null; then
        echec ssh-hote "ssh-keygen absent (paquet openssh-client) : clés d'hôte intactes"; return 0
    fi
    mkdir -p "$SSH_DIR" "$neuf/etc/ssh"
    # 1. Générer à part : ssh-keygen -A -f PRÉFIXE écrit dans PRÉFIXE/etc/ssh, sous TRAVAIL.
    if ! ssh-keygen -A -f "$neuf" >/dev/null 2>&1; then
        echec ssh-hote "ssh-keygen -A a échoué : anciennes clés intactes"; return 0
    fi
    # 2. Valider : chaque clé privée neuve se relit et redonne sa clé publique ; sshd la charge.
    for k in "$neuf"/etc/ssh/ssh_host_*_key; do
        if [ ! -f "$k" ] || [ ! -f "$k.pub" ] || \
           [ "$(ssh-keygen -y -f "$k" 2>/dev/null | awk '{print $1, $2}' || true)" != "$(awk '{print $1, $2}' "$k.pub")" ]; then
            echec ssh-hote "clé neuve ${k##*/} illisible : anciennes clés intactes"; return 0
        fi
        cles+=("$k"); h+=(-h "$k"); neufs[${k##*/}]=1
    done
    if "$SYSTEMCTL" is-active -q ssh; then ssh_actif=1; fi
    if [ "$ssh_actif" -eq 1 ] && [ -x "$SSHD" ] && ! motif="$(sshd_teste "${h[@]}")"; then
        echec ssh-hote "sshd -t refuse les clés neuves ($motif) : anciennes clés intactes"; return 0
    fi
    # 3. Échanger paire par paire : l'ancienne gardée, la neuve posée par renommage — à aucun instant une clé d'hôte
    #    n'est absente. --absents ne pose que les types qui manquent.
    for k in "${cles[@]}"; do
        f="$SSH_DIR/${k##*/}"
        if [ "$MODE" != tout ] && { [ -e "$f" ] || [ -L "$f" ]; }; then continue; fi
        if [ -f "$f" ] || [ -L "$f" ]; then de_cote "$f"; fi
        if [ -f "$f.pub" ] || [ -L "$f.pub" ]; then de_cote "$f.pub"; fi
        chmod 0600 "$k"; chmod 0644 "$k.pub"
        mv -fT -- "$k" "$f"
        mv -fT -- "$k.pub" "$f.pub"
    done
    # Les types qui ne sont plus générés (dsa…) partent aussi : une clé d'image ne doit pas rester servie.
    if [ "$MODE" = tout ]; then
        for f in "$SSH_DIR"/ssh_host_*_key "$SSH_DIR"/ssh_host_*_key.pub; do
            { [ -f "$f" ] || [ -L "$f" ]; } || continue
            nom="${f##*/}"
            [ -z "${neufs[${nom%.pub}]:-}" ] || continue
            de_cote "$f"; rm -f -- "$f"
        done
    fi
    # 4. sshd relit sa configuration avec les clés posées ; un refus remet les anciennes, sans rechargement.
    if [ "$ssh_actif" -eq 1 ]; then
        if [ -x "$SSHD" ] && ! motif="$(sshd_teste)"; then
            retour_arriere || err "remise des clés d'hôte incomplète"
            echec ssh-hote "sshd -t refuse la configuration ($motif) : anciennes clés remises, sshd non rechargé"; return 0
        fi
        if ! "$SYSTEMCTL" reload ssh; then
            retour_arriere || err "remise des clés d'hôte incomplète"
            echec ssh-hote "rechargement de ssh refusé : anciennes clés remises"; return 0
        fi
    elif "$SYSTEMCTL" is-enabled -q ssh; then
        # Arrêté faute de clés (premier démarrage) : on le démarre. Un SSH volontairement coupé (désactivé) le reste.
        "$SYSTEMCTL" start ssh || err "ssh ne démarre pas (journalctl -u ssh) ; clés neuves en place"
    fi
    EN_ATTENTE=()
    SSH_NEUF=1
    audit secret_renouvele secret ssh-hote
    log "clés d'hôte SSH : $(ssh-keygen -lf "$SSH_DIR/ssh_host_ed25519_key.pub" 2>/dev/null | awk '{print $2}' || true)"
}

TLS_NEUF=0 ANCIENNE_PUB_TLS="" NGINX_A_RECHARGER=0
renouvelle_tls() {
    local neuf="$TRAVAIL/tls" k c
    local -a proprio=()
    if [ "$MODE" != tout ] && [ -f "$TLS_DIR/key.pem" ] && [ -f "$TLS_DIR/cert.pem" ]; then return 0; fi
    if [ -L "$TLS_DIR" ] || { [ -e "$TLS_DIR" ] && [ ! -d "$TLS_DIR" ]; }; then
        echec tls "${TLS_DIR#"$R"} n'est pas un dossier : rien n'y est écrit"; return 0
    fi
    if [ -z "$R" ] && getent passwd secubox >/dev/null; then proprio=(-o secubox -g secubox); fi
    # Créé s'il manque, comme l'étape 9 de secubox-firstboot ; un dossier existant garde son mode.
    [ -d "$TLS_DIR" ] || install -d -m 0750 "${proprio[@]}" "$TLS_DIR"
    # Généré et mis aux droits dans TRAVAIL : TLS_DIR appartient à secubox, qui pourrait y substituer un lien pendant les
    # secondes de RSA 4096. Mêmes paramètres que l'étape 9 de secubox-firstboot, plus localhost.
    mkdir "$neuf"
    k="$neuf/key.pem" c="$neuf/cert.pem"
    if ! openssl req -x509 -newkey rsa:4096 -days 3650 -nodes -keyout "$k" -out "$c" \
            -subj "/CN=${HOTE}/O=CyberMind SecuBox/C=FR" \
            -addext "subjectAltName=DNS:${HOTE},DNS:secubox.local,DNS:localhost,IP:192.168.10.1,IP:127.0.0.1" >/dev/null 2>&1; then
        echec tls "openssl a échoué : clé et certificat inchangés"; return 0
    fi
    cat "$c" "$k" > "$neuf/haproxy.pem"          # pour les copies HAProxy : certificat puis clé, comme haproxyctl
    chmod 0640 "$k"; chmod 0644 "$c"
    [ "${#proprio[@]}" -eq 0 ] || chown -h secubox:secubox "$k" "$c"
    # Anciens gardés ; la clé publique de l'ancienne clé (lue par le lien dur, jamais par un lien symbolique) sert à
    # retrouver ses copies HAProxy.
    ANCIENNE_PUB_TLS=""
    if [ -f "$TLS_DIR/key.pem" ] || [ -L "$TLS_DIR/key.pem" ]; then
        de_cote "$TLS_DIR/key.pem"
        if [ -f "$DE_COTE" ] && [ ! -L "$DE_COTE" ]; then
            ANCIENNE_PUB_TLS="$(openssl pkey -in "$DE_COTE" -pubout 2>/dev/null || true)"
        fi
    fi
    if [ -f "$TLS_DIR/cert.pem" ] || [ -L "$TLS_DIR/cert.pem" ]; then de_cote "$TLS_DIR/cert.pem"; fi
    # Deux renommages depuis le même dossier (mv -T : un lien ou un dossier à la place n'est jamais suivi) ; si le second
    # est refusé, le premier est défait.
    if [ -L "$TLS_DIR" ] || ! mv -fT -- "$k" "$TLS_DIR/key.pem"; then
        retour_arriere || err "remise TLS incomplète"
        echec tls "clé non posée : anciens clé et certificat en place"; return 0
    fi
    if ! mv -fT -- "$c" "$TLS_DIR/cert.pem"; then
        retour_arriere || err "remise TLS incomplète"
        echec tls "certificat non posé : ancienne clé remise"; return 0
    fi
    EN_ATTENTE=()
    TLS_NEUF=1 NGINX_A_RECHARGER=1
    audit secret_renouvele secret tls
    log "TLS du frontal local : clé et certificat neufs"
}

# Dossiers et fichiers nommés par `crt` dans la configuration d'HAProxy (haproxy.cfg, *.cfg voisins, conf.d, cfg.d).
crt_haproxy() {
    local d f
    d="$(dirname "$HAPROXY_CFG")"
    for f in "$HAPROXY_CFG" "$d"/*.cfg "$d"/conf.d/*.cfg "$d"/cfg.d/*.cfg; do
        [ -f "$f" ] || continue
        awk '/^[[:space:]]*#/ { next } { for (i = 1; i < NF; i++) if ($i == "crt") print $(i + 1) }' "$f"
    done | sort -u
}

# haproxyctl frontal copie la clé TLS dans $CERTS_DIR/000-defaut.pem (gk3 : /srv/haproxy/certs) : sans ce remplacement,
# HAProxy servait encore l'ancienne. Tout .pem d'un dossier crt dont la clé est l'ancienne prend cert + clé neufs (mêmes
# droits) ; haproxy -c puis reload, sinon l'ancien est remis et c'est dit.
renouvelle_haproxy() {
    local p cible f d t s n=0
    local -a pems=() noms=()
    if [ "$TLS_NEUF" -ne 1 ] || [ -z "$ANCIENNE_PUB_TLS" ] || [ ! -f "$HAPROXY_CFG" ]; then return 0; fi
    while IFS= read -r p; do
        case "$p" in /*) ;; *) continue ;; esac            # chemin absolu (crt-base n'est pas suivi)
        case "$p" in *..*) continue ;; esac
        cible="$R${p%/}"
        if [ -d "$cible" ] && [ ! -L "$cible" ]; then pems+=("$cible"/*.pem); else pems+=("$cible"); fi
    done < <(crt_haproxy)
    for f in "${pems[@]}"; do
        { [ -f "$f" ] && [ ! -L "$f" ]; } || continue
        [ "$(openssl pkey -in "$f" -pubout 2>/dev/null || true)" = "$ANCIENNE_PUB_TLS" ] || continue
        d="$(dirname "$f")"
        if [ "$(stat -c %u -- "$d")" != "$(id -u)" ] || [ -n "$(find "$d" -maxdepth 0 -perm /022)" ]; then
            echec haproxy-defaut "${f#"$R"} porte l'ancienne clé TLS, mais son dossier n'est pas à root seul : non remplacé"
            continue
        fi
        cp -p -- "$f" "$TRAVAIL/haproxy.$n.pem"
        HAPROXY_EN_ATTENTE+=("$TRAVAIL/haproxy.$n.pem|$f"); n=$((n + 1))
        t="$(mktemp "$d/.renouvelle.XXXXXX")"
        TEMPO="$t"
        if ! { cat "$TRAVAIL/tls/haproxy.pem" > "$t" && chmod --reference="$f" -- "$t" \
                && chown --reference="$f" -- "$t" && mv -fT -- "$t" "$f"; }; then
            rm -f -- "$t"; TEMPO=""
            remet_haproxy || err "remise HAProxy incomplète"
            echec haproxy-defaut "${f#"$R"} non remplacé : anciens certificats HAProxy remis, l'ancienne clé reste servie"
            return 0
        fi
        TEMPO=""
        noms+=("${f#"$R"}")
    done
    [ "${#noms[@]}" -gt 0 ] || return 0
    if command -v "$HAPROXY" >/dev/null && ! s="$("$HAPROXY" -c -q -f "$HAPROXY_CFG" 2>&1)"; then
        remet_haproxy || err "remise HAProxy incomplète"
        echec haproxy-defaut "haproxy -c refuse ($(derniere_ligne <<< "$s")) : ancien certificat remis, l'ancienne clé reste servie par HAProxy"
        return 0
    fi
    if "$SYSTEMCTL" is-active -q haproxy && ! "$SYSTEMCTL" reload haproxy; then
        remet_haproxy || err "remise HAProxy incomplète"
        echec haproxy-defaut "rechargement d'HAProxy refusé : ancien certificat remis"; return 0
    fi
    HAPROXY_EN_ATTENTE=()
    audit secret_renouvele secret haproxy-defaut
    log "HAProxy : copie de l'ancienne clé TLS remplacée (${noms[*]})"
}

renouvelle_oidc() {
    local s=""
    if [ "$MODE" != tout ] && [ -f "$OIDC" ]; then return 0; fi
    if [ ! -x "$OIDCCTL" ]; then             # vérifié AVANT de toucher la clé
        if [ -f "$OIDC" ]; then echec oidc "secubox-oidcctl absent : clé de signature conservée, non renouvelée"; fi
        return 0
    fi
    if [ -f "$OIDC" ] || [ -L "$OIDC" ]; then de_cote "$OIDC"; rm -f -- "$OIDC"; fi
    if ! s="$("$OIDCCTL" init 2>&1)" || [ ! -s "$OIDC" ]; then
        retour_arriere || err "remise OIDC incomplète"
        echec oidc "secubox-oidcctl init a échoué ($(derniere_ligne <<< "$s")) : ancienne clé remise"; return 0
    fi
    EN_ATTENTE=()
    audit secret_renouvele secret oidc
    log "OIDC : clé de signature neuve (les jetons émis avant ne valent plus)"
}

cle_wg_coherente() { # 0 : pas d'interface wg-ephemeral, ou elle porte la clé du fichier
    local noyau fichier
    noyau="$("$WG" show wg-ephemeral public-key 2>/dev/null)" || return 0
    [ -f "$P2P_DIR/wg-ephemeral.key" ] || return 1
    fichier="$("$WG" pubkey < "$P2P_DIR/wg-ephemeral.key" 2>/dev/null)" || return 1
    [ -n "$noyau" ] && [ "$noyau" = "$fichier" ]
}

p2p_retour() { # MOTIF JOURNAL — anciens jeton, clé et conf nginx remis ; nginx relu à la fin
    local suite=""
    retour_arriere || err "remise p2p incomplète"
    NGINX_A_RECHARGER=1
    cle_wg_coherente || suite=" ; wg-ephemeral porte une autre clé que le fichier : secubox-p2pctl iface-up"
    echec p2p "$1 : anciens jeton et clé remis$suite (journal : ${2#"$R"})"
}

renouvelle_p2p() {
    local tok="$P2P_DIR/pair.token" cle="$P2P_DIR/wg-ephemeral.key" v journal a_tok="" a_cle="" f
    if [ "$MODE" != tout ] && [ -f "$tok" ] && [ -f "$cle" ]; then return 0; fi
    # shellcheck disable=SC2016  # ${Version} est le format de dpkg-query, pas une variable du shell
    v="$("$DPKG_QUERY" -W -f='${Version}' secubox-p2p 2>/dev/null || true)"
    if [ ! -x "$P2P_POSTINST" ] || [[ ! "$v" =~ ^[0-9A-Za-z.+~:-]+$ ]]; then
        if [ "$MODE" = tout ] && { [ -f "$tok" ] || [ -f "$cle" ]; }; then
            echec p2p "secubox-p2p non installé : jeton et clé conservés, non renouvelés"
        fi
        return 0
    fi
    if dpkg_occupe; then echec p2p "apt ou dpkg en cours : postinst non relancé, jeton et clé inchangés"; return 0; fi
    if [ "$MODE" = tout ]; then
        if [ -f "$tok" ] || [ -L "$tok" ]; then de_cote "$tok"; a_tok="$DE_COTE"; rm -f -- "$tok"; fi
        if [ -f "$cle" ] || [ -L "$cle" ]; then de_cote "$cle"; a_cle="$DE_COTE"; rm -f -- "$cle"; fi
    fi
    # Le postinst réécrit la conf nginx qui interpole le jeton : copiée aussi, pour rester cohérente en cas d'échec.
    if [ -f "$P2P_NGX" ] || [ -L "$P2P_NGX" ]; then copie_de_cote "$P2P_NGX"; fi
    journal="$JOURNAUX/renouvelle-secrets.log"
    [ -d "$JOURNAUX" ] || journal="$TRAVAIL/p2p-postinst.log"
    : >> "$journal"; chmod 0600 "$journal"
    printf '== %s postinst secubox-p2p configure %s (secubox-renouvelle-secrets --%s)\n' \
        "$(date -u -Iseconds)" "$v" "$MODE" >> "$journal"
    # Relancé à chaud hors de dpkg, sous umask 022 comme dpkg (sinon p2p-macro-mesh.conf naît 0600). Il redémarre les
    # unités p2p et recharge nginx ; sa sortie (avertissements de locale de perl…) va au journal, root 0600.
    if ! ( umask 022; DPKG_MAINTSCRIPT_PACKAGE=secubox-p2p DPKG_MAINTSCRIPT_NAME=postinst \
            "$P2P_POSTINST" configure "$v" ) >> "$journal" 2>&1 < /dev/null; then
        p2p_retour "postinst de secubox-p2p en échec ($(derniere_ligne < "$journal"))" "$journal"; return 0
    fi
    # Contrôles avant l'audit : fichiers présents, non vides, neufs ; l'interface porte la clé neuve.
    for f in "$tok" "$cle"; do
        if [ ! -f "$f" ] || [ -L "$f" ] || [ ! -s "$f" ]; then
            p2p_retour "${f##*/} absent ou vide après le postinst" "$journal"; return 0
        fi
    done
    if { [ -n "$a_tok" ] && cmp -s -- "$a_tok" "$tok"; } || { [ -n "$a_cle" ] && cmp -s -- "$a_cle" "$cle"; }; then
        p2p_retour "le postinst a laissé l'ancien jeton ou l'ancienne clé" "$journal"; return 0
    fi
    if ! cle_wg_coherente; then
        p2p_retour "wg-ephemeral garde une autre clé que le fichier neuf" "$journal"; return 0
    fi
    EN_ATTENTE=()
    audit secret_renouvele secret p2p
    log "p2p : jeton d'appairage et clé WireGuard éphémère neufs (postinst relancé : unités p2p redémarrées)"
}

renouvelle_machine_id() {
    local id mode=444 t="$TRAVAIL/machine-id"
    id="$(systemd-id128 new 2>/dev/null || true)"
    if [[ ! "$id" =~ ^[0-9a-f]{32}$ ]]; then echec machine-id "systemd-id128 new sans identifiant : inchangé"; return 0; fi
    # D'abord le fichier de dbus : un fichier ordinaire valide serait recopié par systemd-machine-id-setup (gk5).
    if [ -d "$(dirname "$MID_DBUS")" ] && [ ! -L "$MID_DBUS" ]; then
        rm -f -- "$MID_DBUS"; ln -s /etc/machine-id "$MID_DBUS"
    fi
    if [ -f "$MID" ]; then mode="$(stat -c %a -- "$MID")"; fi
    printf '%s\n' "$id" > "$t"
    chmod "$mode" "$t"
    # Remplacé par renommage : /etc/machine-id n'est jamais absent ni vide.
    if ! mv -fT -- "$t" "$MID"; then echec machine-id "${MID#"$R"} non remplaçable (montage ?) : inchangé"; return 0; fi
    audit secret_renouvele secret machine-id
    log "machine-id neuf : redémarrer la box (journal, DUID DHCP ; l'adresse LAN peut changer)"
}

recharge_nginx() {
    local s
    [ "$NGINX_A_RECHARGER" -eq 1 ] || return 0
    "$SYSTEMCTL" is-active -q nginx || return 0
    if ! s="$("$NGINX" -t 2>&1)"; then
        echec nginx "nginx -t refuse la configuration ($(derniere_ligne <<< "$s")) : non rechargé, nginx sert l'ancien certificat jusqu'à son redémarrage"
    elif ! "$SYSTEMCTL" reload nginx; then
        echec nginx "rechargement de nginx refusé : l'ancien certificat reste servi"
    fi
}

if [ "$MODE" = constat ]; then constat; exit 0; fi

# Refus AVANT tout changement.
if [ "$MODE" = tout ]; then
    command -v ssh-keygen >/dev/null || { err "ssh-keygen absent (paquet openssh-client) : rien n'a été renouvelé"; exit 1; }
    if [ "$AVEC_MID" -eq 1 ] && ! command -v systemd-id128 >/dev/null; then
        err "systemd-id128 absent : rien n'a été renouvelé"; exit 1
    fi
    if [ -x "$P2P_POSTINST" ] && dpkg_occupe; then err "apt ou dpkg en cours : rien n'a été renouvelé, relancer après"; exit 1; fi
fi

trap fin EXIT
trap 'err "interrompu"; exit 130' INT TERM
trap 'err "erreur inattendue ligne $LINENO (code $?) : arrêt"' ERR
trap '' HUP PIPE            # une session SSH coupée n'interrompt pas un échange en cours (systemd-run ignore déjà PIPE)
TRAVAIL="$(mktemp -d "$R/etc/.secubox-renouvelle.XXXXXX")"

MACHINE="$(machine_de_la_cle)"          # lue AVANT de remplacer la clé
[ "$MODE" != tout ] || desactive_comptes "$MACHINE"
renouvelle_ssh
renouvelle_tls
renouvelle_haproxy
renouvelle_oidc
renouvelle_p2p
[ "$AVEC_MID" -eq 0 ] || renouvelle_machine_id
recharge_nginx
[ "$AUDIT_OK" -eq 1 ] || ECHECS+=(audit)
if [ "$MODE" = tout ] && [ "$SSH_NEUF" -eq 1 ]; then
    log "sur les postes clients : ssh-keygen -R <adresse de la box>, puis accepter la nouvelle empreinte"
fi
if [ "${#ECHECS[@]}" -gt 0 ]; then
    err "NON renouvelé : $(printf '%s\n' "${ECHECS[@]}" | sort -u | paste -sd' ') (détail ci-dessus ; l'ancien reste en place)"
    exit 1
fi
[ "$MODE" != tout ] || log "terminé"
