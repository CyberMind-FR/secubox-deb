#!/usr/bin/env bash
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
# Source-Disclosed License — All rights reserved except as expressly granted.
# See LICENCE-CMSD-1.0.md for terms.
#
# SecuBox-Deb :: secubox-renouvelle-secrets — les secrets d'une box sont générés SUR la box (#3243)
#
# POURQUOI. Les images construites en CI embarquaient des secrets générés dans le chroot : clés d'hôte SSH (commentaire
# root@runnervm…), clé de signature OIDC, clé TLS du frontal, clé WireGuard du p2p éphémère, jeton d'appairage,
# machine-id, et un compte admin au nom du runner. Leurs générateurs étant du type « crée si absent », le premier
# démarrage les gardait : toutes les box d'une image partageaient ces secrets, téléchargeables avec l'image publique.
#
#   secubox-renouvelle-secrets                     constat : chaque secret, sa date, l'origine de la clé d'hôte (rien ne change)
#   secubox-renouvelle-secrets --absents           crée ceux qui manquent (premier démarrage d'une image nettoyée)
#   secubox-renouvelle-secrets --tout --oui        les régénère TOUS (box installée depuis une image publiée)
#                              [--machine-id]      … et l'identifiant de machine (redémarrage conseillé, bail DHCP neuf possible)
#
# Chaque secret passe par le générateur de son paquet : ssh-keygen -A, secubox-oidcctl init, postinst de secubox-p2p
# (le jeton est interpolé dans nginx), openssl comme le faisait build-image.sh. L'audit nomme les secrets renouvelés,
# jamais leur valeur. Les sessions SSH ouvertes restent ; les clients oublient l'ancienne empreinte (ssh-keygen -R <box>).
#
# Variables de substitution (tests) : SBX_RACINE, SBX_HOSTNAME, SBX_SYSTEMCTL, SBX_NGINX, SBX_OIDCCTL, SBX_USERSCTL,
# SBX_P2P_POSTINST, SBX_DPKG_QUERY, SBX_MACHINE_ID_SETUP.
set -euo pipefail
umask 077

R="${SBX_RACINE:-}"
SYSTEMCTL="${SBX_SYSTEMCTL:-systemctl}"
NGINX="${SBX_NGINX:-nginx}"
OIDCCTL="${SBX_OIDCCTL:-/usr/sbin/secubox-oidcctl}"
USERSCTL="${SBX_USERSCTL:-/usr/sbin/usersctl}"
P2P_POSTINST="${SBX_P2P_POSTINST:-/var/lib/dpkg/info/secubox-p2p.postinst}"
DPKG_QUERY="${SBX_DPKG_QUERY:-dpkg-query}"
MID_SETUP="${SBX_MACHINE_ID_SETUP:-systemd-machine-id-setup}"

SSH_DIR="$R/etc/ssh"
OIDC="$R/etc/secubox/secrets/oidc/signing.pem"
P2P_DIR="$R/etc/secubox/secrets/p2p"
TLS_DIR="$R/etc/secubox/tls"
USERS="$R/etc/secubox/users.json"
MID="$R/etc/machine-id"
MID_DBUS="$R/var/lib/dbus/machine-id"
AUDIT="$R/var/log/secubox/audit.log"

MODE=constat OUI=0 AVEC_MID=0
while [ $# -gt 0 ]; do case "$1" in
    --absents) MODE=absents; shift ;;
    --tout) MODE=tout; shift ;;
    --oui) OUI=1; shift ;;
    --machine-id) AVEC_MID=1; shift ;;
    -h|--help) sed -n '7,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "argument inconnu : $1" >&2; exit 2 ;;
esac; done
if [ -z "$R" ] && [ "$(id -u)" -ne 0 ]; then echo "à lancer en root" >&2; exit 2; fi
if [ "$MODE" = tout ] && [ "$OUI" -ne 1 ]; then
    echo "--tout régénère clés d'hôte SSH, OIDC, TLS et p2p (jetons OIDC en cours invalidés, empreinte SSH changée) : ajouter --oui" >&2
    exit 2
fi
if [ "$AVEC_MID" -eq 1 ] && [ "$MODE" != tout ]; then echo "--machine-id va avec --tout" >&2; exit 2; fi

HOTE="${SBX_HOSTNAME:-$(hostname)}"
[[ "$HOTE" =~ ^[a-z0-9][a-z0-9.-]{0,62}$ ]] || HOTE=secubox

log() { echo "[secrets] $*"; }
date_de() { [ -e "$1" ] && date -r "$1" '+%Y-%m-%d %H:%M' || echo "absent"; }
audit() { # EVENEMENT CLE VALEUR — identifiants seulement, jamais une valeur secrète
    mkdir -p "$(dirname "$AUDIT")"
    printf '{"ts": "%s", "module": "core", "evenement": "%s", "%s": "%s", "mode": "%s"}\n' \
        "$(date -Iseconds)" "$1" "$2" "$3" "$MODE" >> "$AUDIT"
}

# Machine qui a généré la clé d'hôte, d'après son commentaire (root@<machine>) ; vide si absent.
machine_de_la_cle() {
    local c
    c="$(awk '{print $3}' "$SSH_DIR/ssh_host_ed25519_key.pub" 2>/dev/null || true)"
    case "$c" in *@*) printf '%s' "${c#*@}" ;; esac
}

# Comptes sans mot de passe au nom d'une machine de construction : celle de la clé d'hôte, ou un runner de CI.
comptes_de_construction() { # MACHINE
    [ -f "$USERS" ] || return 0
    python3 -I - "$USERS" "$1" "$HOTE" <<'PY'
import json, re, sys
chemin, machine, hote = sys.argv[1:4]
try:
    users = json.load(open(chemin)).get("users", [])
except (OSError, ValueError):
    sys.exit(0)
for u in users:
    n = u.get("username") or ""
    if not re.fullmatch(r"[a-z0-9][a-z0-9_.-]{0,63}", n) or u.get("password_hash"):
        continue
    if (machine and n == machine and n != hote) or re.fullmatch(r"runnervm[a-z0-9]+", n):
        print(n)
PY
}

constat() {
    local m
    m="$(machine_de_la_cle)"
    printf '%-11s %-17s %s\n' ssh-hote "$(date_de "$SSH_DIR/ssh_host_ed25519_key")" \
        "$(ssh-keygen -lf "$SSH_DIR/ssh_host_ed25519_key.pub" 2>/dev/null | awk '{print $2, $3}')"
    if [ -n "$m" ] && [ "$m" != "$HOTE" ]; then
        log "  la clé d'hôte porte « root@$m », pas « $HOTE » : générée ailleurs (image) ou avant un renommage"
    fi
    case "$m" in runnervm*) log "  « $m » est une machine de CI : clé d'hôte d'une image publiée, à renouveler (--tout --oui)" ;; esac
    printf '%-11s %-17s\n' tls "$(date_de "$TLS_DIR/key.pem")"
    printf '%-11s %-17s\n' oidc "$(date_de "$OIDC")"
    printf '%-11s %-17s jeton %s\n' p2p "$(date_de "$P2P_DIR/wg-ephemeral.key")" "$(date_de "$P2P_DIR/pair.token")"
    printf '%-11s %-17s\n' machine-id "$(date_de "$MID")"
    local c
    c="$(comptes_de_construction "$m" | paste -sd' ')"
    [ -z "$c" ] || log "comptes admin au nom d'une machine de construction, sans mot de passe : $c"
}

renouvelle_ssh() {
    local t cree=0
    if [ "$MODE" = tout ]; then
        for t in rsa ecdsa ed25519 dsa; do rm -f "$SSH_DIR/ssh_host_${t}_key" "$SSH_DIR/ssh_host_${t}_key.pub"; done
    fi
    [ -f "$SSH_DIR/ssh_host_ed25519_key" ] || cree=1
    [ "$MODE" = tout ] || [ "$cree" -eq 1 ] || return 0
    mkdir -p "$SSH_DIR"
    if [ -n "$R" ]; then ssh-keygen -A -f "$R" >/dev/null; else ssh-keygen -A >/dev/null; fi
    audit secret_renouvele secret ssh-hote
    # Un sshd en marche relit ses clés d'hôte au rechargement ; arrêté faute de clés (premier démarrage), on le démarre
    # seulement s'il est activé : un SSH volontairement coupé le reste.
    if "$SYSTEMCTL" is-active -q ssh; then "$SYSTEMCTL" reload ssh || true
    elif "$SYSTEMCTL" is-enabled -q ssh; then "$SYSTEMCTL" start ssh || true; fi
    log "clés d'hôte SSH : $(ssh-keygen -lf "$SSH_DIR/ssh_host_ed25519_key.pub" | awk '{print $2}')"
}

renouvelle_tls() {
    if [ "$MODE" != tout ] && [ -f "$TLS_DIR/key.pem" ] && [ -f "$TLS_DIR/cert.pem" ]; then return 1; fi
    mkdir -p "$TLS_DIR"
    chmod 0755 "$TLS_DIR"
    local k c
    k="$(mktemp "$TLS_DIR/.key.XXXXXX")"; c="$(mktemp "$TLS_DIR/.cert.XXXXXX")"
    # Mêmes paramètres que l'étape 9 de secubox-firstboot (qui ne génère que si le certificat manque), plus localhost.
    if ! openssl req -x509 -newkey rsa:4096 -days 3650 -nodes -keyout "$k" -out "$c" \
            -subj "/CN=${HOTE}/O=CyberMind SecuBox/C=FR" \
            -addext "subjectAltName=DNS:${HOTE},DNS:secubox.local,DNS:localhost,IP:192.168.10.1,IP:127.0.0.1" 2>/dev/null; then
        rm -f "$k" "$c"; echo "TLS : openssl a échoué" >&2; return 2
    fi
    chmod 0640 "$k"; chmod 0644 "$c"
    if [ -z "$R" ] && getent passwd secubox >/dev/null; then chown secubox:secubox "$k" "$c"; fi
    mv -f "$k" "$TLS_DIR/key.pem" && mv -f "$c" "$TLS_DIR/cert.pem" || { echo "TLS : mise en place impossible" >&2; return 2; }
    audit secret_renouvele secret tls
    log "TLS du frontal local : clé et certificat neufs"
}

renouvelle_oidc() {
    [ "$MODE" != tout ] || rm -f "$OIDC"
    [ ! -f "$OIDC" ] || return 0
    if [ -x "$OIDCCTL" ]; then
        "$OIDCCTL" init >/dev/null
        audit secret_renouvele secret oidc
        log "OIDC : clé de signature neuve (les jetons émis avant ne valent plus)"
    fi
}

renouvelle_p2p() {
    [ "$MODE" != tout ] || rm -f "$P2P_DIR/pair.token" "$P2P_DIR/wg-ephemeral.key"
    [ ! -f "$P2P_DIR/pair.token" ] || [ ! -f "$P2P_DIR/wg-ephemeral.key" ] || return 0
    [ -x "$P2P_POSTINST" ] || return 0
    local v
    # shellcheck disable=SC2016  # ${Version} est le format de dpkg-query, pas une variable du shell
    v="$("$DPKG_QUERY" -W -f='${Version}' secubox-p2p 2>/dev/null || true)"
    [ -n "$v" ] || return 0
    # Le postinst de secubox-p2p crée jeton et clé s'ils manquent, et repose la conf nginx qui interpole le jeton.
    DPKG_MAINTSCRIPT_PACKAGE=secubox-p2p DPKG_MAINTSCRIPT_NAME=postinst "$P2P_POSTINST" configure "$v" >/dev/null
    audit secret_renouvele secret p2p
    log "p2p : jeton d'appairage et clé WireGuard éphémère neufs"
}

desactive_comptes() { # MACHINE
    local n
    for n in $(comptes_de_construction "$1"); do
        "$USERSCTL" disable "$n" >/dev/null
        audit compte_desactive compte "$n"
        log "compte admin « $n » (machine de construction, sans mot de passe) désactivé"
    done
}

renouvelle_machine_id() {
    rm -f "$MID"
    if [ -n "$R" ]; then "$MID_SETUP" --root="$R" >/dev/null; else "$MID_SETUP" >/dev/null; fi
    if [ -d "$(dirname "$MID_DBUS")" ] && [ ! -L "$MID_DBUS" ]; then
        rm -f "$MID_DBUS"; ln -s /etc/machine-id "$MID_DBUS"
    fi
    audit secret_renouvele secret machine-id
    log "machine-id neuf : redémarrer la box (journal, DUID DHCP ; l'adresse LAN peut changer)"
}

if [ "$MODE" = constat ]; then constat; exit 0; fi

MACHINE="$(machine_de_la_cle)"          # lue AVANT de remplacer la clé
renouvelle_ssh
tls_neuf=0
if renouvelle_tls; then tls_neuf=1; else rc=$?; [ "$rc" -eq 1 ] || exit 1; fi   # 1 : présent, rien à faire
renouvelle_oidc
renouvelle_p2p
[ "$MODE" != tout ] || desactive_comptes "$MACHINE"
[ "$AVEC_MID" -eq 0 ] || renouvelle_machine_id
if [ "$tls_neuf" -eq 1 ] && "$SYSTEMCTL" is-active -q nginx && "$NGINX" -t >/dev/null 2>&1; then
    "$SYSTEMCTL" reload nginx || true
fi
[ "$MODE" != tout ] || log "terminé ; sur les postes clients : ssh-keygen -R <adresse de la box>, puis accepter la nouvelle empreinte"
