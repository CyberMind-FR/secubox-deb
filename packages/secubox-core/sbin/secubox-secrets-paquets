# SecuBox-Deb :: secubox-secrets-paquets — au premier démarrage, chaque paquet recrée ses secrets (#3558).
# L'image n'en porte plus aucun (image/lib/purger-secrets.sh) ; les postinst savent déjà créer ce qui manque.
# Tout paquet qui gère un secret est pris en compte sans liste à tenir. Ce service tourne AVANT les unités :
# un vrai `systemctl restart` attendrait un job ordonné après nous, d'où les substituts qui ne font rien.
set -u
readonly INFO="${SBX_DPKG_INFO:-/var/lib/dpkg/info}"
readonly JOURNAL="${SBX_JOURNAL:-/var/log/secubox-secrets-paquets.log}"
readonly MOTIF='/etc/secubox/(secrets|credstore|toolbox/(ca|mitm))'

faux="$(mktemp -d)"
trap 'rm -rf -- "$faux"' EXIT
for c in systemctl deb-systemd-invoke deb-systemd-helper invoke-rc.d service apparmor_parser nginx; do
    printf '#!/bin/sh\nexit 0\n' > "$faux/$c"
    chmod 0755 "$faux/$c"
done
umask 022
install -m 0600 /dev/null "$JOURNAL"
echecs=0
for f in "$INFO"/secubox-*.postinst "$INFO/ssl-cert.postinst"; do
    [[ -f "$f" ]] || continue
    case "$f" in */ssl-cert.postinst) ;; *) grep -qE "$MOTIF" "$f" || continue ;; esac
    p="$(basename "$f" .postinst)"
    v="$(dpkg-query -W -f='${Version}' "$p" 2>/dev/null)" || continue
    echo "== $p $v" >> "$JOURNAL"
    if ! PATH="$faux:$PATH" DPKG_MAINTSCRIPT_PACKAGE="$p" DPKG_MAINTSCRIPT_NAME=postinst \
            "$f" configure "$v" >> "$JOURNAL" 2>&1 < /dev/null; then
        echo "secrets : postinst de $p en échec (journal : $JOURNAL)" >&2
        echecs=$((echecs + 1))
    fi
done
echo "secrets : paquets repassés, $echecs échec(s)"
exit 0
