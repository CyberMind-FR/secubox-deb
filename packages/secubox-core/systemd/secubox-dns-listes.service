# Listes DNS compilées par étiquettes (#3205) : webfilter, adblock et adult déposent leur source dans
# /var/lib/secubox/dns-listes/sources ; ce service compile, pose /etc/unbound/unbound.conf.d/92-secubox-listes.conf,
# retire les anciens fichiers et recharge Unbound en une transaction (retour arrière complet au moindre échec).
# Root : il écrit /etc/unbound et lance unbound-control. Confiné par le profil AppArmor « /usr/sbin/secubox-dns-listes ».
# Exception au compte dédié (RULES-CODE § 10) : voir le profil et .claude/RULES-CODE.md.
[Unit]
Description=SecuBox — compilation des listes DNS d'Unbound (#3205)
After=unbound.service
ConditionPathIsDirectory=/etc/unbound/unbound.conf.d
# Déclenché par fichier : des écritures en rafale dans unbound.conf.d (passes sautées en une fraction de seconde) ne doivent
# pas atteindre la limite de démarrages, qui désactiverait le .path.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-dns-listes appliquer
Nice=10
IOSchedulingClass=idle
# Pire cas : 3 passes × (compilation ~2,5 min + unbound-checkconf ≤ 10 min + rechargement ≤ 2 min + attente ≤ 5 min).
TimeoutStartSec=90min
# Pic mesuré : 487 Mo pour la configuration de gk2 (1,9 million de zones lues), PLUS unbound-checkconf dans le même cgroup.
MemoryMax=2G
UMask=0027
# Aucune capacité : il écrit des fichiers root et parle à /run/unbound.ctl (root:unbound 0660). Réseau : boucle locale
# seulement (unbound-control en TCP sur les box qui n'ont pas de socket Unix).
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/etc/unbound/unbound.conf.d /var/lib/secubox-dns-listes -/var/log/secubox/audit.log
