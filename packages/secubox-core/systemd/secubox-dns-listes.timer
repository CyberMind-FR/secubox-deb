# Rattrapage quotidien (#3205) : adopte un ancien fichier réapparu dans unbound.conf.d ; sans changement, rien n'est
# rechargé.
[Unit]
Description=SecuBox — rattrapage quotidien des listes DNS (#3205)

[Timer]
OnBootSec=10min
OnCalendar=daily
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
