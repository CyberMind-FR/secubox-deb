# Toutes les heures, sur l'horloge (OnCalendar) : jamais relatif à la dernière exécution, une passe en échec ne peut
# pas arrêter la minuterie (#3692).
[Unit]
Description=SecuBox — masquer les jetons des journaux nginx, toutes les heures (#3691)

[Timer]
OnCalendar=hourly
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
