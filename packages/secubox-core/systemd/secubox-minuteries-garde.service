# Une minuterie SecuBox activée ne reste jamais arrêtée (#3692) : relance et audit. Root : systemctl start/reset-failed.
[Unit]
Description=SecuBox — relancer les minuteries activées restées arrêtées (#3692)

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-minuteries-garde
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/secubox
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
