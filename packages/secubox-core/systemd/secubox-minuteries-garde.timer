# Toutes les 10 min, sur l'horloge : une passe en échec n'arrête pas la minuterie elle-même (#3692).
[Unit]
Description=SecuBox — garde des minuteries, toutes les 10 min (#3692)

[Timer]
OnCalendar=*:0/10
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
