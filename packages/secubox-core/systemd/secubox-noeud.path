[Unit]
Description=SecuBox : demandes de l API sur le relais du nom de noeud (#3824, #3883)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3824

[Path]
# L API system (secubox, NoNewPrivileges) depose <id>.demande ici ; cette unite root la traite.
DirectoryNotEmpty=/run/secubox/noeud
Unit=secubox-noeud.service

[Install]
WantedBy=paths.target
