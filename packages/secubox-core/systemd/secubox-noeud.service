[Unit]
Description=SecuBox : relais du nom de noeud, ouvert ou ferme par l administrateur (#3824, #3883)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3824
StartLimitIntervalSec=60
StartLimitBurst=30

[Service]
Type=oneshot
# Depot (root:secubox 1770) et resultats (root:secubox 0750) crees en root sous /run/secubox (1777), jamais par
# tmpfiles (#3172) : `+` = hors du bac a sable, pour ce seul verbe (lien retire, jamais suivi). Lance aussi au
# demarrage (WantedBy) pour que le depot existe apres un redemarrage.
ExecStartPre=+/usr/sbin/secubox-noeud prepare
ExecStart=/usr/sbin/secubox-noeud traite
# nginx -t par PID 1 (systemd-run), comme le pilotage : dans ce bac a sable, sans IP, il echouerait.
Environment=SBX_NOEUD_UNITE=1
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# audit.log (secubox 0640), users.json lu par la garde du mot de passe par defaut, resultats chownes root:secubox.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
# /etc/secubox/noeud (dossier root) : noeud.toml reecrit par renommage atomique dans ce dossier, par descripteur (#3883).
# Exception ecrite : RULES-CODE § Exceptions (#3824).
ReadWritePaths=-/etc/secubox/noeud /etc/nginx/conf.d /var/log/secubox -/run/secubox/noeud -/run/secubox/noeud-resultats

[Install]
WantedBy=multi-user.target
