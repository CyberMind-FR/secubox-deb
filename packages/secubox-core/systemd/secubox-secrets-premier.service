# Secrets propres à CETTE box, créés au premier démarrage d'une image qui n'en contient aucun (#3518).
[Unit]
Description=SecuBox : secrets de cette box au premier démarrage
DefaultDependencies=no
After=local-fs.target systemd-machine-id-commit.service
Before=ssh.service sshd.service nginx.service haproxy.service secubox-firstboot.service multi-user.target
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=-/usr/sbin/secubox-renouvelle-secrets --absents
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
