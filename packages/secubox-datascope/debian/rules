#!/usr/bin/make -f
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
# SecuBox-Deb :: datascope — SBXOS DataScope V0.1 (#3853).
P = $(CURDIR)/debian/secubox-datascope

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_installsystemd:

override_dh_auto_install:
	install -d $(P)/usr/lib/secubox/datascope/api
	install -m 644 api/*.py $(P)/usr/lib/secubox/datascope/api/
	# Tout l'arbre du paquet Python (sous-paquet connecteurs/ compris), sans __pycache__.
	cd secubox_datascope && find . -name __pycache__ -prune -o -type f -name '*.py' -print | while read -r f; do \
	  install -D -m 644 "$$f" "$(P)/usr/lib/secubox/datascope/secubox_datascope/$$f" || exit 1; \
	done
	# Migrations de schéma (tâche 2) : installées seulement si présentes.
	if [ -d migrations ]; then \
	  install -d $(P)/usr/lib/secubox/datascope/migrations; \
	  install -m 644 migrations/* $(P)/usr/lib/secubox/datascope/migrations/; \
	fi
	install -d $(P)/usr/share/secubox/datascope
	install -m 644 conf/datascope.toml $(P)/usr/share/secubox/datascope/datascope.toml.example
	install -m 644 conf/modules.d/datascope.toml $(P)/usr/share/secubox/datascope/modules.d-datascope.toml
	install -d $(P)/usr/lib/systemd/system
	install -m 644 debian/secubox-datascope.service debian/secubox-datascope-collect.service \
	  debian/secubox-datascope-collect.timer $(P)/usr/lib/systemd/system/
	# Page : installée si présente (créée à la tâche 6, un espace réservé tient lieu d'ici là).
	if [ -f www/datascope/index.html ]; then \
	  install -d $(P)/usr/share/secubox/www/datascope/; \
	  cp -r www/datascope/. $(P)/usr/share/secubox/www/datascope/; \
	fi
	install -d $(P)/usr/share/secubox/menu.d
	cp -r menu.d/. $(P)/usr/share/secubox/menu.d/
	install -d $(P)/etc/apparmor.d
	install -m 644 apparmor/secubox-datascope $(P)/etc/apparmor.d/secubox-datascope
	install -d $(P)/etc/nginx/secubox.d $(P)/etc/nginx/secubox-routes.d
	install -m 644 nginx/datascope.conf $(P)/etc/nginx/secubox.d/
	install -m 644 nginx/datascope.conf $(P)/etc/nginx/secubox-routes.d/
