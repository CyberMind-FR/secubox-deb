#!/bin/sh
# secubox-defaults postinst: autodetect SECUBOX_HOSTNAME if empty,
# then activate the secubox-defaults-changed trigger so consumers refresh.
set -e

DEFAULTS=/etc/default/secubox

case "$1" in
    configure)
        if [ ! -f "$DEFAULTS" ]; then
            echo "secubox-defaults: $DEFAULTS missing — package files not installed?" >&2
            exit 1
        fi

        # Source the existing values
        # shellcheck disable=SC1090
        . "$DEFAULTS" 2>/dev/null || true

        # LE NOM DE LA BOX VIENT DE secubox-domaine (#1841), source canonique
        # (#1723). Le fichier était livré avec "gk2" : l'autodétection, qui ne
        # jouait que sur une valeur vide, ne jouait jamais — gk3 se croyait
        # gk2. On aligne donc aussi une valeur EXISTANTE quand elle diffère du
        # domaine de la box ; gk2 reste gk2.
        DOMAINE=""
        if command -v secubox-domaine >/dev/null 2>&1; then
            DOMAINE=$(secubox-domaine 2>/dev/null || true)
        fi
        if printf '%s' "$DOMAINE" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'; then
            HOTE=${DOMAINE%%.*}
            SUFFIXE=${DOMAINE#*.}
            if [ "${SECUBOX_HOSTNAME:-}" != "$HOTE" ] || [ "${SECUBOX_DOMAIN_SUFFIX:-}" != "$SUFFIXE" ]; then
                echo "secubox-defaults: SECUBOX_HOSTNAME=${SECUBOX_HOSTNAME:-<vide>} → $HOTE, suffixe → $SUFFIXE (secubox-domaine)"
                sed -i -e "s/^SECUBOX_HOSTNAME=.*/SECUBOX_HOSTNAME=\"$HOTE\"/" \
                       -e "s/^SECUBOX_DOMAIN_SUFFIX=.*/SECUBOX_DOMAIN_SUFFIX=\"$SUFFIXE\"/" "$DEFAULTS"
            fi
        elif [ -z "${SECUBOX_HOSTNAME:-}" ]; then
            # Sans secubox-domaine : hostname -s, préfixe 'secubox-' retiré.
            DETECTED=$(hostname -s 2>/dev/null | sed 's/^secubox-//')
            if [ -n "$DETECTED" ]; then
                echo "secubox-defaults: setting SECUBOX_HOSTNAME=$DETECTED (autodetected)"
                sed -i "s/^SECUBOX_HOSTNAME=.*/SECUBOX_HOSTNAME=\"$DETECTED\"/" "$DEFAULTS"
            else
                echo "secubox-defaults: WARNING — SECUBOX_HOSTNAME unset and could not autodetect" >&2
            fi
        fi

        # Activate the trigger so other packages (secubox-haproxy etc.) refresh
        dpkg-trigger secubox-defaults-changed || true
        ;;
esac

#DEBHELPER#

exit 0
