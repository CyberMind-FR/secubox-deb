"""secubox-dns-joker : assure « *.<nœud> A <ip> » chez le registraire, par les fournisseurs du module DNS (#3206).

  secubox-dns-joker assurer <domaine-du-pair> <ipv4-publique> <zone-autorisée>

Appelé par secubox-relais-maillage (root) avant le certificat joker d'un pair ; la zone autorisée est sa zone
parente (gk2.secubox.in → secubox.in) : un pair ne fait jamais écrire ailleurs. Seuls les fournisseurs Gandi activés
sont retenus (les autres nomment autrement les enregistrements : « jamais écrasé » n'y serait pas tenu). Sortie : une ligne JSON. Codes : 0 créé ou
déjà juste ; 2 usage ; 3 refus (domaine, IP, zone non gérée, enregistrement étranger) ; 1 échec du fournisseur.
Les clés d'API (providers.json, 0600) ne sont jamais écrites dans la sortie ni dans l'audit."""
import asyncio
import json
import os
import sys

INSTALLE = "/usr/lib/secubox/dns-provider"
USAGE = "usage : secubox-dns-joker assurer <domaine-du-pair> <ipv4-publique> <zone-autorisée>"


def _repondre(donnees, code):
    print(json.dumps(donnees, ensure_ascii=False))
    return code


def fournisseurs_retenus(fournisseurs):
    """Gandi activés seulement (revue #3206 : un fournisseur désactivé n'est jamais écrit ; Route53 et Cloudflare nomment
    autrement les enregistrements, la vérification « jamais écrasé » n'y serait pas tenue)."""
    return [p for p in fournisseurs if isinstance(p, dict) and p.get("provider") == "gandi" and p.get("enabled", True)]


def charger_systeme():
    """(fournisseurs, fabrique, auditer, erreurs_fournisseur) depuis le module installé."""
    racine = INSTALLE if os.path.isdir(INSTALLE) else os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if racine not in sys.path:
        sys.path.insert(0, racine)
    from api import main as m
    fournisseurs = []
    for p in fournisseurs_retenus(m._load_json(m.PROVIDERS_FILE, {"providers": []}).get("providers", [])):
        try:
            fournisseurs.append((p["id"], m.get_adapter(m.ProviderType(p["provider"]), p["credentials"])))
        except Exception:                                   # fournisseur incomplet : ignoré, jamais bloquant
            continue

    def fabrique(nom, ip):
        return m.RecordCreate(type=m.RecordType("A"), name=nom, value=ip, ttl=300)

    def auditer(action, details):
        """_audit_log du module ; un fichier qu'il vient de créer en root est rendu au compte du service (le propriétaire
        de son dossier), sans quoi l'API (secubox) ne pourrait plus y écrire (revue #3206)."""
        m._audit_log(action, details)
        try:
            dossier, f = os.stat(m.DATA_DIR), m.AUDIT_LOG_FILE
            if os.stat(f).st_uid == 0 and dossier.st_uid != 0:
                os.chown(f, dossier.st_uid, dossier.st_gid)
        except OSError:
            pass

    return fournisseurs, fabrique, auditer, (m.HTTPException,)


def main(argv=None, charger=None):
    args = list(sys.argv[1:] if argv is None else argv)
    if len(args) != 4 or args[0] != "assurer":
        return _repondre({"erreur": USAGE}, 2)
    if charger is None and os.geteuid() != 0:
        return _repondre({"erreur": "secubox-dns-joker doit tourner en root (clés d'API en 0600)"}, 1)
    domaine, ip, zone = args[1], args[2], args[3]
    fournisseurs, fabrique, auditer, erreurs = (charger or charger_systeme)()
    racine = INSTALLE if os.path.isdir(INSTALLE) else os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if racine not in sys.path:
        sys.path.insert(0, racine)
    from api import joker
    try:
        r = asyncio.run(joker.assurer(fournisseurs, domaine, ip, fabrique, [zone]))
    except joker.Refus as exc:
        auditer("joker_refuse", {"domaine": domaine, "ip": ip, "motif": str(exc)})
        return _repondre({"erreur": str(exc)}, 3)
    except (joker.Echec, *erreurs) as exc:
        motif = getattr(exc, "detail", None) or str(exc)
        auditer("joker_echec", {"domaine": domaine, "ip": ip, "motif": motif})
        return _repondre({"erreur": motif}, 1)
    except Exception as exc:                                # imprévu : JSON et audit plutôt qu'une trace
        motif = f"échec inattendu : {exc.__class__.__name__}"
        auditer("joker_echec", {"domaine": domaine, "ip": ip, "motif": motif})
        return _repondre({"erreur": motif}, 1)
    if r["etat"] == "cree":
        auditer("record_created", {"domain": r["zone"], "provider": r["fournisseur"], "type": "A", "name": r["nom"],
                                   "motif": f"joker du pair {domaine} (relais du maillage, #3206)"})
    return _repondre(r, 0)


if __name__ == "__main__":
    sys.exit(main())
