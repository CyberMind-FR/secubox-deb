#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    systemctl daemon-reload
    systemctl enable secubox-dns.service || true
    systemctl start secubox-dns.service || true
fi
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/dns/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "dns : postinst de $(basename "$_s") en échec" >&2; }
done
#DEBHELPER#
exit 0
