#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
    systemctl stop secubox-dns.service || true
    systemctl disable secubox-dns.service || true
    systemctl reload nginx 2>/dev/null || true
fi
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/dns/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "dns : prerm de $(basename "$_s") en échec" >&2; }
done
#DEBHELPER#
exit 0
