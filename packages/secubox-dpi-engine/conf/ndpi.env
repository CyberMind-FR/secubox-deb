# SecuBox-Deb :: nDPId engine configuration (dpkg conffile)
#
# Interface nDPId captures on. eth2 is the WAN uplink (all egress funnels here);
# switch to a LAN bridge for per-client talkers. An optional BPF narrows it.
DPI_IFACE=eth2
DPI_BPF=
# Collector socket nDPId pushes framed JSON to and nDPIsrvd listens on.
DPI_COLLECTOR_SOCK=/run/secubox/ndpi/collector.sock
# Distributor socket nDPIsrvd serves the stream on (sbxdpi dials this).
DPI_DISTRIBUTOR_SOCK=/run/secubox/ndpi/distributor.sock
