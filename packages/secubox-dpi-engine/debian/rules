#!/usr/bin/make -f
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
#
# Le binaire nDPId embarque libnDPI 5.x (BUILD_NDPI=ON). La build clone
# utoni/nDPId (récursif) et compile en NATIF — le cross-build de libnDPI n'est
# pas supporté ici. Construire sur arm64 (la box ou un runner arm64) :
#     dpkg-buildpackage -b -us -uc
#
# ÉPINGLAGE : le binaire déployé = nDPId 1.7.0-pre. Pour une build reproductible,
# renseigner le commit exact dans debian/ndpid.ref (une ligne). À défaut, on
# tombe sur la branche par défaut ci-dessous (NON reproductible — à figer).
NDPID_URL ?= https://github.com/utoni/nDPId.git
NDPID_REF := $(shell test -f debian/ndpid.ref && sed -n '1p' debian/ndpid.ref || echo main)

SRC   := $(CURDIR)/.ndpid-src
BUILD := $(CURDIR)/.ndpid-build
DEST  := $(CURDIR)/debian/secubox-dpi-engine

%:
	dh $@

override_dh_auto_configure:
	rm -rf $(SRC) $(BUILD)
	git clone $(NDPID_URL) $(SRC)
	cd $(SRC) && git checkout $(NDPID_REF) && git submodule update --init --recursive
	cmake -S $(SRC) -B $(BUILD) -DBUILD_NDPI=ON -DCMAKE_BUILD_TYPE=Release

override_dh_auto_build:
	cmake --build $(BUILD) --target nDPId nDPIsrvd -j$$(nproc)

override_dh_auto_test:
	true

override_dh_auto_install:
	# Binaires (nDPI 5.x statiquement liée dans nDPId).
	install -d $(DEST)/usr/sbin
	install -m 0755 $$(find $(BUILD) -type f -name nDPId    | head -1) $(DEST)/usr/sbin/nDPId
	install -m 0755 $$(find $(BUILD) -type f -name nDPIsrvd | head -1) $(DEST)/usr/sbin/nDPIsrvd
	# Units systemd.
	install -d $(DEST)/usr/lib/systemd/system
	install -m 0644 systemd/nDPId.service    $(DEST)/usr/lib/systemd/system/nDPId.service
	install -m 0644 systemd/nDPIsrvd.service $(DEST)/usr/lib/systemd/system/nDPIsrvd.service
	# Config (conffile) + répertoire de sockets (tmpfiles).
	install -d $(DEST)/etc/secubox
	install -m 0644 conf/ndpi.env $(DEST)/etc/secubox/ndpi.env
	install -d $(DEST)/usr/lib/tmpfiles.d
	install -m 0644 tmpfiles/zz-secubox-ndpi.conf $(DEST)/usr/lib/tmpfiles.d/zz-secubox-ndpi.conf

override_dh_auto_clean:
	rm -rf $(SRC) $(BUILD)

# Activation gérée en postinst (respect du masquage opérateur), pas par dh.
override_dh_installsystemd:
	true
