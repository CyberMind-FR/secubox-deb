#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    mkdir -p /var/lib/secubox/ndpid
    chown -R secubox:secubox /var/lib/secubox/ndpid

    # API servie par l'AGRÉGATEUR (#2335) : un seul processus pour ~110 modules au lieu d'un démon uvicorn dédié par module (~70-80 Mo chacun). Déclaration idempotente.
    NOUVEAU=$(python3 - <<'TOML' 2>/dev/null || true
import pathlib, re
f = pathlib.Path("/etc/secubox/aggregator.toml")
if f.exists():
    s = f.read_text()
    if '"ndpid"' not in s:
        f.write_text(re.sub(r'modules\s*=\s*\[', 'modules = [\n    "ndpid",', s, count=1))
        print("oui")
TOML
)
    # Ancien démon dédié (paquet secubox-ndpid, puis unité du paquet dpi) : arrêté et désactivé, l'agrégateur sert l'API.
    # Sans condition : l'unite n'existe plus dans le paquet, mais le processus tourne encore (unite chargee en memoire, ou fournie par l'ancien paquet).
    systemctl disable --now secubox-ndpid.service >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    # L'agrégateur n'importe un module qu'à son démarrage : redémarrage SEULEMENT si ndpid vient d'y être déclaré.
    if [ "$NOUVEAU" = "oui" ] && [ -d /run/systemd/system ]; then
        systemctl --no-block restart secubox-aggregator >/dev/null 2>&1 || true
    fi
fi
exit 0
