#!/usr/bin/make -f
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: secubox-dpi — DPI dashboard (Python) + R3 exfil collector (Go)
#
# The per-device cloud-exfiltration collector (#687) is a pure-stdlib Go binary
# cross-built for arm64, fully offline (no module download): the collector has
# no external deps so no vendor tree is needed. GOTOOLCHAIN=local pins the build
# to the distro Go; GOPROXY=off forbids any network. CI cross-builds the same.
export DH_VERBOSE = 1

export GOOS = linux
export GOARCH = $(shell dpkg-architecture -qDEB_HOST_ARCH)
export CGO_ENABLED = 0
export GOPROXY = off
export GOTOOLCHAIN = local
# Keep the Go build/module cache inside the build tree (sandbox-friendly).
export GOCACHE = $(CURDIR)/_gocache
export GOPATH  = $(CURDIR)/_gopath

%:
	dh $@

override_dh_auto_build:
	# #718 — maxminddb-golang is vendored into collector/vendor so the build is
	# fully offline (GOPROXY=off, -mod=vendor); CGO off keeps the arm64 cross static.
	cd collector && go build -mod=vendor -trimpath -ldflags=-s -o secubox-dpi-collector .

# The arm64 cross-binary cannot run its tests on the build host; CI runs Go
# unit tests on the host arch instead.
override_dh_auto_test:

override_dh_auto_install:
	# Python API + dashboard (arch-independent payload, shipped in the arm64 deb)
	install -d debian/secubox-dpi/usr/lib/secubox/dpi/
	cp -r api debian/secubox-dpi/usr/lib/secubox/dpi/
	# Exemple d'alias de terminaux (vue Clients). L'opérateur le copie en
	# /etc/secubox/dpi/device-names.json ; rechargé à chaud par l'API.
	install -d debian/secubox-dpi/etc/secubox/dpi
	install -m 0644 debian/dpi/device-names.json.example debian/secubox-dpi/etc/secubox/dpi/device-names.json.example
	install -d debian/secubox-dpi/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-dpi/usr/share/secubox/www/ || true
	install -d debian/secubox-dpi/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-dpi/usr/share/secubox/menu.d/ || true
	# Modular nginx config
	install -d debian/secubox-dpi/etc/nginx/secubox.d
	[ -f nginx/dpi.conf ] && cp nginx/dpi.conf debian/secubox-dpi/etc/nginx/secubox.d/ || true
	# #687 R3 exfil pipeline: Go collector + capture loop
	install -d debian/secubox-dpi/usr/sbin
	install -m 0755 collector/secubox-dpi-collector debian/secubox-dpi/usr/sbin/secubox-dpi-collector
	install -m 0755 sbin/secubox-dpi-flowcap        debian/secubox-dpi/usr/sbin/secubox-dpi-flowcap
	# flowcap unit — installed into the tree so dh_installsystemd auto-enables it
	install -d debian/secubox-dpi/usr/lib/systemd/system
	install -m 0644 systemd/secubox-dpi-flowcap.service \
	  debian/secubox-dpi/usr/lib/systemd/system/secubox-dpi-flowcap.service
	# Composant absorbé : ndpid (#2050)
	install -d debian/secubox-dpi/usr/lib/secubox/ndpid
	cp -r composants/ndpid/api debian/secubox-dpi/usr/lib/secubox/ndpid/
	install -d debian/secubox-dpi/usr/share/secubox/www/ndpid
	cp -r composants/ndpid/www/ndpid/. debian/secubox-dpi/usr/share/secubox/www/ndpid/
	install -d debian/secubox-dpi/usr/share/secubox/menu.d
	[ -d composants/ndpid/menu.d ] && cp -r composants/ndpid/menu.d/. debian/secubox-dpi/usr/share/secubox/menu.d/ || true
	install -d debian/secubox-dpi/etc/secubox
	[ -f composants/ndpid/config/ndpid.toml ] && install -m 644 composants/ndpid/config/ndpid.toml debian/secubox-dpi/etc/secubox/ || true
	install -d debian/secubox-dpi/usr/bin
	[ -f composants/ndpid/scripts/ndpidctl ] && install -m 755 composants/ndpid/scripts/ndpidctl debian/secubox-dpi/usr/bin/ || true
	install -d debian/secubox-dpi/etc/nginx/secubox.d
	[ -f composants/ndpid/nginx/ndpid.conf ] && install -m 644 composants/ndpid/nginx/ndpid.conf debian/secubox-dpi/etc/nginx/secubox.d/ || true
	install -D -m 755 composants/ndpid/debian/postinst debian/secubox-dpi/usr/lib/secubox/dpi/maintscripts/ndpid.postinst
	install -D -m 755 composants/ndpid/debian/prerm debian/secubox-dpi/usr/lib/secubox/dpi/maintscripts/ndpid.prerm
	install -D -m 644 composants/ndpid/debian/secubox-ndpid.service debian/secubox-dpi/usr/lib/systemd/system/secubox-ndpid.service
	# Composant absorbé : mediaflow (#2050)
	install -d debian/secubox-dpi/usr/lib/secubox/mediaflow/
	cp -r composants/mediaflow/api debian/secubox-dpi/usr/lib/secubox/mediaflow/
	install -d debian/secubox-dpi/usr/share/secubox/www
	[ -d composants/mediaflow/www ] && cp -r composants/mediaflow/www/. debian/secubox-dpi/usr/share/secubox/www/ || true
	install -d debian/secubox-dpi/usr/share/secubox/menu.d
	[ -d composants/mediaflow/menu.d ] && cp -r composants/mediaflow/menu.d/. debian/secubox-dpi/usr/share/secubox/menu.d/ || true
	# Modular composants/mediaflow/nginx composants/mediaflow/config
	install -d debian/secubox-dpi/etc/nginx/secubox.d
	[ -f composants/mediaflow/nginx/mediaflow.conf ] && cp composants/mediaflow/nginx/mediaflow.conf debian/secubox-dpi/etc/nginx/secubox.d/ || true
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d debian/secubox-dpi/etc/nginx/secubox-routes.d
	[ -f composants/mediaflow/nginx/mediaflow.conf ] && cp composants/mediaflow/nginx/mediaflow.conf debian/secubox-dpi/etc/nginx/secubox-routes.d/ || true
	# R4 cloner helper (#736): keep yt-dlp current for Discovered Media
	install -d debian/secubox-dpi/usr/sbin
	install -m 0755 composants/mediaflow/sbin/secubox-yt-dlp-refresh debian/secubox-dpi/usr/sbin/
	install -D -m 755 composants/mediaflow/debian/postinst debian/secubox-dpi/usr/lib/secubox/dpi/maintscripts/mediaflow.postinst
	install -D -m 755 composants/mediaflow/debian/prerm debian/secubox-dpi/usr/lib/secubox/dpi/maintscripts/mediaflow.prerm
	install -D -m 644 composants/mediaflow/debian/secubox-mediaflow.secubox-yt-dlp-refresh.service debian/secubox-dpi/usr/lib/systemd/system/secubox-yt-dlp-refresh.service
	install -D -m 644 composants/mediaflow/debian/secubox-mediaflow.secubox-yt-dlp-refresh.timer debian/secubox-dpi/usr/lib/systemd/system/secubox-yt-dlp-refresh.timer
	install -D -m 644 composants/mediaflow/debian/secubox-mediaflow.service debian/secubox-dpi/usr/lib/systemd/system/secubox-mediaflow.service

override_dh_auto_clean:
	rm -f collector/secubox-dpi-collector
	rm -rf _gocache _gopath
