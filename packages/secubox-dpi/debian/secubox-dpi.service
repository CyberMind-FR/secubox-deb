[Unit]
Description=SecuBox DPI Dashboard API
After=network.target secubox-core.service netifyd.service
Wants=secubox-core.service
Wants=netifyd.service

[Service]
UMask=0000
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/dpi
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/dpi.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app \
    --uds /run/secubox/dpi.sock \
    --log-level warning
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
