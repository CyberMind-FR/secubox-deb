[Unit]
Description=SecuBox Droplet File Publisher API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
UMask=0000
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/droplet
ExecStart=/usr/bin/python3 -m uvicorn api.main:app \
    --uds /run/secubox/droplet.sock \
    --log-level warning
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
RuntimeDirectory=secubox
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0775

# /data/secubox/droplet : l espace de depot (#1026). Sans ce chemin, le
# service demarre normalement et le PREMIER depot echoue — la panne la plus
# desagreable, puisqu elle n arrive qu en presence d un utilisateur.
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox /srv/droplet /data/secubox

[Install]
WantedBy=multi-user.target
