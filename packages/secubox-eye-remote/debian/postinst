#!/bin/bash
set -e

case "$1" in
    configure)
        # Reload udev rules
        udevadm control --reload-rules || true
        
        # Create runtime directory
        mkdir -p /run/secubox
        chown secubox:secubox /run/secubox 2>/dev/null || true
        
        # Enable and start service
        systemctl daemon-reload
        systemctl enable secubox-eye-remote.service || true
        systemctl start secubox-eye-remote.service || true
        
        echo "SecuBox Eye Remote installed."
        echo "Connect Pi Zero W to USB port - auto-detection enabled."
        ;;
esac

#DEBHELPER#

exit 0
