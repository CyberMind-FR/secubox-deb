[Unit]
Description=SecuBox FM Relay — host control plane API (issue #377)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/377
After=network.target
Wants=secubox-core.service
# Soft dep: icecast2 must be up before any /start call can succeed,
# but the API itself runs without it (it'll report `red` overall).
Wants=icecast2.service
After=icecast2.service

# /run/secubox N'EST PAS UN RuntimeDirectory (#1022).
#
# Il est PARTAGE par une centaine de modules. `RuntimeDirectory=` est concu pour
# un repertoire PROPRE a un service : systemd le recree a chaque demarrage avec
# le mode de l'unite, donc le dernier service demarre imposait le sien. Huit
# unites le posaient en 0755, ce qui privait tous les autres du droit d'y creer
# leur socket — « bind: permission denied », et un 502 dont la cause etait le
# redemarrage d'un module sans rapport, survenu entre-temps.
#
# Le meme mecanisme effacait le repertoire a l'arret d'un service, emportant les
# sockets des quatre-vingt-dix autres.
#
# Il est desormais declare une seule fois, en 1777, par le tmpfiles.d de
# secubox-core — un seul proprietaire, une seule verite.
[Service]
Type=simple
User=secubox
Group=secubox
# MUST preserve /run/secubox across unit restarts — otherwise stopping
# this service wipes the directory and removes every other secubox
# module's socket (lyrion, authelia, etc.). Same pattern as every other
# secubox unit that owns RuntimeDirectory=secubox.
WorkingDirectory=/usr/lib/secubox/fmrelay
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/fmrelay.sock --log-level warning
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/secubox /var/lib/secubox/fmrelay /var/log/secubox

[Install]
WantedBy=multi-user.target
