[Unit]
Description=SecuBox FM Relay — host control plane API (issue #377)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/377
After=network.target
Wants=secubox-core.service
# Soft dep: icecast2 must be up before any /start call can succeed,
# but the API itself runs without it (it'll report `red` overall).
Wants=icecast2.service
After=icecast2.service

[Service]
Type=simple
User=secubox
Group=secubox
# RuntimeDirectory=secubox RETIRE (#1022) : /run/secubox est partage par ~95
# unites, et systemd EFFACE le contenu d'un RuntimeDirectory au redemarrage —
# une seule unite qui le declare emporte les sockets de toutes les autres, et
# la board rend des 502 sur des modules qui n'avaient rien demande. Le parent
# reste root:root 1777, cree hors des unites.
RuntimeDirectoryMode=0755
# MUST preserve /run/secubox across unit restarts — otherwise stopping
# this service wipes the directory and removes every other secubox
# module's socket (lyrion, authelia, etc.). Same pattern as every other
# secubox unit that owns RuntimeDirectory=secubox.
WorkingDirectory=/usr/lib/secubox/fmrelay
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/fmrelay.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/fmrelay.sock --log-level warning
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/secubox /var/lib/secubox/fmrelay /var/log/secubox

[Install]
WantedBy=multi-user.target
