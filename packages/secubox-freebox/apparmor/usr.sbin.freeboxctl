# Profil AppArmor ENFORCE de freeboxctl (#3742), attaché au chemin de la commande (minuteur secubox-freebox-maillage,
# appels sudo -u secubox-freebox d'autres modules). Il LIT sa conf (/etc/secubox/p2p.toml, /etc/secubox/freebox.toml) et
# son code, n'ÉCRIT que sous /var/lib/secubox/freebox/ (magasin du jeton, état du contrôle) ; seule exception : l'AJOUT en
# fin de /var/log/secubox/audit.log (append-only, exigence CSPN : chaque décision de sécurité y est écrite).
# N'exécute que `ip` (lecture des adresses et routes IPv6). Réseau : inet/inet6 (API Freebox, résolution DNS), netlink (ip).
# Aucun shell, aucun secret.

#include <tunables/global>

profile secubox-freeboxctl /usr/sbin/freeboxctl flags=(enforce) {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>      # résolution de l'AAAA annoncée, nom de la Freebox

  /usr/sbin/freeboxctl r,
  /usr/bin/python3* rix,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /usr/lib/secubox/freebox/ r,
  /usr/lib/secubox/freebox/** r,

  deny /etc/secubox/secrets/** rw,
  /etc/secubox/p2p.toml r,
  /etc/secubox/freebox.toml r,

  /var/lib/secubox/freebox/ r,
  /var/lib/secubox/freebox/** rw,
  /var/log/secubox/audit.log a,

  /usr/bin/ip ix,
  /usr/sbin/ip ix,
  /bin/ip ix,

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,
  network unix stream,
  network unix dgram,
}
