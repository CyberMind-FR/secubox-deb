# Contrôle du maillage distant (#3742) : l'IPv6 fixe est-elle toujours sur le WAN, et égale à l'AAAA publiée ? Lecture seule
# (ip -j addr, résolution DNS) ; écrit l’état lu par l’API, alerte au journal sinon. Puis contrôle des DNS de la Freebox (#3769).
[Unit]
Description=SecuBox Freebox — contrôle de l’IPv6 fixe du maillage et des DNS annoncés
After=network-online.target

[Service]
Type=oneshot
User=secubox-freebox
Group=secubox
ExecStart=/usr/sbin/freeboxctl maillage-controle
# Contrôle des DNS annoncés par la Freebox (#3769) : seule écriture possible, vers la box, selon le réglage (dns-reglage.json).
ExecStart=/usr/sbin/freeboxctl dns-controle
SyslogLevelPrefix=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027
ReadWritePaths=/var/lib/secubox/freebox
