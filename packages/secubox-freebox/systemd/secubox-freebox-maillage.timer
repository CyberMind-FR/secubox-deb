[Unit]
Description=SecuBox Freebox — contrôle périodique de l'IPv6 fixe du maillage distant

[Timer]
OnBootSec=3min
OnUnitActiveSec=15min
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
