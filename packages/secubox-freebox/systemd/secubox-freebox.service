# SecuBox Freebox — connecteur de l'API Freebox OS. Utilisateur dédié, sans capacité ; le jeton d'application vit dans /var/lib/secubox/freebox (0600) et ne sort jamais.
[Unit]
Description=SecuBox Connecteur Freebox (API Freebox OS)
After=network.target secubox-core.service

[Service]
Type=simple
User=secubox-freebox
Group=secubox
WorkingDirectory=/usr/lib/secubox/freebox
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# /run/secubox est PARTAGÉ et collant (1777) : on n'y délie que ce qu'on possède. Le préfixe « + » s'exécute en root malgré User=.
ExecStartPre=+/bin/rm -f /run/secubox/freebox.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/freebox.sock --workers 1 --log-level warning
# uvicorn force la socket en 0o666 après le bind : le chmod 660 est INDISPENSABLE (#2026).
ExecStartPost=/bin/sh -c 'for i in $(seq 1 1200); do [ -S /run/secubox/freebox.sock ] && break; sleep 0.1; done; chmod 660 /run/secubox/freebox.sock'
TimeoutStartSec=180
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027
ReadWritePaths=/run/secubox /var/lib/secubox/freebox

[Install]
WantedBy=multi-user.target
