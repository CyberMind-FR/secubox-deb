#!/bin/bash
set -e
case "$1" in
  configure)
    install -d -m 0755 -o secubox -g secubox /var/cache/secubox/frigate 2>/dev/null || true
    # Stockage des enregistrements. Le prerm prend soin de le PRESERVER, mais
    # rien ne le creait : sur une installation neuve le service mourait donc au
    # demarrage (« Failed to set up mount namespacing: /data/frigate »), constate
    # sur rpi400. Cree seulement si /data existe — sur les cartes sans SSD monte,
    # le `-` de ReadWritePaths dans l'unite couvre l'absence.
    if [ -d /data ]; then
        install -d -m 0755 -o secubox -g secubox /data/frigate 2>/dev/null || true
    fi
    systemctl daemon-reload || true
    deb-systemd-helper enable secubox-frigate.service >/dev/null 2>&1 || true
    deb-systemd-invoke restart secubox-frigate.service >/dev/null 2>&1 || true
    systemctl enable --now secubox-frigate-diskguard.timer >/dev/null 2>&1 || true
    # Plus d'installation automatique (#1751) : chaque mise à jour du paquet
    # relançait `frigatectl install`, qui met podman DANS le LXC et tire
    # l'image officielle — contraire à la règle LXC uniquement (#1743). En
    # attendant l'arbitrage frigate, l'installation reste un geste manuel.
    if command -v lxc-create >/dev/null 2>&1 && [ ! -d /data/lxc/frigate ]; then
        echo "secubox-frigate : LXC non provisionné — installation manuelle (frigatectl install), voir #1743" >&2
    fi
    ;;
esac
#DEBHELPER#
exit 0
