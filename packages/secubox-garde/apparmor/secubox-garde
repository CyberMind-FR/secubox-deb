# Profil AppArmor ENFORCE de Garde (#3794), nommé par AppArmorProfile= dans secubox-garde.service et
# secubox-garde-passage.service, chargé par le postinst. LECTURE de garde.toml ; ÉCRITURE du seul
# /var/lib/secubox/garde et de la socket. Aucun secret, aucun sudo, aucun réseau IP.
# Les sources (journaux du WAF, des leurres) et les actions viendront avec les tâches suivantes.

#include <tunables/global>

profile secubox-garde flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>

  /usr/bin/python3* rix,
  /usr/lib/secubox/garde/ r,
  /usr/lib/secubox/garde/** r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /usr/local/lib/python3*/** r,

  # ExecStartPost de l'API : remettre la socket en 0660.
  /{usr/,}bin/sh ix,
  /{usr/,}bin/dash ix,
  /{usr/,}bin/seq ix,
  /{usr/,}bin/sleep ix,
  /{usr/,}bin/chmod ix,

  # Configuration ; jamais les secrets.
  /etc/secubox/garde.toml r,
  # Gardes de l'API (require_lecture / require_jwt de secubox_core), même liste que secubox-status.
  /etc/secubox/ r,
  /etc/secubox/secubox.conf r,
  /etc/secubox/users.json r,
  /etc/secubox/auth.toml r,
  /var/lib/secubox/auth/ r,
  /var/lib/secubox/auth/sessions.json r,
  /var/log/secubox/delegation.log w,
  /dev/null rw,
  /proc/sys/net/core/somaxconn r,
  deny /etc/secubox/secrets/** rwklx,

  # État : base des décisions.
  /var/lib/secubox/garde/ rw,
  /var/lib/secubox/garde/** rwk,

  # API.
  /run/secubox/ r,
  /run/secubox/garde.sock rw,
  network unix stream,
}
