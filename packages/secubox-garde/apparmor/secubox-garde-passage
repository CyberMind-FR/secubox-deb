# Profil AppArmor ENFORCE du passage du moteur de Garde (#3794), nommé par AppArmorProfile= dans
# secubox-garde-passage.service, chargé par le postinst. Distinct du profil de l'API : seul le passage lit
# la clé garde-ban.pem et lance sudo. Le contrôleur d'ad-guard tourne HORS de ce profil (sudo Ux), borné par
# le sudoers secubox-adguard-garde (deux verbes, arguments revalidés).

#include <tunables/global>

profile secubox-garde-passage flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>

  /usr/bin/python3* rix,
  /usr/sbin/secubox-garde-passage r,
  /usr/lib/secubox/garde/ r,
  /usr/lib/secubox/garde/** r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /usr/local/lib/python3*/** r,

  # Outils.
  /{usr/,}bin/ip rix,
  /{usr/,}sbin/ip rix,
  /usr/bin/sudo Ux,
  network netlink raw,
  network unix stream,

  # Réglages, nom de la box ; un seul secret : la clé du geste garde-ban.
  /etc/secubox/garde.toml r,
  /etc/secubox/secrets/ r,
  /etc/secubox/secrets/garde-* r,
  /etc/hostname r,
  /proc/sys/kernel/random/boot_id r,
  /proc/sys/kernel/hostname r,
  /dev/null rw,

  # Capteurs (lecture seule).
  /var/lib/secubox/dns-guard/alerts.jsonl r,
  /run/secubox/actord-propositions.json r,
  /var/lib/secubox/ad-guard/dnstv/ r,
  /var/lib/secubox/ad-guard/dnstv/dnstv.db* rk,
  /var/lib/secubox/ad-guard/dnstv/etat.json r,
  /usr/share/secubox/ad-guard/lists/resolveurs-doh.txt r,
  /var/lib/secubox/nac/ r,
  /var/lib/secubox/nac/devices.db* rk,
  /var/lib/misc/dnsmasq.leases r,
  /var/lib/kea/kea-leases4.csv r,
  /usr/share/ieee-data/oui.csv r,

  # WAF (geste garde-ban).
  /run/secubox/ r,
  /run/secubox/waf.sock rw,
  # Adresses isolées lues par sbxwaf (#3800) : temporaire puis rename, rien d'autre dans /run/secubox.
  /run/secubox/garde-isoles.json rw,
  /run/secubox/.garde-isoles.* rw,

  # État et audit.
  /var/lib/secubox/garde/ rw,
  /var/lib/secubox/garde/** rwk,
  /var/log/secubox/audit.log a,
}
