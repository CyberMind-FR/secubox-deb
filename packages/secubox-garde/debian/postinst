set -e

case "$1" in
    configure)
        getent group secubox >/dev/null || groupadd --system secubox
        id -u secubox-garde >/dev/null 2>&1 || \
          adduser --system --ingroup secubox --no-create-home --home /nonexistent \
            --shell /usr/sbin/nologin secubox-garde >/dev/null
        install -d -o secubox-garde -g secubox -m 0750 /var/lib/secubox/garde
        # La configuration n'est semée qu'une fois : une copie modifiée fait autorité.
        if [ ! -e /etc/secubox/garde.toml ] && [ ! -L /etc/secubox/garde.toml ] && [ -d /etc/secubox ] && [ ! -L /etc/secubox ]; then
            install -m 0640 -o root -g secubox /usr/share/secubox/garde/garde.toml.example /etc/secubox/garde.toml
        fi
        # Profil AppArmor AVANT tout démarrage (les unités le nomment).
        if [ -d /run/systemd/system ] && [ -d /sys/kernel/security/apparmor ] \
           && command -v apparmor_parser >/dev/null 2>&1; then
            apparmor_parser -r /etc/apparmor.d/secubox-garde \
              || echo "secubox-garde : profil AppArmor non chargé (apparmor_parser -r /etc/apparmor.d/secubox-garde ; journalctl -k)" >&2
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable --now secubox-garde.service secubox-garde-passage.timer >/dev/null 2>&1 || true
            if nginx -t >/dev/null 2>&1; then systemctl reload nginx 2>/dev/null || true; fi
        fi
        ;;
esac

#DEBHELPER#
exit 0
