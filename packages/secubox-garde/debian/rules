# See LICENCE-CMSD-1.0.md for terms.
# SecuBox-Deb :: garde (#3794).
P = $(CURDIR)/debian/secubox-garde

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_installsystemd:

override_dh_auto_install:
	install -d $(P)/usr/lib/secubox/garde/api $(P)/usr/lib/secubox/garde/garde
	install -m 644 api/*.py $(P)/usr/lib/secubox/garde/api/
	install -m 644 garde/*.py $(P)/usr/lib/secubox/garde/garde/
	install -d $(P)/usr/share/secubox/garde
	install -m 644 conf/garde.toml $(P)/usr/share/secubox/garde/garde.toml.example
	install -d $(P)/usr/lib/systemd/system
	install -m 644 debian/secubox-garde.service debian/secubox-garde-passage.service \
	  debian/secubox-garde-passage.timer debian/secubox-garde-envoi.service $(P)/usr/lib/systemd/system/
	install -d $(P)/usr/share/secubox/menu.d
	cp -r menu.d/. $(P)/usr/share/secubox/menu.d/
	install -d $(P)/etc/apparmor.d
	install -m 644 apparmor/secubox-garde apparmor/secubox-garde-passage apparmor/secubox-garde-envoi $(P)/etc/apparmor.d/
	install -d $(P)/usr/sbin
	install -m 755 sbin/secubox-garde-passage sbin/secubox-garde-envoi $(P)/usr/sbin/
	install -m 755 lib/secubox-garde-acl-audit lib/secubox-garde-depots $(P)/usr/lib/secubox/garde/
	install -d $(P)/usr/share/secubox/www/garde
	install -m 644 www/garde/index.html www/garde/isole.html $(P)/usr/share/secubox/www/garde/
	# Route nginx : les deux dossiers, comme l'exige .claude/MODULE-COMPLIANCE.md (secubox-routes.d = vhost
	# d'administration, secubox.d = vhosts historiques) ; aucun vhost n'inclut les deux.
	install -d $(P)/etc/nginx/secubox.d $(P)/etc/nginx/secubox-routes.d
	install -m 644 nginx/garde.conf $(P)/etc/nginx/secubox.d/
	install -m 644 nginx/garde.conf $(P)/etc/nginx/secubox-routes.d/
