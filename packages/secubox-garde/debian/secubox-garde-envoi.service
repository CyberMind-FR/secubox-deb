# SecuBox Garde — envoi des notifications (#3794). Tiré par secubox-garde-passage.service (Wants=) et ordonné APRÈS lui :
# chaque passage du minuteur est suivi d'un envoi, même si le passage échoue. Seul ce programme a le réseau IP
# (relais SMTP de la box, smsapi.free-mobile.fr en HTTPS) ; ni sudo, ni capacité, ni autre exécutable (AppArmor).
[Unit]
Description=SecuBox Garde — envoi des notifications
After=secubox-garde-passage.service network-online.target

[Service]
Type=oneshot
User=secubox-garde
Group=secubox
SupplementaryGroups=secubox-garde
WorkingDirectory=/usr/lib/secubox/garde
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/sbin/secubox-garde-envoi
UMask=0027
AppArmorProfile=secubox-garde-envoi
Nice=10
MemoryMax=128M
TimeoutStartSec=50
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/secubox/garde
