# SecuBox Garde — passage du moteur (#3794), lancé par le minuteur. Squelette : le moteur arrive avec les
# tâches suivantes ; le passage ouvre pour l'instant la base et rend la main.
[Unit]
Description=SecuBox Garde — passage du moteur
After=secubox-core.service

[Service]
Type=oneshot
User=secubox-garde
Group=secubox
WorkingDirectory=/usr/lib/secubox/garde
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -c "from garde import base; base.ouvrir(base.BASE).close()"
UMask=0027
AppArmorProfile=secubox-garde
Nice=10
MemoryMax=128M
TimeoutStartSec=50
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/secubox/garde
