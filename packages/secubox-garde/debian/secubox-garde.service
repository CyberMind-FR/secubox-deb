# SecuBox Garde — API locale (#3794). Socket dans /run/secubox (RuntimeDirectory non utilisé : il effacerait
# les sockets des autres modules). Compte dédié, aucune capacité, aucun réseau IP.
[Unit]
Description=SecuBox Garde — API locale
After=network.target secubox-core.service

[Service]
Type=simple
User=secubox-garde
Group=secubox
WorkingDirectory=/usr/lib/secubox/garde
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=+/bin/rm -f /run/secubox/garde.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/garde.sock --workers 1 --log-level warning
# uvicorn force la socket en 0666 : on la remet en 0660 (groupe secubox, que nginx traverse).
ExecStartPost=/bin/sh -c 'for i in $(seq 1 1200); do [ -S /run/secubox/garde.sock ] && break; sleep 0.1; done; chmod 660 /run/secubox/garde.sock'
UMask=0027
AppArmorProfile=secubox-garde
Restart=on-failure
RestartSec=5
MemoryMax=128M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/secubox/garde
ReadWritePaths=/run/secubox

[Install]
WantedBy=multi-user.target
