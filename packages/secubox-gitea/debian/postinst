#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    # #319 /data migration. Move legacy /srv/<dir> → /data/<dir> and leave a
    # symlink behind for back-compat. Idempotent.
    for _d in gitea; do
      if [ -d "/srv/$_d" ] && [ ! -L "/srv/$_d" ] && [ ! -e "/data/$_d" ]; then
        mkdir -p /data
        _was_active=""
        if systemctl is-active --quiet secubox-gitea; then
          systemctl stop secubox-gitea || true
          _was_active=1
        fi
        mv "/srv/$_d" "/data/$_d" && ln -s "/data/$_d" "/srv/$_d" \
          && echo "secubox-gitea: migrated /srv/$_d → /data/$_d"
        [ -n "$_was_active" ] && systemctl start secubox-gitea || true
      fi
    done


    systemctl daemon-reload
    systemctl enable secubox-gitea.service || true
    systemctl start secubox-gitea.service || true

    # --- Gitea routing install (idempotent) ---
    NGINX_VHOST=/etc/nginx/sites-available/gitea.conf
    NGINX_ENABLED=/etc/nginx/sites-enabled/gitea
    HAPROXY_CFG=/etc/haproxy/haproxy.cfg
    SECUBOX_GITEA_CONF=/usr/share/secubox-gitea/conf

    # 1. nginx vhost
    if [ ! -f "$NGINX_VHOST" ] && [ -f "$SECUBOX_GITEA_CONF/gitea.nginx.conf" ]; then
        install -m 0644 "$SECUBOX_GITEA_CONF/gitea.nginx.conf" "$NGINX_VHOST"
        ln -sf "$NGINX_VHOST" "$NGINX_ENABLED"
        if nginx -t 2>/dev/null; then
            systemctl reload nginx || true
        else
            echo "secubox-gitea: nginx -t failed after vhost install — rolling back vhost" >&2
            rm -f "$NGINX_ENABLED" "$NGINX_VHOST"
        fi
    fi

    # #1682 : le vhost ACTIF répond aussi à gitea.* (le service sous le domaine
    # de la box). Une copie posée par une ancienne installation n'est jamais
    # rafraîchie : on n'y migre QUE la ligne server_name, sauvegarde hors de
    # sites-enabled (nginx charge tout ce qui s'y trouve), retour si nginx -t refuse.
    f="$(readlink -f /etc/nginx/sites-available/gitea.conf 2>/dev/null || true)"
    if [ -n "$f" ] && [ -f "$f" ] && grep -q 'gitea\.gk2\.secubox\.in' "$f" && ! grep -q 'gitea\.\*' "$f"; then
      mkdir -p /var/backups/secubox-vhosts
      cp -p "$f" "/var/backups/secubox-vhosts/$(basename "$f").avant-1682"
      sed -i 's/^\(\s*server_name\s[^;]*gitea\.gk2\.secubox\.in\)\([^;]*\);/\1\2 gitea.*;/' "$f"
      if command -v nginx >/dev/null && ! nginx -t 2>/dev/null; then
        cp -p "/var/backups/secubox-vhosts/$(basename "$f").avant-1682" "$f"
      else
        systemctl reload nginx 2>/dev/null || true
      fi
    fi

    # 2. HAProxy ACLs + TCP frontend (only if gitea.gk2.secubox.in is not yet routed)
    if [ -f "$HAPROXY_CFG" ] && ! grep -q "host_gitea_gk2_secubox_in" "$HAPROXY_CFG"; then
        cp "$HAPROXY_CFG" "$HAPROXY_CFG.bak.gitea-postinst.$(date +%s)"
        for frontend in http-in https-in; do
            awk -v fe="$frontend" '
                $0 ~ "^frontend "fe { inside=1 }
                /^frontend / && $0 !~ "^frontend "fe { inside=0 }
                inside && /^    default_backend / && !done {
                    print "    acl host_gitea_gk2_secubox_in hdr(host) -i gitea.gk2.secubox.in"
                    print "    use_backend nginx_vhosts if host_gitea_gk2_secubox_in"
                    done=1
                }
                { print }
            ' "$HAPROXY_CFG" > "$HAPROXY_CFG.new"
            mv "$HAPROXY_CFG.new" "$HAPROXY_CFG"
        done
        if ! grep -q "^frontend gitea-ssh" "$HAPROXY_CFG"; then
            cat >> "$HAPROXY_CFG" <<'GITEASSH'

frontend gitea-ssh
    bind *:2222
    mode tcp
    option tcplog
    timeout client 1h
    default_backend gitea_ssh

backend gitea_ssh
    mode tcp
    option tcp-check
    timeout server 1h
    server gitea_lxc 10.100.0.40:2222 check
GITEASSH
        fi
        if haproxy -f "$HAPROXY_CFG" -c >/dev/null 2>&1; then
            systemctl reload haproxy || true
        else
            echo "secubox-gitea: haproxy -c failed after ACL install — rolling back" >&2
            latest_bak=$(ls -t "$HAPROXY_CFG.bak.gitea-postinst."* 2>/dev/null | head -1)
            if [ -n "$latest_bak" ]; then cp "$latest_bak" "$HAPROXY_CFG"; fi
        fi
    fi
    # --- end Gitea routing install ---

    # #1791 : le SSH de gitea (2222) au LAN et au maillage seulement. La table
    # nft `inet secubox_gitea_ssh` jette, AVANT toute traduction, les paquets
    # vers 2222 d'une source ni locale, ni privée reliée, ni du maillage — que
    # 2222 passe par le frontal HAProxy ou par une DNAT posée à la main.
    # restart : une mise à jour recharge la table du nouveau script. Le
    # service de mise à jour est lancé une fois pour armer son minuteur.
    systemctl daemon-reload || true
    systemctl enable secubox-gitea-ssh-garde.service secubox-gitea-ssh-garde-maj.timer >/dev/null 2>&1 || true
    systemctl restart secubox-gitea-ssh-garde.service \
        || echo "secubox-gitea: garde du SSH 2222 non chargée — journalctl -u secubox-gitea-ssh-garde" >&2
    systemctl start secubox-gitea-ssh-garde-maj.timer secubox-gitea-ssh-garde-maj.service || true
fi
# ROUTE SBXWAF — DÉCLARÉE PAR CE PAQUET (#1739), comme son vhost et son unité.
# HAProxy envoie gitea.<domaine> à l'inspection (waf_bypass = false) ; sans cette
# route, sbxwaf ne connaît pas le nom et son fourre-tout répondait 401 au lieu
# du service — et le relais du maillage n'exposait pas le gitea des nœuds relayés.
# Le nom de CETTE box (#1723) ; le vhost écoute sur 9080.
if [ "$1" = configure ] && command -v secubox-waf-route >/dev/null 2>&1; then
    secubox-waf-route "$(secubox-domaine gitea 2>/dev/null || true)" 9080 || true
fi

#DEBHELPER#
exit 0
