[Unit]
Description=SecuBox Gitea reaper — periodic sweep (stuck git serve-clone)

[Timer]
# #3355 : décalage aléatoire stable par box (FixedRandomDelay), pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=75s
FixedRandomDelay=true
OnBootSec=300
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=300
OnUnitActiveSec=300
AccuracySec=30s

[Install]
WantedBy=timers.target
