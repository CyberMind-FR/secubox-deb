[Unit]
Description=SecuBox Gitea — réveil toutes les 4 h pour la synchronisation des miroirs (#3747)

[Timer]
OnCalendar=*-*-* 00/4:17:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
