#!/bin/sh
set -e

case "$1" in
    configure)
        # Create config directory
        mkdir -p /etc/secubox

        # Create run directory
        mkdir -p /run/secubox

        # Tor hidden-service PARENT dir. _tor_add_sync writes
        # `HiddenServiceDir /var/lib/tor/hidden_services/<name>` into torrc, but
        # tor only creates the LEAF dir — if the parent is missing tor errors
        # "No such file or directory" AND fails to load its whole config
        # (breaking the egress; found live in Tor Phase-1 e2e). Create it owned
        # by debian-tor (so tor can make the leaf) and setgid + group-traversable
        # so secubox-tor (SupplementaryGroups=debian-tor) can discover .onions.
        if getent passwd debian-tor >/dev/null 2>&1; then
            mkdir -p /var/lib/tor/hidden_services
            chown debian-tor:debian-tor /var/lib/tor/hidden_services
            chmod 2750 /var/lib/tor/hidden_services
        fi

        # Enable and start service
        systemctl daemon-reload
        systemctl enable secubox-exposure.service
        systemctl start secubox-exposure.service || true

        # tor-enhancement-phase1 (FINAL-REVIEW packaging fix): enable the
        # boot-time Tor hidden-service persist reconciler (oneshot, runs on
        # every boot via multi-user.target). Idempotent / no-op until a
        # service is actually emancipated with active=true.
        systemctl enable secubox-exposure-tor-reconcile.service || true

        # ONIONS (#3112, #3123) : Tor livrait a nginx :9080 (webui) ou a http-in :80 (vhosts, metablogizer) en
        # direct, sans nettoyage des en-tetes, et nginx prenait chaque visiteur Tor (127.0.0.1) pour un poste du
        # LAN. Migration, sur les seules box qui ont un service onion, idempotente :
        #   1. le frontal onion-in (127.0.0.1:9180) doit exister dans le haproxy.cfg vivant : sinon regeneration
        #      sure (validation, rechargement, retour arriere) ;
        #   2. la cible de chaque service onion est reecrite SUR PLACE vers ce frontal (meme HiddenServiceDir :
        #      meme cle, meme adresse), la route sbxwaf de l'onion du webui posee, Tor recharge ; tout onion
        #      restant hors du frontal est signale sur stderr et dans le journal d'audit.
        # Si la regeneration echoue, les onions restent FERMES (et non ouverts vers nginx) jusqu'a haproxyctl
        # generate.
        if grep -qs '^[[:space:]]*HiddenServicePort' /etc/tor/torrc /etc/tor/torrc.d/*.conf \
                /etc/tor/secubox-metablogizer.d/*.conf; then
            if [ -f /etc/haproxy/haproxy.cfg ] && ! grep -q '^frontend onion-in$' /etc/haproxy/haproxy.cfg \
               && [ -x /usr/local/bin/secubox-haproxy-regen-safe ]; then
                /usr/local/bin/secubox-haproxy-regen-safe \
                    || echo "exposure : ERREUR regeneration HAProxy — onions fermes jusqu'a 'haproxyctl generate' (#3112)" >&2
            fi
            /usr/sbin/secubox-exposure-tor-reconcile postinst \
                || echo "exposure : ERREUR migration des services onion (#3112)" >&2
        fi
        # Le demon en service doit charger la nouvelle garde de /tor/add et la cible du frontal : sans cela,
        # « Publier » reecrirait 127.0.0.1:9080 jusqu'au prochain redemarrage (#3112).
        systemctl try-restart secubox-exposure.service || true
        ;;
esac


exit 0
