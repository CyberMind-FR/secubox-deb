#!/bin/sh
set -e

case "$1" in
    configure)
        # Create config directory
        mkdir -p /etc/secubox

        # Create run directory
        mkdir -p /run/secubox

        # Tor hidden-service PARENT dir. _tor_add_sync writes
        # `HiddenServiceDir /var/lib/tor/hidden_services/<name>` into torrc, but
        # tor only creates the LEAF dir — if the parent is missing tor errors
        # "No such file or directory" AND fails to load its whole config
        # (breaking the egress; found live in Tor Phase-1 e2e). Create it owned
        # by debian-tor (so tor can make the leaf) and setgid + group-traversable
        # so secubox-tor (SupplementaryGroups=debian-tor) can discover .onions.
        if getent passwd debian-tor >/dev/null 2>&1; then
            mkdir -p /var/lib/tor/hidden_services
            chown debian-tor:debian-tor /var/lib/tor/hidden_services
            chmod 2750 /var/lib/tor/hidden_services
        fi

        # Enable and start service
        systemctl daemon-reload
        systemctl enable secubox-exposure.service
        systemctl start secubox-exposure.service || true

        # tor-enhancement-phase1 (FINAL-REVIEW packaging fix): enable the
        # boot-time Tor hidden-service persist reconciler (oneshot, runs on
        # every boot via multi-user.target). Idempotent / no-op until a
        # service is actually emancipated with active=true.
        systemctl enable secubox-exposure-tor-reconcile.service || true

        # ONION DU WEBUI (#3112) : Tor livrait a nginx :9080 en direct, hors HAProxy et hors sbxwaf, et nginx
        # prenait chaque visiteur Tor (127.0.0.1) pour un poste du LAN. Migration, sur les seules box qui ont
        # cet onion, idempotente :
        #   1. le frontal onion-webui (127.0.0.1:9180) doit exister dans le haproxy.cfg vivant : sinon
        #      regeneration sure (validation, rechargement, retour arriere) ;
        #   2. la cible du service onion est reecrite vers ce frontal (meme HiddenServiceDir : meme cle, meme
        #      adresse), la route sbxwaf <onion> posee, Tor recharge.
        # Si la regeneration echoue, l'onion reste FERME (et non ouvert vers nginx) jusqu'a haproxyctl generate.
        if [ -e /var/lib/tor/hidden_services/webui ]; then
            if [ -f /etc/haproxy/haproxy.cfg ] && ! grep -q '^frontend onion-webui$' /etc/haproxy/haproxy.cfg \
               && [ -x /usr/local/bin/secubox-haproxy-regen-safe ]; then
                /usr/local/bin/secubox-haproxy-regen-safe \
                    || echo "exposure : regeneration HAProxy en echec — onion du webui ferme jusqu'a 'haproxyctl generate' (#3112)" >&2
            fi
            /usr/sbin/secubox-exposure-tor-reconcile \
                || echo "exposure : migration de l'onion du webui en echec (#3112)" >&2
        fi
        ;;
esac


exit 0
