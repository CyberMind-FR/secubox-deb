#!/usr/bin/make -f
%:
	dh $@

# /usr/local/bin admin-only tools (issue #44): dh_usrlocal only knows how to
# rehome directories (Policy 9.1.2), not individual files — it errors out
# with "<file> is not a directory" on our regen-safe + render-nginx-webui
# scripts. The deliberate placement under /usr/local/bin is the intended
# behaviour; we just need debhelper to leave the path alone.
override_dh_usrlocal:

override_dh_auto_install:
	# Hook de deploiement certbot (#1019). Sans lui, HAProxy sert des copies que
	# le renouvellement ne met jamais a jour : trois certificats sur six
	# divergeaient sur gk2, dont un qui serait tombe alors qu'une version valide
	# dormait deja sur le disque.
	install -d debian/secubox-haproxy/etc/letsencrypt/renewal-hooks/deploy
	install -m 0755 letsencrypt-hooks/secubox-haproxy debian/secubox-haproxy/etc/letsencrypt/renewal-hooks/deploy/secubox-haproxy
	install -d debian/secubox-haproxy/usr/lib/secubox/haproxy/
	cp -r api debian/secubox-haproxy/usr/lib/secubox/haproxy/
	install -d debian/secubox-haproxy/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-haproxy/usr/share/secubox/www/ || true
	install -d debian/secubox-haproxy/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-haproxy/usr/share/secubox/menu.d/ || true
	# Smart self-healing HAProxy error pages (#626) — wired via errorfile in
	# haproxyctl. Own dir (NOT /etc/haproxy/errors, which the haproxy package owns).
	install -d debian/secubox-haproxy/etc/haproxy/secubox-errors
	[ -d errors ] && install -m 644 errors/*.http debian/secubox-haproxy/etc/haproxy/secubox-errors/ || true
	# Modular nginx config
	install -d debian/secubox-haproxy/etc/nginx/secubox.d
	[ -f nginx/haproxy.conf ] && cp nginx/haproxy.conf debian/secubox-haproxy/etc/nginx/secubox.d/ || true
	# Install control scripts (system-wide admin tools)
	install -d debian/secubox-haproxy/usr/sbin
	[ -d sbin ] && find sbin -maxdepth 1 -type f ! -name 'secubox-render-nginx-webui' \
	    ! -name 'secubox-haproxy-regen-safe' \
	    -exec install -m 755 {} debian/secubox-haproxy/usr/sbin/ \; || true
	# Install local admin tools (issue #44 — kept in /usr/local/bin for admin-only invocation)
	install -d debian/secubox-haproxy/usr/local/bin
	[ -f sbin/secubox-render-nginx-webui ] && \
	    install -m 755 sbin/secubox-render-nginx-webui debian/secubox-haproxy/usr/local/bin/ || true
	[ -f sbin/secubox-haproxy-regen-safe ] && \
	    install -m 755 sbin/secubox-haproxy-regen-safe debian/secubox-haproxy/usr/local/bin/ || true
	# Composant absorbé : vhost (#2050)
	install -d debian/secubox-haproxy/usr/lib/secubox/vhost/
	cp -r composants/vhost/api debian/secubox-haproxy/usr/lib/secubox/vhost/
	install -d debian/secubox-haproxy/usr/share/secubox/www
	[ -d composants/vhost/www ] && cp -r composants/vhost/www/. debian/secubox-haproxy/usr/share/secubox/www/ || true
	install -d debian/secubox-haproxy/usr/share/secubox/menu.d
	[ -d composants/vhost/menu.d ] && cp -r composants/vhost/menu.d/. debian/secubox-haproxy/usr/share/secubox/menu.d/ || true
	# Control script
	install -d debian/secubox-haproxy/usr/sbin
	[ -d composants/vhost/sbin ] && install -m 755 composants/vhost/sbin/* debian/secubox-haproxy/usr/sbin/ || true
	# Modular composants/vhost/nginx composants/vhost/config
	install -d debian/secubox-haproxy/etc/nginx/secubox.d
	[ -f composants/vhost/nginx/vhost.conf ] && cp composants/vhost/nginx/vhost.conf debian/secubox-haproxy/etc/nginx/secubox.d/ || true
	install -D -m 755 composants/vhost/debian/postinst debian/secubox-haproxy/usr/lib/secubox/haproxy/maintscripts/vhost.postinst
	install -D -m 755 composants/vhost/debian/prerm debian/secubox-haproxy/usr/lib/secubox/haproxy/maintscripts/vhost.prerm
	install -D -m 644 composants/vhost/debian/secubox-vhost.service debian/secubox-haproxy/usr/lib/systemd/system/secubox-vhost.service
	# Composant absorbé : exposure (#2050)
	install -d $(CURDIR)/debian/secubox-haproxy/usr/lib/secubox/exposure/api
	install -m 644 composants/exposure/api/*.py $(CURDIR)/debian/secubox-haproxy/usr/lib/secubox/exposure/api/
	install -d $(CURDIR)/debian/secubox-haproxy/usr/share/secubox/www/exposure
	install -m 644 composants/exposure/www/exposure/*.html $(CURDIR)/debian/secubox-haproxy/usr/share/secubox/www/exposure/
	install -d $(CURDIR)/debian/secubox-haproxy/usr/lib/systemd/system
	install -m 644 composants/exposure/debian/secubox-exposure.service $(CURDIR)/debian/secubox-haproxy/usr/lib/systemd/system/
	install -d $(CURDIR)/debian/secubox-haproxy/usr/share/secubox/menu.d
	install -m 644 composants/exposure/menu.d/*.json $(CURDIR)/debian/secubox-haproxy/usr/share/secubox/menu.d/
	# Install composants/exposure/nginx composants/exposure/config
	install -d $(CURDIR)/debian/secubox-haproxy/etc/nginx/secubox.d
	install -m 644 composants/exposure/nginx/exposure.conf $(CURDIR)/debian/secubox-haproxy/etc/nginx/secubox.d/exposure.conf
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d $(CURDIR)/debian/secubox-haproxy/etc/nginx/secubox-routes.d
	install -m 644 composants/exposure/nginx/exposure.conf $(CURDIR)/debian/secubox-haproxy/etc/nginx/secubox-routes.d/exposure.conf
	# Install exposure snippet directory and default snippet
	install -d debian/secubox-haproxy/etc/nginx/snippets/exposure
	install -m 644 composants/exposure/conf/nginx-exposure-default.conf \
	   debian/secubox-haproxy/etc/nginx/snippets/exposure/default.conf
	# tor-enhancement-phase1 (FINAL-REVIEW packaging fix): boot-time Tor
	# hidden-service persist reconciler (root composants/exposure/sbin script + oneshot unit).
	# Without these, tor_reconcile_persist() never runs on boot and an
	# emancipated .onion doesn't survive a torrc reset / fresh image flash.
	install -d $(CURDIR)/debian/secubox-haproxy/usr/sbin
	install -m 755 composants/exposure/sbin/secubox-exposure-tor-reconcile \
	   $(CURDIR)/debian/secubox-haproxy/usr/sbin/secubox-exposure-tor-reconcile
	install -m 644 composants/exposure/systemd/secubox-exposure-tor-reconcile.service \
	   $(CURDIR)/debian/secubox-haproxy/usr/lib/systemd/system/
	install -D -m 755 composants/exposure/debian/postinst debian/secubox-haproxy/usr/lib/secubox/haproxy/maintscripts/exposure.postinst
	install -D -m 755 composants/exposure/debian/prerm debian/secubox-haproxy/usr/lib/secubox/haproxy/maintscripts/exposure.prerm
	install -D -m 644 composants/exposure/debian/secubox-exposure.service debian/secubox-haproxy/usr/lib/systemd/system/secubox-exposure.service

