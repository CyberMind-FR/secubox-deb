# Leurres de messagerie de sbx-authwatch (#3924), secubox-toolbox-ng ≥ 0.20.0.
#
# Pendant l'arrêt du conteneur de courrier, la table `ip secubox_leurres_mail`
# (tenue par authwatch) redirige 25, 465, 587, 993 et 995 vers des ports locaux.
# Sous la base en `policy drop`, une box dont le WAN n'est pas de confiance les
# jetterait : ces ports locaux sont acceptés, et SEULEMENT quand la connexion y
# arrive par cette redirection (port d'origine = port de messagerie, DNAT posé).
# Un accès direct reste refusé, et sans redirection rien n'écoute derrière.
#
# La base saute vers cette chaîne ; le fichier ne fait que la remplir, après l'avoir vidée : le recharger ne double rien
# (créer, vider, remplir). Avec une base plus ancienne, la chaîne existe sans être consultée. Posé par
# secubox-fragment-leurres, qui valide l'ensemble de /etc/nftables.conf et l'écarte (.rejete) s'il le fait refuser.
table inet filter {
	chain leurres_mail {
	}
}
flush chain inet filter leurres_mail
table inet filter {
	chain leurres_mail {
		meta nfproto ipv4 tcp dport { 18025, 18465, 18587, 18993, 18995 } ct status dnat ct original proto-dst { 25, 465, 587, 993, 995 } accept comment "leurres de messagerie, par redirection seulement (#3924)"
	}
}
