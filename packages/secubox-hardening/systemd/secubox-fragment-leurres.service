[Unit]
Description=SecuBox — validation du fragment nftables des leurres de messagerie (#3924)
# Seulement si la postinst n'a rien pu valider (chroot d'image). Avant nftables : pris dès ce démarrage.
ConditionPathExists=/etc/nftables.d/secubox-leurres-mail.nft.non-verifie
DefaultDependencies=no
After=local-fs.target
Before=nftables.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
# root : nft -c (netlink, CAP_NET_ADMIN) et écriture dans /etc/nftables.d seulement.
ExecStart=/usr/sbin/secubox-fragment-leurres
TimeoutStartSec=60
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/nftables.d
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
UMask=0027

[Install]
WantedBy=sysinit.target
