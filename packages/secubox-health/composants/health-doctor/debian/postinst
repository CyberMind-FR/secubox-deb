#!/bin/bash
set -e

case "$1" in
  configure)
    install -d -o secubox -g secubox -m 755 /var/cache/secubox
    systemctl daemon-reload
    # API daemon + periodic timer
    systemctl enable --now secubox-health-doctor.service || true
    systemctl enable --now secubox-health-doctor-runner.timer || true
    # Bouton « Réparer » (#3628) : dossier de demandes (tmpfiles) + unité root qui le draine.
    # Jamais `restart` du .service : il peut être en train de terminer ce dpkg même.
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/secubox-reparer.conf || true
    systemctl enable --now secubox-reparer.path || true
    ;;
esac

