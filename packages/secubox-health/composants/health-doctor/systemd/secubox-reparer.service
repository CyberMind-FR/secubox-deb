[Unit]
Description=SecuBox Santé : réparation d'un service en panne (#3628)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3628

[Service]
Type=oneshot
# Root : reset-failed et démarrage d'une unité, et reprise d'un dpkg interrompu. La liste est
# fermée par le ctl (unité secubox-* chargée ET en échec). Aucun délai : un dpkg coupé est pire.
TimeoutStartSec=infinity
StateDirectory=secubox-health-reparer
StateDirectoryMode=0755
ExecStart=/usr/sbin/secubox-reparerctl process-ops
