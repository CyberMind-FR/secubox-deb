#!/bin/sh
set -e
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/health/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "health : postinst de $(basename "$_s") en échec" >&2; }
done
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/health/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "health : postinst de $(basename "$_s") en échec" >&2; }
done
#DEBHELPER#
exit 0
