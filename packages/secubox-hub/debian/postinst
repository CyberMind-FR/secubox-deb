#!/bin/bash
set -e
case "$1" in
  configure)
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home \
        --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    install -d -o root -g root -m 1777 /run/secubox
    install -d -o secubox -g secubox -m 755 /var/lib/secubox
    systemctl daemon-reload
    # Le standalone secubox-hub.service (:8001) est un VESTIGE : le module
    # `hub` est servi par secubox-aggregator (aggregator.toml) et la route
    # nginx pointe sur aggregator.sock. On ne l'active plus, et on l'arrête
    # s'il tourne encore d'une installation precedente — sinon un second
    # uvicorn charge la meme app pour personne.
    systemctl disable --now secubox-hub.service 2>/dev/null || true
    # …à condition d'y être DÉCLARÉ. Seul gk2 l'était (à la main) : sur une box
    # neuve, /api/v1/hub/ répondait 404 et plus rien n'écrivait menu.json —
    # le Hall restait vide (vu sur gk3, #1544). Déclaration unique, idempotente.
    if [ -f /etc/secubox/aggregator.toml ] && python3 - <<'TOML'
import pathlib, re, sys
f = pathlib.Path("/etc/secubox/aggregator.toml")
s = f.read_text()
if '"hub"' in s:
    sys.exit(1)
s2 = re.sub(r'modules\s*=\s*\[', 'modules = [\n    "hub",', s, count=1)
if s2 == s:
    sys.exit(1)
f.write_text(s2)
TOML
    then
      echo "secubox-hub : déclaré dans aggregator.toml"
      systemctl try-restart secubox-aggregator.service 2>/dev/null || true
    fi
    install -d -m 755 /etc/nginx/secubox.d
    # #3189 : fragments de la géo $lan_client (LAN du mode routeur de netmodes), inclus par secubox-lan-geo.conf.
    install -d -o root -g root -m 0755 /etc/nginx/secubox-lan-geo.d
    # Le include d'un bloc geo n'accepte pas de joker : le fichier doit exister (vide), sinon nginx -t échoue.
    [ -e /etc/nginx/secubox-lan-geo.d/netmodes-lan.conf ] || install -m 0644 /dev/null /etc/nginx/secubox-lan-geo.d/netmodes-lan.conf
    # Activer le vhost du panneau s'il ne l'est pas déjà (idempotent, et
    # jamais forcé : un lien existant vers autre chose est respecté).
    if [ -f /etc/nginx/sites-available/webui.conf ] && \
       [ ! -e /etc/nginx/sites-enabled/webui.conf ]; then
      ln -s ../sites-available/webui.conf /etc/nginx/sites-enabled/webui.conf
    fi
    # #1754 : fichier des relais de confiance AVANT le rechargement ci-dessous, sinon
    # nginx ne ferait plus confiance à personne (adresse de la box pour tous) jusqu'au
    # prochain passage du minuteur. Ne recharge pas lui-même ici : le reload qui suit s'en charge.
    if [ -x /usr/sbin/secubox-realip ]; then
      SECUBOX_REALIP_NORELOAD=1 /usr/sbin/secubox-realip || true
    fi
    # VERDICT LAN POUR TOUTE L'API (#2743). Le fichier GeoIP (`$lan_client`) vient d'ICI ; la directive qui le transmet à l'API vit dans snippets/secubox-proxy.conf (core).
    # core ne la pose que si `$lan_client` existe à ce moment-là : sur une image neuve core est configuré AVANT hub, `nginx -t` échoue, la ligne est retirée, et rien ne la remet.
    # Sans elle l'API croit tout client « WAN » et exige le second facteur même depuis le LAN (#1699). On la pose donc ici, SI le fichier GeoIP existe, et on retire si `nginx -t`
    # refuse (une variable inconnue casserait TOUTE la configuration). LE GARDE RECONNAÎT LA DIRECTIVE, PAS LA CHAÎNE (#1351) : le commentaire qui documente la ligne contient son nom.
    _snip="${SECUBOX_PROXY_SNIPPET:-/etc/nginx/snippets/secubox-proxy.conf}"
    _geo="${SECUBOX_LAN_GEO:-/etc/nginx/conf.d/secubox-lan-geo.conf}"
    if [ -f "$_geo" ] && [ -f "$_snip" ] && ! grep -qE '^[[:space:]]*proxy_set_header[[:space:]]+X-SecuBox-LAN' "$_snip"; then
      cp -a "$_snip" "$_snip.sbxbak"
      printf 'proxy_set_header   X-SecuBox-LAN     $lan_client;\n' >> "$_snip"
      if nginx -t >/dev/null 2>&1; then
        rm -f "$_snip.sbxbak"
      else
        mv -f "$_snip.sbxbak" "$_snip"
        echo "secubox-hub: \$lan_client refusé par nginx -t — verdict LAN non posé, le second facteur restera exigé partout" >&2
      fi
    fi
    # `nginx -t` AVANT tout rechargement : une configuration invalide passée à
    # un reload laisse nginx sur l'ancienne sans le dire, et le défaut ne
    # surgit qu'au redémarrage suivant — c'est-à-dire au pire moment.
    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx 2>/dev/null || true
    else
      echo "secubox-hub: nginx -t échoue — rechargement NON effectué" >&2
    fi
    # #758 — deploy + load the network-stats input policy-drop tap
    if [ -f /usr/share/secubox/hub/nftables.d/zz-secubox-netstats-tap.nft ]; then
        install -d -m 0755 /etc/nftables.d
        install -m 0644 /usr/share/secubox/hub/nftables.d/zz-secubox-netstats-tap.nft \
            /etc/nftables.d/zz-secubox-netstats-tap.nft
        # La sonde SEULE, et seulement si elle manque. JAMAIS `systemctl reload
        # nftables` : il rejoue `flush ruleset` et efface toutes les tables
        # posées à chaud — bans, NAC, et sur les box qui n'incluent pas
        # nftables.d (issues de l'image) TOUS les dropins. Constaté sur gk3 le
        # 2026-09-30 : 9 tables → 4 à l'installation du paquet (#1777, #1721).
        # Sans chaîne `inet filter input` (pare-feu secubox_filter), rien à faire.
        if nft list chain inet filter input >/dev/null 2>&1 \
           && ! nft list chain inet filter input 2>/dev/null | grep -q "sbx-netstats-input-policy-tap"; then
            /usr/sbin/nft -f /etc/nftables.d/zz-secubox-netstats-tap.nft 2>/dev/null || true
        fi
    fi
    # #2240 — sonde du capteur pare-feu (ensembles + règles additives). Même prudence que ci-dessus : JAMAIS de reload de nftables ; chargée seulement si
    # l'ensemble manque (sinon les règles se dupliqueraient à chaque mise à jour), et seulement si la chaîne d'entrée existe.
    if [ -f /usr/share/secubox/hub/nftables.d/zz-secubox-scan-tap.nft ]; then
        install -d -m 0755 /etc/nftables.d
        install -m 0644 /usr/share/secubox/hub/nftables.d/zz-secubox-scan-tap.nft \
            /etc/nftables.d/zz-secubox-scan-tap.nft
        if nft list chain inet filter input >/dev/null 2>&1 \
           && ! nft list set inet filter sbx_scan_seen4 >/dev/null 2>&1; then
            /usr/sbin/nft -f /etc/nftables.d/zz-secubox-scan-tap.nft 2>/dev/null || true
        fi
    fi
    # #758 — enable the collector timer (idempotent)
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now secubox-netstats.timer 2>/dev/null || true

    # ROUTE SBXWAF — POSEE PAR CE PAQUET (#1323), comme son vhost et son unite.
    # Sans elle, sbxwaf recoit un nom qu'il ne connait pas et rend 421, meme
    # si HAProxy dirige bien et que nginx sert bien. Cette table n'appartenait
    # a aucun paquet : 275 routes posees a la main, invisibles tant qu'elles
    # tiennent, fatales le jour ou l'une saute (vu sur podcaster).
    # L'outil vient de secubox-core, dont ce paquet depend deja ; le garde
    # `command -v` couvre l'ordre de configuration a la premiere installation.
    if command -v secubox-waf-route >/dev/null 2>&1; then
      secubox-waf-route "$(secubox-domaine admin)" 9080 || true
    fi

    ;;
esac
#DEBHELPER#
