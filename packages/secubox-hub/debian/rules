#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-hub/usr/lib/secubox/hub/
	cp -r api debian/secubox-hub/usr/lib/secubox/hub/
	install -d debian/secubox-hub/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-hub/usr/share/secubox/www/ || true
	install -d debian/secubox-hub/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-hub/usr/share/secubox/menu.d/ || true
	# Modular nginx config
	install -d debian/secubox-hub/etc/nginx/secubox.d
	[ -f nginx/hub.conf ] && cp nginx/hub.conf debian/secubox-hub/etc/nginx/secubox.d/ || true
	# Nginx snippets (shared CORS config)
	install -d debian/secubox-hub/etc/nginx/snippets
	[ -d nginx/snippets ] && cp -r nginx/snippets/. debian/secubox-hub/etc/nginx/snippets/ || true
