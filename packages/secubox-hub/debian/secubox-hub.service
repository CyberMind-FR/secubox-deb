[Unit]
Description=SecuBox Hub — Dashboard Central API
After=network.target secubox-core.service secubox-runtime.service
Wants=secubox-core.service secubox-runtime.service

# /run/secubox N'EST PAS UN RuntimeDirectory (#1022).
#
# Il est PARTAGE par une centaine de modules. `RuntimeDirectory=` est concu pour
# un repertoire PROPRE a un service : systemd le recree a chaque demarrage avec
# le mode de l'unite, donc le dernier service demarre imposait le sien. Huit
# unites le posaient en 0755, ce qui privait tous les autres du droit d'y creer
# leur socket — « bind: permission denied », et un 502 dont la cause etait le
# redemarrage d'un module sans rapport, survenu entre-temps.
#
# Le meme mecanisme effacait le repertoire a l'arret d'un service, emportant les
# sockets des quatre-vingt-dix autres.
#
# Il est desormais declare une seule fois, en 1777, par le tmpfiles.d de
# secubox-core — un seul proprietaire, une seule verite.
[Service]
UMask=0002
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/hub
# Ensure /run/secubox exists before starting (fallback if secubox-core didn't run)
# + prefix runs as root regardless of User= setting.
# #494: do NOT chown/chmod the parent here — it is owned by tmpfiles.d
# (1777 root root) + secubox-runtime.service. This ExecStartPre ran on every
# hub (re)start and clobbered it back to 775 secubox:secubox, breaking
# cross-user socket traversal (nginx/www-data 502). The sticky 1777 parent
# already lets the hub create its own socket; only mkdir as a fallback.
ExecStartPre=+/bin/mkdir -p /run/secubox
# TCP binding for VM compatibility (Unix socket has issues in some VMs)
ExecStart=/usr/bin/python3 -m uvicorn api.main:app \
    --host 127.0.0.1 --port 8001 \
    --log-level warning
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
LogsDirectory=secubox
LogsDirectoryMode=0755
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox /var/log/secubox

[Install]
WantedBy=multi-user.target
