[Unit]
Description=SecuBox nftables cache populator timer (every 30s)
Documentation=https://secubox.in/docs/soc

[Timer]
# #3355 : décalage aléatoire stable par box (FixedRandomDelay), pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=7s
FixedRandomDelay=true
OnBootSec=10s
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=10s
OnUnitActiveSec=30s
AccuracySec=5s
Unit=secubox-nft-cache.service

[Install]
WantedBy=timers.target
