#
# #2240 — sonde du capteur PARE-FEU d'Actor Intelligence. Inscrit, pour chaque paquet qui tombe jusqu'à la politique par défaut (DROP) de la chaîne
# `inet filter input`, le couple (adresse source, port visé) dans un ensemble à durée de vie de 10 minutes. sbxwaf (--scan-sensor) relit cet
# ensemble et en déduit les balayages de ports (≥ 8 ports distincts depuis une même adresse).
# ADDITIF SEULEMENT, comme zz-secubox-netstats-tap.nft : les ensembles s'ajoutent à la table existante sans la remplacer, les règles sont ajoutées
# APRÈS toutes les règles d'acceptation. Elles ne bloquent ni n'acceptent rien. Le préfixe zz- les fait charger en dernier. Taille bornée
# (65 536 couples par famille) : une inondation ne peut pas faire grossir la mémoire du noyau, l'ensemble plein cesse simplement d'enregistrer.
table inet filter {
    set sbx_scan_seen4 { type ipv4_addr . inet_service; flags timeout; timeout 10m; size 65536; }
    set sbx_scan_seen6 { type ipv6_addr . inet_service; flags timeout; timeout 10m; size 65536; }
}
add rule inet filter input meta l4proto { tcp, udp } add @sbx_scan_seen4 { ip saddr . th dport } comment "sbx-scan-tap4"
add rule inet filter input meta l4proto { tcp, udp } add @sbx_scan_seen6 { ip6 saddr . th dport } comment "sbx-scan-tap6"
