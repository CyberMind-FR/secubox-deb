#!/bin/sh
set -e

case "$1" in
    configure)
        # #2447 : l'API est servie par l'agrégateur ; l'ancien démon (maquette, lancé en root) n'existe plus.
        # Une mise à jour depuis une version antérieure le retire proprement ; ses données et sa CA ne sont pas touchées.
        if [ -n "$2" ]; then
            systemctl disable --now secubox-interceptor.service >/dev/null 2>&1 || true
            rm -f /usr/lib/systemd/system/secubox-interceptor.service /etc/systemd/system/multi-user.target.wants/secubox-interceptor.service
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi

        # Instantané des niveaux par pair et des exclusions du Toolbox (dossier fermé au compte de l'agrégateur)
        install -d -m 0755 -o secubox -g secubox /var/lib/secubox/interceptor
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable secubox-interceptor-snapshot.timer >/dev/null 2>&1 || true
        systemctl start secubox-interceptor-snapshot.timer >/dev/null 2>&1 || true
        systemctl start secubox-interceptor-snapshot.service >/dev/null 2>&1 || true
        ;;
esac

#DEBHELPER#

exit 0
