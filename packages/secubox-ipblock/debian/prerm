#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
    systemctl stop secubox-ipblock.service || true
    systemctl disable secubox-ipblock.service || true

    # Remove nftables table
    nft delete table inet ipblock 2>/dev/null || true

    # Remove nginx config
    rm -f /etc/nginx/secubox.d/ipblock.conf
    nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null || true
fi
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/ipblock/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "ipblock : prerm de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/ipblock/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "ipblock : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
