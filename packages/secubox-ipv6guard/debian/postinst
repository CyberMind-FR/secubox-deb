#!/bin/sh
set -e
case "$1" in
  configure)
    getent group secubox >/dev/null || addgroup --system secubox >/dev/null
    id -u secubox-ipv6guard >/dev/null 2>&1 || \
      adduser --system --ingroup secubox --no-create-home --home /nonexistent \
        --shell /usr/sbin/nologin secubox-ipv6guard >/dev/null
    # #3411 : activation HORS du test systemd — dans le chroot d'une image il est faux et l'unite restait
    # desactivee sur la box flashee ; deb-systemd-helper travaille sur le systeme de fichiers. Le demarrage reste conditionne.
    # Motif debhelper : un disable manuel de l'operateur survit a la mise a jour.
    for _u in secubox-ipv6guard.service; do
      if deb-systemd-helper --quiet was-enabled "$_u"; then
        deb-systemd-helper enable "$_u" >/dev/null || true
      else
        deb-systemd-helper update-state "$_u" >/dev/null || true
      fi
    done
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      # try-restart : une mise à jour recharge le code sans démarrer ce que l'opérateur a arrêté ; un premier démarrage se fait.
      if systemctl is-active --quiet secubox-ipv6guard.service; then
        systemctl try-restart secubox-ipv6guard.service || true
      else
        systemctl start secubox-ipv6guard.service || true
      fi
      if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
        systemctl reload nginx >/dev/null 2>&1 || true
      fi
    fi
    ;;
esac
#DEBHELPER#
exit 0
