#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-ipv6guard/usr/lib/secubox/ipv6guard/api
	install -m 644 api/*.py debian/secubox-ipv6guard/usr/lib/secubox/ipv6guard/api/
	# Route AUSSI dans secubox-routes.d/ : c'est le seul répertoire que le vhost principal inclut (#989).
	install -D -m 644 registre.d/ipv6guard.json debian/secubox-ipv6guard/usr/share/secubox/registre.d/ipv6guard.json
	install -d debian/secubox-ipv6guard/etc/nginx/secubox-routes.d
	install -m 644 nginx/ipv6guard.conf debian/secubox-ipv6guard/etc/nginx/secubox-routes.d/ipv6guard.conf
	install -d debian/secubox-ipv6guard/lib/systemd/system
	install -m 644 systemd/secubox-ipv6guard.service debian/secubox-ipv6guard/lib/systemd/system/

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
