[Unit]
# Only start if explicitly enabled (backend installed)
ConditionPathExists=/etc/secubox/jabber/enabled
Description=SecuBox Jabber API
After=network.target secubox-core.service

[Service]
Type=simple
User=root
WorkingDirectory=/usr/lib/secubox/jabber
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/jabber.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/jabber.sock --log-level warning
UMask=0117
Restart=on-failure

[Install]
WantedBy=multi-user.target
