# SecuBox-Deb :: Jellyfin — periodic playback-policy reconciliation schedule.
[Unit]
Description=SecuBox Jellyfin — periodic playback policy reconciliation

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
RandomizedDelaySec=30s
Persistent=true

[Install]
WantedBy=timers.target
