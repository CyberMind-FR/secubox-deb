# SecuBox-Deb :: jellyfinctl
# CyberMind — https://cybermind.fr
#
# Jellyfin host-side controller. Jellyfin runs NATIVELY in an unprivileged
# Debian LXC (default 10.100.0.170 on br-lxc, jellyfin.service inside the
# container, HTTP on :8096). The host nginx vhost proxies the public hostname
# to <LXC_IP>:8096.
#
# Partner auto-wire: detect sibling SecuBox media services by presence of their
# host media dir and RO-bind them into the Jellyfin LXC as virtual folders.
#
# Every verb emits JSON on stdout. Delegated to by the FastAPI host api
# (WebUI-delegates-to-confined-ctl). Conventions mirror lyrionctl/peertubectl.

set -euo pipefail

readonly MODULE="jellyfin"
readonly VERSION="2.0.0"
readonly CONFIG_FILE="${SECUBOX_JELLYFIN_CONFIG:-/etc/secubox/jellyfin.toml}"
readonly INSTALL_LIB="${SECUBOX_INSTALL_LIB:-/usr/share/secubox/lib/jellyfin/install-lxc.sh}"
readonly STATE_DIR="${SECUBOX_JELLYFIN_STATE_DIR:-/etc/secubox/jellyfin}"
readonly LIBRARIES_JSON="${SECUBOX_JELLYFIN_LIBRARIES:-$STATE_DIR/libraries.json}"
readonly SECRETS_DIR="${SECUBOX_SECRETS_DIR:-/etc/secubox/secrets}"
readonly APIKEY_FILE="${SECUBOX_JELLYFIN_APIKEY:-$SECRETS_DIR/jellyfin-apikey}"

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

log()  { printf '%b[jellyfin]%b %s\n' "$GREEN" "$NC" "$*" >&2; }
warn() { printf '%b[warn]%b %s\n'     "$YELLOW" "$NC" "$*" >&2; }
err()  { printf '%b[error]%b %s\n'    "$RED"    "$NC" "$*" >&2; }

# ── TOML config (best-effort, grep-style — same as lyrionctl/peertubectl) ─────
# Flat scalar read: greps the FIRST matching key anywhere in the file. Fine for
# keys that occur once; section-aware reads use toml_get_sec() below.
config_get() {
    local key="$1" default="${2:-}" raw=""
    if [ -f "$CONFIG_FILE" ]; then
        raw=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1)
    fi
    if [ -z "$raw" ]; then echo "$default"; return; fi
    local val
    val=$(echo "$raw" | cut -d= -f2- | sed 's/[[:space:]]*#.*$//' \
        | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | tr -d '"' | tr -d "'")
    [ -z "$val" ] && echo "$default" || echo "$val"
}

# toml_get <file> <key> <default> — flat scalar read from an ARBITRARY file.
toml_get() {
    local file="$1" key="$2" default="${3:-}" raw=""
    [ -f "$file" ] && raw=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$file" 2>/dev/null | head -1)
    if [ -z "$raw" ]; then echo "$default"; return; fi
    local val
    val=$(echo "$raw" | cut -d= -f2- | sed 's/[[:space:]]*#.*$//' \
        | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | tr -d '"' | tr -d "'")
    [ -z "$val" ] && echo "$default" || echo "$val"
}

# toml_get_sec <file> <section> <key> <default> — section-aware scalar read.
# Needed for lyrion.toml where `path` occurs under BOTH [lxc] and [library].
toml_get_sec() {
    local file="$1" section="$2" key="$3" default="${4:-}"
    if [ ! -f "$file" ]; then echo "$default"; return; fi
    local val
    val=$(awk -v section="$section" -v key="$key" '
        /^[[:space:]]*\[/ { s=$0; gsub(/[][[:space:]]/,"",s); cur=s; next }
        cur==section {
            line=$0; k=line; sub(/=.*/,"",k); gsub(/[[:space:]]/,"",k)
            if (k==key) {
                v=line; sub(/^[^=]*=/,"",v); sub(/#.*/,"",v)
                gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); gsub(/["'\''"]/,"",v)
                print v; exit
            }
        }' "$file" 2>/dev/null || true)
    [ -z "$val" ] && echo "$default" || echo "$val"
}

LXC_NAME=$(config_get "name" "jellyfin")
LXC_IP=$(config_get "ip" "10.100.0.170")
LXC_PATH=$(config_get "path" "/data/lxc")
PORT=$(config_get "http_port" "8096")
PUBLIC_HOSTNAME=$(config_get "public_hostname" "jellyfin.gk2.secubox.in")

readonly JELLYFIN_URL="http://${LXC_IP}:${PORT}"

# ── LXC helpers ───────────────────────────────────────────────────────────────
lxc_state() {
    lxc-info -n "$LXC_NAME" -P "$LXC_PATH" 2>/dev/null \
        | awk -F: '/^State:/ { gsub(/ /,"",$2); print tolower($2) }' || true
}
lxc_running() { [ "$(lxc_state)" = "running" ]; }
svc() { lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl "$@" jellyfin.service; }

# ── Jellyfin API helpers ──────────────────────────────────────────────────────
_apikey() { [ -s "$APIKEY_FILE" ] && cat "$APIKEY_FILE" 2>/dev/null || true; }

# collectionType for the Jellyfin virtual folder, derived from partner kind.
# Jellyfin groups photos under "homevideos" (there is no pure photos type).
_kind_ct() {
    case "${1:-}" in
        photos)   echo "homevideos" ;;
        music)    echo "music" ;;
        files)    echo "movies" ;;
        torrents) echo "movies" ;;
        videos)   echo "movies" ;;
        *)        echo "mixed" ;;
    esac
}

# _jf_add_library <name> <collectionType> <container_path>
_jf_add_library() {
    local name="${1:-}" ct="${2:-}" path="${3:-}" key
    [ -n "$name" ] && [ -n "$path" ] || return 1
    key=$(_apikey)
    [ -n "$key" ] || { warn "no jellyfin api key ($APIKEY_FILE); virtual folder for '$name' NOT created"; return 1; }
    lxc_running || { warn "jellyfin not running; virtual folder for '$name' deferred to next scan"; return 1; }
    curl -fsS --max-time 20 -X POST \
        -H "X-Emby-Token: $key" -H "Content-Type: application/json" \
        "${JELLYFIN_URL}/Library/VirtualFolders?name=${name}&collectionType=${ct}&refreshLibrary=true" \
        -d "{\"LibraryOptions\":{\"PathInfos\":[{\"Path\":\"${path}\"}]}}" >/dev/null 2>&1 || return 1
}

# _jf_del_library <name>
_jf_del_library() {
    local name="${1:-}" key
    [ -n "$name" ] || return 1
    key=$(_apikey)
    [ -n "$key" ] || return 1
    lxc_running || return 1
    curl -fsS --max-time 20 -X DELETE \
        -H "X-Emby-Token: $key" \
        "${JELLYFIN_URL}/Library/VirtualFolders?name=${name}" >/dev/null 2>&1 || return 1
}

# ── libraries.json store (wired-partners state) ───────────────────────────────
_ensure_lib_store() {
    [ -d "$STATE_DIR" ] || install -d -m 0755 "$STATE_DIR" 2>/dev/null || mkdir -p "$STATE_DIR"
    [ -f "$LIBRARIES_JSON" ] || printf '{"libraries":[]}\n' > "$LIBRARIES_JSON"
}

_lib_count() {
    if [ -f "$LIBRARIES_JSON" ]; then
        jq '(.libraries // []) | length' "$LIBRARIES_JSON" 2>/dev/null || echo 0
    else
        echo 0
    fi
}

_partner_wired() {
    _ensure_lib_store
    if jq --arg n "$1" -e '(.libraries // []) | any(.name == $n)' "$LIBRARIES_JSON" >/dev/null 2>&1; then
        echo true
    else
        echo false
    fi
}

# _record_lib <name> <container_path> <host_path> <kind> <collectionType>
_record_lib() {
    local name="${1:-}" path="${2:-}" host="${3:-}" kind="${4:-}" ct="${5:-}" tmp
    [ -n "$name" ] || return 1
    _ensure_lib_store
    tmp=$(mktemp)
    jq --arg n "$name" --arg p "$path" --arg h "$host" --arg k "$kind" --arg c "$ct" \
        '.libraries = ((.libraries // []) | map(select(.name != $n))
                        + [{name:$n, path:$p, host_path:$h, kind:$k, collectionType:$c}])' \
        "$LIBRARIES_JSON" > "$tmp" && mv -f "$tmp" "$LIBRARIES_JSON" || { rm -f "$tmp"; return 1; }
}

_drop_lib() {
    local name="${1:-}" tmp
    [ -n "$name" ] || return 1
    _ensure_lib_store
    tmp=$(mktemp)
    jq --arg n "$name" '.libraries = ((.libraries // []) | map(select(.name != $n)))' \
        "$LIBRARIES_JSON" > "$tmp" && mv -f "$tmp" "$LIBRARIES_JSON" || { rm -f "$tmp"; return 1; }
}

# ── LXC bind + live-mount helpers (RO ONLY) ───────────────────────────────────
_lxc_config() { echo "$LXC_PATH/$LXC_NAME/config"; }

# _add_bind <host_path> <name> — idempotent RO bind entry in the LXC config.
_add_bind() {
    local host="${1:-}" name="${2:-}" cfg
    [ -n "$host" ] && [ -n "$name" ] || { err "_add_bind: missing host/name"; return 1; }
    cfg=$(_lxc_config)
    [ -f "$cfg" ] || { err "LXC config not found: $cfg (provision the LXC first)"; return 1; }
    grep -qF " media/${name} none bind" "$cfg" && return 0
    printf 'lxc.mount.entry = %s media/%s none bind,ro,create=dir 0 0\n' "$host" "$name" >> "$cfg"
}

_remove_bind() {
    local name="${1:-}" cfg
    [ -n "$name" ] || return 0
    cfg=$(_lxc_config)
    [ -f "$cfg" ] || return 0
    sed -i "\# media/${name} none bind#d" "$cfg" 2>/dev/null || true
}

# _live_mount <host_path> <name> — best-effort RO bind into the running rootfs
# so no restart is needed. Durable across boots via the config bind entry.
_live_mount() {
    local host="${1:-}" name="${2:-}"
    [ -n "$host" ] && [ -n "$name" ] || return 0
    local target="$LXC_PATH/$LXC_NAME/rootfs/media/$name"
    mkdir -p "$target" 2>/dev/null || true
    if ! mountpoint -q "$target" 2>/dev/null; then
        mount --bind "$host" "$target" 2>/dev/null || return 0
        mount -o remount,ro,bind "$target" 2>/dev/null || true
    fi
}

_live_umount() {
    local name="${1:-}"
    [ -n "$name" ] || return 0
    local target="$LXC_PATH/$LXC_NAME/rootfs/media/$name"
    mountpoint -q "$target" 2>/dev/null && umount "$target" 2>/dev/null || true
}

# ── Partner registry ──────────────────────────────────────────────────────────
readonly PARTNERS="photoprism nextcloud torrent lyrion peertube podcaster"

_partner_kind() {
    case "${1:-}" in
        photoprism) echo "photos" ;;
        nextcloud)  echo "files" ;;
        torrent)    echo "torrents" ;;
        lyrion)     echo "music" ;;
        peertube)   echo "videos" ;;
        podcaster)  echo "music" ;;
        *)          echo "" ;;
    esac
}

# _partner_media_path <name> — host media dir for the RO bind.
# Reads the real path from each module's TOML, falls back to a documented default.
_partner_media_path() {
    case "${1:-}" in
        photoprism)
            toml_get /etc/secubox/photoprism.toml originals "/data/shared/photos"
            ;;
        nextcloud)
            local d
            d=$(toml_get /etc/secubox/nextcloud.toml data_dir "")
            [ -z "$d" ] && d=$(toml_get /etc/secubox/nextcloud.toml data_path "")
            if [ -n "$d" ]; then
                [ -d "$d/data" ] && echo "$d/data" || echo "$d"
            else
                echo "/data/volumes/nextcloud/data"
            fi
            ;;
        torrent)
            toml_get /etc/secubox/torrent.toml download_dir "/data/torrent"
            ;;
        lyrion)
            toml_get_sec /etc/secubox/lyrion.toml library path "/data/music"
            ;;
        peertube)
            # PeerTube stores its web-optimised videos under storage/web-videos
            # (older layouts used storage/videos). Prefer an explicit key in
            # peertube.toml, then a storage base, else the confirmed host default.
            local v base
            v=$(toml_get /etc/secubox/peertube.toml videos "")
            [ -z "$v" ] && v=$(toml_get /etc/secubox/peertube.toml videos_dir "")
            if [ -n "$v" ]; then echo "$v"; return; fi
            base=$(toml_get /etc/secubox/peertube.toml storage "")
            [ -z "$base" ] && base=$(toml_get /etc/secubox/peertube.toml storage_dir "")
            if [ -z "$base" ]; then base="/data/peertube/storage"; fi
            base="${base%/}"
            # web-videos is the current PeerTube layout; fall back to videos.
            if [ -d "$base/web-videos" ]; then echo "$base/web-videos"
            elif [ -d "$base/videos" ]; then echo "$base/videos"
            else echo "$base/web-videos"; fi
            ;;
        podcaster)
            # podcaster.toml's media_path is /var/lib/secubox/podcaster/media,
            # which is a SYMLINK to the SSD (/data/secubox/podcaster/media) —
            # the eMMC cannot hold the episodes. An LXC bind entry must name the
            # real directory: a symlink source is not resolved by lxc.mount.entry
            # and the mount fails (or silently follows a stale target after a
            # package reinstall recreates the link). Resolve it here.
            local m
            m=$(toml_get /etc/secubox/podcaster.toml media_path "/var/lib/secubox/podcaster/media")
            [ -e "$m" ] && m=$(readlink -f "$m" 2>/dev/null || echo "$m")
            echo "$m"
            ;;
        *)
            echo ""
            ;;
    esac
}

_partner_present() {
    local name="${1:-}"
    if [ "$name" = "peertube" ]; then
        # PeerTube present when its on-disk storage root exists on the host.
        [ -d /data/peertube/storage ] && echo true || echo false
    else
        local mp; mp=$(_partner_media_path "$name")
        { [ -n "$mp" ] && [ -d "$mp" ]; } && echo true || echo false
    fi
}

# ── Verbs ─────────────────────────────────────────────────────────────────────
cmd_status() {
    local st reachable=false version=null sessions=null libs
    st=$(lxc_running && echo running || echo stopped)

    local info="" wizard=false
    if info=$(curl -fsS --max-time 5 "${JELLYFIN_URL}/System/Info/Public" 2>/dev/null); then
        reachable=true
        # API returns camelCase (.version/.startupWizardCompleted); tolerate both.
        version=$(printf '%s' "$info" | jq -c '.Version // .version // null' 2>/dev/null || echo null)
        wizard=$(printf '%s' "$info" | jq -c '(.StartupWizardCompleted // .startupWizardCompleted) // false' 2>/dev/null || echo false)
    fi

    local key; key=$(_apikey)
    if [ "$reachable" = true ] && [ -n "$key" ]; then
        local s=""
        s=$(curl -fsS --max-time 5 -H "X-Emby-Token: $key" "${JELLYFIN_URL}/Sessions" 2>/dev/null || true)
        if [ -n "$s" ]; then
            sessions=$(printf '%s' "$s" | jq -c 'if type=="array" then length else null end' 2>/dev/null || echo null)
        fi
    fi

    libs=$(_lib_count)

    jq -nc \
        --arg st "$st" \
        --argjson reachable "$reachable" \
        --argjson port "$PORT" \
        --argjson version "${version:-null}" \
        --argjson libraries "${libs:-0}" \
        --argjson sessions "${sessions:-null}" \
        --argjson wizard "${wizard:-false}" \
        '{status:"ok", lxc_state:$st, jellyfin_reachable:$reachable, port:$port,
          version:$version, libraries:$libraries, sessions:$sessions,
          startup_wizard_completed:$wizard, setup_required:($reachable and ($wizard|not))}'
}

cmd_start() {
    local ok=false state
    lxc_running || lxc-start -n "$LXC_NAME" -P "$LXC_PATH" 2>/dev/null || true
    if svc start >/dev/null 2>&1; then ok=true; fi
    state=$(svc is-active 2>/dev/null || true)
    jq -nc --argjson ok "$ok" --arg s "${state:-unknown}" '{ok:$ok, state:$s}'
}

cmd_stop() {
    local ok=false state
    if lxc_running; then
        svc stop >/dev/null 2>&1 && ok=true || ok=false
        state=$(svc is-active 2>/dev/null || true)
    else
        ok=true; state="lxc-stopped"
    fi
    jq -nc --argjson ok "$ok" --arg s "${state:-unknown}" '{ok:$ok, state:$s}'
}

cmd_restart() {
    local ok=false state
    lxc_running || lxc-start -n "$LXC_NAME" -P "$LXC_PATH" 2>/dev/null || true
    if svc restart >/dev/null 2>&1; then ok=true; fi
    state=$(svc is-active 2>/dev/null || true)
    jq -nc --argjson ok "$ok" --arg s "${state:-unknown}" '{ok:$ok, state:$s}'
}

cmd_library_status() {
    _ensure_lib_store
    jq -c '{libraries: [ (.libraries // [])[] | {name:.name, path:.path, kind:.kind} ]}' \
        "$LIBRARIES_JSON" 2>/dev/null || echo '{"libraries":[]}'
}

cmd_library_scan() {
    local ok=false key
    key=$(_apikey)
    if [ -n "$key" ] && lxc_running \
        && curl -fsS --max-time 20 -X POST -H "X-Emby-Token: $key" \
            "${JELLYFIN_URL}/Library/Refresh" >/dev/null 2>&1; then
        ok=true
    fi
    jq -nc --argjson ok "$ok" '{ok:$ok}'
}

cmd_partner_list() {
    _ensure_lib_store
    local arr='[]' p kind present mp wired obj
    for p in $PARTNERS; do
        kind=$(_partner_kind "$p")
        present=$(_partner_present "$p")
        wired=$(_partner_wired "$p")
        mp=$(_partner_media_path "$p")
        obj=$(jq -nc \
            --arg name "$p" \
            --argjson present "$present" \
            --arg media "$mp" \
            --arg kind "$kind" \
            --argjson wired "$wired" \
            '{name:$name, present:$present,
              media_path:(if $media=="" then null else $media end),
              kind:$kind, wired:$wired}')
        arr=$(jq -nc --argjson a "$arr" --argjson o "$obj" '$a + [$o]')
    done
    jq -nc --argjson a "$arr" '{partners:$a}'
}

# _json_arr <elem...> — JSON array from bash args (empty -> []).
_json_arr() {
    if [ "$#" -eq 0 ]; then printf '[]'; return; fi
    printf '%s\n' "$@" | jq -R . | jq -sc .
}

cmd_partner_wire() {
    local target="${1:-}"
    [ -n "$target" ] || { err "usage: jellyfinctl partner wire <name>|--all"; exit 1; }

    local list
    if [ "$target" = "--all" ]; then list="$PARTNERS"; else list="$target"; fi

    local wired=() skipped=() p kind mp ct
    for p in $list; do
        [ -n "$p" ] || continue
        kind=$(_partner_kind "$p")
        if [ -z "$kind" ]; then warn "unknown partner: $p"; skipped+=("$p"); continue; fi
        mp=$(_partner_media_path "$p")
        if [ -z "$mp" ] || [ ! -d "$mp" ]; then
            warn "partner '$p' media dir absent (${mp:-none}) — skipping"
            skipped+=("$p"); continue
        fi
        if ! _add_bind "$mp" "$p"; then skipped+=("$p"); continue; fi
        lxc_running && _live_mount "$mp" "$p" || true
        ct=$(_kind_ct "$kind")
        _jf_add_library "$p" "$ct" "/media/$p" || warn "virtual folder for '$p' not created (recorded anyway)"
        _record_lib "$p" "/media/$p" "$mp" "$kind" "$ct"
        wired+=("$p")
    done

    # NOTE: expand possibly-empty arrays with the ${arr[@]+…} guard so `set -u`
    # never trips on a zero-length array (e.g. `partner wire torrent` when the
    # torrent dir is absent leaves `wired` empty).
    local w_json s_json
    w_json=$(_json_arr "${wired[@]+"${wired[@]}"}")
    s_json=$(_json_arr "${skipped[@]+"${skipped[@]}"}")
    jq -nc --argjson wired "$w_json" --argjson skipped "$s_json" \
        '{ok:true, wired:$wired, skipped:$skipped}'
}

cmd_partner_unwire() {
    local name="${1:-}"
    [ -n "$name" ] || { err "usage: jellyfinctl partner unwire <name>"; exit 1; }
    _remove_bind "$name"
    lxc_running && _live_umount "$name" || true
    _jf_del_library "$name" || true
    _drop_lib "$name" || true
    jq -nc '{ok:true}'
}

# ── Playback policy (per-user transcoding toggle) ─────────────────────────────
# Declarative, NOT hardcoded: values come from [playback] in $CONFIG_FILE so
# re-enabling transcoding is an operator edit, not a script patch. Jellyfin
# stores this per USER (there is no server-wide default), so `playback apply`
# must walk every account and PUSH THE FULL Policy object back (a partial
# PATCH is not supported by /Users/{id}/Policy — only fields present in the
# body would survive, so we always read-modify-write the whole object).
#
# CAVEAT the operator must know: disabling transcoding is not "play worse" —
# a file the client cannot decode natively (wrong codec/profile/bit depth)
# will refuse to play at all instead of degrading through a software
# re-encode. Remuxing (container change only, no re-encode) is independent
# and cheap; it stays on by default.
_playback_video() { toml_get_sec "$CONFIG_FILE" playback allow_video_transcoding "false"; }
_playback_audio() { toml_get_sec "$CONFIG_FILE" playback allow_audio_transcoding "false"; }
_playback_remux() { toml_get_sec "$CONFIG_FILE" playback allow_remuxing "true"; }

# _bool_json <toml-scalar> — normalize to a JSON bool literal. Unrecognized
# input defaults to false (fail toward the CPU-protective setting, not
# toward silently re-enabling transcoding on a typo).
_bool_json() {
    case "${1:-}" in
        true|True|TRUE|1|yes|Yes) echo true ;;
        *) echo false ;;
    esac
}

# _jf_users <key> — GET /Users, or empty string on any failure (no api key,
# LXC stopped, unreachable). Callers must treat "" as "could not fetch".
_jf_users() {
    local key="$1"
    curl -fsS --max-time 10 -H "X-Emby-Token: $key" "${JELLYFIN_URL}/Users" 2>/dev/null || true
}

cmd_playback_status() {
    local key users vt at rm
    key=$(_apikey)
    [ -n "$key" ] || { jq -nc '{ok:false, reason:"no api key"}'; return 0; }
    lxc_running || { jq -nc '{ok:false, reason:"jellyfin not running"}'; return 0; }
    users=$(_jf_users "$key")
    [ -n "$users" ] || { jq -nc '{ok:false, reason:"jellyfin unreachable"}'; return 0; }

    vt=$(_bool_json "$(_playback_video)")
    at=$(_bool_json "$(_playback_audio)")
    rm=$(_bool_json "$(_playback_remux)")

    printf '%s' "$users" | jq -c \
        --argjson vt "$vt" --argjson at "$at" --argjson rm "$rm" \
        '{ok: true,
          desired: {video_transcoding:$vt, audio_transcoding:$at, remuxing:$rm},
          users: [ .[] | {
              id: .Id, name: .Name,
              video_transcoding: .Policy.EnableVideoPlaybackTranscoding,
              audio_transcoding: .Policy.EnableAudioPlaybackTranscoding,
              remuxing: .Policy.EnablePlaybackRemuxing,
              compliant: (.Policy.EnableVideoPlaybackTranscoding == $vt
                          and .Policy.EnableAudioPlaybackTranscoding == $at
                          and .Policy.EnablePlaybackRemuxing == $rm)
          } ] }
        | .all_compliant = ([ .users[].compliant ] | all)' \
        2>/dev/null || jq -nc '{ok:false, reason:"jellyfin returned unparsable /Users"}'
}

cmd_playback_apply() {
    local key users vt at rm
    key=$(_apikey)
    [ -n "$key" ] || { jq -nc '{ok:false, reason:"no api key"}'; return 0; }
    lxc_running || { jq -nc '{ok:false, reason:"jellyfin not running"}'; return 0; }
    users=$(_jf_users "$key")
    [ -n "$users" ] || { jq -nc '{ok:false, reason:"jellyfin unreachable"}'; return 0; }

    vt=$(_bool_json "$(_playback_video)")
    at=$(_bool_json "$(_playback_audio)")
    rm=$(_bool_json "$(_playback_remux)")

    local applied=() failed=() id name policy body
    while IFS=$'\t' read -r id name; do
        [ -n "$id" ] || continue
        policy=$(printf '%s' "$users" | jq -c --arg id "$id" '(.[] | select(.Id==$id) | .Policy) // empty' 2>/dev/null || true)
        if [ -z "$policy" ] || [ "$policy" = "null" ]; then failed+=("$name"); continue; fi
        body=$(printf '%s' "$policy" | jq -c \
            --argjson vt "$vt" --argjson at "$at" --argjson rm "$rm" \
            '.EnableVideoPlaybackTranscoding=$vt | .EnableAudioPlaybackTranscoding=$at | .EnablePlaybackRemuxing=$rm' 2>/dev/null || true)
        if [ -z "$body" ]; then failed+=("$name"); continue; fi
        # Full object PUT-via-POST — Jellyfin's /Users/{id}/Policy replaces the
        # whole policy, so a partial body would silently reset every other
        # field (parental controls, folder access, ...) to its zero value.
        if curl -fsS --max-time 15 -X POST \
            -H "X-Emby-Token: $key" -H "Content-Type: application/json" \
            "${JELLYFIN_URL}/Users/${id}/Policy" -d "$body" >/dev/null 2>&1; then
            applied+=("$name")
        else
            failed+=("$name")
        fi
    done < <(printf '%s' "$users" | jq -r '.[] | [.Id, .Name] | @tsv' 2>/dev/null || true)

    local a_json f_json
    a_json=$(_json_arr "${applied[@]+"${applied[@]}"}")
    f_json=$(_json_arr "${failed[@]+"${failed[@]}"}")
    jq -nc --argjson vt "$vt" --argjson at "$at" --argjson rm "$rm" \
        --argjson applied "$a_json" --argjson failed "$f_json" \
        '{ok: ($failed | length == 0),
          desired: {video_transcoding:$vt, audio_transcoding:$at, remuxing:$rm},
          applied:$applied, failed:$failed}'
}

# ── Upgrade (mirror peertubectl check-upgrade JSON exactly) ────────────────────
_jf_current() {
    local v
    v=$(lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- dpkg-query -W -f='${Version}' jellyfin-server 2>/dev/null || true)
    [ -z "$v" ] && v=$(lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- dpkg-query -W -f='${Version}' jellyfin 2>/dev/null || true)
    # strip debian revision (10.9.11-1 -> 10.9.11) for clean semver compare
    printf '%s' "${v%%-*}"
}
_jf_latest() {
    curl -s --max-time 10 https://api.github.com/repos/jellyfin/jellyfin/releases/latest 2>/dev/null \
        | jq -r '.tag_name // empty' 2>/dev/null | sed 's/^v//' || true
}

cmd_check_upgrade() {
    local cur latest available=false major=false
    cur=$(_jf_current); latest=$(_jf_latest)
    if [ -n "$latest" ] && [ -n "$cur" ] && [ "$latest" != "$cur" ]; then
        available=true; [ "${latest%%.*}" != "${cur%%.*}" ] && major=true
    fi
    printf '{"current":"%s","latest":"%s","available":%s,"major_jump":%s}\n' \
        "$cur" "${latest:-$cur}" "$available" "$major"
}

cmd_upgrade() {
    local cur latest; cur=$(_jf_current); latest=$(_jf_latest)
    if [ -z "$latest" ] || [ "$latest" = "$cur" ]; then
        jq -nc --arg c "$cur" '{ok:true, detail:"already up to date", current:$c}'; return 0
    fi
    if [ -n "$cur" ] && [ "${latest%%.*}" != "${cur%%.*}" ]; then
        jq -nc --arg c "$cur" --arg l "$latest" \
            '{ok:false, reason:"cross-major upgrade refused", current:$c, latest:$l}'; return 0
    fi
    if lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- bash -lc \
        'export DEBIAN_FRONTEND=noninteractive; apt-get update -q && apt-get install -y --only-upgrade jellyfin jellyfin-server jellyfin-web' >/dev/null 2>&1; then
        local now; now=$(_jf_current)
        jq -nc --arg c "$now" '{ok:true, detail:"upgraded", current:$c}'
    else
        jq -nc --arg c "$cur" '{ok:false, reason:"apt upgrade failed", current:$c}'
    fi
}

cmd_install() {
    if [ ! -f "$INSTALL_LIB" ]; then
        err "install script not found at $INSTALL_LIB (package not installed correctly?)"
        exit 2
    fi
    log "Running LXC bootstrap from $INSTALL_LIB ..."
    SECUBOX_LXC_NAME="$LXC_NAME" SECUBOX_LXC_IP="$LXC_IP" SECUBOX_LXC_PATH="$LXC_PATH" \
    SECUBOX_JELLYFIN_PORT="$PORT" \
        bash "$INSTALL_LIB"
    jq -nc '{ok:true}'
}

# Self-provision an API key WITHOUT any admin password, by inserting it straight
# into Jellyfin's ApiKeys table (the module owns the LXC as root — this is the
# point of a SecuBox module). Jellyfin caches keys in memory, so the service is
# bounced to pick it up. Used by install-lxc first-run as the robust fallback
# when the HTTP /Startup/* wizard flow can't mint one (Jellyfin 10.11 quirk).
cmd_apikey_mint() {
    local name="${1:-secubox}"
    local db="$LXC_PATH/$LXC_NAME/rootfs/var/lib/jellyfin/data/jellyfin.db"
    command -v sqlite3 >/dev/null 2>&1 || { err "sqlite3 not found on host"; exit 2; }
    [ -f "$db" ] || { err "jellyfin.db not found ($db) — LXC provisioned?"; exit 2; }
    local token now was_running=false
    token=$(openssl rand -hex 16)
    now=$(date -u +"%Y-%m-%d %H:%M:%S.0000000")
    lxc_running && was_running=true || true
    [ "$was_running" = true ] && lxc-attach -n "$LXC_NAME" -- systemctl stop jellyfin >/dev/null 2>&1 || true
    sleep 2
    if ! sqlite3 "$db" "DELETE FROM ApiKeys WHERE Name='$name'; INSERT INTO ApiKeys (DateCreated,DateLastActivity,Name,AccessToken) VALUES ('$now','$now','$name','$token');"; then
        err "sqlite insert failed"
        [ "$was_running" = true ] && lxc-attach -n "$LXC_NAME" -- systemctl start jellyfin >/dev/null 2>&1 || true
        exit 1
    fi
    ( umask 077; printf '%s' "$token" > "$APIKEY_FILE" )
    chown secubox-jellyfin:secubox-jellyfin "$APIKEY_FILE" 2>/dev/null || true
    chmod 600 "$APIKEY_FILE"
    [ "$was_running" = true ] && lxc-attach -n "$LXC_NAME" -- systemctl start jellyfin >/dev/null 2>&1 || true
    jq -nc --arg n "$name" '{ok:true, name:$n, minted:true}'
}

cmd_help() {
    cat <<EOF
jellyfinctl $VERSION — SecuBox Jellyfin (native-LXC) controller

Usage: jellyfinctl <verb> [args]   (every verb emits JSON on stdout)

  status                         LXC state + jellyfin health/version/sessions + lib count
  start | stop | restart         Control jellyfin.service inside the LXC
  library status                 List wired libraries (from libraries.json)
  library scan                   Trigger a Jellyfin library refresh (API)
  partner list                   Probe siblings (present/media_path/kind/wired)
  partner wire <name>|--all      RO-bind present partner media as a Jellyfin library
  partner unwire <name>          Remove the bind + virtual folder + state
  playback status                Per-user transcoding/remux policy vs. [playback] config
  playback apply                 Push [playback] policy onto every current user
  check-upgrade                  {current, latest, available, major_jump}
  upgrade                        apt-upgrade jellyfin in the LXC (refuses cross-major)
  apikey-mint [name]             Self-provision an API key via the Jellyfin DB (no
                                 admin password needed; root LXC control) — bounces jellyfin
  install                        Provision the LXC + install Jellyfin (idempotent)
  help                           This message

Config: $CONFIG_FILE  (name/ip/path/http_port/public_hostname)
LXC: $LXC_NAME @ $LXC_IP:$PORT on br-lxc — public https://$PUBLIC_HOSTNAME/
Partners RO-bound under /media/<name>; state in $LIBRARIES_JSON
EOF
}

# ── Dispatch (two-word verbs: library <sub>, partner <sub>) ───────────────────
main() {
    local noun="${1:-help}"; shift || true
    case "$noun" in
        status)  cmd_status "$@" ;;
        start)   cmd_start "$@" ;;
        stop)    cmd_stop "$@" ;;
        restart) cmd_restart "$@" ;;
        library)
            local sub="${1:-}"; shift || true
            case "$sub" in
                status) cmd_library_status "$@" ;;
                scan)   cmd_library_scan "$@" ;;
                *) err "usage: jellyfinctl library status|scan"; exit 1 ;;
            esac ;;
        partner)
            local sub="${1:-}"; shift || true
            case "$sub" in
                list)   cmd_partner_list "$@" ;;
                wire)   cmd_partner_wire "$@" ;;
                unwire) cmd_partner_unwire "$@" ;;
                *) err "usage: jellyfinctl partner list|wire <name>|unwire <name>"; exit 1 ;;
            esac ;;
        playback)
            local psub="${1:-}"; shift || true
            case "$psub" in
                status) cmd_playback_status "$@" ;;
                apply)  cmd_playback_apply "$@" ;;
                *) err "usage: jellyfinctl playback status|apply"; exit 1 ;;
            esac ;;
        check-upgrade) cmd_check_upgrade "$@" ;;
        upgrade)       cmd_upgrade "$@" ;;
        apikey-mint)   cmd_apikey_mint "$@" ;;
        install)       cmd_install "$@" ;;
        --version|-V)  echo "jellyfinctl $VERSION" ;;
        help|-h|--help|"") cmd_help ;;
        *) err "unknown verb: $noun"; cmd_help; exit 1 ;;
    esac
}

main "$@"
