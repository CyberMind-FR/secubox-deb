[Unit]
Description=SecuBox TURN API
After=network.target secubox-core.service
Wants=secubox-core.service

# /run/secubox N'EST PAS UN RuntimeDirectory (#1022) : partagé par une centaine de
# modules, déclaré une fois en 1777 par le tmpfiles.d de secubox-core.
[Service]
UMask=0002
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/turn
# La socket périmée est retirée par root (le répertoire est collé) : le `+` l'exécute malgré User=.
ExecStartPre=+/bin/rm -f /run/secubox/turn.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app \
    --uds /run/secubox/turn.sock \
    --log-level warning
Restart=on-failure
RestartSec=5

# #3060 : l'API ne touche ni coturn, ni systemd, ni /etc/turnserver.conf. Sa seule
# surface privilégiée est `sudo -n secubox-turnctl <verbe exact>` (sudoers/secubox-turn) :
# NoNewPrivileges=yes neutraliserait sudo (précédent autoload, antirootkit). Le reste du
# bac à sable reste : tmp privé, pas de /home, écriture limitée à son état et à la socket.
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/secubox /var/lib/secubox/turn /var/log/secubox

[Install]
WantedBy=multi-user.target
