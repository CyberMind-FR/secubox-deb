#!/bin/bash
set -e
case "$1" in
  remove|upgrade)
    # Remove nginx location config
    rm -f /etc/nginx/secubox.d/jitsi.conf
    # Reload nginx to remove location
    systemctl reload nginx 2>/dev/null || true
    ;;
esac
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/jitsi/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "jitsi : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
