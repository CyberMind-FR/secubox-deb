#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	# API files
	install -d debian/secubox-jitsi/usr/lib/secubox/jitsi/
	cp -r api debian/secubox-jitsi/usr/lib/secubox/jitsi/
	# Static www files
	install -d debian/secubox-jitsi/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-jitsi/usr/share/secubox/www/ || true
	# Menu definitions
	install -d debian/secubox-jitsi/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-jitsi/usr/share/secubox/menu.d/ || true
	# Modular nginx config
	install -d debian/secubox-jitsi/etc/nginx/secubox.d
	[ -f nginx/jitsi.conf ] && cp nginx/jitsi.conf debian/secubox-jitsi/etc/nginx/secubox.d/ || true
	# Systemd service
	install -d debian/secubox-jitsi/usr/lib/systemd/system
	# Confined root actuator — the module's single privileged surface.
	install -d debian/secubox-jitsi/usr/sbin
	install -m 755 sbin/jitsictl debian/secubox-jitsi/usr/sbin/
	# LXC provisioning library (run by the provision unit / `jitsictl install`).
	install -d debian/secubox-jitsi/usr/lib/secubox/jitsi
	install -m 755 lib/jitsi/install-lxc.sh debian/secubox-jitsi/usr/lib/secubox/jitsi/
	install -d debian/secubox-jitsi/usr/share/secubox/lib/jitsi
	install -m 755 lib/jitsi/install-lxc.sh debian/secubox-jitsi/usr/share/secubox/lib/jitsi/
	# Scoped sudoers grant (secubox -> jitsictl).
	install -d debian/secubox-jitsi/etc/sudoers.d
	install -m 440 debian/secubox-jitsi.sudoers debian/secubox-jitsi/etc/sudoers.d/secubox-jitsi
	# Provisioning unit.
	install -m 644 debian/secubox-jitsi-provision.service debian/secubox-jitsi/usr/lib/systemd/system/
	# Example config + nftables drop-in (NOT applied automatically: it opens a
	# UDP port from the outside, see conf/jitsi.nft).
	install -d debian/secubox-jitsi/usr/share/doc/secubox-jitsi/examples
	install -m 644 conf/jitsi.toml.example debian/secubox-jitsi/usr/share/doc/secubox-jitsi/examples/
	install -m 644 conf/jitsi.nft debian/secubox-jitsi/usr/share/doc/secubox-jitsi/examples/
	# Public vhost served by the HOST nginx (packaged, not hand-written: a
	# hand-placed route vanishes on reinstall and nobody notices until it
	# breaks).
	install -d debian/secubox-jitsi/etc/nginx/sites-available
	install -m 644 nginx/jitsi-vhost.conf debian/secubox-jitsi/etc/nginx/sites-available/jitsi.conf
	# Composant absorbé : turn (#2050)
	# Install API
	install -d debian/secubox-jitsi/usr/lib/secubox/turn/
	cp -r composants/turn/api debian/secubox-jitsi/usr/lib/secubox/turn/
	# Install frontend
	install -d debian/secubox-jitsi/usr/share/secubox/www
	[ -d composants/turn/www ] && cp -r composants/turn/www/. debian/secubox-jitsi/usr/share/secubox/www/ || true
	# Install menu entry
	install -d debian/secubox-jitsi/usr/share/secubox/menu.d
	[ -d composants/turn/menu.d ] && cp -r composants/turn/menu.d/. debian/secubox-jitsi/usr/share/secubox/menu.d/ || true
	# Modular composants/turn/nginx composants/turn/config
	install -d debian/secubox-jitsi/etc/nginx/secubox.d
	[ -f composants/turn/nginx/turn.conf ] && cp composants/turn/nginx/turn.conf debian/secubox-jitsi/etc/nginx/secubox.d/ || true
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d debian/secubox-jitsi/etc/nginx/secubox-routes.d
	[ -f composants/turn/nginx/turn.conf ] && cp composants/turn/nginx/turn.conf debian/secubox-jitsi/etc/nginx/secubox-routes.d/ || true
	# Create composants/turn/data directories
	install -d debian/secubox-jitsi/var/lib/secubox/turn
	install -d debian/secubox-jitsi/var/log/turnserver
	install -D -m 755 composants/turn/debian/postinst debian/secubox-jitsi/usr/lib/secubox/jitsi/maintscripts/turn.postinst
	install -D -m 755 composants/turn/debian/prerm debian/secubox-jitsi/usr/lib/secubox/jitsi/maintscripts/turn.prerm
	install -D -m 644 composants/turn/debian/secubox-turn.service debian/secubox-jitsi/usr/lib/systemd/system/secubox-turn.service

# La seule unite est le provisionnement, que postinst active et lance en
# --no-block. Laisse a debhelper, elle etait RELANCEE de facon synchrone a
# chaque configure : dpkg attendait tout le telechargement du conteneur
# (jusqu'a 30 min, vecu sur amd64 neuf, #1497). Meme choix que jellyfin.
override_dh_installsystemd:
	# jitsi : rien d'automatique pour ses propres unités ; le composant turn garde
	# la gestion dh de son unité (redémarrage à la mise à jour, #2050).
	true
	dh_installsystemd --name=secubox-turn
