# SecuBox-Deb :: jitsictl
# CyberMind — https://cybermind.fr
#
# Jitsi Meet host-side controller. Jitsi runs NATIVELY in an unprivileged
# Debian LXC (default 10.100.0.190 on br-lxc): prosody + jicofo +
# jitsi-videobridge2 + an internal nginx serving the web app on :80. The host
# HAProxy vhost proxies the public hostname to <LXC_IP>:80.
#
# Every verb emits JSON on stdout. Delegated to by the FastAPI host api
# (WebUI-delegates-to-confined-ctl — the api never drives systemd or LXC
# itself). Conventions mirror jellyfinctl/lyrionctl.
#
# Supersedes the 1.0.0 module, whose FastAPI generated a docker-compose.yml and
# ran docker/podman directly from the request path.

set -euo pipefail

readonly MODULE="jitsi"
# Tenue en phase avec debian/changelog : un status qui annonce une version
# obsolete rend tout diagnostic a distance trompeur.
readonly VERSION="2.1.0"
readonly CONFIG_FILE="${SECUBOX_JITSI_CONFIG:-/etc/secubox/jitsi.toml}"
readonly INSTALL_LIB="${SECUBOX_INSTALL_LIB:-/usr/share/secubox/lib/jitsi/install-lxc.sh}"
readonly STATE_DIR="${SECUBOX_JITSI_STATE_DIR:-/etc/secubox/jitsi}"
readonly LXC_PATH="${SECUBOX_LXC_PATH:-/data/lxc}"

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

log()  { printf '%b[jitsi]%b %s\n'  "$GREEN"  "$NC" "$*" >&2; }
warn() { printf '%b[warn]%b %s\n'   "$YELLOW" "$NC" "$*" >&2; }
err()  { printf '%b[error]%b %s\n'  "$RED"    "$NC" "$*" >&2; }

# ── TOML config (flat scalar read — same shape as jellyfinctl) ───────────────
config_get() {
    local key="$1" default="${2:-}" raw=""
    if [ -f "$CONFIG_FILE" ]; then
        raw=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1)
    fi
    if [ -z "$raw" ]; then echo "$default"; return; fi
    local val
    val=$(echo "$raw" | cut -d= -f2- | sed 's/[[:space:]]*#.*$//' \
        | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | tr -d '"' | tr -d "'")
    [ -z "$val" ] && echo "$default" || echo "$val"
}

LXC_NAME="$(config_get lxc_name jitsi)"
LXC_IP="$(config_get lxc_ip 10.100.0.190)"
DOMAIN="$(config_get domain meet.gk2.secubox.in)"
JVB_PORT="$(config_get jvb_port 10000)"
WEB_PORT="$(config_get web_port 80)"

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

lxc_state() {
    lxc-info -n "$LXC_NAME" -P "$LXC_PATH" 2>/dev/null \
        | awk -F: '/^State:/ { gsub(/ /,"",$2); print tolower($2) }' || true
}

lxc_exists() { [ -d "$LXC_PATH/$LXC_NAME/rootfs" ]; }

# État d'une unité systemd À L'INTÉRIEUR du conteneur. Jamais `systemctl` nu :
# ces quatre services ne tournent pas sur l'hôte, et interroger l'hôte
# rapporterait « inactive » pour tout, ce qui se lit comme une panne alors que
# c'est une erreur de cible.
unit_state() {
    local unit="$1"
    [ "$(lxc_state)" = "running" ] || { printf 'container-down'; return; }
    lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- \
        systemctl is-active "$unit" 2>/dev/null | head -1 || printf 'unknown'
}

# ── status ───────────────────────────────────────────────────────────────────
#
# Les quatre services sont rapportés SÉPARÉMENT, et non agrégés en un booléen.
# Une visio Jitsi tombe en panne de façons qui se distinguent : prosody mort =
# personne ne se connecte ; jicofo mort = on se connecte mais aucune conférence
# ne se forme ; le videobridge mort = la conférence se forme et reste muette.
# Un unique « ok/ko » perdrait exactement l'information qui oriente le
# diagnostic.
cmd_status() {
    local state; state=$(lxc_state)
    local prosody jicofo jvb web public_ip
    prosody=$(unit_state prosody)
    jicofo=$(unit_state jicofo)
    jvb=$(unit_state jitsi-videobridge2)
    web=$(unit_state nginx)
    public_ip=""
    [ -s "$STATE_DIR/public-ip" ] && public_ip=$(cat "$STATE_DIR/public-ip")

    local reachable=false
    if [ "$state" = "running" ] && curl -fsS --max-time 5 -o /dev/null \
            "http://${LXC_IP}:${WEB_PORT}/" 2>/dev/null; then
        reachable=true
    fi

    cat <<EOF
{
  "module": "$MODULE",
  "version": "$VERSION",
  "installed": $(lxc_exists && echo true || echo false),
  "container": "$(json_escape "$state")",
  "domain": "$(json_escape "$DOMAIN")",
  "lxc_ip": "$(json_escape "$LXC_IP")",
  "web_reachable": $reachable,
  "services": {
    "prosody": "$(json_escape "$prosody")",
    "jicofo": "$(json_escape "$jicofo")",
    "videobridge": "$(json_escape "$jvb")",
    "web": "$(json_escape "$web")"
  },
  "media": {
    "udp_port": $JVB_PORT,
    "public_address": "$(json_escape "$public_ip")",
    "public_address_set": $([ -n "$public_ip" ] && echo true || echo false)
  }
}
EOF
}

# ── stats ────────────────────────────────────────────────────────────────────
#
# Le videobridge expose /colibri/stats sur son port privé (8080). C'est la
# SEULE source de données réelle du module : conférences en cours,
# participants, plus grosse conférence. Le module 1.0.0 l'atteignait par
# `docker exec ... curl localhost` ; ici le conteneur a une IP fixe sur le
# bridge, donc un appel direct suffit — pas de runtime de conteneur dans le
# chemin de lecture.
#
# Volontairement PAS d'endpoint « liste des salons » : Jitsi n'expose pas les
# noms de salons par colibri. Le module 1.0.0 en offrait un qui répondait
# « Room status not available via API » — une promesse d'API qui n'en était
# pas une. Mieux vaut ne pas l'exposer que l'exposer vide.
cmd_stats() {
    local raw=""
    if [ "$(lxc_state)" = "running" ]; then
        raw=$(curl -fsS --max-time 5 "http://${LXC_IP}:8080/colibri/stats" 2>/dev/null || true)
    fi
    if [ -z "$raw" ]; then
        echo '{"available": false, "conferences": 0, "participants": 0}'
        return 0
    fi
    printf '%s\n' "$raw"
}

cmd_start() {
    lxc_exists || { echo '{"success": false, "error": "not installed"}'; return 1; }
    if [ "$(lxc_state)" = "running" ]; then
        echo '{"success": true, "already": true}'
        return 0
    fi
    lxc-start -n "$LXC_NAME" -P "$LXC_PATH"
    echo '{"success": true}'
}

cmd_stop() {
    if [ "$(lxc_state)" != "running" ]; then
        echo '{"success": true, "already": true}'
        return 0
    fi
    lxc-stop -n "$LXC_NAME" -P "$LXC_PATH"
    echo '{"success": true}'
}

cmd_restart() {
    cmd_stop >/dev/null 2>&1 || true
    sleep 2
    cmd_start
}

# Redémarre les services Jitsi SANS redémarrer le conteneur : un redémarrage de
# conteneur coupe aussi les conférences en cours pour rien quand seul un
# service est en cause.
cmd_service_restart() {
    local unit="${1:-}"
    case "$unit" in
        prosody|jicofo|jitsi-videobridge2|nginx) ;;
        *)
            echo '{"success": false, "error": "unknown unit (prosody|jicofo|jitsi-videobridge2|nginx)"}'
            return 2
            ;;
    esac
    [ "$(lxc_state)" = "running" ] || { echo '{"success": false, "error": "container not running"}'; return 1; }
    lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl restart "$unit"
    echo "{\"success\": true, \"unit\": \"$(json_escape "$unit")\"}"
}

# ── set-public-ip ────────────────────────────────────────────────────────────
#
# L'adresse que le videobridge annonce aux pairs. Derrière deux NAT il ne peut
# pas la découvrir seul ; une valeur fausse produit la panne caractéristique
# « la conférence se forme puis reste muette ».
#
# Validée ici plutôt que supposée : cette valeur finit dans un fichier de
# configuration lu par un service, et une chaîne arbitraire y serait injectée
# telle quelle.
cmd_set_public_ip() {
    local ip="${1:-}"
    if ! printf '%s' "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        echo '{"success": false, "error": "not an IPv4 address"}'
        return 2
    fi
    local o
    for o in $(printf '%s' "$ip" | tr '.' ' '); do
        if [ "$o" -gt 255 ]; then
            echo '{"success": false, "error": "octet out of range"}'
            return 2
        fi
    done
    [ "$(lxc_state)" = "running" ] || { echo '{"success": false, "error": "container not running"}'; return 1; }

    install -d -m 0755 "$STATE_DIR"
    printf '%s\n' "$ip" > "$STATE_DIR/public-ip"
    lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- bash -c "
        # Créé s'il manque : jitsi-videobridge2 2.3 ne livre plus ce fichier
        # mais le lit toujours (SC_HOME_DIR_LOCATION/NAME dans son unité).
        props=/etc/jitsi/videobridge/sip-communicator.properties
        [ -d /etc/jitsi/videobridge ] || exit 3
        touch \"\$props\"
        sed -i '/NAT_HARVESTER_LOCAL_ADDRESS/d;/NAT_HARVESTER_PUBLIC_ADDRESS/d' \"\$props\"
        printf 'org.ice4j.ice.harvest.NAT_HARVESTER_LOCAL_ADDRESS=%s\n' '$LXC_IP' >> \"\$props\"
        printf 'org.ice4j.ice.harvest.NAT_HARVESTER_PUBLIC_ADDRESS=%s\n' '$ip' >> \"\$props\"
        systemctl restart jitsi-videobridge2
    " || { echo '{"success": false, "error": "videobridge config not found — is jitsi installed?"}'; return 1; }

    echo "{\"success\": true, \"public_address\": \"$(json_escape "$ip")\"}"
}

# ── media-expose ─────────────────────────────────────────────────────────────
#
# Installe (ou retire) la règle nft qui redirige UDP/10000 vers le conteneur.
#
# Pourquoi un verbe plutôt qu'un effet du postinst : ouvrir un port UDP entrant
# vers un service média est une décision d'exposition, pas un effet de bord
# d'un `apt install`. Mais la laisser à la main produit exactement la dérive
# que ce dépôt passe son temps à réparer — un fichier vivant sur la board,
# appartenant à aucun paquet, qui disparaît sans que personne le voie.
#
# Le contenu de la règle est donc EMPAQUETÉ (conf/jitsi.nft), et ce verbe ne
# fait que le déposer là où nftables le charge au démarrage. La décision reste
# explicite, le fichier reste traçable.
#
# Rappel utile : une seule règle suffit. Après DNAT en prerouting la
# destination n'est plus locale, le paquet emprunte FORWARD (policy accept) et
# ne traverse jamais INPUT — la politique drop de la chaîne input ne s'y
# applique pas.
readonly NFT_SRC="${SECUBOX_JITSI_NFT_SRC:-/usr/share/doc/secubox-jitsi/examples/jitsi.nft}"
readonly NFT_DST="${SECUBOX_JITSI_NFT_DST:-/etc/nftables.d/secubox-jitsi-dnat.nft}"

cmd_media_expose() {
    local action="${1:-}"
    case "$action" in
        --apply)
            [ -f "$NFT_SRC" ] || { echo "{\"success\": false, \"error\": \"règle absente: $NFT_SRC\"}"; return 1; }
            install -d -m 0755 "$(dirname "$NFT_DST")"
            install -m 0644 "$NFT_SRC" "$NFT_DST"
            # La table est SUPPRIMÉE avant rechargement : `nft -f` ajoute les
            # règles, il ne remplace pas la table. Sans ça, un second --apply
            # duplique la règle — mesuré, deux DNAT identiques empilées. Une
            # duplication de DNAT est inoffensive en soi (la première gagne),
            # mais elle rend le compteur illisible, et c'est justement le
            # compteur qui sert à diagnostiquer un média qui ne passe pas.
            nft delete table inet secubox-jitsi 2>/dev/null || true
            if nft -f "$NFT_DST" 2>/dev/null; then
                echo "{\"success\": true, \"applied\": \"$(json_escape "$NFT_DST")\", \"port\": $JVB_PORT}"
            else
                rm -f "$NFT_DST"
                echo '{"success": false, "error": "nft a refusé la règle — rien appliqué"}'
                return 1
            fi
            ;;
        --revoke)
            nft delete table inet secubox-jitsi 2>/dev/null || true
            rm -f "$NFT_DST"
            echo '{"success": true, "revoked": true}'
            ;;
        *)
            # Sans argument : rapporte l'état, ne change rien.
            local installed=false live=false
            [ -f "$NFT_DST" ] && installed=true
            nft list table inet secubox-jitsi >/dev/null 2>&1 && live=true
            cat <<EOF
{
  "file_installed": $installed,
  "rule_live": $live,
  "file": "$(json_escape "$NFT_DST")",
  "udp_port": $JVB_PORT,
  "hint": "jitsictl media-expose --apply | --revoke"
}
EOF
            ;;
    esac
}

cmd_install() {
    [ -x "$INSTALL_LIB" ] || { echo "{\"success\": false, \"error\": \"install lib missing: $INSTALL_LIB\"}"; return 1; }
    log "Provisioning Jitsi LXC (this pulls the official Jitsi apt repo) ..."
    if SECUBOX_LXC_NAME="$LXC_NAME" SECUBOX_LXC_IP="$LXC_IP" \
       SECUBOX_JITSI_DOMAIN="$DOMAIN" bash "$INSTALL_LIB"; then
        echo '{"success": true}'
    else
        echo '{"success": false, "error": "install-lxc.sh failed"}'
        return 1
    fi
}

cmd_logs() {
    local unit="${1:-jitsi-videobridge2}" lines="${2:-50}"
    case "$unit" in
        prosody|jicofo|jitsi-videobridge2|nginx) ;;
        *) echo '{"success": false, "error": "unknown unit"}'; return 2 ;;
    esac
    case "$lines" in ''|*[!0-9]*) lines=50 ;; esac
    [ "$(lxc_state)" = "running" ] || { echo '{"success": false, "error": "container not running"}'; return 1; }
    lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- \
        journalctl -u "$unit" -n "$lines" --no-pager 2>/dev/null || true
}

cmd_help() {
    cat <<EOF
jitsictl v$VERSION — Jitsi Meet (LXC-native)

  status                    État conteneur + les 4 services, séparément (JSON)
  stats                     Compteurs colibri du videobridge (conférences, participants)
  start | stop | restart    Cycle de vie du conteneur
  service-restart <unit>    Redémarre UN service sans toucher au conteneur
                            (prosody|jicofo|jitsi-videobridge2|nginx)
  set-public-ip <addr>      Adresse annoncée par le videobridge aux pairs
  install                   Provisionne le conteneur (idempotent)
  media-expose [--apply|--revoke]
                            Redirection UDP/10000 vers le conteneur. Sans
                            argument : rapporte l'etat sans rien changer.
  logs <unit> [lines]       Journal d'un service
EOF
}

case "${1:-help}" in
    status)           cmd_status ;;
    stats)            cmd_stats ;;
    start)            cmd_start ;;
    stop)             cmd_stop ;;
    restart)          cmd_restart ;;
    service-restart)  cmd_service_restart "${2:-}" ;;
    set-public-ip)    cmd_set_public_ip "${2:-}" ;;
    install)          cmd_install ;;
    media-expose)     cmd_media_expose "${2:-}" ;;
    logs)             cmd_logs "${2:-}" "${3:-}" ;;
    help|--help|-h)   cmd_help ;;
    *)                cmd_help; exit 1 ;;
esac
