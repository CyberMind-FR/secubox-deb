P = debian/secubox-kiosque

%:
	dh $@

override_dh_auto_install:
	install -d $(P)/usr/share/secubox/www/kiosque
	install -m 644 www/kiosque/* $(P)/usr/share/secubox/www/kiosque/
	install -D -m 644 nginx/kiosque.conf $(P)/etc/nginx/secubox-routes.d/kiosque.conf
