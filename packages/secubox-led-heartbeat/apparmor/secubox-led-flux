# Profil AppArmor ENFORCE du collecteur de la LED de supervision (#3361).
# Compte secubox-leds, aucune capacité ni socket réseau ; LIT les sources de mesures
# (dont /run/secubox-led-nft/nft.json, publié par secubox-led-nft), N'ÉCRIT que
# /run/secubox-leds/ et /var/lib/secubox-leds/. Aucun secret.
#
# Le profil s'applique à toutes les commandes de l'unité (AppArmorProfile=), donc
# aussi à ExecCondition=/usr/sbin/secubox-led-board.

#include <tunables/global>

profile secubox-led-flux /usr/sbin/secubox-led-flux {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>

  /usr/sbin/secubox-led-flux r,
  /usr/bin/python3* rix,

  # Garde secubox-led-board (ExecCondition)
  /usr/sbin/secubox-led-board rix,
  /usr/bin/env rix,
  /{,usr/}bin/bash rix,
  /{,usr/}bin/tr rix,
  /{,usr/}bin/grep rix,
  @{PROC}/device-tree/ r,
  @{PROC}/device-tree/** r,
  /sys/firmware/devicetree/** r,
  /sys/devices/**/name r,
  /sys/class/leds/ r,
  /sys/class/leds/** r,

  /usr/lib/python3/** r,
  /usr/lib/python3.*/** r,
  /usr/lib/secubox-led-heartbeat/ r,
  /usr/lib/secubox-led-heartbeat/** r,

  /etc/secubox/leds.toml r,
  deny /etc/secubox/secrets/** r,

  # Sources de mesures
  @{PROC}/net/dev r,
  @{PROC}/@{pid}/net/dev r,
  @{PROC}/sys/net/netfilter/nf_conntrack_count r,
  /var/cache/secubox/metrics-cache.json r,
  /var/cache/secubox/health-doctor.json r,
  /run/secubox/actord-mesures.json r,
  /var/lib/secubox/ad-guard/ r,
  /var/lib/secubox/ad-guard/ad-guard.db* rk,
  /run/secubox-led-nft/nft.json r,           # compteurs sbx_drop_* (secubox-led-nft, root)

  # Sorties
  /run/secubox-leds/ r,
  /run/secubox-leds/** rw,
  /var/lib/secubox-leds/ r,
  /var/lib/secubox-leds/** rw,
}
