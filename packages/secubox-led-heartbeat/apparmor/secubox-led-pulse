# Profil AppArmor ENFORCE du moteur d'affichage des LED MOCHAbin (#3290). Root
# (sysfs root:root) mais n'ÉCRIT que brightness et trigger des 9 canaux de la puce
# IS31FL3199 ; LIT /proc/stat, /proc/meminfo, leds.toml et les fichiers d'état des
# sources. Aucun shell, aucun autre exécutable, aucun réseau, aucun secret.

#include <tunables/global>

profile secubox-led-pulse /usr/sbin/secubox-led-pulse {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>      # pwd.getpwnam : propriétaires des fichiers d'état

  /usr/sbin/secubox-led-pulse r,
  /usr/bin/python3* rix,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /usr/lib/secubox-led-heartbeat/ r,
  /usr/lib/secubox-led-heartbeat/** r,

  /etc/secubox/leds.toml r,
  deny /etc/secubox/secrets/** r,

  @{PROC}/stat r,
  @{PROC}/meminfo r,

  # Sources par défaut de leds.toml ; une source ajoutée ailleurs reste « inconnue ».
  /var/cache/secubox/metrics-cache.json r,
  /var/lib/secubox/soc/alerts.json r,
  /run/secubox/soc.sock r,

  # Canaux de la puce : /sys/class/leds/<couleur>:led<n> pointe vers /sys/devices/.../leds/.
  /sys/class/leds/ r,
  /sys/class/leds/** r,
  /sys/devices/**/leds/{red,green,blue}:led[123]/ r,
  /sys/devices/**/leds/{red,green,blue}:led[123]/brightness rw,
  /sys/devices/**/leds/{red,green,blue}:led[123]/trigger rw,

  deny network,
}
