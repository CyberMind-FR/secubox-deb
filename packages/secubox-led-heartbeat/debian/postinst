#!/bin/bash
set -e

OVERLAY_SRC="/usr/share/secubox-led-heartbeat/secubox-leds.dts"
OVERLAY_DST="/boot/dtbs"

compile_overlay() {
    # Find kernel version directory
    local kver=$(uname -r 2>/dev/null || ls /lib/modules | head -1)
    local overlay_dir=""

    # Try various locations for overlay installation
    for dir in \
        "/boot/dtbs/${kver}/marvell/overlays" \
        "/boot/dtbs/${kver}/overlays" \
        "/boot/overlays" \
        "/boot/dtbs/overlays"
    do
        if [[ -d "$(dirname "$dir")" ]] || mkdir -p "$dir" 2>/dev/null; then
            overlay_dir="$dir"
            break
        fi
    done

    if [[ -z "$overlay_dir" ]]; then
        echo "Warning: Could not find overlay directory"
        return 1
    fi

    mkdir -p "$overlay_dir"

    # Compile DTS to DTBO
    if [[ -f "$OVERLAY_SRC" ]]; then
        if dtc -@ -I dts -O dtb -o "${overlay_dir}/secubox-leds.dtbo" "$OVERLAY_SRC" 2>/dev/null; then
            echo "Compiled Device Tree overlay: ${overlay_dir}/secubox-leds.dtbo"
            return 0
        else
            echo "Warning: Failed to compile Device Tree overlay"
            return 1
        fi
    fi
    return 1
}

case "$1" in
    configure)
        # Compile and install Device Tree overlay
        compile_overlay || true

        # Load kernel module if available
        if modprobe leds-is31fl319x 2>/dev/null; then
            echo "Loaded IS31FL3199 LED kernel module"
        else
            echo "Note: LED kernel module not loaded (may need Device Tree overlay)"
        fi

        # Check I2C device
        if command -v i2cdetect &>/dev/null; then
            if i2cdetect -y 1 2>/dev/null | grep -q "64"; then
                echo "IS31FL3199 detected at I2C address 0x64"
            fi
        fi

        # Reload udev rules
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=leds 2>/dev/null || true

        # Enable and start services
        systemctl daemon-reload

        # Only start if LEDs are available
        if [[ -d /sys/class/leds ]] && ls /sys/class/leds/ | grep -qE "(led[0-9]|:led)"; then
            echo "LEDs detected, enabling HealthBump 3-tier system..."
            # Enable LED trigger setup (runs at boot)
            systemctl enable secubox-led-trigger.service 2>/dev/null || true
            systemctl start secubox-led-trigger.service 2>/dev/null || true
            # Enable HealthBump timer (runs every 30s)
            systemctl enable secubox-healthbump.timer 2>/dev/null || true
            systemctl start secubox-healthbump.timer 2>/dev/null || true
            # Enable LED pulse daemon
            systemctl enable secubox-led-pulse.service 2>/dev/null || true
            systemctl start secubox-led-pulse.service 2>/dev/null || true
            echo "HealthBump system started."
        else
            echo "Note: No LEDs detected. Services enabled but not started."
            echo "      Reboot with Device Tree overlay to enable LEDs."
            # Still enable for next boot
            systemctl enable secubox-led-trigger.service 2>/dev/null || true
            systemctl enable secubox-healthbump.timer 2>/dev/null || true
            systemctl enable secubox-led-pulse.service 2>/dev/null || true
        fi

        # Neutralize a legacy unit deployed by hand on some boards
        # (gk2, May 2026). secubox-led-health-bumper.service spawns a
        # bash daemon at /usr/local/bin/secubox-led-health-bumper that
        # competes with the python heartbeat for the same i2c chip:
        # both writers driving the same channels saturates the bus and
        # the LEDs freeze at the last successful value. The python
        # heartbeat handles all three LEDs (LED1 health pulse, LED2
        # threat, LED3 CPU) so the bumper is redundant — disable it
        # if present.
        if systemctl list-unit-files 2>/dev/null | grep -q '^secubox-led-health-bumper\.service'; then
            systemctl disable --now secubox-led-health-bumper.service 2>/dev/null || true
            echo "Disabled legacy secubox-led-health-bumper (redundant with heartbeat)."
        fi
        ;;
esac

#DEBHELPER#

exit 0
