#!/usr/bin/make -f
# Version amont (sans revision Debian) : nomme /usr/src/secubox-leds-<ver>/ (#3290).
DKMS_VERSION := $(shell dpkg-parsechangelog -SVersion | sed -e 's/^[0-9]*://' -e 's/-[^-]*$$//')
DKMS_SRC := debian/secubox-led-heartbeat/usr/src/secubox-leds-$(DKMS_VERSION)

%:
	dh $@

override_dh_auto_install:
	# HealthBump 3-tier system (primary)
	install -D -m 755 usr/sbin/secubox-healthbump \
		debian/secubox-led-heartbeat/usr/sbin/secubox-healthbump
	install -D -m 755 usr/sbin/secubox-led \
		debian/secubox-led-heartbeat/usr/sbin/secubox-led
	install -D -m 755 usr/sbin/secubox-led-board \
		debian/secubox-led-heartbeat/usr/sbin/secubox-led-board
	install -D -m 755 usr/sbin/secubox-led-k2000 \
		debian/secubox-led-heartbeat/usr/sbin/secubox-led-k2000
	install -D -m 755 usr/sbin/secubox-led-pulse \
		debian/secubox-led-heartbeat/usr/sbin/secubox-led-pulse
	# Moteur d'affichage en couches (#3290 tranche 2) : reprise I2C et AppArmor
	install -D -m 644 systemd/secubox-led-reprise.service \
		debian/secubox-led-heartbeat/usr/lib/systemd/system/secubox-led-reprise.service
	install -D -m 644 apparmor/secubox-led-pulse \
		debian/secubox-led-heartbeat/etc/apparmor.d/secubox-led-pulse
	install -D -m 644 usr/lib/secubox-led-heartbeat/ledcouches.py \
		debian/secubox-led-heartbeat/usr/lib/secubox-led-heartbeat/ledcouches.py
	install -D -m 755 usr/sbin/secubox-led-trigger \
		debian/secubox-led-heartbeat/usr/sbin/secubox-led-trigger
	install -D -m 755 usr/sbin/secubox-led-dkms \
		debian/secubox-led-heartbeat/usr/sbin/secubox-led-dkms
	# Pilote leds-is31fl319x en sources DKMS (MOCHAbin, noyau stock) #3290
	install -D -m 644 kmod/leds-is31fl319x.c $(DKMS_SRC)/leds-is31fl319x.c
	install -D -m 644 kmod/Makefile $(DKMS_SRC)/Makefile
	sed 's/@VERSION@/$(DKMS_VERSION)/' kmod/dkms.conf > $(DKMS_SRC)/dkms.conf
	chmod 644 $(DKMS_SRC)/dkms.conf
	# LED reset tool (I2C recovery)
	install -D -m 755 usr/sbin/secubox-led-reset \
		debian/secubox-led-heartbeat/usr/sbin/secubox-led-reset
	# Legacy daemon (backward compatibility)
	install -D -m 755 usr/sbin/secubox-led-heartbeat \
		debian/secubox-led-heartbeat/usr/sbin/secubox-led-heartbeat
	# Systemd services - HealthBump system
	install -D -m 644 systemd/secubox-healthbump.service \
		debian/secubox-led-heartbeat/usr/lib/systemd/system/secubox-healthbump.service
	install -D -m 644 systemd/secubox-healthbump.timer \
		debian/secubox-led-heartbeat/usr/lib/systemd/system/secubox-healthbump.timer
	install -D -m 644 systemd/secubox-led-pulse.service \
		debian/secubox-led-heartbeat/usr/lib/systemd/system/secubox-led-pulse.service
	install -D -m 644 systemd/secubox-led-trigger.service \
		debian/secubox-led-heartbeat/usr/lib/systemd/system/secubox-led-trigger.service
	install -D -m 644 systemd/secubox-leds.service \
		debian/secubox-led-heartbeat/usr/lib/systemd/system/secubox-leds.service
	# Legacy service (backward compatibility)
	install -D -m 644 systemd/secubox-led-heartbeat.service \
		debian/secubox-led-heartbeat/usr/lib/systemd/system/secubox-led-heartbeat.service
	# Kernel module load config
	install -D -m 644 etc/modules-load.d/secubox-leds.conf \
		debian/secubox-led-heartbeat/etc/modules-load.d/secubox-leds.conf
	# Udev rules for LED permissions
	install -D -m 644 etc/udev/rules.d/90-secubox-leds.rules \
		debian/secubox-led-heartbeat/etc/udev/rules.d/90-secubox-leds.rules
	# Config file
	install -D -m 644 etc/secubox/leds.toml \
		debian/secubox-led-heartbeat/etc/secubox/leds.toml
	# Device Tree overlay source
	install -D -m 644 boot/overlays/secubox-leds.dts \
		debian/secubox-led-heartbeat/usr/share/secubox-led-heartbeat/secubox-leds.dts
	# Initramfs modules (for early boot)
	install -D -m 644 etc/initramfs-tools/modules.d/secubox-leds \
		debian/secubox-led-heartbeat/etc/initramfs-tools/modules.d/secubox-leds
	install -D -m 644 etc/initramfs-tools/modules.d/secubox-usb-net \
		debian/secubox-led-heartbeat/etc/initramfs-tools/modules.d/secubox-usb-net

override_dh_installsystemd:
	dh_installsystemd --name=secubox-healthbump --no-enable
	dh_installsystemd --name=secubox-led-pulse --no-enable
	dh_installsystemd --name=secubox-led-trigger --no-enable
	dh_installsystemd --name=secubox-led-heartbeat --no-enable
