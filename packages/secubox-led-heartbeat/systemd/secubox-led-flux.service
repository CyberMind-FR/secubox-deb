# Collecteur de la LED de supervision (#3361) : relève les compteurs toutes les
# 10 s, entretient la référence propre à la box (/var/lib/secubox-leds/) et publie
# un niveau 0..4 par mesure dans /run/secubox-leds/flux.json, lu par le moteur.
# Compte dédié secubox-leds, AUCUNE capacité : les compteurs nftables sbx_drop_* sont
# publiés dans /run/secubox-leds/nft.json par l'unité root secubox-led-nft. Pas
# d'isolation réseau : le collecteur doit voir l'espace réseau de l'hôte
# (/proc/net/dev, conntrack) ; aucune socket réseau (AF_UNIX seul).
# /run/secubox-leds est créé ici (0775 secubox-leds:secubox-leds) : secubox-led-nft
# (root, Group=secubox-leds, sans CAP_DAC_OVERRIDE) y écrit par le groupe.
[Unit]
Description=SecuBox LED - collecteur de supervision
After=network.target

[Service]
Type=simple
ExecCondition=/usr/sbin/secubox-led-board
ExecStart=/usr/sbin/secubox-led-flux
User=secubox-leds
Group=secubox-leds
# /run/secubox/actord-mesures.json est 0640 secubox-actord:actord-ingest
SupplementaryGroups=actord-ingest
Restart=on-failure
RestartSec=30
TimeoutStopSec=10
Nice=19
CPUWeight=10
IOWeight=10
AppArmorProfile=secubox-led-flux
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RuntimeDirectory=secubox-leds
RuntimeDirectoryMode=0775
StateDirectory=secubox-leds
StateDirectoryMode=0750
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
MemoryMax=64M

[Install]
WantedBy=multi-user.target
