# Relève des compteurs nftables sbx_drop_* pour la LED de supervision (#3361).
# Seule unité du groupe à détenir CAP_NET_ADMIN (lecture netlink de nftables) :
# le collecteur Python secubox-led-flux n'a plus aucune capacité et lit le résultat
# dans /run/secubox-led-nft/nft.json (0644 root).
# Dossier runtime PROPRE (RuntimeDirectory=secubox-led-nft, 0755 root:root) : partager
# /run/secubox-leds avec le collecteur cassait l'écriture, sans message, à chaque
# redémarrage automatique de secubox-led-flux (dossier supprimé, montage périmé).
[Unit]
Description=SecuBox LED - releve des compteurs nftables

[Service]
Type=simple
ExecCondition=/usr/sbin/secubox-led-board
ExecStart=/usr/sbin/secubox-led-nft
User=root
Restart=on-failure
RestartSec=30
TimeoutStopSec=10
Nice=19
CPUWeight=10
IOWeight=10
AppArmorProfile=secubox-led-nft
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
UMask=0022
ProtectSystem=strict
ProtectHome=yes
RuntimeDirectory=secubox-led-nft
RuntimeDirectoryMode=0755
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
MemoryMax=32M

[Install]
WantedBy=multi-user.target
