# Relève des compteurs nftables sbx_drop_* pour la LED de supervision (#3361).
# Seule unité du groupe à détenir CAP_NET_ADMIN (lecture netlink de nftables) :
# le collecteur Python secubox-led-flux n'a plus aucune capacité et lit le résultat
# dans /run/secubox-leds/nft.json (0644 root).
# /run/secubox-leds appartient à secubox-led-flux (RuntimeDirectory, 0775 secubox-leds) :
# Requires= + After= garantissent qu'il existe au démarrage et que cette unité s'arrête
# avec lui. Root SANS CAP_DAC_OVERRIDE : l'écriture passe par Group=secubox-leds.
[Unit]
Description=SecuBox LED - releve des compteurs nftables
After=secubox-led-flux.service
Requires=secubox-led-flux.service

[Service]
Type=simple
ExecCondition=/usr/sbin/secubox-led-board
ExecStart=/usr/sbin/secubox-led-nft
User=root
Group=secubox-leds
Restart=on-failure
RestartSec=30
TimeoutStopSec=10
Nice=19
CPUWeight=10
IOWeight=10
AppArmorProfile=secubox-led-nft
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
UMask=0022
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/secubox-leds
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
MemoryMax=32M

[Install]
WantedBy=multi-user.target
