"""secubox-led-flux : collecteur de la LED de supervision (#3361).
Voir /usr/lib/secubox-led-heartbeat/flux.py."""

import os
import sys

sys.path.insert(0, "/usr/lib/secubox-led-heartbeat")

from flux import main  # noqa: E402

code = main()
# Sortie sans finalisation de l'interpréteur : un vidage de flux en échec y
# donnerait 120 au lieu du code du collecteur, vu sur gk6.
for flux in (sys.stdout, sys.stderr):
    try:
        flux.flush()
    except (OSError, ValueError):
        pass
os._exit(code if isinstance(code, int) else 1)
