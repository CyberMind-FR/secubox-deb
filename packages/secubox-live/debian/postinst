set -e

case "$1" in
  configure)
    # --- Compte de service dédié (jamais root) ---
    if ! getent passwd secubox-live >/dev/null; then
      adduser --system --group --no-create-home --home /var/cache/secubox/live --shell /usr/sbin/nologin secubox-live >/dev/null
    fi
    install -d -m 0755 -o secubox-live -g secubox-live /var/cache/secubox/live
    # Lecture du collecteur par ACL CIBLÉES (jamais le groupe secubox entier) : héritées par les fichiers recréés.
    if command -v setfacl >/dev/null 2>&1; then
      for d in /var/log/secubox/waf /var/cache/secubox/metrics /var/cache/secubox/waf; do
        [ -d "$d" ] || continue
        setfacl -m u:secubox-live:rx "$d" 2>/dev/null || true
        setfacl -d -m u:secubox-live:r "$d" 2>/dev/null || true
      done
      for f in /var/log/secubox/waf/waf-threats.log /var/log/secubox/waf/waf-threats.log.1 \
               /var/cache/secubox/metrics/vhost_stats.json /var/cache/secubox/waf/nft-etat.json \
               /etc/secubox/haproxy.toml; do
        [ -f "$f" ] && setfacl -m u:secubox-live:r "$f" 2>/dev/null || true
      done
      for d in /var/log/secubox /var/cache/secubox; do setfacl -m u:secubox-live:x "$d" 2>/dev/null || true; done
    fi

    # --- Confinement AppArmor (enforce) ---
    if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
      apparmor_parser -r /etc/apparmor.d/secubox-live >/dev/null 2>&1 \
        || echo "secubox-live : profil AppArmor non chargé : la page ne sera pas exposée" >&2
    fi

    systemctl daemon-reload || true
    systemctl enable --now secubox-live-collecte.timer >/dev/null 2>&1 || true
    systemctl start secubox-live-collecte.service >/dev/null 2>&1 || true

    # --- Exposition publique : seulement si /etc/secubox/live.toml nomme un domaine ---
    /usr/sbin/secubox-live-exposer || echo "secubox-live : exposition non faite" >&2
    ;;
esac

#DEBHELPER#
exit 0
