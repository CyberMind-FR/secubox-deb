#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
set -e
case "$1" in
  remove|purge)
    rm -f /etc/nginx/sites-enabled/live.conf /etc/nginx/sites-available/live.conf
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then systemctl reload nginx >/dev/null 2>&1 || true; fi
    ;;
esac
if [ "$1" = purge ]; then rm -rf /var/cache/secubox/live; fi
#DEBHELPER#
exit 0
