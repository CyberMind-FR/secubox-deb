#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
# ACL de LECTURE du compte secubox-live sur les seules sources du collecteur (#3351). Lancé en root par le postinst et
# avant chaque collecte (ExecStartPre=+) : un producteur qui recrée un dossier ou un journal (logrotate) ne coupe pas la
# page. Liste FIGÉE : aucun argument, aucun chemin venu de la configuration.
# Producteurs (écriture atomique, nouveau fichier puis rename, dans le même dossier : l'ACL par défaut du dossier
# s'applique) : vhost_stats.json (secubox-metrics, 0644 selon l'umask),
# waf-threats.log (sbxwaf, 0660 puis rotation et .N.gz),
# bans.jsonl (sbxwaf, append-only 0640, jamais tourné). haproxy.toml : fichier simple.
set -eu
command -v setfacl >/dev/null 2>&1 || exit 0
for d in /var/log/secubox /var/cache/secubox /var/lib/secubox; do
  [ -d "$d" ] && setfacl -m u:secubox-live:x "$d" 2>/dev/null || true
done
for d in /var/log/secubox/waf /var/cache/secubox/metrics /var/lib/secubox/waf; do
  [ -d "$d" ] || continue
  setfacl -m u:secubox-live:rx "$d" 2>/dev/null || true
  # Défaut du GROUPE en rwx et masque rwx (#3679) : sans eux, l'ACL par défaut héritait `group::r-x` et un fichier recréé
  # par son producteur perdait l'écriture de groupe que son mode demandait (waf-threats.log en 0660 : sbx-authwatch,
  # groupe secubox-waf, y écrit ses bannissements, #1318). Le mode de création reste le seul juge : 0640 → groupe en
  # lecture, 0660 → groupe en écriture.
  setfacl -d -m u:secubox-live:r,g::rwx,m::rwx "$d" 2>/dev/null || true
done
# Journal courant déjà recréé sous l'ancienne ACL : on lui rend l'écriture de groupe que logrotate demande (create 0660),
# jamais davantage (ni autres, ni exécution).
f=/var/log/secubox/waf/waf-threats.log
[ -f "$f" ] && [ ! -L "$f" ] && setfacl -m g::rw,m::rw "$f" 2>/dev/null || true
for f in /var/log/secubox/waf/waf-threats.log /var/log/secubox/waf/waf-threats.log.1 /var/log/secubox/waf/waf-threats.log.*.gz \
         /var/lib/secubox/waf/bans.jsonl \
         /var/cache/secubox/metrics/vhost_stats.json /etc/secubox/haproxy.toml; do
  [ -f "$f" ] && [ ! -L "$f" ] && setfacl -m u:secubox-live:r "$f" 2>/dev/null || true
done
exit 0
