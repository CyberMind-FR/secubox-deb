"""Lance l'API publique de secubox-live sur sa socket Unix (#3351)."""
import sys

sys.path.insert(0, "/usr/lib/secubox/live")
import uvicorn  # noqa: E402

uvicorn.run("api.main:app", uds="/run/secubox/live.sock", log_level="warning", proxy_headers=False)
