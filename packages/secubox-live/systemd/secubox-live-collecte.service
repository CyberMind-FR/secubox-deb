[Unit]
Description=SecuBox Live — collecte de l'état public du réseau (#3351)
After=network-online.target

[Service]
Type=oneshot
User=secubox-live
Group=secubox-live
# Lecture des sources du maître : base du pilotage (groupe secubox-pilotage, 0640), caches et journaux (groupe secubox).
SupplementaryGroups=secubox secubox-pilotage
ExecStart=/usr/sbin/secubox-live-collecte
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
# https sortant vers api.github.com seulement (cache 10 min) ; rien d'autre n'est contacté.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/cache/secubox/live
TimeoutStartSec=120
MemoryMax=192M
Nice=10
