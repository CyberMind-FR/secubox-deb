# SecuBox Lyrion — lecteur web (squeezelite headless + flux LMS natif). Conffile.
#
# squeezelite s'enregistre comme un VRAI client LMS (nom PLAYER_NAME, MAC fixe
# PLAYER_MAC) et DÉFAUSSE l'audio localement (-o null). Le navigateur écoute le
# flux que LMS produit DÉJÀ pour ce lecteur : http://<LMS>/stream.mp3?player=MAC,
# relayé de même origine par le Hall (/lyrion-stream.mp3). Pas d'ALSA, pas
# d'icecast, pas de ffmpeg — LMS fait le transcodage.
PLAYER_NAME=SBX-Web
PLAYER_MAC=02:42:53:42:57:01
LMS_HOST=10.100.0.100
