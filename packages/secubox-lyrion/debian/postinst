#!/bin/sh
# SecuBox Lyrion — post-install
set -e

case "$1" in
    configure)
        # secubox system user/group (idempotent, matches sibling modules)
        getent group secubox >/dev/null || groupadd --system secubox
        getent passwd secubox >/dev/null || useradd --system --gid secubox \
            --home /var/lib/secubox --no-create-home --shell /usr/sbin/nologin secubox

        install -d -o secubox -g secubox -m 755 /etc/secubox
        install -d -m 0755 -o secubox -g secubox /var/lib/secubox/lyrion
        install -d -m 0755 -o secubox -g secubox /var/log/secubox

        # Seed config from example if no live config exists
        if [ ! -f /etc/secubox/lyrion.toml ] && [ -f /etc/secubox/lyrion.toml.example ]; then
            cp /etc/secubox/lyrion.toml.example /etc/secubox/lyrion.toml
            chmod 640 /etc/secubox/lyrion.toml
            chown root:secubox /etc/secubox/lyrion.toml
        fi

        # Reload nginx if it's running and our snippet parses
        if systemctl is-active --quiet nginx 2>/dev/null; then
            nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
        fi

        systemctl daemon-reload

        # LECTEUR WEB « SBX-Web » DECOMMISSIONNE. La brique lecteur web du Hall
        # (bouton 🎧 « Ecouter ici », flux /lyrion-stream.mp3) est retiree ; on
        # coupe les unites/instances qui trainent sur les box deja deployees.
        # Le controle des lecteurs Squeezebox/Squeezelite et le cast 📡 restent.
        systemctl disable --now sbx-lyrion-webplayer.service 2>/dev/null || true
        systemctl disable --now sbx-lyrion-webplayer-icy.service 2>/dev/null || true
        rm -f /usr/lib/systemd/system/sbx-lyrion-webplayer.service 2>/dev/null || true
        pkill -f 'squeezelite -n SBX-Web' 2>/dev/null || true
        systemctl daemon-reload 2>/dev/null || true

    # Releve de version : savoir qu'une mise a jour existe, sans jamais
    # l'appliquer seul (#993).
    systemctl enable --now secubox-lyrion-version-check.timer 2>/dev/null || true 2>/dev/null || true
        # L'API est servie par l'AGRÉGATEUR (/api/v1/lyrion/ → aggregator.sock) :
        # secubox-lyrion.service n'existe plus. Le manifeste dérivé par
        # `profilectl scan` la déclarait pourtant comme unité du module, en
        # on-demand : le waker attendait un réveil impossible et lyrion.gk2
        # bouclait sur la page de réveil (#1573). Un serveur de musique ne
        # dort pas non plus : le sleeper couperait les lecteurs en pleine
        # écoute. Correction faite UNE fois (témoin), puis le manifeste reste
        # celui de l'administrateur.
        temoin=/var/lib/secubox/lyrion/.manifeste-1573
        man=/etc/secubox/modules.d/lyrion.toml
        if [ ! -e "$temoin" ] && [ -f "$man" ]; then
            if grep -q '^units *= *\["secubox-lyrion.service"\]' "$man"; then
                sed -i 's/^units *= *\["secubox-lyrion.service"\]/units     = []   # API servie par l'"'"'agrégateur (#1573)/' "$man"
            fi
            if command -v secubox-profilectl >/dev/null 2>&1; then
                secubox-profilectl set-lifecycle lyrion --lifecycle always-on \
                    --wake-class normal >/dev/null 2>&1 || true
            fi
            touch "$temoin"
        fi
        # ROUTE SBXWAF posée par le paquet (#1323) : hors on-demand, sans elle
        # lyrion.gk2 rendrait 421.
        if command -v secubox-waf-route >/dev/null 2>&1; then
            secubox-waf-route "$(secubox-domaine lyrion)" 9080 || true
        fi
        systemctl disable secubox-lyrion.service 2>/dev/null || true
        ;;
esac

#DEBHELPER#
exit 0
