#!/bin/sh
# SecuBox Lyrion — post-install
set -e

case "$1" in
    configure)
        # secubox system user/group (idempotent, matches sibling modules)
        getent group secubox >/dev/null || groupadd --system secubox
        getent passwd secubox >/dev/null || useradd --system --gid secubox \
            --home /var/lib/secubox --no-create-home --shell /usr/sbin/nologin secubox

        install -d -o secubox -g secubox -m 755 /etc/secubox
        install -d -m 0755 -o secubox -g secubox /var/lib/secubox/lyrion
        install -d -m 0755 -o secubox -g secubox /var/log/secubox

        # Seed config from example if no live config exists
        if [ ! -f /etc/secubox/lyrion.toml ] && [ -f /etc/secubox/lyrion.toml.example ]; then
            cp /etc/secubox/lyrion.toml.example /etc/secubox/lyrion.toml
            chmod 640 /etc/secubox/lyrion.toml
            chown root:secubox /etc/secubox/lyrion.toml
        fi

        # Reload nginx if it's running and our snippet parses
        if systemctl is-active --quiet nginx 2>/dev/null; then
            nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
        fi

        systemctl daemon-reload

        # LECTEUR WEB : squeezelite headless (vrai client LMS, -o null). Le
        # navigateur ecoute le flux LMS natif (/stream.mp3?player=MAC), relaye
        # en /lyrion-stream.mp3. On coupe une eventuelle instance manuelle, et
        # on retire les anciennes unites ALSA/icecast si elles trainent.
        systemctl disable --now sbx-lyrion-webplayer-icy.service 2>/dev/null || true
        pkill -f 'squeezelite -n SBX-Web' 2>/dev/null || true
        sleep 1
        systemctl enable --now sbx-lyrion-webplayer.service 2>/dev/null || true

    # Releve de version : savoir qu'une mise a jour existe, sans jamais
    # l'appliquer seul (#993).
    systemctl enable --now secubox-lyrion-version-check.timer 2>/dev/null || true 2>/dev/null || true
        systemctl enable secubox-lyrion.service 2>/dev/null || true

        # The nginx route proxies /api/v1/lyrion/ to our dedicated socket
        # /run/secubox/lyrion.sock (NOT the aggregator — see nginx/lyrion.conf
        # invariant, #763), so the admin page is blank/502 unless this service
        # runs. Preserve runtime state across upgrades, and on a fresh install
        # start only once the LMS LXC answers (otherwise defer to
        # `lyrionctl install`, which provisions the LXC then starts us).
        if systemctl is-active --quiet secubox-lyrion.service 2>/dev/null; then
            systemctl try-restart secubox-lyrion.service 2>/dev/null || true
        else
            lms_ip="$(sed -n 's/^[[:space:]]*ip[[:space:]]*=[[:space:]]*"\([0-9.]*\)".*/\1/p' \
                /etc/secubox/lyrion.toml 2>/dev/null | head -n1)"
            lms_ip="${lms_ip:-10.100.0.100}"
            if command -v curl >/dev/null 2>&1 && \
               curl -s -m 3 -o /dev/null "http://${lms_ip}:9000/" 2>/dev/null; then
                systemctl start secubox-lyrion.service 2>/dev/null || true
            fi
        fi
        ;;
esac

#DEBHELPER#
exit 0
