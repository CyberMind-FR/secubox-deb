#!/bin/sh
# SecuBox Lyrion — pre-remove
set -e

case "$1" in
    remove|deconfigure|upgrade)
        systemctl stop secubox-lyrion.service 2>/dev/null || true
        systemctl disable secubox-lyrion.service 2>/dev/null || true
        # We do not destroy the LXC here — purge does that via postrm if asked.
        ;;
esac

#DEBHELPER#
exit 0
