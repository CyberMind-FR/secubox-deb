#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-lyrion/etc/sudoers.d
	install -m 0440 debian/secubox-lyrion.sudoers debian/secubox-lyrion/etc/sudoers.d/secubox-lyrion
	# Host control plane (FastAPI)
	install -d debian/secubox-lyrion/usr/lib/secubox/lyrion
	cp -r api debian/secubox-lyrion/usr/lib/secubox/lyrion/
	# CTL
	install -d debian/secubox-lyrion/usr/sbin
	install -m 755 sbin/lyrionctl debian/secubox-lyrion/usr/sbin/lyrionctl
	# Web UI
	install -d debian/secubox-lyrion/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-lyrion/usr/share/secubox/www/ || true
	# Menu entry
	install -d debian/secubox-lyrion/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-lyrion/usr/share/secubox/menu.d/ || true
	# nginx snippet — install to BOTH secubox.d/ and secubox-routes.d/ (per v2.11.1 lesson)
	install -d debian/secubox-lyrion/etc/nginx/secubox.d
	[ -f nginx/lyrion.conf ] && cp nginx/lyrion.conf debian/secubox-lyrion/etc/nginx/secubox.d/ && (install -d debian/secubox-lyrion/etc/nginx/secubox-routes.d && cp nginx/lyrion.conf debian/secubox-lyrion/etc/nginx/secubox-routes.d/) || true
	# Public + LAN vhost (sites-available — operator opts in via ln -s)
	install -d debian/secubox-lyrion/etc/nginx/sites-available
	[ -f nginx/lyrion-vhost.conf ] && cp nginx/lyrion-vhost.conf debian/secubox-lyrion/etc/nginx/sites-available/lyrion.conf || true
	# Config example
	install -d debian/secubox-lyrion/etc/secubox
	[ -f conf/lyrion.toml.example ] && cp conf/lyrion.toml.example debian/secubox-lyrion/etc/secubox/lyrion.toml.example || true
	# LXC bootstrap + Lyrion configuration template
	install -d debian/secubox-lyrion/usr/share/secubox/lib/lyrion
	[ -d lib/lyrion ] && cp -r lib/lyrion/. debian/secubox-lyrion/usr/share/secubox/lib/lyrion/ || true
	# install-lxc.sh must be executable (cp -r doesn't always preserve +x from git)
	[ -f debian/secubox-lyrion/usr/share/secubox/lib/lyrion/install-lxc.sh ] && \
	    chmod 755 debian/secubox-lyrion/usr/share/secubox/lib/lyrion/install-lxc.sh
	# Releve quotidien de la version disponible (#993).
	install -d debian/secubox-lyrion/usr/lib/systemd/system
	install -m 0644 debian/secubox-lyrion-version-check.service debian/secubox-lyrion/usr/lib/systemd/system/
	install -m 0644 debian/secubox-lyrion-version-check.timer debian/secubox-lyrion/usr/lib/systemd/system/
	# Lecteur web : squeezelite headless (vrai client LMS, -o null) ; le
	# navigateur écoute le flux LMS natif (/stream.mp3?player=MAC).
	install -m 0644 debian/sbx-lyrion-webplayer.service debian/secubox-lyrion/usr/lib/systemd/system/
	install -d debian/secubox-lyrion/etc/secubox
	install -m 0644 debian/lyrion-webplayer.env debian/secubox-lyrion/etc/secubox/lyrion-webplayer.env
