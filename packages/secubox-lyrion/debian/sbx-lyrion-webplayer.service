[Unit]
Description=SecuBox Lyrion — lecteur web (squeezelite headless, vrai client LMS)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=-/etc/secubox/lyrion-webplayer.env
# -o null : LMS le voit comme un lecteur et lui envoie le flux ; l'audio local
# est defausse. Le navigateur ecoute le flux LMS natif (/stream.mp3?player=MAC).
ExecStart=/usr/bin/squeezelite -n ${PLAYER_NAME} -m 02:42:53:42:57:01 -s ${LMS_HOST} -o null
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=192M
TasksMax=16
[Install]
WantedBy=multi-user.target
