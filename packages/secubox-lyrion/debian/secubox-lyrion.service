[Unit]
Description=SecuBox Lyrion — host control plane API
Documentation=file:///usr/share/doc/secubox-lyrion/README
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
UMask=0007
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/lyrion
# /run/secubox (1777 root:root) appartient à secubox-core : RuntimeDirectory=secubox le re-chownait en
# 0755 secubox:secubox, 502 sur toute la box (#494, #763, #3096). On n'y touche pas ; socket périmée retirée.
RuntimeDirectory=
RuntimeDirectoryPreserve=yes
ExecStartPre=+/bin/rm -f /run/secubox/lyrion.sock
ExecStartPre=+/bin/mkdir -p /etc/secubox
ExecStartPre=+/bin/chown secubox:secubox /etc/secubox
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/lyrion.sock --log-level warning
Restart=on-failure
RestartSec=5
# NoNewPrivileges=true neutralise sudo — « the "no new privileges" flag is
# set, which prevents sudo from running as root ». Or le panneau DOIT
# deleguer a lyrionctl en root : /data/lxc/<nom> appartient a l'idmap du
# conteneur et n'est pas meme traversable par `secubox`.
NoNewPrivileges=false
LogsDirectory=secubox
LogsDirectoryMode=0755
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox /var/log/secubox

[Install]
WantedBy=multi-user.target
