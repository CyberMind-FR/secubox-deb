#!/usr/bin/env bash
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: lyrionctl
# CyberMind — https://cybermind.fr
#
# Lyrion host-side controller. LXC at 10.100.0.100 on br-lxc.
# Three-fold introspection (components/status/access) + dashboard, datasource,
# alert, user, api-key, install, reload verbs.
#
# Grammar: docs/grammar.md, OPS MONITORING layer.
# Conventions: docs/MODULE-GUIDELINES.md §7.

set -u

readonly VERSION="1.2.0"
readonly CONFIG_FILE="${SECUBOX_LYRION_CONFIG:-/etc/secubox/lyrion.toml}"
readonly STATE_DIR="${SECUBOX_LYRION_STATE:-/var/lib/secubox/lyrion}"
readonly SECRETS_DIR="${SECUBOX_SECRETS_DIR:-/etc/secubox/secrets}"
readonly INSTALL_LIB="${SECUBOX_INSTALL_LIB:-/usr/share/secubox/lib/lyrion/install-lxc.sh}"

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

log()   { printf '%b[lyrion]%b %s\n' "$GREEN" "$NC" "$*"; }
warn()  { printf '%b[warn]%b %s\n'    "$YELLOW" "$NC" "$*" >&2; }
err()   { printf '%b[error]%b %s\n'   "$RED"    "$NC" "$*" >&2; }

# ── TOML config (best-effort, grep-style — same as giteactl) ─────────────────
config_get() {
    # Minimal TOML scalar read: strips inline `# comments`, surrounding
    # whitespace, and the optional "..." / '...' quotes. The previous
    # version concatenated comment text into the value (eg HTTP_PORT
    # became `9000 # web admin UI` which then broke URL construction).
    local key="$1" default="${2:-}" raw=""
    if [ -f "$CONFIG_FILE" ]; then
        raw=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1)
    fi
    if [ -z "$raw" ]; then
        echo "$default"
        return
    fi
    # value-after-equals, strip inline comment, trim whitespace, drop quotes
    local val
    val=$(echo "$raw" | cut -d= -f2- | sed 's/[[:space:]]*#.*$//' \
        | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' \
        | tr -d '"' | tr -d "'")
    if [ -z "$val" ]; then
        echo "$default"
    else
        echo "$val"
    fi
}

# toml_get_sec <file> <section> <key> <default> — section-aware scalar read.
# Needed for lyrion.toml where `path` occurs under BOTH [lxc] and [library];
# config_get()'s flat grep would silently return the [lxc] one for either.
# Same implementation as jellyfinctl's toml_get_sec (kept in sync by hand —
# these host *ctl tools deliberately don't share a bash lib, see PATTERNS.md).
toml_get_sec() {
    local file="$1" section="$2" key="$3" default="${4:-}"
    if [ ! -f "$file" ]; then echo "$default"; return; fi
    local val
    val=$(awk -v section="$section" -v key="$key" '
        /^[[:space:]]*\[/ { s=$0; gsub(/[][[:space:]]/,"",s); cur=s; next }
        cur==section {
            line=$0; k=line; sub(/=.*/,"",k); gsub(/[[:space:]]/,"",k)
            if (k==key) {
                v=line; sub(/^[^=]*=/,"",v); sub(/#.*/,"",v)
                gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); gsub(/["'\''"]/,"",v)
                print v; exit
            }
        }' "$file" 2>/dev/null || true)
    [ -z "$val" ] && echo "$default" || echo "$val"
}

LXC_NAME=$(config_get "name" "lyrion")
LXC_IP=$(config_get "ip" "10.100.0.100")
LXC_PATH=$(config_get "path" "/data/lxc")
HTTP_PORT=$(config_get "http_port" "3000")
PUBLIC_HOSTNAME=$(config_get "public_hostname" "lyrion.gk2.secubox.in")

# Conserved-audio landing subdir, inside [library].path (default /data/music).
# Same directory tree LMS already scans — no separate partner-side mount
# needed, unlike the single-slot `medialib` external mount below.
readonly CONSERVE_SUBDIR="${SECUBOX_LYRION_CONSERVE_SUBDIR:-conserve}"

# ── LXC helpers ───────────────────────────────────────────────────────────────
lxc_state() {
    lxc-info -n "$LXC_NAME" -P "$LXC_PATH" 2>/dev/null \
        | awk -F: '/^State:/ { gsub(/ /,"",$2); print tolower($2) }'
}

lxc_running() { [ "$(lxc_state)" = "running" ]; }
lxc_exists()  { [ -d "$LXC_PATH/$LXC_NAME/rootfs" ]; }

daemon_running() {
    lxc_running || return 1
    # The upstream .deb installs unit `lyrionmusicserver.service`; the
    # historic Logitech-era unit `logitechmediaserver.service` is the
    # legacy fallback if someone provisioned an older release.
    lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl is-active --quiet lyrionmusicserver 2>/dev/null \
        || lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl is-active --quiet logitechmediaserver 2>/dev/null
}

host_api_running() {
    systemctl is-active --quiet secubox-lyrion.service 2>/dev/null
}

# ── Three-fold output (matches docs/MODULE-GUIDELINES.md §7) ──────────────────
emit_components_json() {
    local lxc_st daemon_st api_st
    if lxc_exists; then
        lxc_st=$(lxc_state)
        [ -z "$lxc_st" ] && lxc_st="absent"
    else
        lxc_st="absent"
    fi
    daemon_running && daemon_st="running" || daemon_st="stopped"
    host_api_running && api_st="running" || api_st="stopped"

    cat <<EOF
{
  "module": "lyrion",
  "version": "$VERSION",
  "components": [
    {"name": "lxc",      "state": "$lxc_st",      "detail": "$LXC_NAME @ $LXC_IP on br-lxc"},
    {"name": "daemon",   "state": "$daemon_st",   "detail": "lyrion, port $HTTP_PORT"},
    {"name": "host-api", "state": "$api_st",      "detail": "secubox-lyrion.service (uvicorn @ /run/secubox/lyrion.sock)"}
  ]
}
EOF
}

emit_components_text() {
    printf '%-12s %-12s %s\n' "COMPONENT" "STATE" "DETAIL"
    if lxc_exists; then
        local s; s=$(lxc_state); [ -z "$s" ] && s="absent"
        printf '%-12s %-12s %s\n' "lxc" "$s" "$LXC_NAME @ $LXC_IP on br-lxc"
    else
        printf '%-12s %-12s %s\n' "lxc" "absent" "$LXC_NAME @ $LXC_IP on br-lxc — run 'lyrionctl install'"
    fi
    if daemon_running; then
        printf '%-12s %-12s %s\n' "daemon" "running" "lyrion, port $HTTP_PORT"
    else
        printf '%-12s %-12s %s\n' "daemon" "stopped" "lyrion, port $HTTP_PORT"
    fi
    if host_api_running; then
        printf '%-12s %-12s %s\n' "host-api" "running" "secubox-lyrion.service (uvicorn)"
    else
        printf '%-12s %-12s %s\n' "host-api" "stopped" "secubox-lyrion.service (uvicorn)"
    fi
}

emit_status_json() {
    local overall
    if lxc_running && daemon_running && host_api_running; then
        overall="green"
    elif lxc_exists && (daemon_running || host_api_running); then
        overall="yellow"
    else
        overall="red"
    fi
    cat <<EOF
{
  "module": "lyrion",
  "version": "$VERSION",
  "overall": "$overall"
}
EOF
}

emit_access_json() {
    # Real LMS Music UI URLs — NOT the /lyrion/ admin subpath. The admin
    # webui's "Open Music UI" button reads this; consistency comes from
    # one source.
    #   lan:    http://<host>:9000/   (direct nginx vhost, LAN-only)
    #   public: https://<PUBLIC_HOSTNAME>/   (Authelia-gated dedicated vhost)
    local lan_url public_url
    lan_url="http://$(hostname -I | awk '{print $1}'):${HTTP_PORT}/"
    if [ -n "$PUBLIC_HOSTNAME" ]; then
        public_url="https://${PUBLIC_HOSTNAME}/"
    else
        public_url=""
    fi
    cat <<EOF
{
  "module": "lyrion",
  "access": [
    {"url": "$lan_url",    "auth": "lan-only",       "scope": "lan"}$( [ -n "$public_url" ] && echo ',' )
    $( [ -n "$public_url" ] && cat <<PUB
{"url": "$public_url", "auth": "Authelia SSO",   "scope": "public"}
PUB
)
  ]
}
EOF
}

# ── Verbs ─────────────────────────────────────────────────────────────────────
cmd_components() {
    case "${1:-}" in
        --json) emit_components_json ;;
        ""|list|status) emit_components_text ;;
        *) err "unknown verb for 'components': $1"; exit 1 ;;
    esac
}

cmd_status() {
    case "${1:-}" in
        --json) emit_status_json ;;
        ""|list) emit_components_text ; echo ; emit_status_json | python3 -c 'import json,sys; d=json.load(sys.stdin); print("overall:", d["overall"])' ;;
        *) err "unknown verb for 'status': $1"; exit 1 ;;
    esac
}

cmd_access() {
    case "${1:-}" in
        --json) emit_access_json ;;
        ""|list) emit_access_json | python3 -m json.tool ;;
        show)
            local name="${2:-lan}"
            emit_access_json | python3 -c "import json,sys; d=json.load(sys.stdin); m=[a for a in d['access'] if a['scope']=='$name']; print(m[0] if m else 'not found')"
            ;;
        *) err "unknown verb for 'access': $1"; exit 1 ;;
    esac
}

cmd_install() {
    if [ ! -x "$INSTALL_LIB" ]; then
        err "install script not found at $INSTALL_LIB (package not installed correctly?)"
        exit 2
    fi
    log "Running LXC bootstrap from $INSTALL_LIB ..."
    SECUBOX_LXC_NAME="$LXC_NAME" SECUBOX_LXC_IP="$LXC_IP" SECUBOX_LXC_PATH="$LXC_PATH" \
        bash "$INSTALL_LIB"
    log "Starting host-side FastAPI ..."
    systemctl start secubox-lyrion.service 2>/dev/null || true
    log "Done. Try 'lyrionctl status' to verify."
}

cmd_reload() {
    systemctl restart secubox-lyrion.service 2>/dev/null || true
    if lxc_running; then
        lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl restart lyrionmusicserver 2>/dev/null \
            || lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl restart logitechmediaserver 2>/dev/null || true
    fi
    log "Reloaded host FastAPI and lyrionmusicserver (if running)."
}

# ── Conserve ingest (partner entry point for secubox-torrent-conserve /
# secubox-ytsas-conserve, issue #967) ─────────────────────────────────────────
# Places an already-downloaded audio file into the Lyrion music library
# ([library].path, the same tree lyrionctl install RO-binds into the LXC)
# and nudges a rescan. Always emits JSON; callers key off .ok to decide
# whether the item is DONE (dequeue) or should stay queued for a retry.
#
# The LXC must be RUNNING for anything to happen — not just provisioned.
# This keeps the contract simple and unambiguous for callers: "ok":false
# means "Lyrion is absent or unreachable right now, try again later",
# never a half-done copy sitting in a directory nobody is scanning yet.
cmd_ingest() {
    local src="${1:-}" lib dest_dir dest src_hash
    if [ -z "$src" ] || [ ! -f "$src" ]; then
        printf '{"ok":false,"error":"source file not found"}\n'
        return 1
    fi
    if ! lxc_running; then
        printf '{"ok":false,"error":"lyrion lxc not running"}\n'
        return 1
    fi
    lib=$(toml_get_sec "$CONFIG_FILE" library path "/data/music")
    # Namespace by a hash of the SOURCE PATH (not content — cheap, and stable
    # across retries of the same request): two unrelated conserved files that
    # happen to share a basename (eg. two different torrents both producing
    # "01 - Track.mp3") must never silently overwrite each other in the
    # library. Same source path always hashes the same, so a retried/re-run
    # ingest of the same file is idempotent (re-copies over itself, no dupes).
    src_hash=$(printf '%s' "$src" | sha1sum | cut -c1-10)
    dest_dir="${lib%/}/${CONSERVE_SUBDIR}/${src_hash}"
    if ! install -d -m 0755 "$dest_dir" 2>/dev/null; then
        printf '{"ok":false,"error":"library path not writable"}\n'
        return 1
    fi
    dest="$dest_dir/$(basename -- "$src")"
    if ! cp -f -- "$src" "$dest" 2>/dev/null; then
        printf '{"ok":false,"error":"copy failed"}\n'
        return 1
    fi
    # Best-effort — the file is already in place either way, so a failed
    # nudge does not flip this to ok:false; LMS's own periodic scan will
    # eventually pick it up.
    _medialib_trigger_scan
    printf '{"ok":true,"path":%s}\n' "$(_json_str "$dest")"
}

cmd_help() {
    cat <<'HELP'
lyrionctl — SecuBox Lyrion music-server controller (HOSTING layer)

Three-fold introspection:
  lyrionctl components [--json]      # LXC + lyrion daemon + host-API states
  lyrionctl status     [--json]      # overall green/yellow/red
  lyrionctl access     [list|show <name>] [--json]

Lifecycle (per docs/MODULE-GUIDELINES.md §7):
  lyrionctl install                  # idempotent LXC + Lyrion bootstrap
  lyrionctl reload                   # restart host FastAPI + lyrion daemon
  lyrionctl repair                   # detect + fix drift (NOT YET IMPLEMENTED)
  lyrionctl wizard                   # interactive seed + install (NOT YET IMPLEMENTED)
  lyrionctl uninstall                # remove LXC + state + secrets (NOT YET IMPLEMENTED)

Music-server nouns (v1.1.0):
  lyrionctl player       list|play <id>|pause <id>|next <id>|prev <id>|volume <id> <0-100>
  lyrionctl library      scan|refresh|status|wipe
  lyrionctl playlist     list|add <name>|remove <name>|tracks <name>
  lyrionctl plugin       list|install <name>|uninstall <name>

External media library (v1.1.3, always emits JSON):
  lyrionctl medialib detect            # candidate external mounts w/ audio (NEVER mounts)
  lyrionctl medialib mount <path>      # RO-bind <path> into the LXC + persist + rescan
  lyrionctl medialib unmount           # remove bind + config + rescan
  lyrionctl medialib status            # {"external":"<path|null>","mounted":bool}

Conserve partner entry point (v1.2.0, issue #967, always emits JSON):
  lyrionctl ingest <file>              # copy <file> into [library].path/conserve + rescan
                                        # {"ok":true,"path":"..."} or {"ok":false,"error":"..."}
                                        # ok:false (lxc not running, etc.) => caller should
                                        # leave the item queued and retry later

  (--json on any verb returns machine-readable output)

For grammar details: /usr/share/doc/secubox-lyrion/README.gz
                     docs/grammar.md (HOSTING layer, #244)
HELP
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
_ly_latest() {
    # Stable Lyrion releases are plain-semver tags (X.Y.Z); 'ueml/…' tags are
    # experimental and must be ignored.
    curl -s --max-time 10 'https://api.github.com/repos/LMS-Community/slimserver/tags' 2>/dev/null \
        | jq -r '.[].name' 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1
}
_ly_current() { lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- dpkg-query -W -f='${Version}' lyrionmusicserver 2>/dev/null; }

# check-upgrade — non-destructive: prints JSON {current, latest, available, major_jump}.
# Cache de la derniere version connue (#993).
#
# `_ly_latest` sort vers le reseau. Appele depuis le chemin de requete du
# panneau, il le prendrait en otage a chaque affichage — et le rendrait
# dependant d'une panne DNS ou d'un depot lent. Le minuteur quotidien ecrit
# ici, le panneau lit.
readonly LY_VERSION_CACHE="${SECUBOX_LYRION_VERSION_CACHE:-/var/cache/secubox/lyrion/version.json}"

cmd_check_upgrade() {
    local cur latest available=false major=false
    cur=$(_ly_current); latest=$(_ly_latest)
    if [ -n "$latest" ] && [ -n "$cur" ] && [ "$latest" != "$cur" ]; then
        available=true; [ "${latest%%.*}" != "${cur%%.*}" ] && major=true
    fi
    local payload
    payload=$(printf '{"current":"%s","latest":"%s","available":%s,"major_jump":%s,"checked_at":"%s"}' \
        "$cur" "${latest:-$cur}" "$available" "$major" "$(date -Is)")
    # Le cache n'est ecrit que si la version distante a REELLEMENT ete obtenue :
    # memoriser un « latest = current » issu d'un echec reseau ferait disparaitre
    # une mise a jour disponible du panneau, en silence.
    if [ -n "$latest" ]; then
        mkdir -p "$(dirname "$LY_VERSION_CACHE")" 2>/dev/null || true
        printf '%s\n' "$payload" > "$LY_VERSION_CACHE" 2>/dev/null || true
    fi
    printf '%s\n' "$payload"
}

# version — lit le cache, sans jamais sortir vers le reseau. C'est ce que le
# panneau interroge.
cmd_version_status() {
    local cur; cur=$(_ly_current)
    if [ -r "$LY_VERSION_CACHE" ]; then
        python3 - "$LY_VERSION_CACHE" "$cur" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
cur = sys.argv[2]
# `current` est relu en direct QUAND C'EST POSSIBLE : le cache peut dater
# d'avant un upgrade, et afficher une version obsolete apres coup serait pire
# que ne rien afficher.
#
# Mais l'API tourne en `secubox` et ne peut pas interroger la LXC : la lecture
# live y revient VIDE. Sans ce repli, le panneau afficherait une version
# courante vide — mesure sur la board. On prefere donc le live, puis le cache,
# et jamais le blanc.
d["current"] = cur or d.get("current") or ""
latest = d.get("latest") or cur
d["latest"] = latest
d["available"] = bool(latest and cur and latest != cur)
d["cached"] = True
print(json.dumps(d))
PY
    else
        printf '{"current":"%s","latest":null,"available":false,"cached":false,"checked_at":null}\n' "$cur"
    fi
}

# upgrade — download the new _all.deb and dpkg -i it (low risk: single package).
cmd_upgrade() {
    local cur latest; cur=$(_ly_current); latest=$(_ly_latest)
    [ -n "$latest" ] && [ "$latest" != "$cur" ] || { echo "Already up to date (${cur})"; return 0; }
    echo "Upgrading Lyrion ${cur} → ${latest}…"
    local url="https://downloads.lms-community.org/LyrionMusicServer_v${latest}/lyrionmusicserver_${latest}_all.deb"
    if ! lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- bash -lc \
        "cd /tmp && wget -q '${url}' -O lms.deb && systemctl stop lyrionmusicserver 2>/dev/null; DEBIAN_FRONTEND=noninteractive dpkg -i lms.deb || apt-get -f install -y; systemctl start lyrionmusicserver; rm -f lms.deb"; then
        err "lyrion upgrade failed"; return 1
    fi
    echo "Upgraded to ${latest}."
}

# ── medialib — external media (auto-detect + opt-in confirm) ──────────────────
# Additions here are written strict-mode-clean (safe under `set -euo pipefail`):
# every pipeline / substitution is guarded so no defensive assumption from the
# module-level `set -u` is required. NOTE: the file-level `set` stays `set -u`
# on purpose — flipping it to errexit would break the grep-based config_get
# (grep no-match → rc 1 in a command-substitution assignment).
#
# RO bind target inside the LXC rootfs. Detect NEVER mounts.
readonly MEDIALIB_TARGET="medialib/external"

# Racine des montages que CE module cree lui-meme. Separee des points de
# montage de l'operateur (/mnt, /media/<autre>) pour que `unmount` sache
# exactement ce qu'il a le droit de demonter : on ne demonte jamais un support
# qu'on n'a pas monte.
readonly MEDIALIB_MOUNT_ROOT="${SECUBOX_LYRION_MOUNT_ROOT:-/media/secubox-lyrion}"

_medialib_cfg()   { printf '%s\n' "$LXC_PATH/$LXC_NAME/config"; }
# UN POINT DE MONTAGE PAR SUPPORT.
#
# La premiere version n'avait qu'une cible unique (`medialib/external`) et
# `medialib mount` REMPLAÇAIT la precedente : brancher un second disque faisait
# disparaitre le premier de Lyrion. Constate avec une cle et un disque de 2 To
# — seule la cle etait visible.
#
# Le nom vient de l'etiquette du support, donc d'une source non maitrisee, et
# compose un chemin : il est assaini.
_medialib_slug() {
    printf '%s' "$(basename -- "${1:-}")" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-40
}
_medialib_target() { printf '%s/%s' "$MEDIALIB_TARGET" "$(_medialib_slug "$1")"; }
_medialib_mntpt() { printf '%s\n' "$LXC_PATH/$LXC_NAME/rootfs/$(_medialib_target "${1:-}")"; }

# JSON string encoder — paths may carry spaces / quotes.
_json_str() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

# Count audio files under a path (bounded so `detect` stays responsive).
# Le balayage est BORNE DANS LE TEMPS. Sur un disque USB de 931 Go (HFS+), il
# prend des minutes : `head -n 5000` limite le nombre de resultats, pas la
# duree de la marche. Sans borne, un support volumineux immobilise un scan
# pendant tout le temps qu'il faut.
_medialib_audio_count() {
    local path="$1" n=0
    n=$(timeout "${MEDIALIB_SCAN_TIMEOUT:-20}" \
        find "$path" -maxdepth 6 -type f \( \
            -iname '*.mp3' -o -iname '*.flac' -o -iname '*.m4a' \
            -o -iname '*.ogg' -o -iname '*.wav' -o -iname '*.aac' \
        \) 2>/dev/null | head -n 5000 | wc -l | tr -d ' ')
    printf '%s\n' "${n:-0}"
}

# Partitions porteuses d'un systeme de fichiers et NON montees (#993).
#
# La detection d'origine n'examinait que des repertoires DEJA montes : une cle
# USB fraichement branchee, qu'aucun automontage ne prend en charge, restait
# donc invisible — c'etait le trou signale par « aucun candidat detecte » alors
# qu'un disque etiquete etait bien present.
#
# Emis en TSV : device, label, taille, systeme de fichiers, amovible(0/1).
# Le comptage de fichiers audio n'est PAS possible ici sans monter, donc un
# candidat bloc est rapporte tel quel — a l'utilisateur de decider. Monter pour
# regarder serait exactement ce que le panneau promet de ne pas faire.
_medialib_block_candidates() {
    command -v lsblk >/dev/null 2>&1 || return 0
    # PATH est DELIBEREMENT absent de la liste : `lsblk -P` emet
    # `PATH="/dev/sda1"`, et l'evaluer ecraserait le PATH du shell — toute
    # commande externe appelee ensuite dans la boucle deviendrait introuvable.
    # Le chemin du peripherique est reconstruit depuis NAME.
    lsblk -P -o NAME,LABEL,SIZE,FSTYPE,MOUNTPOINT,RM,TYPE 2>/dev/null | while IFS= read -r line; do
        NAME=""; LABEL=""; SIZE=""; FSTYPE=""; MOUNTPOINT=""; RM=""; TYPE=""
        eval "$line" 2>/dev/null || continue
        [ "${TYPE:-}" = "part" ] || continue
        [ -n "${FSTYPE:-}" ] || continue
        [ -z "${MOUNTPOINT:-}" ] || continue
        [ -n "${NAME:-}" ] || continue
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "/dev/${NAME}" "${LABEL:-}" "${SIZE:-}" "${FSTYPE:-}" "${RM:-0}"
    done
}

# Enumerate candidate mountpoints: immediate children of the external roots +
# removable/media mounts parsed from /proc/mounts. Prints one path per line.
_medialib_candidates() {
    local roots=(/media /mnt /data/external) r d mp
    for r in "${roots[@]}"; do
        [ -d "$r" ] || continue
        printf '%s\n' "$r"
        for d in "$r"/*; do
            [ -d "$d" ] || continue
            printf '%s\n' "$d"
        done
    done
    if [ -r /proc/mounts ]; then
        # field 2 = mountpoint (octal-escaped); keep only external-ish mounts.
        awk '$2 ~ /^\/(media|mnt|run\/media|data\/external)/ {print $2}' /proc/mounts \
            2>/dev/null | while IFS= read -r mp; do
                [ -n "$mp" ] && printf '%b\n' "$mp"
            done
    fi
}

# Strip any prior medialib bind line from the LXC config (idempotent).
# Ne retire QUE l'entree du support vise (ou toutes si aucun n'est donne).
# Retirer aveuglement toutes les entrees faisait disparaitre les autres
# supports a chaque nouveau montage.
_medialib_strip_cfg() {
    local cfg="$1" only="${2:-}" tmp pat
    [ -f "$cfg" ] || return 0
    tmp=$(mktemp) || return 1
    if [ -n "$only" ]; then
        pat="^[[:space:]]*lxc\.mount\.entry[[:space:]]*=.*$(_medialib_target "$only")([[:space:]]|$)"
    else
        pat="^[[:space:]]*lxc\.mount\.entry[[:space:]]*=.*${MEDIALIB_TARGET}/([[:space:]]|$|[^[:space:]]*[[:space:]])"
    fi
    grep -vE "$pat" "$cfg" > "$tmp" 2>/dev/null || true
    cat "$tmp" > "$cfg"
    rm -f "$tmp"
}

# Persist / drop the external_medialib key in lyrion.toml.
_medialib_toml_set() {
    local path="$1" tmp
    [ -f "$CONFIG_FILE" ] || return 0
    tmp=$(mktemp) || return 1
    grep -vE '^[[:space:]]*external_medialib[[:space:]]*=' "$CONFIG_FILE" > "$tmp" 2>/dev/null || true
    cat "$tmp" > "$CONFIG_FILE"
    rm -f "$tmp"
    [ -n "$path" ] && printf 'external_medialib = "%s"\n' "$path" >> "$CONFIG_FILE"
    return 0
}

# ── Declarer le chemin aupres de LMS ────────────────────────────────────────
#
# MONTER N'EST PAS DECLARER. Le bind fait apparaitre le support dans le
# conteneur, mais LMS ne scanne que les repertoires listes dans sa preference
# `mediadirs`. Sans cette declaration, `medialib mount` repondait « monte » et
# lançait une reindexation — d'un repertoire dont LMS n'avait jamais entendu
# parler. Cote utilisateur : le disque est la, et Lyrion ne voit rien.
#
# La preference est editee AVEC LMS ARRETE : le serveur reecrit ses prefs en
# sortant, et ecraserait une modification faite a chaud.
_medialib_lms_prefs() {
    printf '%s/%s/rootfs/var/lib/squeezeboxserver/prefs/server.prefs' "$LXC_PATH" "$LXC_NAME"
}

_medialib_lms_declare() {
    local action="$1" src="${2:-}" target prefs changed=0
    target="/$(_medialib_target "$src")"
    target="/${target#/}"
    prefs=$(_medialib_lms_prefs)
    [ -f "$prefs" ] || { err "prefs LMS introuvables : $prefs"; return 1; }

    changed=$(python3 - "$prefs" "$target" "$action" <<'PY'
import re, sys
prefs, target, action = sys.argv[1:4]
lines = open(prefs).read().splitlines()
out, i, inside, seen, changed = [], 0, False, False, 0
while i < len(lines):
    line = lines[i]
    if line.startswith("mediadirs:"):
        inside = True
        out.append(line)
        i += 1
        # Collecte les entrees existantes de la liste.
        items = []
        while i < len(lines) and lines[i].startswith("- "):
            items.append(lines[i][2:].strip())
            i += 1
        if action == "add":
            if target not in items:
                items.append(target); changed = 1
        else:
            if target in items:
                items = [x for x in items if x != target]; changed = 1
        out.extend("- " + x for x in items)
        continue
    out.append(line)
    i += 1
if changed:
    open(prefs, "w").write("\n".join(out) + "\n")
print(changed)
PY
) || return 1

    if [ "${changed:-0}" = "1" ]; then
        return 0
    fi
    return 2   # deja dans l'etat voulu
}

# Redemarre LMS pour que la preference soit relue, puis reindexe.
_medialib_lms_restart() {
    local svc
    for svc in lyrionmusicserver logitechmediaserver; do
        if lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl is-enabled --quiet "$svc" 2>/dev/null; then
            lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl restart "$svc" 2>/dev/null && return 0
        fi
    done
    return 1
}

# Best-effort LMS rescan (same jsonrpc the /rescan endpoint uses).
_medialib_trigger_scan() {
    lxc_running || return 0
    curl -s --max-time 5 -H 'Content-Type: application/json' \
        -d '{"id":1,"method":"slim.request","params":["",["rescan"]]}' \
        "http://${LXC_IP}:9000/jsonrpc.js" >/dev/null 2>&1 || true
    return 0
}

# detect — CACHE ET VERROU (#993).
#
# Ce que la premiere version coutait : chaque appel relançait un `find` sur
# tous les supports. Le panneau interrogeant l'endpoint en boucle, les scans
# s'EMPILAIENT — 7 `find` concurrents sur un disque USB de 931 Go ont ete
# observes sur la board, sur 4 coeurs deja charges. Tant que la fonctionnalite
# etait cassee (elle l'etait, cf. #993), le defaut restait invisible.
#
# Deux gardes, dans cet ordre :
#
#   1. Un VERROU exclusif : deux appels simultanes ne lancent jamais deux
#      balayages. Le second attend et resservira le cache.
#   2. Un CACHE horodate : la composition d'un support ne change pas d'une
#      seconde a l'autre, et le pattern du projet l'impose pour tout endpoint
#      qui agrege (cf. CLAUDE.md, « Performance Patterns »).
medialib_detect() {
    local cache="${MEDIALIB_CACHE:-/var/cache/secubox/lyrion/medialib-detect.json}"
    local ttl="${MEDIALIB_CACHE_TTL:-300}"
    local lock="${cache}.lock"
    mkdir -p "$(dirname "$cache")" 2>/dev/null || true

    _cache_fresh() {
        [ -s "$cache" ] || return 1
        local age; age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
        [ "$age" -lt "$ttl" ]
    }

    if [ "${MEDIALIB_FORCE:-0}" != "1" ] && _cache_fresh; then
        cat "$cache"; return 0
    fi

    # Le verrou attend plutot que d'echouer : un appelant qui trouve le verrou
    # pris veut le RESULTAT, pas une erreur. Il resservira le cache que le
    # detenteur vient d'ecrire.
    if exec 9>"$lock" 2>/dev/null && flock -w "${MEDIALIB_LOCK_WAIT:-30}" 9 2>/dev/null; then
        # Re-verification APRES le verrou : sans elle, N appelants bloques
        # relancent N balayages a la suite, chacun a son tour, alors que le
        # premier vient d'ecrire le cache.
        if [ "${MEDIALIB_FORCE:-0}" != "1" ] && _cache_fresh; then
            flock -u 9 2>/dev/null
            cat "$cache"; return 0
        fi
        local tmp="${cache}.tmp.$$"
        if _medialib_detect_scan > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
            mv -f "$tmp" "$cache"
            flock -u 9 2>/dev/null
            cat "$cache"; return 0
        fi
        rm -f "$tmp" 2>/dev/null
        flock -u 9 2>/dev/null
    else
        # PAS DE VERROU POSSIBLE (repertoire non inscriptible, par exemple).
        # On balaie quand meme, sans mettre en cache : renvoyer « rien trouve »
        # parce qu'on n'a pas pu ecrire un fichier de verrou serait un mensonge
        # — et c'est indiscernable d'un support vide cote panneau.
        _medialib_detect_scan && return 0
    fi

    if [ -s "$cache" ]; then
        # Cache perime, mais un resultat ancien vaut mieux qu'une reponse vide.
        cat "$cache"
    else
        printf '{"candidates":[],"devices":[],"stale":true}\n'
    fi
}

_medialib_detect_scan() {
    local first=1 path label n
    printf '{"candidates":['
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        [ -d "$path" ] || continue
        n=$(_medialib_audio_count "$path")
        [ "${n:-0}" -gt 0 ] || continue
        label=$(basename -- "$path")
        [ "$first" -eq 1 ] || printf ','
        first=0
        printf '{"path":%s,"label":%s,"audio_files":%s}' \
            "$(_json_str "$path")" "$(_json_str "$label")" "$n"
    done < <(_medialib_candidates | sort -u)
    printf '],"devices":['
    # Peripheriques non montes (#993). Rapportes SEPAREMENT des `candidates` :
    # un chemin deja monte est pret a etre lie, un peripherique demande d'abord
    # un montage hote. Les confondre ferait promettre au panneau une action qui
    # echouerait.
    local dfirst=1 dev dlabel dsize dfs drm
    while IFS=$'\t' read -r dev dlabel dsize dfs drm; do
        [ -n "$dev" ] || continue
        [ "$dfirst" -eq 1 ] || printf ','
        dfirst=0
        printf '{"device":%s,"label":%s,"size":%s,"fstype":%s,"removable":%s,"mounted":false}' \
            "$(_json_str "$dev")" "$(_json_str "$dlabel")" "$(_json_str "$dsize")" \
            "$(_json_str "$dfs")" "$([ "${drm:-0}" = "1" ] && echo true || echo false)"
    done < <(_medialib_block_candidates)
    printf ']}\n'
}

# Monte un peripherique bloc en LECTURE SEULE sous la racine du module, et
# emet le point de montage. Le ro est tenu de bout en bout : une mediatheque
# n'a pas a etre ecrite par le serveur, et HFS+ en ecriture sous Linux est un
# risque connu.
_medialib_mount_device() {
    local dev="$1" label name mntpt
    [ -b "$dev" ] || { printf '{"ok":false,"error":%s}\n' "$(_json_str "not a block device: $dev")" >&2; return 1; }
    label=$(lsblk -no LABEL "$dev" 2>/dev/null | head -1 | tr -d ' ')
    name=$(basename -- "$dev")
    [ -n "$label" ] || label="$name"
    # Nom de repertoire assaini : une etiquette vient du support, donc d'une
    # source non maitrisee, et finit dans un chemin.
    label=$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_')
    mntpt="$MEDIALIB_MOUNT_ROOT/$label"
    if mountpoint -q "$mntpt" 2>/dev/null; then
        printf '%s\n' "$mntpt"; return 0
    fi
    mkdir -p "$mntpt" || return 1
    if ! mount -o ro,noexec,nosuid,nodev "$dev" "$mntpt" 2>/dev/null; then
        rmdir "$mntpt" 2>/dev/null || true
        return 1
    fi
    printf '%s\n' "$mntpt"
}

medialib_mount() {
    local path="$1" cfg mntpt entry
    if [ -z "$path" ]; then
        printf '{"ok":false,"error":"no path given"}\n'; return 1
    fi
    # Un peripherique bloc est d'abord monte cote HOTE, en lecture seule, puis
    # lie dans la LXC. Sans cette etape, « Monter » echouait sur tout support
    # qu'aucun automontage n'avait pris en charge (#993).
    if [ -b "$path" ]; then
        local mounted_at
        if ! mounted_at=$(_medialib_mount_device "$path"); then
            printf '{"ok":false,"error":%s}\n' "$(_json_str "host mount failed for device: $path")"; return 1
        fi
        path="$mounted_at"
    fi
    if [ ! -d "$path" ]; then
        printf '{"ok":false,"error":%s}\n' "$(_json_str "path not found: $path")"; return 1
    fi
    cfg=$(_medialib_cfg)
    # « introuvable » et « illisible » sont deux pannes differentes, et les
    # confondre envoie chercher un fichier absent qui est en fait la. Le
    # repertoire du conteneur appartient a l'idmap (100000:100000, drwxrwx---)
    # et n'est traversable que par root.
    if [ ! -e "$cfg" ] && [ ! -r "$(dirname "$cfg")" ]; then
        printf '{"ok":false,"error":%s}\n' \
            "$(_json_str "config LXC inaccessible ($cfg) — lyrionctl doit tourner en root (sudo)")"
        return 1
    fi
    if [ ! -f "$cfg" ]; then
        printf '{"ok":false,"error":%s}\n' "$(_json_str "config LXC absente : $cfg")"; return 1
    fi
    # READ-ONLY bind, create the target dir on start; idempotent.
    entry="lxc.mount.entry = $path $(_medialib_target "$path") none bind,ro,create=dir 0 0"
    _medialib_strip_cfg "$cfg" "$path"
    printf '%s\n' "$entry" >> "$cfg"
    _medialib_toml_set "$path"

    # MONTER N'EST PAS DECLARER : sans cette etape, LMS reindexe un repertoire
    # qu'il ne scanne pas, et l'utilisateur voit un disque monte dont Lyrion
    # n'affiche rien.
    if _medialib_lms_declare add "$path"; then
        _medialib_lms_restart || err "LMS non redemarre — la preference sera relue au prochain demarrage"
    fi
    # Live-mount (RO) if the container is already running.
    if lxc_running; then
        mntpt=$(_medialib_mntpt "$path")
        mkdir -p "$mntpt" 2>/dev/null || true
        if ! mountpoint -q "$mntpt" 2>/dev/null; then
            mount --bind "$path" "$mntpt" 2>/dev/null \
                && mount -o remount,ro,bind "$mntpt" 2>/dev/null || true
        fi
    fi
    _medialib_trigger_scan
    printf '{"ok":true,"mounted":%s}\n' "$(_json_str "$path")"
}

medialib_unmount() {
    # Un support precis, ou tous si aucun n'est donne. Sans argument, l'ancienne
    # version retirait la seule cible existante ; avec plusieurs supports, il
    # faut pouvoir en detacher un sans perdre les autres.
    local cfg mntpt path="${1:-}"
    cfg=$(_medialib_cfg)
    if [ -n "$path" ]; then
        _medialib_lms_declare remove "$path" >/dev/null 2>&1 && _medialib_lms_restart
        _medialib_strip_cfg "$cfg" "$path"
        mntpt=$(_medialib_mntpt "$path")
        if mountpoint -q "$mntpt" 2>/dev/null; then
            umount "$mntpt" 2>/dev/null || umount -l "$mntpt" 2>/dev/null || true
        fi
    else
        local m
        for m in "$LXC_PATH/$LXC_NAME/rootfs/$MEDIALIB_TARGET"/*; do
            [ -d "$m" ] || continue
            mountpoint -q "$m" 2>/dev/null && { umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true; }
        done
        _medialib_strip_cfg "$cfg"
        _medialib_lms_declare_purge >/dev/null 2>&1 && _medialib_lms_restart
    fi
    _medialib_toml_set ""
    _medialib_trigger_scan
    printf '{"ok":true}\n'
}

# Retire toutes les mediatheques externes des prefs LMS.
_medialib_lms_declare_purge() {
    local prefs; prefs=$(_medialib_lms_prefs)
    [ -f "$prefs" ] || return 1
    python3 - "$prefs" "/${MEDIALIB_TARGET#/}" <<'PY'
import sys
prefs, prefix = sys.argv[1:3]
lines = open(prefs).read().splitlines()
out, i, changed = [], 0, 0
while i < len(lines):
    if lines[i].startswith("mediadirs:"):
        out.append(lines[i]); i += 1
        items = []
        while i < len(lines) and lines[i].startswith("- "):
            items.append(lines[i][2:].strip()); i += 1
        kept = [x for x in items if not x.startswith(prefix + "/")]
        changed = int(len(kept) != len(items))
        out.extend("- " + x for x in kept)
        continue
    out.append(lines[i]); i += 1
if changed:
    open(prefs, "w").write("\n".join(out) + "\n")
raise SystemExit(0 if changed else 1)
PY
}

medialib_status() {
    local ext mounted=false mntpt
    ext=$(config_get "external_medialib" "")
    mntpt=$(_medialib_mntpt)
    mountpoint -q "$mntpt" 2>/dev/null && mounted=true
    if [ -n "$ext" ]; then
        printf '{"external":%s,"mounted":%s}\n' "$(_json_str "$ext")" "$mounted"
    else
        printf '{"external":null,"mounted":%s}\n' "$mounted"
    fi
}

# All medialib output is JSON regardless of a trailing --json (the host API's
# _ctl_json appends it). The first non---json argument to `mount` is the path.
cmd_medialib() {
    local sub="${1:-status}" path=""
    shift || true
    local a
    for a in "$@"; do
        [ "$a" = "--json" ] && continue
        [ -z "$path" ] && path="$a"
    done
    case "$sub" in
        detect)         medialib_detect ;;
        mount)          medialib_mount "$path" ;;
        unmount|umount) medialib_unmount "${3:-}" ;;
        status|--json)  medialib_status ;;
        *) err "unknown verb for 'medialib': $sub"; exit 1 ;;
    esac
}

main() {
    local noun="${1:-help}"
    shift || true
    case "$noun" in
        check-upgrade) cmd_check_upgrade ;;
        version-status) cmd_version_status ;;
        upgrade) cmd_upgrade ;;
        components|status|access|install|reload) "cmd_${noun}" "$@" ;;
        medialib) cmd_medialib "$@" ;;
        ingest) cmd_ingest "$@" ;;
        # The remaining nouns are stubs in v1.0.0 — see #230 task G5 for
        # full implementation. They print a clear "not implemented yet" so
        # the help/grammar surface is consistent now and the API contract
        # is testable.
        player|library|playlist|plugin)
            err "noun '$noun' not yet implemented in v$VERSION — see #244 v1.1.0 follow-up"
            exit 2
            ;;
        --help|-h|help|"") cmd_help ;;
        --version|-V) echo "lyrionctl $VERSION" ;;
        *) err "unknown noun: $noun"; cmd_help; exit 1 ;;
    esac
}

main "$@"
