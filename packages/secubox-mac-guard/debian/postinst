#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    # L'ancien paquet livrait une unité : on la retire sans rien démarrer (nac reprend le rôle).
    systemctl disable --now secubox-mac-guard.service 2>/dev/null || true
    rm -f /etc/systemd/system/multi-user.target.wants/secubox-mac-guard.service
    systemctl daemon-reload || true
fi
#DEBHELPER#
exit 0
