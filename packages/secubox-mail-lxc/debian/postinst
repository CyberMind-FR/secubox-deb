#!/bin/sh
set -e

# Transitional package (secubox-mail-lxc 2.2.0) — clean up the old
# standalone service if it's still around from <2.2 installs.
if [ "$1" = "configure" ]; then
    # #319 /data migration. Move legacy /srv/<dir> → /data/<dir> and leave a
    # symlink behind for back-compat. Idempotent.
    for _d in mail; do
      if [ -d "/srv/$_d" ] && [ ! -L "/srv/$_d" ] && [ ! -e "/data/$_d" ]; then
        mkdir -p /data
        _was_active=""
        if systemctl is-active --quiet secubox-mail-lxc; then
          systemctl stop secubox-mail-lxc || true
          _was_active=1
        fi
        mv "/srv/$_d" "/data/$_d" && ln -s "/data/$_d" "/srv/$_d" \
          && echo "secubox-mail-lxc: migrated /srv/$_d → /data/$_d"
        [ -n "$_was_active" ] && systemctl start secubox-mail-lxc || true
      fi
    done


    if [ -e /lib/systemd/system/secubox-mail-lxc.service ] \
       || [ -e /etc/systemd/system/secubox-mail-lxc.service ]; then
        systemctl stop    secubox-mail-lxc.service 2>/dev/null || true
        systemctl disable secubox-mail-lxc.service 2>/dev/null || true
        rm -f /lib/systemd/system/secubox-mail-lxc.service \
              /etc/systemd/system/secubox-mail-lxc.service
        systemctl daemon-reload || true
    fi
fi

#DEBHELPER#
exit 0
