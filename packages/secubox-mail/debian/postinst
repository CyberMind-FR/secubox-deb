#!/bin/sh
set -e

MAIL_LIB_DIR="/usr/lib/secubox/mail"

if [ "$1" = "configure" ]; then
    # #1169 — non-destructive mail.toml. The package ships only a TEMPLATE
    # under $MAIL_LIB_DIR/config/mail.toml (never straight to /etc, which
    # dpkg would silently overwrite on every upgrade). Fresh install: seed
    # /etc/secubox/mail.toml from the template. Upgrade: merge only the
    # keys/sections that are missing — live values (domain, lxc_path...)
    # are never rewritten. See lib/mail/toml.sh::merge_mail_toml.
    if [ -f "$MAIL_LIB_DIR/lib/toml.sh" ]; then
        . "$MAIL_LIB_DIR/lib/toml.sh"
        install -d -m 0755 /etc/secubox
        if [ ! -f /etc/secubox/mail.toml ] && [ -f "$MAIL_LIB_DIR/config/mail.toml" ]; then
            install -m 0644 "$MAIL_LIB_DIR/config/mail.toml" /etc/secubox/mail.toml
        fi
        if [ -f /etc/secubox/mail.toml ]; then
            merge_mail_toml /etc/secubox/mail.toml
        fi
    fi

    # #319 /data migration. Move legacy /srv/<dir> → /data/<dir> and leave a
    # symlink behind for back-compat. Idempotent.
    for _d in mail; do
      if [ -d "/srv/$_d" ] && [ ! -L "/srv/$_d" ] && [ ! -e "/data/$_d" ]; then
        mkdir -p /data
        _was_active=""
        if systemctl is-active --quiet secubox-mail; then
          systemctl stop secubox-mail || true
          _was_active=1
        fi
        mv "/srv/$_d" "/data/$_d" && ln -s "/data/$_d" "/srv/$_d" \
          && echo "secubox-mail: migrated /srv/$_d → /data/$_d"
        [ -n "$_was_active" ] && systemctl start secubox-mail || true
      fi
    done


    # Phase 1 rev. 2: on upgrade from < 2.2, rewrite legacy toml + run
    # the defensive scanner. Both are idempotent and refuse to touch
    # /data/volumes/mail/vmail user data (spec invariant I13).
    if dpkg --compare-versions "${2:-0}" lt-nl 2.2.0; then
        if [ -x /usr/sbin/mailctl ]; then
            /usr/sbin/mailctl migrate-config || true
        fi
        if [ -x /usr/sbin/mail-migrate-to-single-lxc.sh ]; then
            /usr/sbin/mail-migrate-to-single-lxc.sh || true
        fi
    fi

    # Phase 2: on upgrade from < 2.3, provision Rspamd secrets + data dirs.
    if dpkg --compare-versions "${2:-0}" lt-nl 2.3.0; then
        install -d -m 0700 /etc/secubox/secrets
        if [ ! -s /etc/secubox/secrets/rspamd-controller.pw ]; then
            openssl rand -base64 24 > /etc/secubox/secrets/rspamd-controller.pw
            chmod 0600 /etc/secubox/secrets/rspamd-controller.pw
        fi
        install -d -m 0750 /data/volumes/mail/rspamd \
                           /data/volumes/mail/rspamd/dkim \
                           /data/volumes/mail/rspamd/bayes \
                           /data/volumes/mail/rspamd/history \
                           /data/volumes/mail/rspamd/settings
        # _rspamd uid in unprivileged LXC = 100110 (5000 + 100000-ish; safe to chown blindly)
        chown -R 100110:100110 /data/volumes/mail/rspamd 2>/dev/null || true
    fi

    systemctl daemon-reload
    systemctl enable secubox-mail.service || true
    systemctl start secubox-mail.service || true

    # SSL auto-renew timer (ref #1169 task 10). Guarded like the other units:
    # never fail the install if systemd isn't around (chroot/image build).
    if command -v systemctl >/dev/null 2>&1; then
        systemctl enable --now secubox-mail-ssl-renew.timer >/dev/null 2>&1 || true
    fi

    # Autoconfig XML + SRV Unbound (ref #1169 task 11) — end of board-only
    # drift: the .xml under /usr/share/secubox/www/autoconfig/ is already
    # in place from debian/rules (dh_installdirs owns it, no action needed
    # here). nginx picks up the new secubox.d/secubox-routes.d snippet on
    # its own reload below.
    #
    # SRV drop-in : posé idempotemment dans SON PROPRE fichier, jamais dans
    # 97-secubox-split-horizon.conf (celui du board ne doit jamais être
    # touché par ce paquet). `install` recopie le fichier source à chaque
    # postinst — geste idempotent par construction (contenu figé, aucune
    # variable), donc rien à "append-if-absent" : le simple recopiage
    # suffit et ne perd jamais une modification manuelle du board, puisque
    # ce fichier n'est OWNED que par ce paquet.
    if [ -d /etc/unbound/unbound.conf.d ] && \
       [ -f /usr/share/secubox/mail/unbound/97-mail-srv.conf ]; then
        install -m 0644 /usr/share/secubox/mail/unbound/97-mail-srv.conf \
            /etc/unbound/unbound.conf.d/97-mail-srv.conf
        _unbound_ok=1
        if command -v unbound-checkconf >/dev/null 2>&1; then
            unbound-checkconf >/dev/null 2>&1 || _unbound_ok=""
        fi
        if [ -n "$_unbound_ok" ] && command -v systemctl >/dev/null 2>&1 \
           && systemctl is-active --quiet unbound.service 2>/dev/null; then
            systemctl reload-or-restart unbound.service >/dev/null 2>&1 || true
        fi
    fi

    # Reload nginx (hôte) so the new autoconfig.conf snippet is served
    # immediately, without waiting for the next unrelated reload. Guarded:
    # never fail the install if nginx isn't installed/active (chroot/image
    # build, or this host doesn't run the shared nginx yet).
    if command -v nginx >/dev/null 2>&1; then
        nginx -t >/dev/null 2>&1 && \
        command -v systemctl >/dev/null 2>&1 && \
        systemctl is-active --quiet nginx.service 2>/dev/null && \
        systemctl reload nginx.service >/dev/null 2>&1 || true
    fi
fi

#DEBHELPER#
exit 0
