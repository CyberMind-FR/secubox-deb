#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	# API
	install -d debian/secubox-mail/usr/lib/secubox/mail
	cp -r api debian/secubox-mail/usr/lib/secubox/mail/
	# Greffon Roundcube zipjointes (#1029). Livre dans /usr/share/secubox pour
	# que le postinst le pose DANS le conteneur : /usr/share/roundcube n'existe
	# pas sur l hote, et un conteneur non privilegie n accepte pas qu on ecrive
	# chez lui depuis l exterieur avec la bonne appartenance.
	install -d debian/secubox-mail/usr/share/secubox/roundcube-plugins
	cp -r roundcube/plugins/zipjointes \
	  debian/secubox-mail/usr/share/secubox/roundcube-plugins/

	# Library scripts
	install -d debian/secubox-mail/usr/lib/secubox/mail/lib
	[ -d lib/mail ] && cp -r lib/mail/. debian/secubox-mail/usr/lib/secubox/mail/lib/ || true

	# Rspamd config templates (Phase 2)
	install -d debian/secubox-mail/usr/lib/secubox/mail/templates/rspamd/local.d
	[ -d templates/rspamd ] && cp -r templates/rspamd/. debian/secubox-mail/usr/lib/secubox/mail/templates/rspamd/ || true

	# Control scripts (sbin)
	install -d debian/secubox-mail/usr/sbin
	[ -d sbin ] && install -m 755 sbin/* debian/secubox-mail/usr/sbin/ || true

	# Web interface
	install -d debian/secubox-mail/usr/share/secubox/www/mail
	cp -r www/mail/. debian/secubox-mail/usr/share/secubox/www/mail/

	# Menu entry
	install -d debian/secubox-mail/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-mail/usr/share/secubox/menu.d/ || true

	# Modular nginx config
	install -d debian/secubox-mail/etc/nginx/secubox.d
	[ -f nginx/mail.conf ] && cp nginx/mail.conf debian/secubox-mail/etc/nginx/secubox.d/ || true
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d debian/secubox-mail/etc/nginx/secubox-routes.d
	[ -f nginx/mail.conf ] && cp nginx/mail.conf debian/secubox-mail/etc/nginx/secubox-routes.d/ || true

	# Default config TEMPLATE. Shipped under /usr/lib, NOT /etc: writing it
	# straight to /etc/secubox/mail.toml would make dpkg silently clobber the
	# live file (domain, lxc_path...) on every upgrade, since it is not a
	# dpkg conffile. postinst seeds /etc/secubox/mail.toml from this template
	# on first install and merges only missing keys on upgrade (ref #1169,
	# see lib/mail/toml.sh::merge_mail_toml).
	install -d debian/secubox-mail/usr/lib/secubox/mail/config
	[ -f config/mail.toml ] && install -m 644 config/mail.toml debian/secubox-mail/usr/lib/secubox/mail/config/ || true

	# Sieve global par défaut (Task 6 : spam Rspamd → Junk). Déployé et compilé
	# à l'intérieur du LXC par install_default_sieve() (lib/mail/install.sh).
	install -d debian/secubox-mail/usr/lib/secubox/mail/config/sieve
	[ -f config/sieve/default.sieve ] && install -m 644 config/sieve/default.sieve debian/secubox-mail/usr/lib/secubox/mail/config/sieve/ || true

	# SSL auto-renew unit + timer (ref #1169 task 10). dh_installsystemd only
	# auto-detects the package-named unit (secubox-mail.service); this extra
	# unit needs to be placed in the install tree explicitly (mirror
	# secubox-frigate's diskguard pattern) so dh_installsystemd picks it up
	# for enable/start alongside the postinst systemctl calls below.
	install -d debian/secubox-mail/usr/lib/systemd/system
	install -m 644 debian/secubox-mail-ssl-renew.service debian/secubox-mail/usr/lib/systemd/system/
	install -m 644 debian/secubox-mail-ssl-renew.timer debian/secubox-mail/usr/lib/systemd/system/
