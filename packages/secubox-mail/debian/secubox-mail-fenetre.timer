[Unit]
Description=SecuBox Mail — fenêtres de relance du conteneur mail (04:52, lundi 07:07, 18:02 ; #3925)

[Timer]
# 04:52 + 90 min couvre les rapports de 05:07 et 05:34 ; le lundi 07:07 couvre celui de 07:20. Minutes hors multiples
# de 5 : pas de collision avec la veille (*:0/5).
OnCalendar=*-*-* 04:52
OnCalendar=Mon *-*-* 07:07
# Réception du soir : les expéditeurs externes qui réessayent.
OnCalendar=*-*-* 18:02
Persistent=false

[Install]
WantedBy=timers.target
