[Unit]
Description=SecuBox Mail — fenêtres de relance du conteneur mail (04:50, lundi 07:05, 18:00 ; #3925)

[Timer]
# 04:50 + 90 min couvre les rapports de 05:07 et 05:34 ; le lundi 07:05 couvre celui de 07:20.
OnCalendar=*-*-* 04:50
OnCalendar=Mon *-*-* 07:05
# Réception du soir : les expéditeurs externes qui réessayent.
OnCalendar=*-*-* 18:00
Persistent=false

[Install]
WantedBy=timers.target
