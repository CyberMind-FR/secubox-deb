[Unit]
Description=SecuBox Mail — rapatriement des boîtes IMAP distantes toutes les 15 min (#3033)

[Timer]
OnBootSec=3min
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redéclenche pas après une réactivation.
OnActiveSec=3min
OnUnitActiveSec=15min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
