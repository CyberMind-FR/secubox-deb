[Unit]
Description=SecuBox Mail — rapatriement des boîtes IMAP distantes toutes les 15 min (#3033)

[Timer]
OnBootSec=3min
# Sur l horloge (#3692, #3693) : relative à la dernière exécution, la minuterie s est arrêtée le 06/11 sur gk2.
OnCalendar=*:0/15
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
