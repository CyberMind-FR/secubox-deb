[Unit]
Description=SecuBox Mail — veille des services de courrier toutes les 5 min (#3842)

[Timer]
OnBootSec=5min
# Sur l horloge (#3692) : une minuterie relative à la dernière exécution peut s arrêter après une réactivation.
OnCalendar=*:0/5
Persistent=false

[Install]
WantedBy=timers.target
