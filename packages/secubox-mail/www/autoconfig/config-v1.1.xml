<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="secubox.in">
    <domain>secubox.in</domain>
    <domain>gk2.secubox.in</domain>
    <displayName>SecuBox Mail</displayName>
    <displayShortName>SecuBox</displayShortName>
    <incomingServer type="imap">
      <hostname>mail.secubox.in</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>mail.secubox.in</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
</clientConfig>
