#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_install:
	install -D -m 0440 sudoers.d/secubox-mastodon \
		debian/secubox-mastodon/etc/sudoers.d/secubox-mastodon
	install -d debian/secubox-mastodon/usr/lib/secubox/mastodon
	cp -r api debian/secubox-mastodon/usr/lib/secubox/mastodon/
	install -d debian/secubox-mastodon/usr/sbin
	install -m 0755 sbin/mastodonctl debian/secubox-mastodon/usr/sbin/mastodonctl
	install -d debian/secubox-mastodon/usr/share/secubox/lib/mastodon
	install -m 0755 lib/mastodon/install-lxc.sh debian/secubox-mastodon/usr/share/secubox/lib/mastodon/
	install -d debian/secubox-mastodon/usr/share/secubox/www/mastodon
	install -m 0644 www/mastodon/index.html debian/secubox-mastodon/usr/share/secubox/www/mastodon/
	install -d debian/secubox-mastodon/usr/share/secubox/menu.d
	install -m 0644 menu.d/815-mastodon.json debian/secubox-mastodon/usr/share/secubox/menu.d/
	install -d debian/secubox-mastodon/etc/nginx/secubox-routes.d
	install -m 0644 nginx/mastodon.conf debian/secubox-mastodon/etc/nginx/secubox-routes.d/
	# Vhost de l'instance : LIVRE, NON ACTIVE. Activer demande aussi HAProxy et
	# le DNS, qu'un paquet ne decide pas seul.
	install -d debian/secubox-mastodon/etc/nginx/sites-available
	install -m 0644 conf/mastodon.nginx.conf debian/secubox-mastodon/etc/nginx/sites-available/mastodon.conf
	# Entretien periodique de l'instance federee. Mastodon accumule
	# indefiniment les medias distants, les cartes d'apercu et les statuts
	# d'auteurs que plus personne ne suit : rien n'est nettoye tout seul, la
	# documentation amont le confie a l'exploitant. Constate sur gk2 le
	# 2026-08-12 : aucun minuteur, aucune entree cron.
	install -d debian/secubox-mastodon/lib/systemd/system
	install -m 0644 systemd/secubox-mastodon-entretien.service \
	  debian/secubox-mastodon/lib/systemd/system/
	install -m 0644 systemd/secubox-mastodon-entretien.timer \
	  debian/secubox-mastodon/lib/systemd/system/
	install -d debian/secubox-mastodon/etc/secubox
	install -m 0644 conf/mastodon.toml.example debian/secubox-mastodon/etc/secubox/mastodon.toml.example
	install -d debian/secubox-mastodon/usr/share/doc/secubox-mastodon
	install -m 0644 README.md debian/secubox-mastodon/usr/share/doc/secubox-mastodon/

# LIVREE MAIS NON ACTIVEE, et --restart-after-upgrade est INDISPENSABLE avec
# --no-start : sans lui, chaque `dpkg -i` laisse le service arrete alors que
# l'operateur l'avait active. « Ne pas activer d'office » et « couper ce qui
# tourne » sont deux choses differentes.
override_dh_installsystemd:
	# --exclude EST INDISPENSABLE : sans lui, ce premier appel traite AUSSI le
	# minuteur d'entretien et lui pose un « ne pas activer ». Le second appel
	# n'a alors plus rien a faire, et le minuteur reste desactive — constate a
	# l'installation, il fallait l'activer a la main.
	dh_installsystemd --no-enable --no-start --restart-after-upgrade \
	  --exclude=secubox-mastodon-entretien
	# L'ENTRETIEN, LUI, EST ACTIVE. Ne pas activer d'office vaut pour le service
	# de l'instance — qui demande HAProxy et le DNS — pas pour un menage
	# hebdomadaire dont l'absence laisse le disque se remplir sans borne. Il est
	# active sans etre demarre : il se declenchera au prochain dimanche.
	dh_installsystemd --no-start secubox-mastodon-entretien.timer
