#!/bin/bash
set -e
case "$1" in
  remove|upgrade)
    # Remove nginx location config
    rm -f /etc/nginx/secubox.d/media.conf
    # Stop and disable service
    systemctl stop    secubox-media.service 2>/dev/null || true
    systemctl disable secubox-media.service 2>/dev/null || true
    # Reload nginx to remove location
    systemctl reload nginx 2>/dev/null || true
    ;;
esac
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/media/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "media : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
