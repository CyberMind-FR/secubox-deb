#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	# API files
	install -d debian/secubox-media/usr/lib/secubox/media/
	cp -r api debian/secubox-media/usr/lib/secubox/media/
	# Static www files
	install -d debian/secubox-media/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-media/usr/share/secubox/www/ || true
	# Menu definitions
	install -d debian/secubox-media/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-media/usr/share/secubox/menu.d/ || true
	# Modular nginx config
	install -d debian/secubox-media/etc/nginx/secubox.d
	[ -f nginx/media.conf ] && cp nginx/media.conf debian/secubox-media/etc/nginx/secubox.d/ || true
	# Surface privilégiée unique du module.
	install -d debian/secubox-media/usr/sbin
	install -m 0755 sbin/mediactl debian/secubox-media/usr/sbin/mediactl
	# Racines declarees : source unique du confinement. Conffile — une
	# racine ajoutee par l'administrateur survit aux mises a jour.
	install -d debian/secubox-media/etc/secubox
	install -m 0644 etc/media.roots debian/secubox-media/etc/secubox/media.roots
	install -d debian/secubox-media/etc/sudoers.d
	install -m 0440 debian/secubox-media.sudoers debian/secubox-media/etc/sudoers.d/secubox-media
	# Route nginx dans les DEUX répertoires (#989) : le vhost principal
	# n'inclut que secubox-routes.d.
	install -d debian/secubox-media/etc/nginx/secubox.d debian/secubox-media/etc/nginx/secubox-routes.d
	install -m 0644 nginx/media.conf debian/secubox-media/etc/nginx/secubox.d/media.conf
	install -m 0644 nginx/media.conf debian/secubox-media/etc/nginx/secubox-routes.d/media.conf
	# Drainage de la file de transfert.
	install -d debian/secubox-media/usr/lib/systemd/system
	install -m 0644 debian/secubox-media-drain.service debian/secubox-media/usr/lib/systemd/system/
	install -m 0644 debian/secubox-media-drain.timer debian/secubox-media/usr/lib/systemd/system/
	install -m 0644 debian/secubox-media-automount.service debian/secubox-media/usr/lib/systemd/system/
	# Composant absorbé : smb (#2050)
	install -d debian/secubox-media/etc/ksmbd
	install -m 0644 composants/smb/etc/ksmbd.conf debian/secubox-media/etc/ksmbd/ksmbd.conf
	install -d debian/secubox-media/etc/nftables.d
	install -m 0644 composants/smb/nft/zz-secubox-smb.nft debian/secubox-media/etc/nftables.d/zz-secubox-smb.nft
	install -d debian/secubox-media/etc/avahi/services
	install -m 0644 composants/smb/avahi/secubox-smb.service debian/secubox-media/etc/avahi/services/secubox-smb.service
	install -d debian/secubox-media/usr/sbin
	install -m 0755 composants/smb/sbin/smbctl debian/secubox-media/usr/sbin/smbctl
	install -D -m 755 composants/smb/debian/postinst debian/secubox-media/usr/lib/secubox/media/maintscripts/smb.postinst
	install -D -m 755 composants/smb/debian/prerm debian/secubox-media/usr/lib/secubox/media/maintscripts/smb.prerm
	# Composant absorbé : freeboxtv (#2050)
	install -d debian/secubox-media/usr/share/secubox/freeboxtv/
	cp -r composants/freeboxtv/api debian/secubox-media/usr/share/secubox/freeboxtv/
	install -D -m0644 composants/freeboxtv/conf/freeboxtv.toml \
	  debian/secubox-media/etc/secubox/freeboxtv.toml
	install -d debian/secubox-media/usr/lib/systemd/system
	cp composants/freeboxtv/systemd/secubox-freeboxtv.service \
	  debian/secubox-media/usr/lib/systemd/system/
	install -D -m 755 composants/freeboxtv/debian/postinst debian/secubox-media/usr/lib/secubox/media/maintscripts/freeboxtv.postinst
