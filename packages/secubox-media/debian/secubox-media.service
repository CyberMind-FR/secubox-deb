[Unit]
Description=SecuBox Media API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/media
# `python3 -m uvicorn` : /usr/bin/uvicorn n'existe pas sur la board.
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/media.sock --log-level warning
Restart=on-failure
RestartSec=5
PrivateTmp=true
# false, et NON true : cette API sudo son ctl confine (webui -> ctl).
# NoNewPrivileges=true neutralise sudo — « the "no new privileges" flag is
# set, which prevents sudo from running as root » — et toute action devient
# une erreur visible dans le panneau. Le reste du durcissement reste.
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox

[Install]
WantedBy=multi-user.target
