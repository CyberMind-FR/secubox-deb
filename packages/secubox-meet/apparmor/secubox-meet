# Profil AppArmor ENFORCE de l'API hôte secubox-meet (#3154). Posé dans /etc/apparmor.d/secubox-meet, chargé par le postinst
# AVANT le démarrage de l'unité (qui le nomme par AppArmorProfile=). L'actionneur root (meetctl) tourne hors confinement via sudo.

#include <tunables/global>

profile secubox-meet-api {
  #include <abstractions/base>
  #include <abstractions/python>

  /usr/bin/python3* rix,
  /usr/lib/secubox/meet/** r,
  /usr/lib/secubox/ r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /usr/local/lib/python3*/** r,

  # Configuration et authentification : fichiers nommés, jamais /etc/secubox/** (le dossier des secrets reste interdit).
  /etc/secubox/ r,
  /etc/secubox/meet.toml r,
  /etc/secubox/secubox.conf r,
  /etc/secubox/auth.toml r,
  /etc/secubox/users.json r,
  /etc/secubox/appareils.json r,
  deny /etc/secubox/secrets/** r,
  /etc/nsswitch.conf r,
  # Registre des sessions (sans lui toute garde d'API refuse) et trace de délégation.
  /var/lib/secubox/auth/ r,
  /var/lib/secubox/auth/** r,
  /var/log/secubox/delegation.log w,
  /var/log/secubox/garde-origine.log w,

  # Cache d'état de l'API.
  /var/cache/secubox/meet/ r,
  /var/cache/secubox/meet/** rwk,

  # Activité de la visio (#3182) : base écrite par le relevé root, LUE ici seulement. k : SQLite verrouille même en lecture
  # (sans lui, « database is locked » : 500 sur /connexions et /stats, gk1 2026-10-26) ; journal à chaud vérifié en lecture.
  /var/lib/secubox-meet/ r,
  /var/lib/secubox-meet/activite.db rk,
  /var/lib/secubox-meet/activite.db-journal r,

  /run/secubox/ r,
  /run/secubox/meet.sock rwk,
  /run/secubox/meet.sock.lock rwk,

  # Le SEUL passage privilégié : sudo -> meetctl (règle sudoers étroite), hors confinement.
  /usr/bin/sudo Ux,

  network unix stream,
  network unix dgram,
  /proc/sys/net/core/somaxconn r,
}
