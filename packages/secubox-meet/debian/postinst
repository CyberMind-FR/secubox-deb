# Source-Disclosed License — All rights reserved except as expressly granted.
# See LICENCE-CMSD-1.0.md for terms.
set -e
case "$1" in
  configure)
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home \
        --home /var/lib/secubox --shell /usr/sbin/nologin secubox

    # Parents PARTAGÉS : créés seulement s'ils manquent, jamais resserrés ni
    # réattribués. `install -d` impose mode et propriétaire à un dossier qui
    # existe déjà : /etc/secubox appartient à secubox (l'agrégateur y écrit
    # users.json), /etc/secubox/secrets est root:secubox 0750 avec des ACL de
    # traversée (le fournisseur OIDC y lit sa clé de signature).
    [ -d /etc/secubox ] || install -d -m 0755 /etc/secubox
    [ -d /etc/secubox/secrets ] || install -d -o root -g secubox -m 0750 /etc/secubox/secrets
    [ -d /var/cache/secubox ] || install -d -m 0755 /var/cache/secubox
    [ -d /var/lib/secubox ] || install -d -m 0755 /var/lib/secubox
    # Feuilles du module seulement.
    install -d -o root -g root -m 0755 /etc/secubox/meet
    install -d -o root -g root -m 0700 /etc/secubox/secrets/meet
    install -d -o secubox -g secubox -m 0755 /var/cache/secubox/meet
    # Publications de ports décidées par un administrateur (lues par le panneau),
    # dossier commun à tous les modules qui publient des ports.
    if getent group secubox >/dev/null 2>&1; then
      [ -d /var/lib/secubox/ports-publics.d ] || install -d -o root -g secubox -m 0755 /var/lib/secubox/ports-publics.d
    else
      [ -d /var/lib/secubox/ports-publics.d ] || install -d -m 0755 /var/lib/secubox/ports-publics.d
    fi

    if [ ! -f /etc/secubox/meet.toml ] && [ -f /usr/share/doc/secubox-meet/examples/meet.toml.example ]; then
      cp /usr/share/doc/secubox-meet/examples/meet.toml.example /etc/secubox/meet.toml
      chown root:secubox /etc/secubox/meet.toml
      chmod 640 /etc/secubox/meet.toml
    fi

    # Jamais de sudoers cassé laissé en place.
    if [ -f /etc/sudoers.d/secubox-meet ]; then
      visudo -cf /etc/sudoers.d/secubox-meet >/dev/null 2>&1 || rm -f /etc/sudoers.d/secubox-meet
    fi

    # Profil AppArmor (enforce), chargé AVANT l'activation de l'unité qui le nomme.
    # Sans AppArmor actif sur la machine, l'unité démarre sans profil ; avec AppArmor actif
    # et un profil non chargé, elle échouerait au démarrage : on ne la lance alors pas.
    PROFIL_PRET=1
    if [ -d /sys/kernel/security/apparmor ]; then
      if [ -f /etc/apparmor.d/secubox-meet ] && command -v apparmor_parser >/dev/null 2>&1 \
         && apparmor_parser -r /etc/apparmor.d/secubox-meet; then
        :
      else
        PROFIL_PRET=0
        echo "secubox-meet : profil AppArmor secubox-meet-api non chargé : l'API ne démarrera pas tant que le profil n'est pas chargé (apparmor_parser -r /etc/apparmor.d/secubox-meet) ; voir journalctl -k" >&2
      fi
    fi

    systemctl daemon-reload 2>/dev/null || true
    # API de l'hôte (unité livrée par une tâche ultérieure : sans effet tant qu'absente).
    if [ -f /usr/lib/systemd/system/secubox-meet.service ]; then
      if [ "$PROFIL_PRET" = 1 ]; then
        systemctl enable --now secubox-meet.service || true
      else
        systemctl enable secubox-meet.service || true
        echo "secubox-meet : service activé mais NON démarré (profil AppArmor absent)" >&2
      fi
    fi

    # Relevé de l'activité de la visio (#3182) : root, toutes les 5 minutes ; base lue par l'API (groupe secubox). Sous
    # /var/lib (root), jamais sous /var/lib/secubox, qui appartient au compte partagé secubox (relecture : un lien glissé là
    # aurait détourné les écritures root). 0.2.0 l'y avait mise : retirée (le relevé suivant reprend 30 jours de journal).
    install -d -m 0750 -o root -g secubox /var/lib/secubox-meet 2>/dev/null || true
    if [ -d /var/lib/secubox/meet ] && [ ! -L /var/lib/secubox/meet ]; then
      rm -f -- /var/lib/secubox/meet/activite.db /var/lib/secubox/meet/activite.db-journal
      rmdir /var/lib/secubox/meet 2>/dev/null || true
    fi
    if [ -f /usr/lib/systemd/system/secubox-meet-activite.timer ]; then
      systemctl enable --now secubox-meet-activite.timer || true
    fi

    # Vhosts visio.<domaine> et livekit.<domaine>. La route sbxwaf et le vhost
    # HAProxy ne valent que si nginx accepte la configuration : poser l'un sans
    # l'autre échange un 421 contre un 502.
    if command -v nginx >/dev/null 2>&1 && [ -f /etc/nginx/sites-available/visio.conf ] \
       && [ -f /etc/nginx/sites-available/livekit.conf ]; then
      ln -sf ../sites-available/visio.conf /etc/nginx/sites-enabled/visio.conf
      ln -sf ../sites-available/livekit.conf /etc/nginx/sites-enabled/livekit.conf
      if NT=$(nginx -t 2>&1); then
        HAP_A_RECHARGER=0
        for NOM in visio livekit; do
          DOMAINE="$(secubox-domaine "$NOM" 2>/dev/null || true)"
          [ -n "$DOMAINE" ] || continue
          command -v secubox-waf-route >/dev/null 2>&1 && { secubox-waf-route "$DOMAINE" 9080 || true; }
          if command -v haproxyctl >/dev/null 2>&1 && [ -f /etc/secubox/haproxy.toml ] \
             && ! grep -q "\"$DOMAINE\"" /etc/secubox/haproxy.toml 2>/dev/null; then
            haproxyctl vhost add "$DOMAINE" sbxwaf_inspector true >/dev/null 2>&1 || true
            HAP_A_RECHARGER=1
          fi
        done
        if [ "$HAP_A_RECHARGER" = 1 ]; then
          haproxyctl generate >/dev/null 2>&1 || true
          systemctl reload haproxy >/dev/null 2>&1 || true
        fi
      else
        echo "secubox-meet : nginx -t a échoué, vhosts visio et livekit NON activés : $NT" >&2
        rm -f /etc/nginx/sites-enabled/visio.conf /etc/nginx/sites-enabled/livekit.conf
      fi
    fi
    if systemctl is-active --quiet nginx 2>/dev/null; then
      if nginx -t >/dev/null 2>&1; then systemctl reload nginx 2>/dev/null || true; fi
    fi

    # DÉLIBÉRÉ : la règle nftables des ports média n'est PAS appliquée ici.
    # Ouvrir des ports entrants est une décision d'exposition, pas un effet de
    # bord d'un « apt install » : elle se prend depuis la page /meet/ ou par
    # meetctl, et l'exemple est livré dans /usr/share/doc/secubox-meet/examples/.
    ;;
esac
#DEBHELPER#

# Le provisionnement est démarré APRÈS le bloc debhelper, délibérément.
#
# Ce bloc injecte un redémarrage des unités du paquet. Démarré AVANT, le
# provisionnement se ferait tuer en pleine création du conteneur, laissant un
# conteneur à moitié créé que la relance refuse ensuite de reprendre.
#
# NOTE : ne jamais écrire le jeton de substitution debhelper en toutes lettres
# dans un commentaire de ce fichier : il est remplacé partout où il apparaît.
#
# En arrière-plan (--no-block) : debootstrap, compilation du front et
# environnement Python prennent 15 à 30 minutes et demandent du réseau. L'unité
# est un no-op après une mise en route réussie (ConditionPathExists).
case "$1" in
  configure)
    systemctl enable secubox-meet-provision.service 2>/dev/null || true
    systemctl start --no-block secubox-meet-provision.service 2>/dev/null || true
    if [ -f /etc/secubox/meet/.lxc-provisioned ]; then
      # Réinstallation après « apt remove » : le prerm a coupé l'autostart et
      # arrêté le conteneur ; sans cela Meet resterait arrêté, même au démarrage.
      meetctl autostart on >/dev/null 2>&1 || true
      meetctl start >/dev/null 2>&1 || true
      # Mise à jour : nouveau rendu (configuration, secrets, version de Meet) en
      # arrière-plan, jamais bloquant pour dpkg. L'unité de provisionnement est un
      # no-op une fois la sentinelle posée : sans ce rendu, rien n'atteindrait
      # les services du conteneur.
      if [ -n "${2:-}" ]; then
        systemctl start --no-block secubox-meet-rerendu.service 2>/dev/null || true
      fi
    fi
    ;;
esac
exit 0
