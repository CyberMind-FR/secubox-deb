set -e
case "$1" in
  remove)
    systemctl stop secubox-meet.service secubox-meet-provision.service 2>/dev/null || true
    # Les ports médias ne restent jamais ouverts vers un conteneur arrêté.
    meetctl media-expose --revoke || true
    meetctl stop || true
    ;;
esac
#DEBHELPER#
exit 0
