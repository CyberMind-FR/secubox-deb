#
# Toutes les 5 minutes. OnActiveSec : la minuterie repart aussi après une réactivation faite après le démarrage
# (mise à jour du paquet), ce que OnBootSec + OnUnitActiveSec seuls ne font pas (#2919).
[Unit]
Description=SecuBox Meet — relevé de l'activité de la visio toutes les 5 minutes

[Timer]
# #3355 : décalage aléatoire stable par box (FixedRandomDelay), pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=75s
FixedRandomDelay=true
AccuracySec=30s
OnBootSec=3min
OnActiveSec=1min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
