#
# SecuBox-Deb :: Meet — nouveau rendu après une mise à jour du paquet.
#
# Démarrée --no-block par le postinst d'une MISE À JOUR, seulement si le
# conteneur est déjà provisionné (sentinelle). install-lxc.sh est idempotent :
# il rend les configurations et les secrets, reconstruit si la version de Meet
# a changé, puis ne relance que les services dont une entrée a changé. Aucune
# condition sur la sentinelle ici (contrairement à secubox-meet-provision.service,
# le postinst la vérifie) et aucune section d'installation : jamais démarrée au boot.
[Unit]
Description=SecuBox Meet — nouveau rendu de la configuration du conteneur
Documentation=https://github.com/CyberMind-FR/secubox-deb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/secubox/meet/install-lxc.sh
TimeoutStartSec=3600
