[Unit]
Description=SecuBox Meet — API hôte (La Suite Meet en LXC)
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
# Profil chargé par le postinst avant le démarrage (apparmor/secubox-meet).
AppArmorProfile=secubox-meet-api
# /run/secubox est partagé et collé (1777) : on n'y délie que ce qu'on possède.
# Le préfixe `+` exécute en root malgré User=. Pas de RuntimeDirectory= (#1022).
ExecStartPre=+/bin/rm -f /run/secubox/meet.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/meet.sock --workers 1
WorkingDirectory=/usr/lib/secubox/meet
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# sudo -> meetctl exige de nouveaux privilèges : la règle sudoers étroite et la
# validation de meetctl sont la frontière de sécurité.
NoNewPrivileges=no
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/secubox /var/cache/secubox/meet /var/log/secubox

[Install]
WantedBy=multi-user.target
