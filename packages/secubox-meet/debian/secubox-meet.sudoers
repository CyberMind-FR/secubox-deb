# SecuBox Meet — le panneau/API non privilégié (utilisateur `secubox`) pilote le
# LXC Meet via meetctl. C'est la SEULE surface privilégiée du module (cycle de
# vie du conteneur, journaux, exposition média), confinée : le ctl valide
# lui-même ses entrées (liste blanche d'unités).
secubox ALL=(root) NOPASSWD: /usr/sbin/meetctl
