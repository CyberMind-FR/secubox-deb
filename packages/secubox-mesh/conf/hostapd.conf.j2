{# Spec : CM-MESH-MPCIE-2026-06 §6 — AP Passpoint/HS2.0 #}
# Generated by secubox-mesh — DO NOT EDIT
interface={{ radio.iface }}
ssid={{ ap.ssid }}
country_code={{ reg.country }}
hw_mode={{ 'a' if ap.band == '5g' else 'g' }}
ieee80211n=1
ieee80211d=1
ieee80211h={{ 1 if reg.dfs and ap.band == '5g' else 0 }}
ieee80211w=2

# WPA3-SAE (Passpoint Release 3 cible — fallback WPA2-PSK désactivé)
auth_algs=1
wpa=2
wpa_key_mgmt=SAE
rsn_pairwise=CCMP
sae_require_mfp=1

{% if ap.hs20 %}
# Hotspot 2.0 / Passpoint
interworking=1
access_network_type=2
internet=1
hs20=1
hs20_release=3
{% endif %}
{% if ap.anqp %}
# ANQP minimal — à enrichir selon réalité métier
venue_name=eng:SecuBox-Gondwana-Air
domain_name=secubox.in
{% endif %}
