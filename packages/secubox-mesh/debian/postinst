#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: MESH — postinst
set -e

case "$1" in
  configure)
    # 1. User système pour le service (CSPN : séparation de privilèges)
    if ! getent passwd secubox-mesh >/dev/null; then
      adduser --system --group --no-create-home \
              --home /nonexistent --shell /usr/sbin/nologin \
              --gecos "SecuBox-Deb MESH" secubox-mesh
    fi

    # 2. Dossier secrets (mesh-sae). Le parent est partagé et appartient à
    # secubox-core (root:secubox 0750, #1689) : s'en attribuer la propriété
    # (secubox-mesh 0700) coupait tous les autres modules. mesh reçoit une ACL
    # de traversée, comme bbs.
    install -d -o root -g secubox -m 0750 /etc/secubox/secrets
    if command -v setfacl >/dev/null 2>&1; then
        setfacl -m u:secubox-mesh:--x /etc/secubox/secrets 2>/dev/null || true
    fi

    # 3. Dossier log dédié au module.
    # /run/secubox PARENT est platform-managed par secubox-core en 1777 root:root.
    # NE PAS le toucher ici — l'écraser bloque la traversée nginx (www-data) et
    # casse tous les /api/v1/<module>/* en 502 (cf. #471). Si besoin d'un
    # sous-dossier privé, utiliser /run/secubox/mesh/ (et non le parent).
    install -d -m 0755 -o secubox-mesh -g secubox-mesh /var/log/secubox

    # 4. Verrou régulatoire FR (idempotent ; ne pas planter si iw absent)
    if command -v iw >/dev/null 2>&1; then
      iw reg set FR || true
    fi

    # 5. Recharger udev (pour la règle MT7632U fraîchement déposée)
    if command -v udevadm >/dev/null 2>&1; then
      udevadm control --reload || true
    fi

    # 6. systemd : activation par deb-systemd-helper ci-dessous (hors test systemd), puis daemon-reload + restart
    # #3411 : activation HORS du test systemd — dans le chroot d'une image il est faux et l'unite restait
    # desactivee sur la box flashee ; deb-systemd-helper travaille sur le systeme de fichiers. Le demarrage reste conditionne.
    # Motif debhelper : un disable manuel de l'operateur survit a la mise a jour.
    for _u in secubox-mesh.service; do
      if deb-systemd-helper --quiet was-enabled "$_u"; then
        deb-systemd-helper enable "$_u" >/dev/null || true
      else
        deb-systemd-helper update-state "$_u" >/dev/null || true
      fi
    done
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      # Si l'ancien 1.1.0 tournait, on le bascule en douceur (restart, pas mass)
      systemctl restart secubox-mesh.service || true
    fi
    ;;
esac

#DEBHELPER#
exit 0
