[Unit]
Description=SecuBox-Deb MESH control plane (FastAPI/Uvicorn)
Documentation=https://github.com/CyberMind-FR/secubox-deb/blob/master/docs/specs/CM-MESH-MPCIE-2026-06.md
After=network.target

[Service]
Type=simple
User=secubox-mesh
Group=secubox-mesh
ExecStart=/usr/bin/uvicorn secubox_mesh.app:app --host 127.0.0.1 --port 8743
Restart=on-failure
RestartSec=3

# CSPN durcissement (cf. CLAUDE.md root §Règles CSPN / Sécurité formelle)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false        # besoin de /dev/net/tun éventuel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Sockets/files autorisés
ReadWritePaths=/run/secubox /var/log/secubox
ReadOnlyPaths=/etc/secubox

# Capabilities — aucune par défaut. Le bring-up RF (iw, wpa_supplicant) est
# délégué à des helpers root via systemd-run (hors plan API courant).
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
