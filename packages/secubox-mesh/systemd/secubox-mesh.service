[Unit]
Description=SecuBox-Deb MESH control plane (FastAPI/Uvicorn)
Documentation=https://github.com/CyberMind-FR/secubox-deb/blob/master/docs/specs/CM-MESH-MPCIE-2026-06.md
After=network.target

[Service]
Type=simple
User=secubox-mesh
Group=secubox
# Le module Python est installé sous /usr/lib/secubox/mesh/ (pas de venv).
# Pattern hérité de secubox-meshname, lyrion, etc. — voir CLAUDE.md root.
Environment="PYTHONPATH=/usr/lib/secubox/mesh"
# Socket Unix, jamais un port TCP (#2050). Voir secubox-surf.service pour le motif du « + » et du chmod 660.
ExecStartPre=+/bin/rm -f /run/secubox/mesh.sock
ExecStart=/usr/bin/python3 -m uvicorn secubox_mesh.app:app --uds /run/secubox/mesh.sock --log-level warning
ExecStartPost=/bin/sh -c 'for i in $(seq 1 1200); do [ -S /run/secubox/mesh.sock ] && break; sleep 0.1; done; chmod 660 /run/secubox/mesh.sock'
TimeoutStartSec=180
Restart=on-failure
RestartSec=3

# CSPN durcissement (cf. CLAUDE.md root §Règles CSPN / Sécurité formelle)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# PrivateDevices stays false: besoin de /dev/net/tun éventuel
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Sockets/files autorisés
ReadWritePaths=/run/secubox /var/log/secubox
ReadOnlyPaths=/etc/secubox

# Capabilities — aucune par défaut. Le bring-up RF (iw, wpa_supplicant) est
# délégué à des helpers root via systemd-run (hors plan API courant).
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
