#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
set -e

case "$1" in
    configure)
        # Create secubox-meshtastic system user/group if missing (idempotent,
        # mirrors packages/secubox-profiles/debian/postinst's secubox user).
        # In `dialout` so the daemon can open /dev/ttyUSB*/ttyACM* even
        # without the DeviceAllow cgroup rules in the unit (belt+braces, see
        # systemd/secubox-meshtasticd.service).
        getent group secubox-meshtastic >/dev/null || addgroup --system secubox-meshtastic
        getent passwd secubox-meshtastic >/dev/null || adduser --system --ingroup secubox-meshtastic \
            --no-create-home --home /nonexistent --shell /usr/sbin/nologin \
            --gecos "SecuBox Meshtastic" secubox-meshtastic
        adduser secubox-meshtastic dialout >/dev/null 2>&1 || true

        # Shared parents MUST stay 0755 traversable-by-all (ref #511/#474 —
        # narrowing a shared parent like /etc/secubox, /var/log/secubox or
        # /var/cache/secubox to 0750 breaks every OTHER secubox-* daemon's
        # access to its own leaf dir under it). Only the leaf dirs below are
        # restricted to this module's own user.
        install -d -o root -g root -m 0755 /etc/secubox
        install -d -o root -g root -m 0755 /var/log/secubox
        install -d -o root -g root -m 0755 /var/cache/secubox
        install -d -o root -g root -m 0755 /etc/secubox/secrets

        # Leaf dirs owned by secubox-meshtastic.
        install -d -o secubox-meshtastic -g secubox-meshtastic -m 0700 /etc/secubox/secrets/meshtastic
        install -d -o secubox-meshtastic -g secubox-meshtastic -m 0750 /var/cache/secubox/meshtastic
        install -d -o secubox-meshtastic -g secubox-meshtastic -m 0750 /var/log/secubox/meshtastic

        # Seed the default config on first install only — never clobber an
        # operator-edited /etc/secubox/meshtastic.toml on upgrade.
        if [ ! -e /etc/secubox/meshtastic.toml ]; then
            install -o root -g secubox-meshtastic -m 0640 \
                /usr/share/secubox/meshtastic/meshtastic.toml.example \
                /etc/secubox/meshtastic.toml
        fi

        # Own dedicated socket, own service — never served by the aggregator
        # (a radio/serial-attached daemon must not depend on something it
        # may later restart, and the aggregator loop must not block on
        # serial I/O — see systemd/secubox-meshtasticd.service). It runs
        # fine with `radio: absent` (no device attached yet, ref #897).
        systemctl daemon-reload 2>/dev/null || true
        systemctl enable --now secubox-meshtasticd.service 2>/dev/null || true
        systemctl try-restart secubox-meshtasticd.service 2>/dev/null || true

        systemctl reload nginx 2>/dev/null || true
        ;;
esac

#DEBHELPER#
exit 0
