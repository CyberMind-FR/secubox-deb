set -e

if [ "$1" = "remove" ]; then
    systemctl stop secubox-meshtasticd.service 2>/dev/null || true
    systemctl disable secubox-meshtasticd.service 2>/dev/null || true
    systemctl reload nginx 2>/dev/null || true
fi

#DEBHELPER#
exit 0
