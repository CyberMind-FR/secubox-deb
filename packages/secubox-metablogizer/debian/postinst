#!/bin/bash
set -e
mkdir -p /run/secubox /srv/metablogizer/sites
# #494: do NOT chown the shared parent /run/secubox (owned by tmpfiles.d at
# 1777 root root). Only own this module's own data dir.
chown secubox:secubox /srv/metablogizer/sites 2>/dev/null || true
# LE FICHIER UNIFIÉ DES SITES (#1823). Le générateur (compte secubox, et dans
# l'agrégateur sous ProtectSystem=full) écrit un fichier PRÉPARÉ sous
# /var/lib/secubox/metablogizer ; `secubox-publishctl nginx-apply` le vérifie et
# l'installe en root. Sur une box neuve, le fichier servi n'existait pas et
# aucun site publié n'obtenait de bloc. Vide = rien servi, nginx l'accepte.
install -d -o secubox -g secubox -m 0750 /var/lib/secubox/metablogizer
f=/etc/nginx/sites-enabled/metablogizer
if [ -d /etc/nginx/sites-enabled ] && [ ! -e "$f" ] && [ ! -L "$f" ]; then
    install -m 0644 /dev/null "$f"
fi
# CADENCE (#1650) : une copie MANUELLE de la surcharge, posée dans /etc, masquait
# celle du paquet sans remettre l'intervalle à zéro (captures toutes les 2 min).
m=/etc/systemd/system/metablog-shots.timer.d/10-cadence.conf
if [ -f "$m" ] && grep -q "CHROMIUM TOUTES LES DEUX MINUTES" "$m"; then
    rm -f "$m"; rmdir --ignore-fail-on-non-empty "$(dirname "$m")" 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi
# ── LE VHOST DÉDIÉ ET SA ROUTE (#1323) ────────────────────────────────────
#
# UN SERVICE DÉCLARE SA PROPRE ROUTE, comme il déclare son vhost et son unité.
# Le 421 n'a qu'une cause : sbxwaf reçoit un nom d'hôte qu'il ne connaît pas.
# La table n'appartenait à aucun paquet — 275 routes posées à la main au fil
# des années, invisibles tant que ça tient, fatales le jour où une entrée
# saute. `secubox-waf-route` (secubox-core) fait la fusion idempotente.
HOTE=metablogizer

# MIGRATION #3117 : les vhosts étaient livrés sous le nom de gk2. Idempotent.
#   $1 ancien nom de fichier  $2 nouveau nom  $3 ancien filtre d'exposition
#   (ou vide)  $4 nouveau filtre. L'ancien lien d'activation part ; l'ancien
# fichier part s'il est celui que le paquet avait livré (somme dpkg), sinon il
# est repris sous le nouveau nom pour que les retouches de l'administrateur
# survivent. Retourne 0 si l'ancien vhost était activé.
sbx_migrer_vhost() {
    _o="$1"; _n="$2"; _os="$3"; _ns="$4"; _act=1
    _av=/etc/nginx/sites-available; _en=/etc/nginx/sites-enabled
    _sn=/etc/nginx/snippets/exposure
    if [ -e "$_en/$_o" ] || [ -L "$_en/$_o" ]; then
        rm -f "$_en/$_o"; _act=0
    fi
    if [ -f "$_av/$_o" ]; then
        _livre=$(dpkg-query -W -f='${Conffiles}\n' secubox-metablogizer 2>/dev/null \
                 | awk -v f="$_av/$_o" '$1 == f { print $2 }')
        _actuel=$(md5sum "$_av/$_o" | cut -d' ' -f1)
        if [ -n "$_livre" ] && [ "$_livre" != "$_actuel" ]; then
            cp -p "$_av/$_o" "$_av/$_n"
        elif [ -z "$_livre" ]; then
            mkdir -p /var/backups/nginx
            cp -p "$_av/$_o" "/var/backups/nginx/$_o.avant-3117" || true
        fi
        rm -f "$_av/$_o"
    fi
    # Le filtre d'exposition de l'opérateur suit le vhost.
    if [ -n "$_os" ] && [ -f "$_sn/$_os" ]; then
        if [ ! -f "$_sn/$_ns" ]; then mv -f "$_sn/$_os" "$_sn/$_ns"; else rm -f "$_sn/$_os"; fi
    fi
    return $_act
}
sbx_migrer_vhost metablogizer.gk2.secubox.in.conf metablogizer.conf \
    metablogizer.gk2.secubox.in.conf metablogizer.conf || true
# Le vhost du dépôt est livré mais non activé : on ne le réactive que s'il l'était.
if sbx_migrer_vhost depot.gk2.conf depot.conf "" ""; then
    if [ -f /etc/nginx/sites-available/depot.conf ]; then
        ln -sf ../sites-available/depot.conf /etc/nginx/sites-enabled/depot.conf
    fi
fi

# Filtre d'exposition, semé à « lan » S'IL MANQUE et jamais écrasé ensuite :
# publier au monde la console qui pilote la publication de tous les sites
# n'est pas une décision qu'un paquet prend à la place de l'opérateur.
mkdir -p /etc/nginx/snippets/exposure
if [ ! -f "/etc/nginx/snippets/exposure/$HOTE.conf" ]; then
    cat > "/etc/nginx/snippets/exposure/$HOTE.conf" <<'EXPO'
# Filtre d'exposition — semé à « lan » par secubox-metablogizer (#1323).
# Édité par le module secubox-exposure, qui fait autorité une fois le fichier
# créé. Cette console pilote la publication de tous les sites de la box :
# ouverte au monde, elle donne la main sur chacun d'eux.
allow 127.0.0.1;
allow 10.0.0.0/8;
allow 172.16.0.0/12;
allow 192.168.0.0/16;
deny all;
EXPO
fi

ln -sf ../sites-available/$HOTE.conf /etc/nginx/sites-enabled/$HOTE.conf

# La route ne vaut que si nginx accepte la configuration : poser l'une sans
# l'autre donne un 502 au lieu d'un 421, ce qui n'est pas un progrès.
if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx 2>/dev/null || true
    if command -v secubox-waf-route >/dev/null 2>&1; then
        secubox-waf-route "$(secubox-domaine metablogizer)" 9080 || true
    fi
else
    echo "secubox-metablogizer : nginx -t a échoué, vhost NON activé" >&2
    rm -f /etc/nginx/sites-enabled/$HOTE.conf
fi

systemctl daemon-reload
systemctl enable secubox-metablogizer 2>/dev/null || true
# Filet de secours de la liste « Mes sites » (#1687) : installé depuis #974,
# jamais activé — le cache restait figé dès qu'un chemin d'écriture oubliait de
# le rafraîchir (six jours sur gk2). Les écritures le rafraîchissent ; le
# minuteur rattrape le reste toutes les 30 min.
systemctl enable metablog-audit.timer 2>/dev/null || true
systemctl start metablog-audit.timer 2>/dev/null || true

# ── RESTAURÉ PAR #1768 : effacé par la fusion 6036886281 du 2026-08-17 ────
#
# Arborescence des caches (vignettes #956, liste des sites #974) : le fichier
# tmpfiles est livré, mais plus personne ne le créait sur une box neuve.
systemd-tmpfiles --create /usr/lib/tmpfiles.d/secubox-metablogizer.conf 2>/dev/null || true

# Minuteries des vignettes (#956) et de la synchro des sites adossés à git
# (#1029) : activées à la PREMIÈRE installation seulement. Sur une mise à
# jour, l'état choisi par l'opérateur prime — metablog-sync a pu être coupé
# exprès (décommission d'une synchro GitHub), metablog-shots après
# l'incident de cadence (#1650).
if [ "${1:-}" = configure ] && [ -z "${2:-}" ]; then
    systemctl enable --now metablog-shots.timer metablog-sync.timer 2>/dev/null || true
fi

# Versionnement des téléversements dans Gitea (api/webhook.py:git_commit_push).
# Le dépôt distant vise l'hôte PUBLIC de gitea, qui repasse par la box (NAT en
# épingle) : la poignée SSH réussit, le transfert cale. On réécrit vers le
# point d'entrée interne du LXC, pour le compte du service. Nom dérivé du
# domaine de CETTE box (#1723), jamais gk2 en dur.
GITEA_HOTE="$(secubox-domaine gitea 2>/dev/null || true)"
GITEA_PUSH_TARGET="${GITEA_PUSH_TARGET:-ssh://gitea@10.100.0.40:2222/}"
if [ -n "$GITEA_HOTE" ] && getent passwd secubox >/dev/null 2>&1; then
    GITEA_PUBLIC_URL="${GITEA_PUBLIC_URL:-ssh://gitea@${GITEA_HOTE}:2222/}"
    runuser -u secubox -- git config --global "url.${GITEA_PUSH_TARGET}.insteadOf" "$GITEA_PUBLIC_URL" 2>/dev/null || true
    SECU_HOME="$(getent passwd secubox | cut -d: -f6)"
    if [ -n "$SECU_HOME" ]; then
        install -d -o secubox -g secubox -m 700 "$SECU_HOME/.ssh" 2>/dev/null || true
        runuser -u secubox -- sh -c "ssh-keyscan -T 5 -p 2222 10.100.0.40 2>/dev/null >> '$SECU_HOME/.ssh/known_hosts' && sort -u '$SECU_HOME/.ssh/known_hosts' -o '$SECU_HOME/.ssh/known_hosts'" 2>/dev/null || true
    fi
fi

# Assistant de publication et rafraîchissement manuel de la liste (#974) :
# un fichier sudoers que visudo refuse casserait TOUT sudo — on le valide.
for f in /etc/sudoers.d/secubox-publish-wizard /etc/sudoers.d/secubox-metablog-audit \
         /etc/sudoers.d/secubox-metablog-nginx; do
    [ -f "$f" ] || continue
    chmod 0440 "$f"
    visudo -cf "$f" >/dev/null 2>&1 || rm -f "$f"
done

systemctl start secubox-metablogizer 2>/dev/null || true

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/metablogizer/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "metablogizer : postinst de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/metablogizer/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "metablogizer : postinst de $(basename "$_s") en échec" >&2; }
done
exit 0
