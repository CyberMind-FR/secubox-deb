#!/bin/bash
set -e
systemctl stop secubox-metablogizer 2>/dev/null || true
systemctl disable secubox-metablogizer 2>/dev/null || true
systemctl disable --now metablog-shots.timer 2>/dev/null || true
systemctl disable --now metablog-audit.timer 2>/dev/null || true
case "$1" in
  remove|deconfigure)
    # Mosaic wall thumbnail route (#977): drop it immediately rather than
    # wait for dpkg's own conffile cleanup, same pattern as secubox-hub.
    rm -f /etc/nginx/secubox.d/metablogizer.conf
    systemctl reload nginx 2>/dev/null || true
    ;;
  upgrade)
    # Don't remove nginx config on upgrade — postinst reinstalls it.
    ;;
esac

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/metablogizer/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "metablogizer : prerm de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/metablogizer/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "metablogizer : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
