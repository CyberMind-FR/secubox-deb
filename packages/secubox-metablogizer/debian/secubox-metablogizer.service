[Unit]
Description=SecuBox MetaBlogizer API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metablogizer
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/metablogizer.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/metablogizer.sock --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
