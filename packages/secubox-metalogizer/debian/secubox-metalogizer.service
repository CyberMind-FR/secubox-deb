[Unit]
Description=SecuBox Metalogizer - Log processor and analyzer API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
UMask=0000
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metalogizer
ExecStart=/usr/bin/python3 -m uvicorn api.main:app \
    --uds /run/secubox/metalogizer.sock \
    --log-level warning
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
RuntimeDirectory=secubox
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0775

ReadWritePaths=/run/secubox /var/lib/secubox /var/cache/secubox /etc/secubox
ReadOnlyPaths=/var/log

[Install]
WantedBy=multi-user.target
