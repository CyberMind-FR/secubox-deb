# Composant searxng (#3581) : l'API hôte s'arrête au retrait. Le conteneur n'est jamais touché par le paquet.
set -e
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop secubox-searxng.service >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
