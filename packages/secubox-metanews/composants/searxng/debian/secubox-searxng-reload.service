# SecuBox SearXNG — rechargement de la configuration (#3581), oneshot ROOT démarré par secubox-searxng-reload.path.
# Traite UNE demande de l'API (searxngctl reload --demandes : demande revalidée, settings.yml régénéré en double tampon
# dans le conteneur, relance, sonde, retour arrière, audit) et pose son résultat pour l'API.
# Exception § 10 de RULES-CODE.md : lxc-attach entre dans les espaces de noms du conteneur (setns, dont user et mount),
# rejoint son cgroup, y applique sa personnalité et son profil AppArmor à l'exécution : NoNewPrivileges, ProtectSystem,
# ProtectKernelTunables, ProtectControlGroups, RestrictNamespaces, RestrictSUIDSGID et LockPersonality le casseraient
# (le contrôleur tournait jusque-là sans aucun bac à sable, dans le contexte de PID 1 par systemd-run). Test :
# composants/searxng/tests/test_paquet_3581.py::test_unite_reload_root_et_exception_ecrite.
[Unit]
Description=SecuBox SearXNG : rechargement de la configuration (contrôleur root, #3581)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3581
# Des refus en rafale ne doivent pas désarmer l'unité .path : limite de démarrages large.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart=/usr/sbin/searxngctl reload --demandes
# Pire cas d'UN reload (délais des opérations lxc-attach, relance 90 s, sonde 30 s, puis retour arrière avec une seconde
# relance et une seconde sonde) : moins de 8 min. L'API, elle, n'attend que 30 s puis répond 202.
TimeoutStartSec=10min
UMask=0027
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# Hôte : seule la sonde /healthz vers le conteneur (lxc.ip du TOML, 10.100.0.85 par défaut). Ce qui tourne DANS le
# conteneur (lxc-attach) quitte ce cgroup et n'est pas concerné.
IPAddressDeny=any
IPAddressAllow=10.100.0.85/32
