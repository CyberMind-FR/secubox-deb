#!/bin/sh
set -e
case "$1" in
  configure)
    if ! getent passwd secubox-metanews >/dev/null; then
      adduser --system --group --no-create-home --home /var/lib/secubox/metanews \
              --shell /usr/sbin/nologin secubox-metanews >/dev/null
      adduser secubox-metanews secubox >/dev/null 2>&1 || true
    fi
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/secubox-metanews.conf >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    ;;
esac
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/metanews/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "metanews : postinst de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/metanews/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "metanews : postinst de $(basename "$_s") en échec" >&2; }
done


# ── Le vhost public : le PAQUET fait foi (#1727, motif de la radio #1430) ──
# Il était livré dans nginx-available sans jamais être installé : gk2 servait
# une copie posée à la main le 2026-08-24 (sans verdict LAN #1354 ni
# metanews.*), gk3 rendait « Wrong Domain ». Sauvegarde hors de sites-enabled
# (nginx charge tout ce qui s'y trouve), installation, nginx -t, retour arrière.
if [ "$1" = configure ] && [ -f /etc/secubox/nginx-available/metanews.conf ] && [ -d /etc/nginx/sites-enabled ]; then
  ACTIF=/etc/nginx/sites-enabled/metanews.conf
  SAUVE=/var/backups/secubox-vhosts/metanews.conf.avant-paquet
  if ! cmp -s /etc/secubox/nginx-available/metanews.conf "$ACTIF"; then
    mkdir -p /var/backups/secubox-vhosts
    [ -f "$ACTIF" ] && cp -p "$ACTIF" "$SAUVE" 2>/dev/null || rm -f "$SAUVE"
    cp -f /etc/secubox/nginx-available/metanews.conf "$ACTIF"
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
      systemctl reload nginx >/dev/null 2>&1 || true
    elif [ -f "$SAUVE" ]; then
      cp -p "$SAUVE" "$ACTIF"
      echo "secubox-metanews: vhost refusé par nginx -t, ancien conservé" >&2
    else
      rm -f "$ACTIF"
      echo "secubox-metanews: vhost refusé par nginx -t, non activé" >&2
    fi
  fi
fi
exit 0
