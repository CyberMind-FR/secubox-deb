#!/bin/sh
set -e
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop secubox-metanews.service >/dev/null 2>&1 || true
    fi
    ;;
esac
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/metanews/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "metanews : prerm de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/metanews/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "metanews : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
