# SecuBox Metoblizer Configuration
# Location: /etc/secubox/metoblizer.toml

[main]
enabled = true
data_dir = "/var/lib/secubox/metoblizer"
max_events = 10000
buffer_size = 100

[modules]
# Module endpoints for aggregation
# Format: module_name = "http://host:port/api/v1/module"
netdata = "http://127.0.0.1:9202/api/v1/netdata"
glances = "http://127.0.0.1:9213/api/v1/glances"
streamlit = "http://127.0.0.1:9214/api/v1/streamlit"
crowdsec = "http://127.0.0.1:9201/api/v1/crowdsec"

[presence]
# Presence event settings
enabled = true
banner_duration = 30
presence_dir = "/var/lib/secubox/presence"

[retention]
# Event retention settings
max_age_hours = 168
cleanup_interval_hours = 24
