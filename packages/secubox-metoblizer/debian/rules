#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-metoblizer/usr/lib/secubox/metoblizer
	cp -r api debian/secubox-metoblizer/usr/lib/secubox/metoblizer/
	install -d debian/secubox-metoblizer/usr/share/secubox/www/metoblizer
	cp -r www/metoblizer/. debian/secubox-metoblizer/usr/share/secubox/www/metoblizer/
	install -d debian/secubox-metoblizer/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-metoblizer/usr/share/secubox/menu.d/ || true
	install -d debian/secubox-metoblizer/etc/nginx/secubox.d
	[ -f nginx/metoblizer.conf ] && install -m 644 nginx/metoblizer.conf debian/secubox-metoblizer/etc/nginx/secubox.d/ || true
	install -d debian/secubox-metoblizer/etc/secubox
	[ -f config/metoblizer.toml.example ] && install -m 644 config/metoblizer.toml.example debian/secubox-metoblizer/etc/secubox/metoblizer.toml || true
