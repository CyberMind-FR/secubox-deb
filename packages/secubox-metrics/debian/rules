#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d $(CURDIR)/debian/secubox-metrics/usr/lib/secubox/metrics/api
	install -d $(CURDIR)/debian/secubox-metrics/usr/share/secubox/www/metrics
	install -d $(CURDIR)/debian/secubox-metrics/usr/share/secubox/menu.d
	install -d $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d

	cp -r api/* $(CURDIR)/debian/secubox-metrics/usr/lib/secubox/metrics/api/
	cp -r www/metrics/* $(CURDIR)/debian/secubox-metrics/usr/share/secubox/www/metrics/

	if [ -d menu.d ]; then \
		cp menu.d/*.json $(CURDIR)/debian/secubox-metrics/usr/share/secubox/menu.d/ 2>/dev/null || true; \
	fi

	# Install nginx config
	echo '# Metrics Dashboard' > $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo 'location /metrics/ {' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '    alias /usr/share/secubox/www/metrics/;' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '    try_files $$uri $$uri/ /metrics/index.html;' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '}' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo 'location /api/v1/metrics/ {' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '    proxy_pass http://unix:/run/secubox/metrics.sock:/api/v1/metrics/;' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '    proxy_http_version 1.1;' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '    proxy_set_header Host $$host;' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '    proxy_set_header X-Real-IP $$remote_addr;' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '    proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '    proxy_set_header X-Forwarded-Proto $$scheme;' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf
	echo '}' >> $(CURDIR)/debian/secubox-metrics/etc/nginx/secubox.d/metrics.conf

	# Journal nginx porte par le domaine, et l'outil qui complete les blocs
	# server qui declarent deja leur propre access_log.
	# log_format sbx_host : livré par secubox-core depuis #1491 (neuf vhosts
	# l'utilisent, metrics n'est dans aucun profil → nginx -t cassé).
	install -D -m 0755 sbin/secubox-vhost-logs \
	    $(CURDIR)/debian/secubox-metrics/usr/sbin/secubox-vhost-logs
	# Composant absorbé : glances (#2050)
	install -d debian/secubox-metrics/usr/lib/secubox/glances/
	cp -r composants/glances/api debian/secubox-metrics/usr/lib/secubox/glances/
	install -d debian/secubox-metrics/usr/share/secubox/www
	[ -d composants/glances/www ] && cp -r composants/glances/www/. debian/secubox-metrics/usr/share/secubox/www/ || true
	install -d debian/secubox-metrics/usr/share/secubox/menu.d
	[ -d composants/glances/menu.d ] && cp -r composants/glances/menu.d/. debian/secubox-metrics/usr/share/secubox/menu.d/ || true
	# Modular composants/glances/nginx composants/glances/config
	install -d debian/secubox-metrics/etc/nginx/secubox.d
	[ -f composants/glances/nginx/glances.conf ] && cp composants/glances/nginx/glances.conf debian/secubox-metrics/etc/nginx/secubox.d/ || true
	install -D -m 755 composants/glances/debian/postinst debian/secubox-metrics/usr/lib/secubox/metrics/maintscripts/glances.postinst
	install -D -m 755 composants/glances/debian/prerm debian/secubox-metrics/usr/lib/secubox/metrics/maintscripts/glances.prerm
	install -D -m 644 composants/glances/debian/secubox-glances.service debian/secubox-metrics/usr/lib/systemd/system/secubox-glances.service
	# Composant absorbé : reporter (#2050)
	install -d debian/secubox-metrics/usr/lib/secubox/reporter/
	cp -r composants/reporter/api debian/secubox-metrics/usr/lib/secubox/reporter/
	install -d debian/secubox-metrics/usr/share/secubox/www
	[ -d composants/reporter/www ] && cp -r composants/reporter/www/. debian/secubox-metrics/usr/share/secubox/www/ || true
	install -d debian/secubox-metrics/usr/share/secubox/menu.d
	[ -d composants/reporter/menu.d ] && cp -r composants/reporter/menu.d/. debian/secubox-metrics/usr/share/secubox/menu.d/ || true
	# Modular composants/reporter/nginx composants/reporter/config
	install -d debian/secubox-metrics/etc/nginx/secubox.d
	[ -f composants/reporter/nginx/reporter.conf ] && cp composants/reporter/nginx/reporter.conf debian/secubox-metrics/etc/nginx/secubox.d/ || true
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d debian/secubox-metrics/etc/nginx/secubox-routes.d
	[ -f composants/reporter/nginx/reporter.conf ] && cp composants/reporter/nginx/reporter.conf debian/secubox-metrics/etc/nginx/secubox-routes.d/ || true
	# Report composants/reporter/templates directory
	install -d debian/secubox-metrics/usr/share/secubox/reporter/templates
	install -D -m 755 composants/reporter/debian/postinst debian/secubox-metrics/usr/lib/secubox/metrics/maintscripts/reporter.postinst
	install -D -m 755 composants/reporter/debian/prerm debian/secubox-metrics/usr/lib/secubox/metrics/maintscripts/reporter.prerm
	install -D -m 644 composants/reporter/debian/secubox-reporter.service debian/secubox-metrics/usr/lib/systemd/system/secubox-reporter.service
	# Composant absorbé : grafana (#2050)
	# Host control plane (FastAPI)
	install -d debian/secubox-metrics/usr/lib/secubox/grafana
	cp -r composants/grafana/api debian/secubox-metrics/usr/lib/secubox/grafana/
	# CTL
	install -d debian/secubox-metrics/usr/sbin
	install -m 755 composants/grafana/sbin/grafanactl debian/secubox-metrics/usr/sbin/grafanactl
	# Web UI
	install -d debian/secubox-metrics/usr/share/secubox/www
	[ -d composants/grafana/www ] && cp -r composants/grafana/www/. debian/secubox-metrics/usr/share/secubox/www/ || true
	# Menu entry
	install -d debian/secubox-metrics/usr/share/secubox/menu.d
	[ -d composants/grafana/menu.d ] && cp -r composants/grafana/menu.d/. debian/secubox-metrics/usr/share/secubox/menu.d/ || true
	# composants/grafana/nginx snippet
	install -d debian/secubox-metrics/etc/nginx/secubox.d
	[ -f composants/grafana/nginx/grafana.conf ] && cp composants/grafana/nginx/grafana.conf debian/secubox-metrics/etc/nginx/secubox.d/ || true && (install -d debian/secubox-metrics/etc/nginx/secubox-routes.d && cp composants/grafana/nginx/grafana.conf debian/secubox-metrics/etc/nginx/secubox-routes.d/)
	# Config example
	install -d debian/secubox-metrics/etc/secubox
	[ -f composants/grafana/conf/grafana.toml.example ] && cp composants/grafana/conf/grafana.toml.example debian/secubox-metrics/etc/secubox/grafana.toml.example || true
	# LXC bootstrap + provisioning (shipped, not pre-built)
	install -d debian/secubox-metrics/usr/share/secubox/lib/grafana
	[ -d composants/grafana/lib/grafana ] && cp -r composants/grafana/lib/grafana/. debian/secubox-metrics/usr/share/secubox/lib/grafana/ || true
	install -D -m 755 composants/grafana/debian/postinst debian/secubox-metrics/usr/lib/secubox/metrics/maintscripts/grafana.postinst
	install -D -m 755 composants/grafana/debian/prerm debian/secubox-metrics/usr/lib/secubox/metrics/maintscripts/grafana.prerm
	install -D -m 755 composants/grafana/debian/postrm debian/secubox-metrics/usr/lib/secubox/metrics/maintscripts/grafana.postrm
	install -D -m 644 composants/grafana/debian/secubox-grafana.service debian/secubox-metrics/usr/lib/systemd/system/secubox-grafana.service

override_dh_install:
	dh_install
	install -D -m 0644 nftables/secubox-metrics.nft \
	    debian/secubox-metrics/etc/nftables.d/secubox-metrics.nft
	install -D -m 0644 systemd/secubox-geoipupdate.service \
	    debian/secubox-metrics/lib/systemd/system/secubox-geoipupdate.service
	install -D -m 0644 systemd/secubox-geoipupdate.timer \
	    debian/secubox-metrics/lib/systemd/system/secubox-geoipupdate.timer
	# Recuperateur (#194) : MaxMind si une licence est presente, sinon repli
	# sur l'ASN lite gratuit de DB-IP (sans inscription). Efface par la fusion
	# 7ebe27403a — sans lui VisitorOrigin restait vide a jamais (#1777).
	install -D -m 0755 bin/secubox-geoipupdate-fetch \
	    debian/secubox-metrics/usr/bin/secubox-geoipupdate-fetch
	# Routes /api/v1/cookie-audit/* vers metrics.sock (#1777).
	install -D -m 0644 nginx/metrics-cookie-audit.conf \
	    debian/secubox-metrics/etc/nginx/secubox-routes.d/metrics-cookie-audit.conf
	# #1059 — rapport de fréquentation planifié (oneshot + timer hebdo).
	install -D -m 0644 systemd/secubox-metrics-rapport.service \
	    debian/secubox-metrics/lib/systemd/system/secubox-metrics-rapport.service
	install -D -m 0644 systemd/secubox-metrics-rapport.timer \
	    debian/secubox-metrics/lib/systemd/system/secubox-metrics-rapport.timer
	install -D -m 0644 systemd/secubox-metrics-rapport-quotidien.service \
	    debian/secubox-metrics/lib/systemd/system/secubox-metrics-rapport-quotidien.service
	install -D -m 0644 systemd/secubox-metrics-rapport-quotidien.timer \
	    debian/secubox-metrics/lib/systemd/system/secubox-metrics-rapport-quotidien.timer
	install -D -m 0644 systemd/secubox-metrics-rapport-waf.service \
	    debian/secubox-metrics/lib/systemd/system/secubox-metrics-rapport-waf.service
	install -D -m 0644 systemd/secubox-metrics-rapport-waf.timer \
	    debian/secubox-metrics/lib/systemd/system/secubox-metrics-rapport-waf.timer
