[Unit]
Description=SecuBox Metrics Dashboard API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metrics
# RuntimeDirectory=secubox RETIRE (#1022) : /run/secubox est partage par ~95
# unites, et systemd EFFACE le contenu d'un RuntimeDirectory au redemarrage —
# une seule unite qui le declare emporte les sockets de toutes les autres, et
# la board rend des 502 sur des modules qui n'avaient rien demande. Le parent
# reste root:root 1777, cree hors des unites.
RuntimeDirectoryMode=0755
# CacheDirectory auto-creates /var/cache/secubox with service user/group
# and survives reboots (unlike /tmp). Fix for #149: was ReadWritePaths=
# /tmp/secubox, which broke namespace setup after every reboot because
# /tmp/secubox was cleared by systemd-tmpfiles before the unit started.
CacheDirectory=secubox
CacheDirectoryMode=0755
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/metrics.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app \
    --uds /run/secubox/metrics.sock \
    --log-level warning
Restart=on-failure
RestartSec=5
# Sandboxing disabled - causes namespace errors with Python symlinks on some kernels
# PrivateTmp=true
# ProtectSystem=full
NoNewPrivileges=true
ReadWritePaths=/run/secubox /var/cache/secubox
# VisitorOrigin reads the nft `seen_src` set via `nft -j list set ...` which
# requires CAP_NET_ADMIN. Without it, _read_nft_set silently returns [] and
# the aggregator emits empty entries forever (#194 fix, latent since #92).
# Coexists with NoNewPrivileges=true because systemd sets the ambient set
# before the User= drop.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
