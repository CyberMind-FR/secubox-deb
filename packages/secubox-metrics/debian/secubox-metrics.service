[Unit]
Description=SecuBox Metrics Dashboard API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metrics
RuntimeDirectory=secubox
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# CacheDirectory auto-creates /var/cache/secubox with service user/group
# and survives reboots (unlike /tmp). Fix for #149: was ReadWritePaths=
# /tmp/secubox, which broke namespace setup after every reboot because
# /tmp/secubox was cleared by systemd-tmpfiles before the unit started.
CacheDirectory=secubox
CacheDirectoryMode=0755
ExecStart=/usr/bin/python3 -m uvicorn api.main:app \
    --uds /run/secubox/metrics.sock \
    --log-level warning
Restart=on-failure
RestartSec=5
# Sandboxing disabled - causes namespace errors with Python symlinks on some kernels
# PrivateTmp=true
# ProtectSystem=full
NoNewPrivileges=true
ReadWritePaths=/run/secubox /var/cache/secubox

[Install]
WantedBy=multi-user.target
