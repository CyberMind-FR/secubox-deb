# SecuBox-Deb :: secubox-vhost-logs
#
# Un `access_log` declare dans un bloc `server` REMPLACE celui herite du bloc
# `http` — il ne s'y ajoute pas. Le journal commun pose dans conf.d ne couvre
# donc que les blocs qui n'en declarent aucun. Ce script ajoute la ligne
# manquante aux autres.
#
# Idempotent, et re-jouable : les configurations de vhosts sont generees, donc
# une regeneration efface l'ajout. Relancer suffit.
#
# LA RESTAURATION NE REND QUE CE QUE CETTE PASSE A TOUCHE (#1777). La version
# 1.0.0 recopiait, sur echec de `nginx -t`, TOUTES les sauvegardes jamais
# prises : sur gk2 (2026-09-30), 90 fichiers accumules depuis mai ont ressuscite
# six vhosts decommissionnes, repose des doublons `.avant-secubox-hosts`, et
# remplace des vhosts vivants par leur contenu du 17 aout. Pire, `cp` sur un
# lien symbolique ecrit DANS sa cible : nextcloud, peertube et le Hall ont ete
# ecrases dans sites-available. Et l'echec qui l'avait declenche n'etait meme
# pas le sien : `nginx -t` echouait deja avant la premiere modification.
# D'ou trois regles : ne rien toucher si la configuration echoue deja ;
# sauvegarder chaque passe dans son propre repertoire et ne restaurer que lui ;
# restaurer en supprimant d'abord, pour qu'un lien revienne lien sans jamais
# ecrire a travers.
set -euo pipefail
readonly MODULE="vhost-logs"
readonly VERSION="1.1.1"

LIGNE='    access_log /var/log/nginx/secubox-hosts.log sbx_host;'
REP="${1:-/etc/nginx/sites-enabled}"
# Les sauvegardes vont HORS de sites-enabled : nginx inclut tout ce repertoire
# (`include /etc/nginx/sites-enabled/*`), donc une sauvegarde deposee a cote
# est chargee comme une configuration a part entiere et duplique chaque bloc
# server. Cinquante sauvegardes ont ainsi triple les server_name.
SAUVEGARDES="${SAUVEGARDES:-/var/backups/secubox/nginx-vhosts}"
APPLIQUE="${APPLIQUE:-0}"

[ "${1:-}" = "--apply" ] && { APPLIQUE=1; REP=/etc/nginx/sites-enabled; }
[ "${2:-}" = "--apply" ] && APPLIQUE=1

ajoutes=0; deja=0; herites=0

if [ "$APPLIQUE" = "1" ] && ! nginx -t >/dev/null 2>&1; then
    # L'echec n'est pas le notre : modifier puis « restaurer » ne ferait
    # qu'ajouter nos degats a ceux d'un autre.
    echo "[$MODULE] nginx -t echoue AVANT toute modification : rien n'est touche" >&2
    exit 1
fi
# Les sauvegardes de CETTE passe, et elles seules, dans leur propre repertoire.
PASSE="$SAUVEGARDES/passe-$(date +%Y%m%d%H%M%S)-$$"

for f in "$REP"/*; do
    [ -f "$f" ] || continue
    case "$f" in
        *.avant-*|*.bak|*.orig|*.dpkg-*|*~) continue ;;
    esac
    # On n'agit que sur les blocs qui declarent leur propre access_log ; les
    # autres heritent deja du journal commun.
    grep -q "access_log" "$f" || { herites=$((herites+1)); continue; }
    if grep -q "secubox-hosts.log" "$f"; then deja=$((deja+1)); continue; fi

    if [ "$APPLIQUE" = "1" ]; then
        mkdir -p "$PASSE"
        # -a : un lien symbolique est sauvegarde en tant que lien.
        cp -a "$f" "$PASSE/$(basename "$f")"
        # Un lien : sed ecrit desormais dans sa CIBLE (#2253). La cible est donc sauvegardee a part, avec son chemin, pour la rendre telle quelle.
        if [ -L "$f" ]; then
            cible=$(readlink -f "$f")
            mkdir -p "$PASSE/cibles"
            cp -a "$cible" "$PASSE/cibles/$(basename "$f")"
            printf '%s' "$cible" > "$PASSE/cibles/$(basename "$f").chemin"
        fi
        # Apres CHAQUE access_log existant, pour couvrir tous les blocs server
        # du fichier sans avoir a analyser les accolades.
        # --follow-symlinks (#2253) : sans lui, `sed -i` REMPLACE le lien par une copie, et sites-available diverge de ce que nginx charge.
        sed -i --follow-symlinks "/^[[:space:]]*access_log[[:space:]]/a\\$LIGNE" "$f"
    fi
    ajoutes=$((ajoutes+1))
done

echo "[$MODULE] $ajoutes fichier(s) a completer, $deja deja fait(s), $herites herite(nt) du commun"
if [ "$APPLIQUE" = "1" ]; then
    if nginx -t 2>/dev/null; then
        systemctl reload nginx && echo "[$MODULE] nginx recharge"
    else
        echo "[$MODULE] ECHEC nginx -t : restauration" >&2
        for b in "$PASSE"/*; do
            # -L aussi : une sauvegarde de lien relatif ne se resout pas ici.
            [ -e "$b" ] || [ -L "$b" ] || continue
            nom=$(basename "$b")
            [ "$nom" = "cibles" ] && continue          # les cibles de liens sont rendues plus bas
            # Supprimer D'ABORD : `cp` sur un lien existant ecrit dans sa cible.
            rm -f "$REP/$nom"
            cp -a "$b" "$REP/$nom"
        done
        # Les CIBLES des liens modifies : on les rend a leur contenu d'avant la passe (le lien, lui, n'a jamais cesse d'etre un lien).
        for c in "$PASSE"/cibles/*.chemin; do
            [ -e "$c" ] || continue
            nom=$(basename "$c" .chemin)
            cible=$(cat "$c")
            rm -f "$cible"
            cp -a "$PASSE/cibles/$nom" "$cible"
        done
        nginx -t && systemctl reload nginx
        exit 1
    fi
else
    echo "[$MODULE] essai a blanc — relancer avec --apply"
fi
