# Rafraichissement hebdomadaire de GeoLite2-ASN.mmdb (#194). Restaure apres la
# fusion 7ebe27403a (#1777) : la version perimee ne tournait QUE si une licence
# MaxMind existait (ConditionPathExists), si bien que sans licence la base ASN
# n'arrivait jamais et VisitorOrigin restait vide. Le recuperateur essaie
# MaxMind, puis se replie sur l'ASN lite gratuit de DB-IP.
[Unit]
Description=SecuBox — refresh GeoLite2-ASN database (MaxMind or DB-IP fallback)
After=network-online.target unbound.service
Wants=network-online.target

[Service]
Type=oneshot
# Au demarrage le DNS local peut repondre apres network-online : on retente (Debian 13, #1294).
Restart=on-failure
RestartSec=60
# Fetcher must run as root because /var/lib/GeoIP is owned by root and the
# DB-IP fallback path uses `install -o secubox` to land the mmdb under the
# correct ownership. The helper does not exec anything as root that takes
# untrusted input.
User=root
ExecStart=/usr/bin/secubox-geoipupdate-fetch
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/GeoIP
