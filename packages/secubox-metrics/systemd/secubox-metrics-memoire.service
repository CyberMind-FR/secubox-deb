[Unit]
Description=SecuBox — releve de la memoire de la box (historique, alerte de fuite noyau, #2146)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/2146

[Service]
Type=oneshot
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metrics
Nice=15
IOSchedulingClass=idle
StateDirectory=secubox/metrics
ExecStart=/usr/bin/python3 -m api.memoire
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=64M
