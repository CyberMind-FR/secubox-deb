[Unit]
Description=SecuBox — releve de la memoire de la box (historique, alerte de fuite noyau, #2146)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/2146

[Service]
# Tâche de fond de collecte (ref #4036) : tranche basse priorité et file FIFO à concurrence bornée.
Slice=secubox-taches.slice
ReadWritePaths=-/run/secubox/taches
Type=oneshot
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metrics
Nice=15
IOSchedulingClass=idle
StateDirectory=secubox/metrics
# #3941 : une ligne d'audit quand un conteneur ou un service reste étouffé plus de dix minutes, une à la fin.
ReadWritePaths=-/var/log/secubox/audit.log
ExecStart=/usr/lib/secubox/tache-fifo --nom secubox-metrics-memoire --attente-max 300 -- /usr/bin/python3 -m api.memoire
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=64M
