[Unit]
Description=SecuBox — rapport de pilotage hebdomadaire (PDF six feuilles → email, #3970)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3970
After=network-online.target secubox-metrics.service
Wants=network-online.target

[Service]
# oneshot déclenché par secubox-metrics-rapport-pilotage.timer, LIVRÉ DÉSACTIVÉ : l'ancien rapport du lundi
# reste tant que celui-ci n'est pas validé. Même sans minuteur, rien ne part tant que
# `[rapport.pilotage] actif = true` n'est pas posé dans /etc/secubox/metrics.toml.
Type=oneshot
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metrics
Nice=10
IOSchedulingClass=idle
CacheDirectory=secubox-metrics-rapport
Environment=MPLCONFIGDIR=/var/cache/secubox-metrics-rapport
Environment=SECUBOX_RELEVE_DIR=/var/lib/secubox/metrics/releve
ExecStart=/usr/bin/python3 -m api.rapport_pilotage
TimeoutStartSec=20min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# Le relais mail (SMTP) et la socket d'actord.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
MemoryMax=384M
