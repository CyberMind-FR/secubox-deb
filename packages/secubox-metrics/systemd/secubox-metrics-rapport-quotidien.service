[Unit]
Description=SecuBox — rapport de fréquentation QUOTIDIEN (famille anibal-amiot → email interne)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/1059
After=network-online.target secubox-metrics.service
Wants=network-online.target

[Service]
# Même orchestrateur que le rapport hebdomadaire, mais période « jour » : le
# bilan de la veille. Un seul module (api.rapport_planifie), l'argument fixe la
# période — aucune config dupliquée.
Type=oneshot
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metrics
Nice=10
IOSchedulingClass=idle
CacheDirectory=secubox-metrics-rapport
Environment=MPLCONFIGDIR=/var/cache/secubox-metrics-rapport
ExecStart=/usr/bin/python3 -m api.rapport_planifie jour
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
