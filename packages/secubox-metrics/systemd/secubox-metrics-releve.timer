[Unit]
Description=SecuBox — relevé quotidien du rapport de pilotage (00:20, #3970)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3970

[Timer]
# Peu après minuit : la veille est complète dans les journaux, la rotation du WAF ne l'a pas encore compressée.
OnCalendar=*-*-* 00:20:00
RandomizedDelaySec=10m
FixedRandomDelay=true
# Box éteinte à l'heure dite : rattrapage au démarrage ; le relevé rattrape aussi les jours manquants des 7 derniers.
Persistent=true

[Install]
WantedBy=timers.target
