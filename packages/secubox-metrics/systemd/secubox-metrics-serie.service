[Unit]
Description=SecuBox — releve des courbes de la box (CPU, memoire, reseau, connexions, disque ; remplace Grafana, #2765)

[Service]
Type=oneshot
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/metrics
Nice=15
IOSchedulingClass=idle
StateDirectory=secubox/metrics
ExecStart=/usr/bin/python3 -m api.serie
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=64M
