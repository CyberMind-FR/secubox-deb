# SecuBox-Deb :: mirrornet — MirrorNet v1 (#3645 schéma, #3647 abonnements, #3651 interface web).
P = $(CURDIR)/debian/secubox-mirrornet

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_installsystemd:

override_dh_auto_install:
	install -d $(P)/usr/lib/secubox/mirrornet/api $(P)/usr/lib/secubox/mirrornet/secubox_mirrornet
	install -m 644 api/*.py $(P)/usr/lib/secubox/mirrornet/api/
	install -m 644 secubox_mirrornet/*.py $(P)/usr/lib/secubox/mirrornet/secubox_mirrornet/
	install -d $(P)/usr/share/secubox/mirrornet
	install -m 644 conf/mirrornet.toml $(P)/usr/share/secubox/mirrornet/mirrornet.toml.example
	install -m 644 nginx/mirrornet-maillage.conf.tpl $(P)/usr/share/secubox/mirrornet/
	install -d $(P)/usr/lib/systemd/system
	install -m 644 debian/secubox-mirrornet.service $(P)/usr/lib/systemd/system/
	install -d $(P)/etc/apparmor.d
	install -m 644 apparmor/secubox-mirrornet $(P)/etc/apparmor.d/secubox-mirrornet
	install -d $(P)/etc/nginx/secubox.d $(P)/etc/nginx/secubox-routes.d
	install -m 644 nginx/mirrornet.conf $(P)/etc/nginx/secubox.d/
	install -m 644 nginx/mirrornet.conf $(P)/etc/nginx/secubox-routes.d/
	# Interface web (#3651) : page statique servie à /mirrornet/ par la racine de l'hôte d'administration ; entrée de menu.
	install -d $(P)/usr/share/secubox/www/mirrornet $(P)/usr/share/secubox/menu.d
	install -m 644 www/mirrornet/index.html $(P)/usr/share/secubox/www/mirrornet/
	install -m 644 menu.d/576-mirrornet.json $(P)/usr/share/secubox/menu.d/
