# SecuBox MirrorNet v1 — API locale, phase 2 : lecture seule (#3645). Le schéma est créé ou migré au démarrage, sous le
# compte du service. Compte dédié, aucune capacité, aucun réseau IP (les échanges entre pairs viendront en phase 3+).
[Unit]
Description=SecuBox MirrorNet — plan de contrôle (abonnements, jeux de données)
After=network.target secubox-core.service secubox-annuaire.service
# Filet : au plus 3 démarrages en 5 min, quoi qu'il arrive.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# Type=exec et non simple : avec ExecStartPost et LoadCredential, « simple » laisse une course que systemd signale
# (« could lead to race conditions ») ; vue au banc #3653 (status=243/CREDENTIALS au premier démarrage, gk6).
Type=exec
User=secubox-mirrornet
Group=secubox
WorkingDirectory=/usr/lib/secubox/mirrornet
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=+/bin/rm -f /run/secubox/mirrornet.sock
# Lanceur : migration du schéma puis uvicorn, dans le processus principal (code 3 = base trop récente, sans redémarrage).
ExecStart=/usr/bin/python3 -m secubox_mirrornet.lanceur /run/secubox/mirrornet.sock
# uvicorn force sa socket en 0666 : remise en 0660 (groupe secubox, que nginx traverse) dès qu'elle existe.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 1200); do [ -S /run/secubox/mirrornet.sock ] && break; sleep 0.1; done; chmod 660 /run/secubox/mirrornet.sock'
# Ledger privé (MIRRORNET_ECONOMY.md § 8) : base et WAL lisibles par le seul compte du service, jamais par le groupe
# secubox (modules, agrégateur). La socket est remise en 0660 explicitement par ExecStartPost.
UMask=0077
# Preuve de l'écouteur maillé (#3653) : secret root seul, copié par systemd dans le dossier privé de credentials du
# service ; le profil AppArmor continue d'interdire tout /etc/secubox/secrets.
LoadCredential=pair-preuve:/etc/secubox/secrets/mirrornet/pair.preuve
AppArmorProfile=-secubox-mirrornet
StateDirectory=secubox-mirrornet
StateDirectoryMode=0700
Restart=on-failure
# Base plus récente que le code (retour arrière du paquet) : code 3, pas de redémarrage en boucle.
RestartPreventExitStatus=3
RestartSec=5
MemoryMax=128M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
# Réseau : le seul maillage (versions de jeux de données tirées des pairs par :8799, #3653) ; rien d'autre.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.10.0.0/24
# #3666 : partage avec les modules (demande de publication, indices livrés) ; la publication d'ad-guard
# (/var/lib/secubox/ad-guard/dnstv/indices-publication.json) reste lisible sous ProtectSystem=strict.
ReadWritePaths=/run/secubox -/var/log/secubox/delegation.log -/data/mirrornet -/var/lib/secubox-mirrornet-partage

[Install]
WantedBy=multi-user.target
