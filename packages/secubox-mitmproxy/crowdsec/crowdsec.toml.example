# SecuBox WAF → CrowdSec bridge (Phase 7.A, ref #498)
#
# Goal : turn WAF detections into actual nft drops within seconds.
#
# Path : when threat_counts crosses BAN_THRESHOLD for an IP,
#   secubox_waf.py POSTs to ${url}/v1/decisions with X-Api-Key header,
#   CrowdSec records the decision,
#   crowdsec-firewall-bouncer reads it and adds an nft drop element to
#   table ip crowdsec → subsequent connections from that IP get dropped
#   at kernel level before TCP handshake.
#
# This file lives at /etc/secubox/waf/crowdsec.toml inside the WAF
# environment (mitmproxy LXC or host, wherever secubox_waf.py runs).
# Generated by secubox-waf-cs-bridge-setup which captures the bouncer
# API key from `cscli bouncers add secubox-waf`.

# Master switch — false = bridge disabled, WAF behaves as before.
enabled          = false

# CrowdSec LAPI URL reachable from where secubox_waf.py runs.
# Default is the LXC bridge gateway via socat (10.100.0.1:8080 → host
# loopback 127.0.0.1:8080). If your WAF runs on the host, use
# http://127.0.0.1:8080 directly.
url              = "http://10.100.0.1:8080"

# Machine credentials from `cscli machines add secubox-waf --password XXX`.
# We need WATCHER auth (POST /v1/alerts) not BOUNCER (read-only).
# Treat password as a secret. Do not commit a real value.
machine_id       = "secubox-waf"
machine_password = "REPLACE_ME"

# How long the decision lasts. Format : <number><unit> with unit ∈ {h, m, s}.
# Defaults to 4h. Longer = harder for an attacker IP to retry; shorter =
# faster recovery for shared/NAT IPs.
duration         = "4h"
