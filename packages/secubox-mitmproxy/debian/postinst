#!/bin/bash
set -e

case "$1" in
  configure)
    # Migrate /srv/mitmproxy* → /data/mitmproxy* (#319). Idempotent: only
    # acts if the legacy directory is a real dir and the new location is
    # absent. Leaves a symlink behind so any external references to
    # /srv/<name> keep working until operators clean them up.
    for _d in mitmproxy-waf mitmproxy mitmproxy-in; do
      if [ -d "/srv/$_d" ] && [ ! -L "/srv/$_d" ] && [ ! -e "/data/$_d" ]; then
        mkdir -p /data
        _was_active=""
        if systemctl is-active --quiet secubox-mitmproxy; then
          systemctl stop secubox-mitmproxy || true
          _was_active=1
        fi
        mv "/srv/$_d" "/data/$_d" && ln -s "/data/$_d" "/srv/$_d" \
          && echo "secubox-mitmproxy: migrated /srv/$_d → /data/$_d"
        [ -n "$_was_active" ] && systemctl start secubox-mitmproxy || true
      fi
    done

    # Create data directories
    install -d -o secubox -g secubox -m 750 /data/mitmproxy-waf/data
    install -d -o secubox -g secubox -m 750 /data/mitmproxy-waf/addons
    install -d -o secubox -g secubox -m 750 /data/mitmproxy-waf/config

    # Copy addon to data directory
    cp /usr/share/secubox/mitmproxy/addons/secubox_waf.py /data/mitmproxy-waf/addons/

    # Copy default rules if not exists
    if [ ! -f /data/mitmproxy-waf/data/waf-rules.json ]; then
      cp /usr/share/secubox/mitmproxy/data/waf-rules.json /data/mitmproxy-waf/data/
    fi

    # Phase 7.B (#498) : nft rate-limit pre-mitm.
    # Loads a standalone nft table that drops slowloris/scanner sources
    # exceeding 30 conn/s on TCP 80/443. Self-healing : 5-min timeout.
    if command -v nft >/dev/null 2>&1; then
        if [ -f /usr/share/secubox/mitmproxy/nftables/secubox-waf-ratelimit.nft ]; then
            if nft -f /usr/share/secubox/mitmproxy/nftables/secubox-waf-ratelimit.nft 2>/dev/null; then
                echo "secubox-mitmproxy: WAF rate-limit nft table loaded"
            else
                echo "secubox-mitmproxy: WARN — failed to load rate-limit nft table"
            fi
        fi
    fi

    # Phase 7.B (#498) : honeypot nginx routes for known bot signatures.
    # Returns empty 200s to common probes (/wp-admin /.env /.git ...) and
    # logs to /var/log/nginx/honeypot.log for offline analysis.
    if [ -d /etc/nginx/secubox-routes.d ]; then
        install -m 644 /usr/share/secubox/mitmproxy/nginx/honeypot.conf \
            /etc/nginx/secubox-routes.d/ 2>/dev/null || true
        # Add log_format secubox_honeypot at http block level if not present
        if [ ! -f /etc/nginx/conf.d/secubox-honeypot-log.conf ]; then
            cat > /etc/nginx/conf.d/secubox-honeypot-log.conf <<'EOF'
# Phase 7.B (#498) : honeypot log format
log_format secubox_honeypot '$time_iso8601 $remote_addr "$request" "$http_user_agent" "$http_referer"';
EOF
        fi
    fi

    # Phase 6.P (#496) : journal disk rotation — bound to 200 MB / 2 weeks.
    # Drops journald from typical 1-2 GB retention down to ~200 MB.
    if [ -d /etc/systemd/journald.conf.d ] || mkdir -p /etc/systemd/journald.conf.d; then
        install -m 644 /usr/share/secubox/mitmproxy/systemd/journald.conf.d/90-secubox-rotation.conf \
            /etc/systemd/journald.conf.d/ 2>/dev/null || true
        # Vacuum to enforce the new ceiling immediately
        journalctl --vacuum-size=200M >/dev/null 2>&1 || true
        systemctl restart systemd-journald >/dev/null 2>&1 || true
    fi

    # Phase 6.P (#496) : per-LXC memory budgets (caps + swap=0).
    # Prevents one runaway LXC from eating all 8 GB host RAM. Idempotent.
    if [ -x /usr/sbin/secubox-apply-lxc-memory-budget ]; then
        /usr/sbin/secubox-apply-lxc-memory-budget 2>&1 | head -20
    fi

    # Enable and start service
    systemctl daemon-reload
    systemctl enable secubox-mitmproxy.service
    systemctl start secubox-mitmproxy.service || true

    # WAF inspector self-healing watchdog (#624)
    systemctl enable secubox-waf-watchdog.timer 2>/dev/null || true
    systemctl start secubox-waf-watchdog.timer 2>/dev/null || true

    # Reload nginx if installed
    systemctl reload nginx 2>/dev/null || true
    ;;
esac
#DEBHELPER#
