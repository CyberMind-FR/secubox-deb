# Profil AppArmor ENFORCE de l'API de la clé mobile (#3467) : socket Unix, sudo vers le contrôleur.

#include <tunables/global>

/usr/sbin/secubox-mobile-api {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>

  /usr/sbin/secubox-mobile-api r,
  /usr/bin/python3* rix,
  # Le seul assistant privilégié : sudo (sudoers à argv exact), hors de ce profil.
  /usr/bin/sudo Ux,
  /usr/lib/secubox/mobile/** r,
  /usr/lib/secubox/ r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /usr/local/lib/python3*/** r,

  /etc/secubox/ r,
  /etc/secubox/secubox.conf r,
  /etc/secubox/users.json r,
  /etc/secubox/auth.toml r,
  deny /etc/secubox/secrets/** r,
  /var/lib/secubox/auth/ r,
  /var/lib/secubox/auth/sessions.json r,
  /var/log/secubox/delegation.log w,

  /run/secubox/ r,
  /run/secubox/mobile.sock rwk,

  network unix stream,
  /proc/sys/net/core/somaxconn r,
}
