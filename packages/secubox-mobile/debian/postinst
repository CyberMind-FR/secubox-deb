#!/bin/sh
set -e
if [ "$1" = configure ]; then
  getent passwd secubox-mobile >/dev/null 2>&1 || adduser --system --no-create-home --home /nonexistent \
    --shell /usr/sbin/nologin --ingroup secubox --gecos "SecuBox Mobile" secubox-mobile
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable secubox-mobile.service secubox-mobile-suivi.timer 2>/dev/null || true
  systemctl enable --now secubox-mobile-api.service 2>/dev/null || true
fi
#DEBHELPER#
exit 0
