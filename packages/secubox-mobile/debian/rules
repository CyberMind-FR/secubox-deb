#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -D -m 755 sbin/secubox-mobilectl debian/secubox-mobile/usr/sbin/secubox-mobilectl
	install -d debian/secubox-mobile/usr/lib/systemd/system
	install -m 644 systemd/* debian/secubox-mobile/usr/lib/systemd/system/

override_dh_installsystemd:
	true
