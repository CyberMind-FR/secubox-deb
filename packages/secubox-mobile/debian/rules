#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -D -m 755 sbin/secubox-mobilectl debian/secubox-mobile/usr/sbin/secubox-mobilectl
	install -m 755 sbin/secubox-mobile-api debian/secubox-mobile/usr/sbin/secubox-mobile-api
	install -D -m 644 apparmor/secubox-mobile-api debian/secubox-mobile/etc/apparmor.d/secubox-mobile-api
	install -d debian/secubox-mobile/usr/lib/secubox/mobile/api
	install -m 644 api/*.py debian/secubox-mobile/usr/lib/secubox/mobile/api/
	install -d debian/secubox-mobile/usr/share/secubox/www debian/secubox-mobile/usr/share/secubox/menu.d
	cp -r www/. debian/secubox-mobile/usr/share/secubox/www/
	cp -r menu.d/. debian/secubox-mobile/usr/share/secubox/menu.d/
	install -D -m 644 nginx/mobile.conf debian/secubox-mobile/etc/nginx/secubox-routes.d/mobile.conf
	install -D -m 440 debian/secubox-mobile.sudoers debian/secubox-mobile/etc/sudoers.d/secubox-mobile
	install -d debian/secubox-mobile/usr/lib/systemd/system
	install -m 644 systemd/* debian/secubox-mobile/usr/lib/systemd/system/

override_dh_installsystemd:
	true
