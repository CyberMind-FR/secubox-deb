"""Lanceur de l'API : un programme nommé, pour que le profil AppArmor s'y attache (#3467)."""
import sys

import uvicorn

sys.path.insert(0, "/usr/lib/secubox/mobile")
uvicorn.run("api.main:app", uds="/run/secubox/mobile.sock", workers=1, log_level="warning")
