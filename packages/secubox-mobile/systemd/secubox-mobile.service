# Root (exception RULES-CODE § 10) : Unbound, nftables. Actif tant que la clé tourne ; l'arrêt rend le DNS à la Freebox.
# After= réseau : à l'extinction, ce service s'arrête AVANT le réseau, la Freebox reste joignable.
[Unit]
Description=SecuBox Mobile — protection du réseau local, retrait à l'extinction (#3467)
Wants=network-online.target unbound.service
After=network-online.target unbound.service nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/secubox-mobilectl activer
ExecStop=-/usr/sbin/secubox-mobilectl retirer
TimeoutStartSec=600
TimeoutStopSec=90
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictSUIDSGID=yes
ReadWritePaths=/etc/unbound/unbound.conf.d /etc/nftables.d /var/lib/secubox-mobile -/var/lib/secubox-dns-listes -/var/lib/secubox/ad-guard -/var/lib/secubox/freebox -/var/log/secubox /run
StateDirectory=secubox-mobile
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
