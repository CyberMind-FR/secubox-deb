#!/bin/sh
# SecuBox MQTT — pre-remove
set -e

case "$1" in
    remove|deconfigure|upgrade)
        systemctl stop secubox-mqtt.service 2>/dev/null || true
        systemctl disable secubox-mqtt.service 2>/dev/null || true
        # We do not destroy the LXC here — purge does that via postrm if asked.
        ;;
esac

#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/mqtt/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "mqtt : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
