#!/bin/bash
set -e
case "$1" in
  configure)
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home \
        --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    install -d -o root -g root -m 1777 /run/secubox
    install -d -o secubox -g secubox -m 755 /var/lib/secubox

    # #817 Task 9: module state dir for the SQLite device store
    # (devices.db). The unit runs with UMask=0000, so if the app were
    # left to mkdir() this itself at import time it would land 0777 —
    # pre-create it here with the correct perms so `exist_ok=True` just
    # no-ops in the app. `devices.db` itself (and its idempotent
    # migrate_legacy() import of the mac-guard/device-intel/iot-guard
    # legacy stores) is created lazily by the app's first
    # `DeviceStore(...)` at FastAPI startup / first collector cycle —
    # NOT here. Postinst does no DB/schema work, only directory perms.
    install -d -o secubox -g secubox -m 750 /var/lib/secubox/nac

    systemctl daemon-reload
    systemctl enable secubox-nac.service
    systemctl start  secubox-nac.service || true
    install -d -m 755 /etc/nginx/secubox.d
    systemctl reload nginx 2>/dev/null || true

    # Project B (#820 Task 9): enable the presence-report TIMER only — the
    # .service is a oneshot the timer invokes, never enabled/started
    # directly. This is safe to enable unconditionally: the timer's
    # oneshot calls `secubox-presence-report`, which delegates to Task 7's
    # `run_scheduled()` — that itself no-ops (returns without emailing)
    # unless an operator has separately configured
    # `/etc/secubox/reporter-schedule.json` with a `frequency`+`recipient`.
    # This is UNRELATED to Task 6's tiered EMAIL ALERTS, which stay OFF by
    # design: only a commented `.example` is shipped
    # (/usr/share/secubox/nac/presence-alerts.toml.example) — it is never
    # copied to the live `/etc/secubox/presence-alerts.toml` path here, so
    # `load_config()` keeps returning "no config" (no alerts) until an
    # operator opts in by hand.
    systemctl daemon-reload
    systemctl enable secubox-presence-report.timer 2>/dev/null || true
    systemctl start  secubox-presence-report.timer 2>/dev/null || true

    # #1766 : la table `inet secubox_nac`, ses règles et ses éléments sont portés par
    # /etc/nftables.d/secubox-nac.nft et appliqués par secubox-nac-apply (root, étroit) à
    # partir de /var/lib/secubox/nac/nft-desired.json. Avant : table créée à chaud ici,
    # sans aucune règle qui la référence, effacée au premier `flush ruleset`.
    #
    # #817 Task 9 — migration unique et idempotente : les éléments de la table
    # `inet secubox_mac_guard` (retirée) rejoignent l'état voulu :
    #   mac_blacklist -> blocked      mac_whitelist -> lan_allowed
    # Silencieuse si mac-guard n'a jamais été installé : ne doit jamais faire échouer configure.
    install -d -m 0775 -o secubox -g secubox /var/lib/secubox/nac 2>/dev/null || true
    if command -v nft >/dev/null 2>&1; then
      for _pair in "mac_blacklist:blocked" "mac_whitelist:lan_allowed"; do
        _src_set="${_pair%%:*}"
        _dst_set="${_pair##*:}"
        nft list set inet secubox_mac_guard "$_src_set" 2>/dev/null \
          | grep -oE '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' \
          | while IFS= read -r _mac; do
              NAC_NFT_DESIRED=/var/lib/secubox/nac/nft-desired.json \
              python3 -c "import sys,importlib.util as u
s=u.spec_from_file_location('d','/usr/lib/secubox/nac/api/nft_desired.py');m=u.module_from_spec(s);s.loader.exec_module(m)
m.add(sys.argv[1],sys.argv[2])" "$_dst_set" "$_mac" 2>/dev/null || true
            done
      done
    fi

    # Application : unité .path (réagit aux changements) + un premier passage maintenant.
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable secubox-nac-apply.path 2>/dev/null || true
    systemctl start  secubox-nac-apply.path 2>/dev/null || true
    systemctl start  secubox-nac-apply.service 2>/dev/null || true
    ;;
esac
#DEBHELPER#
