#!/bin/bash
set -e
case "$1" in
  remove|deconfigure)
    rm -f /etc/nginx/secubox.d/nac.conf
    systemctl reload nginx 2>/dev/null || true
    ;;
  upgrade)
    # Don't remove nginx config on upgrade
    ;;
esac
systemctl stop    secubox-nac.service 2>/dev/null || true
systemctl disable secubox-nac.service 2>/dev/null || true
# Project B (#820 Task 9): stop/disable the presence-report timer too (the
# oneshot .service it invokes is never separately enabled, nothing to do
# for it here).
systemctl stop    secubox-presence-report.timer 2>/dev/null || true
systemctl disable secubox-presence-report.timer 2>/dev/null || true
#DEBHELPER#
