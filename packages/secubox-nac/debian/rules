#!/usr/bin/make -f
%:
	dh $@

# #820 whole-branch fix M4: dh's auto-generated systemd snippet may
# enable/start units on install by default. postinst hand-manages ONLY the
# presence-report TIMER (enable+start) and the main secubox-nac.service —
# `dh_installsystemd` must install the unit files verbatim and leave every
# enable/start decision to postinst, never take it over itself.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_auto_install:
	install -d debian/secubox-nac/usr/lib/secubox/nac/
	cp -r api debian/secubox-nac/usr/lib/secubox/nac/
	install -d debian/secubox-nac/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-nac/usr/share/secubox/www/ || true
	install -d debian/secubox-nac/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-nac/usr/share/secubox/menu.d/ || true
	# Modular nginx config
	install -d debian/secubox-nac/etc/nginx/secubox.d
	[ -f nginx/nac.conf ] && cp nginx/nac.conf debian/secubox-nac/etc/nginx/secubox.d/ || true
	# Project B (#820 Task 9): presence report timer/service + a commented
	# alert-config .example (never the live /etc/secubox path — see
	# postinst / the .example file's own header for the off-by-default
	# rationale).
	install -d debian/secubox-nac/usr/sbin
	[ -f sbin/secubox-presence-report ] && install -m 0755 sbin/secubox-presence-report \
	  debian/secubox-nac/usr/sbin/secubox-presence-report || true
	install -d debian/secubox-nac/lib/systemd/system
	[ -f debian/secubox-presence-report.service ] && install -m 0644 \
	  debian/secubox-presence-report.service debian/secubox-nac/lib/systemd/system/ || true
	[ -f debian/secubox-presence-report.timer ] && install -m 0644 \
	  debian/secubox-presence-report.timer debian/secubox-nac/lib/systemd/system/ || true
	install -d debian/secubox-nac/usr/share/secubox/nac
	[ -f debian/presence-alerts.toml.example ] && install -m 0644 \
	  debian/presence-alerts.toml.example \
	  debian/secubox-nac/usr/share/secubox/nac/presence-alerts.toml.example || true
