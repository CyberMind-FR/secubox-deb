# SecuBox :: moteur DPI (#1345)

# Interface écoutée. Celle qui porte l'adresse LAN de la box : c'est là que
# passe le trafic des terminaux, et c'est ce qu'on veut classer.
INTERFACE=eth2

# Les deux sockets. Le DISTRIBUTEUR doit être exactement celui que sbxdpi
# attend (DPI_DISTRIBUTOR_SOCK dans /etc/secubox/dpi.env) — sinon les deux
# moitiés de la chaîne s'ignorent poliment.
COLLECTEUR=/run/secubox/ndpi/collecteur.sock
DISTRIBUTEUR=/run/secubox/ndpi/distributor.sock

# Le producteur tourne sous son propre compte.
UTILISATEUR=secubox-ndpi
GROUPE=secubox-ndpi

# Le LECTEUR est sbxdpi, qui tourne sous un autre compte. C'est ce groupe-là
# qui doit pouvoir ouvrir le socket distributeur.
GROUPE_LECTEUR=secubox-toolbox
