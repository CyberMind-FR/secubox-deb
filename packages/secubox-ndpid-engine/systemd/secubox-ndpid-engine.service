[Unit]
Description=SecuBox nDPId — capture et classification DPI [#1345]
Documentation=https://github.com/utoni/nDPId
# LE DISTRIBUTEUR D'ABORD : nDPId se connecte au socket collecteur au
# démarrage. S'il n'existe pas encore, il échoue et repart en boucle de
# redémarrage — bruyant, et pour rien.
After=secubox-ndpisrvd.service
Requires=secubox-ndpisrvd.service

[Service]
Type=simple
EnvironmentFile=-/etc/secubox/ndpid-engine.env
# Lot 4 (#3374) : garde CPU (gk2 chargé). Capture COMPLÈTE conservée (Hall, /ndpid/) : aucun filtre de capture.
# 40 % d'un cœur et non 25 % : aucune mesure de nDPId sur gk2 n'existe ; nDPId est mono-fil et capture tout le LAN, un plafond
# trop bas ferait perdre des paquets à pcap (classification dégradée sur /ndpid/). 40 % laisse plus de 3,5 cœurs au reste.
CPUQuota=40%
Nice=10
# LA CAPTURE EXIGE CAP_NET_RAW ; ABANDONNER SES PRIVILÈGES EXIGE CAP_SETUID.
#
# Le premier périmètre ne gardait que NET_RAW et NET_ADMIN — et le démon
# échouait sur « Change user/group to secubox-ndpi failed ». La cause n'est pas
# évidente à lire : en retirant SETUID du BoundingSet, on retire la capacité de
# DESCENDRE, pas seulement celle de monter. Un périmètre trop serré empêche
# donc le durcissement qu'il était censé servir.
#
# nDPId démarre root, ouvre l'interface, puis redescend vers `-u` de lui-même.
# C'est le bon ordre, et il ne garde rien après.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN
# Le lanceur choisit une interface qui existe (#2740) : `eth2` en dur faisait redémarrer nDPId toutes les 5 s sur une carte qui s'appelle autrement.
ExecStart=/usr/sbin/secubox-ndpid-engine-run
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
