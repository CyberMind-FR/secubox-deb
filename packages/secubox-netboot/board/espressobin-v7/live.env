# SecuBox-Deb :: live réseau — ESPRESSObin v7 eMMC (Armada 3720, 1 Go) (#3233), lu par scripts/build-live-netboot.sh.
# ⚠️ À valider au banc série : adresses et comportement du switch sur le U-Boot usine.
LIVE_NOM=espressobin-live
LIVE_TITRE="ESPRESSObin v7"
LIVE_DTB=armada-3720-espressobin-v7-emmc.dtb
LIVE_PILOTE=mvneta
LIVE_CONSOLE=ttyMV0,115200
LIVE_ETHACT=neta@30000
# Adresse de script de l'environnement usine, celle des procédures validées de l'image (boot-usb.scr).
LIVE_SCRIPT_ADDR='${loadaddr}'
# DRAM à 0x0, 1 Go ; 0x04000000-0x04200000 réservé (PSCI, armada-37xx.dtsi). Noyau Debian (~37 Mo) à 0x07000000,
# 64 Mo laissés au noyau, initrd au-dessus ; U-Boot se reloge près de 0x3F000000.
LIVE_KERNEL_ADDR=0x07000000
LIVE_FDT_ADDR=0x06f00000
LIVE_RAMDISK_ADDR=0x0b000000
# Repris du boot.cmd de l'image minimal, validé sur la carte : switch 88E6341 laissé en commutation par U-Boot (eth0
# passe par lui ; mv88e6xxx en ferait un simple conduit DSA), carte Wi-Fi ath10k bloquée (gel des deux cœurs, #2177),
# correctif DDR du contrôleur eMMC xenon (le live doit voir l'eMMC qu'il écrit).
LIVE_BOOTARGS="modprobe.blacklist=mv88e6xxx,mv88e6085,dsa_core,ath10k_pci,ath10k_core initcall_blacklist=mv88e6xxx_driver_init sdhci.debug_quirks2=0x40"
