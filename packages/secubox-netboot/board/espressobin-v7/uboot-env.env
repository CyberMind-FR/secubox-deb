# SecuBox-Deb :: préparation de l'environnement U-Boot — ESPRESSObin v7 (#3271), lu par scripts/uboot-env.py (DONNÉES,
# jamais exécuté). Adresses sûres, ethact et nom du live : live.env (une seule source).
#
# Support installé : eMMC = mmc 1 (la carte SD est mmc 0). bootcmd = celui de l'ancien fix-bootcmd #2826, validé sur la carte :
# boot.scr de l'eMMC, puis boot-usb.scr de la clé USB.
UBOOT_MMC=1
UBOOT_CHARGE=load
UBOOT_BOOTCMD='mmc dev 1; if load mmc 1:1 ${loadaddr} boot.scr; then source ${loadaddr}; fi; usb start; if load usb 0:1 ${loadaddr} boot-usb.scr; then source ${loadaddr}; fi'
#
# Environnement en SPI NOR (DIAGNOSTIC seulement : R-3271-1, rien n'est écrit depuis Linux), même emplacement dans les trois U-Boot Globalscale de l'Armada 3720 :
# - 2017.03 (u-boot-2017.03-armada-17.10-espressobin) et 2018.03 (u-boot-2018.03-armada-18.12-gti,
#   gti_espressobin-88f3720_defconfig : CONFIG_ENV_IS_IN_SPI_FLASH=y) : include/configs/mvebu_armada-common.h,
#   CONFIG_ENV_SIZE = CONFIG_ENV_SECT_SIZE = 64 Kio, CONFIG_ENV_OFFSET = 0x400000 - CONFIG_ENV_SIZE = 0x3f0000 ;
# - 2020.10 (u-boot-2020.10-gti) : gti_espressobin-88f3720_defconfig, CONFIG_ENV_OFFSET=0x3F0000, CONFIG_ENV_SIZE=0x10000.
# Linux (armada-3720-espressobin.dtsi) : flash SPI sans partitions → un seul mtd, la flash entière ; offset absolu.
UBOOT_ENV_MTD=*
UBOOT_ENV_SPI=0x3f0000
UBOOT_ENV_TAILLE=0x10000
UBOOT_ENV_SOURCE="u-boot-2018.03-armada-18.12-gti include/configs/mvebu_armada-common.h (CONFIG_ENV_OFFSET 0x3f0000) ; 2017.03 et 2020.10 identiques"
