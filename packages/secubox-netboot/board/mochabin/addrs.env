# SecuBox-Deb :: adresses de chargement — board MOCHAbin (Armada 7040) (#737)
# ⚠️ À VALIDER AU BANC SÉRIE (`printenv` du U-Boot usine) avant tout usage réel.
# OVERLAY_LOAD ne doit chevaucher NI TF-A, NI la zone réservée, NI le U-Boot usine.
# DRAM démarre à 0x0 (4/8 GB) ; ces valeurs sont des défauts plausibles, pas vérifiés.

OVERLAY_LOAD=0x06000000     # où l'usine charge le 2ᵉ U-Boot (bootm)
DEFCONFIG=mvebu_db_armada8k_defconfig

# adresses pour boot.fit (kernel/dtb/initrd) — héritées de l'env usine si présentes
KLOAD=0x02080000
KENTRY=0x02080000
FDTLOAD=0x06f00000
RDLOAD=0x07000000
