# SecuBox-Deb :: live réseau — MOCHAbin (Armada 7040) (#3079), lu par scripts/build-live-netboot.sh (#3233).
LIVE_NOM=mochabin-live
LIVE_TITRE="MOCHAbin"
LIVE_DTB=armada-7040-mochabin.dtb
LIVE_PILOTE=mvpp2
LIVE_CONSOLE=ttyS0,115200
# WAN 1G = mvpp2-2 ; mvpp2-0 (SFP+) est le port prime par défaut d'U-Boot, d'où les échecs DHCP/ARP.
LIVE_ETHACT=mvpp2-2
LIVE_SCRIPT_ADDR='${scriptaddr}'
# Au-dessus de 0x04000000-0x04200000 (PSCI/ATF) : le noyau Debian (~37 Mo) chargé plus bas débordait dessus.
LIVE_KERNEL_ADDR=0x08000000
LIVE_FDT_ADDR=0x0c000000
LIVE_RAMDISK_ADDR=0x0c100000
# mv88e6xxx chargé tard : mvpp2 rouvre ses ports, eth2 perd sa porteuse (#2004). Le netplan de l'image met eth1/eth2
# dans br-lan : networkd masqué, le live garde le réseau de l'initrd.
LIVE_BOOTARGS="modprobe.blacklist=mv88e6xxx systemd.mask=systemd-networkd.service systemd.mask=systemd-networkd.socket"
