# SecuBox-Deb :: préparation de l'environnement U-Boot — MOCHAbin (#3271), lu par scripts/uboot-env.py (DONNÉES, jamais
# exécuté). Adresses sûres, ethact et nom du live : live.env (une seule source).
#
# Support installé : eMMC = mmc 0. bootcmd = séquence validée au banc le 2026-10-29 (U-Boot Marvell 2018.03 d'usine) :
# le port WAN cuivre (mvpp2-2) n'est initialisé pour Linux que si U-Boot l'a touché. On le touche par un `ping` vers une
# adresse locale fictive (169.254.10.2), PAS par `dhcp` : sans câble ou sans lien, dhcp enchaînait ~129 BOOTP et bloquait
# le démarrage hors réseau ; le ping échoue en quelques secondes (PHY + ARP) puis la séquence continue sur l'eMMC.
# Validé au banc gk6 hors réseau le 2026-11-01 (démarrage direct sur l'eMMC, aucun BOOTP).
# Adresses #3091 et bootcmd validés au banc (2026-10-29).
UBOOT_VALIDE_BANC=oui
UBOOT_MMC=0
UBOOT_CHARGE=fatload
UBOOT_BOOTCMD='setenv ethact mvpp2-2; setenv ipaddr 169.254.10.1; setenv netmask 255.255.0.0; ping 169.254.10.2; mmc dev 0; fatload mmc 0:1 ${loadaddr} boot.scr; source ${loadaddr}'
#
# Environnement en SPI NOR (DIAGNOSTIC seulement : R-3271-1, rien n'est écrit depuis Linux, le script
# secubox-uboot-env.scr pose l'environnement depuis U-Boot). Source : U-Boot Globalscale, branche u-boot-2018.03-armada-18.12-gti
# (github.com/globalscaletechnologies/u-boot-marvell, 926d08c7ce), configs/gti_mochabin-88f7040_defconfig :
# CONFIG_ENV_IS_IN_SPI_FLASH=y ; include/configs/mvebu_armada-common.h : CONFIG_ENV_SIZE = CONFIG_ENV_SECT_SIZE = 64 Kio,
# CONFIG_ENV_OFFSET = 0x400000 - CONFIG_ENV_SIZE = 0x3f0000 (ni NAND ni MMC). L'environnement relevé sur la carte
# (loadaddr=0x6000000, kernel_addr_r=0x7000000, fdt_addr_r=0x6f00000, pas de scriptaddr) est celui de ce même en-tête.
# Linux (arch/arm64/boot/dts/marvell/armada-7040-mochabin.dts) : partition « u-boot-env » 0x3f0000+0x10000, écrivable ;
# « firmware » (0x0+0x3e0000) et « hw-info » (0x3e0000+0x10000, EEPROM de config Marvell) en lecture seule.
UBOOT_ENV_MTD=u-boot-env
UBOOT_ENV_SPI=0x3f0000
UBOOT_ENV_TAILLE=0x10000
UBOOT_ENV_SOURCE="u-boot-2018.03-armada-18.12-gti include/configs/mvebu_armada-common.h (CONFIG_ENV_OFFSET 0x3f0000) ; armada-7040-mochabin.dts (u-boot-env)"
# Autre disposition : U-Boot Globalscale 2020.10 (gti_mochabin-88f7040_defconfig) met l'environnement à 0x180000.
