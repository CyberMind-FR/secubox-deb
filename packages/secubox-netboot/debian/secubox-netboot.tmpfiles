# Créé par aucun paquet jusqu ici (#1482) : absent sur une image neuve et dans le
# tmpfs du live, l unité ne montait pas son namespace. Mêmes droits que gk2.
d /var/lib/secubox/netboot 0755 root root -
d /var/log/secubox/netboot 0750 secubox secubox -
d /etc/secubox/netboot 0755 root root -
