# SecuBox-Deb :: sbx-netflash (#3079) — DANS LE LIVE netbooté, écrit une image eMMC servie par le serveur de boot.
#
# Le live tourne en RAM (rootfs squashfs récupéré en HTTP) : l'eMMC est libre. Flux :
#   liste des images (images.txt) → contrôle de la mémoire libre → téléchargement de l'image .img.gz et de sa
#   signature détachée dans /run (tmpfs) → VÉRIFICATION de la signature avec la clé publique EMBARQUÉE dans le
#   live (/etc/secubox/netboot-image.pub) → secubox-flash-emmc (refuse si l'on a démarré de l'eMMC, demande
#   « FLASH » sauf --auto). Signature invalide = rien n'est écrit, le fichier est supprimé.
# #3233 (ESPRESSObin, 1 Go) : quand l'image ne tient pas en RAM, elle s'écrit EN FLUX (curl | secubox-flash-emmc
#   --stdin) ; signature et empreinte sont vérifiées pendant l'écriture et un échec invalide l'eMMC. Formats .img.gz et
#   .img.xz. Une image dont la taille décompressée (4e colonne d'images.txt) dépasse l'eMMC est refusée avant d'écrire.
#
# Serveur : --srv HOTE[:PORT], sinon l'hôte de `fetch=` (ou `sbx_srv=`) de la ligne de commande du noyau.
# Avec --nom (#3100) : le maître sert un lot signé (GET http://SRV/lot-flash?nom=NOM, même clé que les images) ;
# après l'écriture de l'image (--no-reboot), on dépose sur l'eMMC le code de jonction (p2, 0600), l'ancre du maître
# (p2, 0644) et secubox/profil.toml (p1, monté en /boot) : la box rejoint le maillage toute seule au premier démarrage.
set -euo pipefail

PUB=/etc/secubox/netboot-image.pub
TRAVAIL=/run/sbx-netflash
JOURNAL=/var/log/sbx-netflash.log
srv="" dir="" image="" auto=0 liste=0 reboot_opt=() nom="" reboot_demande=1

usage() {
    cat <<EOF
sbx-netflash — écrit sur l'eMMC une image signée servie par le serveur de boot

  sbx-netflash --list                         images disponibles
  sbx-netflash --image NOM.img.gz             télécharge, vérifie la signature, écrit (demande « FLASH »)
  sbx-netflash --image NOM.img.gz --auto      sans confirmation
  sbx-netflash --image NOM.img.gz --nom NOM   en plus : dépose le code de jonction, l'ancre du maître et le profil
Options : --nom NOM  --srv HOTE[:PORT]  --dir DOSSIER  --no-reboot
EOF
}

log()  { echo "[sbx-netflash] $*"; echo "[$(date -Iseconds)] $*" >> "$JOURNAL" 2>/dev/null || true; }
fail() { log "ERREUR : $*"; exit 1; }

# ── Petite RAM (#3233) ─────────────────────────────────────────────────────
mode_ecriture() { # TAILLE DISPO → « ram » si l'image tient en tmpfs avec 768 Mo de marge, sinon « flux »
    if [ "$2" -gt $(( $1 + 768 * 1048576 )) ]; then echo ram; else echo flux; fi
}

format_image() { # NOM → gz | xz
    case "$1" in *.img.gz) echo gz ;; *.img.xz) echo xz ;; *) return 1 ;; esac
}

emmc_detectee() { # comme secubox-flash-emmc : le premier mmcblk doté d'une partition boot0 (eMMC, jamais une carte SD)
    local d
    for d in /dev/mmcblk0 /dev/mmcblk1 /dev/mmcblk2; do
        if [ -b "${d}boot0" ]; then echo "$d"; return 0; fi
    done
    return 1
}

confirme_flash() { # IMAGE — « FLASH » lu sur le terminal : en flux, l'entrée standard du flasheur porte l'image
    local r tty="${SBX_TTY:-/dev/tty}"
    IFS= read -r -p "Taper FLASH pour effacer l'eMMC et y écrire $1 : " r < "$tty" >&2 || return 1
    [ "$r" = "FLASH" ]
}

telecharge_flux() { # URL → sortie standard ; jamais de reprise (--retry) : un flux recommencé serait corrompu
    if command -v curl >/dev/null 2>&1; then curl -fsS "$1"; else wget -qO- "$1"; fi
}


# ── Dépôt du lot (#3100) ───────────────────────────────────────────────────
# Extrait le lot et sa signature de la réponse JSON du maître, puis vérifie la signature (clé embarquée, même
# commande que les images) sur les octets EXACTS du texte du lot. Écrit le lot dans LOT_SORTIE seulement si valide.
verifie_lot() { # REPONSE_JSON LOT_SORTIE
    local rep="$1" sortie="$2" t
    t="$(mktemp -d)" || return 1
    if ! python3 -I - "$rep" "$t/lot" "$t/sig" <<'PY'
import base64, json, sys
r = json.load(open(sys.argv[1]))
if not isinstance(r.get("lot"), str) or not isinstance(r.get("signature"), str):
    sys.exit(1)
open(sys.argv[2], "wb").write(r["lot"].encode("utf-8"))
open(sys.argv[3], "wb").write(base64.b64decode(r["signature"], validate=True))
PY
    then rm -rf "$t"; return 1; fi
    if ! openssl dgst -sha256 -verify "$PUB" -signature "$t/sig" "$t/lot" >/dev/null 2>&1; then
        rm -rf "$t"; return 1
    fi
    cp "$t/lot" "$sortie" && chmod 0600 "$sortie"
    rm -rf "$t"
}

champ_lot() { # LOT_JSON CHAMP : valeur texte ("" si absente) ; "ancre" sort l'objet en JSON
    python3 -I - "$1" "$2" <<'PY'
import json, sys
v = json.load(open(sys.argv[1])).get(sys.argv[2], "")
sys.stdout.write(json.dumps(v) if isinstance(v, dict) else str(v))
PY
}

# Sans empreinte dans le lot, le mot de passe est saisi ici et haché : sans module argon2, on refuse AVANT d'écrire
# (jamais de repli « demander » : l'assistant s'ouvrirait et bloquerait la jonction automatique au maillage).
verifie_hacheur_ou_refuse() { # EMPREINTE_DU_LOT
    [ -n "$1" ] && return 0
    if ! python3 -c "import argon2" >/dev/null 2>&1; then
        log "ERREUR : le lot n'a pas d'empreinte administrateur et ce live n'a pas le module python3 argon2 : le mot de passe ne peut pas être haché. Rien n'a été écrit."
        return 1
    fi
}

saisit_empreinte() { # → empreinte argon2 sur stdout ; mot de passe jamais en argument ni dans le journal
    local a b tty="${SBX_TTY:-/dev/tty}"
    for _ in 1 2 3; do
        # IFS= : les espaces en tête ou en queue du mot de passe sont conservés ; échec de lecture = abandon
        IFS= read -r -s -p "Mot de passe administrateur de la box : " a < "$tty" >&2 || return 1; echo >&2
        IFS= read -r -s -p "Confirmer : " b < "$tty" >&2 || return 1; echo >&2
        if [ -z "$a" ]; then echo "mot de passe vide" >&2; continue; fi
        if [ "$a" = "$b" ]; then
            printf '%s\n' "$a" | python3 -c "import argon2,sys; print(argon2.PasswordHasher().hash(sys.stdin.read().rstrip('\n')))"
            return
        fi
        echo "les deux saisies diffèrent" >&2
    done
    return 1
}

# Le lot doit porter un code de jonction et une ancre exploitables : contrôle AVANT toute écriture.
lot_complet() { # LOT_JSON
    python3 -I - "$1" <<'PY'
import json, sys
l = json.load(open(sys.argv[1]))
c, a = l.get("code"), l.get("ancre")
ok = isinstance(c, str) and c.startswith("sbxmesh1.") and isinstance(a, dict) \
    and isinstance(a.get("cle_publique"), str) and a["cle_publique"].strip() != ""
sys.exit(0 if ok else 1)
PY
}

# Écrit sur la racine RACINE (p2 montée) et sur BOOT (p1 montée) : code 0600, ancre 0644, secubox/profil.toml.
depose_dans() { # RACINE BOOT LOT_JSON PROFIL_TOML
    local racine="$1" boot="$2" lot="$3" profil="$4" code
    code="$(champ_lot "$lot" code)"
    [ -n "$code" ] || { log "ERREUR : lot sans code"; return 1; }
    lot_complet "$lot" || { log "ERREUR : lot sans ancre exploitable"; return 1; }
    install -d -m0755 "$racine/var/lib/secubox/p2p" "$racine/etc/secubox/p2p" "$boot/secubox" || return 1
    ( umask 077; printf '%s' "$code" > "$racine/var/lib/secubox/p2p/automesh.code" ) || return 1
    chmod 0600 "$racine/var/lib/secubox/p2p/automesh.code"
    champ_lot "$lot" ancre > "$racine/etc/secubox/p2p/ancre-maitre.json" || return 1
    chmod 0644 "$racine/etc/secubox/p2p/ancre-maitre.json"
    install -m0644 "$profil" "$boot/secubox/profil.toml" || return 1
}

# Monte p2 puis p1, dépose, démonte. Un échec de montage n'écrit rien (et ne touche pas à ce qui est déjà flashé).
depose_sur_emmc() { # DEV_P2 DEV_P1 LOT_JSON PROFIL_TOML
    local p2="$1" p1="$2" lot="$3" profil="$4" m="${SBX_TRAVAIL_DEPOT:-$TRAVAIL/depot}" rc=0
    mkdir -p "$m/p2" "$m/p1" || return 1
    mount "$p2" "$m/p2" || { log "ERREUR : montage de $p2 impossible, rien n'a été déposé (l'image écrite est intacte)"; return 1; }
    if mount "$p1" "$m/p1"; then
        depose_dans "$m/p2" "$m/p1" "$lot" "$profil" || rc=1
        sync; umount "$m/p1" || rc=1
    else
        log "ERREUR : montage de $p1 impossible, rien n'a été déposé"; rc=1
    fi
    umount "$m/p2" || rc=1
    [ "$rc" -eq 0 ] || log "ERREUR : dépôt incomplet sur l'eMMC (image intacte) : relancer avec --nom"
    return "$rc"
}

main() {
while [ $# -gt 0 ]; do case "$1" in
    --srv) srv="$2"; shift 2 ;;
    --dir) dir="$2"; shift 2 ;;
    --image) image="$2"; shift 2 ;;
    --nom) nom="$2"; shift 2 ;;
    --auto) auto=1; shift ;;
    --list) liste=1; shift ;;
    --no-reboot) reboot_opt=(--no-reboot); reboot_demande=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
esac; done

# même motif que le lot du maître (api/lot.py) et sbx-netflash-profil ; =~ de bash : pas de multiligne
NOM_RE='^[a-z]([a-z0-9-]{0,29}[a-z0-9])?$'
if [ -n "$nom" ] && ! [[ "$nom" =~ $NOM_RE ]]; then fail "nom invalide : $nom"; fi
[ "$(id -u)" -eq 0 ] || fail "à lancer en root"

# Serveur et dossier par défaut : ceux qui ont servi le live (fetch=http://HOTE:PORT/DOSSIER/filesystem.squashfs).
CMDLINE="$(cat /proc/cmdline 2>/dev/null || true)"
if [ -z "$srv" ] || [ -z "$dir" ]; then
    f="$(printf '%s\n' $CMDLINE | sed -n 's#^fetch=http://##p' | head -n1)"
    if [ -n "$f" ]; then
        [ -n "$srv" ] || srv="${f%%/*}"
        [ -n "$dir" ] || { d="${f#*/}"; dir="${d%/*}"; }
    fi
fi
[ -n "$srv" ] || srv="$(printf '%s\n' $CMDLINE | sed -n 's#^sbx_srv=##p' | head -n1)"
[ -n "$srv" ] || fail "serveur inconnu : --srv HOTE[:PORT]"
[ -n "$dir" ] || dir="mochabin-live"
BASE="http://$srv/$dir"

telecharge() { # URL DEST
    if command -v curl >/dev/null 2>&1; then curl -fSL --retry 3 -o "$2" "$1"
    else wget -O "$2" "$1"; fi
}

mkdir -p "$TRAVAIL"
# sortie d'erreur gardée : « Network is unreachable » ou un 404 se lisent directement
telecharge "$BASE/images.txt" "$TRAVAIL/images.txt" >/dev/null || fail "liste introuvable : $BASE/images.txt"
# images.txt : « NOM TAILLE_OCTETS SHA256 » par ligne
if [ "$liste" -eq 1 ] || [ -z "$image" ]; then
    echo "Images disponibles sur $BASE :"
    awk '{printf "  %-45s %6d Mo\n", $1, $2/1048576}' "$TRAVAIL/images.txt"
    [ -n "$image" ] || { echo; echo "Écrire : sbx-netflash --image NOM"; exit 0; }
fi

case "$image" in */*|*..*|"") fail "nom d'image invalide : $image" ;; esac
ligne="$(awk -v n="$image" '$1==n' "$TRAVAIL/images.txt")"
[ -n "$ligne" ] || fail "image absente de la liste du serveur : $image"
taille="$(echo "$ligne" | awk '{print $2}')"
sha="$(echo "$ligne" | awk '{print $3}')"
[ -s "$PUB" ] || fail "clé publique absente ($PUB) : ce live n'a pas été construit pour le flash réseau"

# --nom : lot signé récupéré et VÉRIFIÉ avant toute écriture ; refus = rien n'est écrit.
lot="" profil=""
if [ -n "$nom" ]; then
    mkdir -p "$TRAVAIL/lot"; chmod 0700 "$TRAVAIL/lot"
    telecharge "http://$srv/lot-flash?nom=$nom" "$TRAVAIL/lot/reponse.json" >/dev/null || fail "lot de flash refusé ou introuvable : http://$srv/lot-flash?nom=$nom"
    lot="$TRAVAIL/lot/lot.json"
    verifie_lot "$TRAVAIL/lot/reponse.json" "$lot" || { rm -rf "$TRAVAIL/lot"; fail "LOT INVALIDE (signature ou format) — rien n'a été écrit"; }
    [ "$(champ_lot "$lot" nom)" = "$nom" ] || { rm -rf "$TRAVAIL/lot"; fail "le lot n'est pas celui de $nom — rien n'a été écrit"; }
    lot_complet "$lot" || { rm -rf "$TRAVAIL/lot"; fail "lot sans code de jonction ou sans ancre exploitable — rien n'a été écrit"; }
    log "lot VALIDE pour $nom."
    empreinte="$(champ_lot "$lot" admin_empreinte)"
    verifie_hacheur_ou_refuse "$empreinte" || { rm -rf "$TRAVAIL/lot"; exit 1; }
    [ -n "$empreinte" ] || empreinte="$(saisit_empreinte)" \
        || { rm -rf "$TRAVAIL/lot"; fail "mot de passe non saisi (console absente ou 3 essais ratés) — rien n'a été écrit"; }
    profil="$TRAVAIL/lot/profil.toml"
    HERE_NF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    helper="$HERE_NF/sbx-netflash-profil"; [ -x "$helper" ] || helper=/usr/local/sbin/sbx-netflash-profil
    python3 "$helper" --nom "$nom" --domaine "$(champ_lot "$lot" domaine)" --empreinte "$empreinte" > "$profil" \
        || { rm -rf "$TRAVAIL/lot"; fail "profil non généré — rien n'a été écrit"; }
    unset empreinte
fi

format="$(format_image "$image")" || fail "format non pris en charge : $image (.img.gz ou .img.xz)"
dev_emmc="${SBX_EMMC:-$(emmc_detectee || true)}"
brut="$(echo "$ligne" | awk '{print $4}')"
if [ -n "$brut" ] && [ -n "$dev_emmc" ] && [ -b "$dev_emmc" ]; then
    cap="$(blockdev --getsize64 "$dev_emmc" 2>/dev/null || echo 0)"
    if [ "$cap" -gt 0 ] && [ "$brut" -gt "$cap" ]; then
        fail "image de $((brut/1048576)) Mo décompressée, eMMC $dev_emmc de $((cap/1048576)) Mo : elle ne tient pas — rien n'a été écrit"
    fi
fi

# L'image transite par la RAM (tmpfs) : il faut sa taille + 768 Mo pour le reste du système.
# Le live garde toute la pile SecuBox (6,9 Go sur 8 sur DUT) : on ne la stoppe que si la mémoire manque.
# Si elle manque encore (ESPRESSObin, 1 Go, #3233), l'image s'écrit en flux.
libere_memoire() {
    log "mémoire insuffisante : arrêt de la pile SecuBox du live (le live redevient complet au prochain démarrage)…"
    systemctl stop 'secubox-*' 'tor@*' tor haproxy nginx 2>/dev/null || true
    for p in nDPId tor haproxy secubox-groupd uvicorn python3; do pkill -x "$p" 2>/dev/null || true; done
    sleep 3
}
dispo="$(awk '/^MemAvailable:/{print $2*1024}' /proc/meminfo)"
besoin=$(( taille + 768 * 1048576 ))
if [ "$dispo" -le "$besoin" ]; then
    libere_memoire
    dispo="$(awk '/^MemAvailable:/{print $2*1024}' /proc/meminfo)"
fi

if [ "$(mode_ecriture "$taille" "$dispo")" = flux ]; then
    log "$((dispo/1048576)) Mo libres pour une image de $((taille/1048576)) Mo : écriture EN FLUX, signature et empreinte vérifiées pendant l'écriture"
    telecharge "$BASE/$image.sig" "$TRAVAIL/$image.sig" || fail "téléchargement de la signature KO"
    if [ "$auto" -eq 0 ]; then confirme_flash "$image" || fail "flash annulé — rien n'a été écrit"; fi
    opts=(--stdin "$format" --sig "$TRAVAIL/$image.sig" --pub "$PUB" --sha256 "$sha" --auto)
    if [ -n "$nom" ]; then opts+=(--no-reboot); else opts+=("${reboot_opt[@]}"); fi
    log "téléchargement et écriture en flux de $BASE/$image…"
    set +e
    telecharge_flux "$BASE/$image" | secubox-flash-emmc "${opts[@]}"
    st=("${PIPESTATUS[@]}")
    set -e
    [ "${st[1]}" -eq 0 ] || fail "écriture en flux refusée ou interrompue (téléchargement=${st[0]}, flash=${st[1]}) : eMMC invalidée si elle avait été entamée"
    rm -f "$TRAVAIL/$image.sig"
    [ -n "$nom" ] || exit 0
    depose_lot_et_termine
fi

# /run est un tmpfs plafonné à 10 % de la RAM (792 Mo sur 8 Go) : l'image a son propre tmpfs, à sa taille.
mkdir -p "$TRAVAIL/image"
mountpoint -q "$TRAVAIL/image" && umount "$TRAVAIL/image"
mount -t tmpfs -o "size=$(( taille + 64 * 1048576 )),mode=0700" sbx-netflash "$TRAVAIL/image" \
    || fail "espace de travail en mémoire impossible à monter"
dest="$TRAVAIL/image/$image"
log "téléchargement $BASE/$image ($((taille/1048576)) Mo)…"
telecharge "$BASE/$image" "$dest" || { rm -f "$dest"; fail "téléchargement de l'image KO"; }
telecharge "$BASE/$image.sig" "$dest.sig" || { rm -f "$dest" "$dest.sig"; fail "téléchargement de la signature KO"; }

log "vérification de la signature (clé embarquée)…"
if ! openssl dgst -sha256 -verify "$PUB" -signature "$dest.sig" "$dest" >/dev/null 2>&1; then
    rm -f "$dest" "$dest.sig"
    fail "SIGNATURE INVALIDE — rien n'a été écrit, fichier supprimé"
fi
log "signature VALIDE."
# secubox-flash-emmc relit une empreinte locale : celle de la liste, vérifiée contre le fichier reçu.
echo "$sha  $dest" > "${dest}.sha256"
echo "$sha  $dest" | sha256sum -c --status || { rm -f "$dest" "$dest.sig" "${dest}.sha256"; fail "empreinte différente de la liste du serveur"; }

if [ -n "$nom" ]; then      # le dépôt suit l'écriture : pas de redémarrage avant lui
    opts=(--image "$dest" --no-reboot)
else
    opts=(--image "$dest" "${reboot_opt[@]}")
fi
[ "$auto" -eq 1 ] && opts+=(--auto)
log "écriture par secubox-flash-emmc ${opts[*]}"
if [ -z "$nom" ]; then
    exec secubox-flash-emmc "${opts[@]}"
fi
secubox-flash-emmc "${opts[@]}" || fail "écriture de l'eMMC KO — rien n'a été déposé"
depose_lot_et_termine
}

# Après l'écriture (RAM ou flux) avec --nom : code de jonction, ancre et profil sur l'eMMC DÉTECTÉE (mmcblk1 quand une
# carte SD occupe mmcblk0), puis redémarrage si demandé.
depose_lot_et_termine() {
    [ -n "$dev_emmc" ] || fail "eMMC introuvable (aucun mmcblk avec boot0) : image écrite, lot NON déposé"
    depose_sur_emmc "${dev_emmc}p2" "${dev_emmc}p1" "$lot" "$profil" || fail "dépôt du lot KO (image écrite, ni code ni profil déposés)"
    rm -rf "$TRAVAIL/lot"
    log "code de jonction, ancre et profil déposés pour $nom."
    if [ "$reboot_demande" -eq 1 ]; then log "redémarrage…"; sleep 2; systemctl reboot || reboot; fi
    exit 0
}

# Chargeable sans exécuter (tests) : SBX_NETFLASH_SOURCE=1.
if [ -z "${SBX_NETFLASH_SOURCE:-}" ]; then main "$@"; fi
