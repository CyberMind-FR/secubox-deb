"""secubox-netboot-lot NOM : lot de flash signé pour la box NOM (root, sur le maître).

Sortie : {"lot": <JSON texte>, "signature": <base64>}. Émet un code de jonction à usage unique
(sbx-mesh-invite --flash) : à n'appeler que pour un flash réel. Le code n'est jamais journalisé."""
import json
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/secubox/netboot")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
sys.path.insert(0, "/usr/lib/secubox")
from api import lot  # noqa: E402


def main(argv):
    if len(argv) != 2 or not lot.nom_valide(argv[1]):
        print("usage : secubox-netboot-lot NOM (^[a-z][a-z0-9-]{0,30}$)", file=sys.stderr)
        return 2
    try:
        print(json.dumps(lot.construire(argv[1]), ensure_ascii=False))
    except (ValueError, RuntimeError, OSError) as e:
        print(f"secubox-netboot-lot : {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
