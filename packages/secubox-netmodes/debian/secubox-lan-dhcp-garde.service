# Garde du DHCP du LAN (#3419) : avant chaque démarrage de secubox-lan-dhcp (Requires= de celle-ci), sonde chaque
# interface servie ; un autre serveur DHCP sur le segment (ou une sonde impossible) refuse le démarrage et l'audite.
# Choix explicite de l'administrateur : /etc/secubox/netmodes/dhcp.toml, [sonde] forcer = true (audité).
# Oneshot root sans AppArmor ni sudo : exception écrite dans .claude/RULES-CODE.md, figée par
# tests/test_dhcp_sonde_3419.py::test_unites_garde_et_surveillance_durcies.
[Unit]
Description=SecuBox — garde du DHCP du LAN (aucun autre serveur DHCP sur le segment)
After=systemd-networkd.service
# Sans Before= : lancée par ExecStartPre de secubox-lan-dhcp pendant son démarrage (un ordre inverse se bloquerait).
ConditionPathExists=/var/lib/secubox-netmodes/lan-dhcp.conf

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-dhcp-sonde garde
# 2 DHCPDISCOVER et 4 s d'attente par interface servie (br-lan et ports isolés).
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/secubox
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027
# AF_INET : DHCPDISCOVER / OFFER ; AF_NETLINK : `ip -j addr` ; AF_UNIX : systemctl, journal.
RestrictAddressFamilies=AF_INET AF_NETLINK AF_UNIX
# NET_RAW : SO_BINDTODEVICE ; NET_BIND_SERVICE : port 68 ; DAC_OVERRIDE : audit.log appartient à secubox (0640).
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=
