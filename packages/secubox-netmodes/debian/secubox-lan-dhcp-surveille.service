# Surveillance du DHCP du LAN (#3419), lancée par secubox-lan-dhcp-surveille.timer tant que le DHCP tourne : un
# serveur DHCP tiers apparu sur le segment arrête secubox-lan-dhcp et l'audite (sauf choix forcé de l'administrateur).
[Unit]
Description=SecuBox — surveillance des serveurs DHCP tiers sur le LAN
After=secubox-lan-dhcp.service
ConditionPathExists=/var/lib/secubox-netmodes/lan-dhcp.conf

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-dhcp-sonde surveiller
TimeoutStartSec=90
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/secubox
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027
# AF_INET : DHCPDISCOVER / OFFER ; AF_NETLINK : `ip -j addr` ; AF_UNIX : systemctl, journal.
RestrictAddressFamilies=AF_INET AF_NETLINK AF_UNIX
# NET_RAW : SO_BINDTODEVICE ; NET_BIND_SERVICE : port 68 ; DAC_OVERRIDE : audit.log appartient à secubox (0640).
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=
