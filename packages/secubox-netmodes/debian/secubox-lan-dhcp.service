# DHCP du LAN du mode routeur (#3189) : dnsmasq en DHCP seul (port=0, le DNS reste à Unbound), sur br-lan.
# Ni activé ni démarré par le paquet : netmodesctl l'active et le relance à la bascule, le désactive au retour.
# Démarre en root le temps de lire sa configuration, rendue dans l'arbre root seul (/var/lib/secubox-netmodes, 0700),
# puis dnsmasq descend lui-même vers l'utilisateur dnsmasq (user=dnsmasq dans la configuration).
[Unit]
Description=SecuBox — DHCP du LAN (dnsmasq, mode routeur)
After=systemd-networkd.service secubox-lan-dhcp-garde.service
# #3419 : jamais de DHCP sans configuration rendue par netmodesctl (mode routeur appliqué) : une condition non remplie
# n'est pas un échec, donc aucune boucle (VM à une interface, image qui l'aurait activé).
ConditionPathExists=/var/lib/secubox-netmodes/lan-dhcp.conf
# #3419 : jamais de DHCP s'il existe déjà un serveur DHCP sur le segment. La garde sonde (DHCPDISCOVER, aucun bail) ;
# un serveur tiers fait échouer la garde, donc ce démarrage (« dependency failed », sans relance automatique).
Requires=secubox-lan-dhcp-garde.service
# Surveillance périodique tant que le DHCP tourne : un serveur tiers apparu l'arrête (minuteur PartOf de cette unité).
Wants=secubox-lan-dhcp-surveille.timer
# #3419 : relances bornées (3 en 2 min), jamais une boucle sans fin.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
# exec : `systemctl restart` échoue si l'exec échoue ; netmodesctl vérifie ensuite que dnsmasq reste actif (refus
# AppArmor, port 67 pris : sans cela il bouclerait en silence et l'application serait déclarée réussie).
Type=exec
# --conf-dir : un fragment par port isolé (#3201) ; le dossier doit exister (postinst) sinon dnsmasq s'arrête.
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/lib/secubox-netmodes/lan-dhcp.conf --conf-dir=/var/lib/secubox-netmodes/dhcp.d,*.conf --pid-file=
# bind-dynamic (#3201) : un port isolé sans adresse ne l'arrête plus ; autre sortie en erreur (AppArmor, port 67) : on retente.
Restart=on-failure
RestartSec=10
AppArmorProfile=secubox-lan-dhcp
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
# Fichier des baux (dnsmasq.leases), lu aussi par le NAC.
ReadWritePaths=/var/lib/misc
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# 0022 et non 0027 : un fichier de baux créé par dnsmasq doit rester lisible par le NAC (jamais d'écriture groupe/autres).
UMask=0022

[Install]
WantedBy=multi-user.target
