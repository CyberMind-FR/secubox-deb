# SecuBox Network Modes (#3189) — l'API (utilisateur secubox-netmodes) pilote le mode routeur par netmodesctl, SEULE
# surface privilégiée du module (root : networkd, nft, Unbound, dnsmasq, nginx, audit). Verbes exacts :
#   routeur-etat                      GET  /routeur/etat       (sans argument : la règle n'en admet aucun)
#   routeur-appliquer <acteur>        POST /routeur/appliquer  (configuration JSON sur l'entrée standard, revalidée)
#   routeur-confirmer <acteur>        POST /routeur/confirmer
#   routeur-retour <acteur>           POST /routeur/retour
#   port-couper <port> <acteur>       POST /ports/<port>/couper    (#3190)
#   port-retablir <port> <acteur>     POST /ports/<port>/retablir  (#3190)
# L'acteur est le `sub` du jeton vérifié ; netmodesctl le revalide (^[A-Za-z0-9._@-]{1,64}$) et refuse tout autre nombre
# d'arguments ; le port, d'abord, par liste blanche (lan0 lan1 lan2 lan3 : jamais eth*, jamais br-lan).
# routeur-retour-demarrage n'est PAS accordé : unité root du démarrage seulement.
secubox-netmodes ALL=(root) NOPASSWD: /usr/sbin/netmodesctl routeur-etat, /usr/sbin/netmodesctl routeur-appliquer *, /usr/sbin/netmodesctl routeur-confirmer *, /usr/sbin/netmodesctl routeur-retour *, /usr/sbin/netmodesctl port-couper *, /usr/sbin/netmodesctl port-retablir *
