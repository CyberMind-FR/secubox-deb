#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if [ -f /etc/sudoers.d/secubox-nextcloud ]; then
        visudo -cf /etc/sudoers.d/secubox-nextcloud >/dev/null || {
            echo "secubox-nextcloud: invalid sudoers, removing" >&2
            rm -f /etc/sudoers.d/secubox-nextcloud
        }
    fi

    # ROUTE SBXWAF — POSEE PAR CE PAQUET (#1323), comme son vhost et son unite.
    # Sans elle, sbxwaf recoit un nom qu'il ne connait pas et rend 421, meme si
    # HAProxy dirige bien et que nginx sert bien. Cette table n'appartenait a
    # aucun paquet : 275 routes posees a la main, invisibles tant qu'elles
    # tiennent, fatales le jour ou l'une saute (vu sur podcaster).
    # L'outil vient de secubox-core, dont ce paquet depend deja ; le garde
    # `command -v` couvre l'ordre de configuration a la premiere installation.
    if command -v secubox-waf-route >/dev/null 2>&1; then
      secubox-waf-route nc.gk2.secubox.in 9080 || true
      secubox-waf-route nextcloud.gk2.secubox.in 9080 || true
    fi
    systemctl daemon-reload
    systemctl enable secubox-nextcloud.service || true
    systemctl start secubox-nextcloud.service || true
fi
#DEBHELPER#
exit 0
