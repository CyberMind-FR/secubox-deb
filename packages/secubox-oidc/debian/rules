#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	install -d debian/secubox-oidc/usr/lib/secubox/oidc/api
	install -m 644 api/*.py debian/secubox-oidc/usr/lib/secubox/oidc/api/
	install -D -m 755 sbin/secubox-oidcctl debian/secubox-oidc/usr/sbin/secubox-oidcctl
	install -D -m 644 conf/oidc.toml debian/secubox-oidc/etc/secubox/oidc.toml
