# Profil AppArmor ENFORCE de secubox-oubli-pair (#3362), attaché au chemin de la commande (lancée par sudo depuis
# secubox-p2p). Il LIT les états du maillage (wg_mesh.json, peers.json, ancre, conf des noms Unbound), n'ÉCRIT que l'audit,
# et n'exécute que : wg (dans ce profil : le code n'appelle que `show wg-mesh …` et `set wg-mesh peer <clé> remove`,
# AppArmor ne borne pas les arguments), et trois commandes du dépôt qui tournent sous LEUR profil s'il existe (Px), sinon
# hors profil (Pux) : secubox-relais-maillage (HAProxy, nft, sbxwaf), secubox-annuaire-noms (Unbound), autoloadctl.
# Aucun shell, aucun secret.

#include <tunables/global>

profile secubox-oubli-pair /usr/sbin/secubox-oubli-pair flags=(enforce) {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>      # pwd.getpwnam("secubox")

  /usr/sbin/secubox-oubli-pair r,
  /usr/bin/python3* rix,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,

  deny /etc/secubox/secrets/** r,
  /var/lib/secubox/p2p/ r,
  /var/lib/secubox/p2p/wg_mesh.json r,
  /var/lib/secubox/p2p/peers.json r,
  /etc/secubox/p2p/ancre-maitre.json r,
  /etc/unbound/unbound.conf.d/60-secubox-noms.conf r,
  /var/log/secubox/audit.log w,

  /usr/bin/wg ix,
  /usr/sbin/secubox-relais-maillage Pux,
  /usr/sbin/secubox-annuaire-noms Pux,
  /usr/sbin/autoloadctl Pux,

  capability dac_override,                  # audit.log et états appartiennent à secubox
  capability net_admin,                     # wg set … remove
  network netlink raw,                      # wg (genetlink)
  network unix stream,
}
