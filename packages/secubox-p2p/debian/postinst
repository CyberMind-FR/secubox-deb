#!/bin/sh
set -e

case "$1" in
    configure)
        # PORT DU MESH (#1499). Les box installees avant que firstboot ouvre
        # 51822 ne peuvent que JOINDRE le mesh : une poignee de main initiee
        # d'ailleurs tombe sur le `drop` de inet secubox_filter. Une table a
        # part ne suffirait pas — un accept d'une table n'annule pas le drop
        # d'une autre sur le meme crochet. On ne touche qu'a CE jeu de regles
        # (genere par firstboot) : ailleurs (gk2) il n'existe pas, et rien
        # ne change.
        if [ -f /etc/nftables.conf ] \
           && grep -q "table inet secubox_filter" /etc/nftables.conf \
           && ! grep -q "dport 51822" /etc/nftables.conf \
           && grep -q "udp dport 51820 accept" /etc/nftables.conf; then
            sed -i '0,/^\([[:space:]]*\)udp dport 51820 accept$/s//&\n\1udp dport 51822 accept  # MirrorNet (secubox-p2p, #1499)/' /etc/nftables.conf
        fi
        if nft list chain inet secubox_filter input >/dev/null 2>&1 \
           && ! nft list chain inet secubox_filter input 2>/dev/null | grep -q "dport 51822"; then
            nft insert rule inet secubox_filter input udp dport 51822 accept 2>/dev/null || true
        fi
        # Create secubox user if it doesn't exist
        if ! getent passwd secubox > /dev/null 2>&1; then
            adduser --system --group --home /var/lib/secubox --no-create-home secubox
        fi

        # Create runtime directory (fallback). #494: never chown/chmod the
        # shared parent /run/secubox — tmpfiles.d owns it (1777 root root);
        # overriding it breaks cross-user socket traversal.
        mkdir -p /run/secubox

        # Log dir: own a subdir, do NOT chown the shared /var/log/secubox
        # parent (#494/#511 — that strips other modules' log access).
        mkdir -p /var/log/secubox
        install -d -o secubox -g secubox -m 0750 /var/log/secubox/p2p

        # Enable and start the service
        systemctl daemon-reload
        systemctl enable secubox-p2p.service
        systemctl start secubox-p2p.service || true

        # ── MIRRORNET : L'ÉTAT DEVIENT UN TUNNEL (#1360) ───────────────────
        # L'API écrit wg_mesh.json ; ces unités root l'appliquent et publient
        # les poignées de main. Sans elles, un enrôlement « réussi » ne monte
        # aucun tunnel, et le statut des pairs reste une supposition.
        systemctl enable secubox-p2p-mesh.path secubox-p2p-mesh.service \
                         secubox-p2p-mesh-liveness.timer >/dev/null 2>&1 || true
        systemctl start secubox-p2p-mesh.path secubox-p2p-mesh-liveness.timer || true
        systemctl start secubox-p2p-mesh-liveness.service || true
        # Appliquer l'état DÉJÀ présent : l'unité .path ne réagit qu'aux
        # changements, et un pair inscrit avant la mise à jour attendrait le
        # prochain enrôlement pour avoir son tunnel.
        systemctl start secubox-p2p-mesh.service || true

        # Écouteur d'enrôlement 7331 : activé seulement si nginx l'accepte. Un
        # site qui casse `nginx -t` casserait TOUS les vhosts, pas seulement
        # l'enrôlement. On retire l'essai posé à la main pendant le test du
        # 2026-09-24, que ce fichier remplace.
        rm -f /etc/nginx/sites-enabled/p2p-masterlink.conf /etc/nginx/sites-available/p2p-masterlink.conf
        if [ -f /etc/nginx/sites-available/secubox-p2p-masterlink.conf ] && \
           [ ! -e /etc/nginx/sites-enabled/secubox-p2p-masterlink.conf ]; then
            ln -s ../sites-available/secubox-p2p-masterlink.conf \
                  /etc/nginx/sites-enabled/secubox-p2p-masterlink.conf
            if ! nginx -t >/dev/null 2>&1; then
                rm -f /etc/nginx/sites-enabled/secubox-p2p-masterlink.conf
                echo "secubox-p2p: nginx -t refuse l'ecouteur 7331 — enrolement non expose" >&2
            fi
        fi

        # Reload nginx if running
        if systemctl is-active --quiet nginx; then
            systemctl reload nginx || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
