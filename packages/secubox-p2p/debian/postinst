#!/bin/sh
set -e

case "$1" in
    configure)
        # PORT DU MESH (#1499). Les box installees avant que firstboot ouvre
        # 51822 ne peuvent que JOINDRE le mesh : une poignee de main initiee
        # d'ailleurs tombe sur le `drop` de inet secubox_filter. Une table a
        # part ne suffirait pas — un accept d'une table n'annule pas le drop
        # d'une autre sur le meme crochet. On ne touche qu'a CE jeu de regles
        # (genere par firstboot) : ailleurs (gk2) il n'existe pas, et rien
        # ne change.
        if [ -f /etc/nftables.conf ] \
           && grep -q "table inet secubox_filter" /etc/nftables.conf \
           && ! grep -q "dport 51822" /etc/nftables.conf \
           && grep -q "udp dport 51820 accept" /etc/nftables.conf; then
            sed -i '0,/^\([[:space:]]*\)udp dport 51820 accept$/s//&\n\1udp dport 51822 accept  # MirrorNet (secubox-p2p, #1499)/' /etc/nftables.conf
        fi
        if nft list chain inet secubox_filter input >/dev/null 2>&1 \
           && ! nft list chain inet secubox_filter input 2>/dev/null | grep -q "dport 51822"; then
            nft insert rule inet secubox_filter input udp dport 51822 accept 2>/dev/null || true
        fi
        # Create secubox user if it doesn't exist
        if ! getent passwd secubox > /dev/null 2>&1; then
            adduser --system --group --home /var/lib/secubox --no-create-home secubox
        fi

        # Create runtime directory (fallback). #494: never chown/chmod the
        # shared parent /run/secubox — tmpfiles.d owns it (1777 root root);
        # overriding it breaks cross-user socket traversal.
        mkdir -p /run/secubox

        # Log dir: own a subdir, do NOT chown the shared /var/log/secubox
        # parent (#494/#511 — that strips other modules' log access).
        mkdir -p /var/log/secubox
        install -d -o secubox -g secubox -m 0750 /var/log/secubox/p2p

        # ── RESTAURÉ PAR #1768 : effacé par la fusion 6036886281 (2026-08-17) ──
        #
        # State dir: own p2p/ and the master-link store, but NEVER chown the
        # shared /var/lib/secubox parent (#494/#511). The app's master-link
        # init mkdir's master-link/ and fails EACCES when p2p/ is root-owned,
        # 500-ing /api/v1/p2p/status and breaking mesh enrollment. chown too so
        # pre-existing root-owned installs are repaired on upgrade (gk3 : p2p/
        # root, master-link/ absent, constaté le 2026-09-30).
        mkdir -p /var/lib/secubox
        install -d -o secubox -g secubox -m 0755 /var/lib/secubox/p2p
        install -d -o secubox -g secubox -m 0755 /var/lib/secubox/p2p/master-link
        chown secubox:secubox /var/lib/secubox/p2p /var/lib/secubox/p2p/master-link 2>/dev/null || true

        # Règle wg-mesh durable : PERSISTÉE dans nftables.conf (validée par
        # nft -c) et appliquée À CHAUD par `nft insert`. Jamais de `nft -f`
        # complet : il rejoue `flush ruleset` et efface bans et tables posées
        # à chaud (#1721). Sans effet là où inet secubox_filter n'existe pas.
        _regle_maillage() {  # port proto
            _conf=/etc/nftables.conf
            _r="iifname \"wg-mesh\" ip saddr 10.10.0.0/24 $2 dport $1 accept"
            if [ -f "$_conf" ] && grep -q 'table inet secubox_filter' "$_conf" \
               && ! grep -q "$2 dport $1" "$_conf"; then
                awk -v r="        $_r" '/^[[:space:]]*drop[[:space:]]*$/ && !d {print r; d=1} {print}' \
                    "$_conf" > "$_conf.sbxtmp" 2>/dev/null || true
                if [ -s "$_conf.sbxtmp" ] && nft -c -f "$_conf.sbxtmp" >/dev/null 2>&1; then
                    mv "$_conf.sbxtmp" "$_conf"
                else
                    rm -f "$_conf.sbxtmp" 2>/dev/null || true
                fi
            fi
            if nft list chain inet secubox_filter input >/dev/null 2>&1 \
               && ! nft list chain inet secubox_filter input 2>/dev/null | grep -q "$2 dport $1 "; then
                nft insert rule inet secubox_filter input $_r 2>/dev/null || true
            fi
        }

        # Render the Gondwana mesh macro grant listener IFF a wg-mesh exists.
        # Mirrors the annuaire-mesh.conf.tpl pattern (#766).
        # Bind only the node's wg-mesh IPv4 — never 0.0.0.0 (minimal surface).
        # X-Real-IP=$remote_addr is set in the template so macroctl sees the
        # provider-observed mesh source IP, not a client-supplied value.
        MACRO_TPL=/usr/share/secubox/p2p/p2p-macro-mesh.conf.tpl
        MACRO_CONF=/etc/nginx/conf.d/p2p-macro-mesh.conf
        MESH_IP=$(ip -4 -o addr show wg-mesh 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
        if [ -n "$MESH_IP" ] && [ -f "$MACRO_TPL" ]; then
            sed "s/__MESH_IP__/$MESH_IP/g" "$MACRO_TPL" > "$MACRO_CONF"
            # A broken render must NEVER persist on disk — validate now; revert on failure.
            if ! nginx -t >/dev/null 2>&1; then
                rm -f "$MACRO_CONF" 2>/dev/null || true
            fi
            _regle_maillage 8798 tcp          # écouteur de subvention macro
        else
            # No mesh interface (or template missing) → ensure no stale listener.
            rm -f "$MACRO_CONF" 2>/dev/null || true
        fi

        # Enable and start the service
        systemctl daemon-reload
        systemctl enable secubox-p2p.service
        systemctl start secubox-p2p.service || true

        # ── MIRRORNET : L'ÉTAT DEVIENT UN TUNNEL (#1360) ───────────────────
        # L'API écrit wg_mesh.json ; ces unités root l'appliquent et publient
        # les poignées de main. Sans elles, un enrôlement « réussi » ne monte
        # aucun tunnel, et le statut des pairs reste une supposition.
        systemctl enable secubox-p2p-mesh.path secubox-p2p-mesh.service \
                         secubox-p2p-mesh-liveness.timer >/dev/null 2>&1 || true
        systemctl start secubox-p2p-mesh.path secubox-p2p-mesh-liveness.timer || true
        systemctl start secubox-p2p-mesh-liveness.service || true
        # Exposition par défaut des nœuds relayés (#1682) : sur un satellite,
        # ouvre le port au maître ; sur le relais, relaie les noms des pairs.
        systemctl enable secubox-relais-maillage.timer >/dev/null 2>&1 || true
        systemctl start secubox-relais-maillage.timer >/dev/null 2>&1 || true
        # Appliquer l'état DÉJÀ présent : l'unité .path ne réagit qu'aux
        # changements, et un pair inscrit avant la mise à jour attendrait le
        # prochain enrôlement pour avoir son tunnel.
        systemctl start secubox-p2p-mesh.service || true

        # Écouteur d'enrôlement 7331 : activé seulement si nginx l'accepte. Un
        # site qui casse `nginx -t` casserait TOUS les vhosts, pas seulement
        # l'enrôlement. On retire l'essai posé à la main pendant le test du
        # 2026-09-24, que ce fichier remplace.
        rm -f /etc/nginx/sites-enabled/p2p-masterlink.conf /etc/nginx/sites-available/p2p-masterlink.conf
        if [ -f /etc/nginx/sites-available/secubox-p2p-masterlink.conf ] && \
           [ ! -e /etc/nginx/sites-enabled/secubox-p2p-masterlink.conf ]; then
            ln -s ../sites-available/secubox-p2p-masterlink.conf \
                  /etc/nginx/sites-enabled/secubox-p2p-masterlink.conf
            if ! nginx -t >/dev/null 2>&1; then
                rm -f /etc/nginx/sites-enabled/secubox-p2p-masterlink.conf
                echo "secubox-p2p: nginx -t refuse l'ecouteur 7331 — enrolement non expose" >&2
            fi
        fi

        # --- ephemeral wg-ephemeral iface prerequisites (restauré, #1768) --- #
        # Generate the wg-ephemeral private key once if absent. Guarded:
        # `wg` may be unavailable in a build/CI container, and this must
        # never fail the package install.
        install -d -m 700 /etc/secubox/secrets/p2p
        if [ ! -f /etc/secubox/secrets/p2p/wg-ephemeral.key ]; then
            (umask 077; wg genkey > /etc/secubox/secrets/p2p/wg-ephemeral.key) 2>/dev/null || true
        fi
        chmod 600 /etc/secubox/secrets/p2p/wg-ephemeral.key 2>/dev/null || true
        # Bring the wg-ephemeral iface up idempotently.
        /usr/sbin/secubox-p2pctl iface-up 2>/dev/null || true
        # TTL-backstop sweep timer (removes expired ephemeral peers even if
        # the assist-side teardown never runs).
        systemctl enable --now secubox-p2p-ephemeral-sweep.timer 2>/dev/null || true
        # udp/51825 : là où inet secubox_filter existe, sa politique `drop`
        # l'emporte sur l'accept d'une autre table — la règle doit y figurer
        # (même raison que 51822 ci-dessus). Ailleurs, la table dédiée livrée
        # en conffile, chargée seulement si absente (pas de doublon).
        if nft list chain inet secubox_filter input >/dev/null 2>&1; then
            _conf=/etc/nftables.conf
            if [ -f "$_conf" ] && ! grep -q "udp dport 51825" "$_conf" \
               && grep -q "udp dport 51820 accept" "$_conf"; then
                sed -i '0,/^\([[:space:]]*\)udp dport 51820 accept$/s//&\n\1udp dport 51825 accept  # pairs éphémères (secubox-p2p, #1768)/' "$_conf"
            fi
            nft list chain inet secubox_filter input 2>/dev/null | grep -q "udp dport 51825 " \
                || nft insert rule inet secubox_filter input udp dport 51825 accept 2>/dev/null || true
        elif [ -f /etc/nftables.d/secubox-p2p-ephemeral.nft ] \
             && ! nft list table inet secubox_p2p_ephemeral >/dev/null 2>&1; then
            nft -f /etc/nftables.d/secubox-p2p-ephemeral.nft 2>/dev/null || true
        fi

        # Reload nginx if running — seulement sur une configuration valide.
        if systemctl is-active --quiet nginx; then
            nginx -t >/dev/null 2>&1 && systemctl reload nginx || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
