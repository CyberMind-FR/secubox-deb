set -e
case "$1" in
    remove|purge)
        # Remove the rendered mesh macro grant listener (postinst generated it
        # from a template, so dpkg does not track it as a conffile).
        rm -f /etc/nginx/conf.d/p2p-macro-mesh.conf 2>/dev/null || true
        if systemctl is-active --quiet nginx 2>/dev/null; then
            nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
        fi
        ;;
esac
# #3133 : à la purge, la carte nginx du jeton des pairs et le jeton (le dossier des secrets seulement s'il est vide).
# Jamais l'état du maillage (wg_mesh.json, ancre, poignées). Jamais d'échec.
if [ "$1" = "purge" ]; then
    _ngx="${SBX_P2P_PAIR_CONF:-/etc/nginx/secubox-p2p-pair.conf}"
    _sec="${SBX_P2P_SECRETS_DIR:-/etc/secubox/secrets/p2p}"
    rm -f "$_ngx" "$_sec/pair.token" 2>/dev/null || true
    rmdir "$_sec" 2>/dev/null || true
fi
# #3154 : à la purge, le relais des ports médias du maître : le fichier régénéré par secubox-relais-maillage
# (inclus au démarrage par nftables.conf) et la table appliquée à chaud. Jamais l'état (relais-ports.json),
# jamais d'échec (table absente).
if [ "$1" = "purge" ]; then
    rm -f "${SECUBOX_RELAIS_PORTS_NFT:-/etc/nftables.d/secubox-relais-ports.nft}" 2>/dev/null || true
    nft delete table inet secubox-relais-ports 2>/dev/null || true
fi
#DEBHELPER#
exit 0
