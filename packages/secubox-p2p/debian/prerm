#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Liens directs (#3133) : la minuterie d'abord, pour qu'aucune synchronisation ne démarre pendant l'opération.
        systemctl stop secubox-maillage-pairs.timer secubox-maillage-pairs.service || true
        if [ "$1" = "remove" ]; then
            systemctl disable secubox-maillage-pairs.timer || true
        fi
        # Stop the service
        systemctl stop secubox-p2p.service || true
        systemctl disable secubox-p2p.service || true
        ;;
esac

#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/p2p/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "p2p : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
