[Unit]
Description=SecuBox P2P Network Hub API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
# RuntimeDirectory=secubox RETIRE (#1022) : /run/secubox est partage par ~95
# unites, et systemd EFFACE le contenu d'un RuntimeDirectory au redemarrage —
# une seule unite qui le declare emporte les sockets de toutes les autres, et
# la board rend des 502 sur des modules qui n'avaient rien demande. Le parent
# reste root:root 1777, cree hors des unites.
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/p2p.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/p2p.sock --workers 1
WorkingDirectory=/usr/lib/secubox/p2p
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
# NoNewPrivileges=no: the macro grant endpoint invokes `sudo -n secubox-macroctl`
# (root, AppArmor-confined, sudoers-restricted to that one binary). NNP=yes would
# block sudo. Matches the secubox-appstore/aggregator precedent for services that
# shell out to a tightly-scoped root helper.
NoNewPrivileges=no

ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/secubox /var/log/secubox /var/lib/secubox

[Install]
WantedBy=multi-user.target
