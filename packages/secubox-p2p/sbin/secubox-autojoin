"""secubox-autojoin (#3638) : une box DERRIÈRE un maître SecuBox rejoint son maillage, sans jeton à recopier.

COMMANDE À TAPER sur la box (root), jamais lancée seule : une passerelle hostile ne peut donc pas attirer la box dans
son maillage à son insu. Sur le maître, ouvrir d'abord l'appairage (page Flotte, 15 min). Rien si la box est déjà
maillée ou maître de ses propres pairs. La passerelle par défaut (adresse privée) délivre un jeton à usage unique,
déposé comme code de jonction (automesh.code, 0600) ; secubox-automesh fait la jonction éprouvée. Le pair entre
« à valider » : rien de lui n'est exposé avant « Valider » dans la Flotte. Le jeton n'est jamais affiché ni journalisé."""
import ipaddress
import json
import os
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

sys.path.insert(0, "/usr/lib/secubox/p2p")
from api import automesh  # noqa: E402

ENV = os.environ.get
P2P_DIR = ENV("SBX_P2P_DIR", "/var/lib/secubox/p2p")
PORT = 7331


def deja_maillee() -> bool:
    """Déjà rattachée à un parent, OU maître de ses propres pairs : jamais d'autojoin (un maître derrière un autre ne
    s'y rattache pas tout seul)."""
    for nom, cle in (("mesh.json", "upstream"), ("wg_mesh.json", "peers")):
        try:
            with open(os.path.join(P2P_DIR, nom), encoding="utf-8") as f:
                if json.load(f).get(cle):
                    return True
        except FileNotFoundError:
            continue
        except (OSError, ValueError, AttributeError):
            return True               # état illisible : dans le doute, ne rien joindre
    return False


def passerelle() -> str | None:
    try:
        routes = json.loads(subprocess.run(["ip", "-j", "-4", "route", "show", "default"], capture_output=True,
                                           text=True, timeout=5).stdout or "[]")
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    for r in routes:
        gw = r.get("gateway") if isinstance(r, dict) else None
        try:
            if gw and ipaddress.ip_address(gw).is_private:
                return gw
        except ValueError:
            continue
    return None


def demander_jeton(gw: str, ouvrir=urllib.request.urlopen) -> tuple:
    """(jeton, None) ou (None, raison lisible)."""
    req = urllib.request.Request(f"http://{gw}:{PORT}/api/v1/p2p/master-link/autojoin", data=b"{}", method="POST",
                                 headers={"Content-Type": "application/json"})
    try:
        with ouvrir(req, timeout=8) as r:
            corps = json.loads(r.read(4096).decode())
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read(2048).decode()).get("detail")
        except (OSError, ValueError, AttributeError):
            detail = None
        propre = "".join(c for c in str(detail or "") if c.isprintable())[:160]      # jamais de séquence d'échappement
        return None, f"refus du maître (HTTP {e.code}){' : ' + propre if propre else ''}"
    except (OSError, ValueError) as e:
        return None, f"passerelle {gw} : pas de maître SecuBox joignable ({e.__class__.__name__})"
    jeton = corps.get("token") if isinstance(corps, dict) else None
    if isinstance(jeton, str) and automesh._JETON.fullmatch(jeton):
        return jeton, None
    return None, "réponse inattendue du maître"


def deposer(gw: str, jeton: str) -> None:
    code = automesh.encoder(gw, jeton)
    chemin = automesh.CODE_DEPOSE
    dossier = os.path.dirname(chemin)
    os.makedirs(dossier, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=dossier, prefix=".automesh-")      # O_EXCL, 0600
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(code)
        os.replace(tmp, chemin)
    except OSError:
        os.unlink(tmp)
        raise


def main() -> int:
    if deja_maillee():
        print("secubox-autojoin : box déjà maillée (ou maître de ses propres pairs) — rien à faire")
        return 0
    if os.path.exists(automesh.CODE_DEPOSE):
        print("secubox-autojoin : une jonction est déjà en cours (code déposé) — voir secubox-automesh")
        return 0
    gw = passerelle()
    if not gw:
        print("secubox-autojoin : pas de passerelle privée — la box n'est pas derrière un maître SecuBox", file=sys.stderr)
        return 1
    jeton, raison = demander_jeton(gw)
    if not jeton:
        print(f"secubox-autojoin : {raison}", file=sys.stderr)
        return 1
    deposer(gw, jeton)
    print(f"secubox-autojoin : maître SecuBox {gw}, jonction en cours…")
    try:
        r = subprocess.run(["/usr/sbin/secubox-automesh"], capture_output=True, text=True, timeout=240, check=False)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"secubox-autojoin : jonction non lancée ({e.__class__.__name__})", file=sys.stderr)
        return 1
    print((r.stdout or r.stderr).strip() or f"secubox-automesh : code {r.returncode}")
    if r.returncode == 0:
        print("secubox-autojoin : dans le maillage, « à valider » dans la Flotte du maître")
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
