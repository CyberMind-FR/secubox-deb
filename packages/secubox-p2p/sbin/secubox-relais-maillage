# SecuBox-Deb :: secubox-relais-maillage — un nœud SANS WAN servi par un nœud
# qui en a un, à travers le maillage wg-mesh (#1670).
#
# Sur le RELAIS (le nœud qui a le WAN, ex. gk2) :
#   relayer <nom> <ip-maillée-du-pair> [port]   (port par défaut : 9080)
#   retirer <nom>
#   relayer-port <proto/port> <ip-du-pair> <module> | retirer-port <proto/port>   (ports média, #3154)
#   relayer --sans-sonde <nom> <ip> [port]      rétablissement (retour arrière du pilotage) sans sonder le pair
#   pair-de <box>                               IP maillée du pair <box> (wg_mesh.json + wg-mesh)
#   etat
# Sur le PAIR (le nœud sans WAN, ex. gk3) :
#   ouvrir <ip-maillée-du-relais> [port]        (port par défaut : 9080)
#   fermer <ip-maillée-du-relais> [port]
# Partout (minuteur horaire, #1682) :
#   synchroniser   satellite : ouvre le port au maître ; relais : expose par
#                  défaut les noms de chaque pair (voir cmd_synchroniser)
#
# CHAÎNE D'UN NOM, SUR LE RELAIS. Le TLS se termine ici et le WAF d'ici inspecte
# (jamais de bypass) ; sbxwaf relaie en HTTP vers le pair, et c'est WireGuard qui
# chiffre sur le fil. Dans l'ordre, chaque étape vérifiée avant la suivante :
#   1. le pair est un pair du maillage (allowed-ips /32 sur wg-mesh) et répond ;
#   2. le DNS PUBLIC du nom pointe vers ce relais — on ne crée rien chez le
#      registraire ici : on refuse et on dit quoi faire ;
#   3. un certificat (certbot webroot, renouvelé par le crochet existant) ;
#   4. le vhost HAProxy, derrière sbxwaf_inspector ;
#   5. la route sbxwaf vers l'IP MAILLÉE du pair. Pas `secubox-waf-route` : il
#      recopie l'adresse d'une route voisine du même port, qui serait la nôtre.
#
# CÔTÉ PAIR, deux choses et rien de plus : le port n'est ouvert QU'AU relais (pas
# à tout le maillage), et nginx croit l'adresse de visiteur que le relais lui
# transmet — sinon chaque visiteur aurait l'adresse du relais. Le maillage n'est
# PAS un réseau local : le visiteur relayé reste un visiteur WAN.
set -euo pipefail
readonly MODULE="relais-maillage"

# Racine substituée (tests seulement) : honorée HORS root uniquement ; en root, chemins réels et propriétaire attendu uid 0.
R=""; UID_ROOT=0
if [ "$(id -u)" -ne 0 ] && [ -n "${SBX_RELAIS_ESSAI:-}" ]; then
    R="${SBX_RELAIS_ESSAI%/}"; UID_ROOT="$(id -u)"
fi

ROUTES="${SECUBOX_RELAIS_ROUTES:-$R/etc/secubox/waf/haproxy-routes.json}"
HAPROXY_TOML="$R/etc/secubox/haproxy.toml"
CERTS_DIR=$R/data/haproxy/certs
WEBROOT=/usr/share/secubox/www
NFT_CONF=$R/etc/nftables.conf
NGINX_CONF=$R/etc/nginx/conf.d/secubox-relais-maillage.conf
BACKEND=sbxwaf_inspector
RESOLVEUR=1.1.1.1
ACME=/root/.acme.sh
DNS_JOKER="${SECUBOX_DNS_JOKER:-/usr/sbin/secubox-dns-joker}"   # module DNS d'ici (#3206)
PAS_DNS=10          # propagation d'un joker créé : relevé toutes les PAS_DNS s…
ATTENTE_DNS_PAS=12  # … ATTENTE_DNS_PAS fois au plus (2 min), puis la synchronisation suivante reprend
REGLAGES=$R/etc/secubox/relais-maillage.toml
ETAT_PERIMES=$R/var/lib/secubox/p2p/relais-perimes.json   # candidats au retrait du relevé précédent (#3132)
# Noms admin.<box> qu'une box « distante » fait servir par le pilotage du maître (#3126 L5, R-L5-27) : fichier root écrit par
# secubox-pilotage-vhost ; jamais relayés ici tant qu'ils y figurent.
EXCLUSIONS_PILOTAGE=$R/var/lib/secubox-pilotage-pages/exclusions-relais.json
AUDIT="${SECUBOX_RELAIS_AUDIT:-$R/var/log/secubox/audit.log}"
WG_ETAT=$R/var/lib/secubox/p2p/wg_mesh.json
PORT_PAIR=9080
# Ports bruts (média d'une visio…) publiés par les pairs, relayés par DNAT vers leur IP maillée (#3154).
RELAIS_PORTS_ETAT="${SECUBOX_RELAIS_PORTS_ETAT:-$R/var/lib/secubox/p2p/relais-ports.json}"
RELAIS_PORTS_NFT="${SECUBOX_RELAIS_PORTS_NFT:-$R/etc/nftables.d/secubox-relais-ports.nft}"
# Ports jamais relayés, quoi que publie un pair : ssh, dns, web, API/WAF/agrégateur de la box, WireGuard (le maître
# écoute 51820 et 51822 : un pair qui les publierait couperait tout le maillage). Même liste dans les Python ci-dessous.
PORTS_RESERVES=" 22 53 80 443 7331 8085 9080 51820 51822 "
PORTS_PUBLICS_LOCAL="${SECUBOX_PORTS_PUBLICS_DIR:-$R/var/lib/secubox/ports-publics.d}"

# VERROU COMMUN avec secubox-pilotage-vhost (#3126, R-L5-30) : flock exclusif sur un fichier root dédié du dossier root des
# exclusions. Tenu par CE script pendant toute une passe relayer/retirer/synchroniser (lecture des exclusions comprise,
# jusqu'à la fin des écritures et du `haproxyctl generate`), et par le ctl du pilotage pendant tout un basculement.
# ORDRE DES VERROUS : verrou commun D'ABORD, verrou de conf.d nginx (ctl du pilotage) ENSUITE ; ce script ne prend que le
# commun. Quand le ctl l'appelle, il lui transmet SA description de fichier (SECUBOX_VERROU_FD, descripteur hérité) : flock
# sur la même description est immédiat, aucun interblocage ; un descripteur qui n'est pas ce fichier ne dispense de rien.
VERROU_COMMUN=$R/var/lib/secubox-pilotage-pages/verrou-relais.lock

log()  { printf '[%s] %s\n' "$MODULE" "$*"; }
meurt() { printf '[%s] ERREUR : %s\n' "$MODULE" "$*" >&2; exit 1; }
# Décision d'exposition → journal d'audit (append-only). Valeurs déjà validées (nom_valide, ip_valide) : JSON sûr.
audit_relais() {   # audit_relais <evenement> <nom> <ip-du-pair>
    printf '{"ts":"%s","module":"p2p","evenement":"%s","nom":"%s","pair":"%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" >> "$AUDIT" 2>/dev/null || true
}
[ "$(id -u)" -eq 0 ] || [ -n "$R" ] || meurt "à lancer en root"

verrou_commun() {
    local fd="${SECUBOX_VERROU_FD:-}" d u m
    if [[ "$fd" =~ ^[0-9]{1,4}$ ]] && [ "$fd" -gt 2 ] && [ ! -L "$VERROU_COMMUN" ] && [ "/proc/self/fd/$fd" -ef "$VERROU_COMMUN" ]; then
        flock -x "$fd" || meurt "verrou commun hérité inutilisable"
        return 0
    fi
    d="$(dirname "$VERROU_COMMUN")"
    [ -e "$d" ] || [ -L "$d" ] || mkdir -m 0755 "$d" || meurt "dossier du verrou commun impossible à créer"
    [ -d "$d" ] && [ ! -L "$d" ] || meurt "dossier du verrou commun non sûr (lien ou absent)"
    u="$(stat -c %u "$d")"; m="$(stat -c %a "$d")"
    [ "$u" = "$UID_ROOT" ] && [ $(( 8#$m & 8#22 )) -eq 0 ] || meurt "dossier du verrou commun non sûr (root, sans écriture groupe/autres)"
    [ ! -L "$VERROU_COMMUN" ] || meurt "verrou commun non sûr (lien)"
    ( umask 077; exec 9<>"$VERROU_COMMUN" ) || meurt "verrou commun impossible à ouvrir"
    exec 9<"$VERROU_COMMUN" || meurt "verrou commun impossible à ouvrir"
    # vérifié APRÈS ouverture, sur le descripteur : le fichier ouvert est bien celui du dossier (aucun lien suivi), ordinaire,
    # root, un seul lien
    [ "$(readlink "/proc/$$/fd/9")" = "$(readlink -f "$d")/$(basename "$VERROU_COMMUN")" ] || meurt "verrou commun non sûr (lien)"
    [ -f "/proc/$$/fd/9" ] && [ "$(stat -L -c '%u %h' "/proc/$$/fd/9")" = "$UID_ROOT 1" ] \
        || meurt "verrou commun non sûr (propriétaire ou liens)"
    flock -x 9 || meurt "verrou commun indisponible"
}

nom_valide()  { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]; }
ip_valide()   { [[ "$1" =~ ^10\.10\.0\.([0-9]{1,3})$ ]] && [ "${BASH_REMATCH[1]}" -ge 1 ] && [ "${BASH_REMATCH[1]}" -le 254 ]; }
port_valide() { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

domaine_box() {
    python3 -c 'from secubox_core.auth import domaine_box; print(domaine_box())' 2>/dev/null || true
}

# L'IP publique de CE relais : celle que le DNS public donne à son propre Hall.
ip_publique() {
    local d; d="$(domaine_box)"
    [ -n "$d" ] || meurt "domaine de la box inconnu ([global] domain ou [api] sso_cookie_domain)"
    # `|| true` : sous pipefail, un dig vide tuerait le script EN SILENCE.
    dig +short "hall.$d" A @"$RESOLVEUR" | grep -E '^[0-9.]+$' | head -1 || true
}

# Le nom résout-il, auprès du DNS public, vers <ip> ?
resout_vers() { [ "$(dig +short "$1" A @"$RESOLVEUR" | grep -E '^[0-9.]+$' | head -1 || true)" = "$2" ]; }

# Joignable par wg-mesh : l'IP est couverte par les allowed-ips d'un pair — un
# /32 côté maître, tout le réseau maillé côté satellite (le maître y relaie).
# Une sonde de lien direct (#3133) n'a pas d'AllowedIPs : `wg show` affiche « (none) », valeur ignorée.
pair_du_maillage() {
    python3 - "$1" "$(wg show wg-mesh allowed-ips 2>/dev/null || true)" <<'PY'
import ipaddress, sys
try:
    ip = ipaddress.ip_address(sys.argv[1])
except ValueError:
    sys.exit(1)
for ligne in sys.argv[2].splitlines():
    for v in ligne.split()[1:]:
        try:
            if ip in ipaddress.ip_network(v, strict=False):
                sys.exit(0)
        except ValueError:
            continue
sys.exit(1)
PY
}

routes_ecrire() {   # routes_ecrire <nom> [<ip> <port>] — sans ip : retire
    python3 - "$ROUTES" "$@" <<'PY'
import json, os, sys, shutil, time
chemin, nom = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(chemin))
except FileNotFoundError:
    d = {}
shutil.copy2(chemin, f"{chemin}.avant-relais-{int(time.time())}") if os.path.exists(chemin) else None
if len(sys.argv) > 3:
    d[nom] = [sys.argv[3], int(sys.argv[4])]
else:
    d.pop(nom, None)
tmp = chemin + ".sbxtmp"
with open(tmp, "w") as f:
    json.dump(d, f, indent=2, sort_keys=True)
    f.write("\n")
os.chmod(tmp, os.stat(chemin).st_mode & 0o777 if os.path.exists(chemin) else 0o644)
os.replace(tmp, chemin)
PY
}

# 0 si <nom> ne doit PAS être relayé ici parce que le pilotage du maître le sert (box « distante », #3126 R-L5-27/30) :
#  • seul un nom exact admin.<box>.secubox.in peut l'être (tout autre nom : 1, jamais exclu) ;
#  • fichier ABSENT (ou son dossier) : 1, rien d'exclu (box sans pilotage) ;
#  • fichier présent et sûr (ordinaire, root, sans écriture groupe/autres, un seul lien, ≤ 1 Mio, dans un dossier root non
#    inscriptible, lu sans suivre de lien) : 0 si le nom y figure ;
#  • fichier présent mais NON SÛR ou illisible (lien, lien dur, droits, JSON cassé) : 0 dans le doute pour tout admin.<box> —
#    le relais n'en crée aucun (jamais deux vhosts pour un nom) et la synchronisation n'en retire aucun ; dit au journal.
nom_exclu_pilotage() {   # nom_exclu_pilotage <nom>
    python3 - "$EXCLUSIONS_PILOTAGE" "$1" "$UID_ROOT" <<'PY'
import json, os, re, stat, sys
chemin, nom, uid = sys.argv[1], sys.argv[2], int(sys.argv[3])
if not re.fullmatch(r"admin\.[a-z0-9-]{1,40}\.secubox\.in", nom):
    sys.exit(1)
def douteux(motif):
    print(f"[relais-maillage] exclusions du pilotage non sûres ({motif}) : {nom} ni créé ni retiré", file=sys.stderr)
    sys.exit(0)
try:
    dfd = os.open(os.path.dirname(chemin), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
except FileNotFoundError:
    sys.exit(1)
except OSError:
    douteux("dossier")
try:
    sd = os.fstat(dfd)
    if sd.st_uid != uid or sd.st_mode & 0o022:
        douteux("dossier")
    try:
        fd = os.open(os.path.basename(chemin), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
    except FileNotFoundError:
        sys.exit(1)
    except OSError:
        douteux("lien")
finally:
    os.close(dfd)
try:
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_mode & 0o022 or st.st_nlink != 1
                or st.st_size > 1 << 20):
            douteux("propriétaire, droits ou liens")
        d = json.load(f)
except (OSError, ValueError):
    douteux("illisible")
noms = d.get("noms") if isinstance(d, dict) else None
if not isinstance(noms, list):
    douteux("illisible")
sys.exit(0 if nom in noms else 1)
PY
}

vhost_present() {
    python3 - "$1" "$HAPROXY_TOML" <<'PY'
import sys, tomllib
d = tomllib.load(open(sys.argv[2], "rb"))
v = d.get("vhosts") or {}
it = v.values() if isinstance(v, dict) else v
sys.exit(0 if any(x.get("domain") == sys.argv[1] for x in it) else 1)
PY
}

# relayer --sans-sonde : RÉTABLISSEMENT d'un relais qui existait (retour arrière du pilotage, #3126 R-L5-30 I3). Mêmes
# contrôles du nom, de l'exclusion, de l'IP et du port, même certificat, vhost et route ; mais ni sonde du pair (curl), ni
# DNS public, ni vérification finale : un pair muet au moment du retour retrouve quand même son nom.
cmd_relayer() {
    local sonde=1
    if [ "${1:-}" = "--sans-sonde" ]; then sonde=0; shift; fi
    local nom="${1:-}" ip="${2:-}" port="${3:-9080}"
    nom_valide "$nom" || meurt "nom invalide : « $nom »"
    ! nom_exclu_pilotage "$nom" || meurt "$nom est servi par le pilotage du maître (box « distante ») : non relayé"
    ip_valide "$ip"   || meurt "IP maillée invalide : « $ip » (attendu 10.10.0.x)"
    port_valide "$port" || meurt "port invalide : « $port »"
    if [ "$sonde" = 0 ]; then
        log "rétablissement sans sonde : $nom → $ip:$port"
        relais_poser "$nom" "$ip" "$port"
        haproxyctl generate >/dev/null && haproxyctl reload >/dev/null || meurt "HAProxy n'a pas rechargé"
        systemctl reload secubox-waf-ng 2>/dev/null || true
        audit_relais relais_retabli "$nom" "$ip"
        log "relais rétabli : $nom → $ip:$port"
        return 0
    fi

    log "1/5 pair $ip dans le maillage et joignable…"
    pair_du_maillage "$ip" || meurt "$ip n'est pas un pair de wg-mesh sur ce nœud"
    local code
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 -H "Host: $nom" "http://$ip:$port/" || true)
    [ "$code" != "000" ] || meurt "le pair ne répond pas sur $ip:$port — sur le pair : secubox-relais-maillage ouvrir <ip-du-relais> $port"
    log "    le pair répond (HTTP $code)"
    # En automatique, on ne publie pas un service arrêté (5xx) : il le sera à
    # une prochaine synchronisation, s'il répond alors.
    if [ -n "${RELAIS_EN_LOT:-}" ] && [[ "$code" == 5* ]]; then
        meurt "le service ne répond pas sur le pair (HTTP $code)"
    fi

    log "2/5 DNS public de $nom…"
    local pub vu
    pub="$(ip_publique)"; [ -n "$pub" ] || meurt "IP publique du relais introuvable"
    vu="$(dig +short "$nom" A @"$RESOLVEUR" | grep -E '^[0-9.]+$' | head -1 || true)"
    [ "$vu" = "$pub" ] || meurt "$nom résout vers « ${vu:-rien} », pas vers ce relais ($pub) — créer l'enregistrement A chez le registraire (module DNS) puis relancer"
    log "    $nom → $pub"

    relais_poser "$nom" "$ip" "$port"
    # En lot (synchroniser), le rechargement et la vérification se font une
    # fois, à la fin.
    [ -n "${RELAIS_EN_LOT:-}" ] && return 0
    haproxyctl generate >/dev/null && haproxyctl reload >/dev/null || meurt "HAProxy n'a pas rechargé"
    systemctl reload secubox-waf-ng 2>/dev/null || true
    sleep 2

    code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 15 --resolve "$nom:443:127.0.0.1" "https://$nom/" || true)
    log "vérification : https://$nom/ → HTTP $code"
    case "$code" in 2??|3??|401|403) log "relais en place : $nom → $ip:$port" ;;
        *) meurt "la chaîne répond $code — voir journalctl -u secubox-waf-ng" ;; esac
}

# Étapes 3 à 5 (certificat, vhost HAProxy derrière le WAF, route sbxwaf) : communes au relais et au rétablissement.
relais_poser() {   # relais_poser <nom> <ip> <port>
    local nom="$1" ip="$2" port="$3"
    log "3/5 certificat…"
    if [ -s "$CERTS_DIR/$nom.pem" ]; then
        log "    déjà servi par HAProxy"
    elif [ -s "$CERTS_DIR/*.${nom#*.}.pem" ]; then
        log "    couvert par le joker *.${nom#*.}"
    else
        certbot certonly --webroot -w "$WEBROOT" -d "$nom" --non-interactive --agree-tos \
            --keep-until-expiring --register-unsafely-without-email >/dev/null \
            || meurt "certbot a échoué pour $nom"
        haproxyctl cert sync >/dev/null
        [ -s "$CERTS_DIR/$nom.pem" ] || meurt "certificat émis mais absent de $CERTS_DIR"
        log "    émis et installé"
    fi

    log "4/5 vhost HAProxy (WAF)…"
    if vhost_present "$nom"; then
        log "    déjà déclaré"
    else
        haproxyctl vhost add "$nom" "$BACKEND" true >/dev/null
    fi

    log "5/5 route sbxwaf → $ip:$port…"
    routes_ecrire "$nom" "$ip" "$port"
    if [[ "$nom" == hall.* ]] && command -v secubox-halls-parc >/dev/null; then
        secubox-halls-parc ajouter "https://$nom" >/dev/null && log "Halls du parc : https://$nom peut encadrer les services d'ici"
    fi
}

# Joker DNS du pair (#3206) : « *.<domaine-du-pair> A <ip publique> » chez le registraire, par le module DNS d'ici
# (secubox-dns-joker, fournisseurs de secubox-dns-provider). AVANT le certificat joker : son défi DNS-01 crée
# _acme-challenge.<domaine-du-pair>, après quoi le joker parent (*.secubox.in) ne couvre plus les noms du pair (vécu
# sur gk3 puis gk4, 2026-10-27 : 19 noms refusés). Idempotent ; jamais d'écrasement d'un enregistrement étranger.
# Rend 0 si le joker est en place (créé ou déjà juste) ; 1 sinon (module absent, refus, échec : dit au journal).
dns_joker_assure() {   # dns_joker_assure <domaine-du-pair> <ip-publique> <zone-autorisée> <ip-du-pair>
    local d="$1" pub="$2" zone="$3" pair="$4" sortie
    [ -x "$DNS_JOKER" ] || return 1
    [ -n "$pub" ] || { log "joker DNS *.$d non assuré : IP publique du relais inconnue"; return 1; }
    # zone = zone parente de CE relais (gk2.secubox.in → secubox.in) : un pair ne fait jamais écrire ailleurs (revue #3206)
    if ! sortie="$(timeout 180 "$DNS_JOKER" assurer "$d" "$pub" "$zone" 2>&1)"; then
        log "joker DNS *.$d non assuré : $sortie"; return 1
    fi
    case "$sortie" in
        *'"etat": "cree"'*)
            audit_relais joker_dns_cree "*.$d" "$pair"
            log "joker DNS *.$d créé chez le registraire → $pub ; attente de la propagation…"
            for _ in $(seq 1 "$ATTENTE_DNS_PAS"); do
                resout_vers "hall.$d" "$pub" && { log "    hall.$d → $pub"; return 0; }
                sleep "$PAS_DNS"
            done
            log "    hall.$d ne résout pas encore vers $pub : ses noms suivront à la prochaine synchronisation" ;;
    esac
    return 0
}

# ── EXPOSITION PAR DÉFAUT (#1682) ────────────────────────────────────────────
# Certificat JOKER *.<domaine> par DNS-01 (acme.sh + Gandi LiveDNS, comme
# *.gk2.secubox.in) : un seul certificat pour tous les noms d'un pair, au lieu
# d'un par nom. Renouvelé par acme.sh --cron, recopié par secubox-certs-deploy.
joker_assure() {
    local d="$1" pem="$CERTS_DIR/*.$1.pem"
    [ -s "$pem" ] && return 0
    [ -x "$ACME/acme.sh" ] && grep -q '^SAVED_GANDI_LIVEDNS_' "$ACME/account.conf" 2>/dev/null || return 1
    log "certificat joker *.$d (DNS-01)…"
    "$ACME/acme.sh" --issue --dns dns_gandi_livedns -d "*.$d" --keylength ec-256 \
        --home "$ACME" >/dev/null 2>&1 || return 1
    local rep="$ACME/*.${d}_ecc" tmp
    [ -s "$rep/fullchain.cer" ] && [ -s "$rep/*.$d.key" ] || return 1
    tmp="$(mktemp "$CERTS_DIR/.joker.XXXXXX")"
    cat "$rep/fullchain.cer" "$rep/*.$d.key" > "$tmp"
    chown haproxy:secubox "$tmp" 2>/dev/null || true
    chmod 0640 "$tmp"
    mv "$tmp" "$pem"
    log "    *.$d installé"
}

reglage() {   # reglage <clé> <défaut> — lu dans relais-maillage.toml
    python3 - "$REGLAGES" "$1" "$2" <<'PY'
import sys, tomllib, json
chemin, cle, defaut = sys.argv[1:4]
try:
    v = tomllib.load(open(chemin, "rb")).get(cle, json.loads(defaut))
except (OSError, ValueError):
    v = json.loads(defaut)
print(" ".join(v) if isinstance(v, list) else json.dumps(v))
PY
}

# Ce que le relais expose LUI-MÊME : le premier label de chaque route de son
# propre domaine. Un pair n'est relayé que pour ces services-là.
labels_exposes() {
    python3 - "$ROUTES" "$1" <<'PY'
import json, sys
d = json.load(open(sys.argv[1])); dom = "." + sys.argv[2]
print(" ".join(sorted({k[: -len(dom)] for k in d if k.endswith(dom) and "." not in k[: -len(dom)]})))
PY
}

# Noms relayés vers le pair IP, de la forme que pose la synchronisation (<libellé>.<domaine-du-pair>, libellé non
# exclu, et commun en mode « communs ») et qu'il ne publie plus (#3132). Retirés seulement s'ils l'étaient déjà au
# relevé précédent : un webos au cache vide ne vide pas le relais d'un coup. Le relais lui-même, les autres pairs,
# les autres domaines et les relais posés à la main (plusieurs niveaux, libellé exclu) ne sont jamais touchés.
noms_perimes() {   # noms_perimes <ip> <domaine-du-pair> <exclus,…> <communs,…|*> [noms publiés…]
    python3 - "$ROUTES" "$ETAT_PERIMES" "$@" <<'PY'
import json, os, sys
routes, etat, ip, dpair, exclus, communs = sys.argv[1:7]
publies = set(sys.argv[7:])
exclus = set(filter(None, exclus.split(",")))
communs = None if communs == "*" else set(filter(None, communs.split(",")))
try:
    d = json.load(open(routes))
except (OSError, ValueError):
    sys.exit(0)
cand = []
for k in sorted(d):
    v = d[k]
    if not (isinstance(v, list) and v and v[0] == ip and k.endswith("." + dpair)):
        continue
    label = k[: -len(dpair) - 1]
    if "." in label or label in exclus or (communs is not None and label not in communs):
        continue
    if k not in publies:
        cand.append(k)
try:
    e = json.load(open(etat))
    e = e if isinstance(e, dict) else {}
except (OSError, ValueError):
    e = {}
avant = set(e.get(ip) or [])
for k in cand:
    if k in avant:
        print(k)
e[ip] = cand
import tempfile
dossier = os.path.dirname(etat) or "."
os.makedirs(dossier, exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=dossier, prefix=".relais-perimes.")
with os.fdopen(fd, "w") as f:
    json.dump(e, f)
os.replace(tmp, etat)
PY
}

# Un domaine déjà relayé vers une AUTRE IP n'est pas à ce pair : refus (#3132 — sinon un pair annonce le domaine d'un
# autre et détourne ses noms). Routes illisibles : refus aussi.
domaine_tenu_par_autre() {   # domaine_tenu_par_autre <ip> <domaine> — 0 : tenu par un autre
    python3 - "$ROUTES" "$@" <<'PY'
import json, sys
chemin, ip, dpair = sys.argv[1:4]
try:
    d = json.load(open(chemin))
except (OSError, ValueError):
    sys.exit(0)
import ipaddress
maillage = ipaddress.ip_network("10.10.0.0/24")
for k, v in d.items():
    if not (isinstance(v, list) and v and v[0] != ip):
        continue
    # même domaine ou un de ses noms, quelle que soit la cible
    if k == dpair or k.endswith("." + dpair):
        sys.exit(0)
    # sous-domaine du domaine d'un AUTRE PAIR (son joker le couvrirait) ; les routes du relais lui-même
    # (127.0.0.1, sous le domaine parent) ne comptent pas, sinon tout *.secubox.in serait refusé
    try:
        pair = ipaddress.ip_address(v[0]) in maillage
    except ValueError:
        pair = False
    parent = k.split(".", 1)[1] if "." in k else k
    if pair and (dpair == parent or dpair.endswith("." + parent)):
        sys.exit(0)
sys.exit(1)
PY
}

# Jamais écraser une route qui vise une autre cible que ce pair.
route_etrangere() {   # route_etrangere <nom> <ip> — 0 : la route existe et vise ailleurs
    python3 -c 'import json,sys
d = json.load(open(sys.argv[1])); v = d.get(sys.argv[2])
sys.exit(0 if isinstance(v, list) and v and v[0] != sys.argv[3] else 1)' "$ROUTES" "$1" "$2" 2>/dev/null
}

# Noms d'un pair (JSON de /public/noms sur l'entrée) ; liste absente ou mal formée : échec, rien n'est ajouté ni retiré.
noms_du_pair() {
    python3 -c 'import json,sys
try:
    n = json.load(sys.stdin)["noms"]
except Exception:
    sys.exit(1)
if not isinstance(n, list) or not all(isinstance(x, str) for x in n):
    sys.exit(1)
print(" ".join(n))'
}

# Pairs à /32 (côté maître) ; maître du satellite (entrée « master » de l'état).
# Un lien direct entre pairs (#3133, entrée `direct: true` de l'état) a aussi un /32 mais n'est PAS un pair à relayer :
# sans ce filtre, tout satellite se prendrait pour le relais de ses frères. État absent ou illisible : aucun filtre.
pairs_32() {
    python3 - "$WG_ETAT" "$(wg show wg-mesh allowed-ips 2>/dev/null || true)" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    directs = {p.get("public_key") for p in d.get("peers") or [] if isinstance(p, dict) and p.get("direct") is True}
except (OSError, ValueError, AttributeError, TypeError):
    directs = set()
for ligne in sys.argv[2].splitlines():
    champs = ligne.split()
    if len(champs) < 2 or champs[0] in directs:
        continue
    for v in champs[1:]:
        if v.endswith("/32"):
            print(v[:-3])
PY
}
maitre_du_satellite() {
    python3 - "$WG_ETAT" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit(0)
for p in d.get("peers") or []:
    if p.get("name") == "master" or str(p.get("allowed_ips", "")).endswith("/24"):
        print(p.get("mesh_ip") or ""); break
PY
}

# ── ports bruts relayés (#3154) ──────────────────────────────────────────────
# Ports d'un pair (JSON de /public/ports sur l'entrée) → lignes « tcp/7881 meet ». Liste absente ou mal formée : échec,
# rien n'est ajouté ni retiré. Entrée non fiable : tout est revalidé ici.
ports_du_pair() {   # ports_du_pair [--tous] — --tous : garde aussi les ports réservés (l'appelant les refuse et les audite)
    python3 -c 'import json, re, sys
RESERVES = {22, 53, 80, 443, 7331, 8085, 9080, 51820, 51822}
tous = "--tous" in sys.argv[1:]
try:
    liste = json.load(sys.stdin)["ports"]
except Exception:
    sys.exit(1)
if not isinstance(liste, list):
    sys.exit(1)
vus = []
for p in liste[:16]:
    if not isinstance(p, dict):
        continue
    proto, port, mod = p.get("proto"), p.get("port"), p.get("module")
    if proto in ("tcp", "udp") and type(port) is int and 1024 <= port <= 65535 and (tous or port not in RESERVES) \
            and isinstance(mod, str) and re.fullmatch(r"[a-z0-9-]{1,32}", mod):
        ligne = "%s/%d %s" % (proto, port, mod)
        if ligne not in vus:
            vus.append(ligne)
print("\n".join(vus))' "$@"
}

# Ports en écoute sur CE relais (« tcp/7881 »…) : un pair ne peut pas se faire rediriger un service local.
ports_en_ecoute() {
    local netid loc
    ss -Hlntu 2>/dev/null | while read -r netid _ _ _ loc _; do
        printf '%s/%s\n' "$netid" "${loc##*:}"
    done || true
}

# Ports que CE relais publie lui-même (même format que les pairs) : ils comptent comme déjà pris.
ports_locaux() {
    python3 - "$PORTS_PUBLICS_LOCAL" <<'PY'
import json, re, sys
from pathlib import Path
vus = set()
try:
    fichiers = sorted(Path(sys.argv[1]).glob("*.json"))
except OSError:
    fichiers = []
for f in fichiers:
    try:
        d = json.loads(f.read_text())
        mod, liste = d["module"], d["ports"]
    except (OSError, ValueError, KeyError, TypeError):
        continue
    if not isinstance(mod, str) or not re.fullmatch(r"[a-z0-9-]{1,32}", mod) or not isinstance(liste, list):
        continue
    for p in liste:
        if isinstance(p, dict) and p.get("proto") in ("tcp", "udp") and type(p.get("port")) is int and 1024 <= p["port"] <= 65535:
            vus.add("%s/%d %s" % (p["proto"], p["port"], mod))
print("\n".join(sorted(vus)))
PY
}

# Entrées de l'état dont l'ip n'est ni 127.0.0.1 (ce relais) ni parmi les pairs actuels : « cle ip » par ligne.
ports_disparus() {   # ports_disparus <etat.json> [<ip-de-pair>…]
    python3 - "$@" <<'PY'
import json, sys
try:
    e = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit(0)
presents = set(sys.argv[2:]) | {"127.0.0.1"}
for k, v in sorted(e.items() if isinstance(e, dict) else []):
    ip = v.get("ip") if isinstance(v, dict) else None
    if ip not in presents:
        print("%s %s" % (k, ip))
PY
}

# <proto/port> déjà tenu par une AUTRE ip ? (0 : oui, refuser — le premier déclarant gagne). État illisible : non.
port_tenu_par_autre() {   # port_tenu_par_autre <etat.json> <ip> <proto/port>
    python3 - "$1" "$2" "$3" <<'PY'
import json, sys
try:
    e = json.load(open(sys.argv[1]))
    v = e.get(sys.argv[3])
    sys.exit(0 if isinstance(v, dict) and v.get("ip") != sys.argv[2] else 1)
except (OSError, ValueError, AttributeError):
    sys.exit(1)
PY
}

# Clés <proto/port> que l'état attribue à <ip>.
ports_de_ip() {   # ports_de_ip <etat.json> <ip>
    python3 - "$1" "$2" <<'PY'
import json, sys
try:
    e = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit(0)
for k, v in sorted(e.items()):
    if isinstance(v, dict) and v.get("ip") == sys.argv[2]:
        print(k)
PY
}

# État : poser <cle> <ip> <module> | retirer <cle>. Écriture atomique ; état illisible : repart de zéro.
etat_ports_maj() {   # etat_ports_maj <etat.json> poser|retirer <cle> [<ip> <module>]
    python3 - "$@" <<'PY'
import json, os, sys, tempfile
chemin, action, cle = sys.argv[1:4]
try:
    e = json.load(open(chemin))
    if not isinstance(e, dict):
        e = {}
except (OSError, ValueError):
    e = {}
if action == "poser":
    e[cle] = {"ip": sys.argv[4], "module": sys.argv[5]}
else:
    e.pop(cle, None)
os.makedirs(os.path.dirname(chemin) or ".", exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(chemin) or ".", prefix=".relais-ports.")
with os.fdopen(fd, "w") as f:
    json.dump(e, f, indent=2, sort_keys=True)
    f.write("\n")
os.chmod(tmp, 0o644)
os.replace(tmp, chemin)
PY
}

# SEULS les paquets destinés à une adresse LOCALE du maître sont redirigés (fib daddr type local) : sans cela, le trafic
# routé du LAN ou des conteneurs vers n'importe quelle destination au port publié serait détourné vers le pair.
# Table nft entière de l'état (rien si aucune entrée distante). Les entrées 127.0.0.1 (ports du relais lui-même) n'ont pas
# de règle ici : le DNAT local est posé par le module (meetctl media-expose). Le masquerade fait repasser le retour par
# ce relais, sinon la box d'accès verrait une réponse hors de sa table NAT.
rendu_nft_ports() {   # rendu_nft_ports <etat.json>
    python3 - "$1" <<'PY'
import json, re, sys
try:
    e = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    e = {}
RESERVES = {22, 53, 80, 443, 7331, 8085, 9080, 51820, 51822}
regles = []
for cle, v in sorted(e.items() if isinstance(e, dict) else []):
    m = re.fullmatch(r"(tcp|udp)/([1-9][0-9]{3,4})", cle)
    if not m or not isinstance(v, dict):
        continue
    ip, mod = v.get("ip"), v.get("module")
    if not isinstance(ip, str) or not re.fullmatch(r"10\.10\.0\.(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-4])", ip):
        continue
    if not isinstance(mod, str) or not re.fullmatch(r"[a-z0-9-]{1,32}", mod):
        continue
    proto, port = m.groups()
    if not 1024 <= int(port) <= 65535 or int(port) in RESERVES:
        continue
    regles.append((proto, port, ip, mod))
if not regles:
    sys.exit(0)
print("table inet secubox-relais-ports {")
print("    chain prerouting {")
print("        type nat hook prerouting priority dstnat; policy accept;")
for proto, port, ip, mod in regles:
    print('        iifname != "wg-mesh" fib daddr type local %s dport %s counter dnat ip to %s:%s comment "relais-ports %s"' % (proto, port, ip, port, mod))
print("    }")
print("    chain postrouting {")
print("        type nat hook postrouting priority srcnat; policy accept;")
for proto, port, ip, mod in regles:
    print('        oifname "wg-mesh" ip daddr %s %s dport %s counter masquerade' % (ip, proto, port))
print("    }")
print("    chain forward {")
print("        type filter hook forward priority 0; policy accept;")
for proto, port, ip, mod in regles:
    print('        oifname "wg-mesh" ip daddr %s %s dport %s accept' % (ip, proto, port))
print("    }")
print("}")
PY
}

# Régénère le fichier persistant (rechargé au démarrage par l'inclusion de /etc/nftables.d dans nftables.conf) puis l'applique
# À CHAUD, table seule : JAMAIS `nft -f nftables.conf` (voir plus bas, il efface les tables vivantes). Table supprimée avant
# `nft -f` : celui-ci ajoute des règles, il ne remplace pas la table.
ports_nft_appliquer() {
    local rendu tmp="$RELAIS_PORTS_NFT.sbxtmp"
    rendu="$(rendu_nft_ports "$RELAIS_PORTS_ETAT")"
    if [ -z "$rendu" ]; then
        nft delete table inet secubox-relais-ports 2>/dev/null || true
        rm -f "$RELAIS_PORTS_NFT"
        return 0
    fi
    mkdir -p "$(dirname "$RELAIS_PORTS_NFT")"
    # « table {} » puis « delete table » puis la table : une seule transaction `nft -f`, sans instant où la table manque
    # (et sans erreur si elle n'existait pas). Validé AVANT de remplacer le fichier : nftables.conf inclut
    # /etc/nftables.d/*.nft, et un fichier invalide ferait échouer tout le jeu de règles au démarrage.
    printf '# secubox-relais-maillage (#3154) : ports médias des pairs relayés par ce maître. Régénéré, ne pas éditer.\ntable inet secubox-relais-ports {}\ndelete table inet secubox-relais-ports\n%s\n' \
        "$rendu" > "$tmp"
    if ! nft -c -f "$tmp"; then
        rm -f "$tmp"
        audit_relais relais_ports_nft_refuse secubox-relais-ports -
        log "nft refuse la table des ports relayés — ancien fichier et table vivante conservés"
        return 1
    fi
    mv -f "$tmp" "$RELAIS_PORTS_NFT"
    nft -f "$RELAIS_PORTS_NFT" || { log "nft a refusé $RELAIS_PORTS_NFT à chaud"; return 1; }
}

# Retire les ports des pairs disparus du maillage (ip absente de <pairs>) puis régénère. Appelée aussi quand il n'y a plus de pair.
ports_nettoyer_disparus() {   # ports_nettoyer_disparus <pairs>
    local cle ipp
    # shellcheck disable=SC2086  # pairs : liste d'IP validées par pairs_32, découpée exprès
    while read -r cle ipp; do
        [ -n "$cle" ] || continue
        ( RELAIS_EN_LOT=1 cmd_retirer_port "$cle" ) >/dev/null 2>&1 || true
        audit_relais relais_port_retire "$cle" "$ipp"
        log "port retiré : $cle (le pair $ipp n'est plus dans le maillage)"
    done < <(ports_disparus "$RELAIS_PORTS_ETAT" $1)
    ports_nft_appliquer
}

port_cle_valide() {
    [[ "$1" =~ ^(tcp|udp)/[1-9][0-9]{3,4}$ ]] && [ "${1#*/}" -ge 1024 ] && [ "${1#*/}" -le 65535 ] && [[ "$PORTS_RESERVES" != *" ${1#*/} "* ]]
}

cmd_relayer_port() {   # cmd_relayer_port <proto/port> <ip> <module>
    local cle="${1:-}" ip="${2:-}" mod="${3:-}"
    port_cle_valide "$cle" || meurt "port invalide : « $cle » (attendu tcp|udp/1024-65535)"
    ip_valide "$ip"        || meurt "IP maillée invalide : « $ip » (attendu 10.10.0.x)"
    [[ "$mod" =~ ^[a-z0-9-]{1,32}$ ]] || meurt "module invalide : « $mod »"
    port_tenu_par_autre "$RELAIS_PORTS_ETAT" "$ip" "$cle" && meurt "$cle est déjà relayé vers un autre pair"
    etat_ports_maj "$RELAIS_PORTS_ETAT" poser "$cle" "$ip" "$mod"
    [ -n "${RELAIS_EN_LOT:-}" ] || ports_nft_appliquer
    log "port relayé : $cle → $ip ($mod)"
}

cmd_retirer_port() {   # cmd_retirer_port <proto/port>
    local cle="${1:-}"
    port_cle_valide "$cle" || meurt "port invalide : « $cle »"
    etat_ports_maj "$RELAIS_PORTS_ETAT" retirer "$cle"
    [ -n "${RELAIS_EN_LOT:-}" ] || ports_nft_appliquer
    log "port retiré : $cle"
}

# SYNCHRONISER — sans argument, idempotent, sûr à relancer (minuteur horaire).
#  • Satellite : le port des vhosts est ouvert au SEUL maître, qui voit donc les
#    noms de la box ; real_ip lui fait confiance.
#  • Relais (a des pairs /32) : pour chaque pair, lit /api/v1/webos/public/noms
#    et relaie un nom <svc>.<domaine-du-pair> si, et seulement si :
#      1. <svc>.<domaine-du-relais> est exposé ici (même politique qu'ici) ;
#      2. <svc> n'est pas exclu (défaut : wpad, boot — jamais publics) ;
#      3. le domaine du pair n'est ni celui du relais ni un de ses parents/enfants
#         (un pair ne peut pas revendiquer les noms du relais) ;
#      4. le DNS public du nom pointe vers ce relais (décision du propriétaire du
#         domaine, vérifiée dans cmd_relayer).
#    Le WAF d'ici inspecte tout ; un service réservé au LAN sur le pair y voit un
#    visiteur WAN (real_ip) et reste fermé.
cmd_synchroniser() {
    local maitre
    maitre="$(maitre_du_satellite)"
    if [ -n "$maitre" ] && ip_valide "$maitre" && pair_du_maillage "$maitre"; then
        cmd_ouvrir "$maitre" "$PORT_PAIR" | sed 's/^/  /'
    fi

    # `wg show wg-mesh` echoue quand l'interface n'existe pas (box sans maillage) : sous set -e/pipefail cela tuait le script AVANT
    # la garde ci-dessous (#2532). Pas de pair, ce n'est pas une erreur.
    local pairs; pairs="$(pairs_32 || true)"
    [ -n "$pairs" ] || { log "aucun pair à relayer (pas de pair /32 sur wg-mesh)"; ports_nettoyer_disparus "" || true; return 0; }
    [ "$(reglage auto true)" = "true" ] || { log "exposition automatique désactivée ($REGLAGES : auto = false)"; ports_nettoyer_disparus "$pairs" || true; return 0; }
    local dom exclus labels mode
    dom="$(domaine_box)"; [ -n "$dom" ] || meurt "domaine du relais inconnu"
    # services_des_pairs (#3132) : « tous » (défaut) publie aussi les services propres à un pair ; « communs »
    # ne relaie que les libellés que ce relais expose lui-même (comportement d'avant).
    mode="$(reglage services_des_pairs '"tous"')"; mode="${mode//\"/}"
    exclus=" $(reglage exclure '["wpad", "boot"]') "
    labels=" $(labels_exposes "$dom") "

    local ip json dpair nom label ajoutes=0 vus=0 echecs=0 retires=0 publies perime
    for ip in $pairs; do
        json="$(curl -s --max-time 6 -H 'Host: hall.localhost' "http://$ip:$PORT_PAIR/api/v1/webos/public/noms" || true)"
        dpair="$(printf '%s' "$json" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("domaine",""))
except Exception: pass' 2>/dev/null)"
        [ -n "$dpair" ] && nom_valide "$dpair" || continue
        if [ "$dpair" = "$dom" ] || [[ "$dpair" == *".$dom" ]] || [[ "$dom" == *".$dpair" ]]; then
            log "pair $ip : domaine $dpair refusé (celui du relais)"; continue
        fi
        if domaine_tenu_par_autre "$ip" "$dpair"; then
            log "pair $ip : domaine $dpair déjà relayé vers un autre pair — refusé"
            audit_relais relais_domaine_refuse "$dpair" "$ip"; continue
        fi
        local liste
        if ! liste="$(printf '%s' "$json" | noms_du_pair)"; then
            log "pair $ip : liste de noms illisible — rien ajouté ni retiré"; continue
        fi
        # ÉMETTRE UN JOKER PEUT MASQUER LE DNS. Si les noms du pair résolvent
        # par un joker PARENT (*.secubox.in), le défi DNS-01 crée
        # _acme-challenge.<domaine> : le domaine devient un nœud existant et le
        # joker parent ne s'y applique plus — tous les noms du pair tombent en
        # NXDOMAIN. Un enregistrement *.<domaine> propre au pair l'évite (vécu
        # sur gk3, #1682). On le dit plutôt que de laisser 14 échecs muets.
        local temoin="hall.$dpair" pub; pub="$(ip_publique)"
        dns_joker_assure "$dpair" "$pub" "${dom#*.}" "$ip" || true   # #3206 : avant le certificat (masquerait le parent)
        local avant=0; resout_vers "$temoin" "$pub" && avant=1
        joker_assure "$dpair" || log "pair $ip : pas de joker *.$dpair — certificats par nom"
        if [ "$avant" = 1 ] && ! resout_vers "$temoin" "$pub"; then
            log "pair $ip : $temoin ne résout plus depuis le défi DNS-01 — créer « *.$dpair A $pub » chez le registraire"
        fi
        publies=""
        for nom in $liste; do
            [[ "$nom" == *".$dpair" ]] && nom_valide "$nom" || continue
            label="${nom%.$dpair}"
            [[ "$label" =~ ^[a-z0-9-]+$ ]] || continue
            [[ "$exclus" == *" $label "* ]] && continue
            # box « distante » (#3126) : admin.<box> servi par le pilotage — jamais (re)créé ici, et compté comme publié pour
            # que la synchronisation ne le retire jamais non plus (c'est le pilotage qui le rend, par relayer --sans-sonde)
            if nom_exclu_pilotage "$nom"; then publies="$publies $nom"; continue; fi
            if [ "$mode" = "communs" ]; then
                [[ "$labels" == *" $label "* ]] || continue
            fi
            publies="$publies $nom"
            vus=$((vus + 1))
            if python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if d.get(sys.argv[2],[None])[0]==sys.argv[3] else 1)' "$ROUTES" "$nom" "$ip"; then
                continue
            fi
            if route_etrangere "$nom" "$ip"; then
                log "non relayé : $nom vise déjà une autre cible — jamais écrasé"
                audit_relais relais_nom_refuse "$nom" "$ip"; continue
            fi
            if ( RELAIS_EN_LOT=1 cmd_relayer "$nom" "$ip" "$PORT_PAIR" ) >/dev/null 2>&1; then
                ajoutes=$((ajoutes + 1)); log "relayé : $nom → $ip"; audit_relais relaye "$nom" "$ip"
            else
                echecs=$((echecs + 1)); log "non relayé : $nom (voir : secubox-relais-maillage relayer $nom $ip)"
            fi
        done
        # Le pair a répondu (domaine valide) : ce qu'il ne publie plus n'est plus relayé (#3132). Un pair
        # injoignable n'arrive jamais ici, ses noms restent.
        # listes « a b c » → « a,b,c » par découpage bash (un guillemet du TOML ne vide plus la liste)
        local communs="*" ex_csv mots
        read -ra mots <<<"$exclus"; ex_csv="$(IFS=,; printf '%s' "${mots[*]}")"
        if [ "$mode" = "communs" ]; then read -ra mots <<<"$labels"; communs="$(IFS=,; printf '%s' "${mots[*]}")"; fi
        # shellcheck disable=SC2086  # publies : liste de noms validés, découpée exprès
        for perime in $(noms_perimes "$ip" "$dpair" "$ex_csv" "$communs" $publies); do
            if ( RELAIS_EN_LOT=1 cmd_retirer "$perime" ) >/dev/null 2>&1; then
                retires=$((retires + 1)); log "retiré : $perime (le pair $ip ne le publie plus)"
                audit_relais relais_retire "$perime" "$ip"
            fi
        done
    done
    # PORTS BRUTS (#3154). Les ports que ce relais publie lui-même sont notés d'abord (ip 127.0.0.1 : pas de règle ici, le
    # module pose son propre DNAT) ; le premier déclarant d'un <proto/port> le garde. Boucle à part : les « continue » des
    # noms (domaine refusé, liste illisible) ne doivent pas priver un pair de ses ports.
    local lignes cle mod rep code corps tenus vus_p ecoutes retires_p=0 relayes_p=0
    ecoutes=" $(ports_en_ecoute | tr '\n' ' ') "
    export RELAIS_EN_LOT=1
    lignes="$(ports_locaux)"; vus_p=" "
    while read -r cle mod; do
        [ -n "$cle" ] || continue
        vus_p="$vus_p$cle "
        if port_tenu_par_autre "$RELAIS_PORTS_ETAT" 127.0.0.1 "$cle"; then
            log "port local $cle déjà relayé vers un pair — le pair garde"; audit_relais relais_port_refuse "$cle" 127.0.0.1; continue
        fi
        etat_ports_maj "$RELAIS_PORTS_ETAT" poser "$cle" 127.0.0.1 "$mod"
    done <<<"$lignes"
    for cle in $(ports_de_ip "$RELAIS_PORTS_ETAT" 127.0.0.1); do
        [[ "$vus_p" == *" $cle "* ]] || etat_ports_maj "$RELAIS_PORTS_ETAT" retirer "$cle"
    done
    for ip in $pairs; do
        rep="$(mktemp)"
        code="$(curl -s --max-time 6 -o "$rep" -w '%{http_code}' -H 'Host: hall.localhost' \
            "http://$ip:$PORT_PAIR/api/v1/webos/public/ports" || true)"
        corps="$(cat "$rep")"; rm -f "$rep"
        # injoignable (000) ou en panne (5xx) : les ports du pair restent. 404 : webos ancien, aucun port publié.
        if [ "$code" = 404 ]; then
            corps='{"ports": []}'
        elif [ "$code" != 200 ]; then
            continue
        fi
        if ! lignes="$(printf '%s' "$corps" | ports_du_pair --tous)"; then
            log "pair $ip : liste de ports illisible — rien ajouté ni retiré"; continue
        fi
        tenus=" "
        while read -r cle mod; do
            [ -n "$cle" ] || continue
            if [[ "$PORTS_RESERVES" == *" ${cle#*/} "* ]] || [[ "$ecoutes" == *" $cle "* ]]; then
                log "pair $ip : port $cle réservé ou en écoute sur ce relais — refusé"
                audit_relais relais_port_refuse "$cle" "$ip"; continue
            fi
            if port_tenu_par_autre "$RELAIS_PORTS_ETAT" "$ip" "$cle"; then
                log "pair $ip : port $cle déjà relayé vers un autre — refusé"
                audit_relais relais_port_refuse "$cle" "$ip"; continue
            fi
            tenus="$tenus$cle "
            if ( cmd_relayer_port "$cle" "$ip" "$mod" ) >/dev/null 2>&1; then relayes_p=$((relayes_p + 1)); fi
        done <<<"$lignes"
        # Le pair a répondu : ce qu'il ne publie plus n'est plus relayé.
        for cle in $(ports_de_ip "$RELAIS_PORTS_ETAT" "$ip"); do
            if [[ "$tenus" != *" $cle "* ]]; then
                ( cmd_retirer_port "$cle" ) >/dev/null 2>&1 || true; retires_p=$((retires_p + 1))
                audit_relais relais_port_retire "$cle" "$ip"
            fi
        done
    done
    unset RELAIS_EN_LOT
    # pairs disparus du maillage : leurs ports ne restent pas (IP morte ou réattribuée) ; régénère aussi le fichier
    ports_nettoyer_disparus "$pairs" || echecs=$((echecs + 1))
    log "ports : $relayes_p relayé(s), $retires_p retiré(s)"
    if [ "$ajoutes" -gt 0 ] || [ "$retires" -gt 0 ]; then
        # --allow-shrink seulement si des noms ont été retirés : sinon la garde anti-dérive reste entière
        local opt=()
        if [ "$retires" -gt 0 ]; then opt=(--allow-shrink); fi
        haproxyctl generate "${opt[@]}" >/dev/null && haproxyctl reload >/dev/null || meurt "HAProxy n'a pas rechargé"
        systemctl reload secubox-waf-ng 2>/dev/null || true
    fi
    log "synchronisé : $vus nom(s) éligible(s), $ajoutes ajouté(s), $retires retiré(s), $echecs échec(s)"
}

cmd_retirer() {
    local nom="${1:-}"
    nom_valide "$nom" || meurt "nom invalide : « $nom »"
    routes_ecrire "$nom"
    if vhost_present "$nom"; then
        local cle; cle="$(printf '%s' "$nom" | tr '.-' '__')"
        haproxyctl vhost remove "$cle" >/dev/null || true
    fi
    # retirer réduit le nombre de vhosts : sans --allow-shrink la garde anti-dérive refusait et le nom restait servi.
    # En lot (synchroniser), un seul rechargement à la fin.
    if [ -z "${RELAIS_EN_LOT:-}" ]; then
        haproxyctl generate --allow-shrink >/dev/null && haproxyctl reload >/dev/null \
            || log "génération HAProxy refusée : $nom peut rester servi jusqu'au prochain « haproxyctl generate »"
    fi
    if [[ "$nom" == hall.* ]] && command -v secubox-halls-parc >/dev/null; then
        secubox-halls-parc retirer "https://$nom" >/dev/null || true
    fi
    log "relais retiré pour $nom (certificat conservé, DNS inchangé)"
}

# pair-de <box> : IP maillée du pair nommé <box> dans l'état du maillage (wg_mesh.json), seulement s'il y est UNE fois et que
# wg-mesh le connaît (pair_du_maillage). Lu par secubox-pilotage-vhost (#3126 R-L5-30 I1) : un admin.<box> n'est « tenu par le
# relais » que si sa route vise CETTE IP. Lecture seule.
cmd_pair_de() {
    local box="${1:-}" ip
    [[ "$box" =~ ^[a-z0-9-]{1,40}$ ]] && [[ "$box" != -* ]] || meurt "nom de box invalide"
    ip="$(python3 - "$WG_ETAT" "$box" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    ips = [p.get("mesh_ip") for p in d.get("peers") or [] if isinstance(p, dict) and p.get("name") == sys.argv[2]]
except (OSError, ValueError, AttributeError, TypeError):
    sys.exit(1)
if len(ips) != 1 or not isinstance(ips[0], str):
    sys.exit(1)
print(ips[0])
PY
)" || exit 1
    ip_valide "$ip" && pair_du_maillage "$ip" || exit 1
    printf '%s\n' "$ip"
}

cmd_etat() {
    python3 - "$ROUTES" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
r = {k: v for k, v in d.items() if isinstance(v, list) and str(v[0]).startswith("10.10.0.")}
print("\n".join(f"{k} → {v[0]}:{v[1]}" for k, v in sorted(r.items())) or "aucun nom relayé vers le maillage")
PY
}

# ── côté PAIR ────────────────────────────────────────────────────────────────
regle_nft() { printf 'iifname "wg-mesh" ip saddr %s tcp dport %s accept comment "secubox-relais"' "$1" "$2"; }

# Chaîne vivante qui porte les règles du relais : celle de nftables.conf.
# JAMAIS `nft -f "$NFT_CONF"` : le fichier commence par `flush ruleset` et
# rejouer efface les tables vivantes — bans sbxwaf, ensembles NAC, sortie tor
# (#1721, #1769). Le fichier sert au prochain démarrage ; la chaîne vivante
# est modifiée règle par règle.
chaine_vivante() {
    local t
    for t in secubox_filter filter; do
        nft list chain inet "$t" input >/dev/null 2>&1 && { printf 'inet %s input' "$t"; return 0; }
    done
    return 1
}
poser_a_chaud() {  # règle
    local ch; ch="$(chaine_vivante)" || return 0
    # shellcheck disable=SC2086
    nft list chain $ch 2>/dev/null | grep -qF -- "$1" && return 0
    # shellcheck disable=SC2086
    nft insert rule $ch "$1"
}
retirer_a_chaud() {  # règle
    local ch h; ch="$(chaine_vivante)" || return 0
    # shellcheck disable=SC2086
    nft -a list chain $ch 2>/dev/null | grep -F -- "$1" | sed -n 's/.*# handle \([0-9][0-9]*\)$/\1/p' \
        | while read -r h; do nft delete rule $ch handle "$h"; done || true   # absente : rien à retirer
}

cmd_ouvrir() {
    local relais="${1:-}" port="${2:-9080}"
    ip_valide "$relais" || meurt "IP maillée du relais invalide : « $relais »"
    port_valide "$port" || meurt "port invalide : « $port »"
    pair_du_maillage "$relais" || meurt "$relais n'est pas un pair de wg-mesh sur ce nœud"
    local regle; regle="$(regle_nft "$relais" "$port")"
    if grep -qF "$regle" "$NFT_CONF"; then
        log "pare-feu : déjà ouvert à $relais sur $port"
    else
        # Avant le `drop` terminal (une règle après lui ne sert à rien) ; à défaut
        # (#3130, gk1 : chaîne input en `policy drop` de secubox-hardening), juste
        # avant l'accolade fermante de cette chaîne. Validé par `nft -c` avant de
        # remplacer quoi que ce soit.
        python3 - "$NFT_CONF" "$regle" <<'PY'
import re, sys, shutil, time, subprocess, os
chemin, regle = sys.argv[1], sys.argv[2]
t = open(chemin).read()
lignes = t.splitlines(keepends=True)
out, fait = [], False
for l in lignes:
    if not fait and re.match(r"^[ \t]*drop[ \t]*$", l):
        out.append(l[: len(l) - len(l.lstrip())] + regle + "\n"); fait = True
    out.append(l)
if not fait:
    # première chaîne input en policy drop : la règle va en fin de chaîne, avant la politique
    out, dans, prof, politique, retrait = [], False, 0, False, "    "
    for l in lignes:
        if not fait and not dans and re.match(r"^[ \t]*chain[ \t]+input[ \t]*\{", l):
            dans, prof, politique = True, 0, False
        if dans and not fait:
            if re.search(r"\bpolicy[ \t]+drop\b", l):
                politique = True
                retrait = l[: len(l) - len(l.lstrip())]
            prof += l.count("{") - l.count("}")
            if prof == 0 and l.strip() == "}":
                if politique:
                    out.append(retrait + regle + "\n"); fait = True
                dans = False
        out.append(l)
if not fait:
    sys.exit("pas de drop terminal ni de chaîne input en policy drop dans " + chemin)
tmp = chemin + ".sbxtmp"
open(tmp, "w").write("".join(out))
if subprocess.run(["nft", "-c", "-f", tmp]).returncode != 0:
    os.unlink(tmp); sys.exit("nft -c refuse la règle")
shutil.copy2(chemin, f"{chemin}.avant-relais-{int(time.time())}")
os.replace(tmp, chemin)
PY
        log "pare-feu : $port ouvert au seul relais $relais"
    fi
    # Vivante aussi, même si le fichier l'avait déjà (répare une chaîne vidée).
    poser_a_chaud "$regle"
    local ligne="set_real_ip_from $relais;"
    if [ -f "$NGINX_CONF" ] && grep -qxF "$ligne" "$NGINX_CONF"; then
        log "nginx : le relais $relais est déjà cru"
    else
        { [ -f "$NGINX_CONF" ] || printf '# secubox-relais-maillage (#1670) : relais du maillage dont on croit X-Forwarded-For.\n'
          printf '%s\n' "$ligne"; } >> "$NGINX_CONF"
        nginx -t 2>/dev/null || { sed -i "\|^$ligne\$|d" "$NGINX_CONF"; meurt "nginx -t refuse $NGINX_CONF"; }
        systemctl reload nginx
        log "nginx : adresse de visiteur transmise par $relais crue"
    fi
}

cmd_fermer() {
    local relais="${1:-}" port="${2:-9080}"
    ip_valide "$relais" || meurt "IP maillée du relais invalide"
    local regle; regle="$(regle_nft "$relais" "$port")"
    if grep -qF "$regle" "$NFT_CONF"; then
        cp -p "$NFT_CONF" "$NFT_CONF.avant-relais-$(date +%s)"
        grep -vF "$regle" "$NFT_CONF" > "$NFT_CONF.sbxtmp" && nft -c -f "$NFT_CONF.sbxtmp" \
            && mv "$NFT_CONF.sbxtmp" "$NFT_CONF"
    fi
    retirer_a_chaud "$regle"
    [ -f "$NGINX_CONF" ] && sed -i "\|^set_real_ip_from $relais;\$|d" "$NGINX_CONF" && nginx -t 2>/dev/null && systemctl reload nginx
    log "fermé au relais $relais sur $port"
}

case "${1:-}" in
    relayer) shift; verrou_commun; cmd_relayer "$@" ;;
    retirer) shift; verrou_commun; cmd_retirer "$@" ;;
    pair-de) shift; verrou_commun; cmd_pair_de "$@" ;;   # sous le verrou commun (R-L5-31 M3)
    relayer-port) shift; cmd_relayer_port "$@" ;;
    retirer-port) shift; cmd_retirer_port "$@" ;;
    etat)    cmd_etat ;;
    ouvrir)  shift; cmd_ouvrir "$@" ;;
    fermer)  shift; cmd_fermer "$@" ;;
    synchroniser) verrou_commun; cmd_synchroniser ;;
    *) sed -n '8,23p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
