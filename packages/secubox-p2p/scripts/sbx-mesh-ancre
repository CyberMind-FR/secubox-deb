"""sbx-mesh-ancre rattraper [--dump FICHIER] — pose l'ancre du maître (#3100) sur une box déjà associée.

Une box jointe avant l'existence de l'ancre la reçoit ici, depuis le tunnel qu'elle a déjà : état local `role = satellite` et
UN SEUL pair WireGuard couvrant tout le réseau maillé (le maître). Sinon rien n'est écrit. Jamais d'écrasement.
Surcharges pour les tests : SBX_P2P_DIR, SBX_P2P_LIB, SBX_ANCRE, SBX_AUDIT."""
import ipaddress
import json
import os
import subprocess
import sys

sys.path.insert(0, os.environ.get("SBX_P2P_LIB", "/usr/lib/secubox/p2p"))
from api import ancre  # noqa: E402

ETAT = os.path.join(os.environ.get("SBX_P2P_DIR", "/var/lib/secubox/p2p"), "wg_mesh.json")
CHEMIN = os.environ.get("SBX_ANCRE", ancre.CHEMIN)
AUDIT = os.environ.get("SBX_AUDIT", "/var/log/secubox/audit.log")


def _dump(fichier):
    """Lignes de pairs de `wg show wg-mesh dump` (la 1re ligne, l'interface, est ignorée)."""
    if fichier:
        with open(fichier, encoding="utf-8") as f:
            texte = f.read()
    else:
        texte = subprocess.run(["wg", "show", "wg-mesh", "dump"], capture_output=True, text=True,
                               check=True, timeout=10).stdout
    return [l.split("\t") for l in texte.splitlines()[1:] if l.strip()]


def _couvre(allowed, reseau):
    for a in allowed.split(","):
        try:
            if reseau.subnet_of(ipaddress.ip_network(a.strip(), strict=False)):
                return True
        except ValueError:
            continue
    return False


def _hote(endpoint):
    """Hôte IPv4 d'un point d'accès `h:port` ; None si absent ou non IPv4."""
    hote = endpoint.rsplit(":", 1)[0]
    try:
        return hote if isinstance(ipaddress.ip_address(hote), ipaddress.IPv4Address) else None
    except ValueError:
        return None


def rattraper(fichier_dump=None):
    try:
        with open(ETAT, encoding="utf-8") as f:
            etat = json.load(f)
        pairs = _dump(fichier_dump)
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0
    if etat.get("role") != "satellite":
        return 0
    try:
        reseau = ipaddress.ip_network(etat.get("network") or "10.10.0.0/24", strict=False)
    except ValueError:
        return 0
    maitres = [p for p in pairs if len(p) >= 4 and _couvre(p[3], reseau)]
    if len(maitres) != 1:
        return 0
    cle, endpoint = maitres[0][0], maitres[0][2]
    adresse = _hote(endpoint)
    if not adresse:
        return 0
    nom = next((p.get("name") for p in etat.get("peers", []) if p.get("public_key") == cle and p.get("name")), "maitre")
    if ancre.ecrire(cle, adresse, nom, ancre.empreinte(cle), chemin=CHEMIN):
        ancre.audit("ancre_rattrapee", AUDIT, empreinte=ancre.empreinte(cle), adresse=adresse, nom=nom)
        print("ancre du maitre posee (%s)" % ancre.empreinte(cle))
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] != "rattraper":
        print("usage: sbx-mesh-ancre rattraper [--dump FICHIER]", file=sys.stderr)
        return 2
    dump = argv[argv.index("--dump") + 1] if "--dump" in argv and argv.index("--dump") + 1 < len(argv) else None
    return rattraper(dump)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
