"""sbx-mesh-invite : émet un jeton de jonction du maillage (root, sur le maître).

  sbx-mesh-invite                          URL de jonction (ancien comportement, jeton 64 hex)
  sbx-mesh-invite --code [--nom N] [--flash] [--ttl S] [--json]
                                           code `sbxmesh1.…` pour automesh ; --flash : ne vaut que
                                           pour le nom N et remplace la clé d'un pair de ce nom.

Le jeton n'est jamais écrit dans l'audit ; tokens.json reste au compte du service `secubox`."""
import argparse
import json
import os
import sys

sys.path.insert(0, "/usr/lib/secubox/p2p")
from api import automesh, jetons  # noqa: E402
from api.ancre import audit  # noqa: E402

VERSION = "2.0.0"
API_PORT = 7331


def _adresse_lan():
    """Même fonction que l'API (import tardif : tire FastAPI)."""
    from api import main
    return main.get_lan_ip()


def _rendre_au_service(dossier):
    """Lancée en root, la CLI laisserait tokens.json à root : le service `secubox` en tomberait en EACCES."""
    if os.geteuid() != 0:
        return
    try:
        import pwd
        u = pwd.getpwnam("secubox")
    except KeyError:
        return
    for racine, dirs, fichiers in os.walk(dossier):
        for n in [racine] + [os.path.join(racine, f) for f in fichiers]:
            try:
                os.chown(n, u.pw_uid, u.pw_gid)
            except OSError:
                pass


def main(argv=None):
    p = argparse.ArgumentParser(prog="sbx-mesh-invite", description=__doc__.splitlines()[0])
    p.add_argument("-a", "--auto-approve", action="store_true", default=True)
    p.add_argument("-m", "--manual-approve", action="store_true")
    p.add_argument("-t", "--ttl", type=int, default=jetons.DEFAUT_TTL, help="validité en secondes")
    p.add_argument("-i", "--ip", "--adresse", dest="adresse", help="adresse LAN du maître")
    p.add_argument("--code", action="store_true", help="émettre un code sbxmesh1.…")
    p.add_argument("--nom", help="nom prévu de la box (jeton lié à ce nom)")
    p.add_argument("--flash", action="store_true", help="jeton de reflash : remplace la clé du pair de ce nom")
    p.add_argument("--json", action="store_true")
    p.add_argument("-v", "--version", action="version", version=f"sbx-mesh-invite v{VERSION}")
    a = p.parse_args(argv)
    if a.flash and not a.nom:
        p.error("--flash exige --nom")
    if a.ttl <= 0:
        p.error("--ttl doit être positif")
    auto = not a.manual_approve

    adresse = a.adresse or _adresse_lan()
    try:
        # Le code d'abord : une adresse inutilisable ne doit pas laisser un jeton orphelin.
        automesh.encoder(str(adresse or ""), "0" * 64)
    except ValueError:
        print("sbx-mesh-invite : adresse du maître inutilisable (--adresse)", file=sys.stderr)
        return 1
    emis = jetons.generer(a.ttl, auto, nom_prevu=a.nom, flash=a.flash)
    _rendre_au_service(jetons.dossier_p2p())
    code = automesh.encoder(adresse, emis["token"])
    try:
        audit("code_emis", chemin=os.environ.get("SBX_AUDIT", "/var/log/secubox/audit.log"),
              nom=a.nom, ttl=a.ttl, flash=a.flash)
    except OSError as e:
        print(f"sbx-mesh-invite : audit non écrit ({e})", file=sys.stderr)

    if a.code and a.json:
        print(json.dumps({"code": code, "nom": a.nom, "expire": emis["expires"]}))
    elif a.code:
        print(code)
    else:
        print(f"Jeton : {emis['token']}\nExpire : {emis['expires']}\nAuto-approbation : {auto}")
        print(f"URL : http://{adresse}:{API_PORT}/master-link/?token={emis['token']}")
        print(f"Sur le pair : sbx-mesh-join {adresse} {emis['token']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
