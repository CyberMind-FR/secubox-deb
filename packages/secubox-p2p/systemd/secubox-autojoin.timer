[Unit]
Description=SecuBox — autojoin au démarrage puis toutes les 5 minutes (#3638)

[Timer]
OnBootSec=90s
OnActiveSec=90s
OnUnitActiveSec=5min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
