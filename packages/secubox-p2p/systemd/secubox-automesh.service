[Unit]
Description=SecuBox — jonction automatique au maillage (appel sortant vers le parent, #2475)
After=network-online.target secubox-p2p.service
Wants=network-online.target
ConditionPathExists=/var/lib/secubox/p2p/automesh.code

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-automesh
TimeoutStartSec=240
# root : la jonction écrit la configuration WireGuard et monte le tunnel (sbx-mesh-up). Le bac à sable borne le reste.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
