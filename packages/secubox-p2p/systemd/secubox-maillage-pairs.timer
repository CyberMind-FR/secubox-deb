[Unit]
Description=SecuBox — synchronisation des liens directs entre pairs (#3133)

[Timer]
OnBootSec=2min
# Depuis l'activation de la minuterie : OnUnitActiveSec seul ne se redéclenche pas après une réactivation.
OnActiveSec=2min
OnUnitActiveSec=1min
RandomizedDelaySec=10s
Persistent=true

[Install]
WantedBy=timers.target
