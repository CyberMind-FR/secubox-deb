[Unit]
Description=Publish wg-mesh handshakes every 20 s (liveness for /status, /peers)

# 20 s : bien sous le seuil de péremption du fichier (120 s) et sous celui de
# vivacité d'un pair (180 s). Plus fréquent n'apprendrait rien — WireGuard ne
# renégocie qu'environ toutes les deux minutes.
[Timer]
# #3355 : décalage aléatoire stable par box (FixedRandomDelay), pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=2s
FixedRandomDelay=true
AccuracySec=2s
OnBootSec=30s
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=30s
OnUnitActiveSec=20s
Unit=secubox-p2p-mesh-liveness.service

[Install]
WantedBy=timers.target
