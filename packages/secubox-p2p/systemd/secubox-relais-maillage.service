[Unit]
Description=SecuBox — relais du maillage : exposition par défaut des nœuds sans WAN (#1682)
After=network-online.target wg-quick@wg-mesh.service nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-relais-maillage synchroniser
# Émettre un certificat joker peut prendre quelques minutes (DNS-01).
TimeoutStartSec=15min
