[Unit]
Description=SecuBox — synchronisation horaire du relais du maillage (#1682)

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
