# /etc/secubox/peertube.toml — SecuBox PeerTube module configuration
#
# Operator-facing override of the package defaults. Edit values then run
# `peertubectl install` (first provision) or `peertubectl restart`.

# ── LXC ───────────────────────────────────────────────────────────────
[lxc]
name         = "peertube"
ip           = "10.100.0.120"
gateway      = "10.100.0.1"
bridge       = "br-lxc"
path         = "/data/lxc"
# Suite Debian du conteneur : celle de l'hôte (dernière stable, trixie
# aujourd'hui), jamais figée ici (#3285). Surcharge ponctuelle par
# l'environnement SECUBOX_DEBIAN_SUITE de l'installateur.

# ── PeerTube (native, inside the LXC) ─────────────────────────────────
[peertube]
http_port           = 9000     # PeerTube's own listen port inside the LXC
db_password_file    = "/etc/secubox/secrets/peertube-db"
secret_file         = "/etc/secubox/secrets/peertube-secret"
admin_email         = "admin@cybermind.fr"

# ── Public exposure (nginx vhost :9080 → LXC :9000; HAProxy SNI ACL) ──
[exposure]
# public_hostname = ""  # absent = <nom>.<domaine de la box>, jamais gk2 (#1723)
waf_inspect     = false        # video/uploads bypass the WAF (gitea pattern)

# ── Direct (live) et rediffusions (#3890) ─────────────────────────────
# `peertubectl direct activer` règle la section live de PeerTube par son API ;
# la minuterie secubox-peertube-rediffusions.timer efface chaque nuit les
# rediffusions plus vieilles que jours_conservation, sauf celles de la liste
# de lecture privée « À garder » (compte root).
[direct]
jours_conservation      = 7    # rediffusion gardée N jours, puis effacée (auditée)
duree_max_heures        = 6    # un direct oublié s'arrête seul ; 0 = illimité
directs_max_instance    = 2    # directs existants au plus sur l'instance
directs_max_utilisateur = 1    # directs existants au plus par compte
