# SPDX-License-Identifier: LicenseRef-CMSD-1.0
[Unit]
Description=Refresh the PeerTube transcoding backlog cache every 2 minutes

[Timer]
# #3355 : décalage aléatoire stable par box (FixedRandomDelay), pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=30s
FixedRandomDelay=true
OnBootSec=90s
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=90s
OnUnitActiveSec=2min
# The backlog only moves as fast as ffmpeg finishes a video — polling harder
# would just add lxc-attach churn on a box that is already CPU-tight.
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
