#!/usr/bin/env bash
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: peertubectl
# CyberMind — https://cybermind.fr
#
# PeerTube host-side controller. PeerTube runs NATIVELY in a Debian LXC
# (default 10.100.0.120 on br-lxc, peertube.service inside the container).
# The host nginx vhost proxies the public hostname to <LXC_IP>:9000.
#
# Conventions: docs/MODULE-GUIDELINES.md §7 (mirror of grafanactl/giteactl).

set -u

readonly VERSION="1.3.0"
readonly CONFIG_FILE="${SECUBOX_PEERTUBE_CONFIG:-/etc/secubox/peertube.toml}"
readonly INSTALL_LIB="${SECUBOX_INSTALL_LIB:-/usr/share/secubox/lib/peertube/install-lxc.sh}"

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

log()  { printf '%b[peertube]%b %s\n' "$GREEN" "$NC" "$*"; }
warn() { printf '%b[warn]%b %s\n'    "$YELLOW" "$NC" "$*" >&2; }
err()  { printf '%b[error]%b %s\n'   "$RED"    "$NC" "$*" >&2; }

# ── TOML config (best-effort, grep-style — same as giteactl/grafanactl) ──────
config_get() {
    local key="$1" default="${2:-}" raw=""
    if [ -f "$CONFIG_FILE" ]; then
        raw=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1)
    fi
    if [ -z "$raw" ]; then echo "$default"; return; fi
    local val
    val=$(echo "$raw" | cut -d= -f2- | sed 's/[[:space:]]*#.*$//' \
        | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | tr -d '"' | tr -d "'")
    [ -z "$val" ] && echo "$default" || echo "$val"
}

LXC_NAME=$(config_get "name" "peertube")
LXC_IP=$(config_get "ip" "10.100.0.120")
LXC_PATH=$(config_get "path" "/data/lxc")
HTTP_PORT=$(config_get "http_port" "9000")
PUBLIC_HOSTNAME=$(config_get "public_hostname" "$(secubox-domaine peertube)")

OPS_DIR="${SECUBOX_PEERTUBE_OPS_DIR:-/run/secubox/peertube/ops}"
# Results go in a SEPARATE dir from requests: the peertube-ops.path unit watches
# OPS_DIR with DirectoryNotEmpty=, so a result left in OPS_DIR would re-trigger
# process-ops in a loop (→ start-limit-hit). process-ops removes each request and
# writes its result here, leaving OPS_DIR empty so the watcher goes idle (#798).
RESULTS_DIR="${SECUBOX_PEERTUBE_RESULTS_DIR:-/run/secubox/peertube/results}"
ADMIN_SECRET="${SECUBOX_PEERTUBE_ADMIN_SECRET:-/etc/secubox/secrets/peertube-admin}"

# _write_result <id> <json-string> — atomic result file for the API to poll.
_write_result() {
    local id="$1" body="$2"
    mkdir -p "$RESULTS_DIR" 2>/dev/null || true
    printf '%s' "$body" > "$RESULTS_DIR/$id.result.json.tmp"
    chown root:secubox "$RESULTS_DIR/$id.result.json.tmp" 2>/dev/null || true
    chmod 0640 "$RESULTS_DIR/$id.result.json.tmp" 2>/dev/null || true
    mv -f "$RESULTS_DIR/$id.result.json.tmp" "$RESULTS_DIR/$id.result.json"
}

# _jq <file> <filter> — read a field from a request file (jq is available on the host).
_jq() { jq -r "$2" < "$1" 2>/dev/null; }

# _pt_token — OAuth access token for the root admin (HTTP API). The Host header
# MUST be the configured public_hostname: PeerTube 403s oauth-clients requests
# whose Host is the raw LXC IP. Password is passed via a 0600 temp file, never
# on the command line.
_pt_token() {
    local B="http://${LXC_IP}:${HTTP_PORT}" H="Host: ${PUBLIC_HOSTNAME}"
    local cl cid csec pwf at
    cl=$(curl -s --max-time 10 -H "$H" "$B/api/v1/oauth-clients/local") || return 1
    cid=$(printf '%s' "$cl" | jq -r '.client_id // empty')
    csec=$(printf '%s' "$cl" | jq -r '.client_secret // empty')
    [ -n "$cid" ] && [ -n "$csec" ] || { err "peertube oauth-clients failed (Host header / reachability?)"; return 1; }
    pwf=$(mktemp); chmod 600 "$pwf"; cat "$ADMIN_SECRET" > "$pwf" 2>/dev/null
    at=$(curl -s --max-time 10 -H "$H" -d client_id="$cid" -d client_secret="$csec" \
         -d grant_type=password -d username=root --data-urlencode "password@$pwf" \
         "$B/api/v1/users/token" | jq -r '.access_token // empty')
    rm -f "$pwf"
    [ -n "$at" ] || { err "peertube auth failed — stale admin secret? re-sync it"; return 1; }
    printf '%s' "$at"
}

# cmd_upload <file> <title> [channelId] [privacy] — upload a video file (on the
# HOST) to PeerTube. privacy: 1=public 2=unlisted 3=private 4=internal. Prints a
# JSON result with the watch URL. Used by the torrent "conserve to PeerTube" flow.
cmd_upload() {
    local file="${1:-}" title="${2:-}" channel="${3:-1}" privacy="${4:-2}"
    [ -n "$file" ] && [ -f "$file" ] || { err "usage: peertubectl upload <file> <title> [channelId] [privacy]"; return 1; }
    [ -n "$title" ] || title=$(basename "$file")
    local B="http://${LXC_IP}:${HTTP_PORT}" H="Host: ${PUBLIC_HOSTNAME}" at resp uuid url
    at=$(_pt_token) || return 1
    log "uploading $(basename "$file") to PeerTube (channel $channel, privacy $privacy)…"
    resp=$(curl -s --max-time 7200 -H "$H" -H "Authorization: Bearer $at" \
        -F name="$title" -F channelId="$channel" -F privacy="$privacy" \
        -F videofile=@"$file" "$B/api/v1/videos/upload")
    uuid=$(printf '%s' "$resp" | jq -r '.video.shortUUID // empty')
    [ -n "$uuid" ] || { err "upload failed: $resp"; return 1; }
    url="https://${PUBLIC_HOSTNAME}/w/$uuid"
    log "uploaded: $url"
    printf '{"status":"done","shortUUID":"%s","url":"%s"}\n' "$uuid" "$url"
}

# cmd_check_upgrade — non-destructive: installed (peertube-latest/package.json)
# vs the latest GitHub release. Prints JSON {current, latest, available, major_jump}.
# The actual upgrade is cmd_upgrade (via process-ops), already wired.
# Cache de la derniere version connue (#993, meme dispositif que Lyrion).
#
# `check-upgrade` interroge l'API GitHub. Appele depuis le chemin de requete du
# panneau, il le prendrait en otage a chaque affichage et le rendrait dependant
# d'une limite de debit GitHub ou d'une panne DNS. Le minuteur quotidien ecrit
# ici, le panneau lit.
readonly PT_VERSION_CACHE="${SECUBOX_PEERTUBE_VERSION_CACHE:-/var/cache/secubox/peertube/version.json}"

cmd_check_upgrade() {
    local cur latest available=false major=false
    cur=$(lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- sh -c 'cat /var/www/peertube/peertube-latest/package.json 2>/dev/null' 2>/dev/null | jq -r '.version // empty' 2>/dev/null)
    latest=$(curl -s --max-time 10 https://api.github.com/repos/Chocobozzz/PeerTube/releases/latest 2>/dev/null | jq -r '.tag_name // empty' | sed 's/^v//')
    if [ -n "$latest" ] && [ -n "$cur" ] && [ "$latest" != "$cur" ]; then
        available=true; [ "${latest%%.*}" != "${cur%%.*}" ] && major=true
    fi
    local payload
    payload=$(printf '{"current":"%s","latest":"%s","available":%s,"major_jump":%s,"checked_at":"%s"}' \
        "$cur" "${latest:-$cur}" "$available" "$major" "$(date -Is)")
    # Ecrit UNIQUEMENT si la version distante a reellement ete obtenue :
    # memoriser un « latest = current » issu d'un echec reseau ferait
    # disparaitre une mise a jour disponible du panneau, en silence.
    if [ -n "$latest" ]; then
        mkdir -p "$(dirname "$PT_VERSION_CACHE")" 2>/dev/null || true
        printf '%s\n' "$payload" > "$PT_VERSION_CACHE" 2>/dev/null || true
    fi
    printf '%s\n' "$payload"
}

# version-status — lit le cache, sans jamais sortir vers le reseau.
cmd_version_status() {
    local cur
    cur=$(lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- sh -c 'cat /var/www/peertube/peertube-latest/package.json 2>/dev/null' 2>/dev/null | jq -r '.version // empty' 2>/dev/null)
    if [ -r "$PT_VERSION_CACHE" ]; then
        python3 - "$PT_VERSION_CACHE" "${cur:-}" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
cur = sys.argv[2]
# Live d'abord (il peut refleter un upgrade que le cache ignore), cache
# ensuite, jamais le blanc : l'API tourne en `secubox` et ne peut pas
# interroger la LXC — sans repli le panneau afficherait un champ vide.
d["current"] = cur or d.get("current") or ""
latest = d.get("latest") or d["current"]
d["latest"] = latest
d["available"] = bool(latest and d["current"] and latest != d["current"])
d["cached"] = True
print(json.dumps(d))
PY
    else
        printf '{"current":"%s","latest":null,"available":false,"cached":false,"checked_at":null}\n' "${cur:-}"
    fi
}

# ── LXC helpers ───────────────────────────────────────────────────────────────
lxc_state() {
    lxc-info -n "$LXC_NAME" -P "$LXC_PATH" 2>/dev/null \
        | awk -F: '/^State:/ { gsub(/ /,"",$2); print tolower($2) }'
}
lxc_running() { [ "$(lxc_state)" = "running" ]; }
svc() { lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- systemctl "$@" peertube.service; }

# ── Verbs ─────────────────────────────────────────────────────────────────────
cmd_install() {
    if [ ! -x "$INSTALL_LIB" ] && [ ! -f "$INSTALL_LIB" ]; then
        err "install script not found at $INSTALL_LIB (package not installed correctly?)"
        exit 1
    fi
    log "Running LXC bootstrap from $INSTALL_LIB ..."
    SECUBOX_LXC_NAME="$LXC_NAME" SECUBOX_LXC_IP="$LXC_IP" SECUBOX_LXC_PATH="$LXC_PATH" \
    SECUBOX_PEERTUBE_HOSTNAME="$PUBLIC_HOSTNAME" \
        bash "$INSTALL_LIB" || { echo "[peertube] ERREUR : l'installation a échoué (voir ci-dessus) — rien n'est « fait » (#1729)" >&2; exit 1; }
    log "Done. Try 'peertubectl status' to verify, then wire the nginx vhost + HAProxy ACL."
}

cmd_status() {
    local state; state="$(lxc_state)"
    printf 'LXC %s        : %s\n' "$LXC_NAME" "${state:-absent}"
    if lxc_running; then
        local active; active="$(svc is-active 2>/dev/null || true)"
        printf 'peertube.service : %s\n' "${active:-unknown}"
        if curl -fsS -o /dev/null --max-time 3 "http://$LXC_IP:$HTTP_PORT/api/v1/config" 2>/dev/null; then
            printf 'HTTP %s:%s   : responding\n' "$LXC_IP" "$HTTP_PORT"
        else
            printf 'HTTP %s:%s   : NOT responding\n' "$LXC_IP" "$HTTP_PORT"
        fi
    fi
    printf 'public URL       : https://%s/\n' "$PUBLIC_HOSTNAME"
}

cmd_start()   { lxc_running || lxc-start -n "$LXC_NAME" -P "$LXC_PATH"; svc start;   log "started"; }
cmd_stop()    { lxc_running && svc stop || true;                                     log "stopped"; }
cmd_restart() { lxc_running || lxc-start -n "$LXC_NAME" -P "$LXC_PATH"; svc restart; log "restarted"; }
cmd_logs()    { lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- journalctl -u peertube -n "${1:-50}" --no-pager; }

cmd_reload() {
    if nginx -t 2>/dev/null; then
        systemctl reload nginx 2>/dev/null && log "host nginx reloaded" || warn "nginx reload failed"
    else
        err "nginx -t failed; not reloading"; exit 1
    fi
}

cmd_set_youtube_cookies() {
    # Install a Netscape-format cookies.txt (exported from a browser logged into
    # YouTube) so PeerTube's yt-dlp import can fetch YouTube videos. YouTube
    # hard-blocks server IPs ("Sign in to confirm you're not a bot") — cookies
    # are the only reliable workaround. Idempotent.
    local src="${1:-}"
    [ -n "$src" ] && [ -f "$src" ] || { err "usage: peertubectl set-youtube-cookies <cookies.txt>"; exit 1; }
    lxc_running || { err "LXC '$LXC_NAME' not running"; exit 1; }
    log "Installing YouTube cookies into $LXC_NAME ..."
    lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- bash -c '
        d=/var/www/peertube/storage/tmp-persistent
        install -d -o peertube -g peertube "$d"
        cat > "$d/youtube-cookies.txt"
        chown peertube:peertube "$d/youtube-cookies.txt"
        chmod 600 "$d/youtube-cookies.txt"
    ' < "$src"
    # Ensure the cookies feature is enabled in production.yaml.
    lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- python3 - <<'PY'
import re, pathlib
p = pathlib.Path('/var/www/peertube/config/production.yaml')
lines = p.read_text().splitlines()
ind = lambda s: len(s) - len(s.lstrip())
imp=vid=http=ck=False; chg=False
for i,l in enumerate(lines):
    if re.match(r'^import\s*:', l) and ind(l)==0: imp=True; vid=http=ck=False; continue
    if imp and l and ind(l)==0 and not l.startswith('#'): imp=vid=http=ck=False
    if imp and re.match(r'^\s+videos\s*:', l): vid=True; http=ck=False; continue
    if imp and vid and re.match(r'^\s+http\s*:', l): http=True; ck=False; continue
    if imp and vid and http and re.match(r'^\s+cookies\s*:', l): ck=True; continue
    if ck and re.match(r'^\s+enabled\s*:', l): lines[i]=l[:ind(l)]+'enabled: true'; ck=False; chg=True
p.write_text('\n'.join(lines)+'\n')
print('cookies enabled' if chg else 'cookies flag unchanged')
PY
    log "Cookies installed + enabled. Restarting PeerTube ..."
    svc restart
    log "Done. Retry the import from the PeerTube 'Import with URL' page."
}

cmd_process_ops() {
    # Root-only: the peertube-ops.path unit runs this when a request appears.
    [ -d "$OPS_DIR" ] || return 0
    local f id op
    for f in "$OPS_DIR"/*.request.json; do
        [ -e "$f" ] || continue
        id="$(basename "$f" .request.json)"
        op="$(_jq "$f" '.op')"
        case "$op" in
            ping)                 _write_result "$id" '{"status":"done","detail":"pong"}' ;;
            reset-admin-password) cmd_reset_admin_password "$f" "$id" ;;
            upgrade)              cmd_upgrade "$f" "$id" ;;
            *)                    _write_result "$id" "$(jq -nc --arg o "$op" '{status:"error",detail:("unknown op: "+$o)}')" ;;
        esac
        rm -f "$f"
    done
}

cmd_reset_admin_password() {
    # args: <request-file> <id>  (called by process-ops)
    local reqf="${1:-}" id="${2:-}"
    [ -n "$reqf" ] && [ -n "$id" ] || { err "usage: reset-admin-password <request-file> <id>"; return 1; }
    local pw; pw="$(_jq "$reqf" '.password')"
    [ -n "$pw" ] || { _write_result "$id" '{"status":"error","detail":"no password in request"}'; return; }
    lxc_running || { _write_result "$id" '{"status":"error","detail":"LXC not running"}'; return; }
    # PeerTube reset-password CLI is interactive (prompts once for the new
    # password). Feed it on stdin as the peertube user with the service's env.
    if printf '%s\n' "$pw" | lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- \
        sudo -u peertube env NODE_ENV=production NODE_CONFIG_DIR=/var/www/peertube/config \
        bash -lc 'cd /var/www/peertube/peertube-latest && npm run reset-password -- -u root' >/dev/null 2>&1
    then
        # Keep the dashboard's stored admin secret in sync (get_admin_token()).
        printf '%s' "$pw" > "$ADMIN_SECRET" && chmod 0600 "$ADMIN_SECRET"
        chown secubox:secubox "$ADMIN_SECRET" 2>/dev/null || true
        _write_result "$id" "{\"status\":\"done\",\"detail\":\"password reset\",\"password\":$(printf '%s' "$pw" | jq -Rs .)}"
    else
        _write_result "$id" '{"status":"error","detail":"peertube reset-password CLI failed"}'
    fi
}

cmd_upgrade() {
    # args: <request-file> <id>  (called by process-ops)
    # NOTE: `target` (from the request) is currently ignored — upgrade.sh always
    # fetches the latest PeerTube release; pinning to a specific target is not
    # wired up yet.
    local reqf="${1:-}" id="${2:-}"
    [ -n "$id" ] || { err "usage: upgrade <request-file> <id>"; return 1; }
    lxc_running || { _write_result "$id" '{"status":"error","detail":"LXC not running"}'; return; }
    _write_result "$id" '{"status":"running","detail":"backup + download"}'
    local ts; ts="$(date +%Y%m%d-%H%M%S)"
    local backup="/var/lib/secubox/peertube/backups/pre-upgrade-$ts.sql.gz"

    # 1. Mandatory DB backup (abort on failure). The backups dir is created by
    #    postinst on the HOST, but pg_dump runs INSIDE the LXC — that host path
    #    is not the same filesystem in the container, so ensure it exists there
    #    too before dumping (otherwise gzip silently writes to a missing dir).
    if ! lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- bash -lc \
        "install -d -o peertube -g peertube -m 0750 /var/lib/secubox/peertube/backups && sudo -u postgres pg_dump peertube_prod | gzip > '$backup'" 2>/dev/null; then
        _write_result "$id" "{\"status\":\"error\",\"detail\":\"DB backup failed — upgrade aborted\"}"
        return
    fi

    # 2-5. Run PeerTube's official upgrade inside the LXC. It downloads the latest
    #      release, installs deps, runs migrations, keeps the previous versions/
    #      dir (a failed run leaves peertube-latest on the old build), then asks
    #      for a restart (done in step 6).
    #      CWD MATTERS: PeerTube's v8 shim peertube-latest/scripts/upgrade.sh execs
    #      `../dist/scripts/upgrade.sh` RELATIVE to CWD, and that dist script runs
    #      `node -e "require('js-yaml')…"` whose module resolution is ALSO CWD-relative.
    #      Both resolve only when CWD is peertube-latest/scripts/ (../dist points there,
    #      and require() walks up to peertube-latest/node_modules). Running from
    #      /var/www/peertube fails "cannot open ../dist/scripts/upgrade.sh"; from a
    #      neutral dir it fails "Cannot find module 'js-yaml'". Output is captured so a
    #      failure is diagnosable (was previously discarded to /dev/null).
    local ulog="/run/secubox/peertube/upgrade-$id.log"
    if lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- \
        sudo -u peertube env NODE_ENV=production NODE_CONFIG_DIR=/var/www/peertube/config \
        bash -lc 'cd /var/www/peertube/peertube-latest/scripts && ./upgrade.sh' >"$ulog" 2>&1
    then
        # 6. Health-check: PeerTube answers /api/v1/config once back up.
        svc restart
        local ok=0
        for _ in $(seq 1 30); do
            if lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- \
                curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${HTTP_PORT}/api/v1/config" 2>/dev/null | grep -q 200
            then ok=1; break; fi
            sleep 2
        done
        if [ "$ok" = 1 ]; then
            _write_result "$id" "{\"status\":\"done\",\"detail\":\"upgraded\",\"backup\":$(printf '%s' "$backup" | jq -Rs .)}"
        else
            _write_result "$id" "{\"status\":\"error\",\"detail\":\"upgraded but health-check failed — restore from backup if needed\",\"backup\":$(printf '%s' "$backup" | jq -Rs .)}"
        fi
    else
        # Upgrade script failed — the old peertube-latest is untouched; restart it.
        # Surface the last lines of the captured log so the failure is diagnosable.
        svc restart
        local tail_err; tail_err="$(tail -n 3 "$ulog" 2>/dev/null | tr '\n\r' '  ')"
        _write_result "$id" "{\"status\":\"error\",\"detail\":$(printf 'upgrade script failed — running version unchanged: %s' "$tail_err" | jq -Rs .),\"backup\":$(printf '%s' "$backup" | jq -Rs .)}"
    fi
    rm -f "$ulog"
}

# Transcoding backlog — how many videos are still waiting, and how many of
# those have NO HLS playlist yet.
#
# That second number is the one that matters: with web_videos disabled,
# PeerTube only ever serves HLS, so a video without a playlist is not merely
# "not optimised" — it is unplayable. `peertubectl status` reports the LXC and
# the service, never this, so a full queue looked like a healthy instance.
#
# Read-only, single SQL round-trip, no ffprobe — safe to poll.
# Number of transcoding jobs really in flight: bull's queued/active/delayed
# states PLUS any live ffmpeg. Bull namespaces keys `bull-<hostname>:<queue>:
# <state>` — a `bull:*` scan matches nothing and would always read as "idle".
# Garde un entier, et seulement un entier (#3829) : `redis-cli`/`psql` peuvent
# rendre une ligne vide, un avertissement ou plusieurs lignes ; un `$(( ))` sur
# cette valeur plantait le script (« total + 0 : syntax error ») et `[ -gt ]`
# échouait (« integer expression expected »).
_entier() { local v; v=$(printf '%s' "$1" | tr -cd '0-9'); printf '%s' "${v:-0}"; }

# UN SEUL lxc-attach (#3829) : la version par file×état en lançait huit, chacun
# un redis-cli ; sous charge, le service dépassait son délai de 60 s. Toute la
# somme est calculée DANS le conteneur, une ligne rendue.
_jobs_in_flight() {
    local n ff
    n=$(lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- sh -c \
        "t=0
         for q in video-transcoding transcoding-job-builder; do
           for s in wait active delayed paused; do
             k=\"bull-${PUBLIC_HOSTNAME}:\$q:\$s\"
             ty=\$(redis-cli -n 0 type \"\$k\" 2>/dev/null)
             case \"\$ty\" in
               list) c=\$(redis-cli -n 0 llen \"\$k\" 2>/dev/null) ;;
               zset) c=\$(redis-cli -n 0 zcard \"\$k\" 2>/dev/null) ;;
               set)  c=\$(redis-cli -n 0 scard \"\$k\" 2>/dev/null) ;;
               *) c=0 ;;
             esac
             t=\$(( t + \${c:-0} ))
           done
         done
         printf '%s' \"\$t\"" 2>/dev/null)
    n=$(_entier "$n")
    ff=$(_entier "$(pgrep -c ffmpeg 2>/dev/null)")
    printf '%s' "$(( n + ff ))"
}

# Rows whose pendingTranscode counter says a job owns them.
_pending_counters() {
    local n
    n=$(printf '%s\n' 'select count(*) from "videoJobInfo" where "pendingTranscode" > 0;' \
        | lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- \
          env LC_ALL=C sh -c 'cd /tmp && su postgres -c "psql -q -d peertube_prod -tA -f -"' 2>/dev/null)
    printf '%s' "${n:-0}"
}

cmd_backlog() {
    if ! lxc_running; then
        printf '{"error":"lxc not running","states":[]}\n'
        return 1
    fi
    # Counters that outlive their jobs are the failure mode that silently
    # froze the whole queue (#943). Surface it HERE — in the panel and the
    # companion — rather than in a log nobody reads.
    local flight counters stuck=false
    flight=$(_jobs_in_flight)
    counters=$(_entier "$(_pending_counters)")
    flight=$(_entier "$flight")
    [ "$counters" -gt 0 ] && [ "$flight" -eq 0 ] && stuck=true
    local rows
    rows=$(printf '%s\n' "
select coalesce(json_agg(row_to_json(t)), '[]'::json) from (
  select v.state::int as state,
         count(*)::int as videos,
         (count(*) filter (where coalesce(h.n,0) = 0))::int as without_hls
  from video v
  left join (select \"videoId\", count(*) n from \"videoStreamingPlaylist\" group by \"videoId\") h
    on h.\"videoId\" = v.id
  group by v.state order by v.state
) t;" | lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- \
        env LC_ALL=C sh -c 'cd /tmp && su postgres -c "psql -q -d peertube_prod -tA -f -"' 2>/dev/null)
    [ -n "$rows" ] || rows='[]'
    printf '{"states":%s,"jobs_in_flight":%s,"pending_counters":%s,"stuck":%s}\n' \
        "$rows" "$flight" "$counters" "$stuck"
}

# Detect (and optionally clear) orphaned transcoding counters.
#
# PeerTube guards `POST /videos/{id}/transcoding` with
# videoJobInfo.pendingTranscode: non-zero means "a job already exists". That
# counter lives in postgres while the jobs themselves live in redis/bull. Lose
# redis — a crash, a flush, a container rebuild — and the counters survive with
# nothing left to decrement them. PeerTube then refuses every relaunch with
# 409 video_already_being_transcoded, forever, and the videos stay stuck in
# TO_TRANSCODE with no HLS playlist: unplayable, silently.
#
# Observed on gk2 2026-08-01: 109 videos pending, 0 bull keys.
#
# `unstick` reports the mismatch. `unstick --apply` clears the counters, and
# ONLY when the bull queue is genuinely empty — otherwise it would let a
# duplicate job be queued alongside a running one.
cmd_unstick() {
    local apply=0
    [ "${1:-}" = "--apply" ] && apply=1
    if ! lxc_running; then err "lxc not running"; return 1; fi

    local bull stuck
    bull=$(_jobs_in_flight)
    stuck=$(_pending_counters)

    log "jobs in flight (queued/active/ffmpeg) : $bull"
    log "rows with pendingTranscode > 0        : $stuck"

    if [ "$stuck" -eq 0 ]; then
        log "nothing stuck"
        return 0
    fi
    if [ "$bull" -ne 0 ]; then
        warn "$bull job(s) still in flight — these counters are legitimate, refusing to clear"
        return 1
    fi
    warn "$stuck orphaned counter(s): jobs are gone but PeerTube still thinks they run"
    if [ "$apply" -eq 0 ]; then
        log "re-run with --apply to clear them"
        return 0
    fi
    printf '%s\n' 'update "videoJobInfo" set "pendingTranscode"=0, "pendingMove"=0;' \
        | lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- \
          env LC_ALL=C sh -c 'cd /tmp && su postgres -c "psql -q -d peertube_prod -f -"' >/dev/null 2>&1
    log "counters cleared — relaunch transcoding from the webui or the PeerTube API"
}

# ── Transcodage ───────────────────────────────────────────────────────────
# Cette carte n'est pas une machine d'encodage : un seul thread, un Cortex-A53,
# et le meme processeur fait tourner le pare-feu. Une video d'1 h 41 en 1080p
# demande une quinzaine d'heures — et ffmpeg ne reprend jamais un encodage
# interrompu, donc chaque redemarrage annule tout le calcul deja fait.
#
# Le piege : mettre toutes les resolutions a `false` ne suffit PAS.
# `always_transcode_original_resolution` court-circuite cette liste et
# re-encode quand meme, a la resolution de la source. C'est lui qu'il faut
# eteindre.
cmd_transcodage() {
    local action="${1:-etat}"
    local yaml=/var/www/peertube/config/production.yaml

    case "$action" in
        etat)
            lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- sh -c "
                echo 'transcoding.enabled                     :' \$(grep -A2 '^transcoding:' $yaml | grep -oE 'enabled: (true|false)' | head -1 | awk '{print \$2}')
                echo 'always_transcode_original_resolution    :' \$(grep -oE 'always_transcode_original_resolution: (true|false)' $yaml | awk '{print \$2}')
                echo 'hls.enabled                             :' \$(grep -A2 '^  hls:' $yaml | grep -oE 'enabled: (true|false)' | head -1 | awk '{print \$2}')
                echo 'resolutions actives                     :' \$(sed -n '/^  resolutions:/,/^$/p' $yaml | grep -c ': true')
            "
            ;;
        off)
            log "extinction du transcodage : les videos seront servies telles quelles"
            lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- sh -c "
                cp -a $yaml $yaml.avant-transcodage-off
                sed -i 's/^\(\s*\)always_transcode_original_resolution: true/\1always_transcode_original_resolution: false/' $yaml
                sed -i '/^transcoding:/,/^live:/ s/^\(\s*\)enabled: true/\1enabled: false/' $yaml
            "
            log "sauvegarde : $yaml.avant-transcodage-off"
            svc restart && log "peertube redemarre"
            cmd_transcodage etat
            ;;
        on)
            log "reactivation du transcodage"
            lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- sh -c "
                [ -f $yaml.avant-transcodage-off ] && cp -a $yaml.avant-transcodage-off $yaml
            "
            svc restart && log "peertube redemarre"
            cmd_transcodage etat
            ;;
        *) err "usage: peertubectl transcodage {etat|off|on}"; return 1 ;;
    esac
}

# ── Entrée sans mot de passe par la session SecuBox (#1562) ─────────────────
# Le greffon peertube-plugin-secubox-sso ouvre un compte d'après
# X-Sbx-Peertube-User, que nginx pose après avoir vérifié la session et VIDE
# partout ailleurs. Sans cette garde nginx, n'importe quel client passerait
# l'en-tête par l'hôte : on n'installe donc RIEN tant que le vhost actif ne
# la porte pas (un vhost modifié localement garde l'ancienne version).
SSO_NPM="peertube-plugin-secubox-sso"
SSO_SRC="${SECUBOX_PEERTUBE_SSO_SRC:-/usr/share/secubox/peertube/$SSO_NPM}"
SSO_DANS="/var/www/peertube/sbx-plugins/$SSO_NPM"
DB_NAME=$(config_get "db_name" "peertube_prod")

pt_sql() {
    lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- env LC_ALL=C sh -c \
        'cd / && exec runuser -u postgres -- psql -qAt -v ON_ERROR_STOP=1 -d "$1" -c "$2"' _ "$DB_NAME" "$1"
}

sso_nom_ok() { printf '%s' "$1" | grep -Eq '^[a-z0-9._]{1,50}$'; }

# Une décision de sécurité = une ligne JSON dans le journal d'audit (append-only).
AUDIT_LOG="${SECUBOX_AUDIT_LOG:-/var/log/secubox/audit.log}"
audit() {   # action compte administrateur(true|false) resultat
    mkdir -p "$(dirname "$AUDIT_LOG")" 2>/dev/null || true
    printf '{"ts": "%s", "module": "peertube", "action": "%s", "compte": "%s", "administrateur": %s, "resultat": "%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" "$4" >> "$AUDIT_LOG" 2>/dev/null || true
}

# Rattache un compte ORDINAIRE (rôle 2) au greffon : il s'ouvre dès lors par la
# session SecuBox et plus par mot de passe. Jamais un modérateur, jamais un
# compte déjà rattaché à un autre greffon. Un ADMINISTRATEUR ne l'est que sur
# demande explicite (--administrateur, #3008) : la session SecuBox qui l'ouvre
# est celle de l'administrateur de la box, qui a déjà la main sur PeerTube par
# ce ctl ; l'automatisme de `sso` (comptes liés par l'Identity Manager) ne le
# fait jamais. Chaque rattachement est audité.
cmd_sso_rattache() {
    local nom="" admin=false a
    for a in "$@"; do
        case "$a" in
            --administrateur) admin=true ;;
            --*) err "option inconnue : $a"; return 1 ;;
            *) nom="$a" ;;
        esac
    done
    sso_nom_ok "$nom" || { err "nom invalide"; return 1; }
    local n garde="AND role = 2"
    $admin && garde="AND role IN (0, 2)"
    # Sans greffon actif, un compte rattaché n'aurait PLUS AUCUNE entrée.
    n=$(pt_sql "SELECT 1 FROM plugin WHERE name = 'secubox-sso' AND type = 1 AND enabled") || return 1
    [ "$n" = 1 ] || { warn "greffon secubox-sso inactif — $nom non rattaché"; return 0; }
    n=$(pt_sql "UPDATE \"user\" SET \"pluginAuth\" = '$SSO_NPM' WHERE username = '$nom' $garde AND \"pluginAuth\" IS NULL RETURNING username") || return 1
    local quoi="un compte ordinaire"
    $admin && quoi="un compte ordinaire ou administrateur"
    if [ -n "$n" ]; then
        audit sso-rattache "$nom" "$admin" rattache
        log "$nom : entrée par la session SecuBox ($quoi)"
    else
        audit sso-rattache "$nom" "$admin" inchange
        log "$nom : inchangé (absent, déjà rattaché, ou pas $quoi)"
    fi
}

# Retour arrière : le compte redevient un compte à mot de passe.
cmd_sso_detache() {
    local nom="${1:-}"; sso_nom_ok "$nom" || { err "nom invalide"; return 1; }
    pt_sql "UPDATE \"user\" SET \"pluginAuth\" = NULL WHERE username = '$nom' AND \"pluginAuth\" = '$SSO_NPM'" >/dev/null \
        && log "$nom : de nouveau par mot de passe"
}

cmd_sso() {
    lxc_running || { warn "conteneur arrêté — sso reporté"; return 0; }
    local vh
    vh=$(readlink -f /etc/nginx/sites-enabled/peertube.conf 2>/dev/null)
    if ! grep -q 'X-Sbx-Peertube-User ""' "$vh" 2>/dev/null; then
        warn "vhost sans garde X-Sbx-Peertube-User (voir $vh.dpkg-dist) — sso NON installé"
        return 0
    fi
    [ -f "$SSO_SRC/package.json" ] || { err "greffon absent : $SSO_SRC"; return 1; }
    local veut a
    veut=$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$SSO_SRC/package.json" | head -1)
    a=$(pt_sql "SELECT version FROM plugin WHERE name = 'secubox-sso' AND type = 1 AND enabled") || return 1
    if [ "$a" != "$veut" ]; then
        tar -C "$SSO_SRC" -cf - . | lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- sh -c \
            "rm -rf '$SSO_DANS' && mkdir -p '$SSO_DANS' && tar -C '$SSO_DANS' -xf - && chown -R peertube:peertube /var/www/peertube/sbx-plugins" || return 1
        lxc-attach -n "$LXC_NAME" -P "$LXC_PATH" -- env LC_ALL=C NODE_ENV=production \
            NODE_CONFIG_DIR=/var/www/peertube/config sh -c \
            "cd /var/www/peertube/peertube-latest && exec runuser -u peertube -- npm run -s plugin:install -- --plugin-path '$SSO_DANS'" \
            || { err "installation du greffon refusée"; return 1; }
        svc restart
        log "greffon $SSO_NPM $veut installé"
    fi
    # Les comptes PeerTube liés à une personne par l'Identity Manager.
    local nom
    for nom in $(python3 - <<'EOF'
import sqlite3
try:
    c = sqlite3.connect("file:/var/lib/secubox/sbxid/sbx.db?mode=ro", uri=True, timeout=2)
    for (n,) in c.execute("SELECT DISTINCT app_id FROM sbx_app_links WHERE app='peertube'"):
        print(n)
except sqlite3.Error:
    pass
EOF
    ); do
        sso_nom_ok "$nom" && cmd_sso_rattache "$nom"
    done
    return 0
}

# ── Direct (live) et rediffusions (#3890) ───────────────────────────────────
# Le direct se règle par l'API d'administration, jamais en éditant
# production.yaml : PeerTube écrit la configuration personnalisée dans
# local-production.json, qui l'emporte sur le YAML. On lit TOUTE la
# configuration (GET /api/v1/config/custom), on ne touche QUE `.live`, et on
# la renvoie entière (PUT : le validateur exige chaque champ).
#
# Noms vérifiés sur PeerTube v8.3.2 (pas l'OpenAPI, muette sur `live`) :
#   packages/models/src/server/custom-config.model.ts  (live.enabled,
#     live.allowReplay, live.maxDuration, live.maxInstanceLives,
#     live.maxUserLives, live.transcoding.enabled)
#   server/core/middlewares/validators/config.ts  (live.maxDuration isInt ;
#     checkInvalidLiveConfig : allowReplay=true exige transcoding.enabled=true,
#     le transcodage des VIDÉOS, pas celui du direct — sinon 400)
#   server/core/initializers/config.ts  (MAX_DURATION = parseDurationToMs :
#     millisecondes, -1 = illimité)
readonly LISTE_A_GARDER="À garder"
JOURS_CONSERVATION=$(config_get "jours_conservation" "7")
DUREE_MAX_HEURES=$(config_get "duree_max_heures" "6")
DIRECTS_MAX_INSTANCE=$(config_get "directs_max_instance" "2")
DIRECTS_MAX_UTILISATEUR=$(config_get "directs_max_utilisateur" "1")

# Une ligne JSON d'audit, construite par jq (un titre de vidéo peut porter des
# guillemets). Rend un code non nul si la ligne n'a pas pu être écrite.
audit_json() {   # objet JSON (sans ts ni module)
    local ligne
    ligne=$(jq -nc --argjson o "$1" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{ts: $ts, module: "peertube"} + $o') || return 1
    mkdir -p "$(dirname "$AUDIT_LOG")" 2>/dev/null || true
    printf '%s\n' "$ligne" >> "$AUDIT_LOG" 2>/dev/null
}

_entier_strict() { printf '%s' "$1" | grep -Eq '^[0-9]{1,6}$'; }

# Session d'API : jeton d'administrateur (_pt_token, même mécanisme que
# upload), posé dans un fichier d'en-têtes 0600 passé à curl par `-H @fichier`
# — le jeton n'apparaît jamais sur une ligne de commande ni à l'écran.
_PT_TMP=""
_pt_session() {
    local at
    at=$(_pt_token) || return 1
    _PT_TMP=$(mktemp -d) || return 1
    chmod 700 "$_PT_TMP"
    trap 'rm -rf -- "$_PT_TMP"' EXIT
    ( umask 077; printf 'Authorization: Bearer %s\n' "$at" > "$_PT_TMP/entetes" )
}

# _pt_appel <fichier-corps> <méthode> <chemin> [args curl…] — affiche le code
# HTTP (000 = injoignable) ; le corps de la réponse va dans <fichier-corps>.
_pt_appel() {
    local out="$1" meth="$2" chemin="$3"; shift 3
    curl -s --max-time 30 -o "$out" -w '%{http_code}' -X "$meth" \
        -H "Host: ${PUBLIC_HOSTNAME}" -H "@$_PT_TMP/entetes" "$@" \
        "http://${LXC_IP}:${HTTP_PORT}${chemin}" 2>/dev/null || true
}

_http_ok() { case "$1" in 2??) return 0 ;; *) return 1 ;; esac; }

# Identifiant de la liste « À garder » du compte root (vide si absente).
# GET /accounts/{name}/video-playlists rend aussi les listes privées quand le
# jeton est celui du propriétaire (listMyPlaylists, controllers/api/accounts.ts).
_liste_a_garder_id() {
    local start=0 total=1 code id f="$_PT_TMP/listes.json"
    while [ "$start" -lt "$total" ] && [ "$start" -lt 10000 ]; do
        code=$(_pt_appel "$f" GET "/api/v1/accounts/root/video-playlists?start=$start&count=100")
        _http_ok "$code" || { err "liste des listes de lecture : HTTP $code"; return 1; }
        id=$(jq -r --arg n "$LISTE_A_GARDER" \
            '[.data[]? | select(.displayName == $n) | .id] | first // empty' "$f") || return 1
        [ -n "$id" ] && { printf '%s' "$id"; return 0; }
        total=$(_entier "$(jq -r '.total // 0' "$f")")
        start=$(( start + 100 ))
    done
    return 0
}

cmd_direct() {
    local action="${1:-etat}"
    case "$action" in
        activer|etat) ;;
        *) err "usage: peertubectl direct {activer|etat}"; return 1 ;;
    esac
    if ! { _entier_strict "$DUREE_MAX_HEURES" && _entier_strict "$DIRECTS_MAX_INSTANCE" \
            && _entier_strict "$DIRECTS_MAX_UTILISATEUR"; }; then
        err "[direct] duree_max_heures / directs_max_* : entiers attendus"; return 1
    fi
    _pt_session || return 1
    local f="$_PT_TMP/config.json" code
    code=$(_pt_appel "$f" GET /api/v1/config/custom)
    if ! { _http_ok "$code" && jq -e '.live | type == "object"' "$f" >/dev/null 2>&1; }; then
        err "configuration de l'instance illisible : HTTP $code"; return 1
    fi

    if [ "$action" = etat ]; then
        local liste
        liste=$(_liste_a_garder_id) || return 1
        jq --arg liste "$liste" --argjson jours "$(_entier "$JOURS_CONSERVATION")" '{
            live: {enabled: .live.enabled, allowReplay: .live.allowReplay,
                   maxDuration: .live.maxDuration, maxInstanceLives: .live.maxInstanceLives,
                   maxUserLives: .live.maxUserLives,
                   transcoding: {enabled: .live.transcoding.enabled}},
            transcodage_videos: .transcoding.enabled,
            rediffusion_par_defaut: .defaults.live.saveReplay,
            liste_a_garder: ($liste != ""),
            jours_conservation: $jours}' "$f"
        return
    fi

    # La rediffusion exige le transcodage des vidéos : PeerTube refuserait le
    # PUT (400). Rien n'est écrit, et la section transcoding n'est pas la nôtre.
    if ! jq -e '.transcoding.enabled == true' "$f" >/dev/null; then
        err "la rediffusion exige transcoding.enabled = true (transcodage des vidéos) : PeerTube refuse sinon — rien n'est modifié"
        return 1
    fi
    local voulu="$_PT_TMP/voulu.json" ms=-1
    [ "$DUREE_MAX_HEURES" -gt 0 ] && ms=$(( DUREE_MAX_HEURES * 3600000 ))
    jq --argjson ms "$ms" --argjson i "$DIRECTS_MAX_INSTANCE" --argjson u "$DIRECTS_MAX_UTILISATEUR" '
        .live.enabled = true | .live.allowReplay = true
        | .live.transcoding.enabled = false
        | .live.maxDuration = $ms
        | .live.maxInstanceLives = $i | .live.maxUserLives = $u' "$f" > "$voulu" || return 1

    if jq -e --slurpfile a "$f" '. == $a[0]' "$voulu" >/dev/null; then
        log "direct déjà réglé — rien à écrire"
    else
        code=$(_pt_appel "$_PT_TMP/put.json" PUT /api/v1/config/custom \
            -H 'Content-Type: application/json' --data-binary "@$voulu")
        if ! _http_ok "$code"; then
            err "réglage du direct refusé : HTTP $code"
            audit_json '{"action":"direct-activer","resultat":"refuse"}' || true
            return 1
        fi
        audit_json "$(jq -c '{action: "direct-activer", resultat: "applique",
            live: {enabled: .live.enabled, allowReplay: .live.allowReplay,
                   maxDuration: .live.maxDuration, maxInstanceLives: .live.maxInstanceLives,
                   maxUserLives: .live.maxUserLives, transcoding: .live.transcoding.enabled}}' "$voulu")" \
            || warn "ligne d'audit non écrite ($AUDIT_LOG)"
        log "direct activé : rediffusion enregistrée, sans transcodage du direct"
    fi

    # La liste « À garder » (privée, compte root) : le seul geste qui sauve une
    # rediffusion de la purge. Créée si absente, jamais recréée.
    local liste
    liste=$(_liste_a_garder_id) || return 1
    if [ -z "$liste" ]; then
        code=$(_pt_appel "$_PT_TMP/liste.json" POST /api/v1/video-playlists \
            --form-string "displayName=$LISTE_A_GARDER" --form-string "privacy=3")
        _http_ok "$code" || { err "création de la liste « $LISTE_A_GARDER » : HTTP $code"; return 1; }
        audit_json '{"action":"direct-liste-a-garder","resultat":"creee"}' || warn "ligne d'audit non écrite"
        log "liste de lecture privée « $LISTE_A_GARDER » créée"
    fi
    return 0
}

# Purge des rediffusions de directs non gardées.
#
# Reconnaître une rediffusion : GET /api/v1/videos/{id}/live-session (OpenAPI
# « Get live session of a replay ») rend 200 et la session de direct quand la
# vidéo EST la rediffusion d'un direct (VideoLiveSessionModel.findSessionOfReplay,
# où replayVideoId = la vidéo), 404 « No live replay found » sinon
# (middlewares/validators/videos/video-live.ts, PeerTube v8.3.2). Une vidéo
# téléversée ou importée n'a pas de session : 404, jamais candidate.
# Un direct en cours a isLive = true (écarté à la liste ET ensuite), et une
# session sans endDate n'est pas terminée : écartée aussi.
#
# Âge : le plus récent de publishedAt et de la fin du direct (endDate) — une
# rediffusion d'un direct permanent est une vidéo neuve, celle d'un direct
# simple garde la date de publication du direct.
#
# Toutes les lectures d'abord ; le moindre échec d'API sort en erreur AVANT
# toute suppression.
cmd_rediffusions() {
    local action="${1:-}" simuler=false a
    [ "$action" = purger ] || { err "usage: peertubectl rediffusions purger [--simuler]"; return 1; }
    shift
    for a in "$@"; do
        case "$a" in
            --simuler) simuler=true ;;
            *) err "option inconnue : $a"; return 1 ;;
        esac
    done
    if ! { _entier_strict "$JOURS_CONSERVATION" && [ "$JOURS_CONSERVATION" -ge 1 ]; }; then
        err "[direct] jours_conservation : entier >= 1 attendu"; return 1
    fi
    if ! $simuler; then
        # Une suppression non auditée ne doit pas avoir lieu.
        mkdir -p "$(dirname "$AUDIT_LOG")" 2>/dev/null || true
        { [ -e "$AUDIT_LOG" ] && [ -w "$AUDIT_LOG" ]; } || { [ ! -e "$AUDIT_LOG" ] && [ -w "$(dirname "$AUDIT_LOG")" ]; } \
            || { err "journal d'audit non inscriptible ($AUDIT_LOG) — rien n'est effacé"; return 1; }
    fi
    _pt_session || return 1

    local liste code f="$_PT_TMP/page.json"
    liste=$(_liste_a_garder_id) || return 1
    [ -n "$liste" ] || { err "liste « $LISTE_A_GARDER » absente (peertubectl direct activer) — rien n'est effacé"; return 1; }

    # 1. Les vidéos gardées.
    local gardes="$_PT_TMP/gardes.txt" start=0 total=1
    : > "$gardes"
    while [ "$start" -lt "$total" ] && [ "$start" -lt 10000 ]; do
        code=$(_pt_appel "$f" GET "/api/v1/video-playlists/$liste/videos?start=$start&count=100")
        _http_ok "$code" || { err "liste « $LISTE_A_GARDER » illisible : HTTP $code — rien n'est effacé"; return 1; }
        jq -r '.data[]? | .video.uuid // empty' "$f" >> "$gardes" || return 1
        total=$(_entier "$(jq -r '.total // 0' "$f")")
        start=$(( start + 100 ))
    done

    # 2. Les vidéos locales hors direct, toutes confidentialités (privacyOneOf
    #    et include sont réservés aux administrateurs ; include=6 = mises sur
    #    liste noire + propriétaire bloqué ; pas NOT_PUBLISHED_STATE : une
    #    rediffusion encore en traitement n'est jamais touchée).
    local maintenant limite cands="$_PT_TMP/candidates.jsonl"
    maintenant=$(date -u +%s)
    limite=$(( JOURS_CONSERVATION * 86400 ))
    : > "$cands"
    start=0; total=1
    while [ "$start" -lt "$total" ] && [ "$start" -lt 100000 ]; do
        code=$(_pt_appel "$f" GET "/api/v1/videos?isLocal=true&isLive=false&nsfw=both&include=6&privacyOneOf=1&privacyOneOf=2&privacyOneOf=3&privacyOneOf=4&privacyOneOf=5&sort=-publishedAt&start=$start&count=100")
        _http_ok "$code" || { err "liste des vidéos : HTTP $code — rien n'est effacé"; return 1; }
        # Écarte d'emblée : direct, gardée, publiée depuis moins de N jours.
        jq -c --rawfile g "$gardes" --argjson now "$maintenant" --argjson lim "$limite" '
            ($g | split("\n") | map(select(. != ""))) as $gl
            | .data[]?
            | select(.isLive != true)
            | select(.uuid as $u | ($gl | index($u)) == null)
            | select((.publishedAt // "") != "")
            | select(($now - (.publishedAt | sub("\\.[0-9]+"; "") | fromdateiso8601)) > $lim)
            | {uuid, name, publishedAt}' "$f" >> "$cands" || { err "réponse illisible — rien n'est effacé"; return 1; }
        total=$(_entier "$(jq -r '.total // 0' "$f")")
        start=$(( start + 100 ))
    done

    # 3. Seules les rediffusions terminées, plus vieilles que N jours.
    local asup="$_PT_TMP/a-supprimer.jsonl" ligne uuid s="$_PT_TMP/session.json" v="$_PT_TMP/video.json"
    : > "$asup"
    while IFS= read -r ligne; do
        [ -n "$ligne" ] || continue
        uuid=$(printf '%s' "$ligne" | jq -r '.uuid')
        printf '%s' "$uuid" | grep -Eq '^[0-9a-fA-F-]{36}$' || { err "uuid inattendu — rien n'est effacé"; return 1; }
        code=$(_pt_appel "$s" GET "/api/v1/videos/$uuid/live-session")
        case "$code" in
            404) continue ;;                       # pas une rediffusion
            2??) ;;
            *) err "session de direct de $uuid : HTTP $code — rien n'est effacé"; return 1 ;;
        esac
        # La vidéo elle-même, relue : jamais un direct en cours.
        code=$(_pt_appel "$v" GET "/api/v1/videos/$uuid")
        _http_ok "$code" || { err "vidéo $uuid : HTTP $code — rien n'est effacé"; return 1; }
        jq -e '.isLive == true' "$v" >/dev/null 2>&1 && continue
        jq -c --slurpfile s "$s" --argjson now "$maintenant" --argjson lim "$limite" '
            ($s[0].endDate // null) as $fin
            | select($fin != null)
            | ([.publishedAt, $fin] | map(sub("\\.[0-9]+"; "") | fromdateiso8601) | max) as $t
            | select(($now - $t) > $lim)
            | {uuid, titre: ((.name // "") | .[0:60]), age_jours: ((($now - $t) / 86400) | floor)}' \
            <<<"$ligne" >> "$asup" || { err "session illisible — rien n'est effacé"; return 1; }
    done < "$cands"

    # 4. Suppression (ou simulation). Un échec arrête tout, en erreur.
    local n=0 sortie=0
    while IFS= read -r ligne; do
        [ -n "$ligne" ] || continue
        uuid=$(printf '%s' "$ligne" | jq -r '.uuid')
        if $simuler; then
            log "serait effacée : $(printf '%s' "$ligne" | jq -r '"\(.uuid) « \(.titre) » (\(.age_jours) j)"')"
            n=$(( n + 1 )); continue
        fi
        code=$(_pt_appel "$_PT_TMP/del.json" DELETE "/api/v1/videos/$uuid")
        if ! _http_ok "$code"; then
            err "suppression de $uuid refusée : HTTP $code — purge arrêtée"
            audit_json "$(printf '%s' "$ligne" | jq -c --arg c "$code" '{action: "rediffusion-supprimee", resultat: "echec", http: $c} + .')" || true
            sortie=1; break
        fi
        audit_json "$(printf '%s' "$ligne" | jq -c '{action: "rediffusion-supprimee", resultat: "supprimee"} + .')" \
            || warn "ligne d'audit non écrite pour $uuid"
        log "effacée : $(printf '%s' "$ligne" | jq -r '"\(.uuid) « \(.titre) » (\(.age_jours) j)"')"
        n=$(( n + 1 ))
    done < "$asup"
    jq -nc --argjson sim "$simuler" --argjson n "$n" --argjson j "$JOURS_CONSERVATION" \
        --slurpfile l "$asup" '{simulation: $sim, jours_conservation: $j, traitees: $n, rediffusions: $l}'
    return "$sortie"
}

cmd_help() {
    cat <<EOF
peertubectl $VERSION — SecuBox PeerTube (native-LXC) controller

Usage: peertubectl <verb> [args]

  install                       Provision the LXC + install PeerTube (idempotent)
  status                        LXC state + peertube.service + HTTP reachability
  start|stop|restart            Control peertube.service inside the LXC
  set-youtube-cookies <file>    Install browser-exported YouTube cookies.txt so
                                yt-dlp import works (YouTube blocks server IPs)
  logs [N]                      Tail N lines of peertube journal (default 50)
  backlog                       (json) videos per state + how many still lack an
                                HLS playlist — i.e. are not yet playable at all
  unstick [--apply]             Detect transcoding counters left behind by a lost
                                redis queue (PeerTube then 409s every relaunch);
                                --apply clears them, only if bull is empty
  upload <file> <title> [ch] [priv]  Upload a video to PeerTube (priv 2=unlisted)
  transcodage {etat|off|on}     Transcodage video. `off` eteint AUSSI
                                always_transcode_original_resolution,
                                que la liste des resolutions n'arrete pas
  direct {activer|etat}         Direct (live) par l'API d'administration : seule la
                                section live change (rediffusion, sans transcodage
                                du direct, durée et nombre plafonnés) ; crée la
                                liste privée « À garder ». etat : réglages en JSON
  rediffusions purger [--simuler]  Efface les rediffusions de directs de plus de
                                [direct] jours_conservation jours absentes de
                                « À garder » (auditées) ; --simuler n'efface rien
  reload                        Reload host nginx (after vhost changes)
  process-ops                   (root) drain the /run ops spool
  sso                           Entrée par la session SecuBox (greffon + comptes
                                liés ordinaires ; rien sans la garde du vhost)
  sso-rattache|sso-detache <n>  Un compte ordinaire : par la session / par mot de passe
      [--administrateur]        sso-rattache d'un administrateur, explicite et audité
  help                          This message

Config: $CONFIG_FILE  (name/ip/path/http_port/public_hostname)
LXC: $LXC_NAME @ $LXC_IP on br-lxc — public https://$PUBLIC_HOSTNAME/
EOF
}

main() {
    local noun="${1:-help}"; shift || true
    case "$noun" in
        install|status|start|stop|restart|logs|reload) "cmd_${noun}" "$@" ;;
        backlog) cmd_backlog "$@" ;;
        unstick) cmd_unstick "$@" ;;
        transcodage) cmd_transcodage "$@" ;;
        set-youtube-cookies) cmd_set_youtube_cookies "$@" ;;
        upload) cmd_upload "$@" ;;
        direct) cmd_direct "$@" ;;
        rediffusions) cmd_rediffusions "$@" ;;
        check-upgrade) cmd_check_upgrade "$@" ;;
        version-status) cmd_version_status ;;
        process-ops) cmd_process_ops "$@" ;;
        reset-admin-password) cmd_reset_admin_password "$@" ;;
        upgrade) cmd_upgrade "$@" ;;
        sso) cmd_sso ;;
        sso-rattache) cmd_sso_rattache "$@" ;;
        sso-detache) cmd_sso_detache "$@" ;;
        help|-h|--help) cmd_help ;;
        *) err "unknown verb: $noun"; cmd_help; exit 1 ;;
    esac
}

main "$@"
