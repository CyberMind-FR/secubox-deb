#!/bin/bash
set -e
case "$1" in
  configure)
    # Ensure secubox user exists
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home \
        --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    # Create runtime directories
    # NE JAMAIS chown un parent partagé : d'autres démons en dépendent.
    # On se contente de garantir le mode si le répertoire existe déjà.
    if [ -d /run/secubox ]; then chmod 1777 /run/secubox 2>/dev/null || true
    else install -d -m 1777 /run/secubox; fi
    install -d -o secubox -g secubox -m 755 /var/lib/secubox
    # Create data directories for picobrew
    install -d -o secubox -g secubox -m 755 /var/lib/secubox/picobrew
    install -d -o secubox -g secubox -m 755 /var/lib/secubox/picobrew/sensors
    install -d -o secubox -g secubox -m 755 /var/lib/secubox/picobrew/profiles
    install -d -o secubox -g secubox -m 755 /var/lib/secubox/picobrew/sessions
    install -d -o secubox -g secubox -m 755 /var/lib/secubox/picobrew/recipes
    install -d -o secubox -g secubox -m 755 /var/lib/secubox/picobrew/alerts
    # Create cache directory
    install -d -o secubox -g secubox -m 755 /var/cache/secubox/picobrew
    # Ensure nginx secubox.d directory exists
    install -d -m 755 /etc/nginx/secubox.d
    # Ensure config directory exists
    install -d -m 755 /etc/secubox
    # Enable and start service
    systemctl daemon-reload
    # Une unit masquée (ex: héritée d'une install précédente) ferait échouer
    # `enable` avec `set -e` actif et laisserait le paquet en état `iF`.
    # Démasquer explicitement, puis tolérer l'échec comme pour `start`.
    systemctl unmask secubox-picobrew.service 2>/dev/null || true
    systemctl enable secubox-picobrew.service || true
    systemctl start  secubox-picobrew.service || true
    # « Installer le paquet » active l'appareil : le provisionnement du conteneur
    # (debootstrap + clone picobrew_pico + venv + nginx/TLS, ~5-8 min, réseau)
    # est lancé EN ARRIÈRE-PLAN via --no-block pour ne PAS bloquer dpkg. Le
    # service oneshot est gardé par ConditionPathExists=!pinned-sha : il ne
    # provisionne qu'une fois, et devient un no-op ensuite.
    systemctl enable secubox-picobrew-provision.service 2>/dev/null || true
    systemctl start --no-block secubox-picobrew-provision.service 2>/dev/null || true
    # Reload nginx to pick up new location
    systemctl reload nginx 2>/dev/null || true
    # Le drop-in DNS est actif par défaut : le cloud PicoBrew est éteint
    # depuis 2020, la réécriture locale ne peut donc rien casser.
    # NB: `systemctl reload unbound` (SIGHUP) NE recharge PAS les local-zone —
    # seul `unbound-control reload` (ou un restart) applique le drop-in. On
    # préfère unbound-control quand il est configuré, sinon on retombe sur un
    # try-restart, sinon un reload en dernier recours (best-effort, jamais fatal).
    if command -v unbound-checkconf >/dev/null 2>&1 && unbound-checkconf >/dev/null 2>&1; then
        if command -v unbound-control >/dev/null 2>&1 && unbound-control status >/dev/null 2>&1; then
            unbound-control reload >/dev/null 2>&1 || true
        else
            systemctl try-restart unbound 2>/dev/null || systemctl reload unbound 2>/dev/null || true
        fi
    fi
    ;;
esac
#DEBHELPER#
