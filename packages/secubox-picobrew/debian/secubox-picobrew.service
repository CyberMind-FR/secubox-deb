[Unit]
Description=SecuBox PicoBrew Fermentation Controller API
After=network.target secubox-runtime.service
Requires=secubox-runtime.service

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/share/secubox/picobrew
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/picobrew.sock --workers 1
Restart=on-failure
RestartSec=5

# Security hardening
# NoNewPrivileges=no est requis ICI : le sudoers (debian/secubox-picobrew.sudoers)
# accorde au user secubox un sudo NOPASSWD vers picobrewctl. Avec
# NoNewPrivileges=yes, sudo serait neutralisé et cette seule surface
# privilégiée du module cesserait de fonctionner.
NoNewPrivileges=no

ProtectHome=read-only

ReadWritePaths=/run/secubox /var/lib/secubox /var/cache/secubox /etc/secubox

[Install]
WantedBy=multi-user.target
