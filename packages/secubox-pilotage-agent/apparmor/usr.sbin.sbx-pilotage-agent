# Profil AppArmor ENFORCE de sbx-pilotage-agent (#3126 ; L1 lecture, L2 actions par sudo).
# Posé dans /etc/apparmor.d/usr.sbin.sbx-pilotage-agent, chargé par le postinst.
# Tout ce qui n'est pas listé est refusé. Une seule écriture de fichier (L5 tâche 7) : la page d'état locale
# /run/secubox/pilotage/etat.html, par un fichier de travail au nom fixe renommé ; aucune
# capacité, aucune écoute : la connexion au maître est sortante seulement.
# Seul passage privilégié : sudo -> secubox-pilotagectl (sudoers à argv borné, validé par le ctl).

#include <tunables/global>

/usr/sbin/sbx-pilotage-agent {
  #include <abstractions/base>

  # --- Réseau : sortie vers le maître, jamais d'écoute (ni listen, ni accept).
  # bind : liaison de l'adresse de SORTIE du tunnel (IPSource), port éphémère.
  network (create, bind, connect, shutdown, getattr, setattr, getopt, setopt, send, receive) inet stream,
  # systemctl parle à systemd par la socket D-Bus ; netlink : adresses des interfaces (lecture).
  network (create, connect, shutdown, getattr, setattr, getopt, setopt, send, receive) unix stream,
  network netlink raw,

  # --- Le binaire lui-même et le seul programme lancé : systemctl (même profil).
  /usr/sbin/sbx-pilotage-agent mr,
  /usr/bin/systemctl rix,
  # L2 : le SEUL passage privilégié, sudo -> /usr/sbin/secubox-pilotagectl (sudoers.d/secubox-pilotage-agent), hors de
  # ce profil (Ux, comme secubox-netmodes et secubox-autoload) ; ce qu'il permet est borné par le sudoers et par le ctl.
  /usr/bin/sudo Ux,
  /usr/lib/systemd/** r,
  /etc/systemd/** r,
  /run/systemd/ r,
  /run/systemd/** r,
  /run/dbus/system_bus_socket rw,
  /sys/fs/cgroup/ r,
  # D-Bus système, limité au gestionnaire de systemd en lecture (précédent : secubox-profiles-releve).
  dbus send bus=system path=/org/freedesktop/DBus interface=org.freedesktop.DBus
       member={Hello,AddMatch,RemoveMatch,GetNameOwner,NameHasOwner,GetConnectionUnixUser} peer=(name=org.freedesktop.DBus),
  dbus send bus=system path=/org/freedesktop/systemd1{,/**}
       interface={org.freedesktop.DBus.Properties,org.freedesktop.systemd1.Manager}
       member={Get,GetAll,GetUnit,LoadUnit,ListUnitsByNames,ListUnitsByPatterns} peer=(name=org.freedesktop.systemd1),
  dbus receive bus=system peer=(name=org.freedesktop.systemd1),
  dbus receive bus=system peer=(name=org.freedesktop.DBus),
  /etc/localtime r,
  /etc/passwd r,
  /etc/nsswitch.conf r,

  # --- Sources de lecture : /proc (système, processus par comm, réseau, boot_id), /sys (réseau, carte).
  @{PROC}/ r,
  @{PROC}/** r,
  /sys/class/net/ r,
  /sys/class/net/** r,
  # Les liens de /sys/class/net/<if>/ se résolvent sous /sys/devices/**/net/<if>/ (adresse MAC).
  /sys/devices/**/net/** r,
  # /sys/class/dmi/id est un lien vers /sys/devices/virtual/dmi/id/ (x86 : modèle et fabricant).
  /sys/devices/virtual/dmi/id/{product_name,sys_vendor} r,
  # /proc/device-tree est un lien : AppArmor contrôle le chemin résolu (modèle de carte).
  /sys/firmware/devicetree/base/model r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,

  # --- Paquets, exposition, état du pilotage : fichiers nommés, lecture seule.
  /var/lib/dpkg/status r,
  /etc/nginx/sites-enabled/ r,
  /etc/nginx/sites-enabled/* r,
  /etc/nginx/sites-available/* r,
  # Réglages et drapeau : ouverts par descripteur, sans suivre de lien, root:root exigé (R36).
  /etc/secubox/pilotage-agent.env r,
  /etc/secubox/pilotage/mains-liees r,
  # L5 tâche 3 : portée du pilotage HTTP recalculée ici ; drapeau root lu comme le relais (dossier puis drapeau,
  # sans suivre de lien, root exigé).
  /etc/secubox-pilotage/ r,
  /etc/secubox-pilotage/mains-liees r,
  # R-L5-21 : échéances projetées par le ctl root (box du propriétaire, support ouvert), mêmes vérifications.
  /etc/secubox-pilotage/proprietaire r,
  /etc/secubox-pilotage/support-ouvert r,
  # L5 tâche 3 : la SEULE socket jointe, celle du relais local (0660, groupe secubox-pilotage-agent ; SO_PEERCRED
  # vérifié par le relais). Aucune socket de module : le relais seul les appelle, avec son jeton.
  /run/secubox/pilotage-relais.sock rw,
  /var/lib/secubox/profiles/actif r,

  # L5 tâche 7 : page d'état locale (statique, sans secret), régénérée toutes les 60 s. Dossier = RuntimeDirectory de
  # l'unité ; écriture atomique : fichier de travail ouvert sans suivre de lien, puis renommé sur la page.
  /run/secubox/pilotage/ r,
  /run/secubox/pilotage/.etat.html.tmp rw,
  /run/secubox/pilotage/etat.html w,

  # Les secrets restent interdits, quoi qu'une règle large ajoute un jour.
  deny /etc/secubox/secrets/** r,
  deny /etc/shadow r,
  # Jamais la ligne de commande ni l'environnement d'un processus (secrets possibles) : seulement comm/stat/statm.
  deny @{PROC}/[0-9]*/{cmdline,environ} r,
  deny /root/** rwx,
}
