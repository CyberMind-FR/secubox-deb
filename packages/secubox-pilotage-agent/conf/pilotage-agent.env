# Copier vers /etc/secubox/pilotage-agent.env pour modifier un réglage
# (lu par l'unité : EnvironmentFile=-/etc/secubox/pilotage-agent.env).
# Aucun secret ici.

# Adresse du maître dans le tunnel. Défaut : 10.10.0.1:8472 si wg-mesh porte une
# adresse en 10.10.0.0/24, sinon 10.64.0.1:8472 si wg-autoload porte une adresse
# en 10.64.0.0/16, sinon l'agent attend et revérifie toutes les 300 s.
# L'unité n'autorise que 10.10.0.1, 10.64.0.1 et localhost (IPAddressAllow).
#PILOTAGE_MAITRE=10.10.0.1:8472

# Échantillonnage des notifications, en secondes (défaut 30, minimum 5).
#PILOTAGE_RELEVE_INTERVALLE_S=30

# Seuils des notifications (valeurs positives ; défaut entre parenthèses).
#PILOTAGE_MEMOIRE_SEUIL_MO=200
#PILOTAGE_SWAP_SEUIL_PCT=80
#PILOTAGE_BOUCLE_RELANCES=3
#PILOTAGE_BOUCLE_FENETRE_S=600
