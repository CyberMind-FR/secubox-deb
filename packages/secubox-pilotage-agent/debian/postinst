# See LICENCE-CMSD-1.0.md for terms.
set -e
case "$1" in
  configure)
    if ! getent passwd secubox-pilotage-agent >/dev/null; then
      adduser --system --no-create-home --group secubox-pilotage-agent
    fi
    # Rien n'est créé ni modifié sous /etc/secubox (compte partagé secubox : un install -d de root y suivrait un lien, I1/R36).
    # Profil AppArmor (enforce) chargé AVANT le démarrage du service.
    if [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1; then
      apparmor_parser -r /etc/apparmor.d/usr.sbin.sbx-pilotage-agent \
        || echo "secubox-pilotage-agent : profil AppArmor non chargé (voir journalctl -k)" >&2
    fi
    # Arbre d'état root 0700 du ctl (consentements, mains liées) : avant le démarrage, l'unité l'ouvre en écriture.
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/secubox-pilotagectl.conf \
      || echo "secubox-pilotage-agent : /var/lib/secubox-pilotagectl non créé (systemd-tmpfiles)" >&2
    # L5 tâche 2 (R-L5-9, R-L5-13, R-L5-18) : relais local du pilotage délégué, sous son PROPRE compte, seul
    # lecteur de la clé privée (un agent compromis ne frappe pas de jeton lui-même). Arbres hors de /etc/secubox et
    # de /var/lib/secubox (comptes partagés) : root seul en a les parents, aucun lien ne peut y être planté.
    if ! getent passwd secubox-pilotage-relais >/dev/null; then
      adduser --system --no-create-home --group secubox-pilotage-relais
    fi
    install -d -o secubox-pilotage-relais -g secubox-pilotage-relais -m 0700 /var/lib/secubox-pilotage-relais
    install -d -o root -g root -m 0755 /etc/secubox-pilotage
    if [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1; then
      apparmor_parser -r /etc/apparmor.d/usr.sbin.sbx-pilotage-relais \
        || echo "secubox-pilotage-agent : profil AppArmor du relais non chargé (voir journalctl -k)" >&2
    fi
    # Clé privée créée (si absente) PAR LE COMPTE DU RELAIS, jamais lue ici ; la clé publique revient par un tube
    # et root la pose (root:root 0644), par renommage atomique. Rejouée à chaque configuration : concordance garantie.
    relais_pret=0
    if pub=$(runuser -u secubox-pilotage-relais -- /usr/sbin/sbx-pilotage-relais cle-publique); then
      case "$pub" in
        "-----BEGIN PUBLIC KEY-----"*"-----END PUBLIC KEY-----")
          tmp=$(mktemp /etc/secubox-pilotage/.relais.pub.XXXXXX)
          printf '%s\n' "$pub" > "$tmp"
          chown root:root "$tmp"
          chmod 0644 "$tmp"
          mv -f "$tmp" /etc/secubox-pilotage/relais.pub
          [ -s /etc/secubox-pilotage/relais.pub ] && relais_pret=1
          ;;
        *) echo "secubox-pilotage-agent : clé publique du relais illisible, non posée" >&2 ;;
      esac
    else
      echo "secubox-pilotage-agent : clé du relais non créée : aucun jeton délégué ne sera reconnu" >&2
    fi
    # Mise à niveau (R-L5-19) : le relais lit les mains liées dans l'arbre root ; l'état root du ctl y est projeté.
    if [ -e /var/lib/secubox-pilotagectl/mains-liees ]; then
      tmp=$(mktemp /etc/secubox-pilotage/.mains-liees.XXXXXX)
      chmod 0644 "$tmp"
      mv -f "$tmp" /etc/secubox-pilotage/mains-liees
    else
      rm -f /etc/secubox-pilotage/mains-liees
    fi
    # R-L5-21 : drapeaux de portée (proprietaire, support-ouvert) reprojetés de l'état root ; sans eux (montée de
    # version, redémarrage), une box cliente en support ouvert serait servie en lecture seule jusqu'au verbe suivant.
    /usr/sbin/secubox-pilotagectl etat >/dev/null 2>&1 \
      || echo "secubox-pilotage-agent : drapeaux de portée non reprojetés (pilotage HTTP en lecture)" >&2
    # Ajout des refus du relais à audit.log (ACL d'écriture seule, fichier vérifié ; reposée à chaque démarrage).
    if command -v setfacl >/dev/null 2>&1; then
      /usr/sbin/secubox-pilotage-relais-acl \
        || echo "secubox-pilotage-agent : ACL du journal d'audit non posée : les refus du relais iront au journal du service" >&2
    fi
    # Chroot d'image (pas de systemd en marche) : rien à activer ici.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      systemctl enable --now secubox-pilotage-agent.service || true
      # Minor 9 : sans clé publique posée, aucun module ne reconnaîtrait le jeton : la socket n'est pas ouverte
      # (configuration réussie quand même, code 0 : le reste du paquet fonctionne ; relancer dpkg-reconfigure).
      if [ "$relais_pret" = 1 ]; then
        systemctl enable --now secubox-pilotage-relais.socket || true
      else
        echo "secubox-pilotage-agent : relais NON activé (clé publique absente) ; corriger puis dpkg-reconfigure secubox-pilotage-agent" >&2
        systemctl disable --now secubox-pilotage-relais.socket 2>/dev/null || true
      fi
      # mise à jour : le nouveau binaire doit être relancé
      if [ -n "$2" ]; then
        systemctl restart secubox-pilotage-agent.service || true
        systemctl try-restart secubox-pilotage-relais.service || true
      fi
    fi
    ;;
esac
#DEBHELPER#
exit 0
