set -e
case "$1" in
  remove|purge)
    # Le profil n'est plus attaché à rien : on le décharge du noyau.
    if [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1; then
      apparmor_parser -R /etc/apparmor.d/usr.sbin.sbx-pilotage-agent 2>/dev/null || true
    fi
    ;;
esac
#DEBHELPER#
exit 0
