# vhost générique
server {
    listen 80 default_server;
    server_name _;
}
server {
    listen 443 ssl;
    server_name admin.gk5.secubox.in hub.gk5.secubox.in; # deux noms
}
server {
    listen 127.0.0.1:9080;
    server_name localhost;
}
server_names_hash_bucket_size 128;
server_name_in_redirect off;
