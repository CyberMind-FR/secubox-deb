# secubox-pilotage-agent (#3126, L2 « Agir ») : la SEULE voie d'action de l'agent, qui ne devient jamais root.
# Argv borné au ctl ; la validation complète (liste fermée de verbes, motifs entiers, politique, audit) vit dans
# /usr/sbin/secubox-pilotagectl (patron secubox-appstorectl). Jamais NOPASSWD: ALL, jamais un autre programme.
# consentement et mains-liees : refusés par le ctl quand l'appel vient de ce compte (local seulement).
secubox-pilotage-agent ALL=(root) NOPASSWD: /usr/sbin/secubox-pilotagectl *
