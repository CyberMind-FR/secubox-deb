[Unit]
Description=SecuBox — agent de pilotage distant (TR-369/USP)
Documentation=https://secubox.in
# L5 : après la socket du relais local (activation systemd), sans en dépendre (l'agent L1/L2 vit sans relais).
After=network-online.target wg-quick@wg-mesh.service wg-quick@wg-autoload.service secubox-pilotage-relais.socket
Wants=network-online.target

[Service]
Type=simple
User=secubox-pilotage-agent
Group=secubox-pilotage-agent
# Réglages : /etc/secubox/pilotage-agent.env est lu par l'agent lui-même, par descripteur et root:root seulement
# (R36). Pas d'EnvironmentFile= : systemd suivrait un lien déposé dans /etc/secubox par le compte partagé secubox.
AppArmorProfile=/usr/sbin/sbx-pilotage-agent
UMask=0027
ExecStart=/usr/sbin/sbx-pilotage-agent
Restart=on-failure
RestartSec=10
# L5 tâche 3 (R-L5-22 M3) : 48M (au lieu de 32M). RSS réel MESURÉ (VmHWM, GOGC par défaut, GOMEMLIMIT=32MiB) à
# 34,5 Mio pour un échange de 4 Mio aller et retour en parallèle de trois de 200 Kio (TestAgentRSSEchangesParalleles,
# plafond 40 Mio ; binaire de test, un peu plus lourd que l'agent) : ~13 Mio de marge. Tas : 23,3 Mio.
MemoryMax=48M
# M13 : borne souple du runtime Go, sous MemoryMax : le ramasse-miettes travaille avant le tueur du cgroup.
Environment=GOMEMLIMIT=32MiB

# Durcissement : connexion sortante vers le maître seulement ; l'agent lui-même n'a aucune capacité.
# NoNewPrivileges=no : seulement pour sudo. La seule action privilégiée de l'agent (L2, #3126) est
# `sudo -n /usr/sbin/secubox-pilotagectl <verbe> …` (sudoers.d/secubox-pilotage-agent ; argv validé en entier par le ctl).
# Avec NoNewPrivileges=yes, sudo serait neutralisé. ATTENTION — NE PAS AJOUTER ProtectKernelTunables, ProtectKernelModules,
# ProtectKernelLogs, RestrictSUIDSGID, LockPersonality, RestrictNamespaces, RestrictAddressFamilies, RestrictRealtime,
# PrivateDevices, SystemCallFilter, SystemCallArchitectures ni MemoryDenyWriteExecute : sous User= non root, chacun impose
# NoNewPrivileges par seccomp (précédents secubox-autoload, secubox-netmodes). Les familles réseau de l'agent restent
# bornées par son profil AppArmor enforce (inet stream qualifié, unix stream, netlink raw ; ni inet6 ni écoute).
NoNewPrivileges=no
AmbientCapabilities=
# Borne de ce que sudo et le ctl root peuvent obtenir DANS cette unité : sudo (setuid, setgroups, audit noyau) ;
# le ctl écrit /var/log/secubox/audit.log (secubox, 0640 ; le crée au compte secubox sur une box neuve : CAP_CHOWN)
# et lit /etc/secubox/modules.d ; `ancre-verifier` lit `wg show <interface> allowed-ips`, que le noyau réserve à
# CAP_NET_ADMIN même pour root (lecture seule : le ctl n'a aucun verbe qui modifie une interface).
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_NET_ADMIN
ProtectSystem=strict
ReadOnlyPaths=/
# Le ctl root lancé par sudo hérite de cet espace de montage : il n'y écrit que son état (arbre root 0700, tmpfiles.d
# du paquet ; « - » : absent, ignoré au lieu d'empêcher le démarrage) et le journal d'audit. Les opérations elles-mêmes
# passent par systemd-run (PID 1), hors de cette unité.
# /etc/secubox-pilotage (#3302) : drapeaux de portée reprojetés par le ctl (sudo, même espace de montage) après chaque
# verbe ; root 0755 : l'agent lui-même n'y écrit rien.
ReadWritePaths=/var/log/secubox -/var/lib/secubox-pilotagectl -/etc/secubox-pilotage
# L5 tâche 7 : page d'état locale /run/secubox/pilotage/etat.html, lue par nginx (gabarit « etat » du profil léger) :
# dossier propre à l'unité (vidé à son arrêt ; jamais /run/secubox lui-même, partagé), 0755, page 0644.
RuntimeDirectory=secubox/pilotage
RuntimeDirectoryMode=0755
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
IPAddressDeny=any
IPAddressAllow=10.10.0.1 10.64.0.1 localhost

[Install]
WantedBy=multi-user.target
