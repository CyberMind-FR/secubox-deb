[Unit]
Description=SecuBox — agent de pilotage distant (L1, lecture seule)
Documentation=https://secubox.in
After=network-online.target wg-quick@wg-mesh.service wg-quick@wg-autoload.service
Wants=network-online.target

[Service]
Type=simple
User=secubox-pilotage-agent
Group=secubox-pilotage-agent
EnvironmentFile=-/etc/secubox/pilotage-agent.env
AppArmorProfile=/usr/sbin/sbx-pilotage-agent
UMask=0027
ExecStart=/usr/sbin/sbx-pilotage-agent
Restart=on-failure
RestartSec=10
MemoryMax=32M

# Durcissement : connexion sortante vers le maître seulement, aucune capacité.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadOnlyPaths=/
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# AF_NETLINK : le runtime Go lit les adresses des interfaces par netlink (lecture seule, sans capacité).
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
IPAddressDeny=any
IPAddressAllow=10.10.0.1 10.64.0.1 localhost

[Install]
WantedBy=multi-user.target
