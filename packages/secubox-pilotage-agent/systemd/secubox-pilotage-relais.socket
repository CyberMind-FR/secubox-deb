#
# Socket du relais local du pilotage délégué (#3126 L5, tâche 2 ; R-L5-18). Créée par systemd : propriétaire, groupe
# et mode ci-dessous, sans rm, chgrp ni umask dans /run/secubox (partagé et collant). Seul le groupe de l'agent
# (secubox-pilotage-agent) peut s'y connecter ; le relais vérifie en plus SO_PEERCRED = uid de l'agent.
[Unit]
Description=SecuBox — socket du relais local du pilotage délégué (#3126)

[Socket]
ListenStream=/run/secubox/pilotage-relais.sock
SocketMode=0660
SocketUser=secubox-pilotage-relais
SocketGroup=secubox-pilotage-agent
Service=secubox-pilotage-relais.service
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
