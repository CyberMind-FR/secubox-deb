# Profil AppArmor ENFORCE de secubox-pilotage-api (#3126) : deux sockets Unix reçues de systemd, la base SQLite du module, l'audit, la lecture des tables
# d'identité des box. Tout ce qui n'est pas listé est refusé. Posé dans /etc/apparmor.d/secubox-pilotage-api, chargé par le postinst
# AVANT le (re)démarrage de l'unité.

#include <tunables/global>

/usr/sbin/secubox-pilotage-api {
  #include <abstractions/base>
  #include <abstractions/python>

  /usr/sbin/secubox-pilotage-api r,
  /usr/bin/python3* rix,
  /usr/lib/secubox/pilotage/** r,
  /usr/lib/secubox/ r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /usr/local/lib/python3*/** r,

  # Configuration et authentification (secubox_core) : fichiers nommés, jamais /etc/secubox/** (le dossier des secrets reste interdit).
  /etc/secubox/ r,
  /etc/secubox/secubox.conf r,
  /etc/secubox/users.json r,
  /etc/secubox/auth.toml r,
  /etc/secubox/appareils.json r,
  deny /etc/secubox/secrets/** r,
  # Registre des sessions : sans lui, toute garde d'API voit un registre vide et refuse (401 partout, #942).
  /var/lib/secubox/auth/ r,
  /var/lib/secubox/auth/sessions.json r,
  # Journaux communs : AJOUT SEUL (a). Un w pourrait tronquer le journal d'audit, dont la valeur probante tient à l'ajout seul.
  /var/log/secubox/delegation.log a,

  # Identité des box : table du maillage et projection publique des pairs Auto-Load, en lecture seule.
  /var/lib/secubox/p2p/ r,
  /var/lib/secubox/p2p/peers.json r,
  /var/lib/secubox/autoload-public/ r,
  /var/lib/secubox/autoload-public/pairs-publics.json r,

  # Données du module : base SQLite en WAL (verrous, fichier -shm projeté en mémoire, d'où k et m).
  /var/lib/secubox/pilotage/ r,
  /var/lib/secubox/pilotage/** rwkm,

  # Journal d'audit commun (le fichier appartient à secubox ; ACL au compte du service, ajout seul ici).
  /var/log/secubox/audit.log a,

  network unix,
}
