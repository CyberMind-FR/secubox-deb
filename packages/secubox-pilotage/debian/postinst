set -e
DONNEES=/var/lib/secubox/pilotage
AUDIT=/var/log/secubox/audit.log

case "$1" in
  configure)
    getent group secubox >/dev/null 2>&1 || addgroup --system secubox >/dev/null
    getent passwd secubox-pilotage >/dev/null || \
      adduser --system --no-create-home --home /nonexistent --group --shell /usr/sbin/nologin secubox-pilotage >/dev/null
    # Parents PARTAGÉS : créés seulement s'ils manquent, jamais resserrés ni réattribués.
    [ -d /run/secubox ] || install -d -o root -g root -m 1777 /run/secubox
    [ -d /var/log/secubox ] || install -d -m 0755 /var/log/secubox
    install -d -m 0755 /etc/secubox/pilotage

    # Dossier de données, sans systemd-tmpfiles (il refuse /var/lib/secubox/<module>/ : « unsafe path transition ») et sans suivre de lien :
    # un lien à cet emplacement est retiré (le lien seul, jamais sa cible), le dossier est créé neuf, puis réattribué par chown -h.
    [ -L /var/lib/secubox/pilotage ] && rm -f /var/lib/secubox/pilotage
    install -d -o secubox-pilotage -g secubox-pilotage -m 0750 /var/lib/secubox/pilotage
    chown -h secubox-pilotage:secubox-pilotage "$DONNEES"
    chmod 0750 "$DONNEES"

    # Journal d'audit commun : créé comme le fait secubox-core s'il manque (secubox:secubox 0640). Ni propriétaire ni droits ne changent ;
    # le service y ajoute des lignes par une ACL nominative (l'unité de l'écouteur la repose après chaque rotation).
    [ -e "$AUDIT" ] || install -m 0640 -o secubox -g secubox /dev/null "$AUDIT"
    if command -v setfacl >/dev/null 2>&1; then
      setfacl -m u:secubox-pilotage:rw- "$AUDIT" || echo "secubox-pilotage : ACL du journal d'audit non posée : l'audit des relevés échouera" >&2
    else
      echo "secubox-pilotage : setfacl absent : l'audit des relevés échouera (paquet acl)" >&2
    fi

    # AppArmor : profil ENFORCE chargé AVANT le démarrage, seulement si le noyau le permet.
    if [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1; then
      apparmor_parser -r /etc/apparmor.d/secubox-pilotage-api >/dev/null 2>&1 \
        || echo "secubox-pilotage : profil AppArmor non chargé (voir journalctl -k)" >&2
    fi

    # Écouteurs de tunnel et règles nft (seulement pour les interfaces présentes).
    /usr/sbin/secubox-pilotage-ecoute || echo "secubox-pilotage : écouteurs de tunnel non posés" >&2

    # Chroot d'image (pas de systemd en marche) : rien à activer ici.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      if nginx -t >/dev/null 2>&1; then systemctl reload nginx 2>/dev/null || true; fi
      systemctl enable --now secubox-pilotage.service || true
      systemctl enable --now secubox-pilotage-ecoute.path secubox-pilotage-ecoute.timer || true
      # mise à jour : le nouveau code et le nouveau profil doivent être pris
      if [ -n "$2" ]; then
        systemctl restart secubox-pilotage.service || true
      fi
    fi
    ;;
esac
#DEBHELPER#
exit 0
