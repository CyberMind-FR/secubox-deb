set -e
case "$1" in
  configure)
    getent group secubox >/dev/null 2>&1 || addgroup --system secubox >/dev/null
    getent passwd secubox-pilotage >/dev/null || \
      adduser --system --no-create-home --home /nonexistent --group --shell /usr/sbin/nologin secubox-pilotage >/dev/null
    # Parents PARTAGÉS : créés seulement s'ils manquent, jamais resserrés ni réattribués.
    [ -d /var/lib/secubox ] || install -d -m 0755 /var/lib/secubox
    [ -d /var/log/secubox ] || install -d -m 0755 /var/log/secubox

    # Dossier de données (0750, secubox-pilotage), par descripteur : sans systemd-tmpfiles (il refuse /var/lib/secubox/<module>/ : « unsafe path
    # transition ») et sans suivre de lien (le compte partagé secubox écrit dans le parent). Échec franc : le paquet ne se configure pas à moitié.
    python3 -I /usr/lib/secubox/pilotage/init_donnees.py /var/lib/secubox pilotage secubox-pilotage 750

    # Journal d'audit commun : créé comme le fait secubox-core s'il manque (secubox:secubox 0640). Ni propriétaire ni droits ne changent ; le
    # service y AJOUTE des lignes par une ACL nominative, posée par un assistant qui vérifie le fichier (pas un lien, un seul lien dur, propriétaire).
    [ -e /var/log/secubox/audit.log ] || install -m 0640 -o secubox -g secubox /dev/null /var/log/secubox/audit.log
    /usr/sbin/secubox-pilotage-audit-acl || echo "secubox-pilotage : ACL du journal d'audit non posée : l'audit des relevés échouera" >&2

    # nginx lie l'adresse des tunnels avant leur montée : ip_nonlocal_bind (même valeur que secubox-annuaire, qui n'est qu'un Recommends).
    sysctl -p /etc/sysctl.d/31-secubox-pilotage-nonlocal-bind.conf >/dev/null 2>&1 || true

    # AppArmor : profil ENFORCE chargé AVANT le démarrage, seulement si le noyau le permet.
    if [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1; then
      apparmor_parser -r /etc/apparmor.d/secubox-pilotage-api >/dev/null 2>&1 \
        || echo "secubox-pilotage : profil AppArmor non chargé (voir journalctl -k)" >&2
      apparmor_parser -r /etc/apparmor.d/secubox-pilotage-invite >/dev/null 2>&1 \
        || echo "secubox-pilotage : profil AppArmor de l'assistant de jonction non chargé (voir journalctl -k)" >&2
    fi

    # Écouteurs de tunnel et règles nft (seulement pour les interfaces présentes).
    /usr/sbin/secubox-pilotage-ecoute || echo "secubox-pilotage : écouteurs de tunnel non posés" >&2

    # Chroot d'image (pas de systemd en marche) : rien à activer ici.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      if nginx -t >/dev/null 2>&1; then systemctl reload nginx 2>/dev/null || true; fi
      # Les sockets d'abord (systemd les crée avec le bon propriétaire, groupe et mode), puis le service.
      systemctl enable --now secubox-pilotage.socket secubox-pilotage-canal.socket || true
      # Assistant de jonction (Rejoindre après un renommage, R-L2-35) : activé par socket, une instance par demande.
      systemctl enable --now secubox-pilotage-invite.socket || true
      systemctl enable --now secubox-pilotage.service || true
      systemctl enable --now secubox-pilotage-ecoute.path secubox-pilotage-ecoute.timer || true
      # mise à jour : le nouveau code et le nouveau profil doivent être pris
      if [ -n "$2" ]; then
        systemctl restart secubox-pilotage.service || true
      fi
    fi
    ;;
esac
#DEBHELPER#
exit 0
