# Socket d'canal des box (derrière l'écouteur nginx des IP de tunnel) du service Pilotage (#3126, R26). Créée par systemd : propriétaire, groupe et mode ci-dessous, sans rm, chgrp ni umask dans
# /run/secubox (partagé et collant). Le lanceur reçoit le descripteur (nom « canal »).
[Unit]
Description=SecuBox Pilotage — socket canal (#3126)

[Socket]
ListenStream=/run/secubox/pilotage-canal.sock
SocketMode=0660
SocketUser=secubox-pilotage
SocketGroup=www-data
FileDescriptorName=canal
Service=secubox-pilotage.service
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
