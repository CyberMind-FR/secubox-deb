# Écouteurs nginx du canal de pilotage sur les IP de tunnel, et règles nft associées (#3126). Root par nécessité (nginx, nft) ; unité
# oneshot appelée par le postinst, par secubox-pilotage-ecoute.path (wg-mesh / wg-autoload qui changent) et par la minuterie.
[Unit]
Description=SecuBox Pilotage — écouteurs du canal sur les tunnels (nginx, nft) (#3126)
After=network.target nginx.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-pilotage-ecoute
# L'ACL du service sur le journal d'audit commun : la rotation (create 0640 secubox secubox) recrée le fichier sans elle. ExecStopPost tourne aussi
# quand ExecStart échoue (nginx -t refusé, nft absent) : l'audit du service ne dépend pas de la réussite de l'écouteur. L'assistant vérifie le
# fichier (ordinaire, un seul lien, propriétaire secubox) et pose l'ACL sur le descripteur : jamais de lien suivi.
ExecStopPost=-/usr/sbin/secubox-pilotage-audit-acl
UMask=0027
# Socle § 10 sauf User= (nginx -t, nft et la réécriture de /etc/nftables.conf exigent root) ; exception écrite dans RULES-CODE.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# AF_NETLINK : nft et ip. Aucun socket IP dans l'unité : `nginx -t` (vraies sockets AF_INET, :80/:443, /run/nginx.pid) est lancé HORS de ce bac à
# sable par systemd-run (R30) ; le rechargement de nginx passe par D-Bus (AF_UNIX).
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# NET_ADMIN : nft ; DAC_READ_SEARCH : nginx -t lit clés et certificats ; DAC_OVERRIDE et FOWNER : fichiers d'autres comptes (journal d'audit, ACL).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
# /etc : conf.d de nginx et /etc/nftables.conf (fichier temporaire puis rename dans le même dossier) ; nginx : journal d'erreurs et temporaires
# de nginx -t ; /var/log/secubox : ACL du journal.
ReadWritePaths=/etc /var/log/nginx /var/lib/nginx /var/log/secubox
