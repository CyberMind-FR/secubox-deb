# Filet (#3126) : une interface qui monte sans toucher aux fichiers surveillés, ou une règle vive perdue (rechargement nft), est reprise
# au passage suivant. Le passage ne recharge nginx que si le rendu change.
[Unit]
Description=SecuBox Pilotage — reprise périodique des écouteurs de tunnel (#3126)

[Timer]
# #3355 : décalage aléatoire stable par box (FixedRandomDelay), pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=10s
FixedRandomDelay=true
OnBootSec=2min
OnUnitInactiveSec=5min
AccuracySec=30s
Unit=secubox-pilotage-ecoute.service

[Install]
WantedBy=timers.target
