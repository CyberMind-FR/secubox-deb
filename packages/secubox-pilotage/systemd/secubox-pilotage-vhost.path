[Unit]
Description=SecuBox Pilotage — plan des vhosts des box légères (#3126)

[Path]
PathChanged=/var/lib/secubox/pilotage/vhosts.json
# Aucune limite de déclenchement (R-L5-26 I2 : atteinte, elle mettrait ce .path en échec définitif) : le ctl espace lui-même ses passes
# (60 s au moins, attente hors verrou).
Unit=secubox-pilotage-vhost.service

[Install]
WantedBy=paths.target
