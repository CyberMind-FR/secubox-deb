# SecuBox Pilotage — maître du pilotage distant (#3126, L1 « Voir »). Un utilisateur À LUI, aucune capacité, aucun sudo, aucun réseau IP :
# deux sockets Unix servies par un seul processus (administration et canal des box). Les écouteurs TCP des IP de tunnel sont ceux de nginx
# (secubox-pilotage-ecoute), pas ceux de ce service.
[Unit]
Description=SecuBox Pilotage — maître du pilotage distant (#3126)
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox-pilotage
Group=secubox-pilotage
SupplementaryGroups=secubox
WorkingDirectory=/usr/lib/secubox/pilotage
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# /run/secubox est PARTAGÉ et collant (1777) : une socket périmée d'un autre propriétaire ne se retire qu'en root (« + »).
ExecStartPre=+/bin/rm -f /run/secubox/pilotage.sock /run/secubox/pilotage-canal.sock
ExecStart=/usr/sbin/secubox-pilotage-api
# Groupes des sockets (le service n'est membre ni de www-data ni de l'écouteur) : l'administration est lue par nginx et l'agrégateur
# (groupe secubox), le canal par nginx seul (groupe www-data). 0660 posé par le lanceur ; jamais 0666. « + » : en root, hors du profil AppArmor.
ExecStartPost=+/bin/sh -c 'for i in $(seq 1 100); do [ -S /run/secubox/pilotage.sock ] && [ -S /run/secubox/pilotage-canal.sock ] && break; sleep 0.1; done; chgrp secubox /run/secubox/pilotage.sock; chgrp www-data /run/secubox/pilotage-canal.sock'
Restart=on-failure
RestartSec=5
UMask=0027
LimitCORE=0

# Durcissement.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# Données du module, journal d'audit commun (le dossier : logrotate remplace le fichier par renommage) et sockets.
ReadWritePaths=/var/lib/secubox/pilotage /var/log/secubox /run/secubox
# Le dossier de données est créé par le postinst (systemd-tmpfiles refuse ces chemins : « unsafe path transition »).

[Install]
WantedBy=multi-user.target
