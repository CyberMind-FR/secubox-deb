# SecuBox Pilotage — maître du pilotage distant (#3126, L1 « Voir »). Un utilisateur À LUI, aucune capacité, aucun sudo, aucun réseau IP :
# deux sockets Unix servies par un seul processus (administration et canal des box). Les écouteurs TCP des IP de tunnel sont ceux de nginx
# (secubox-pilotage-ecoute), pas ceux de ce service.
[Unit]
Description=SecuBox Pilotage — maître du pilotage distant (#3126)
After=network.target secubox-core.service
Wants=secubox-core.service
Requires=secubox-pilotage.socket secubox-pilotage-canal.socket
After=secubox-pilotage.socket secubox-pilotage-canal.socket

[Service]
Type=simple
Sockets=secubox-pilotage.socket secubox-pilotage-canal.socket
User=secubox-pilotage
Group=secubox-pilotage
SupplementaryGroups=secubox
WorkingDirectory=/usr/lib/secubox/pilotage
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# Les deux sockets sont créées par systemd (secubox-pilotage.socket, secubox-pilotage-canal.socket) : propriétaire, groupe et mode y sont posés,
# le lanceur reçoit les descripteurs. Aucune écriture dans /run/secubox.
ExecStart=/usr/sbin/secubox-pilotage-api
Restart=on-failure
RestartSec=5
UMask=0027
LimitCORE=0

# Durcissement.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# Données du module et journal d'audit commun (le dossier : logrotate remplace le fichier par renommage ; AppArmor borne l'écriture à l'ajout).
ReadWritePaths=/var/lib/secubox/pilotage /var/log/secubox
# Le dossier de données est créé par le postinst (systemd-tmpfiles refuse ces chemins : « unsafe path transition »).

[Install]
WantedBy=multi-user.target
