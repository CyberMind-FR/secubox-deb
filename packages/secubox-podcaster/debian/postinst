#!/bin/bash
set -e

case "$1" in
  configure)
    # Data dirs (module-owned; never touch the shared /run/secubox parent, #494).
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/podcaster
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/podcaster/media

    # #761: the service used to run as root and created the DB + media files
    # root:root. It now runs as secubox, so reclaim ownership of any pre-existing
    # data — otherwise the unprivileged service can't read its own library.
    chown -R secubox:secubox /var/lib/secubox/podcaster 2>/dev/null || true

    # Config on first install only (preserve operator edits on upgrade).
    if [ ! -f /etc/secubox/podcaster.toml ]; then
      if [ -f /usr/share/secubox/podcaster/podcaster.toml ]; then
        install -o secubox -g secubox -m 0640 \
          /usr/share/secubox/podcaster/podcaster.toml /etc/secubox/podcaster.toml
      fi
    fi

    systemctl daemon-reload 2>/dev/null || true
    # Respect operator masking (set -e would abort on a masked enable).
    if [ "$(systemctl is-enabled secubox-podcaster.service 2>/dev/null)" != "masked" ]; then
      systemctl enable secubox-podcaster.service 2>/dev/null || true
      systemctl restart secubox-podcaster.service 2>/dev/null || true
    fi

    # Vhost podcaster.gk2 : on active le server-block (symlink) s'il est fourni.
    if [ -f /etc/nginx/sites-available/podcaster.gk2.conf ]; then
      ln -sf ../sites-available/podcaster.gk2.conf /etc/nginx/sites-enabled/podcaster.gk2.conf
    fi

    # ROUTE SBXWAF — POSEE PAR CE PAQUET, comme le vhost juste au-dessus.
    # C'est LE maillon qui manquait : HAProxy dirigeait bien l'hote vers
    # l'inspecteur et nginx servait bien le portail, mais sbxwaf ne
    # connaissait pas le nom et rendait 421. La route avait ete ajoutee une
    # fois a la main et vivait dans un fichier qu'aucun paquet ne possede --
    # meme sedimentation que les manifestes modules.d : invisible tant
    # qu'elle tient, fatale le jour ou elle saute (constate le 2026-09-23).
    #
    # Tant que le module etait `on-demand`, son absence ne se voyait pas :
    # sbxwaf trouvait le nom dans `on-demand-vhosts.json` et passait la main
    # au waker. Le module est passe `always-on` -- il n'y figure donc plus,
    # et il ne restait plus rien pour rattraper la route manquante.
    #
    # Motif repris de secubox-socialrelay : fusion IDEMPOTENTE, jamais une
    # reecriture de la table (272 routes y vivent, posees par d'autres).
    WAF_ROUTES="/etc/secubox/waf/haproxy-routes.json"
    if [ -f "$WAF_ROUTES" ] && command -v python3 >/dev/null 2>&1; then
      python3 - "$WAF_ROUTES" "podcaster.gk2.secubox.in" 9080 <<'SBXROUTE' || true
import json, os, sys
chemin, dom, port = sys.argv[1], sys.argv[2], int(sys.argv[3])
try:
    d = json.load(open(chemin))
    if not isinstance(d, dict):
        raise ValueError
except Exception:
    # ON N'ECRASE PAS UNE TABLE QU'ON N'A PAS SU LIRE : repartir d'un
    # dictionnaire vide couperait tous les autres services de la box.
    sys.exit(0)
# L'adresse est celle que la table emploie DEJA pour les vhosts nginx
# locaux : on lit un voisin plutot que d'imposer 127.0.0.1, que sbxwaf
# n'atteindrait pas si la table est ecrite pour l'IP de la board.
hote = "127.0.0.1"
for v in d.values():
    if isinstance(v, list) and len(v) == 2 and v[1] == port:
        hote = v[0]
        break
if d.get(dom) != [hote, port]:
    d[dom] = [hote, port]
    tmp = chemin + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(d, fh, indent=2, sort_keys=True)
    os.replace(tmp, chemin)
SBXROUTE
      # Rechargement seulement si sbxwaf tourne : il relit la table a chaud.
      if systemctl is-active --quiet secubox-waf-ng 2>/dev/null; then
        systemctl reload secubox-waf-ng 2>/dev/null || \
          systemctl restart secubox-waf-ng 2>/dev/null || true
      fi
    fi
    # Reload nginx only if the resulting config is valid.
    if command -v nginx >/dev/null 2>&1 && nginx -t 2>/dev/null; then
      systemctl reload nginx 2>/dev/null || true
    fi
    ;;
esac

#DEBHELPER#
exit 0
