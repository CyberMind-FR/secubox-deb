#!/bin/bash
set -e

# MIGRATION #3117 : le vhost était livré sous le nom de gk2. Idempotent.
#   $1 ancien nom de fichier  $2 nouveau nom  $3 ancien filtre d'exposition
#   (ou vide)  $4 nouveau filtre. L'ancien lien d'activation part ; l'ancien
# fichier part s'il est celui que le paquet avait livré (somme dpkg), sinon il
# est archivé dans /var/backups/nginx (0600) avec un avertissement : le fichier
# livré fait foi. Retourne 0 si l'ancien vhost était activé.
sbx_migrer_vhost() {
    _o="$1"; _n="$2"; _os="$3"; _ns="$4"; _act=1
    _av=/etc/nginx/sites-available; _en=/etc/nginx/sites-enabled
    _sn=/etc/nginx/snippets/exposure
    if [ -e "$_en/$_o" ] || [ -L "$_en/$_o" ]; then
        rm -f "$_en/$_o"; _act=0
    fi
    # Un lien posé à la main sous un AUTRE nom vers l'ancien fichier pendrait
    # une fois celui-ci retiré, et nginx -t échouerait pour toute la box.
    for _l in "$_en"/*; do
        [ -L "$_l" ] || continue
        case "$(readlink "$_l")" in
            "$_o"|*/"$_o") rm -f "$_l"; _act=0 ;;
        esac
    done
    if [ -f "$_av/$_o" ]; then
        _livre=$(dpkg-query -W -f='${Conffiles}\n' secubox-podcaster 2>/dev/null \
                 | awk -v f="$_av/$_o" '$1 == f { print $2 }')
        _actuel=$(md5sum "$_av/$_o" | cut -d' ' -f1)
        if [ "$_livre" != "$_actuel" ]; then
            # Retouché par l'administrateur (ou origine inconnue) : ses lignes
            # sont ARCHIVÉES, jamais recopiées sur le fichier livré — elles
            # citeraient l'ancien nom (et l'ancien filtre d'exposition) et
            # nginx -t échouerait. Le fichier livré fait foi.
            _arch="/var/backups/nginx/$_o.$(date +%Y%m%d-%H%M%S)"
            mkdir -p /var/backups/nginx
            if cp -p "$_av/$_o" "$_arch" && chmod 0600 "$_arch"; then
                echo "secubox-podcaster : l'ancien vhost $_o avait été modifié ; archivé dans $_arch, le fichier livré $_n est utilisé. Reportez-y vos retouches si besoin." >&2
            fi
        fi
        rm -f "$_av/$_o"
    fi
    # Le filtre d'exposition de l'opérateur suit le vhost.
    if [ -n "$_os" ] && [ -f "$_sn/$_os" ]; then
        if [ ! -f "$_sn/$_ns" ]; then mv -f "$_sn/$_os" "$_sn/$_ns"; else rm -f "$_sn/$_os"; fi
    fi
    return $_act
}

case "$1" in
  configure)
    # Data dirs (module-owned; never touch the shared /run/secubox parent, #494).
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/podcaster
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/podcaster/media

    # #761: the service used to run as root and created the DB + media files
    # root:root. It now runs as secubox, so reclaim ownership of any pre-existing
    # data — otherwise the unprivileged service can't read its own library.
    chown -R secubox:secubox /var/lib/secubox/podcaster 2>/dev/null || true
    # Six semaines en root (#1759) : médias et imports créés root:root sur le
    # SSD. Le service, repassé en secubox, doit pouvoir les relire et les
    # remplacer. Chemin résolu (media est un lien vers /data), jamais au-delà.
    for d in /data/secubox/podcaster "$(readlink -f /var/lib/secubox/podcaster/media 2>/dev/null)"; do
        case "$d" in /data/secubox/podcaster|/data/secubox/podcaster/*) ;; *) continue ;; esac
        [ -d "$d" ] && chown -R secubox:secubox "$d" 2>/dev/null || true
    done

    # Config on first install only (preserve operator edits on upgrade).
    if [ ! -f /etc/secubox/podcaster.toml ]; then
      if [ -f /usr/share/secubox/podcaster/podcaster.toml ]; then
        install -o secubox -g secubox -m 0640 \
          /usr/share/secubox/podcaster/podcaster.toml /etc/secubox/podcaster.toml
      fi
    fi

    systemctl daemon-reload 2>/dev/null || true
    # Respect operator masking (set -e would abort on a masked enable).
    if [ "$(systemctl is-enabled secubox-podcaster.service 2>/dev/null)" != "masked" ]; then
      systemctl enable secubox-podcaster.service 2>/dev/null || true
      systemctl restart secubox-podcaster.service 2>/dev/null || true
    fi

    # Vhost podcaster.<domaine> : on active le server-block (symlink) s'il est fourni.
    # #3117 : il s'appelait podcaster.gk2.conf (nom de gk2 livré à toutes les
    # boxes). L'ancien lien et l'ancien fichier partent juste avant que le
    # nouveau lien soit posé : aucun `nginx -t` ne passe entre les deux. Ce
    # postinst ne retire jamais le lien sur un échec de nginx -t.
    sbx_migrer_vhost podcaster.gk2.conf podcaster.conf "" "" || true
    if [ -f /etc/nginx/sites-available/podcaster.conf ]; then
      ln -sf ../sites-available/podcaster.conf /etc/nginx/sites-enabled/podcaster.conf
    fi

    # ROUTE SBXWAF — POSEE PAR CE PAQUET, comme le vhost juste au-dessus.
    # C'est LE maillon qui manquait : HAProxy dirigeait bien l'hote vers
    # l'inspecteur et nginx servait bien le portail, mais sbxwaf ne
    # connaissait pas le nom et rendait 421. La route avait ete ajoutee une
    # fois a la main et vivait dans un fichier qu'aucun paquet ne possede --
    # meme sedimentation que les manifestes modules.d : invisible tant
    # qu'elle tient, fatale le jour ou elle saute (constate le 2026-09-23).
    #
    # Tant que le module etait `on-demand`, son absence ne se voyait pas :
    # sbxwaf trouvait le nom dans `on-demand-vhosts.json` et passait la main
    # au waker. Le module est passe `always-on` -- il n'y figure donc plus,
    # et il ne restait plus rien pour rattraper la route manquante.
    #
    # Motif repris de secubox-socialrelay : fusion IDEMPOTENTE, jamais une
    # reecriture de la table (272 routes y vivent, posees par d'autres).
    WAF_ROUTES="/etc/secubox/waf/haproxy-routes.json"
    if [ -f "$WAF_ROUTES" ] && command -v python3 >/dev/null 2>&1; then
      python3 - "$WAF_ROUTES" "$(secubox-domaine podcaster 2>/dev/null || true)" 9080 <<'SBXROUTE' || true
import json, os, sys
chemin, dom, port = sys.argv[1], sys.argv[2], int(sys.argv[3])
if not dom:
    sys.exit(0)  # domaine de la box inconnu : aucune route plutôt qu'une route vide (#1723)
try:
    d = json.load(open(chemin))
    if not isinstance(d, dict):
        raise ValueError
except Exception:
    # ON N'ECRASE PAS UNE TABLE QU'ON N'A PAS SU LIRE : repartir d'un
    # dictionnaire vide couperait tous les autres services de la box.
    sys.exit(0)
# L'adresse est celle que la table emploie DEJA pour les vhosts nginx
# locaux : on lit un voisin plutot que d'imposer 127.0.0.1, que sbxwaf
# n'atteindrait pas si la table est ecrite pour l'IP de la board.
hote = "127.0.0.1"
for v in d.values():
    if isinstance(v, list) and len(v) == 2 and v[1] == port:
        hote = v[0]
        break
if d.get(dom) != [hote, port]:
    d[dom] = [hote, port]
    tmp = chemin + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(d, fh, indent=2, sort_keys=True)
    os.replace(tmp, chemin)
SBXROUTE
      # Rechargement seulement si sbxwaf tourne : il relit la table a chaud.
      if systemctl is-active --quiet secubox-waf-ng 2>/dev/null; then
        systemctl reload secubox-waf-ng 2>/dev/null || \
          systemctl restart secubox-waf-ng 2>/dev/null || true
      fi
    fi
    # Reload nginx only if the resulting config is valid.
    if command -v nginx >/dev/null 2>&1 && nginx -t 2>/dev/null; then
      systemctl reload nginx 2>/dev/null || true
    fi
    ;;
esac

#DEBHELPER#
exit 0
