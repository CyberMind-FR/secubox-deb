set -e

case "$1" in
    remove|purge)
        # Vhost podcaster.gk2 : on retire le symlink d'activation (le server-block
        # sous sites-available/ est un conffile géré par dpkg).
        rm -f /etc/nginx/sites-enabled/podcaster.gk2.conf || true
        if command -v nginx >/dev/null 2>&1 && nginx -t 2>/dev/null; then
            systemctl reload nginx 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#
exit 0
