[Unit]
Description=SecuBox Podcaster API
After=network.target secubox-runtime.service
Requires=secubox-runtime.service

[Service]
# Run unprivileged as secubox:secubox like every other module (CSPN: never
# root). UMask 0002 makes uvicorn create the Unix socket secubox:secubox with
# group-rw, so nginx (www-data, a member of the 'secubox' group) can connect.
# This removes the racy "sleep 1 + chown" ExecStartPost (#761): when uvicorn
# took >1s to bind, the chown ran before the socket existed, silently failed,
# and the socket stayed root:root → nginx "Permission denied" → 502 → the UI
# looked empty ("content disappeared"). Now the socket is owned correctly the
# instant it is created, with no timing window.
UMask=0002
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/share/secubox/podcaster
# Fallback if secubox-runtime hasn't created /run/secubox yet (+ runs as root).
ExecStartPre=+/bin/mkdir -p /run/secubox
# Remove any stale socket before binding. /run/secubox is sticky (1777), so an
# unprivileged secubox process cannot unlink a socket left behind by a previous
# root-owned run (uvicorn's own os.remove() would hit EPERM) — clear it as root.
ExecStartPre=+/bin/rm -f /run/secubox/podcaster.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/podcaster.sock --workers 1
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox

[Install]
WantedBy=multi-user.target
