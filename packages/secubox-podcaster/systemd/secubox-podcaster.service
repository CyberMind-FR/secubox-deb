[Unit]
Description=SecuBox Podcaster API
After=network.target secubox-runtime.service
Requires=secubox-runtime.service

[Service]
Type=simple
# NON PRIVILÉGIÉ (b513ecaf74, perdu dans les fusions du 2026-08-17 ; #1759).
# Le service a tourné en root six semaines sur un vhost public. UMask 0002 :
# uvicorn crée la socket secubox:secubox en rw de groupe, nginx (www-data,
# membre de secubox) s'y connecte — sans chown a posteriori ni fenêtre de course.
User=secubox
Group=secubox
UMask=0002
WorkingDirectory=/usr/share/secubox/podcaster
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/podcaster.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/podcaster.sock --workers 1
Restart=on-failure
RestartSec=5

# Security hardening
# NoNewPrivileges=no est REQUIS : le service ne lit ses deux secrets root
# (import PeerTube, cookies YouTube) que par `sudo -n podcasterctl`, limité
# par /etc/sudoers.d/secubox-podcaster à deux verbes sans argument.
NoNewPrivileges=no
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox

[Install]
WantedBy=multi-user.target
