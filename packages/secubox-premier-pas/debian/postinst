#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    # UNE BOX DÉJÀ EN SERVICE N'EST PAS UNE BOX NEUVE (#1522) — mais une mise à jour ne doit pas fermer un assistant EN COURS (#2727). La règle vit
    # dans premier_pas/en_service.py (testable) : admin ayant servi ET aucun profil en cours de remplissage. Dans une image en construction,
    # users.json n'existe pas encore (firstboot le crée) : l'assistant s'ouvrira au premier démarrage.
    if [ ! -e /var/lib/secubox/.premier-pas-fait ] \
       && PYTHONPATH=/usr/lib/secubox/premier-pas python3 -m premier_pas.en_service 2>/dev/null
    then
        mkdir -p /var/lib/secubox
        date -Is > /var/lib/secubox/.premier-pas-fait
        echo "secubox-premier-pas : box déjà configurée, assistant non ouvert"
    fi
    systemctl enable secubox-premier-pas.service >/dev/null 2>&1 || true
    systemctl enable --now secubox-premier-pas-appliquer.path >/dev/null 2>&1 || true
    # Face console sur tty1 : ne démarre que sur une box neuve (Condition).
    systemctl enable secubox-premier-pas-console.service >/dev/null 2>&1 || true
    # LA MINUTERIE DES MISES À JOUR SURVIT À NOTRE PROPRE MISE À JOUR (#1550).
    # dh_installsystemd --no-start ARRÊTE les unités du paquet pendant la mise à
    # jour et ne les relance pas : sur gk3, la minuterie est restée « dead »
    # après l'installation de 0.4.5 — plus aucune mise à jour la nuit, et c'est
    # majauto lui-même qui installe ce paquet. On la relance si le profil l'a
    # activée ; on ne l'active jamais d'office.
    if systemctl is-enabled --quiet secubox-majauto.timer 2>/dev/null; then
        systemctl start secubox-majauto.timer >/dev/null 2>&1 || true
    fi
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/premier-pas
    # API servie par l'agrégateur (comme la messagerie) : déclaration unique.
    python3 - <<'TOML' || echo "secubox-premier-pas : déclaration dans aggregator.toml impossible" >&2
import pathlib, re
f = pathlib.Path("/etc/secubox/aggregator.toml")
if f.exists():
    s = f.read_text()
    if '"premier-pas"' not in s:
        s = re.sub(r'modules\s*=\s*\[', 'modules = [\n    "premier-pas",', s, count=1)
        f.write_text(s)
        print("secubox-premier-pas : déclaré dans aggregator.toml")
TOML
    if [ -d /run/systemd/system ]; then
        systemctl restart secubox-aggregator >/dev/null 2>&1 || true
        # Box neuve dont le kiosque tourne déjà (lanceur d'avant #1542) : le
        # relancer pour qu'il ouvre l'assistant. Box configurée : on n'y touche pas.
        if [ ! -e /var/lib/secubox/.premier-pas-fait ] \
           && systemctl is-active --quiet secubox-kiosk.service; then
            systemctl restart secubox-kiosk.service >/dev/null 2>&1 || true
        fi
    fi
fi
#DEBHELPER#
exit 0
