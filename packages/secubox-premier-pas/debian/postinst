#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    # UNE BOX DÉJÀ EN SERVICE N'EST PAS UNE BOX NEUVE (#1522) — mais une mise à jour ne doit pas fermer un assistant EN COURS (#2727). La règle vit
    # dans premier_pas/en_service.py (testable) : admin ayant servi ET aucun profil en cours de remplissage. Dans une image en construction,
    # users.json n'existe pas encore (firstboot le crée) : l'assistant s'ouvrira au premier démarrage.
    if [ ! -e /var/lib/secubox/.premier-pas-fait ] \
       && PYTHONPATH=/usr/lib/secubox/premier-pas python3 -m premier_pas.en_service 2>/dev/null
    then
        mkdir -p /var/lib/secubox
        date -Is > /var/lib/secubox/.premier-pas-fait
        echo "secubox-premier-pas : box déjà configurée, assistant non ouvert"
    fi
    # KIOSQUE : l'ancienne unité `startx` de l'image RPi masque celle du paquet (#2738). On la retire (elle seule), puis on réactive le kiosque sous la nouvelle.
    # Le lien d'activation de l'ancienne unité (graphical.target.wants) pointe dans le vide une fois son fichier retiré : on le remplace. Le nettoyage est REJOUABLE :
    # un lien orphelin laissé par une configuration interrompue est traité même si l'unité n'est plus là. `set -e` : le code 10 de l'aide (« retirée ») n'est PAS une erreur.
    SYSD="${PREMIER_PAS_SYSTEMD_ETC:-/etc/systemd/system}"
    RETIRE="${PREMIER_PAS_RETIRE_UNITE:-/usr/sbin/premier-pas-retire-unite-kiosque}"
    KIOSQUE_ETAIT_ACTIF=0; KIOSQUE_ETAIT_ACTIVE=0; KIOSQUE_A_REFAIRE=0
    systemctl is-enabled --quiet secubox-kiosk.service 2>/dev/null && KIOSQUE_ETAIT_ACTIF=1
    systemctl is-active --quiet secubox-kiosk.service 2>/dev/null && KIOSQUE_ETAIT_ACTIVE=1
    "$RETIRE" "$SYSD/secubox-kiosk.service" && RC_RETIRE=0 || RC_RETIRE=$?
    [ "$RC_RETIRE" -eq 10 ] && KIOSQUE_A_REFAIRE=1
    if [ -L "$SYSD/graphical.target.wants/secubox-kiosk.service" ] && [ ! -e "$SYSD/secubox-kiosk.service" ]; then
        KIOSQUE_A_REFAIRE=1; KIOSQUE_ETAIT_ACTIF=1          # lien orphelin : le kiosque était activé, il doit le rester
    fi
    if [ "$KIOSQUE_A_REFAIRE" = 1 ]; then
        rm -f "$SYSD/graphical.target.wants/secubox-kiosk.service"
        systemctl daemon-reload >/dev/null 2>&1 || true
        if [ "$KIOSQUE_ETAIT_ACTIF" = 1 ]; then systemctl enable secubox-kiosk.service >/dev/null 2>&1 || true; fi
        systemctl reset-failed secubox-kiosk.service >/dev/null 2>&1 || true
        if [ "$KIOSQUE_ETAIT_ACTIVE" = 1 ] || [ "$KIOSQUE_ETAIT_ACTIF" = 1 ]; then systemctl restart secubox-kiosk.service >/dev/null 2>&1 || true; fi
    fi
    systemctl enable secubox-premier-pas.service >/dev/null 2>&1 || true
    systemctl enable --now secubox-premier-pas-appliquer.path >/dev/null 2>&1 || true
    # Face console sur tty1 : ne démarre que sur une box neuve (Condition).
    systemctl enable secubox-premier-pas-console.service >/dev/null 2>&1 || true
    # LA MINUTERIE DES MISES À JOUR SURVIT À NOTRE PROPRE MISE À JOUR (#1550).
    # dh_installsystemd --no-start ARRÊTE les unités du paquet pendant la mise à
    # jour et ne les relance pas : sur gk3, la minuterie est restée « dead »
    # après l'installation de 0.4.5 — plus aucune mise à jour la nuit, et c'est
    # majauto lui-même qui installe ce paquet. On la relance si le profil l'a
    # activée ; on ne l'active jamais d'office.
    if systemctl is-enabled --quiet secubox-majauto.timer 2>/dev/null; then
        systemctl start secubox-majauto.timer >/dev/null 2>&1 || true
    fi
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/premier-pas
    # API servie par l'agrégateur (comme la messagerie) : déclaration unique.
    python3 - <<'TOML' || echo "secubox-premier-pas : déclaration dans aggregator.toml impossible" >&2
import pathlib, re
f = pathlib.Path("/etc/secubox/aggregator.toml")
if f.exists():
    s = f.read_text()
    if '"premier-pas"' not in s:
        s = re.sub(r'modules\s*=\s*\[', 'modules = [\n    "premier-pas",', s, count=1)
        f.write_text(s)
        print("secubox-premier-pas : déclaré dans aggregator.toml")
TOML
    # Verdict LAN de l'ouverture distante (#2731) : posé ici pour cette route seulement, et SEULEMENT si le fichier GeoIP du Hub existe (sinon
    # `$lan_client` est inconnue et nginx -t casserait toute la configuration), si secubox-proxy.conf ne pose pas DÉJÀ la directive, et si nginx -t passe.
    # LE GARDE RECONNAÎT LA DIRECTIVE, PAS LA CHAÎNE (#1351, #2743) : `grep -q X-SecuBox-LAN` trouvait le COMMENTAIRE qui documente la ligne, concluait « déjà posée »
    # et retirait la route — la page distante répondait encore « pas du réseau local ».
    SESSION_D="${SECUBOX_NGINX_SECUBOX_D:-/etc/nginx/secubox.d}"
    SESSION_CONF="$SESSION_D/premier-pas-session.conf"
    SESSION_SRC="${PREMIER_PAS_SESSION_SOURCE:-/usr/share/secubox/premier-pas/nginx/premier-pas-session.conf}"
    if [ -f "${SECUBOX_LAN_GEO:-/etc/nginx/conf.d/secubox-lan-geo.conf}" ] && [ -d "$SESSION_D" ] \
       && ! grep -qE '^[[:space:]]*proxy_set_header[[:space:]]+X-SecuBox-LAN' "${SECUBOX_PROXY_SNIPPET:-/etc/nginx/snippets/secubox-proxy.conf}" 2>/dev/null; then
        install -m 644 "$SESSION_SRC" "$SESSION_CONF"
    else
        rm -f "$SESSION_CONF"
    fi
    if command -v nginx >/dev/null 2>&1; then
        if nginx -t >/dev/null 2>&1; then
            [ -d /run/systemd/system ] && systemctl reload nginx >/dev/null 2>&1 || true
        else
            rm -f "$SESSION_CONF"          # c'est peut-être lui qui casse : on le retire plutôt que de laisser nginx sans configuration valide
            echo "secubox-premier-pas : nginx -t échoue, route de session retirée" >&2
            if nginx -t >/dev/null 2>&1 && [ -d /run/systemd/system ]; then systemctl reload nginx >/dev/null 2>&1 || true; fi
        fi
    fi
    if [ -d /run/systemd/system ]; then
        systemctl restart secubox-aggregator >/dev/null 2>&1 || true
        # Box neuve dont le kiosque tourne déjà (lanceur d'avant #1542) : le
        # relancer pour qu'il ouvre l'assistant. Box configurée : on n'y touche pas.
        if [ ! -e /var/lib/secubox/.premier-pas-fait ] \
           && systemctl is-active --quiet secubox-kiosk.service; then
            systemctl restart secubox-kiosk.service >/dev/null 2>&1 || true
        fi
    fi
fi
#DEBHELPER#
exit 0
