[Unit]
Description=SecuBox Premier Pas — assistant du premier démarrage, face console (tty1) (#1522)
# Box neuve seulement ; le kiosque (tty7) et la console partagent le même profil.
ConditionPathExists=!/var/lib/secubox/.premier-pas-fait
# L'ASSISTANT MANUEL S'EFFACE DEVANT L'AUTO-LOAD (#2317) : une box qui porte un fichier de réponses signé se provisionne seule ; l'assistant en parallèle écrasait le nom et le réseau
# signés. OU l'un OU l'autre (« | ») : pas de fichier Auto-Load, ou bien l'agent a ABANDONNÉ (marqueur posé après 8 échecs) — l'assistant reprend alors la main au démarrage suivant.
ConditionPathExists=|!/boot/secubox/autoload/reponses.toml
ConditionPathExists=|/var/lib/secubox/autoload-agent/abandon.json
After=secubox-premier-pas.service
Conflicts=getty@tty1.service secubox-console.service

[Service]
Type=simple
ExecStart=/usr/sbin/premier-pas-console
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=TERM=linux LANG=C.UTF-8
# Terminé (ou quitté par F10) : la console de la box reprend tty1.
ExecStopPost=-/bin/systemctl --no-block start getty@tty1.service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
