#!/bin/sh
set -e

case "$1" in
    configure)
        # Create secubox system user/group if missing (idempotent, matches
        # sibling packages — see secubox-users/debian/postinst).
        getent group secubox >/dev/null || groupadd --system secubox
        getent passwd secubox >/dev/null || useradd --system --gid secubox \
            --home /var/lib/secubox --no-create-home --shell /usr/sbin/nologin secubox

        # #3302 : box déjà allégée (profil distante) avant 0.26.3 : le dossier d'état doit être traversable par l'agent de pilotage.
        if [ -d /var/lib/secubox-profiles ] && [ ! -L /var/lib/secubox-profiles ] && [ -f /var/lib/secubox-profiles/allegement/actif ]; then
            chmod 0711 /var/lib/secubox-profiles
        fi

        # /etc et /var/log sont à root : leurs enfants directs ne peuvent pas être remplacés par un lien du compte secubox.
        install -d -o secubox -g secubox -m 755 /etc/secubox

        # The actuator (api/actuate.py + snapshot.py + audit.py, driven both
        # by secubox-profilectl apply/rollback and by secubox-sleeper's
        # in-process STOPs) writes snapshot.SNAP_DIR and audit.AUDIT_LOG —
        # pre-create both here so a fresh board has them before the first
        # apply/sleep, regardless of unit sandboxing (secubox-sleeper.service
        # is deliberately NOT ProtectSystem=strict, see its unit file, but
        # these two leaves are needed either way). Shared parent
        # /var/log/secubox comes from secubox-core (0755 secubox:secubox) —
        # reasserted here matching the repo-wide shared-parent convention,
        # never narrowed to 0750.
        install -d -o secubox -g secubox -m 0755 /var/log/secubox
        # Relevé de validation (#3212) : compte dédié, sans shell ni capacité, pour secubox-profiles-releve ; dossier
        # setgid au groupe secubox (lecteurs : l'API et sbx-fleetctl, User=secubox), fichiers 0640 par UMask=0027.
        id -u secubox-profiles >/dev/null 2>&1 || \
          adduser --system --ingroup secubox --no-create-home --home /nonexistent \
            --shell /usr/sbin/nologin secubox-profiles >/dev/null

        # DOSSIERS ET PROFILS DE RÉFÉRENCE (#3218, relectures de #3248). /etc/secubox et /var/lib/secubox appartiennent
        # au compte secubox ; GNU `install -d` sur un dossier existant SUIT un lien et y fait chown et chmod : un
        # `profiles -> /etc/apt/apt.conf.d` posé par ce compte lui donnait le dossier, donc root. Les dossiers
        # /etc/secubox/{profiles,health,waf} et /var/lib/secubox/profiles/{rollback,validation} (snapshot.SNAP_DIR, relevé
        # #3212 : setgid secubox, compte secubox-profiles) sont créés ou réparés PAR DESCRIPTEUR, un lien est refusé.
        # Puis les profils de référence non modifiés (copie identique à une version livrée) sont mis à jour ; une copie
        # modifiée est gardée, la nouvelle référence posée en .dpkg-dist. Avant, ils n'étaient semés qu'une fois.
        PROPRIO=secubox:secubox PREPA=/etc python3 -I /usr/lib/secubox/profiles/maj-references.py --dossiers \
            || echo "secubox-profiles : dossiers ou profils de référence en échec (voir ci-dessus)" >&2
        # Profil AppArmor AVANT le démarrage du minuteur (l'unité le nomme). Système démarré seulement : dans le chroot
        # d'une image, apparmor.service le charge au premier démarrage depuis /etc/apparmor.d.
        if [ -d /run/systemd/system ] && [ -d /sys/kernel/security/apparmor ] \
           && command -v apparmor_parser >/dev/null 2>&1 && [ -f /etc/apparmor.d/secubox-profiles-releve ]; then
            apparmor_parser -r /etc/apparmor.d/secubox-profiles-releve \
              || echo "secubox-profiles : profil AppArmor secubox-profiles-releve non chargé : le relevé de validation ne tournera pas (apparmor_parser -r /etc/apparmor.d/secubox-profiles-releve ; journalctl -k)" >&2
        fi

        # Own dedicated socket, own service — never served by the aggregator
        # (the profile engine must not depend on something it may later
        # restart). Restart (not just enable) so an upgrade picks up new code.
        systemctl daemon-reload

    # LES MINUTERIES DE GABARIT S'ACTIVENT A LA MAIN (#1028). dh_installsystemd
    # ne reconnait pas les instances `unite@instance.timer` : il installe les
    # fichiers et n'en active aucun. Constate au deploiement — les deux
    # minuteries etaient `disabled / inactive` apres un dpkg -i reussi, ce qui
    # aurait reproduit, une fois de plus, le defaut corrige ici : un mecanisme
    # livre qui ne s'execute jamais.
    #
    # CE QUE LE PROFIL ACTIF COUPE RESTE COUPÉ (#3218, relecture #3248). Le profil minimal arrête ces minuteries
    # (minuteurs_off) et l'API du panneau (proteges_off) : les réactiver ici les rallumait à chaque mise à jour, donc
    # chaque nuit (majauto). `secubox-profilectl coupe` rend 0 si le profil actif coupe l'unité ; tout autre code
    # (aucun profil actif, profil illisible) garde le comportement d'avant.
    for _m in metacatalog jitsi; do
      if /usr/sbin/secubox-profilectl coupe "secubox-cache-warm@${_m}.timer" >/dev/null 2>&1; then
        echo "secubox-profiles : secubox-cache-warm@${_m}.timer coupée par le profil actif, laissée arrêtée" >&2
      else
        systemctl enable --now "secubox-cache-warm@${_m}.timer" >/dev/null 2>&1 || true
      fi
    done
        if /usr/sbin/secubox-profilectl coupe secubox-profiles.service >/dev/null 2>&1; then
            echo "secubox-profiles : API du panneau coupée par le profil actif (proteges_off), ni activée ni redémarrée" >&2
        else
            systemctl enable secubox-profiles.service 2>/dev/null || true
            systemctl restart secubox-profiles.service 2>/dev/null || true
        fi

        # secubox-waker (ref #896, scale-to-zero): safe to enable+run — it only
        # serves the wake splash and fires a single wake per vhost; it never
        # stops anything. `enable --now` is idempotent; `try-restart` is a no-op
        # if inactive and gracefully restarts (not a hard kill) a running
        # instance so an upgrade picks up new code.
        systemctl enable --now secubox-waker.service 2>/dev/null || true
        systemctl try-restart secubox-waker.service 2>/dev/null || true

        # secubox-sleeper ships DISABLED (pilot): it STOPS idle sleepable
        # modules, and until each deployment's lifecycle assignments are audited
        # (a security service like the WAF must be always-on, NEVER on-demand),
        # auto-enabling it fleet-wide could sleep something that must stay up.
        # The operator enables it deliberately, once the sleepable set is
        # verified: `systemctl enable --now secubox-sleeper.service`.
        #
        # ON UPGRADE, WE MUST *START* IT, NOT try-restart IT. The dh snippet
        # stops the unit before this script runs; `try-restart` then finds it
        # inactive and does nothing — so an operator who HAD opted in lost the
        # sleeper at every upgrade, silently, which is precisely the case this
        # line was written to serve. Observed on gk2 (2026-09-22): 5 days of
        # uptime, gone after a `dpkg -i`, and nothing said so.
        #
        # `enabled` IS the record of that opt-in — it is what
        # `enable --now` leaves behind, and `--no-enable` guarantees a fresh
        # install never has it. Starting only when enabled therefore keeps the
        # pilot's promise (never auto-start on a new board) while restoring the
        # operator's choice on upgrade.
        if systemctl is-enabled --quiet secubox-sleeper.service 2>/dev/null; then
            systemctl start secubox-sleeper.service 2>/dev/null || true
        fi

        # Config sync for the sbxwaf-side wake trigger + the health monitor
        # (ref #896 — supersedes the nginx-sync path of Task 7, PIVOT
        # 2026-07-20): waf-sync writes the on-demand vhost list sbxwaf reads
        # to decide "proxy to the waker instead of 421"; health-sync writes
        # the sleepable-module-id set secubox-hub reads to distinguish
        # "voluntarily asleep" from "down". Both are idempotent, best-effort
        # (an empty modules.d before the first `scan` just yields an empty
        # list — never a postinst failure).
        # /etc/secubox/waf et /etc/secubox/health : préparés plus haut par maj-references.py --dossiers.
        /usr/sbin/secubox-wakectl waf-sync 2>/dev/null || true
        /usr/sbin/secubox-wakectl health-sync 2>/dev/null || true

        # Phase-2 wake splash: add `include snippets/secubox-waking.conf;` to
        # every on-demand vhost so a booting backend's 502/503/504 shows the
        # terminal splash instead of a raw gateway error. Idempotent + rolls
        # back if nginx -t fails; itself reloads nginx on success.
        /usr/sbin/secubox-wakectl nginx-sync 2>/dev/null || true

        systemctl reload nginx 2>/dev/null || true
        ;;
esac

#DEBHELPER#
exit 0
