# Relevé de validation de cette box (#3212) : profil attendu, paquets, services, ressources. Lecture seule de dpkg,
# de systemd (D-Bus) et de /health de l'agrégateur ; écrit /var/lib/secubox/profiles/validation/releve.json (0640,
# groupe secubox par le setgid du dossier), que annuaire signe et sert aux pairs du maillage (sbx-fleetctl
# publish-modules). Compte dédié, socle § 10 complet, profil AppArmor enforce, aucun sudo.
[Unit]
Description=SecuBox — relevé de validation des modules de cette box (#3212)
After=secubox-aggregator.service

[Service]
Type=oneshot
User=secubox-profiles
Group=secubox
WorkingDirectory=/usr/lib/secubox/profiles
ExecStart=/usr/sbin/secubox-profilectl releve
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/secubox/profiles/validation
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
AppArmorProfile=secubox-profiles-releve
