# Relevé de validation de cette box (#3212) : profil attendu, paquets, services, ressources. Lecture seule de dpkg,
# de systemd et de /health de l'agrégateur ; écrit /var/lib/secubox/profiles/validation/releve.json, que annuaire
# signe et sert aux pairs du maillage (sbx-fleetctl publish-modules).
[Unit]
Description=SecuBox — relevé de validation des modules de cette box (#3212)
After=secubox-aggregator.service

[Service]
Type=oneshot
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/profiles
ExecStart=/usr/sbin/secubox-profilectl releve
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/secubox/profiles/validation
RestrictAddressFamilies=AF_UNIX
