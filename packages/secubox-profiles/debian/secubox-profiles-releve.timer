[Unit]
Description=SecuBox — relevé de validation des modules toutes les 5 minutes (#3212)

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
RandomizedDelaySec=30
AccuracySec=30s

[Install]
WantedBy=timers.target
