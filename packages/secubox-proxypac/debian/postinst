#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Transitoire (#2050) : l'unité secubox-proxypac.service est désormais livrée par secubox-tor. L'ancien prerm
# de la version précédente l'arrête à la mise à jour ; on la rétablit une fois l'absorbant configuré.
set -e
#DEBHELPER#
if [ "$1" = configure ] && [ -e /usr/lib/systemd/system/secubox-proxypac.service -o -e /lib/systemd/system/secubox-proxypac.service ]; then
    if [ "$(systemctl is-enabled secubox-proxypac.service 2>/dev/null)" != masked ]; then
        systemctl enable secubox-proxypac.service >/dev/null 2>&1 || true
        systemctl start secubox-proxypac.service >/dev/null 2>&1 || true
    fi
fi
exit 0
