# Exemple pour /etc/secubox/pseudo-routeur.toml (#3803).
# Interface du LAN plat (cas de gk2 : eth2). Seul le trafic ENTRE par elle est filtre ;
# br-lxc, wg et maillage ne sont jamais touches. Absente : detection par lan_subnet ;
# introuvable : generer-chaine/activer refusent (code 2).
lan_if = "eth2"
# Sous-reseau du LAN, utilise seulement si lan_if est absent.
lan_subnet = "192.168.1.0/24"
