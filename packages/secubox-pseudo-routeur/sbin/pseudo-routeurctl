# SecuBox-Deb :: secubox-pseudo-routeur :: pseudo-routeurctl (#2940)
#
#   generer-chaine     ecrit la chaine nft dans un fichier (SECUBOX_PR_NFT_OUT ou
#                       /etc/nftables.d/zz-secubox-pseudo-routeur.nft), ne l'applique pas
#   activer-transfert   generer-chaine vers le fichier reel, nft -f, puis ip_forward=1
#   apercu              JSON des voisins LAN non classes par le NAC (informatif, #3803)
#   etat-transfert      JSON {"transfert_actif": bool, "paquets_rejetes": int}
#   relais6-*           relais IPv6 par next hop Freebox (#3807) : preparer/retirer/etat (routeur),
#                       basculer/revenir/sonde/etat (repli) — voir la section « Relais IPv6 »

set -euo pipefail

readonly NFT_OUT_DEFAUT="${SECUBOX_PR_NFT_PERSIST:-/etc/nftables.d/zz-secubox-pseudo-routeur.nft}"
readonly NFT="${SECUBOX_PR_NFT:-nft}"
readonly AUDIT_LOG="${SECUBOX_PR_AUDIT_LOG:-/var/log/secubox/audit.log}"
readonly NFT_OUT="${SECUBOX_PR_NFT_OUT:-$NFT_OUT_DEFAUT}"
# sonde-secours vit dans le meme sbin/ (dev comme une fois installe en /usr/sbin/) : pas
# besoin que /usr/sbin figure dans le PATH pour le trouver.
readonly SONDE_SCRIPT="${SECUBOX_PR_SONDE:-$(dirname "$0")/sonde-secours}"
readonly FREEBOXCTL="${SECUBOX_PR_FREEBOXCTL:-/usr/sbin/freeboxctl}"
readonly IP_GK2="${SECUBOX_PR_IP_GK2:-192.168.1.200}"
readonly IP_FREEBOX="${SECUBOX_PR_IP_FREEBOX:-192.168.1.254}"

_sonde_active() {
    bash "$SONDE_SCRIPT" etat | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("actif") is True else 1)'
}

_freeboxctl() {
    if command -v sudo >/dev/null 2>&1; then
        sudo -u secubox-freebox "$FREEBOXCTL" "$@"
    else
        "$FREEBOXCTL" "$@"
    fi
}

readonly CONF="${SECUBOX_PR_CONF:-/etc/secubox/pseudo-routeur.toml}"
readonly NAC_SETS="lan_allowed lxc_zone guest_zone iot_zone quarantine_zone blocked"

# Lit une cle texte du TOML du paquet (vide si absente / fichier absent).
_conf() {
    [ -r "$CONF" ] || return 0
    python3 - "$CONF" "$1" <<'PYEOF' 2>/dev/null || true
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    v = tomllib.load(f).get(sys.argv[2], "")
print(v if isinstance(v, str) else "")
PYEOF
}

# Interface du LAN plat (#3803) : SECUBOX_PR_LAN_IF, sinon `lan_if` du TOML, sinon
# l'interface qui porte le sous-reseau LAN (`lan_subnet`, defaut <IP_GK2>/24).
# Rien sur la sortie si inconnue ou invalide : l'appelant refuse alors de generer.
_lan_if() {
    local i="${SECUBOX_PR_LAN_IF:-}"
    [ -n "$i" ] || i="$(_conf lan_if)"
    if [ -z "$i" ] && command -v ip >/dev/null 2>&1; then
        local sousreseau
        sousreseau="$(_conf lan_subnet)"
        [ -n "$sousreseau" ] || sousreseau="${IP_GK2%.*}.0/24"
        i="$(ip -o -4 route show to "$sousreseau" 2>/dev/null | awk '{for(k=1;k<NF;k++) if($k=="dev"){print $(k+1); exit}}')"
    fi
    if [[ "$i" =~ ^[A-Za-z0-9_.-]{1,15}$ ]]; then
        printf '%s' "$i"
    fi
}

# #3803 : la chaine ne gouverne QUE le trafic entre par l'interface LAN. Tout autre
# ingress (br-lxc des conteneurs, wg, maillage) est accepte d'emblee : jamais coupe.
# LAN = zone de confiance : un appareil non classe garde Internet ; seuls les ensembles
# NAC blocked et quarantine_zone sont jetes (recopies ici, #2940 Review Focus point 1).
# vus_lan (#3803) : MAC dont un paquet du LAN a reellement ete retransmis par gk2 dans
# les 15 dernieres minutes — signal « passe par gk2 » de la page, sans conntrack.
# Policy accept : aucun drop par defaut ne peut attraper une autre interface.
#
# Un ensemble nft n'est visible que dans sa table : @blocked de secubox_nac est
# introuvable ici (nft refusait tout le fichier). On declare donc des copies locales,
# remplies a la generation avec les MAC actuelles du NAC ; les drops vivants restent
# ceux de la chaine forward de secubox-nac (priorite -5), evaluee avant celle-ci et
# seule source qui fait foi : ces copies ne sont qu'un instantane pris a la generation.
_elements_nac() {
    command -v nft >/dev/null 2>&1 || return 0
    nft -j list set inet secubox_nac "$1" 2>/dev/null | python3 -c 'import json,re,sys
macs = []
try:
    for o in json.load(sys.stdin).get("nftables", []):
        for e in (o.get("set") or {}).get("elem", []) or []:
            v = e if isinstance(e, str) else ((e.get("elem") or {}).get("val") if isinstance(e, dict) else None)
            if isinstance(v, str) and re.fullmatch(r"[0-9a-fA-F:]{17}", v):
                macs.append(v.lower())
except Exception:
    pass
print(", ".join(sorted(set(macs))))' 2>/dev/null || true
}

_def_ensemble() {
    local nom="$1" elems
    elems="$(_elements_nac "$nom")"
    printf '\tset %s {\n\t\ttype ether_addr;\n' "$nom"
    [ -n "$elems" ] && printf '\t\telements = { %s }\n' "$elems"
    printf '\t}\n'
}

_contenu_chaine() {
    local lan_if="$1"
    # Idempotent : declarer (vide) puis supprimer la table dans la meme transaction
    # nft -f, puis la redeclarer -> une seule copie des regles, remplacement atomique.
    echo "table inet secubox_pseudo_routeur {}"
    echo "delete table inet secubox_pseudo_routeur"
    echo "table inet secubox_pseudo_routeur {"
    _def_ensemble blocked
    _def_ensemble quarantine_zone
    cat <<EOF
	set vus_lan {
		type ether_addr;
		flags dynamic,timeout;
		timeout 15m;
	}
	counter sbx_pr_forward_rejete {
	}
	counter sbx_pr_forward_lan {
	}
	chain forward {
		type filter hook forward priority filter - 1; policy accept;
		iifname != "${lan_if}" accept
		ether saddr @blocked counter name sbx_pr_forward_rejete drop
		ether saddr @quarantine_zone counter name sbx_pr_forward_rejete drop
		update @vus_lan { ether saddr }
		counter name sbx_pr_forward_lan accept
	}
}
EOF
}

# Ecrit la chaine dans $1 ; refuse (exit 2) si l'interface LAN est inconnue.
_ecrire_chaine() {
    local dest="$1" lan_if
    lan_if="$(_lan_if)"
    if [ -z "$lan_if" ]; then
        echo "refuse : interface LAN inconnue (lan_if dans $CONF ou SECUBOX_PR_LAN_IF)" >&2
        exit 2
    fi
    mkdir -p "$(dirname "$dest")"
    _contenu_chaine "$lan_if" > "$dest"
}

cmd_generer_chaine() {
    _ecrire_chaine "$NFT_OUT"
}

# apercu (#3803, informatif) : voisins IPv4 de l'interface LAN absents de tout ensemble
# NAC. Ils garderont Internet apres activation (LAN = zone de confiance) ; la liste sert
# seulement a les classer avant la bascule.
cmd_apercu() {
    local lan_if
    lan_if="$(_lan_if)"
    if [ -z "$lan_if" ]; then
        echo "refuse : interface LAN inconnue (lan_if dans $CONF ou SECUBOX_PR_LAN_IF)" >&2
        exit 2
    fi
    local voisins="" connues="" s
    voisins="$(ip -4 neigh show dev "$lan_if" 2>/dev/null || true)"
    if command -v nft >/dev/null 2>&1; then
        for s in $NAC_SETS; do
            connues+="$(nft -j list set inet secubox_nac "$s" 2>/dev/null || true)"$'\n'
        done
    fi
    LAN_IF="$lan_if" VOISINS="$voisins" CONNUES="$connues" python3 - <<'PYEOF'
import json, os, re
macs = set()
for ligne in os.environ["CONNUES"].splitlines():
    try:
        d = json.loads(ligne)
    except ValueError:
        continue
    for o in d.get("nftables", []):
        for e in (o.get("set") or {}).get("elem", []) or []:
            if isinstance(e, str):
                macs.add(e.lower())
            elif isinstance(e, dict):
                v = (e.get("elem") or {}).get("val")
                if isinstance(v, str):
                    macs.add(v.lower())
vus = {}
for ligne in os.environ["VOISINS"].splitlines():
    m = re.match(r"(\S+) .*lladdr ([0-9a-fA-F:]{17})", ligne)
    if m and m.group(2).lower() not in macs:
        vus[m.group(2).lower()] = m.group(1)
print(json.dumps({"lan_if": os.environ["LAN_IF"],
                  "non_classes": [{"ip": ip, "mac": mac} for mac, ip in sorted(vus.items())],
                  "note": "non classes : gardent Internet (LAN de confiance) ; seuls blocked et quarantine_zone sont jetes"}))
PYEOF
}

# Double tampon (#3803) : fichier temporaire dans le meme repertoire, nom hors du motif
# d'inclusion (point initial, suffixe .tmp), valide par nft -c, puis mv atomique et
# seulement alors nft -f. En cas d'echec : temporaire supprime, fichier persistant
# precedent intact.
cmd_activer_transfert() {
    local rep tmp
    rep="$(dirname "$NFT_OUT_DEFAUT")"
    mkdir -p "$rep"
    tmp="$(mktemp "$rep/.zz-secubox-pseudo-routeur.XXXXXX.tmp")"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" EXIT
    _ecrire_chaine "$tmp"
    if ! "$NFT" -c -f "$tmp"; then
        echo "refuse : chaine generee rejetee par nft -c, fichier persistant inchange" >&2
        exit 1
    fi
    chmod 644 "$tmp"
    mv -f "$tmp" "$NFT_OUT_DEFAUT"
    trap - EXIT
    "$NFT" -f "$NFT_OUT_DEFAUT"
    sysctl -w net.ipv4.ip_forward=1 >/dev/null
}

cmd_etat_transfert() {
    local transfert_actif="false"
    local paquets_rejetes=0
    if [ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 0)" = "1" ]; then
        transfert_actif="true"
    fi
    if command -v nft >/dev/null 2>&1; then
        paquets_rejetes="$(nft -j list counter inet secubox_pseudo_routeur sbx_pr_forward_rejete 2>/dev/null \
            | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    print(d["nftables"][1]["counter"]["packets"])
except Exception:
    print(0)' 2>/dev/null || echo 0)"
    fi
    printf '{"transfert_actif": %s, "paquets_rejetes": %s}\n' "$transfert_actif" "$paquets_rejetes"
}

# activer : refuse (code 2) si la sonde n'est pas active — jamais de bascule DHCP sans
# le filet de secours arme en premier (#2940 Review Focus point 3).
# Ordre (#3803) : la sonde ne peut etre « active » qu'une fois le transfert charge ; l'exiger
# AVANT le chargement rendait l'activation impossible. Donc : transfert, puis sonde armee
# (timer) et un controle immediat, et la bascule DHCP seulement si ce controle passe.
_sonde_timer() {
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl "$1" pseudo-routeur-sonde.timer >/dev/null 2>&1 || true
    fi
}

cmd_activer() {
    cmd_activer_transfert
    _sonde_timer start
    bash "$SONDE_SCRIPT" verifier >/dev/null 2>&1 || true
    # Le dernier controle doit avoir REUSSI (actif seul reste vrai apres 1-2 echecs).
    if ! bash "$SONDE_SCRIPT" etat | python3 -c 'import json,sys
d = json.load(sys.stdin); h = d.get("historique") or [{}]
sys.exit(0 if d.get("actif") is True and h[-1].get("ok") is True else 1)'; then
        echo "refuse : la sonde de secours n'est pas active (sonde-secours etat) ; retour a la Freebox" >&2
        cmd_retour_freebox || true
        exit 2
    fi
    _freeboxctl passerelle-dhcp "$IP_GK2" || exit 1
}

# retour-freebox : chemin de secours, toujours execute, sonde active ou non. Un echec de
# l'appel reseau/connecteur sort en 1 (jamais en 2 : ce code est reserve au refus de la
# garde, et retour-freebox n'a pas de garde a refuser).
cmd_retour_freebox() {
    # Retire la chaine en entier (vivante et persistante) : plus rien ne filtre le forward.
    # ip_forward=1 est laisse volontairement : les conteneurs LXC (br-lxc) en ont besoin.
    # Un echec de suppression est signale et audite, mais n'empeche JAMAIS le retour DHCP.
    if command -v "$NFT" >/dev/null 2>&1; then
        "$NFT" delete table inet secubox_pseudo_routeur 2>/dev/null || true
        if "$NFT" list table inet secubox_pseudo_routeur >/dev/null 2>&1; then
            echo "avertissement : table inet secubox_pseudo_routeur toujours presente apres retour-freebox" >&2
            printf '{"ts": "%s", "module": "pseudo-routeur", "action": "retour_freebox_table_restante", "resultat": "echec_suppression"}\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$AUDIT_LOG" 2>/dev/null || true
        fi
    fi
    rm -f "$NFT_OUT_DEFAUT"
    # Sonde desarmee : sans table elle echouerait chaque minute et relancerait ce retour.
    _sonde_timer stop
    _freeboxctl passerelle-dhcp "$IP_FREEBOX" || exit 1
}

cmd_etat() {
    local sonde_active="false"
    if _sonde_active; then sonde_active="true"; fi
    local passerelle
    passerelle="$(_freeboxctl lire-passerelle 2>/dev/null | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("passerelle") or "")
except Exception:
    print("")' 2>/dev/null || echo "")"
    local mode="freebox"
    [ "$passerelle" = "$IP_GK2" ] && mode="gk2"
    printf '{"mode": "%s", "sonde_active": %s}\n' "$mode" "$sonde_active"
}

_nft_json() {
    if command -v "$NFT" >/dev/null 2>&1; then "$NFT" -j "$@" 2>/dev/null || true; fi
}

_passerelle_lue() {
    _freeboxctl lire-passerelle 2>/dev/null | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("passerelle") or "")
except Exception:
    print("")' 2>/dev/null || true
}

# etat-complet (#3803, lecture) : tout ce que montre la page, valeurs reelles ou null.
cmd_etat_complet() {
    local table=false ipf=0 compteurs="" sonde passerelle
    if command -v "$NFT" >/dev/null 2>&1 && "$NFT" list table inet secubox_pseudo_routeur >/dev/null 2>&1; then
        table=true
        compteurs="$(_nft_json list counters table inet secubox_pseudo_routeur)"
    fi
    ipf="$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 0)"
    sonde="$(bash "$SONDE_SCRIPT" etat 2>/dev/null || echo '{}')"
    passerelle="$(_passerelle_lue)"
    TABLE="$table" IPF="$ipf" COMPTEURS="$compteurs" SONDE="$sonde" PASSERELLE="$passerelle" \
    PERSIST="$NFT_OUT_DEFAUT" PR_GK2="$IP_GK2" PR_FREEBOX="$IP_FREEBOX" LAN_IF="$(_lan_if)" python3 - <<'PYEOF'
import json, os, time
e = os.environ
compteurs = {"lan": None, "rejete": None}
try:
    for o in json.loads(e["COMPTEURS"] or "{}").get("nftables", []):
        c = o.get("counter")
        if c and c.get("name") in ("sbx_pr_forward_lan", "sbx_pr_forward_rejete"):
            compteurs["lan" if c["name"].endswith("lan") else "rejete"] = {"paquets": c.get("packets", 0), "octets": c.get("bytes", 0)}
except ValueError:
    pass
try:
    sonde = json.loads(e["SONDE"])
except ValueError:
    sonde = {}
try:
    depuis = int(os.stat(e["PERSIST"]).st_mtime)
except OSError:
    depuis = None
table = e["TABLE"] == "true"
passerelle = e["PASSERELLE"] or None
print(json.dumps({
    "actif": table and passerelle == e["PR_GK2"],
    "depuis": depuis if table else None,
    "table_presente": table,
    "ip_forward": e["IPF"].strip() == "1",
    "lan_if": e["LAN_IF"] or None,
    "ip_gk2": e["PR_GK2"], "ip_freebox": e["PR_FREEBOX"],
    "passerelle_distribuee": passerelle, "passerelle_lue_a": int(time.time()) if passerelle else None,
    "sonde": {"active": sonde.get("actif") is True, "echecs_consecutifs": sonde.get("echecs_consecutifs", 0),
              "historique": sonde.get("historique", [])[-10:]},
    "compteurs": compteurs,
}))
PYEOF
}

# appareils (#3803, lecture) : un objet par MAC vue sur l'interface LAN (ip neigh v4+v6),
# zone NAC (ensembles de secubox_nac), « passe par gk2 » = MAC dans @vus_lan (null si la
# chaine n'est pas chargee : pas de signal, jamais de valeur inventee).
cmd_appareils() {
    local lan_if s zones="" vus=""
    lan_if="$(_lan_if)"
    if [ -z "$lan_if" ]; then
        echo "refuse : interface LAN inconnue (lan_if dans $CONF ou SECUBOX_PR_LAN_IF)" >&2
        exit 2
    fi
    for s in $NAC_SETS; do
        zones+="$s $(_nft_json list set inet secubox_nac "$s" | tr '\n' ' ')"$'\n'
    done
    if command -v "$NFT" >/dev/null 2>&1 && "$NFT" list table inet secubox_pseudo_routeur >/dev/null 2>&1; then
        vus="$(_nft_json list set inet secubox_pseudo_routeur vus_lan)"
        [ -n "$vus" ] || vus='{}'
    fi
    LAN_IF="$lan_if" ZONES="$zones" VUS="$vus" \
    V4="$(ip -4 neigh show dev "$lan_if" 2>/dev/null || true)" V6="$(ip -6 neigh show dev "$lan_if" 2>/dev/null || true)" python3 - <<'PYEOF'
import ipaddress, json, os, re, time
def macs_de(txt):
    r = set()
    try:
        for o in json.loads(txt).get("nftables", []):
            for el in (o.get("set") or {}).get("elem", []) or []:
                v = el if isinstance(el, str) else ((el.get("elem") or {}).get("val") if isinstance(el, dict) else None)
                if isinstance(v, str):
                    r.add(v.lower())
    except ValueError:
        pass
    return r
zone = {}
for ligne in os.environ["ZONES"].splitlines():
    nom, _, js = ligne.partition(" ")
    for m in macs_de(js or "{}"):
        if m not in zone or nom in ("blocked", "quarantine_zone"):
            zone[m] = nom
vus = macs_de(os.environ["VUS"]) if os.environ["VUS"] else None
app = {}
for cle, fam in (("V4", 4), ("V6", 6)):
    for ligne in os.environ[cle].splitlines():
        m = re.match(r"(\S+) .*lladdr ([0-9a-fA-F:]{17})", ligne)
        if not m or "FAILED" in ligne or "INCOMPLETE" in ligne:
            continue
        mac = m.group(2).lower()
        a = app.setdefault(mac, {"mac": mac, "ipv4": [], "ipv6_globales": []})
        try:
            ip = ipaddress.ip_address(m.group(1))
        except ValueError:
            continue
        if fam == 4:
            a["ipv4"].append(str(ip))
        elif ip.is_global:
            a["ipv6_globales"].append(str(ip))
for a in app.values():
    a["zone"] = zone.get(a["mac"])
    a["passe_par_gk2"] = (a["mac"] in vus) if vus is not None else None
print(json.dumps({"lan_if": os.environ["LAN_IF"], "releve": int(time.time()),
                  "chaine_chargee": vus is not None,
                  "appareils": sorted(app.values(), key=lambda a: (a["ipv4"] or ["~"])[0])}))
PYEOF
}

# tester-retour (#3803) : essai a blanc du chemin de secours — ne modifie RIEN, dit ce que
# retour-freebox ferait et si chaque etape est possible.
cmd_tester_retour() {
    local table=false fichier=false passerelle
    if command -v "$NFT" >/dev/null 2>&1 && "$NFT" list table inet secubox_pseudo_routeur >/dev/null 2>&1; then table=true; fi
    [ -f "$NFT_OUT_DEFAUT" ] && fichier=true
    passerelle="$(_passerelle_lue)"
    TABLE="$table" FICHIER="$fichier" PASSERELLE="$passerelle" PR_FREEBOX="$IP_FREEBOX" PERSIST="$NFT_OUT_DEFAUT" python3 - <<'PYEOF'
import json, os
e = os.environ
lue = e["PASSERELLE"] or None
etapes = [
    {"etape": "supprimer la table inet secubox_pseudo_routeur", "possible": True,
     "detail": "table presente, serait supprimee" if e["TABLE"] == "true" else "table absente, rien a supprimer"},
    {"etape": "retirer " + e["PERSIST"], "possible": True,
     "detail": "fichier present, serait retire" if e["FICHIER"] == "true" else "fichier absent, rien a retirer"},
    {"etape": "rendre la passerelle DHCP a la Freebox (" + e["PR_FREEBOX"] + ")", "possible": lue is not None,
     "detail": ("connecteur Freebox joignable, passerelle actuelle " + lue) if lue else "connecteur Freebox injoignable : le retour echouerait"},
    {"etape": "laisser ip_forward=1", "possible": True, "detail": "volontaire : les conteneurs LXC en ont besoin"},
]
print(json.dumps({"modifie": False, "pret": all(x["possible"] for x in etapes), "etapes": etapes}))
PYEOF
}

# ══ Relais IPv6 (#3807) ══════════════════════════════════════════════════════
# La Freebox ignore la passerelle DHCP pour l'IPv6 et ne sait pas couper son IPv6 LAN ; mais elle
# route son /64 principal vers un next hop lien-local si on le lui demande (connection/ipv6/config/,
# delegations[0].next_hop) et cesse alors de l'annoncer. Deux roles, [relais_ipv6] du TOML :
#   routeur (gk1) : adresse fixe + route par defaut via la Freebox (drop-in networkd), annonces RA
#                   (dnsmasq dedie, RDNSS = gk2), redirections ICMPv6 coupees (nft) ;
#   repli   (gk2) : bascule le next hop vers le routeur (si la sonde passe), sonde 60 s, retour au
#                   3e echec consecutif. Rien n'est actif tant que role est vide (defaut).
readonly R6_NETWORKD_DIR="${SECUBOX_PR_NETWORKD_DIR:-/etc/systemd/network}"
readonly R6_DROPIN="zz-secubox-relais6.conf"
readonly R6_NFT_PERSIST="${SECUBOX_PR_R6_NFT:-/etc/nftables.d/zz-secubox-relais6.nft}"
readonly R6_DNSMASQ_CONF="${SECUBOX_PR_R6_DNSMASQ_CONF:-/etc/secubox/relais6-ra.conf}"
readonly R6_ETAT="${SECUBOX_PR_R6_ETAT:-/var/lib/secubox/pseudo-routeur/relais6-sonde.json}"
readonly R6_UNITE_RA="secubox-relais6-ra.service"
readonly R6_TIMER="pseudo-routeur-relais6-sonde.timer"
readonly R6_SEUIL=3
readonly R6_VERROU="${SECUBOX_PR_R6_VERROU:-/run/lock/secubox-relais6.lock}"

# Verrou commun des verbes ecrivants relais6-* et de la sonde : jamais deux a la fois.
_r6_verrou() {
    mkdir -p "$(dirname "$R6_VERROU")"
    exec 9>>"$R6_VERROU"
    if ! flock -w 60 9; then
        echo "refuse : verrou $R6_VERROU tenu depuis plus de 60 s" >&2
        exit 1
    fi
}

_audit() {
    # $1 action, $2 resultat, $3 detail (texte libre deja valide)
    python3 - "$1" "$2" "${3:-}" >> "$AUDIT_LOG" 2>/dev/null <<'PYEOF' || echo "avertissement : audit.log non ecrit ($1)" >&2
import json, sys
from datetime import datetime, timezone
print(json.dumps({"ts": datetime.now(timezone.utc).isoformat(timespec="seconds"), "module": "pseudo-routeur",
                  "action": sys.argv[1], "resultat": sys.argv[2], "detail": sys.argv[3]}, ensure_ascii=False))
PYEOF
}

# Lit et VALIDE [relais_ipv6] : imprime des lignes cle=valeur canoniques (ipaddress), rien
# d'autre ne sort du TOML vers une commande. Code 2 + message si une valeur est invalide.
# Fichier ou section absents : role vide (aucun effet).
_r6_conf() {
    python3 - "$CONF" <<'PYEOF'
import ipaddress, re, sys, tomllib
try:
    with open(sys.argv[1], "rb") as f:
        s = tomllib.load(f).get("relais_ipv6") or {}
except FileNotFoundError:
    s = {}
except (OSError, tomllib.TOMLDecodeError) as e:
    print("refuse : %s illisible (%s)" % (sys.argv[1], e), file=sys.stderr); sys.exit(2)
if not isinstance(s, dict):
    print("refuse : [relais_ipv6] doit etre une table", file=sys.stderr); sys.exit(2)
def txt(k):
    v = s.get(k, "")
    if not isinstance(v, str):
        raise ValueError(k + " doit etre une chaine")
    return v.strip()
def ll(k, v):
    a = ipaddress.IPv6Address(v)
    if not a.is_link_local:
        raise ValueError(k + " doit etre une adresse lien-local fe80::/10")
    return str(a)
out = {}
try:
    role = txt("role")
    if role not in ("", "routeur", "repli", "tout"):
        raise ValueError("role : routeur, repli, tout ou vide")
    out["role"] = role
    i = txt("lan_if")
    if i and not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", i):
        raise ValueError("lan_if invalide")
    out["lan_if"] = i
    f = txt("fichier_network")
    if f and not re.fullmatch(r"[A-Za-z0-9_.@-]{1,64}\.network", f):
        raise ValueError("fichier_network invalide (nom de fichier .network)")
    out["fichier_network"] = f
    if role:
        for k in ("passerelle_ll", "routeur_ll", "dns", "sonde_cible", "adresse_fixe", "prefixe"):
            if "%" in txt(k):     # ipaddress accepte « fe80::1%eth2 » : la zone vient de lan_if, jamais du TOML
                raise ValueError(k + " : pas d'identifiant de zone (%)")
        p = ipaddress.IPv6Network(txt("prefixe"), strict=True)
        if p.prefixlen != 64 or not p.is_global:
            raise ValueError("prefixe : /64 global attendu")
        out["prefixe"] = str(p)
        out["passerelle_ll"] = ll("passerelle_ll", txt("passerelle_ll"))
        # role tout : routeur_ll vide = lien-local de cette box sur lan_if, lu a l'execution.
        out["routeur_ll"] = ll("routeur_ll", txt("routeur_ll")) if (txt("routeur_ll") or role != "tout") else ""
        d = ipaddress.IPv6Address(txt("dns"))
        if d.is_link_local or d.is_multicast or d.is_unspecified or d.is_loopback:
            raise ValueError("dns : adresse IPv6 unicast routable attendue")
        out["dns"] = str(d)
        c = txt("sonde_cible")
        if c:
            c = ipaddress.IPv6Address(c)
            if not c.is_global:
                raise ValueError("sonde_cible : adresse IPv6 globale attendue")
        out["sonde_cible"] = str(c)
        a = txt("adresse_fixe")
        if a:
            a = ipaddress.IPv6Interface(a)
            if a.network != p or a.ip == p.network_address:
                raise ValueError("adresse_fixe : adresse/64 dans le prefixe attendue")
        out["adresse_fixe"] = str(a)
        if role in ("routeur", "tout") and not a:
            raise ValueError("adresse_fixe obligatoire pour le role " + role)
        if role in ("repli", "tout") and not c:
            raise ValueError("sonde_cible obligatoire pour le role " + role)
except ValueError as e:
    print("refuse : [relais_ipv6] " + str(e), file=sys.stderr); sys.exit(2)
for k, v in out.items():
    print(k + "=" + v)
PYEOF
}

# Charge la config validee dans R6_* (variables globales). Code 2 si invalide : l'appelant decide.
_r6_charger() {
    local lignes k v
    lignes="$(_r6_conf)" || return 2
    R6_ROLE="" R6_LAN_IF="" R6_FICHIER_NETWORK="" R6_PREFIXE="" R6_PASSERELLE_LL="" R6_ROUTEUR_LL="" R6_DNS="" R6_SONDE_CIBLE="" R6_ADRESSE_FIXE=""
    while IFS='=' read -r k v; do
        case "$k" in
            role) R6_ROLE="$v" ;; lan_if) R6_LAN_IF="$v" ;; fichier_network) R6_FICHIER_NETWORK="$v" ;;
            prefixe) R6_PREFIXE="$v" ;; passerelle_ll) R6_PASSERELLE_LL="$v" ;; routeur_ll) R6_ROUTEUR_LL="$v" ;;
            dns) R6_DNS="$v" ;; sonde_cible) R6_SONDE_CIBLE="$v" ;; adresse_fixe) R6_ADRESSE_FIXE="$v" ;;
        esac
    done <<< "$lignes"
    [ -n "$R6_LAN_IF" ] || R6_LAN_IF="$(_lan_if)"
    if [ "$R6_ROLE" = "tout" ] && [ -z "$R6_ROUTEUR_LL" ] && [ -n "$R6_LAN_IF" ]; then
        R6_ROUTEUR_LL="$(_r6_ll_local)"
        if [ -z "$R6_ROUTEUR_LL" ]; then
            echo "refuse : aucune adresse lien-local lue sur $R6_LAN_IF (routeur_ll de [relais_ipv6])" >&2
            return 2
        fi
    fi
}

# Lien-local de cette box sur lan_if (role tout), valide par ipaddress ; vide si absent.
_r6_ll_local() {
    ip -6 -o addr show dev "$R6_LAN_IF" scope link 2>/dev/null | python3 -c 'import ipaddress, re, sys
for ligne in sys.stdin:
    m = re.search(r"inet6 ([0-9a-fA-F:]+)/\d+", ligne)
    if m:
        try:
            a = ipaddress.IPv6Address(m.group(1))
        except ValueError:
            continue
        if a.is_link_local:
            print(a)
            break'
}

# L'adresse fixe est-elle deja posee sur lan_if (par un autre fichier) ? Alors on ne la double pas.
_r6_adresse_presente() {
    ip -6 addr show dev "$R6_LAN_IF" 2>/dev/null | grep -F " ${R6_ADRESSE_FIXE} " >/dev/null
}

_r6_exiger_role() {
    if [ -z "$R6_ROLE" ]; then
        printf '{"role": "", "modifie": false, "note": "relais IPv6 non configure ([relais_ipv6] role vide)"}\n'
        exit 0
    fi
    if [ "$R6_ROLE" != "$1" ] && [ "$R6_ROLE" != "tout" ]; then
        echo "refuse : verbe du role $1, cette box a le role $R6_ROLE" >&2
        exit 2
    fi
    if [ -z "$R6_LAN_IF" ]; then
        echo "refuse : interface LAN inconnue (lan_if de [relais_ipv6])" >&2
        exit 2
    fi
}

# Fichier .network qui gere lan_if : fichier_network du TOML, sinon `networkctl status`.
_r6_fichier_network() {
    local f="$R6_FICHIER_NETWORK"
    if [ -z "$f" ]; then
        f="$(networkctl status -- "$R6_LAN_IF" 2>/dev/null | awk -F': ' '/Network File:/{print $2; exit}')"
        f="$(basename -- "${f:-}")"
    fi
    if [[ "$f" =~ ^[A-Za-z0-9_.@-]{1,64}\.network$ ]]; then
        printf '%s' "$f"
    fi
}

_r6_contenu_nft() {
    local i="$1" p="$2"
    cat <<EOF
table inet secubox_relais6 {}
delete table inet secubox_relais6
table inet secubox_relais6 {
	chain sortie {
		type filter hook output priority filter; policy accept;
		oifname "${i}" icmpv6 type nd-redirect counter drop
	}
	chain transit {
		type filter hook forward priority filter - 1; policy accept;
		iifname "${i}" oifname "${i}" ip6 saddr ${p} counter accept
		iifname "${i}" oifname "${i}" ip6 daddr ${p} counter accept
	}
}
EOF
}

_r6_contenu_dnsmasq() {
    cat <<EOF
# Genere par pseudo-routeurctl relais6-preparer (#3807) — ne pas editer.
# Annonces de routeur seules : pas de DNS (port=0), pas de DHCPv4, DHCPv6 sans etat.
port=0
user=dnsmasq
group=nogroup
# Seulement lan_if : gk1 fait deja tourner un autre dnsmasq (lxcbr0), on ne prend rien d'autre.
interface=$R6_LAN_IF
except-interface=lo
bind-interfaces
no-resolv
no-hosts
no-dhcpv4-interface=$R6_LAN_IF
enable-ra
dhcp-range=${R6_PREFIXE%/*},ra-stateless,64
log-dhcp
ra-param=$R6_LAN_IF,high,0
dhcp-option=option6:dns-server,[$R6_DNS]
dhcp-leasefile=/run/secubox-relais6-ra/leases
EOF
}

_r6_contenu_dropin() {
    echo "# Genere par pseudo-routeurctl relais6-preparer (#3807) — ne pas editer."
    # Adresse deja configuree ailleurs (ex. gk2 ::200 par 50-secubox-ipv6-stable.conf) : pas de doublon.
    if [ "${1:-}" != "sans-adresse" ]; then
        printf '[Network]\nAddress=%s\n\n' "$R6_ADRESSE_FIXE"
    fi
    printf '[Route]\nGateway=%s\n' "$R6_PASSERELLE_LL"
}

# Ecrit $2 dans $1 par double tampon (temporaire du meme dossier, mv atomique).
_r6_poser() {
    local dest="$1" contenu="$2" rep tmp
    rep="$(dirname "$dest")"
    mkdir -p "$rep"
    tmp="$(mktemp "$rep/.$(basename "$dest").XXXXXX.tmp")"
    printf '%s\n' "$contenu" > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$dest"
}

cmd_relais6_preparer() {
    _r6_charger || exit 2
    _r6_exiger_role routeur
    local fnet nft_tmp conf_tmp rep
    fnet="$(_r6_fichier_network)"
    if [ -z "$fnet" ]; then
        echo "refuse : fichier .network de $R6_LAN_IF introuvable (fichier_network de [relais_ipv6])" >&2
        exit 2
    fi
    # 1. Valider AVANT toute ecriture : nft -c et dnsmasq --test sur des temporaires.
    rep="$(dirname "$R6_NFT_PERSIST")"; mkdir -p "$rep"
    nft_tmp="$(mktemp "$rep/.zz-secubox-relais6.XXXXXX.tmp")"
    rep="$(dirname "$R6_DNSMASQ_CONF")"; mkdir -p "$rep"
    conf_tmp="$(mktemp "$rep/.relais6-ra.XXXXXX.tmp")"
    # shellcheck disable=SC2064
    trap "rm -f -- '$nft_tmp' '$conf_tmp'" EXIT
    _r6_contenu_nft "$R6_LAN_IF" "$R6_PREFIXE" > "$nft_tmp"
    _r6_contenu_dnsmasq > "$conf_tmp"
    if ! "$NFT" -c -f "$nft_tmp" >/dev/null; then
        echo "refuse : table nft du relais rejetee par nft -c, rien n'a ete ecrit" >&2
        _audit relais6_preparer refuse "nft -c"; exit 1
    fi
    if ! dnsmasq --test -C "$conf_tmp" >/dev/null 2>&1; then
        echo "refuse : configuration dnsmasq rejetee (dnsmasq --test), rien n'a ete ecrit" >&2
        _audit relais6_preparer refuse "dnsmasq --test"; exit 1
    fi
    # 2. Adresse fixe + route par defaut via la Freebox : jamais de lien coupe ni de MTU change.
    # A partir d'ici, tout echec defait ce qui a ete pose (retirer, idempotent).
    # shellcheck disable=SC2064,SC2154
    trap "rc=\$?; rm -f -- '$nft_tmp' '$conf_tmp'; if [ \$rc -ne 0 ]; then echo 'echec : relais IPv6 defait' >&2; cmd_relais6_retirer >/dev/null || true; _audit relais6_preparer echec 'defait apres echec'; fi" EXIT
    local mode_adresse=avec-adresse
    # Adresse deja posee par un AUTRE fichier (pas notre drop-in d'une preparation precedente) : pas de doublon.
    if _r6_adresse_presente && ! grep -qsF "Address=$R6_ADRESSE_FIXE" "$R6_NETWORKD_DIR/$fnet.d/$R6_DROPIN"; then
        mode_adresse=sans-adresse
    fi
    _r6_poser "$R6_NETWORKD_DIR/$fnet.d/$R6_DROPIN" "$(_r6_contenu_dropin "$mode_adresse")"
    networkctl reload
    # 3. Redirections ICMPv6 coupees + transit du prefixe (persistant puis charge).
    chmod 644 "$nft_tmp"; mv -f "$nft_tmp" "$R6_NFT_PERSIST"
    "$NFT" -f "$R6_NFT_PERSIST"
    # 4. Annonces RA (dnsmasq dedie).
    chmod 644 "$conf_tmp"; mv -f "$conf_tmp" "$R6_DNSMASQ_CONF"
    trap - EXIT
    systemctl enable "$R6_UNITE_RA" >/dev/null 2>&1 || true
    systemctl restart "$R6_UNITE_RA"
    _audit relais6_preparer ok "$R6_LAN_IF $R6_ADRESSE_FIXE via $R6_PASSERELLE_LL, RDNSS $R6_DNS"
    printf '{"role": "routeur", "modifie": true, "lan_if": "%s", "adresse_fixe": "%s"}\n' "$R6_LAN_IF" "$R6_ADRESSE_FIXE"
}

# retirer : idempotent, ne lit pas la config (un TOML casse ou vide n'empeche jamais le retrait).
cmd_relais6_retirer() {
    local f retire=false
    if command -v systemctl >/dev/null 2>&1; then
        systemctl disable --now "$R6_UNITE_RA" >/dev/null 2>&1 || true
    fi
    if [ -e "$R6_DNSMASQ_CONF" ]; then rm -f -- "$R6_DNSMASQ_CONF"; retire=true; fi
    if command -v "$NFT" >/dev/null 2>&1 && "$NFT" list table inet secubox_relais6 >/dev/null 2>&1; then
        "$NFT" delete table inet secubox_relais6 || echo "avertissement : table inet secubox_relais6 non supprimee" >&2
        retire=true
    fi
    if [ -e "$R6_NFT_PERSIST" ]; then rm -f -- "$R6_NFT_PERSIST"; retire=true; fi
    local dropins=0
    for f in "$R6_NETWORKD_DIR"/*.network.d/"$R6_DROPIN"; do
        [ -e "$f" ] || continue
        rm -f -- "$f"; rmdir --ignore-fail-on-non-empty -- "$(dirname "$f")" 2>/dev/null || true
        dropins=$((dropins + 1)); retire=true
    done
    if [ "$dropins" -gt 0 ]; then networkctl reload || echo "avertissement : networkctl reload a echoue" >&2; fi
    $retire && _audit relais6_retirer ok "relais IPv6 retire"
    printf '{"modifie": %s}\n' "$retire"
}

# Controle du routeur depuis le repli : routeur lien-local joignable ET Internet IPv6 joignable.
_r6_routeur_ok() {
    if [ "$R6_ROLE" = "tout" ]; then _r6_local_ok; return; fi
    ping -6 -c1 -W2 "${R6_ROUTEUR_LL}%${R6_LAN_IF}" >/dev/null 2>&1 || return 1
    if [ -n "$R6_ADRESSE_FIXE" ]; then ping -6 -c1 -W2 "${R6_ADRESSE_FIXE%/*}" >/dev/null 2>&1 || return 1; fi
    ping -6 -c1 -W2 "$R6_SONDE_CIBLE" >/dev/null 2>&1 || return 1
}

# Role tout : sante du routage LOCAL (forwarding, annonces RA, route via la Freebox, Internet IPv6).
_r6_local_ok() {
    [ "$(sysctl -n net.ipv6.conf.all.forwarding 2>/dev/null || echo 0)" = "1" ] || return 1
    systemctl is-active --quiet "$R6_UNITE_RA" 2>/dev/null || return 1
    ip -6 route show default dev "$R6_LAN_IF" 2>/dev/null | grep -F "via ${R6_PASSERELLE_LL} " >/dev/null || return 1
    # Preuve que les annonces PARTENT (18/11 : unite active mais aucune annonce, `constructor:`) :
    # sans elle, la Freebox se tait apres la bascule et la maison perd l'IPv6 en <= 30 min.
    journalctl -q -u "$R6_UNITE_RA" --since "-15min" 2>/dev/null | grep "RTR-ADVERT" >/dev/null || return 1
    ping -6 -c1 -W2 "$R6_SONDE_CIBLE" >/dev/null 2>&1 || return 1
}

_r6_ecrire_etat() {
    local echecs="$1" ok="$2" tmp
    mkdir -p "$(dirname "$R6_ETAT")"
    tmp="$(mktemp "${R6_ETAT}.XXXXXX")"
    python3 - "$R6_ETAT" "$echecs" "$ok" > "$tmp" <<'PYEOF'
import json, sys, time
hist = []
try:
    with open(sys.argv[1]) as f:
        hist = json.load(f).get("historique", [])[-19:]
except (OSError, ValueError):
    pass
hist.append({"ts": int(time.time()), "ok": sys.argv[3] == "true"})
print(json.dumps({"echecs_consecutifs": int(sys.argv[2]), "historique": hist}))
PYEOF
    chmod 0644 "$tmp"
    mv -f "$tmp" "$R6_ETAT"
}

_r6_echecs() {
    python3 -c 'import json,sys
try:
    print(int(json.load(open(sys.argv[1])).get("echecs_consecutifs", 0)))
except (OSError, ValueError, TypeError):
    print(0)' "$R6_ETAT"
}

_r6_timer() {
    if ! systemctl "$1" --now "$R6_TIMER" >/dev/null 2>&1; then
        echo "avertissement : systemctl $1 --now $R6_TIMER a echoue" >&2
        return 1
    fi
}

cmd_relais6_basculer() {
    _r6_charger || exit 2
    _r6_exiger_role repli
    if ! _r6_routeur_ok; then
        echo "refuse : le routeur $R6_ROUTEUR_LL (ou Internet IPv6 $R6_SONDE_CIBLE) ne repond pas ; next hop inchange" >&2
        _audit relais6_basculer refuse "sonde du routeur en echec"
        exit 2
    fi
    # Surveillance armee AVANT le next hop : jamais de bascule sans sonde.
    _r6_ecrire_etat 0 true
    if ! _r6_timer enable; then
        _audit relais6_basculer refuse "sonde non armee ; next hop inchange"
        exit 1
    fi
    if ! _freeboxctl nexthop-regler "$R6_ROUTEUR_LL"; then
        _r6_timer disable || true
        _audit relais6_basculer echec "freeboxctl nexthop-regler"
        exit 1
    fi
    _audit relais6_basculer ok "next hop $R6_PREFIXE -> $R6_ROUTEUR_LL"
}

# revenir : chemin de secours, toujours execute (sauf sur le routeur, qui n'a pas le connecteur).
cmd_relais6_revenir() {
    R6_ROLE=""
    _r6_charger 2>/dev/null || R6_ROLE=""     # TOML casse : le retour part quand meme
    if [ "$R6_ROLE" = "routeur" ]; then
        echo "refuse : relais6-revenir se lance sur la box de repli (connecteur Freebox)" >&2
        exit 2
    fi
    # La sonde reste armee tant que le retour n'a pas reussi : elle relancera ce retour.
    if ! _freeboxctl nexthop-regler vide; then
        _audit relais6_revenir echec "freeboxctl nexthop-regler vide ; sonde laissee armee"
        exit 1
    fi
    _r6_timer disable || true
    _audit relais6_revenir ok "next hop rendu a la Freebox"
}

# relais6-sonde : un passage du minuteur. Sort en 1 au 3e echec consecutif (OnFailure= -> retour).
cmd_relais6_sonde() {
    _r6_charger || exit 2
    case "$R6_ROLE" in repli|tout) ;; *) exit 0 ;; esac
    [ -n "$R6_LAN_IF" ] || exit 0
    local echecs
    if _r6_routeur_ok; then _r6_ecrire_etat 0 true; exit 0; fi
    echecs=$(( $(_r6_echecs) + 1 ))
    _r6_ecrire_etat "$echecs" false
    if [ "$echecs" -ge "$R6_SEUIL" ]; then
        _audit relais6_sonde echec "$echecs echecs consecutifs : retour a la Freebox"
        exit 1
    fi
}

cmd_relais6_etat() {
    _r6_charger || exit 2
    local nh="" timer=false ra=false table=false dropin=false adresse=false route=false
    if [ "$R6_ROLE" = "repli" ] || [ "$R6_ROLE" = "tout" ]; then
        nh="$(_freeboxctl nexthop-lire 2>/dev/null || true)"
        systemctl is-active --quiet "$R6_TIMER" 2>/dev/null && timer=true
    fi
    if [ "$R6_ROLE" = "routeur" ] || [ "$R6_ROLE" = "tout" ]; then
        systemctl is-active --quiet "$R6_UNITE_RA" 2>/dev/null && ra=true
        command -v "$NFT" >/dev/null 2>&1 && "$NFT" list table inet secubox_relais6 >/dev/null 2>&1 && table=true
        compgen -G "$R6_NETWORKD_DIR/*.network.d/$R6_DROPIN" >/dev/null && dropin=true
        if [ -n "$R6_LAN_IF" ]; then
            ip -6 addr show dev "$R6_LAN_IF" 2>/dev/null | grep -F " ${R6_ADRESSE_FIXE} " >/dev/null && adresse=true
            ip -6 route show default dev "$R6_LAN_IF" 2>/dev/null | grep -F "via ${R6_PASSERELLE_LL} " >/dev/null && route=true
        fi
    fi
    NH="$nh" ROLE="$R6_ROLE" LAN_IF="$R6_LAN_IF" PREFIXE="$R6_PREFIXE" ROUTEUR_LL="$R6_ROUTEUR_LL" \
    TIMER="$timer" RA="$ra" TABLE="$table" DROPIN="$dropin" ADRESSE="$adresse" ROUTE="$route" ETAT="$R6_ETAT" python3 - <<'PYEOF'
import json, os
e = os.environ
b = lambda k: e[k] == "true"
r = {"role": e["ROLE"], "lan_if": e["LAN_IF"] or None, "prefixe": e["PREFIXE"] or None, "routeur_ll": e["ROUTEUR_LL"] or None}
if e["ROLE"] in ("repli", "tout"):
    try:
        lu = json.loads(e["NH"])
        if "erreur" in lu:
            raise ValueError
        nh = {"prefix": lu.get("prefix"), "next_hop": lu.get("next_hop")}
    except ValueError:
        nh = None
    try:
        with open(e["ETAT"]) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    r.update({"next_hop_lu": nh, "actif": bool(nh) and nh["next_hop"] == e["ROUTEUR_LL"],
              "sonde": {"armee": b("TIMER"), "echecs_consecutifs": s.get("echecs_consecutifs", 0),
                        "historique": s.get("historique", [])[-10:]}})
if e["ROLE"] in ("routeur", "tout"):
    r.update({"annonces_ra": b("RA"), "table_nft": b("TABLE"), "dropin_networkd": b("DROPIN"),
              "adresse_fixe_posee": b("ADRESSE"), "route_freebox": b("ROUTE"),
              "pret": all(b(k) for k in ("RA", "TABLE", "DROPIN", "ADRESSE", "ROUTE"))})
print(json.dumps(r))
PYEOF
}

# Hors du bac a sable de l'API (#3803) : lance par l'API (sudo), le ctl herite de son
# ProtectSystem=strict (/etc en lecture seule). Les commandes qui ECRIVENT se relancent
# donc en tache systemd transitoire, root, hors bac a sable ; sortie et code transmis.
case "${1:-}" in
    activer|activer-transfert|retour-freebox|relais6-preparer|relais6-retirer|relais6-basculer|relais6-revenir)
        rep_nft="$(dirname "$NFT_OUT_DEFAUT")"
        if [ "$(id -u)" = 0 ] && [ -d "$rep_nft" ] && [ ! -w "$rep_nft" ] \
            && command -v systemd-run >/dev/null 2>&1 && [ -z "${SECUBOX_PR_HORS_BAC:-}" ]; then
            exec systemd-run --quiet --wait --pipe --collect \
                --unit="pseudo-routeur-$1-$$" --setenv=SECUBOX_PR_HORS_BAC=1 \
                "$(readlink -f "$0")" "$@"
        fi ;;
esac

case "${1:-}" in
    relais6-preparer|relais6-retirer|relais6-basculer|relais6-revenir|relais6-sonde) _r6_verrou ;;
esac

case "${1:-}" in
    generer-chaine) cmd_generer_chaine ;;
    activer-transfert) cmd_activer_transfert ;;
    etat-transfert) cmd_etat_transfert ;;
    activer) cmd_activer ;;
    retour-freebox) cmd_retour_freebox ;;
    etat) cmd_etat ;;
    apercu) cmd_apercu ;;
    etat-complet) cmd_etat_complet ;;
    appareils) cmd_appareils ;;
    tester-retour) cmd_tester_retour ;;
    relais6-preparer) cmd_relais6_preparer ;;
    relais6-retirer) cmd_relais6_retirer ;;
    relais6-etat) cmd_relais6_etat ;;
    relais6-basculer) cmd_relais6_basculer ;;
    relais6-revenir) cmd_relais6_revenir ;;
    relais6-sonde) cmd_relais6_sonde ;;
    *) echo "usage : pseudo-routeurctl generer-chaine|activer-transfert|etat-transfert|activer|retour-freebox|etat|apercu|etat-complet|appareils|tester-retour|relais6-preparer|relais6-retirer|relais6-etat|relais6-basculer|relais6-revenir|relais6-sonde" >&2; exit 2 ;;
esac
