# SecuBox Pseudo-routeur — retour du préfixe IPv6 à la Freebox (#3807). Déclenché par OnFailure= de
# pseudo-routeur-relais6-sonde.service : inconditionnel (next hop vidé, minuterie désarmée).
[Unit]
Description=SecuBox Pseudo-routeur — retour du préfixe IPv6 à la Freebox (#3807)

[Service]
Type=oneshot
ExecStart=/usr/sbin/pseudo-routeurctl relais6-revenir
