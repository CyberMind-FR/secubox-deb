# SecuBox-Deb :: secubox-pseudo-routeur — cadence de la sonde de secours (#2940)
#
# OnActiveSec ET OnUnitActiveSec ensemble (motif #2919/#2925) : une minuterie qui n'a
# que OnUnitActiveSec ne repart pas seule apres une reactivation (mise a jour du
# paquet, redemarrage du module). Une sonde par minute : trois echecs consecutifs =
# trois minutes avant le retour automatique (contrainte globale du plan #2940).

[Unit]
Description=SecuBox Pseudo-routeur — sonde de secours, toutes les 60 s (#2940)

[Timer]
# #3355 : décalage aléatoire stable par box (FixedRandomDelay), pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=15s
FixedRandomDelay=true
AccuracySec=6s
OnActiveSec=60s
OnUnitActiveSec=60s

[Install]
WantedBy=timers.target
