# SecuBox Pseudo-routeur — API locale (#2940). Utilisateur dédié, sans capacité ; toute action
# privilégiée est déléguée à pseudo-routeurctl (root, confiné) par sudo -n (NoNewPrivileges=no,
# requis pour que sudo fonctionne — même motif que secubox-jellyfin).
[Unit]
Description=SecuBox Pseudo-routeur (API, #2940)
After=network.target secubox-core.service

[Service]
Type=simple
User=secubox-pseudo-routeur
Group=secubox
WorkingDirectory=/usr/lib/secubox/pseudo-routeur
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# /run/secubox est PARTAGÉ et collant (1777) : on n'y délie que ce qu'on possède.
ExecStartPre=+/bin/rm -f /run/secubox/pseudo-routeur.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/pseudo-routeur.sock --workers 1 --log-level warning
ExecStartPost=/bin/sh -c 'for i in $(seq 1 1200); do [ -S /run/secubox/pseudo-routeur.sock ] && break; sleep 0.1; done; chmod 660 /run/secubox/pseudo-routeur.sock'
TimeoutStartSec=180
Restart=on-failure
RestartSec=5
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/secubox /var/lib/secubox/pseudo-routeur
UMask=0027

[Install]
WantedBy=multi-user.target
