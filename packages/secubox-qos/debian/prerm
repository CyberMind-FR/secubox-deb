#!/bin/bash
set -e
case "$1" in
  remove|deconfigure)
    rm -f /etc/nginx/secubox.d/qos.conf
    systemctl reload nginx 2>/dev/null || true
    ;;
  upgrade)
    # Don't remove nginx config on upgrade
    ;;
esac
systemctl stop    secubox-qos.service 2>/dev/null || true
systemctl disable secubox-qos.service 2>/dev/null || true
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/qos/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "qos : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
