"""
SecuBox-Deb :: secubox-release-repo — thin wrapper for repo-host cron/timers.

Just execs `secubox-releasectl sync-repo` with the same argv/env (so
ANNUAIRE_JOURNAL/ANNUAIRE_KEY_PATH/ANNUAIRE_LIB/RELEASE_LIB/DRYRUN all pass
through unchanged) — kept separate so a systemd timer / cron entry has a
single, clearly-named entry point without duplicating any logic here.
"""
from __future__ import annotations

import os
import sys

CTL = os.path.join(os.path.dirname(os.path.abspath(__file__)), "secubox-releasectl")


def main() -> int:
    os.execv(sys.executable, [sys.executable, CTL, "sync-repo", *sys.argv[1:]])


if __name__ == "__main__":
    raise SystemExit(main())
