[Unit]
Description=SecuBox Release Rings — REST API (unix socket)
After=network.target

# /run/secubox N'EST PAS UN RuntimeDirectory (#1022).
#
# Il est PARTAGE par une centaine de modules. `RuntimeDirectory=` est concu pour
# un repertoire PROPRE a un service : systemd le recree a chaque demarrage avec
# le mode de l'unite, donc le dernier service demarre imposait le sien. Huit
# unites le posaient en 0755, ce qui privait tous les autres du droit d'y creer
# leur socket — « bind: permission denied », et un 502 dont la cause etait le
# redemarrage d'un module sans rapport, survenu entre-temps.
#
# Le meme mecanisme effacait le repertoire a l'arret d'un service, emportant les
# sockets des quatre-vingt-dix autres.
#
# Il est desormais declare une seule fois, en 1777, par le tmpfiles.d de
# secubox-core — un seul proprietaire, une seule verite.
[Service]
Type=simple
User=secubox
Group=secubox
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/release.sock --log-level warning
WorkingDirectory=/usr/lib/secubox/release
Environment=PYTHONPATH=/usr/lib/secubox/release:/usr/lib/secubox/annuaire
Restart=on-failure
# The API never sudoes: api/main.py execs `/usr/sbin/secubox-releasectl`
# directly (subprocess.run, no "sudo" in argv) for publish/promote/demote/
# assign — those ops sign a journal entry with the box's own node key, which
# this process reaches as itself (secubox), not as root (see the guarded
# `chmod o+x /etc/secubox/secrets` in debian/postinst — same traversal fix
# secubox-assist shipped in 0.2.1 for its own ctl-as-secubox path). Unlike
# secubox-assist's WS daemon (which DOES sudo into its ctl and therefore
# needs NoNewPrivileges=false), this unit keeps full NNP hardening.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
