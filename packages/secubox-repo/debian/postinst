#!/bin/bash
set -e

case "$1" in
    configure)
        # Create directories
        mkdir -p /var/lib/secubox-repo/{conf,gpg}
        mkdir -p /var/www/apt.secubox.in/{dists,pool}
        chmod 700 /var/lib/secubox-repo/gpg

        # Set permissions
        chown -R secubox:secubox /var/lib/secubox-repo
        chown -R secubox:secubox /var/www/apt.secubox.in

        # Nginx config is installed directly in secubox.d by the package
        # Reload nginx if running
        if systemctl is-active --quiet nginx 2>/dev/null; then
            systemctl reload nginx || true
        fi

        # Enable and start service
        systemctl daemon-reload
        systemctl enable secubox-repo.service
        systemctl start secubox-repo.service || true
        ;;
esac

#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/repo/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "repo : postinst de $(basename "$_s") en échec" >&2; }
done
exit 0
