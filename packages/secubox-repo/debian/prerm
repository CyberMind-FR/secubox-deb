#!/bin/bash
set -e

case "$1" in
    remove|purge)
        systemctl stop secubox-repo.service || true
        systemctl disable secubox-repo.service || true
        ;;
esac

#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/repo/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "repo : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
