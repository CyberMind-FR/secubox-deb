#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@ --with python3

override_dh_auto_install:
	# Create directories
	install -d $(CURDIR)/debian/secubox-repo/usr/sbin
	install -d $(CURDIR)/debian/secubox-repo/usr/lib/secubox/repo/api
	install -d $(CURDIR)/debian/secubox-repo/usr/share/secubox/www/repo
	install -d $(CURDIR)/debian/secubox-repo/etc/secubox/repo
	install -d $(CURDIR)/debian/secubox-repo/etc/nginx/secubox.d
	install -d $(CURDIR)/debian/secubox-repo/usr/share/secubox/menu.d

	# Install repoctl
	install -m 755 sbin/repoctl $(CURDIR)/debian/secubox-repo/usr/sbin/

	# Install API
	cp -r api/* $(CURDIR)/debian/secubox-repo/usr/lib/secubox/repo/api/

	# Install web frontend
	cp -r www/repo/* $(CURDIR)/debian/secubox-repo/usr/share/secubox/www/repo/ || true

	# Install configuration templates
	cp -r conf/* $(CURDIR)/debian/secubox-repo/etc/secubox/repo/ || true
	cp -r templates/* $(CURDIR)/debian/secubox-repo/etc/secubox/repo/ || true

	# Install nginx config (secubox.d for auto-include in server block)
	install -m 644 debian/nginx-repo.conf $(CURDIR)/debian/secubox-repo/etc/nginx/secubox.d/repo.conf || true

	# Install menu entries (canonical menu.d/ location, matches other packages)
	[ -d menu.d ] && cp -r menu.d/. $(CURDIR)/debian/secubox-repo/usr/share/secubox/menu.d/ || true
	# Composant absorbé : release (#2050)
	install -d debian/secubox-repo/usr/lib/secubox/release/release
	cp -r composants/release/release/*.py debian/secubox-repo/usr/lib/secubox/release/release/
	install -d debian/secubox-repo/usr/lib/secubox/release/api
	cp -r composants/release/api/*.py debian/secubox-repo/usr/lib/secubox/release/api/
	install -d debian/secubox-repo/usr/sbin
	cp -r composants/release/sbin/secubox-releasectl debian/secubox-repo/usr/sbin/
	install -d debian/secubox-repo/usr/sbin
	cp -r composants/release/sbin/secubox-release-repo debian/secubox-repo/usr/sbin/
	install -d debian/secubox-repo/usr/share/secubox/www/releases
	cp -r composants/release/www/releases/* debian/secubox-repo/usr/share/secubox/www/releases/
	install -d debian/secubox-repo/usr/share/secubox/menu.d
	cp -r composants/release/menu.d/*.json debian/secubox-repo/usr/share/secubox/menu.d/
	install -d debian/secubox-repo/etc/nginx/secubox.d
	cp -r composants/release/nginx/releases.conf debian/secubox-repo/etc/nginx/secubox.d/
	install -d debian/secubox-repo/lib/systemd/system
	cp -r composants/release/systemd/*.service debian/secubox-repo/lib/systemd/system/
	install -d debian/secubox-repo/etc/sudoers.d
	cp -r composants/release/sudoers/secubox-release debian/secubox-repo/etc/sudoers.d/
	install -D -m 755 composants/release/debian/postinst debian/secubox-repo/usr/lib/secubox/repo/maintscripts/release.postinst
	install -D -m 755 composants/release/debian/prerm debian/secubox-repo/usr/lib/secubox/repo/maintscripts/release.prerm

override_dh_installsystemd:
	dh_installsystemd --name=secubox-repo
	# Composant release (#2050) : son unité (installée dans lib/systemd/system) garde la gestion dh.
	dh_installsystemd --name=secubox-release-api
