#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Transitoire (#2050) : l'unité secubox-reporter.service est désormais livrée par secubox-metrics. L'ancien prerm
# de la version précédente l'arrête à la mise à jour ; on la rétablit une fois l'absorbant configuré.
set -e
#DEBHELPER#
if [ "$1" = configure ] && [ -e /usr/lib/systemd/system/secubox-reporter.service -o -e /lib/systemd/system/secubox-reporter.service ]; then
    if [ "$(systemctl is-enabled secubox-reporter.service 2>/dev/null)" != masked ]; then
        systemctl enable secubox-reporter.service >/dev/null 2>&1 || true
        systemctl start secubox-reporter.service >/dev/null 2>&1 || true
    fi
fi
exit 0
