[Unit]
Description=SecuBox RezApp API
After=network.target secubox-core.service docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/usr/lib/secubox/rezapp
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/rezapp.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/rezapp.sock --log-level warning
UMask=0117
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
