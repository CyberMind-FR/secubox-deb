# secubox-rpi-dsi (#3399) : au purge, dernier nettoyage de l'overlay (déjà fait par le prerm).
# ROOTPART est laissé volontairement dans /etc/default/raspi-firmware : le retirer rendrait
# la box non démarrable à la prochaine régénération de cmdline.txt.
set -e
if [ "$1" = "purge" ]; then
    rm -f /boot/firmware/overlays/secubox-dsi-7inch.dtbo
    if [ -f /etc/default/raspi-firmware-custom ]; then
        sed -i '/^[[:space:]]*dtoverlay=secubox-dsi-7inch\([,[:space:]]\|$\)/d' /etc/default/raspi-firmware-custom
    fi
fi
#DEBHELPER#
exit 0
