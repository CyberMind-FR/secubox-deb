# secubox-rpi-dsi (#3399) : au démarrage, configure l'écran 7" si les modules DKMS manquent pour le
# noyau courant (premier démarrage d'une image, linux-source arrivé après linux-image). Idempotent :
# ne fait rien si tout est en place. Root requis (dkms, /lib/modules, /boot/firmware, /etc/default) :
# exception § 10 inscrite dans .claude/RULES-CODE.md.
[Unit]
Description=SecuBox - official RPi 7" DSI display: DKMS modules and overlay check
ConditionPathExists=/proc/device-tree/model
ConditionPathExists=/usr/sbin/secubox-rpi-dsi
After=local-fs.target time-sync.target
Before=display-manager.service getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-rpi-dsi boot-check
TimeoutStartSec=45min
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0022

[Install]
WantedBy=multi-user.target
