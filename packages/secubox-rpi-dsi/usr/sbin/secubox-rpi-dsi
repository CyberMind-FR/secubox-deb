# See LICENCE-CMSD-1.0.md for terms.

# SecuBox-Deb :: secubox-rpi-dsi (#3399) — écran officiel RPi 7" DSI sur noyau Debian.
#
#   is-target          0 si Raspberry Pi 4 / 400 (/proc/device-tree/model)
#   rootpart-ok        0 si ROOTPART est défini ET sûr (UUID=, PARTUUID= ou chemin existant ;
#                      jamais /dev/mmcblk0p* sur RPi4/400)
#   ensure-rootpart    fixe ROOTPART=UUID=<racine> s'il manque ou n'est pas sûr (une valeur sûre
#                      n'est jamais écrasée ; une valeur non sûre est mise en commentaire) ; rc 1 sinon
#   install-overlay    .dtbo dans /boot/firmware/overlays/ + dtoverlay=secubox-dsi-7inch dans
#                      /etc/default/raspi-firmware-custom
#   remove-overlay     retire la ligne et le .dtbo (ROOTPART reste en place)
#   dkms-sync [ver]    retire les autres versions DKMS, ajoute <ver> et l'installe pour chaque noyau
#   dkms-remove [ver]  dkms remove --all
#   update-initramfs   update-initramfs -u -k all, REFUSÉ si ROOTPART n'est pas sûr
#   configure          tout : ROOTPART, overlay, DKMS, initramfs (inerte hors RPi4/400 et en chroot)
#   boot-check         au démarrage : configure seulement si les modules manquent pour le noyau courant
#
# Pourquoi ROOTPART : raspi-firmware (appelé par update-initramfs) régénère cmdline.txt avec
# root=/dev/mmcblk0p2 par défaut, or la SD est mmcblk1 sous noyau Debian sur RPi4 : box morte.
# config.txt n'est jamais édité directement.
#
# Variables de test (SEULEMENT si SECUBOX_TEST=1 et euid != 0) : SECUBOX_RPI_DSI_MODEL,
# SECUBOX_RPI_DSI_RFCONF, SECUBOX_RPI_DSI_RFCUSTOM, SECUBOX_RPI_DSI_OVERLAYS, SECUBOX_RPI_DSI_DTBO,
# SECUBOX_RPI_DSI_ROOTUUID, SECUBOX_RPI_DSI_AUDIT, SECUBOX_RPI_DSI_INITRAMFS, SECUBOX_RPI_DSI_DKMS,
# SECUBOX_RPI_DSI_MODULES, SECUBOX_RPI_DSI_KVER, SECUBOX_RPI_DSI_VERSION, SECUBOX_RPI_DSI_CHROOT.
set -euo pipefail

say() { echo "secubox-rpi-dsi: $*" >&2; }

readonly NOM="secubox-rpi-dsi"
MODEL=/proc/device-tree/model
RFCONF=/etc/default/raspi-firmware
RFCUSTOM=/etc/default/raspi-firmware-custom
OVERLAYS=/boot/firmware/overlays
DTBO=/usr/lib/secubox-rpi-dsi/secubox-dsi-7inch.dtbo
AUDIT=/var/log/secubox/audit.log
INITRAMFS=update-initramfs
DKMS=dkms
MODULES=/lib/modules
KVER="$(uname -r)"
VERSION=""
CHROOT=""
ROOTUUID=""
readonly LIGNE="dtoverlay=secubox-dsi-7inch"
readonly RE_LIGNE="^[[:space:]]*${LIGNE}([,[:space:]]|$)"

if [[ "${SECUBOX_TEST:-}" == "1" && "$(id -u)" != "0" ]]; then
    MODEL="${SECUBOX_RPI_DSI_MODEL:-$MODEL}"
    RFCONF="${SECUBOX_RPI_DSI_RFCONF:-$RFCONF}"
    RFCUSTOM="${SECUBOX_RPI_DSI_RFCUSTOM:-$RFCUSTOM}"
    OVERLAYS="${SECUBOX_RPI_DSI_OVERLAYS:-$OVERLAYS}"
    DTBO="${SECUBOX_RPI_DSI_DTBO:-$DTBO}"
    AUDIT="${SECUBOX_RPI_DSI_AUDIT:-$AUDIT}"
    INITRAMFS="${SECUBOX_RPI_DSI_INITRAMFS:-$INITRAMFS}"
    DKMS="${SECUBOX_RPI_DSI_DKMS:-$DKMS}"
    MODULES="${SECUBOX_RPI_DSI_MODULES:-$MODULES}"
    KVER="${SECUBOX_RPI_DSI_KVER:-$KVER}"
    VERSION="${SECUBOX_RPI_DSI_VERSION:-}"
    CHROOT="${SECUBOX_RPI_DSI_CHROOT:-}"
    ROOTUUID="${SECUBOX_RPI_DSI_ROOTUUID:-}"
fi

TMPF=""
trap '[[ -n "$TMPF" ]] && rm -f -- "$TMPF"' EXIT

# Ajout au journal d'audit SANS suivre de lien symbolique (O_NOFOLLOW) ; jamais bloquant.
audit() {
    [[ -d "$(dirname "$AUDIT")" ]] || return 0
    local ligne
    ligne="$(date -u +%Y-%m-%dT%H:%M:%SZ) rpi-dsi $*"
    python3 -I -c '
import os, sys
fd = os.open(sys.argv[1], os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o640)
try:
    os.write(fd, (sys.argv[2] + "\n").encode())
finally:
    os.close(fd)
' "$AUDIT" "$ligne" 2>/dev/null || say "audit non écrit (lien refusé ou erreur) : $*"
}

is_chroot() {
    [[ -n "$CHROOT" ]] && { [[ "$CHROOT" == 1 ]]; return; }
    # Lancé par systemd sur la machine : l'espace de montage isolé de l'unité trompe ischroot, qui croit à un chroot (#3523).
    [[ -n "${INVOCATION_ID:-}" ]] && return 1
    command -v ischroot >/dev/null 2>&1 && ischroot
}

is_target() {
    [[ -r "$MODEL" ]] || return 1
    local m
    m="$(tr -d '\0' < "$MODEL")"
    [[ "$m" == "Raspberry Pi 4 Model B"* || "$m" == "Raspberry Pi 400"* ]]
}

# Valeur effective de ROOTPART (dernière affectation non commentée), vide sinon.
rootpart_valeur() {
    [[ -r "$RFCONF" ]] || { echo ""; return 0; }
    sed -n -E 's/^[[:space:]]*ROOTPART=["'\'']?([^"'\'']*)["'\'']?[[:space:]]*$/\1/p' "$RFCONF" | tail -n1
}

valeur_sure() {
    local v="$1"
    [[ -n "$v" ]] || return 1
    if [[ "$v" == /dev/mmcblk0p* ]] && is_target; then return 1; fi
    [[ "$v" =~ ^(UUID|PARTUUID)=[0-9A-Fa-f-]+$ ]] && return 0
    [[ "$v" == /* && -e "$v" ]]
}

rootpart_ok() { valeur_sure "$(rootpart_valeur)"; }

# Écriture atomique : temporaire dans le même répertoire, sync, puis mv ; nettoyé en cas d'échec.
remplacer() {
    local cible="$1"
    TMPF="$(mktemp "$(dirname "$cible")/.secubox-rpi-dsi.XXXXXX")"
    cat > "$TMPF"
    if [[ -e "$cible" ]]; then chmod --reference="$cible" "$TMPF"; else chmod 0644 "$TMPF"; fi
    sync -- "$TMPF"
    mv -f -- "$TMPF" "$cible"
    TMPF=""
}

ensure_rootpart() {
    local actuelle
    actuelle="$(rootpart_valeur)"
    if valeur_sure "$actuelle"; then
        say "ROOTPART déjà défini et sûr ($actuelle) : inchangé"
        return 0
    fi
    local uuid="$ROOTUUID"
    [[ -n "$uuid" ]] || uuid="$(findmnt -n -o UUID / 2>/dev/null || true)"
    if [[ ! "$uuid" =~ ^[0-9A-Fa-f-]+$ ]]; then
        say "UUID de la racine introuvable : ROOTPART non fixé, update-initramfs sera refusé"
        return 1
    fi
    {
        if [[ -r "$RFCONF" ]]; then
            # toute affectation non sûre (vide, /dev/mmcblk0p*) est mise en commentaire
            sed -E 's/^([[:space:]]*ROOTPART=.*)$/# secubox-rpi-dsi (non sûr) : \1/' "$RFCONF"
        fi
        echo "# SecuBox #3399 : la SD est mmcblk1 sous noyau Debian (RPi4), jamais mmcblk0p2"
        echo "ROOTPART=UUID=$uuid"
    } | remplacer "$RFCONF"
    audit "ROOTPART=UUID=$uuid fixé dans $RFCONF (ancienne valeur : '${actuelle}')"
    say "ROOTPART=UUID=$uuid fixé dans $RFCONF"
}

install_overlay() {
    [[ -r "$DTBO" ]] || { say "$DTBO absent"; return 1; }
    if [[ -d "$OVERLAYS" ]]; then
        remplacer "$OVERLAYS/secubox-dsi-7inch.dtbo" < "$DTBO"
        chmod 0644 "$OVERLAYS/secubox-dsi-7inch.dtbo"
    else
        say "$OVERLAYS absent : overlay non copié (raspi-firmware installé ?)"
    fi
    if [[ ! -e "$RFCUSTOM" ]] || ! grep -q -E "$RE_LIGNE" "$RFCUSTOM"; then
        { [[ -r "$RFCUSTOM" ]] && cat "$RFCUSTOM"; echo "$LIGNE"; } | remplacer "$RFCUSTOM"
        audit "$LIGNE ajouté à $RFCUSTOM"
    fi
}

remove_overlay() {
    if [[ -r "$RFCUSTOM" ]] && grep -q -E "$RE_LIGNE" "$RFCUSTOM"; then
        { grep -v -E "$RE_LIGNE" "$RFCUSTOM" || true; } | remplacer "$RFCUSTOM"
        audit "$LIGNE retiré de $RFCUSTOM"
    fi
    rm -f -- "$OVERLAYS/secubox-dsi-7inch.dtbo"
}

version_paquet() {
    local v="$VERSION"
    [[ -n "$v" ]] || v="$(dpkg-query -W -f='${Version}' "$NOM" 2>/dev/null || true)"
    v="${v#*:}"; echo "${v%-*}"
}

# Versions enregistrées dans DKMS (« secubox-rpi-dsi/0.1.0, ... » ou « secubox-rpi-dsi/0.1.0: added »).
versions_dkms() {
    "$DKMS" status -m "$NOM" 2>/dev/null | sed -n -E "s|^${NOM}/([^,:[:space:]]+).*|\\1|p" | sort -u
}

dkms_remove() {
    local v="${1:-}"
    [[ -n "$v" ]] || return 0
    if "$DKMS" remove -m "$NOM" -v "$v" --all; then
        audit "dkms remove $NOM/$v --all"
    else
        say "dkms remove $NOM/$v en échec"
    fi
}

dkms_sync() {
    local ver="${1:-$(version_paquet)}" v k rc=0
    [[ -n "$ver" ]] || { say "version du paquet inconnue"; return 1; }
    # Montée de version : une seule version enregistrée.
    while read -r v; do
        [[ -n "$v" && "$v" != "$ver" ]] && dkms_remove "$v"
    done < <(versions_dkms)
    if ! versions_dkms | grep -qx -- "$ver"; then
        "$DKMS" add -m "$NOM" -v "$ver" || { say "dkms add $NOM/$ver en échec"; return 1; }
    fi
    for k in "$MODULES"/*; do
        k="${k##*/}"
        [[ -e "$MODULES/$k/build" ]] || continue
        if "$DKMS" install -m "$NOM" -v "$ver" -k "$k"; then
            audit "dkms install $NOM/$ver pour $k"
        else
            audit "dkms install $NOM/$ver pour $k : ÉCHEC (aucun module partiel)"
            say "DKMS en échec pour $k (aucun module partiel installé)"
            rc=1
        fi
    done
    return "$rc"
}

update_initramfs() {
    if ! rootpart_ok; then
        say "ROOTPART absent ou non sûr dans $RFCONF : update-initramfs REFUSÉ (cmdline.txt deviendrait root=/dev/mmcblk0p2)"
        audit "update-initramfs refusé : ROOTPART non sûr"
        return 1
    fi
    if "$INITRAMFS" -u -k all; then
        audit "update-initramfs -u -k all"
    else
        audit "update-initramfs -u -k all : ÉCHEC"
        return 1
    fi
}

# Plymouth a besoin de l'écran dès l'initramfs, et de splash au démarrage (#3525).
ecran_au_demarrage() {
    local m f=/etc/initramfs-tools/modules
    for m in i2c_mux_pinctrl rpi_panel_attiny_regulator vc4 tc358762 panel_simple; do
        grep -qx "$m" "$f" 2>/dev/null || echo "$m" >> "$f"
    done
    printf 'quiet splash plymouth.ignore-serial-consoles\n' > /etc/default/raspi-extra-cmdline
}

configure() {
    if is_chroot; then
        say "chroot détecté : rien n'est activé (l'unité secubox-rpi-dsi-boot le fera au premier démarrage)"
        return 0
    fi
    if ! is_target; then
        say "matériel autre que Raspberry Pi 4/400 : rien n'est activé (paquet inerte)"
        return 0
    fi
    local rootok=1 rc=0
    ensure_rootpart || rootok=0
    install_overlay || say "overlay non installé"
    dkms_sync || rc=1
    if [[ $rootok == 1 ]]; then
        ecran_au_demarrage || rc=1
        update_initramfs || rc=1
    else
        say "ROOTPART indéterminable : update-initramfs NON lancé (voir README, « Déblocage »)"
        rc=1
    fi
    [[ $rc == 0 ]] && say "écran 7\" prêt au prochain redémarrage."
    return "$rc"
}

modules_presents() {
    local d="$MODULES/$KVER/updates/dkms" n
    for n in vc4 tc358762 panel-simple edt-ft5x06; do
        compgen -G "$d/$n.ko*" >/dev/null || return 1
    done
}

boot_check() {
    is_target || { say "matériel autre que Raspberry Pi 4/400 : rien à faire"; return 0; }
    if modules_presents && rootpart_ok && [[ -r "$RFCUSTOM" ]] && grep -q -E "$RE_LIGNE" "$RFCUSTOM"; then
        say "modules DKMS présents pour $KVER : rien à faire"
        return 0
    fi
    say "configuration manquante pour $KVER : configure"
    configure
}

case "${1:-}" in
    is-target)        is_target ;;
    rootpart-ok)      rootpart_ok ;;
    ensure-rootpart)  ensure_rootpart ;;
    install-overlay)  install_overlay ;;
    remove-overlay)   remove_overlay ;;
    dkms-sync)        dkms_sync "${2:-}" ;;
    dkms-remove)      dkms_remove "${2:-$(version_paquet)}" ;;
    update-initramfs) update_initramfs ;;
    configure)        configure ;;
    boot-check)       boot_check ;;
    *) say "usage : $0 is-target|rootpart-ok|ensure-rootpart|install-overlay|remove-overlay|dkms-sync [ver]|dkms-remove [ver]|update-initramfs|configure|boot-check"; exit 2 ;;
esac
