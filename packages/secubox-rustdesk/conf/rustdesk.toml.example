# /etc/secubox/rustdesk.toml — SecuBox RustDesk module configuration

[lxc]
name         = "rustdesk"
ip           = "10.100.0.90"
gateway      = "10.100.0.1"
bridge       = "br-lxc"
path         = "/data/lxc"
debian_suite = "bookworm"

[rustdesk]
# hbbs (signal) + hbbr (relay) versions — keep in sync with the upstream release URL
version              = "1.1.11"
release_url          = "https://github.com/rustdesk/rustdesk-server/releases/download/1.1.11/rustdesk-server-linux-amd64.zip"
install_dir          = "/opt/rustdesk"
data_dir             = "/var/lib/rustdesk"
# Internal ports (inside the LXC, also exposed via HAProxy stream / nftables DNAT)
hbbs_signal_tcp_port = 21116
hbbs_signal_udp_port = 21116
hbbs_natutil_port    = 21115
hbbr_relay_port      = 21117
web_admin_port       = 21114

[exposure]
# Public hostname for the WEB ADMIN UI (TCP only — HAProxy + nginx).
# The four raw ports (21115/21116-tcp/21116-udp/21117) are forwarded via
# HAProxy stream-mode (TCP) and nftables DNAT (UDP) directly to LXC IP.
public_hostname = ""
# RustDesk client cfg — embed in client builds: relay = "<public_ip>", key = "<see secrets>"
relay_public_ip = ""

[security]
# Optional pre-shared key for the rustdesk-server (clients must use this).
# Generated by install-lxc.sh into /etc/secubox/secrets/rustdesk-key (base64 ed25519).
key_file        = "/etc/secubox/secrets/rustdesk-key"
allow_lan_only  = false   # set true to skip nftables DNAT (no public UDP exposure)
