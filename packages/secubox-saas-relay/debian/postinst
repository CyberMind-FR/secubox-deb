#!/bin/bash
set -e
case "$1" in
  configure)
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    install -d -o root -g root -m 1777 /run/secubox
    install -d -o secubox -g secubox -m 755 /var/lib/secubox
    install -d -o secubox -g secubox -m 750 /var/lib/secubox/saas-relay
    # Parent partagé, propriété de secubox-core (root:secubox 0750, #1689).
    install -d -o root -g secubox -m 0750 /etc/secubox/secrets
    # Le service créait sa clé au premier démarrage, dans ce parent : il n'y
    # écrit plus (0750 root). On la crée ici, au format de Fernet.generate_key().
    if [ ! -s /etc/secubox/secrets/saas-relay.key ]; then
        ( umask 077; python3 -c 'import base64,os,sys; sys.stdout.write(base64.urlsafe_b64encode(os.urandom(32)).decode())' \
            > /etc/secubox/secrets/saas-relay.key )
        chown secubox:secubox /etc/secubox/secrets/saas-relay.key
        chmod 0600 /etc/secubox/secrets/saas-relay.key
    fi
    install -d -o secubox -g secubox -m 750 /var/cache/secubox/saas-relay
    systemctl daemon-reload
    systemctl enable secubox-saas-relay.service
    systemctl start secubox-saas-relay.service || true
    ;;
esac
#DEBHELPER#
