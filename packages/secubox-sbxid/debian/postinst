set -e

DOMAIN="identity.gk2.secubox.in"
NGX_AVAIL="/etc/secubox/nginx-available/identity.conf"
WAF_ROUTES="/etc/secubox/waf/haproxy-routes.json"

case "$1" in
  configure)
    # Données : sbx.db (personnes, appareils, rôles, certificats, journal).
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/sbxid

    # ── ACCÈS, ABSORBÉ (#1424) : ce que faisait le postinst de secubox-acces ──
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/acces
    if systemctl list-unit-files secubox-acces.service >/dev/null 2>&1; then
      systemctl disable --now secubox-acces.service >/dev/null 2>&1 || true
      rm -f /lib/systemd/system/secubox-acces.service
      systemctl daemon-reload || true
    fi
    if [ -f /etc/secubox/nginx-available/acces.conf ] && [ -d /etc/nginx/sites-enabled ]; then
      rm -f /etc/nginx/sites-enabled/acces.conf
      if nginx -t >/dev/null 2>&1; then BASE_SAINE=1; else BASE_SAINE=0; fi
      cp -f /etc/secubox/nginx-available/acces.conf /etc/nginx/sites-enabled/acces.conf
      if [ "$BASE_SAINE" = 1 ] && ! nginx -t >/dev/null 2>&1; then
        rm -f /etc/nginx/sites-enabled/acces.conf
        echo "secubox-sbxid: vhost acces refusé par nginx -t, non activé" >&2
      fi
    fi

    # Déclaration dans l'agrégateur (qui sert /api/v1/sbxid).
    python3 - <<'TOML' || echo "secubox-sbxid: déclaration dans aggregator.toml impossible" >&2
import pathlib, re
f = pathlib.Path("/etc/secubox/aggregator.toml")
if f.exists():
    s = f.read_text()
    for mod in ("acces", "sbxid"):
        if f'"{mod}"' not in s:
            s = re.sub(r'modules\s*=\s*\[', 'modules = [\n    "' + mod + '",', s, count=1)
            print("secubox-sbxid: " + mod + " déclaré dans aggregator.toml")
    f.write_text(s)
TOML

    # identity.gk2 → le Hall : vhost, HAProxy, route WAF (idempotent).
    if [ -f "$NGX_AVAIL" ] && [ -d /etc/nginx/sites-enabled ]; then
      cp -f "$NGX_AVAIL" /etc/nginx/sites-available/identity.conf
      ln -sf ../sites-available/identity.conf /etc/nginx/sites-enabled/identity.conf
      if ! nginx -t >/dev/null 2>&1; then
        rm -f /etc/nginx/sites-enabled/identity.conf
        echo "secubox-sbxid: vhost refusé par nginx -t, non activé" >&2
      fi
      nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
    fi
    if command -v haproxyctl >/dev/null 2>&1 && [ -f /etc/secubox/haproxy.toml ]; then
      if ! grep -q "identity_gk2_secubox_in" /etc/secubox/haproxy.toml 2>/dev/null; then
        haproxyctl vhost add "$DOMAIN" nginx_vhosts true >/dev/null 2>&1 || true
        haproxyctl generate >/dev/null 2>&1 || true
        systemctl reload haproxy >/dev/null 2>&1 || true
      fi
    fi
    if [ -f "$WAF_ROUTES" ]; then
      python3 - "$WAF_ROUTES" "$DOMAIN" <<'PY' || true
import json, sys
p, dom = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(p))
except Exception:
    d = {}
if d.get(dom) != ["127.0.0.1", 9080]:
    d[dom] = ["127.0.0.1", 9080]
    json.dump(d, open(p, "w"), indent=2)   # sbxwaf recharge la table à chaud
PY
    fi

    if [ -d /run/systemd/system ]; then
      systemctl restart secubox-aggregator >/dev/null 2>&1 || true
    fi
    ;;
esac
#DEBHELPER#
exit 0
