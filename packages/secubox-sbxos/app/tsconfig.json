{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"], "noEmit": true,
    "paths": {
      "@sbx/tokens": ["../sbx-sdk/tokens/index.ts"], "@sbx/icons": ["../sbx-sdk/icons/index.tsx"],
      "@sbx/data": ["../sbx-sdk/data/index.ts"], "@sbx/protocol": ["../sbx-sdk/protocol/enfant.ts"], "@sbx/hote": ["../sbx-sdk/protocol/hote.ts"], "@sbx/voix/*": ["../sbx-sdk/voix/*"], "@sbx/ui/*": ["../sbx-sdk/ui/*"], "@sbx/art/*": ["../sbx-sdk/*"]
    }
  },
  "include": ["src", "../sbx-sdk", "../vitrine"], "exclude": ["../vitrine/vite.config.ts", "../sbx-sdk/**/tests"]
}
