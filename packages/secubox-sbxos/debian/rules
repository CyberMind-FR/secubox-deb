#!/usr/bin/make -f
%:
	dh $@

# Le front Aurora est construit AVANT, par scripts/construire-front.sh (#1611) :
# debian/rules ne lance jamais npm, il vérifie que le dist correspond aux
# sources (empreinte), à la version (amont, sans ~<suite>N) et au canal.
AMONT := $(shell dpkg-parsechangelog -SVersion | sed -E 's/-[^-]+$$//; s/~(bookworm|trixie)[0-9]*$$//')

override_dh_auto_build:
	test -f dist/aurora/index.html || { echo "dist absent : lancer scripts/construire-front.sh packages/secubox-sbxos" >&2; exit 1; }
	test -f dist/.construit || { echo "dist/.construit absent" >&2; exit 1; }
	grep -q '"version":"$(AMONT)"' dist/.construit || { echo "dist construit pour une autre version que $(AMONT)" >&2; exit 1; }
	grep -q "\"empreinte\":\"$$(bash ../../scripts/empreinte-front.sh .)\"" dist/.construit || { echo "dist périmé : sources modifiées depuis la construction" >&2; exit 1; }
	case "$(AMONT)" in *~aurora*) grep -q '"canal":"apercu"' dist/.construit ;; *) ! grep -q '"canal":"apercu"' dist/.construit ;; esac || { echo "canal incohérent avec la version" >&2; exit 1; }
	case "$(AMONT)" in *~aurora*) [ "$${GITHUB_REF_TYPE:-}" != "tag" ] || { echo "une version ~aurora ne se construit pas sur une étiquette" >&2; exit 1; } ;; esac

override_dh_auto_install:
	# La PWA vit sous son PROPRE chemin : le périmètre d'un service worker est
	# son répertoire.
	install -d debian/secubox-sbxos/usr/share/secubox/www/sbxos
	cp -r www/. debian/secubox-sbxos/usr/share/secubox/www/sbxos/
	# Aurora (aperçu) : /sbxos/aurora/, fichiers hachés /sbxos/assets/, art /sbxos/art/.
	cp -r dist/aurora dist/assets dist/art debian/secubox-sbxos/usr/share/secubox/www/sbxos/
	install -d debian/secubox-sbxos/etc/nginx/secubox-routes.d
	install -d debian/secubox-sbxos/etc/nginx/secubox.d
	install -m 0644 nginx/sbxos.conf debian/secubox-sbxos/etc/nginx/secubox-routes.d/
	install -m 0644 nginx/sbxos.conf debian/secubox-sbxos/etc/nginx/secubox.d/
