#!/bin/sh
set -e
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/security-posture/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "security-posture : prerm de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/security-posture/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "security-posture : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
