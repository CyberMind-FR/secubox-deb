[Unit]
Description=SecuBox Security Posture API Service
Documentation=https://github.com/CyberMind-FR/secubox-deb
After=network.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=secubox
Group=secubox

# Service runtime directory
RuntimeDirectory=secubox-security-posture
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0750

# Remove any stale socket left by a previous run so uvicorn can re-bind
# cleanly on restart (avoids "Address already in use" on dpkg upgrades).
ExecStartPre=-/bin/rm -f /run/secubox/security-posture.sock

# Main service - single worker (one background refresh loop / one cache writer).
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/security-posture.sock
ExecStart=/usr/bin/python3 -m uvicorn secubox_security_posture.api.main:app \
    --uds /run/secubox/security-posture.sock \
    --log-level info \
    --workers 1

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/secubox /var/log/secubox /run/secubox
InaccessiblePaths=/boot /home /root /run/user /tmp

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=UVICORN_RELOAD=false

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
