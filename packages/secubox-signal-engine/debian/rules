#!/usr/bin/make -f
# SPDX-License-Identifier: LicenseRef-CMSD-1.0

# VERSION EPINGLEE — ET CONTRAINTE PAR LA JVM DE DEBIAN, pas par le gout du
# neuf. Mesure sur les binaires eux-memes (version du format de classe) :
#
#   signal-cli 0.12.8  -> format 61 -> Java 17   <= bookworm en a 17
#   signal-cli 0.13.24 -> format 65 -> Java 21
#   signal-cli 0.14.8  -> format 69 -> Java 25
#
# La 0.14.8 avait ete epinglee parce qu'elle etait la derniere amont. Sur gk2
# elle ne demarrait pas du tout :
#   UnsupportedClassVersionError: class file version 69.0, this version of the
#   Java Runtime only recognizes class file versions up to 61.0
# et bookworm-backports n'offre aucun JRE plus recent.
#
# 0.12.8 convient AUSSI aux images trixie : une JVM plus recente lit un
# format plus ancien. Une seule version pour les deux suites.
#
# AVANT DE RELEVER CETTE VERSION : verifier le format de classe, pas la date
# de publication. Un `latest` rendrait la construction non reproductible et
# ferait entrer une version non relue le jour ou amont publie. La relever est
# une decision, pas un effet de bord.
SIGNAL_CLI_VERSION := 0.12.8
ARCHIVE := signal-cli-$(SIGNAL_CLI_VERSION).tar.gz
AMONT   := https://github.com/AsamK/signal-cli/releases/download/v$(SIGNAL_CLI_VERSION)/$(ARCHIVE)

# Somme de controle de l'archive amont. SANS ELLE, ce paquet installerait
# aveuglement ce que le reseau lui rend — ce qui, pour le composant qui tient
# les cles du lien Signal, serait difficile a defendre.
SHA256 := 8c1cf50f5533df3f90623fb300eadb48891965e2964b0537fe91c8fac0e3247c

%:
	dh $@

override_dh_auto_build:
	# Hors-ligne si l'archive est deja la (cache de la CI, ou miroir local).
	[ -f $(ARCHIVE) ] || curl -fsSL -o $(ARCHIVE) "$(AMONT)"
	echo "$(SHA256)  $(ARCHIVE)" | sha256sum -c -
	tar xf $(ARCHIVE)

override_dh_auto_install:
	install -d debian/secubox-signal-engine/usr/lib/secubox/signal
	cp -a signal-cli-$(SIGNAL_CLI_VERSION)/* \
	      debian/secubox-signal-engine/usr/lib/secubox/signal/
	chmod 0755 debian/secubox-signal-engine/usr/lib/secubox/signal/bin/signal-cli

override_dh_auto_test:
	# Rien a tester : ce paquet ne fait que transporter un binaire amont.

override_dh_clean:
	dh_clean
	rm -rf signal-cli-$(SIGNAL_CLI_VERSION)
