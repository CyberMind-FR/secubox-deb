[Unit]
Description=SecuBox SBX-SIGNAL — passerelle Signal (sbx-signald)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/1309
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/sbin/sbx-signald

[Service]
Type=notify
NotifyAccess=main
User=secubox-signal
# GROUPE PRIMAIRE `secubox`, pas `secubox-signal`. nginx tourne en www-data,
# membre de `secubox` et d'aucun autre groupe du parc : c'est ainsi que la
# socket devient lisible par le mandataire, sans le moindre chown.
#
# La voie evidente — laisser le groupe primaire et chowner la socket au
# demarrage — ECHOUE : `chown` releve de @privileged, que SystemCallFilter
# interdit plus bas. Le demon mourait alors sur SIGSYS (status=31/SYS). Le
# bac a sable avait raison ; c'est la conception qui devait ceder.
Group=secubox

# Le stockage de signal-cli porte les CLES du lien : 0700, jamais plus large.
ExecStartPre=+/bin/mkdir -p /var/lib/secubox/signal/cli /var/lib/secubox/signal/attachments
ExecStartPre=+/bin/chown -R secubox-signal:secubox-signal /var/lib/secubox/signal
ExecStartPre=+/bin/chmod 0700 /var/lib/secubox/signal /var/lib/secubox/signal/cli
ExecStartPre=+/bin/mkdir -p /var/log/secubox/signal
ExecStartPre=+/bin/chown -R secubox-signal:secubox-signal /var/log/secubox/signal
ExecStartPre=+/bin/chmod 0750 /var/log/secubox/signal

ExecStart=/usr/sbin/sbx-signald --config /etc/secubox/signal.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# ── Bac a sable ───────────────────────────────────────────────────────────
# Gabarit de secubox-waf-ng, avec deux DURCISSEMENTS supplementaires :
#
#   - CapabilityBoundingSet= et AmbientCapabilities= sont VIDES. Le WAF a
#     besoin de CAP_NET_ADMIN pour bannir ; une passerelle de messagerie n'a
#     besoin d'AUCUNE capacite. Ne pas en demander est le meilleur moyen de
#     ne pas en abuser.
#   - AF_NETLINK est RETIRE des familles autorisees, pour la meme raison :
#     rien ici ne parle au noyau reseau.
#
# NoNewPrivileges est a `yes` — contrairement au WAF, qui doit le relacher
# pour son ExecStartPre privilegie. Ici les ExecStartPre prefixes `+` sortent
# deja du bac a sable ; le processus principal, lui, ne remontera jamais.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no
ReadOnlyPaths=/etc/secubox
ReadWritePaths=/var/lib/secubox/signal /var/log/secubox/signal /run/secubox
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
UMask=0077

# MemoryDenyWriteExecute est VOLONTAIREMENT absent. signal-cli est une
# application JVM, et un JIT a besoin de pages a la fois inscriptibles et
# executables : l'activer tuerait le backend au demarrage. Le compromis est
# assume et documente plutot que decouvert.

# La JVM de signal-cli est gourmande : 256M suffisent au demon Go, pas au
# couple. Ces bornes valent pour l'unite ENTIERE, sous-processus compris.
MemoryHigh=512M
MemoryMax=768M
TasksMax=256

[Install]
WantedBy=multi-user.target
