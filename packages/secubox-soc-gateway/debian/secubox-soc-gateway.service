[Unit]
Description=SecuBox SOC Gateway
Documentation=https://cybermind.fr/secubox
After=network-online.target secubox-core.service
Wants=network-online.target

[Service]
Type=simple
User=secubox-soc-gateway
Group=secubox-soc-gateway
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/soc-gateway.sock
ExecStart=/usr/bin/python3 -m uvicorn secubox_soc_gateway:app --uds /run/secubox/soc-gateway.sock --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# RuntimeDirectory=secubox RETIRE (#1022) : /run/secubox est partage par ~95
# unites, et systemd EFFACE le contenu d'un RuntimeDirectory au redemarrage —
# une seule unite qui le declare emporte les sockets de toutes les autres, et
# la board rend des 502 sur des modules qui n'avaient rien demande. Le parent
# reste root:root 1777, cree hors des unites.
RuntimeDirectoryMode=0755

# Security hardening
NoNewPrivileges=yes

ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/secubox/soc-gateway
ReadWritePaths=/var/log/secubox
ReadWritePaths=/run/secubox

[Install]
WantedBy=multi-user.target
