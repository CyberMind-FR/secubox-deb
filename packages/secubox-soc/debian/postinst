#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    # base d'état SADE (#3839) : répertoire propre à l'utilisateur du service
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/soc || true
    systemctl daemon-reload
    systemctl enable secubox-soc.service || true
    systemctl start secubox-soc.service || true
    # SADE ACTIVE (#3839) : minuterie de l'exécuteur ; il ne fait rien hors mode active
    systemctl enable --now secubox-soc-sade-auto.timer >/dev/null 2>&1 || true
fi
#DEBHELPER#
exit 0
