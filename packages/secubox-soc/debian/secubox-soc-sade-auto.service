[Unit]
Description=SecuBox SOC - SADE ACTIVE, exécuteur automatique du cas sûr (#3839)
Documentation=file:///usr/share/doc/secubox-soc/README.md
After=secubox-soc.service secubox-waf-ng.service
ConditionPathExists=/usr/lib/secubox/soc/api/sade_auto.py

[Service]
Type=oneshot
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/soc
ExecStart=/usr/bin/python3 -m api.sade_auto
TimeoutStartSec=5min
UMask=0027

# EXCEPTION § 10 (.claude/RULES-CODE.md) : l'exécuteur lance `sudo -n /usr/sbin/wafctl ban <ip> <n>s`
# (sudoers SBX_WAF_BANMANUEL de secubox-waf-ng). sudo est setuid : NoNewPrivileges doit rester `no`, et
# les options qui l'impliquent (SystemCallFilter, RestrictSUIDSGID, LockPersonality,
# MemoryDenyWriteExecute, ProtectKernelTunables, RestrictNamespaces) sont donc absentes.
NoNewPrivileges=no

# Socle gardé. wafctl s'exécute DANS l'espace de noms de montage de cette unité (sudo l'hérite) :
# `wafctl ban`, `limiter`, `prolonger` n'écrivent aucun fichier (ensembles nft = noyau, journal sur stdout) ;
# `waf-blocs verifier` ne fait que lire (liste des protégés, `ip -j addr`, `wg show`). Seuls chemins en écriture :
#  - /var/lib/secubox/soc  : base SQLite defense.db (mode, décisions) ;
#  - /var/log/secubox      : audit.log (append-only) ;
#  - /run/sudo             : horodatage de sudo, absent tant que sudo ne l'a pas créé ;
#  - /var/lib/secubox/waf  : `wafctl leurre` (root) y remplace leurres-ip.json (temporaire + renommage) pour les
#                            gestes approuvés de la file (1.12.0), comme secubox-waf-indices.service ;
#  - /var/log/sudo-io      : `Defaults!SBX_WAF_LIMITER|LEURRE|PROLONGER log_output` (journal d'E/S de sudo).
# /etc/sudoers* et /usr/sbin sont lisibles sous `strict`.
ProtectSystem=strict
ReadWritePaths=/var/lib/secubox/soc /var/log/secubox -/run/sudo -/var/lib/secubox/waf -/var/log/sudo-io
ProtectHome=yes
PrivateTmp=yes
