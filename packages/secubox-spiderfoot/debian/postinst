#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if [ -f /etc/sudoers.d/secubox-spiderfoot ]; then
        visudo -cf /etc/sudoers.d/secubox-spiderfoot >/dev/null || {
            echo "secubox-spiderfoot: invalid sudoers, removing" >&2
            rm -f /etc/sudoers.d/secubox-spiderfoot
        }
    fi

    # Create data directories. The spiderfoot FastAPI module may touch
    # /var/lib/secubox/spiderfoot at import time, so the user that loads it
    # MUST be able to traverse the parent dir. Under the secubox-aggregator
    # the loader runs as `secubox`, not root — so the module dir is 0755 and
    # owned by `secubox:secubox`. NEVER touch the shared parent
    # (/var/lib/secubox stays as-is).
    mkdir -p /var/lib/secubox/spiderfoot
    mkdir -p /var/cache/secubox/spiderfoot
    if getent passwd secubox >/dev/null; then
        chown -R secubox:secubox /var/lib/secubox/spiderfoot /var/cache/secubox/spiderfoot
    fi
    chmod 0755 /var/lib/secubox/spiderfoot

    # The aggregator serves this module in-process (imports api/main.py as
    # user secubox) — no dedicated host unit to enable.
    systemctl daemon-reload

    # Reload nginx if available
    if systemctl is-active --quiet nginx; then
        systemctl reload nginx || true
    fi
fi
#DEBHELPER#
exit 0
