set -e

case "$1" in
    configure)
        getent group secubox >/dev/null || groupadd --system secubox
        # Compte dédié, sans shell ; groupe secubox pour lire les caches 0640 (relevé des profils) et servir la socket.
        id -u secubox-status >/dev/null 2>&1 || \
          adduser --system --ingroup secubox --no-create-home --home /nonexistent \
            --shell /usr/sbin/nologin secubox-status >/dev/null
        # La configuration n'est semée qu'une fois : une copie modifiée fait autorité.
        if [ ! -e /etc/secubox/status.toml ] && [ ! -L /etc/secubox/status.toml ] && [ -d /etc/secubox ] && [ ! -L /etc/secubox ]; then
            install -m 0640 -o root -g secubox /usr/share/secubox/status/status.toml.example /etc/secubox/status.toml
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable secubox-status.service >/dev/null 2>&1 || true
            systemctl enable secubox-status-collect.timer >/dev/null 2>&1 || true
            systemctl restart secubox-status.service || true
            systemctl start secubox-status-collect.timer || true
            # Premier relevé tout de suite, sans attendre le minuteur (souple : un échec reste dans le journal).
            systemctl start --no-block secubox-status-collect.service || true
            if nginx -t >/dev/null 2>&1; then systemctl reload nginx 2>/dev/null || true; fi
        fi
        ;;
esac

#DEBHELPER#
exit 0
