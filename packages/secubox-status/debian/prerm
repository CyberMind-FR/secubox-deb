set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl stop secubox-status-collect.timer secubox-status-collect.service secubox-status.service || true
            systemctl disable secubox-status-collect.timer secubox-status.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#
exit 0
