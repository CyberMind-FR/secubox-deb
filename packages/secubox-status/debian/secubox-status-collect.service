# SecuBox Status Live v2 — collecte locale (#3605) : lit les caches de santé, de modules et de profils, et /proc ;
# n'exécute aucune commande. Écrit seulement sous /var/lib/secubox-status (StateDirectory, hors de l'arbre
# partagé /var/lib/secubox : pas de transition de propriétaire refusée par systemd).
[Unit]
Description=SecuBox Status Live — collecte locale
After=secubox-core.service

[Service]
Type=oneshot
User=secubox-status
Group=secubox
WorkingDirectory=/usr/lib/secubox/status
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m secubox_status.collecte
StateDirectory=secubox-status
StateDirectoryMode=0750
UMask=0027
Nice=10
MemoryMax=128M
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
