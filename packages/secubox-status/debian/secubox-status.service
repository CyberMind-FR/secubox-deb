# SecuBox Status Live v2 — API locale, lecture seule (#3605). Ne collecte rien : relit ce que
# secubox-status-collect a écrit. Compte dédié, aucune capacité, aucun réseau IP.
[Unit]
Description=SecuBox Status Live — API locale (lecture seule)
After=network.target secubox-core.service

[Service]
Type=simple
User=secubox-status
Group=secubox
WorkingDirectory=/usr/lib/secubox/status
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=+/bin/rm -f /run/secubox/status.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/status.sock --workers 1 --log-level warning
# uvicorn crée sa socket puis la force en 0666 quelle que soit l'UMask : on la remet en 0660 (groupe secubox, que
# nginx traverse) dès qu'elle existe (relecture #3605).
ExecStartPost=/bin/sh -c 'for i in $(seq 1 1200); do [ -S /run/secubox/status.sock ] && break; sleep 0.1; done; chmod 660 /run/secubox/status.sock'
UMask=0027
AppArmorProfile=-secubox-status
# StateDirectory en écriture : SQLite en WAL crée le fichier -shm même pour une lecture (mode=ro).
StateDirectory=secubox-status
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
MemoryMax=128M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/run/secubox -/var/log/secubox/delegation.log

[Install]
WantedBy=multi-user.target
