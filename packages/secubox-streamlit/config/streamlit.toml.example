# SecuBox Streamlit Platform Configuration
# Location: /etc/secubox/streamlit.toml

[main]
enabled = true
http_port = "8501"
http_host = "0.0.0.0"
data_path = "/srv/streamlit"
memory_limit = "4G"

[server]
headless = "true"
browser_gather_usage_stats = "false"
theme_base = "dark"
theme_primary_color = "#0ff"

# Gitea integration (optional)
[gitea]
enabled = false
user = "admin"
url = "http://localhost:3001"
# token = "your_gitea_token"

# App definitions
# [apps.myapp]
# name = "My App"
# path = "myapp.py"
# enabled = true
# repo = "user/repo"

# Instance definitions (running instances with domain routing)
# [instances.myinstance]
# name = "myinstance"
# app = "myapp"
# port = "8501"
# enabled = true
# autostart = true
# emancipated = true
# domain = "myapp.example.com"

# Ports des applis (#3247). Sans port fourni, `streamlitctl app port` prend le
# premier port de cette plage qui n'est ni attribué à une autre appli (fichier
# de port, [apps.*], [instances.*], route directe) ni en écoute dans le conteneur.
[ports]
min = 8501
max = 8600

# Publication des applis (#3247) : chaîne HAProxy → sbxwaf → nginx :9080 →
# conteneur, posée par `streamlitctl app publish` et déclarée ci-dessous en
# [instances.<nom public>]. Jamais de contournement du WAF.
[publication]
# false : publication SUR DEMANDE (bouton « Publier », champ « Nom public » au
# dépôt). true : une appli déposée ou démarrée sans nom public est publiée sous
# <nom du dossier>.<domaine de la box>.
auto = false
# true : une appli publiée reste démarrée (autostart, hors mise en veille) et le
# conteneur est démarré au boot (secubox-streamlit-demarrage.service) — rien ne
# réveille encore une appli par son vhost (#746). false : la veille s'applique.
autostart = true
# Adresse du conteneur pour nginx (proxy_pass). Vide : adresse vive (lxc-info),
# sinon celle des publications existantes — l'une comme l'autre SEULEMENT dans le
# sous-réseau du pont du conteneur. Réglée ici, elle est prise telle quelle.
# ip_conteneur = "10.100.0.50"

# Power management (sleep/wake optimization)
[power]
auto_pause = false
auto_pause_minutes = 30
# presence_events enables banner injection on wake/sleep
presence_events = true

[wake]
# How long `streamlitctl app wake <name>` waits for the app's port to
# start listening when the caller doesn't pass an explicit budget as a
# 3rd CLI argument (`app wake <name> <seconds>` always overrides this).
# Measured on a loaded board (average load 45-90): wakes commonly take
# 26 to 78s, sometimes more. Default 300.
budget_seconds = 300

[idle]
# Stop streamlit apps that haven't served any ESTABLISHED connection
# for this many minutes. Set to 0 to disable. Default 30.
timeout_minutes = 30

# How often the systemd timer runs the sweep. Informational — the
# actual timer is in secubox-streamlit-idle.timer; keep them in sync
# if you change either.
check_interval_minutes = 5

# Master switch. false = streamlitctl app idle-check exits 0 without
# touching anything.
enabled = true
