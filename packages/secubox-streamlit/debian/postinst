#!/bin/bash
set -e
case "$1" in
  configure)
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    install -d -o root -g root -m 1777 /run/secubox
    install -d -o secubox -g secubox -m 755 /var/lib/secubox
    install -d -o secubox -g secubox -m 755 /srv/streamlit/apps /srv/streamlit/logs
    install -d -o secubox -g secubox -m 755 /var/log/secubox
    install -d -o root -g root -m 755 /etc/secubox

    # Create example config if none exists
    if [ ! -f /etc/secubox/streamlit.toml ]; then
      if [ -f /usr/share/doc/secubox-streamlit/examples/streamlit.toml.example ]; then
        cp /usr/share/doc/secubox-streamlit/examples/streamlit.toml.example /etc/secubox/streamlit.toml
        chown root:secubox /etc/secubox/streamlit.toml
        chmod 640 /etc/secubox/streamlit.toml
      fi
    fi

    # Create LXC symlink if container exists on /data (mSSD)
    if [ -d /data/lxc/streamlit ] && [ ! -e /var/lib/lxc/streamlit ]; then
      ln -sf /data/lxc/streamlit /var/lib/lxc/streamlit
    fi

    systemctl daemon-reload
    systemctl enable secubox-streamlit.service
    systemctl start secubox-streamlit.service || true
    systemctl enable --now secubox-streamlit-idle.timer || true

    # App-fleet audit cache (#956): root timer writes
    # /var/cache/secubox/streamlit/audit.json, the unprivileged dashboard only
    # reads it — so the Mosaic tab stops paying the ~31s streamlitctl audit
    # cost on every request.
    systemctl enable --now streamlit-audit.timer || true
    ;;
esac
# RÈGLES SUDO lxc-* (#1785) : une version locale ou ancienne de
# /etc/sudoers.d/secubox-streamlit est gardée par --force-confold et garde ses règles
# lxc-* à argument libre (`lxc-start -f` : crochets exécutés en root sur
# l'hôte). La version du paquet, validée par visudo, la remplace ; sauvegarde.
if [ "$1" = "configure" ]; then
    _f=/etc/sudoers.d/secubox-streamlit
    if [ -f "$_f" ] && grep -qE 'NOPASSWD: /usr/bin/lxc-' "$_f" \
       && [ -f "$_f.dpkg-dist" ] && visudo -cf "$_f.dpkg-dist" >/dev/null 2>&1; then
        install -d -m 0700 /var/backups/secubox/sudoers-avant-1785
        cp -p "$_f" /var/backups/secubox/sudoers-avant-1785/
        install -m 0440 "$_f.dpkg-dist" "$_f" && rm -f "$_f.dpkg-dist"
        echo "secubox-streamlit : règles sudo lxc-* retirées (sauvegarde /var/backups/secubox/sudoers-avant-1785)"
    fi
fi

#DEBHELPER#
