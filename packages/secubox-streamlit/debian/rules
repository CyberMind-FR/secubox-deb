#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-streamlit/usr/lib/secubox/streamlit/
	cp -r api debian/secubox-streamlit/usr/lib/secubox/streamlit/
	# Per-app systemd unit template + its launcher (structural fix,
	# replaces streamlit-all.service) — deployed INSIDE the streamlit LXC
	# container by streamlitctl (cmd_install for a fresh container; see
	# also the manual adoption sequence for an already-provisioned one),
	# never installed as host-side systemd units themselves.
	install -d debian/secubox-streamlit/usr/lib/secubox/streamlit/lxc
	[ -d lxc ] && install -m 644 "lxc/streamlit-app@.service" debian/secubox-streamlit/usr/lib/secubox/streamlit/lxc/ || true
	[ -d lxc ] && install -m 755 lxc/streamlit-launch debian/secubox-streamlit/usr/lib/secubox/streamlit/lxc/ || true
	install -d debian/secubox-streamlit/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-streamlit/usr/share/secubox/www/ || true
	install -d debian/secubox-streamlit/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-streamlit/usr/share/secubox/menu.d/ || true
	# Modular nginx config
	install -d debian/secubox-streamlit/etc/nginx/secubox.d
	[ -f nginx/streamlit.conf ] && cp nginx/streamlit.conf debian/secubox-streamlit/etc/nginx/secubox.d/ || true
	# Install control scripts
	install -d debian/secubox-streamlit/usr/sbin
	[ -d sbin ] && install -m 755 sbin/* debian/secubox-streamlit/usr/sbin/ || true
	[ -d scripts ] && install -m 755 scripts/* debian/secubox-streamlit/usr/sbin/ || true
	# Sudoers config for LXC access
	install -d debian/secubox-streamlit/etc/sudoers.d
	[ -f sudoers.d/secubox-streamlit ] && install -m 440 sudoers.d/secubox-streamlit debian/secubox-streamlit/etc/sudoers.d/ || true
	# Systemd service drop-in for NoNewPrivileges
	install -d debian/secubox-streamlit/usr/lib/systemd/system/secubox-streamlit.service.d
	[ -f debian/secubox-streamlit.service.d/allow-lxc.conf ] && install -m 644 debian/secubox-streamlit.service.d/allow-lxc.conf debian/secubox-streamlit/usr/lib/systemd/system/secubox-streamlit.service.d/ || true
	# App-fleet audit cache (#956): root timer refreshes the Mosaic tab's
	# double-cache so the request path is a file read instead of a ~31s
	# streamlitctl invocation through the aggregator.
	install -m 644 debian/streamlit-audit.service debian/secubox-streamlit/usr/lib/systemd/system/
	install -m 644 debian/streamlit-audit.timer debian/secubox-streamlit/usr/lib/systemd/system/
	# Example config
	install -d debian/secubox-streamlit/usr/share/doc/secubox-streamlit/examples
	[ -f config/streamlit.toml.example ] && install -m 644 config/streamlit.toml.example debian/secubox-streamlit/usr/share/doc/secubox-streamlit/examples/ || true
