# SPDX-License-Identifier: LicenseRef-CMSD-1.0
[Unit]
Description=Refresh the Streamlit app-fleet audit cache every 15 minutes (#3355)

[Timer]
# #3355 : décalage aléatoire stable par box (FixedRandomDelay), pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=225s
FixedRandomDelay=true
OnBootSec=2min
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=2min
OnUnitActiveSec=15min
# The inventory only moves at the pace of app starts/stops — polling harder
# would just add disk-scan + lxc-attach churn on a box that is already
# CPU-tight.
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
