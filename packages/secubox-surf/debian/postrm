#!/bin/bash
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -f /etc/nginx/sites-enabled/surf.conf || true
    if [ -x /usr/sbin/nginx ] && nginx -t 2>/dev/null; then
        systemctl reload nginx || true
    fi
fi
#DEBHELPER#
# Automatically added by dh_installsystemd/13.14.1ubuntu5
if [ "$1" = "purge" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper purge 'secubox-surf.service' >/dev/null || true
	fi
fi
# End automatically added section

