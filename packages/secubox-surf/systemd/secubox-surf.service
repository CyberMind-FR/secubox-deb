[Unit]
Description=SecuBox Surf — relais MITM POC (hors chaîne d'inspection)
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=exec
# Pas de SECUBOX_TOR_SOCKS fige ici : surf/egress.py detecte le SOCKS de Tor de CETTE machine (127.0.0.1:9050, puis son
# adresse locale). L'unite figeait celui de gk2 (son adresse LAN) : sur gk3 le surfer serait sorti par le Tor d'une
# autre box (#2039). Un reglage propre a une machine se pose dans un drop-in.
WorkingDirectory=/usr/lib/secubox/surf
ExecStart=/usr/local/bin/uvicorn surf.serveur:app --host 127.0.0.1 --port 9082
Restart=on-failure
RestartSec=3
# POC : durci a minima, mais isole. Il ne lit rien de la box, il relaie
# l'externe — d'ou pas d'acces au systeme de fichiers en ecriture.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secubox/surf
StateDirectory=secubox/surf
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
