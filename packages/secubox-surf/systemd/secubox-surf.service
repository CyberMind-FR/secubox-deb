[Unit]
Description=SecuBox Surf — relais MITM POC (hors chaîne d'inspection)
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=exec
# Pas de SECUBOX_TOR_SOCKS fige ici : surf/egress.py detecte le SOCKS de Tor de CETTE machine (127.0.0.1:9050, puis son
# adresse locale). L'unite figeait celui de gk2 (son adresse LAN) : sur gk3 le surfer serait sorti par le Tor d'une
# autre box (#2039). Un reglage propre a une machine se pose dans un drop-in.
WorkingDirectory=/usr/lib/secubox/surf
# Socket Unix, jamais un port TCP (#2050). /run/secubox est PARTAGÉ et collant (1777) : on n'y délie que ce qu'on possède ; « + » = en root malgré
# un éventuel User=. uvicorn crée la socket en 0666 après le bind : le chmod 660 est INDISPENSABLE.
# #3355 : compte dédié, jamais root (relais de confort exposé à du contenu hostile du web) : rien ne l'exige —
# `ip -j addr` est non privilégié, Chromium tourne en --no-sandbox, tout s'écrit dans StateDirectory.
User=secubox-surf
Group=secubox
ExecStartPre=+/bin/rm -f /run/secubox/surf.sock
ExecStart=/usr/local/bin/uvicorn surf.serveur:app --uds /run/secubox/surf.sock
ExecStartPost=/bin/sh -c 'for i in $(seq 1 1200); do [ -S /run/secubox/surf.sock ] && break; sleep 0.1; done; chmod 660 /run/secubox/surf.sock'
TimeoutStartSec=180
Restart=on-failure
RestartSec=3
# POC : durci a minima, mais isole. Il ne lit rien de la box, il relaie
# l'externe — d'ou pas d'acces au systeme de fichiers en ecriture.
NoNewPrivileges=true
# #3355 : relais de confort (POC) : il cède toujours le processeur et le disque aux services de la box (WAF, pilotage).
# Mesuré sur gk2 : ~60 % d'un cœur en continu, 5 fois le service suivant.
Nice=10
CPUWeight=20
IOWeight=20
CPUQuota=50%
ProtectSystem=strict
ReadWritePaths=/var/lib/secubox/surf /run/secubox
StateDirectory=secubox/surf
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
