#!/bin/bash
set -e
case "$1" in
  configure)
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home \
        --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    install -d -o root -g root -m 1777 /run/secubox
    install -d -o secubox -g secubox -m 755 /var/lib/secubox
    # #3002 — dossier de demandes de mise a jour (ecrit par l'API, lu par l'unite root) et etat
    install -d -o secubox -g secubox -m 775 /run/secubox/system /run/secubox/system/maj
    install -d -o root -g root -m 755 /var/lib/secubox/system
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/secubox-system.conf 2>/dev/null || true
    systemctl daemon-reload
    systemctl enable secubox-system.service
    systemctl start  secubox-system.service || true
    # Sur le vhost d'administration, /api/v1/system/ est servi EN MEMOIRE par l'agregateur (#3003) : sans
    # relancement, il garde l'ancien code (routes absentes, apt lance sans privilege). Meme regle que le hub.
    systemctl try-restart secubox-aggregator.service 2>/dev/null || true
    install -d -m 755 /etc/nginx/secubox.d
    systemctl reload nginx 2>/dev/null || true

    # Eye Remote OTG support
    chmod +x /usr/lib/secubox/eye-remote-connected.sh 2>/dev/null || true
    chmod +x /usr/lib/secubox/eye-remote-disconnected.sh 2>/dev/null || true
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true
    ;;
esac
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/system/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "system : postinst de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/system/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "system : postinst de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/system/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "system : postinst de $(basename "$_s") en échec" >&2; }
done
exit 0
