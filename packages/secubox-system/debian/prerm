#!/bin/bash
set -e
case "$1" in
  remove|deconfigure)
    rm -f /etc/nginx/secubox.d/system.conf
    # #3401 : plus de ctl, plus de regle sudoers. La garde SSH du mot de passe par defaut reste posee (refus prudent).
    systemctl disable --now secubox-ssh-garde.path 2>/dev/null || true
    rm -f /etc/sudoers.d/secubox-ssh
    systemctl reload nginx 2>/dev/null || true
    ;;
  upgrade)
    # Don't remove nginx config on upgrade
    ;;
esac
systemctl stop    secubox-system.service 2>/dev/null || true
systemctl disable secubox-system.service 2>/dev/null || true
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/system/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "system : prerm de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/system/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "system : prerm de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/system/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "system : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
