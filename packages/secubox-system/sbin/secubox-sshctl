# SecuBox-Deb :: secubox-sshctl — accès SSH, en root (#3401).
#
# Seul chemin d'écriture de la configuration SSH SecuBox. Appelé par sudo depuis l'API système (règle sudoers à la
# lettre) et par l'unité secubox-ssh-garde (au changement de users.json).
#   etat                          JSON : service actif, mot de passe permis, garde « mot de passe par défaut »
#   acces <on|off> <acteur>       active / désactive le service ssh
#   mot-de-passe <on|off> <acteur> permet / refuse l'authentification SSH par mot de passe (la clé reste possible).
#                                 « on » est REFUSÉ tant que le mot de passe par défaut est actif.
#   garde                         pose / lève le drop-in qui refuse le mot de passe tant que le défaut est actif
#
# Les drop-ins sont des fichiers à nous, réversibles : les supprimer rend la configuration d'avant. Chaque
# écriture est validée par `sshd -t` et défaite si elle échoue ; chaque changement est écrit dans audit.log.
set -euo pipefail

readonly DIR="${SECUBOX_SSHD_DIR:-/etc/ssh/sshd_config.d}"
readonly GARDE="$DIR/05-secubox-mot-de-passe-defaut.conf"
readonly MDP="$DIR/10-secubox-ssh-mot-de-passe.conf"
readonly AUDIT="${SECUBOX_AUDIT_LOG:-/var/log/secubox/audit.log}"
# Tests seulement : ni systemctl ni sshd (sudo remet l'environnement à zéro, env_reset).
readonly ESSAI="${SECUBOX_SSHCTL_ESSAI:-0}"

refus() { echo "secubox-sshctl : $*" >&2; exit 2; }

audit() {   # audit <evenement> [acteur]
    local ligne
    ligne=$(jq -cn --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg ev "$1" --arg ac "${2:-systeme}" \
        '{ts: $ts, type: "ssh", evenement: $ev, acteur: $ac}')
    printf '%s\n' "$ligne" >> "$AUDIT" || echo "secubox-sshctl : audit non écrit : $ligne" >&2
}

defaut_actif() {
    if [[ -n "${SECUBOX_DEFAUT_ACTIF:-}" && "$ESSAI" == "1" ]]; then
        [[ "$SECUBOX_DEFAUT_ACTIF" == "1" ]]
        return
    fi
    python3 -m secubox_core.mot_de_passe_defaut
}

recharge() {
    [[ "$ESSAI" == "1" ]] && return 0
    systemctl reload ssh.service 2>/dev/null || systemctl try-reload-or-restart ssh.service || true
}

valide() {   # sshd -t ; 0 si la configuration tient
    [[ "$ESSAI" == "1" ]] && return 0
    sshd -t
}

# ecrit <fichier> <contenu> : pose, valide, défait si sshd -t échoue.
ecrit() {
    local f="$1" contenu="$2" sauve="" tmp
    if [[ -f "$f" ]]; then
        sauve=$(mktemp "$DIR/.secubox-sshctl.sauve.XXXXXX")
        cp -p -- "$f" "$sauve"
    fi
    tmp=$(mktemp "$DIR/.secubox-sshctl.XXXXXX")
    printf '%s\n' "$contenu" > "$tmp"
    chmod 0644 "$tmp"
    mv -f -- "$tmp" "$f"
    if ! valide; then
        if [[ -n "$sauve" ]]; then mv -f -- "$sauve" "$f"; else rm -f -- "$f"; fi
        refus "sshd -t refuse la configuration : rien n'est changé"
    fi
    [[ -z "$sauve" ]] || rm -f -- "$sauve"
}

entete="# Géré par secubox-sshctl (#3401) — ne pas éditer à la main."

acteur_valide() { [[ "${1:-}" =~ ^[A-Za-z0-9_.@-]{1,64}$ ]] || refus "acteur invalide"; }

case "${1:-}" in
    etat)
        service=false; mdp=true; garde=false
        if [[ "$ESSAI" != "1" ]] && systemctl is-active --quiet ssh.service; then service=true; fi
        [[ -f "$MDP" ]] && grep -qx 'PasswordAuthentication no' "$MDP" && mdp=false
        [[ -f "$GARDE" ]] && garde=true
        defaut=false; defaut_actif && defaut=true
        jq -cn --argjson s "$service" --argjson m "$mdp" --argjson g "$garde" --argjson d "$defaut" \
            '{service: $s, mot_de_passe: ($m and ($g | not)), mot_de_passe_choisi: $m, garde_defaut: $g, mot_de_passe_defaut: $d}'
        ;;
    acces)
        [[ "${2:-}" == "on" || "${2:-}" == "off" ]] || refus "acces attend on ou off"
        acteur_valide "${3:-}"
        if [[ "$ESSAI" != "1" ]]; then
            if [[ "$2" == "on" ]]; then systemctl enable --now ssh.service; else systemctl disable --now ssh.service; fi
        fi
        audit "ssh_acces_$2" "$3"
        ;;
    mot-de-passe)
        [[ "${2:-}" == "on" || "${2:-}" == "off" ]] || refus "mot-de-passe attend on ou off"
        acteur_valide "${3:-}"
        if [[ "$2" == "on" ]]; then
            if defaut_actif; then
                audit "ssh_mot_de_passe_refuse_defaut" "$3"
                echo "secubox-sshctl : changez d'abord le mot de passe par défaut" >&2
                exit 3
            fi
            rm -f -- "$MDP"
        else
            ecrit "$MDP" "$entete
PasswordAuthentication no
KbdInteractiveAuthentication no"
        fi
        valide || refus "sshd -t refuse la configuration"
        recharge
        audit "ssh_mot_de_passe_$2" "$3"
        ;;
    garde)
        if defaut_actif; then
            if [[ ! -f "$GARDE" ]]; then
                ecrit "$GARDE" "$entete
# Mot de passe par défaut actif : SSH par mot de passe refusé (la clé reste possible). Levé automatiquement
# dès que le mot de passe admin est changé.
PasswordAuthentication no
KbdInteractiveAuthentication no"
                recharge
                audit "ssh_garde_defaut_posee"
            fi
        elif [[ -f "$GARDE" ]]; then
            rm -f -- "$GARDE"
            recharge
            audit "ssh_garde_defaut_levee"
        fi
        ;;
    *) refus "usage : etat | acces <on|off> <acteur> | mot-de-passe <on|off> <acteur> | garde" ;;
esac
