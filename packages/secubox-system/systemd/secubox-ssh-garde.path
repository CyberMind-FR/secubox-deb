[Unit]
Description=SecuBox : garde SSH du mot de passe par defaut (#3401)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3401

[Path]
# users.json (mot de passe web admin) ou /etc/shadow (mot de passe Linux) change : la garde se recalcule.
# touch_last_login reecrit users.json a chaque connexion : secubox-ssh-defaut garde un cache par empreinte.
PathChanged=/etc/secubox/users.json
PathChanged=/etc/shadow
Unit=secubox-ssh-garde.service

[Install]
WantedBy=paths.target
