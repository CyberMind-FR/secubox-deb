[Unit]
Description=SecuBox systeme : demandes d acces SSH de l API (#3401)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3401

[Path]
# L API systeme (secubox, NoNewPrivileges) depose <id>.demande ici ; cette unite root la traite.
DirectoryNotEmpty=/run/secubox/system/ssh
Unit=secubox-ssh.service

[Install]
WantedBy=paths.target
