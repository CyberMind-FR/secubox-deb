[Unit]
Description=SecuBox systeme : acces SSH (#3401)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3401
StartLimitIntervalSec=60
StartLimitBurst=30

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-sshctl traite
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
IPAddressDeny=any
# Ecrit des fichiers root dans des dossiers d autres proprietaires (resultats : secubox) ; rien d autre.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
# sshd -t / -T exigent le dossier de separation de privileges, absent quand ssh est arrete.
RuntimeDirectory=sshd
RuntimeDirectoryPreserve=yes
ReadWritePaths=/etc/ssh/sshd_config.d /var/log/secubox /var/lib/secubox/system /run/secubox/system
