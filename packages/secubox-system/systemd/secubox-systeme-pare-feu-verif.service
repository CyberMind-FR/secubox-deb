[Unit]
Description=SecuBox systeme : verification de la configuration nftables (#2788)

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -c -f /etc/nftables.conf
# Verification seule : /etc/nftables.conf commence par « flush ruleset », un rechargement viderait les ensembles dynamiques (bannissements WAF, maillage).
