#
# #3242 (et #3126 L2 tâche 5) : renommer la box depuis la page Système. Démarrée par l'API (User=secubox,
# NoNewPrivileges) grâce à la règle polkit bornée au sujet secubox-system.service ; root, car secubox-renommer écrit
# /etc/hosts et secubox.conf puis lance hostnamectl. L'instance est le nom demandé, passé brut (%i, jamais %I qui
# changerait « - » en « / ») ; secubox-renommer le revalide (libellé DNS, noms réservés, nom pris au maillage).
# Le code de sortie (ExecMainStatus) est relu par l'API et rendu à la page.
[Unit]
Description=SecuBox systeme : renommer la box en %i (#3242)

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-renommer %i
TimeoutStartSec=90
