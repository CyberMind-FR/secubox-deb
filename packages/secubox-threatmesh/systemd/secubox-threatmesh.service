[Unit]
Description=SecuBox ThreatMesh — sovereign threat-intel mesh API (#728)
After=network.target secubox-runtime.service secubox-p2p.service
Wants=secubox-p2p.service

[Service]
Type=simple
User=root
WorkingDirectory=/usr/lib/secubox/threatmesh
# #3450 : partage non signé retiré, plus aucune écoute TCP.
ExecStartPre=+/bin/rm -f /run/secubox/threatmesh.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/threatmesh.sock --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateTmp=true
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox

[Install]
WantedBy=multi-user.target
