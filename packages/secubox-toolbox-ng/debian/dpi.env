# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: sbxdpi configuration
#
# EnvironmentFile for sbxdpi.service. This is a dpkg conffile: local edits
# survive package upgrades.

# ── Sockets ──────────────────────────────────────────────────────────────────
# nDPIsrvd distributor socket sbxdpi DIALS to receive the framed flow-event
# JSON stream (created by secubox-dpi-engine's nDPIsrvd -s ...).
DPI_DISTRIBUTOR_SOCK=/run/secubox/ndpi/distributor.sock

# Unix socket sbxdpi LISTENS on to serve the read-only /api/v1/dpi/ surface.
# Must live under the shared /run/secubox runtime dir — its OWN socket, NOT the
# master API gateway aggregator.sock. The Hall reaches it either via the
# secubox-dpi FastAPI (which reads sbxdpi's cache/socket and JWT-gates it) or a
# GET-only nginx location proxied straight here.
DPI_API_SOCK=/run/secubox/dpi-live.sock

# ── Cache ────────────────────────────────────────────────────────────────────
# Atomic JSON snapshot (warm-start + last-known-good source for the API).
# Snapshot atomique, PETIT (cartes plafonnées) et sur le SSD /data — JAMAIS sur
# l'eMMC racine (15 Go, vite pleine). Répertoire propre à sbxdpi
# (secubox-toolbox) : /var/cache/secubox/dpi est tenu par secubox-dpi (user
# secubox), et /var/cache est de toute façon sur l'eMMC.
DPI_STATS_CACHE=/data/secubox/sbxdpi/stats.json
DPI_FLUSH_INTERVAL=30s

# Reconnect delay between distributor dial attempts when nDPIsrvd is absent/down.
DPI_DIAL_BACKOFF=3s

# ── Go-level filtering (declarative, hot-reloaded on mtime change) ────────────
# apps/protocols/categories/hosts to DROP from the stats (noise reduction).
DPI_DENY_FILE=/etc/secubox/dpi/app-deny.txt
# pins that OVERRIDE the deny list (keep even if muted).
DPI_ALLOW_FILE=/etc/secubox/dpi/app-allow.txt
# nDPI risk names/ids to NOT surface (false-positive control).
DPI_RISK_MUTE=/etc/secubox/dpi/risk-mute.txt
# our own vhost domains → first-party exemption (never dropped, flagged).
DPI_BOX_DOMAINS=/etc/secubox/waf/haproxy-routes.json

# Minimum interval between filter-file mtime stat passes.
DPI_RELOAD_EVERY=15s
