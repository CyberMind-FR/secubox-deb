#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: toolbox-ng — postinst
#
# DARK by design (#662 Phase 5-prep):
#   - DO reload the systemd unit catalogue so the template is known.
#   - DO NOT enable or start secubox-toolbox-ng-worker@.service — this is the
#     Phase-6 cutover target; the live R3 tunnel keeps running on the Python
#     workers until the operator performs the cutover manually.
#   - DO NOT touch nftables (no DNAT, no live-R3 rewiring).
set -e

case "$1" in
  configure)
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    # Intentionally NO `systemctl enable --now`. See the unit header and
    # debian/changelog: enabled only at the Phase 6 cutover.

    # #826 C2 autolearn: the daemon (secubox-toolbox) appends operator-allowlisted
    # hosts to c2-allow.txt via POST /c2/allow. Make the dir + file writable by it
    # WITHOUT touching the shared /etc/secubox parent (stays 0755).
    if [ -d /etc/secubox/sentinel ]; then
      chown secubox-toolbox:secubox-toolbox /etc/secubox/sentinel 2>/dev/null || true
      chmod 0750 /etc/secubox/sentinel 2>/dev/null || true
      [ -f /etc/secubox/sentinel/c2-allow.txt ] && chown secubox-toolbox:secubox-toolbox /etc/secubox/sentinel/c2-allow.txt 2>/dev/null || true
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

#DEBHELPER#

# ── UNE MISE A JOUR NE DOIT PAS DESARMER LA SURVEILLANCE (#1317) ────────────
#
# secubox-authwatch est volontairement pose `--no-enable --no-start` : un
# service qui BANNIT ne s'active pas tout seul a l'installation, l'operateur
# l'observe puis decide (#1220). C'est juste, et on n'y touche pas.
#
# Mais `--no-start` vaut aussi a la MISE A JOUR : dh arrete l'unite en prerm et
# ne la relance jamais. La surveillance SSH/SMTP/IMAP et les leurres tombaient
# donc en silence a chaque montee de version du paquet, sans qu'aucun message
# ne le dise — constate en production, le service arrete depuis des heures.
#
# On distingue les deux moments. `$2` non vide signifie MISE A JOUR : si
# l'unite est ENABLED, c'est que quelqu'un a decide de la faire tourner, et
# cette decision doit survivre au paquet. A la premiere installation, `$2` est
# vide et l'on ne demarre rien.
if [ "$1" = "configure" ] && [ -n "$2" ]; then
    if systemctl is-enabled secubox-authwatch.service >/dev/null 2>&1; then
        systemctl restart secubox-authwatch.service >/dev/null 2>&1 || true
    fi
fi

exit 0
