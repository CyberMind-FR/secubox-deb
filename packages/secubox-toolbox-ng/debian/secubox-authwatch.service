[Unit]
Description=SecuBox authwatch — analyse de journaux et leurres de service (#1220)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/1220
# L'ensemble nft est cree par sbxwaf : sans lui, authwatch refuse de demarrer
# plutot que de compter des bannissements sans effet (lecon de #1218).
After=network-online.target nftables.service secubox-waf-ng.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/sbx-authwatch \
    --journaux hote,mail:/data/lxc/mail/rootfs/var/log/journal \
    --leurres defaut \
    --leurre-bannieres \
    --comptes /data/volumes/mail/config/users \
    --services /etc/secubox/authwatch/services.json \
    --seuil 6 \
    --fenetre 10m \
    --duree-ban 4h \
    --liste-blanche-fichier /etc/secubox/authwatch/liste-blanche \
    --mail-conteneur=${SBX_MAIL_CONTENEUR}
# #3924 : leurres de messagerie pendant l'arrêt du conteneur de courrier, ÉTEINTS tant que SBX_MAIL_CONTENEUR est vide.
# Pour les armer, écrire dans /etc/secubox/authwatch/authwatch.env (root:root 0640), puis relancer l'unité :
#     SBX_MAIL_CONTENEUR=10.100.0.10
# Jamais de drop-in ExecStart : il masquerait les options des versions suivantes.
Environment=SBX_MAIL_CONTENEUR=
EnvironmentFile=-/etc/secubox/authwatch/authwatch.env
# Arrêt ou plantage : la redirection des ports de messagerie disparaît avec le service (elle expire seule sinon).
ExecStopPost=-/usr/sbin/nft "add table ip secubox_leurres_mail; delete table ip secubox_leurres_mail"
# #3728 : les leurres sont ouverts sur le WAN (secubox-hardening) ; le régime bannière tient la conversation juste
# assez pour recevoir les identifiants des robots (telnet, redis, postgres, HTTP Basic, compte RDP), journalisés EN
# CLAIR avec le client et le profil du visiteur : aucun service ni compte réel derrière ces ports.
Restart=always
RestartSec=10

# Droits : ecrire dans nft (NET_ADMIN) et ouvrir les ports leurres sous 1024
# (NET_BIND_SERVICE, pour telnet 23, smb 445, pop3 110 et imap 143). Rien de plus.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH
# LE GROUPE PLUTOT QUE LA CAPACITE (#1318). Ce service ecrit ses detections dans
# le journal de menaces du pare-feu, qui appartient a secubox-waf. Sans
# CAP_DAC_OVERRIDE — et on ne l'ajoutera pas, c'est tout l'interet de ce
# cloisonnement — root n'outrepasse pas les permissions : le fichier lui restait
# ferme, et ses detections SSH/SMTP/IMAP et de leurres n'atteignaient jamais le
# tableau de bord, alors qu'elles bannissaient bel et bien.
# Appartenir au groupe suffit, et c'est la plus petite permission qui resout le
# probleme.
SupplementaryGroups=secubox-waf
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Le seul chemin en ecriture partage : le journal de menaces du WAF.
ReadWritePaths=/var/log/secubox/waf
# Etat des campagnes par compte vise (#3919), ecrit toutes les 60 s par renommage
# atomique dans /run/secubox-authwatch/campagnes.json. Dossier PROPRE au service :
# jamais /run/secubox, partage (sockets de tous les modules, #1022). Efface a
# l'arret : un etat perime se lirait comme une campagne en cours.
RuntimeDirectory=secubox-authwatch
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
