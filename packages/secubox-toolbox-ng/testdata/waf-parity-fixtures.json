  {
    "_comment": "=== KNOWN GAP 1: router-goform pattern false positive on UA with semicolon ===",
    "_comment2": "Pattern '/goform/.*\\$\\(|`|;' uses unanchored alternation: ANY ';' in scan text triggers it.",
    "_comment3": "A common User-Agent like 'Mozilla/5.0 (X11; Linux x86_64)' contains ';' -> false positive.",
    "_comment4": "Both Python and Go WAF share this pattern bug (same rule file). Go behavior = Python behavior.",
    "_comment5": "Expected = 'warn' (current actual behavior). This is a pattern quality bug, NOT a Go engine bug.",
    "name": "known_gap_router_goform_fp_ua_semicolon",
    "method": "GET",
    "path": "/",
    "query": "",
    "body": "",
    "ua": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36",
    "client_ip": "203.0.113.200",
    "expect": "warn",
    "known_gap": true,
    "_gap_reason": "router-goform pattern '/goform/.*\\$\\(|`|;' has unanchored alternation matching any ';' — FP on common UA with semicolons; shared Python/Go bug, not a parity regression"
  },

  {
    "_comment": "=== KNOWN GAP 2: null-byte CVE patterns — RE2 can't compile \\u0000 sequences ===",
    "_comment2": "5 patterns in cve_voip/cve_xmpp use \\u0000 (stored as literal string in JSON).",
    "_comment3": "RE2 rejects '\\u' as invalid escape. Go skips these at load time.",
    "_comment4": "Python PCRE also treats '\\u0000' as literal string match (not null byte), so both skip the null byte.",
    "_comment5": "However, Go silently drops these patterns; Python would still try to match them.",
    "_comment6": "Requests hitting ONLY these patterns are 'allow' in Go. This is a documented gap.",
    "name": "known_gap_null_byte_cve_voip_body",
    "method": "POST",
    "path": "/api/sip",
    "query": "",
    "body": "Via: SIP/2.0/UDP 10.200.1.1;branch=z9hG4bKsomething",
    "ua": "SIPp/3.6",
    "client_ip": "203.0.113.201",
    "expect": "warn",
    "known_gap": false,
    "_comment7": "Note: 10.200.1.1 in body matches ssrf internal_10 pattern — so this IS caught by Go"
  },
  {
    "name": "known_gap_null_byte_cve_patterns_only",
    "method": "GET",
    "path": "/xmpp-endpoint",
    "query": "stream=clean",
    "body": "",
    "ua": "Strophe.js/1.6.0 clean",
    "client_ip": "203.0.113.202",
    "expect": "allow",
    "known_gap": true,
    "_gap_reason": "cve-ast-2022-42706, cve-ast-2023-37457, cve-opensips-2023-49323, cve-prosody-2022-0217, cve-strophe-2022-29168: RE2 rejects \\u0000 in patterns — these 5 patterns are skipped at compile time; a request matching ONLY these patterns passes the Go WAF"
  }
