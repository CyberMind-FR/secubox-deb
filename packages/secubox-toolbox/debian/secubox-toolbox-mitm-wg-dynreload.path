[Unit]
Description=Watch mitm-bypass-dynamic.conf for auto-learned pinned hosts [Phase 6.N #496]
After=secubox-toolbox-mitm-wg.service

[Path]
# When cert_pin_detect appends a new pattern, restart mitm-wg so the
# ignore_hosts regex picks it up. The launcher merges static + dynamic
# on each start.
PathChanged=/var/lib/secubox/toolbox/mitm-bypass-dynamic.conf

[Install]
WantedBy=multi-user.target
