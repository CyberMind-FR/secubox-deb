[Unit]
Description=SecuBox ToolBoX MITM WireGuard (R3, transparent on wg-toolbox iface)
After=wg-quick@wg-toolbox.service network.target
Requires=wg-quick@wg-toolbox.service
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/496

[Service]
Type=simple
User=secubox-toolbox
Group=secubox-toolbox
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/secubox /var/lib/secubox /tmp /etc/secubox/toolbox/ca-wg
WorkingDirectory=/usr/lib/secubox/toolbox

# Phase 6.C (#496) : transparent mitm on the wg-toolbox iface.
# wg-quick handles WG decapsulation (multi-peer). nft DNAT redirects
# tcp 80/443 from wg-toolbox iface to this mitm port 8081.
# mitm CA = /etc/secubox/toolbox/ca-wg/ (SEPARATE from R1/R2 transparent CA).
ExecStart=/opt/mitmproxy-toolbox/bin/mitmdump \
    --mode transparent \
    --listen-host 10.99.1.1 \
    --listen-port 8081 \
    --set confdir=/etc/secubox/toolbox/ca-wg \
    --set ssl_insecure=false \
    --set web_open_browser=false \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/local_store.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/inject_banner.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/dpi.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/cookies.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/avatar.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/ja4.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/soc_relay.py

Restart=on-failure
RestartSec=5

# Resource bounds
MemoryMax=512M
MemoryHigh=400M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
