# Phase 6 (#496) — LXC config for the dedicated ToolBoX WireGuard MITM container.
# Lives at /etc/lxc/toolbox-mitm-wg.conf after install. Provisioned by
# packages/secubox-toolbox/sbin/secubox-toolbox-wg-provision.
#
# This is the SECOND mitm container — first being toolbox-mitm (#495 transparent).
# Architecture invariant : the two MUST stay disjoint. Don't share addons or CA.

# Base — minimal Debian 12 rootfs, mitmproxy 11+ for --mode wireguard.
lxc.uts.name = toolbox-mitm-wg
lxc.arch = arm64
lxc.rootfs.path = dir:/var/lib/lxc/toolbox-mitm-wg/rootfs

# Network — bridged on br-lxc, distinct IP from WAF (60) and tx (61).
lxc.net.0.type = veth
lxc.net.0.link = br-lxc
lxc.net.0.flags = up
lxc.net.0.name = eth0
lxc.net.0.hwaddr = 00:16:3e:00:00:62
lxc.net.0.ipv4.address = 10.100.0.62/24
lxc.net.0.ipv4.gateway = 10.100.0.1

# Resource bounds — WG mode is heavier than transparent (full QUIC decap).
lxc.cgroup2.memory.high = 600M
lxc.cgroup2.memory.max = 768M

# Autostart, after WAF (100) and toolbox-mitm-tx (110).
lxc.start.auto = 1
lxc.start.delay = 5
lxc.start.order = 120

# Bind mounts — WG-specific :
#   - own CA on host (separate from transparent mitm CA for #495 isolation
#     guarantee). NOT bind-mounting /etc/secubox/toolbox/ca here.
lxc.mount.entry = /etc/secubox/toolbox/ca-wg etc/secubox/toolbox/ca-wg none ro,bind,create=dir 0 0
#   - WG keys + peer database on host (operator-owned)
lxc.mount.entry = /etc/secubox/toolbox/wg etc/secubox/toolbox/wg none ro,bind,create=dir 0 0
#   - mitm-events SQLite shared with toolbox-mitm-tx for unified reporting
lxc.mount.entry = /var/lib/secubox/toolbox var/lib/secubox/toolbox none bind,create=dir 0 0
#   - logs
lxc.mount.entry = /var/log/secubox/toolbox-mitm-wg var/log/secubox/toolbox-mitm-wg none bind,create=dir 0 0
#   - addons (RO from host)
lxc.mount.entry = /usr/lib/secubox/toolbox/mitmproxy_addons usr/lib/secubox/toolbox/mitmproxy_addons none ro,bind,create=dir 0 0
#   - salt for MAC hashing
lxc.mount.entry = /etc/secubox/secrets/toolbox-mac-salt etc/secubox/secrets/toolbox-mac-salt none ro,bind,create=file 0 0

# Capabilities — WG needs CAP_NET_ADMIN + the kernel wireguard module.
lxc.cap.drop = audit_control audit_write mac_admin mac_override mknod sys_module sys_rawio sys_time
# wg kernel iface + tun
lxc.cgroup2.devices.allow = c 10:200 rwm
lxc.cgroup2.devices.allow = c 138:* rwm
lxc.mount.entry = /dev/net/tun dev/net/tun none bind,create=file,optional 0 0

lxc.apparmor.profile = unconfined
