# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Phase 7 follow-up (#498) — LXC config for the dedicated ToolBoX WireGuard
# MITM container (transparent mode on TCP 8081).
#
# Lives at /etc/lxc/toolbox-mitm-wg.conf after install. Provisioned by
# `secubox-toolbox-lxc-provision wg`.
#
# This is the SECOND mitm container — first being toolbox-mitm (#495
# captive transparent). Architecture invariant : the two MUST stay
# disjoint — distinct CA, distinct addon chain, distinct log dir.

# Base — minimal Debian 12 rootfs, /opt/mitmproxy-toolbox (mitmproxy 11+)
# bind-mounted in from the host so the LXC inherits whatever version the
# operator runs on bare metal.
lxc.uts.name = toolbox-mitm-wg
lxc.arch = arm64
lxc.rootfs.path = dir:/var/lib/lxc/toolbox-mitm-wg/rootfs

# Network — bridged on br-lxc, distinct IP from WAF (.60) and tx (.61).
lxc.net.0.type = veth
lxc.net.0.link = br-lxc
lxc.net.0.flags = up
lxc.net.0.name = eth0
lxc.net.0.hwaddr = 00:16:3e:00:00:62
lxc.net.0.ipv4.address = 10.100.0.62/24
lxc.net.0.ipv4.gateway = 10.100.0.1

# Resource bounds — same envelope as the WAF mitm container.
lxc.cgroup2.memory.high = 400M
lxc.cgroup2.memory.max = 512M
lxc.cgroup2.memory.swap.max = 0

# Autostart, after WAF (100) and toolbox-mitm-tx (110).
lxc.start.auto = 1
lxc.start.delay = 5
lxc.start.order = 120

# Bind mounts — single source of truth for code + state. The LXC sees
# the host's files RO (code/secrets) or RW (state).
#
#   - Mitmproxy install (RO) — host owns the version, LXC inherits.
lxc.mount.entry = /opt/mitmproxy-toolbox opt/mitmproxy-toolbox none ro,bind,create=dir 0 0
#   - Launcher script (RO) — composed with addon order + ignore_hosts.
lxc.mount.entry = /usr/sbin/secubox-toolbox-mitm-wg-launch usr/sbin/secubox-toolbox-mitm-wg-launch none ro,bind,create=file 0 0
#   - Addons (RO from host so updates land without rebuilding the LXC).
lxc.mount.entry = /usr/lib/secubox/toolbox/mitmproxy_addons usr/lib/secubox/toolbox/mitmproxy_addons none ro,bind,create=dir 0 0
#   - Dedicated WG CA (RO) — separate from the transparent-mitm CA so the
#     two containers remain compartmentalised (#495 isolation invariant).
# IMPORTANT (Phase 7 #498) — for UNPRIVILEGED LXC the source paths
# below MUST be readable by the LXC root's mapped UID (100000 by
# default). /etc/secubox/toolbox/ca-wg is 0750 root:secubox-toolbox at
# the moment which BLOCKS the mount (Permission denied). Either :
#   1. chmod 0755 /etc/secubox/toolbox/ca-wg (RX for all — relaxes the
#      CA-key visibility ; OK for the PUBLIC cert files, NOT for the
#      private key inside it).
#   2. Use a PRIVILEGED LXC (no lxc.idmap line) — matches the existing
#      mitmproxy LXC. Recommended path for now.
lxc.mount.entry = /etc/secubox/toolbox/ca-wg etc/secubox/toolbox/ca-wg none ro,bind,create=dir 0 0
#   - Bypass lists + SQLite event store (RW, shared with host FastAPI
#     so the cert-pin auto-learning addon's writes show up in /admin).
lxc.mount.entry = /var/lib/secubox/toolbox var/lib/secubox/toolbox none bind,create=dir 0 0
#   - Logs (RW).
lxc.mount.entry = /var/log/secubox/toolbox-mitm-wg var/log/secubox/toolbox-mitm-wg none bind,create=dir 0 0
#   - Salt for MAC hashing (RO, owned root:secubox-toolbox).
lxc.mount.entry = /etc/secubox/secrets/toolbox-mac-salt etc/secubox/secrets/toolbox-mac-salt none ro,bind,create=file 0 0

# Standard capability drops — transparent mode at the application layer
# does not need CAP_NET_ADMIN ; this LXC is a plain user-space TCP proxy.
lxc.cap.drop = audit_control audit_write mac_admin mac_override mknod sys_module sys_rawio sys_time

lxc.apparmor.profile = unconfined
