# Phase 7 follow-up (#498) — secubox-toolbox-mitm-wg (LXC variant).
#
# Installed inside the toolbox-mitm-wg LXC at
# /etc/systemd/system/secubox-toolbox-mitm-wg.service.
#
# This is the LXC equivalent of the host-side host service of the same
# name. It runs the SAME launcher script (which is bind-mounted in from
# the host at /usr/sbin/secubox-toolbox-mitm-wg-launch), keeping the
# addon chain + ignore_hosts compose logic single-sourced.
#
# Architecture decision (conservative migration) — we keep transparent
# mode on TCP 8081 instead of switching to `--mode wireguard` :
#
#   - wg-quick@wg-toolbox stays on the host so the existing 35 peers,
#     server keypair and DNS DNAT chain don't have to be re-issued
#     in a different format.
#   - Host nft DNAT routes wg-toolbox tcp 443/80 to 10.100.0.62:8081
#     (instead of 10.99.1.1:8081). br-lxc delivers the redirected
#     packet to this LXC, which terminates TLS with the R3 CA and
#     fires addons.
#   - The LXC has NO direct view of wg-toolbox iface — it only sees
#     the inbound-DNAT'd TCP flow, which is enough for transparent
#     mitm at the application layer.

[Unit]
Description=SecuBox ToolBoX MITM WireGuard (R3, LXC)
After=network.target
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/498

[Service]
Type=simple
User=root
WorkingDirectory=/usr/lib/secubox/toolbox

# Same launcher as the host variant — it is bind-mounted in from the host
# (lxc.mount.entry in toolbox-mitm-wg.conf). The launcher composes the
# ignore_hosts regex from static + dynamic bypass lists and exec's
# mitmdump with the full addon chain. Single source of truth.
ExecStart=/usr/sbin/secubox-toolbox-mitm-wg-launch

Restart=on-failure
RestartSec=5

# Phase 7 (#498) — matches the host variant's 6 h hygiene cycle. Long-
# running transparent mitmproxy under attack traffic accumulates SSL
# session state ; cycling every 6 h keeps RSS predictable.
RuntimeMaxSec=21600

# Memory bound — matches the host service's drop-in.
MemoryHigh=400M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
