# Phase 5 (#495) — LXC config for the dedicated ToolBoX mitmproxy container.
# Lives at /etc/lxc/toolbox-mitm.conf after install. Generated/installed by
# packages/secubox-toolbox/sbin/secubox-toolbox-lxc-provision.

# Base — minimal Debian 12 rootfs (~80 MB)
lxc.uts.name = toolbox-mitm
lxc.arch = arm64
lxc.rootfs.path = dir:/var/lib/lxc/toolbox-mitm/rootfs

# Network — bridged on br-lxc (same as WAF mitm container) but distinct IP.
# Container IP 10.100.0.61 is one above WAF mitm (10.100.0.60). Static MAC
# so DHCP-less + reproducible across reboots.
lxc.net.0.type = veth
lxc.net.0.link = br-lxc
lxc.net.0.flags = up
lxc.net.0.name = eth0
lxc.net.0.hwaddr = 00:16:3e:00:00:61
lxc.net.0.ipv4.address = 10.100.0.61/24
lxc.net.0.ipv4.gateway = 10.100.0.1

# Resource bounds — same envelope as WAF mitm container.
# memory.high = soft cap (kernel pressure), memory.max = hard OOM-kill cap.
lxc.cgroup2.memory.high = 400M
lxc.cgroup2.memory.max = 512M

# Autostart, after WAF mitm so they don't race for /run mounts.
lxc.start.auto = 1
lxc.start.delay = 5
lxc.start.order = 110

# Bind mounts (read-only for code/config, read-write for events/logs).
# CA store : the toolbox CA generated at install lives on the HOST and is
# bind-mounted in. Host owns the CA so it survives container rebuild.
lxc.mount.entry = /etc/secubox/toolbox/ca etc/secubox/toolbox/ca none ro,bind,create=dir 0 0
# mitm-events SQLite shared between modules — bind RW
lxc.mount.entry = /var/lib/secubox/toolbox var/lib/secubox/toolbox none bind,create=dir 0 0
# mitm logs go to host journal via lxc-attach pipe OR mounted dir
lxc.mount.entry = /var/log/secubox/toolbox-mitm var/log/secubox/toolbox-mitm none bind,create=dir 0 0
# Addons live on host (so package upgrade replaces them) — bind RO
lxc.mount.entry = /usr/lib/secubox/toolbox/mitmproxy_addons usr/lib/secubox/toolbox/mitmproxy_addons none ro,bind,create=dir 0 0
# Salt for MAC hashing — bind RO with strict mode
lxc.mount.entry = /etc/secubox/secrets/toolbox-mac-salt etc/secubox/secrets/toolbox-mac-salt none ro,bind,create=file 0 0

# Capabilities — minimal. Drop everything, then explicit allow.
# CAP_NET_BIND_SERVICE not needed (mitm listens >1024). NET_ADMIN/RAW only
# needed for transparent mode. Reverse mode = none required.
# We start in WIREGUARD mode (Phase 6) for future R3 — so NET_ADMIN +
# CAP_SYS_MODULE for the wg kernel interface.
lxc.cap.drop = audit_control audit_write mac_admin mac_override mknod sys_module sys_rawio sys_time
# Allow tun creation for mitm transparent/wireguard mode
lxc.cgroup2.devices.allow = c 10:200 rwm

# AppArmor profile = unconfined for now ; Phase 5.B will write a dedicated
# profile that matches the addon paths.
lxc.apparmor.profile = unconfined
