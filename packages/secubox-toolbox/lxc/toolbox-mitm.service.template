[Unit]
Description=SecuBox ToolBoX MITM (transparent mode, in dedicated LXC)
After=network.target
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/495

[Service]
Type=simple
User=root
# mitmproxy needs CAP_NET_ADMIN + tun device access in transparent mode
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
# Sandbox MUST allow the bind-mounted paths from the host
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/secubox/toolbox-mitm /var/lib/secubox/toolbox /tmp
# CA cert + addons + salt are RO bind-mounts from host
WorkingDirectory=/usr/lib/secubox/toolbox

# Phase 5 (#495) : transparent mode (current ToolBoX MITM behavior).
# Phase 6 (#496) : SecondaryUnit will run wireguard-mode instance on UDP 51820
# inside a SECOND container (toolbox-mitm-wg) — DO NOT mix here.
ExecStart=/usr/bin/mitmdump \
    --mode transparent \
    --listen-host 0.0.0.0 \
    --listen-port 8080 \
    --set confdir=/etc/secubox/toolbox/ca \
    --set ssl_insecure=false \
    --set web_open_browser=false \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/local_store.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/inject_banner.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/dpi.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/cookies.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/avatar.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/ja4.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/soc_relay.py
Restart=on-failure
RestartSec=5

# Resource bounds inside the container (LXC also caps at 512M)
MemoryMax=480M
MemoryHigh=380M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
