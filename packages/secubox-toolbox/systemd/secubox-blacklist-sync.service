# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Phase 13.A (#521) — union ban sources into the nft blacklist sets.
[Unit]
Description=SecuBox blacklist enforcement sync (threat-intel -> nft sets)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/521
After=nftables.service secubox-toolbox.service
Wants=nftables.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/secubox-blacklist-sync
# Needs CAP_NET_ADMIN for nft set writes ; root is simplest + the script
# is read-only against the toolbox DB.
User=root
Nice=10
IOSchedulingClass=idle
# 600 s etait dimensionne pour le balayage DNS de la Source 3, retiree le
# 2026-08-16 (#1045). Ce qui reste — une requete SQLite et des ajouts
# nft par lots — se compte en secondes. Un plafond genereux ne protegeait plus
# de rien : il laissait simplement un blocage tourner dix minutes avant que
# systemd ne s'en apercoive.
# 300 s et non 120 : une passe ordinaire prend une dizaine de secondes, mais
# apres une re-ingestion des flux un lot peut etre refuse et se rejouer element
# par element — quelques milliers d'appels nft. 120 s coupait la synchronisation
# en plein milieu, et les sets restaient a moitie charges.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
