[Unit]
Description=SecuBox-Deb ToolBoX mitmproxy transparent (R2 MITM analyzer)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/475
After=network.target secubox-toolbox.service
Requires=secubox-toolbox.service

[Service]
Type=simple
User=root
# Root because mitmproxy needs CAP_NET_BIND_SERVICE on :8080 (transparent TPROXY)
# and CAP_NET_RAW for redirect_packet detection.
# mitmproxy en mode transparent (TPROXY) écoute sur 10.99.0.1:8080,
# le mark 0x1 (posé par nftables) redirige le trafic des MAC R2-consented.
ExecStart=/usr/bin/mitmdump \
    --mode transparent \
    --listen-host 10.99.0.1 \
    --listen-port 8080 \
    --set confdir=/etc/secubox/toolbox/mitm \
    --set ssl_insecure=false \
    --set web_open_browser=false \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/cookies.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/dpi.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/avatar.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/ja4.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/soc_relay.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/inject_banner.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/protective_mode.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/privacy_guard.py \
    -s /usr/lib/secubox/toolbox/mitmproxy_addons/local_store.py
Restart=on-failure
RestartSec=5

# Pré-création du confdir avec le CA pré-installé (mitmproxy doit le voir)
ExecStartPre=/usr/sbin/secubox-toolbox-ca-init

[Install]
WantedBy=multi-user.target
