# SecuBox-Deb :: proxypac-wpad — applique l'échelon WPAD selon le rôle détecté.
set -euo pipefail
DRYRUN="${WPAD_DRYRUN:-0}"
DNSMASQ_D="${WPAD_DNSMASQ_D:-/etc/dnsmasq.d}"
UNBOUND_D="${WPAD_UNBOUND_D:-/etc/unbound/unbound.conf.d}"
DOMAIN="${WPAD_DOMAIN:-$(hostname -d 2>/dev/null || echo local)}"
LAN_IP="${WPAD_LAN_IP:-$(/usr/sbin/tor-lan-ip 2>/dev/null || echo 127.0.0.1)}"
WPAD_CONFIG="${WPAD_CONFIG:-/etc/secubox/proxypac/proxypac.toml}"
# racine du paquet source (sbin/../) : fallback sys.path pour que
# `from proxypac.config import load` résolve aussi en environnement de test,
# où le module n'est pas installé sous /usr/lib/secubox/proxypac.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_ROOT="$(dirname "$SCRIPT_DIR")"
# rôle : override explicite (WPAD_ROLE, priorité tests) sinon override toml
# (role=master|slave|off dans proxypac.toml) sinon détection auto complète.
role() {
  if [ -n "${WPAD_ROLE:-}" ]; then echo "$WPAD_ROLE"; return; fi
  python3 - "$PKG_ROOT" "$WPAD_CONFIG" <<'PY'
import sys
sys.path.insert(0, "/usr/lib/secubox/proxypac")
sys.path.insert(0, sys.argv[1])
from proxypac.config import load
from proxypac.role import detect

override = load(sys.argv[2]).get("role", "auto")
if override == "master":
    print("master")
elif override == "off":
    print("off")
elif override == "slave":
    r = detect()
    print("slave-dns" if r.get("dns_resolver") else "slave")
else:
    r = detect()
    print("master" if r["tier"] == 1 else ("slave-dns" if r["tier"] == 2 else "slave"))
PY
}
_reload(){ [ "$DRYRUN" = "1" ] && return 0; "$@" || true; }

# Recharge Unbound SANS couper le DNS (#3958) : bibliothèque commune, checkconf puis fast_reload. Jamais `restart` ni `reload`
# d'ici (48 s sans DNS pour tout le LAN le 2026-11-25). À n'appeler que si NOTRE dropin a changé. Unbound arrêté : rien à
# faire, il lira le fichier à son démarrage.
_recharger_unbound() {
  [ "$DRYRUN" = "1" ] && return 0
  systemctl is-active --quiet unbound || return 0
  python3 -I -c '
from secubox_unbound import SystemeUnbound
class S(SystemeUnbound):
    MODULE = "proxypac"
s = S()
ok, sortie = s.verifier_unbound()
if not ok:
    raise SystemExit("unbound-checkconf refuse la configuration, pas de rechargement : " + sortie[:300])
s.recharger_unbound()
' || echo "proxypac : Unbound non rechargé" >&2
}

# Pose (contenu non vide) ou retire (contenu vide) un dropin ; rend 0 seulement s'il a CHANGÉ.
_poser() {
  local chemin="$1" contenu="$2"
  if [ -z "$contenu" ]; then
    [ -e "$chemin" ] || return 1
    rm -f "$chemin"
    return 0
  fi
  if [ -f "$chemin" ] && [ "$(cat "$chemin")" = "$contenu" ]; then return 1; fi
  printf '%s\n' "$contenu" > "$chemin"
}

apply() {
  local r; r="$(role)"
  # contenu voulu des deux dropins ; vide = retiré (jamais ceux de deux échelons à la fois)
  local dhcp="" dns=""
  case "$r" in
    master)
      dhcp="$(printf '# secubox-proxypac WPAD (auto)\ndhcp-option=252,"http://wpad.%s/wpad.dat"' "$DOMAIN")" ;;
    slave-dns)
      # UN DOMAINE VIDE COUPE LE DNS DE TOUT LE LAN.
      #
      # Sans domaine, ce printf produit `local-data: "wpad.. A <ip>"` — un
      # label vide. Unbound ne l'ignore pas : il REFUSE DE DEMARRER
      # (« fatal error: Could not set up local zones »), et repart en boucle.
      # Le 2026-08-17 il a redemarre 18 fois d'affilee, plus aucun nom ne se
      # resolvait sur la board ni sur le LAN, et toute la surface web est
      # devenue injoignable — pour une variable vide dans un fichier auxiliaire.
      #
      # On n'ecrit donc rien plutot qu'un fichier qui casse le resolveur : sans
      # WPAD, les postes configurent leur proxy a la main ; sans DNS, plus rien
      # ne fonctionne.
      if [ -z "${DOMAIN:-}" ] || [ -z "${LAN_IP:-}" ]; then
        echo "wpad: domaine ou adresse absents — aucun dropin ecrit (un label vide empecherait unbound de demarrer)" >&2
      else
        dns="$(printf '# secubox-proxypac WPAD via DNS (auto)\nserver:\n    local-data: "wpad.%s. A %s"' "$DOMAIN" "$LAN_IP")"
      fi ;;
    *) : ;;  # slave (tier3) et off : no-op réseau (aucun dropin, garde-fou anti double-DHCP)
  esac
  # rechargés seulement si leur dropin a changé (#3958)
  if _poser "$DNSMASQ_D/secubox-wpad.conf" "$dhcp"; then _reload systemctl reload dnsmasq; fi
  if _poser "$UNBOUND_D/secubox-wpad.conf" "$dns"; then _recharger_unbound; fi
  echo "wpad applied role=$r domain=$DOMAIN"
}
state() {
  local r; r="$(role)"
  printf '{"role":"%s","domain":"%s","lan_ip":"%s","pac_url":"http://wpad.%s/wpad.dat"}\n' "$r" "$DOMAIN" "$LAN_IP" "$DOMAIN"
}
case "${1:-}" in apply) apply;; state) state;; *) echo "usage: proxypac-wpad {apply|state}" >&2; exit 2;; esac
