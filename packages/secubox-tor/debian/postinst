#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    systemctl daemon-reload
    systemctl enable secubox-tor.service || true
    systemctl start secubox-tor.service || true
    sysctl --system || true
    # La version 1.2.x livrait le GABARIT brut du dropin SOCKS comme conffile ;
    # dpkg a pu en laisser une copie .dpkg-dist (espace réservé __LAN_IP__).
    # torctl rend désormais le vrai fichier ; la copie périmée est retirée (#1765).
    for f in /etc/tor/torrc.d/50-secubox-socks-lan.conf.dpkg-dist \
             /etc/tor/torrc.d/50-secubox-socks-lan.conf.dpkg-new; do
        [ -f "$f" ] && rm -f "$f"   # plus aucun conffile à cet emplacement
    done
    # transparent activé par défaut (aligné proxypac.toml transparent=true) ;
    # idempotent, best-effort, réutilise le TransPort toolbox s'il existe.
    # AVANT socks-lan : `on` retire d'abord un éventuel doublon d'écouteurs,
    # puis socks-lan redémarre Tor sur une config saine (#1765).
    /usr/sbin/torctl transparent on || true
    /usr/sbin/torctl socks-lan ensure || true
fi
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/tor/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "tor : postinst de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/tor/maintscripts/*.postinst; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "tor : postinst de $(basename "$_s") en échec" >&2; }
done
exit 0
