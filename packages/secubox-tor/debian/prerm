#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
    systemctl stop secubox-tor.service || true
    systemctl disable secubox-tor.service || true
fi
#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/tor/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "tor : prerm de $(basename "$_s") en échec" >&2; }
done

# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/tor/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "tor : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
