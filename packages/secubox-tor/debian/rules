#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-tor/usr/lib/secubox/tor
	cp -r api debian/secubox-tor/usr/lib/secubox/tor/
	install -d debian/secubox-tor/usr/share/secubox/www/tor
	cp -r www/tor/. debian/secubox-tor/usr/share/secubox/www/tor/
	install -d debian/secubox-tor/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-tor/usr/share/secubox/menu.d/ || true

	# Install nginx config
	install -d $(CURDIR)/debian/secubox-tor/etc/nginx/secubox.d
	install -m 644 nginx/tor.conf $(CURDIR)/debian/secubox-tor/etc/nginx/secubox.d/tor.conf
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d $(CURDIR)/debian/secubox-tor/etc/nginx/secubox-routes.d
	install -m 644 nginx/tor.conf $(CURDIR)/debian/secubox-tor/etc/nginx/secubox-routes.d/tor.conf

	# Helpers (torctl copies templates below from /usr/share/secubox/tor/).
	# Effacés par la fusion bab2f860d0 (#1765) : le postinst appelait un torctl
	# absent, masqué par `|| true`. Le dropin SOCKS LAN n'est PAS livré dans
	# /etc/tor/torrc.d : c'est un GABARIT (__LAN_IP__) que torctl rend avec
	# l'adresse de la box ; livré brut, tor lirait un espace réservé.
	install -D -m 755 sbin/tor-lan-ip debian/secubox-tor/usr/sbin/tor-lan-ip
	install -D -m 755 sbin/torctl debian/secubox-tor/usr/sbin/torctl
	install -d debian/secubox-tor/usr/share/secubox/tor
	install -m 644 conf/torrc.d/50-secubox-socks-lan.conf conf/torrc.d/60-secubox-transparent.conf debian/secubox-tor/usr/share/secubox/tor/
	install -m 644 conf/unbound/secubox-onion-forward.conf debian/secubox-tor/usr/share/secubox/tor/
	install -m 644 nft.d/secubox-tor-transparent.nft debian/secubox-tor/usr/share/secubox/tor/

	# route_localnet reboot-persistence: conf.all inherited by ifaces created
	# after boot (wg-toolbox); torctl already sets it live per-iface at
	# `transparent on` time, this dropin covers ifaces recreated later.
	install -D -m 644 debian/secubox-tor-route-localnet.sysctl debian/secubox-tor/etc/sysctl.d/60-secubox-route-localnet.conf
	# Composant absorbé : proxypac (#2050)
	install -d debian/secubox-tor/usr/lib/secubox/proxypac
	cp -r composants/proxypac/proxypac composants/proxypac/api debian/secubox-tor/usr/lib/secubox/proxypac/
	install -D -m 755 composants/proxypac/sbin/proxypac-gen debian/secubox-tor/usr/sbin/proxypac-gen
	install -d debian/secubox-tor/etc/nginx/secubox.d
	cp composants/proxypac/nginx/proxypac.conf debian/secubox-tor/etc/nginx/secubox.d/
	install -d debian/secubox-tor/etc/nginx/sites-available
	cp composants/proxypac/nginx/wpad-vhost.conf debian/secubox-tor/etc/nginx/sites-available/
	install -d debian/secubox-tor/usr/lib/systemd/system
	cp composants/proxypac/systemd/secubox-proxypac.service composants/proxypac/systemd/secubox-proxypac-gen.service composants/proxypac/systemd/secubox-proxypac-gen.path composants/proxypac/systemd/secubox-proxypac-gen.timer debian/secubox-tor/usr/lib/systemd/system/
	install -d debian/secubox-tor/etc/secubox/proxypac/rules.d
	cp composants/proxypac/conf/rules.d/*.rules debian/secubox-tor/etc/secubox/proxypac/rules.d/
	install -d debian/secubox-tor/usr/share/secubox/www
	cp -r composants/proxypac/www/. debian/secubox-tor/usr/share/secubox/www/
	install -d debian/secubox-tor/usr/share/secubox/menu.d
	cp composants/proxypac/menu.d/*.json debian/secubox-tor/usr/share/secubox/menu.d/
	install -D -m 644 composants/proxypac/conf/proxypac.toml debian/secubox-tor/etc/secubox/proxypac/proxypac.toml
	install -D -m 755 composants/proxypac/sbin/proxypac-wpad debian/secubox-tor/usr/sbin/proxypac-wpad
	install -D -m 440 composants/proxypac/debian/secubox-proxypac.sudoers debian/secubox-tor/etc/sudoers.d/secubox-proxypac
	install -D -m 755 composants/proxypac/debian/postinst debian/secubox-tor/usr/lib/secubox/tor/maintscripts/proxypac.postinst
	install -D -m 755 composants/proxypac/debian/prerm debian/secubox-tor/usr/lib/secubox/tor/maintscripts/proxypac.prerm
	# Composant absorbé : macro (#2050)
	install -d $(CURDIR)/debian/secubox-tor/usr/sbin
	install -m 755 composants/macro/sbin/secubox-macroctl $(CURDIR)/debian/secubox-tor/usr/sbin/
	install -d $(CURDIR)/debian/secubox-tor/usr/lib/secubox/macro/macros.d
	install -m 755 composants/macro/macros.d/tor-exit $(CURDIR)/debian/secubox-tor/usr/lib/secubox/macro/macros.d/
	install -d $(CURDIR)/debian/secubox-tor/etc/sudoers.d
	install -m 440 composants/macro/sudoers.d/secubox-macro $(CURDIR)/debian/secubox-tor/etc/sudoers.d/
	install -d $(CURDIR)/debian/secubox-tor/etc/apparmor.d
	install -m 644 composants/macro/apparmor/secubox-macroctl $(CURDIR)/debian/secubox-tor/etc/apparmor.d/
	install -d $(CURDIR)/debian/secubox-tor/usr/share/secubox/macro
	install -m 644 composants/macro/conf/secubox-macro-tor-exit.conf.example $(CURDIR)/debian/secubox-tor/usr/share/secubox/macro/
	install -D -m 755 composants/macro/debian/postinst debian/secubox-tor/usr/lib/secubox/tor/maintscripts/macro.postinst
	install -D -m 755 composants/macro/debian/prerm debian/secubox-tor/usr/lib/secubox/tor/maintscripts/macro.prerm

