[Unit]
Description=SecuBox Tor API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
# Discovery (_discover_hidden_services) reads .onion hostname files under
# /var/lib/tor and /var/lib/tor/hidden_services, which the Debian tor
# package owns as debian-tor:debian-tor and keeps at 0700. Being in the
# debian-tor group is necessary but NOT sufficient by itself — the parent
# directories also need group-traverse/read bits granted operator-side
# (chmod 750 + chgrp debian-tor); discovery stays fail-safe (empty list)
# until that's done, it never 500s.
SupplementaryGroups=debian-tor
WorkingDirectory=/usr/lib/secubox/tor
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/tor.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/tor.sock --log-level warning
Restart=on-failure
RestartSec=5
UMask=0000

NoNewPrivileges=true
# RuntimeDirectory=secubox RETIRE (#1022) : /run/secubox est partage par ~95
# unites, et systemd EFFACE le contenu d'un RuntimeDirectory au redemarrage —
# une seule unite qui le declare emporte les sockets de toutes les autres, et
# la board rend des 502 sur des modules qui n'avaient rien demande. Le parent
# reste root:root 1777, cree hors des unites.
RuntimeDirectoryMode=0775

ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox /var/log/secubox

[Install]
WantedBy=multi-user.target
