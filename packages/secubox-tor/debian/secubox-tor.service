[Unit]
Description=SecuBox Tor API
After=network.target secubox-core.service
Wants=secubox-core.service

# /run/secubox N'EST PAS UN RuntimeDirectory (#1022).
#
# Il est PARTAGE par une centaine de modules. `RuntimeDirectory=` est concu pour
# un repertoire PROPRE a un service : systemd le recree a chaque demarrage avec
# le mode de l'unite, donc le dernier service demarre imposait le sien. Huit
# unites le posaient en 0755, ce qui privait tous les autres du droit d'y creer
# leur socket — « bind: permission denied », et un 502 dont la cause etait le
# redemarrage d'un module sans rapport, survenu entre-temps.
#
# Le meme mecanisme effacait le repertoire a l'arret d'un service, emportant les
# sockets des quatre-vingt-dix autres.
#
# Il est desormais declare une seule fois, en 1777, par le tmpfiles.d de
# secubox-core — un seul proprietaire, une seule verite.
[Service]
Type=simple
User=secubox
Group=secubox
# Discovery (_discover_hidden_services) reads .onion hostname files under
# /var/lib/tor and /var/lib/tor/hidden_services, which the Debian tor
# package owns as debian-tor:debian-tor and keeps at 0700. Being in the
# debian-tor group is necessary but NOT sufficient by itself — the parent
# directories also need group-traverse/read bits granted operator-side
# (chmod 750 + chgrp debian-tor); discovery stays fail-safe (empty list)
# until that's done, it never 500s.
SupplementaryGroups=debian-tor
WorkingDirectory=/usr/lib/secubox/tor
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/tor.sock --log-level warning
Restart=on-failure
RestartSec=5
UMask=0000

NoNewPrivileges=true
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox /var/log/secubox

[Install]
WantedBy=multi-user.target
