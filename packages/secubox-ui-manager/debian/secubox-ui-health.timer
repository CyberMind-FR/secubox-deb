[Unit]
Description=SecuBox UI Health Check Timer
Documentation=https://secubox.in/docs/ui-manager

[Timer]
OnBootSec=30
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=30
OnUnitActiveSec=30
Unit=secubox-ui-health.service

[Install]
WantedBy=timers.target
