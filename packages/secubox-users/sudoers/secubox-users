# secubox-users — comptes dans les services modulaires (#1375).
#
# Routes : GET/POST /api/v1/users/user/{u}/services…, création, suppression et
# changement de mot de passe d'un utilisateur. Root parce que créer un compte
# Nextcloud, une boîte aux lettres, un compte Gitea entre dans un conteneur LXC.
#
# EXACTE ET SANS ARGUMENT (""). La demande arrive en JSON sur stdin ; le helper
# la valide lui-même. Aucun mot de passe ne passe par argv.
secubox ALL=(root) NOPASSWD: /usr/sbin/secubox-usersctl-services ""
