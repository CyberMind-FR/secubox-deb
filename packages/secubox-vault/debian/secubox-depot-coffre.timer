[Unit]
Description=SecuBox — la connexion d'un administrateur ouvre le Coffre, la clé du dépôt se déverrouille (#2007)

[Timer]
OnBootSec=90s
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=90s
OnUnitActiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target
