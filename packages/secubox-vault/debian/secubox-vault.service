# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: le Coffre (secubox-vault 2.0, #1367 P1)
#
# Un utilisateur À LUI (secubox-coffre) : les modules tournent tous sous
# `secubox` ; s'il était l'un d'eux, n'importe lequel traverserait le
# répertoire de la socket racine et lirait les valeurs. La MK ne vit qu'en
# mémoire : ni vidage (LimitCORE=0), ni swap (mlock).
[Unit]
Description=SecuBox Coffre — clé maîtresse en mémoire, scellé par défaut
After=network.target secubox-core.service

[Service]
Type=simple
User=secubox-coffre
Group=secubox-coffre
SupplementaryGroups=secubox
WorkingDirectory=/usr/lib/secubox/vault
Environment=PYTHONDONTWRITEBYTECODE=1
# En root (« + ») : une socket périmée laissée par un autre utilisateur dans
# /run/secubox (sticky) ne se retire pas autrement — vécu sur gk3, elle
# appartenait à secubox-waf et le démon tournait en boucle.
ExecStartPre=+/bin/rm -f /run/secubox/vault.sock
# Le journal chaîné du Coffre appartient au service (#3108) : retrouvé secubox:secubox après un démarrage de gk2,
# le Coffre ne pouvait plus l'écrire, donc plus s'ouvrir (HTTP 500). Le postinst ne corrige qu'à l'installation ;
# ici, à chaque démarrage. Créé s'il manque (sans jamais tronquer un journal existant), contenu jamais touché.
ExecStartPre=+/bin/sh -c 'test -e /var/log/secubox/coffre.journal || install -o secubox-coffre -g secubox -m 0640 /dev/null /var/log/secubox/coffre.journal'
ExecStartPre=+/bin/chown secubox-coffre:secubox /var/log/secubox/coffre.journal
ExecStartPre=+/bin/chmod 0640 /var/log/secubox/coffre.journal
ExecStart=/usr/bin/python3 -m coffre.daemon
RuntimeDirectory=secubox-coffre
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
LimitCORE=0
LimitMEMLOCK=16M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_INET pour la seule alerte d'ouverture distante (P4) : le relais SMTP du
# conteneur mail, et rien d'autre.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.100.0.10/32
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/secubox/coffre /run/secubox /var/log/secubox/coffre.journal

[Install]
WantedBy=multi-user.target
