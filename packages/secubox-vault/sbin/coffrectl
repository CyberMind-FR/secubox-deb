"""coffrectl — le Coffre de la box, pour root (#1367 P1).

Les phrases, codes et valeurs ne passent JAMAIS par la ligne de commande
(visible dans `ps` et l'historique) : invite masquée sur un terminal, sinon
entrée standard.

  coffrectl etat
  coffrectl initialiser                    # phrase, puis 5 codes de secours (une seule fois)
  coffrectl ouvrir [--secours]
  coffrectl sceller
  coffrectl secrets [COMPARTIMENT]
  coffrectl poser COMPARTIMENT NOM         # valeur : invite ou stdin
  coffrectl lire COMPARTIMENT NOM
  coffrectl retirer COMPARTIMENT NOM
  coffrectl serrure-ajouter [LIBELLE]
  coffrectl serrure-retirer ID
  coffrectl codes                          # régénère les 5 codes de secours
  coffrectl journal [N] [--verifier]

  coffrectl depot etat                     # clé de signature du dépôt apt (P2)
  coffrectl depot proteger                 # phrase aléatoire, rangée au Coffre
  coffrectl depot session [--minutes N]    # signer pendant N min (15 ; 60 au plus)
  coffrectl depot fin                      # l'agent oublie la phrase tout de suite

  coffrectl niveau0 etat                   # secrets de démarrage (P3, systemd-creds)
  coffrectl niveau0 migrer NOM CHEMIN UNITE.service   # chiffre et déclare ; garde le clair
  coffrectl niveau0 retirer-clair NOM      # détruit le clair, si l'unité tourne avec la crédence
  coffrectl niveau0 lire NOM               # root : la valeur, sur la sortie standard
"""
import getpass
import http.client
import json
import os
import socket
import sys

SOCKET = os.environ.get("SECUBOX_COFFRE_SOCKET_RACINE", "/run/secubox-coffre/racine.sock")
sys.path.insert(0, os.environ.get("SECUBOX_COFFRE_LIB", "/usr/lib/secubox/vault"))


class _Connexion(http.client.HTTPConnection):
    def __init__(self):
        super().__init__("coffre", timeout=60)

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(60)
        self.sock.connect(SOCKET)


def appel(methode: str, chemin: str, corps=None):
    try:
        c = _Connexion()
        c.request(methode, chemin, body=None if corps is None else json.dumps(corps),
                  headers={"Content-Type": "application/json"})
        r = c.getresponse()
        donnees = json.loads(r.read() or b"{}")
    except (FileNotFoundError, ConnectionRefusedError):
        sys.exit("coffrectl : le démon ne répond pas (systemctl status secubox-vault)")
    except PermissionError:
        sys.exit("coffrectl : réservé à root")
    if r.status >= 400:
        sys.exit(f"coffrectl : {donnees.get('detail', r.status)}")
    return donnees


def saisie(invite: str, confirmer: bool = False) -> str:
    if not sys.stdin.isatty():
        return sys.stdin.readline().rstrip("\n")
    v = getpass.getpass(invite)
    if confirmer and getpass.getpass("Confirmer : ") != v:
        sys.exit("coffrectl : les deux saisies diffèrent")
    return v


def affiche_etat(e: dict) -> None:
    if not e.get("initialise"):
        print("Coffre : non initialisé — coffrectl initialiser")
        return
    print(f"Coffre : {'OUVERT' if e.get('ouvert') else 'scellé'}"
          + (f" (rescellement dans {e['reste_s']} s)" if e.get("ouvert") and "reste_s" in e else ""))
    j = e.get("journal", {})
    print(f"Journal : {j.get('lignes', 0)} lignes, " + ("intègre" if j.get("integre") else
          f"CHAÎNE ROMPUE à la ligne {j.get('ligne_fautive')}"))
    for s in e.get("serrures", []):
        print(f"  serrure {s['id']}  {s['genre']:8}  {s['libelle']}")
    for c in e.get("compartiments", []):
        print(f"  compartiment {c['id']}  ({c['nature']}) — {c['secrets']} secret(s)")


def depot(args) -> None:
    """Session de signature du dépôt apt (P2)."""
    from coffre import depot as d
    sous = args[0] if args else "etat"
    try:
        fpr = d.empreinte_signature()
        if sous == "etat":
            e = d.etat(fpr)
            if "--porcelaine" in args:
                print(f"protegee={int(e['protegee'])} en_cache={int(e['en_cache'])} empreinte={fpr}")
                return
            print(f"clé {fpr[-16:]} : " + ("protégée par le Coffre" if e["protegee"] else "EN CLAIR — coffrectl depot proteger")
                  + (" ; session ouverte (l'agent tient la phrase)" if e["en_cache"] else ""))
        elif sous == "proteger":
            d.proteger(fpr, lambda nom, valeur: appel("POST", "/secrets",
                                                      {"compartiment": "box", "nom": nom, "valeur": valeur}))
            print(f"clé {fpr[-16:]} protégée : sa phrase n'existe qu'au Coffre. Signer : coffrectl depot session")
        elif sous == "session":
            minutes = 15
            if "--minutes" in args:
                minutes = int(args[args.index("--minutes") + 1])
            phrase = appel("GET", f"/secrets/box/{d.nom_secret(fpr)}/valeur")["valeur"]
            d.session(fpr, phrase, minutes)
            del phrase
            print(f"session de signature ouverte pour {minutes} min (clé {fpr[-16:]})")
        elif sous == "fin":
            d.oublier(fpr)
            print("session de signature close")
        else:
            sys.exit("coffrectl depot : etat | proteger | session [--minutes N] | fin")
    except d.ErreurDepot as e:
        sys.exit(f"coffrectl depot : {e}")


def niveau0(args) -> None:
    """Secrets de démarrage (P3) : systemd-creds, sans le Coffre ouvert."""
    from coffre import niveau0 as n
    sous = args[0] if args else "etat"
    try:
        if sous == "etat":
            lignes = n.etat()
            if not lignes:
                print("aucun secret de niveau 0 — coffrectl niveau0 migrer NOM CHEMIN UNITE.service")
            for e in lignes:
                unites = ", ".join(f"{u['unite']} ({'chargée' if u['porte'] else 'à redémarrer'})" for u in e["unites"])
                print(f"{e['nom']:28} clair {'PRÉSENT' if e['clair_present'] else 'retiré'} — {unites}")
        elif sous == "migrer" and len(args) == 4:
            n.migrer(args[1], args[2], args[3])
            print(f"{args[1]} chiffré et déclaré à {args[3]} — redémarrer l'unité, puis : coffrectl niveau0 retirer-clair {args[1]}")
        elif sous == "retirer-clair" and len(args) == 2:
            print("détruit :", n.retirer_clair(args[1]))
        elif sous == "lire" and len(args) == 2:
            sys.stdout.write(n.dechiffrer(args[1]).decode("utf-8", "replace"))
        else:
            sys.exit("coffrectl niveau0 : etat | migrer NOM CHEMIN UNITE.service | retirer-clair NOM | lire NOM")
    except n.ErreurNiveau0 as e:
        sys.exit(f"coffrectl niveau0 : {e}")


def principal(argv) -> None:
    if not argv or argv[0] in ("-h", "--help", "aide"):
        print(__doc__)
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "etat":
        affiche_etat(appel("GET", "/etat"))
    elif cmd == "initialiser":
        phrase = saisie("Phrase du Coffre (12 caractères au moins) : ", confirmer=True)
        codes = appel("POST", "/initialiser", {"phrase": phrase})["codes"]
        print("Coffre initialisé et ouvert. CODES DE SECOURS — à imprimer, ne s'afficheront plus :")
        for c in codes:
            print("   ", c)
    elif cmd == "ouvrir":
        genre = "secours" if "--secours" in args else "phrase"
        secret = saisie("Code de secours : " if genre == "secours" else "Phrase : ")
        affiche_etat(appel("POST", "/ouvrir", {"secret": secret, "genre": genre}))
    elif cmd == "sceller":
        affiche_etat(appel("POST", "/sceller"))
    elif cmd == "secrets":
        q = f"?compartiment={args[0]}" if args else ""
        for s in appel("GET", "/secrets" + q)["secrets"]:
            print(f"{s['compartiment']}/{s['nom']}  v{s['version']}")
    elif cmd == "poser" and len(args) == 2:
        v = appel("POST", "/secrets", {"compartiment": args[0], "nom": args[1],
                                       "valeur": saisie("Valeur : ")})["version"]
        print(f"{args[0]}/{args[1]} : version {v}")
    elif cmd == "lire" and len(args) == 2:
        sys.stdout.write(appel("GET", f"/secrets/{args[0]}/{args[1]}/valeur")["valeur"] + "\n")
    elif cmd == "retirer" and len(args) == 2:
        appel("DELETE", f"/secrets/{args[0]}/{args[1]}")
        print("retiré")
    elif cmd == "serrure-ajouter":
        phrase = saisie("Nouvelle phrase : ", confirmer=True)
        print("serrure", appel("POST", "/serrures/phrase",
                               {"phrase": phrase, "libelle": " ".join(args)})["id"])
    elif cmd == "serrure-retirer" and len(args) == 1:
        appel("DELETE", f"/serrures/{args[0]}")
        print("retirée")
    elif cmd == "codes":
        print("Nouveaux codes de secours (les anciens ne valent plus) :")
        for c in appel("POST", "/serrures/secours")["codes"]:
            print("   ", c)
    elif cmd == "journal":
        n = next((int(a) for a in args if a.isdigit()), 30)
        j = appel("GET", f"/journal?n={n}")
        for e in j["entrees"]:
            print(e["t"], e["evt"], json.dumps(e["details"], ensure_ascii=False))
        if "--verifier" in args or not j["integre"]:
            print("chaîne :", "intègre" if j["integre"] else f"ROMPUE à la ligne {j['ligne_fautive']}")
    elif cmd == "depot":
        depot(args)
    elif cmd == "niveau0":
        niveau0(args)
    else:
        sys.exit(f"coffrectl : commande inconnue ou incomplète « {' '.join(argv)} » — coffrectl aide")


if __name__ == "__main__":
    principal(sys.argv[1:])
