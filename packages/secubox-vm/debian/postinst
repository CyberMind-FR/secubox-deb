#!/bin/bash
set -e
case "$1" in
  configure)
    install -d -o root -g root -m 755 /var/lib/secubox/vm
    install -d -o root -g root -m 755 /var/lib/secubox/vm/iso
    install -d -o root -g root -m 755 /var/lib/secubox/vm/disks
    # #601 — validate the read+lifecycle lxc sudo grant; drop it if
    # malformed so a bad drop-in can never break sudo for the whole system.
    SUDOERS=/etc/sudoers.d/secubox-vm
    if [ -f "$SUDOERS" ]; then
        chmod 0440 "$SUDOERS" || true
        if command -v visudo >/dev/null 2>&1 && ! visudo -cf "$SUDOERS" >/dev/null 2>&1; then
            echo "secubox-vm: invalid sudoers drop-in, removing" >&2
            rm -f "$SUDOERS"
        fi
    fi
    # The aggregator mounts this module in-process; reload it so the new code
    # + LXC listing take effect (the per-module service is not the live path).
    systemctl try-reload-or-restart secubox-aggregator.service 2>/dev/null || true
    systemctl daemon-reload
    systemctl enable secubox-vm.service
    systemctl start secubox-vm.service || true
    systemctl reload nginx 2>/dev/null || true
    ;;
esac
# RÈGLES SUDO lxc-* (#1785) : une version locale ou ancienne de
# /etc/sudoers.d/secubox-vm est gardée par --force-confold et garde ses règles
# lxc-* à argument libre (`lxc-start -f` : crochets exécutés en root sur
# l'hôte). La version du paquet, validée par visudo, la remplace ; sauvegarde.
if [ "$1" = "configure" ]; then
    _f=/etc/sudoers.d/secubox-vm
    if [ -f "$_f" ] && grep -qE 'NOPASSWD: /usr/bin/lxc-' "$_f" \
       && [ -f "$_f.dpkg-dist" ] && visudo -cf "$_f.dpkg-dist" >/dev/null 2>&1; then
        install -d -m 0700 /var/backups/secubox/sudoers-avant-1785
        cp -p "$_f" /var/backups/secubox/sudoers-avant-1785/
        install -m 0440 "$_f.dpkg-dist" "$_f" && rm -f "$_f.dpkg-dist"
        echo "secubox-vm : règles sudo lxc-* retirées (sauvegarde /var/backups/secubox/sudoers-avant-1785)"
    fi
fi

#DEBHELPER#
