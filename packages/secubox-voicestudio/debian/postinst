#!/bin/sh
set -e
case "$1" in
  configure)
    id -u secubox >/dev/null 2>&1 || \
      adduser --system --group --no-create-home --home /var/lib/secubox --shell /usr/sbin/nologin secubox
    install -d -o secubox -g secubox -m 0750 /var/lib/secubox/voicestudio
    # SWAP DISQUE. Une synthèse vocale veut ≈ 4 Go de RAM ; le zram (RAM comprimée) ne suffit pas, et sans swap disque le
    # tueur de mémoire global abat le moteur (vu sur gk3 : swap plein à 3,9/3,9 Go). Idempotent : sans effet si un swap
    # disque existe déjà ; choisit /data puis /srv/secubox, jamais une carte eMMC/SD (secubox-system-tuning >= 1.2.5).
    if [ -x /usr/sbin/secubox-tuning-apply ]; then
      /usr/sbin/secubox-tuning-apply swap >/dev/null 2>&1 || true
    fi
    # Configuration : créée si absente ; ANCIEN schéma (podman) converti en gardant les adresses
    # publiées — gk2 joint le moteur de gk3 par l'une d'elles. Le TOML n'est pas un conffile.
    /usr/sbin/voicestudioctl migrer-conf || true
    /usr/sbin/voicestudioctl init >/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    # Mandataire et mode : drop-ins déduits du TOML (idempotent).
    /usr/sbin/voicestudioctl appliquer >/dev/null 2>&1 || true
    systemctl unmask secubox-voicestudio-api.service 2>/dev/null || true
    systemctl enable secubox-voicestudio-api.service 2>/dev/null || true
    systemctl restart secubox-voicestudio-api.service 2>/dev/null || true
    # Le mandataire n'est PAS démarré ici : tant que l'ancien moteur (podman, avant 0.2.0) tient le
    # port 3900, la prise échouerait. `voicestudioctl install` le démarre une fois le LXC prêt.
    systemctl enable secubox-voicestudio-pub.socket 2>/dev/null || true
    # Mise à jour d'une box DÉJÀ installée : le LXC existe et l'ancien moteur ne tient plus le port,
    # donc le mandataire (arrêté par dpkg pendant la mise à jour) est relancé ici. Sans cela, le port
    # 3900 resterait fermé jusqu'à un `voicestudioctl start` et les autres box perdraient le moteur.
    if [ -f /var/lib/secubox/voicestudio/.lxc-provisioned ] \
       && ! systemctl is-active --quiet secubox-voicestudio.service 2>/dev/null; then
      systemctl start secubox-voicestudio-pub.socket 2>/dev/null || true
    fi
    # « Installer le paquet » active l'appareil : le provisionnement du LXC (torch + ~200
    # dépendances, 10 à 25 min, réseau) tourne EN ARRIÈRE-PLAN pour ne pas bloquer dpkg. Gardé par
    # un marqueur : no-op après une installation réussie.
    systemctl enable secubox-voicestudio-provision.service 2>/dev/null || true
    systemctl start --no-block secubox-voicestudio-provision.service 2>/dev/null || true
    # INTERFACE NATIVE (le studio complet). Construite dans le LXC une fois qu'il existe ; son vhost est posé par
    # `voicestudioctl appliquer` quand elle l'est. Ici : l'unité de construction, puis l'exposition (HAProxy + WAF),
    # idempotentes et sans effet si l'infra manque (même motif que secubox-socialrelay).
    systemctl enable secubox-voicestudio-interface.service 2>/dev/null || true
    systemctl start --no-block secubox-voicestudio-interface.service 2>/dev/null || true
    systemctl enable secubox-voicestudio-rapide.service 2>/dev/null || true
    # Démarrage du LXC au boot en mode « permanent » (#2021) : activé ; lancé tout de suite seulement si le LXC existe.
    systemctl enable secubox-voicestudio-demarrage.service 2>/dev/null || true
    systemctl start --no-block secubox-voicestudio-demarrage.service 2>/dev/null || true
    systemctl start --no-block secubox-voicestudio-rapide.service 2>/dev/null || true
    DOMAINE="$(secubox-domaine voicestudio 2>/dev/null || true)"
    CLE_VHOST="$(printf '%s' "$DOMAINE" | tr '.' '_')"
    if [ -n "$DOMAINE" ] && command -v haproxyctl >/dev/null 2>&1 && [ -f /etc/secubox/haproxy.toml ]; then
      if ! grep -q "$CLE_VHOST" /etc/secubox/haproxy.toml 2>/dev/null; then
        haproxyctl vhost add "$DOMAINE" nginx_vhosts true >/dev/null 2>&1 || true
      fi
      haproxyctl generate >/dev/null 2>&1 || true
      systemctl reload haproxy >/dev/null 2>&1 || true
    fi
    WAF_ROUTES=/etc/secubox/waf/haproxy-routes.json
    if [ -n "$DOMAINE" ] && [ -f "$WAF_ROUTES" ] && command -v python3 >/dev/null 2>&1; then
      python3 - "$WAF_ROUTES" "$DOMAINE" <<'PY' || true
import json, sys
chemin, dom = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(chemin))
except (OSError, ValueError):
    d = {}
if d.get(dom) != ["127.0.0.1", 9080]:
    d[dom] = ["127.0.0.1", 9080]
    json.dump(d, open(chemin, "w"), indent=2)
PY
      # sbxwaf : redémarrage (jamais SIGHUP, qui le tue), seulement s'il tourne.
      if systemctl is-active --quiet secubox-waf-ng 2>/dev/null; then
        systemctl restart secubox-waf-ng >/dev/null 2>&1 || true
      fi
    fi
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
      systemctl reload nginx 2>/dev/null || true
    fi
    ;;
esac
#DEBHELPER#
exit 0
