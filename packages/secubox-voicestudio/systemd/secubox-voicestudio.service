[Unit]
Description=SecuBox VoiceStudio (moteur vocal studio du parc, podman)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/voicestudioctl init
ExecStartPre=/usr/sbin/voicestudioctl parefeu-ouvre
ExecStart=/usr/sbin/voicestudioctl lance
ExecStop=/usr/bin/podman stop -t 20 secubox-voicestudio
ExecStopPost=/usr/sbin/voicestudioctl parefeu-ferme
Restart=on-failure
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
