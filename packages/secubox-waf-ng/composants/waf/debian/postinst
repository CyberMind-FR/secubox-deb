#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma
set -e

if [ "$1" = "configure" ]; then
    # LA MIGRATION /srv -> /data DU MOTEUR MITMPROXY EST RETIREE (#1362).
    # Elle deplacait /srv/mitmproxy{,-waf,-in}, repertoires d'un moteur
    # decommissionne et deja effaces. Elle ne pouvait plus rien trouver, et
    # laissait croire que ce moteur fait encore partie du produit.


    # Create log directory
    mkdir -p /var/log/secubox/waf
    # LE PROPRIETAIRE EST CELUI QUI ECRIT (ref #1039). Cette ligne posait
    # `secubox:secubox` alors que `sbxwaf` tourne sous `secubox-waf` : le
    # repertoire etant en 0750, le demon se retrouvait VERROUILLE DEHORS de son
    # propre journal (« sbxwaf/threatlog: open ...: permission denied »), et
    # chaque reinstallation du paquet reintroduisait la panne.
    #
    # Groupe `secubox` : c'est sous ce compte que l'agregateur sert le panneau
    # du WAF et lit ce journal. Le setgid (2750) fait heriter ce groupe aux
    # fichiers crees, sans quoi le demon les creerait dans SON groupe et le
    # lecteur perdrait l'acces au fichier suivant.
    chown secubox-waf:secubox /var/log/secubox/waf 2>/dev/null || true
    chmod 2750 /var/log/secubox/waf 2>/dev/null || true

    # Enable the WAF API service
    systemctl daemon-reload
    systemctl enable secubox-waf.service || true
    systemctl start secubox-waf.service || true

    # Reminder about LXC container
    echo "=============================================="
    echo "SecuBox WAF installed."
    echo ""
    echo "To install the WAF container, run:"
    echo "  wafctl install"
    echo ""
    echo "To start the WAF after container install:"
    echo "  wafctl start"
    echo ""
    echo "To add routes for HAProxy backends:"
    echo "  wafctl add-route <domain> <ip> <port>"
    echo "=============================================="
fi

# ── #1227 : vhost dedie du tableau de bord WAF ────────────────────────────
#
# Trois gestes, dans cet ordre, et l'ordre compte : semer le filtre
# d'exposition AVANT d'activer le site. Activer d'abord exposerait la page —
# et les points d'entree sans jeton qu'elle consomme — pendant l'intervalle.
VHOST="waf"
SNIP="/etc/nginx/snippets/exposure/${VHOST}.conf"
SITE="/etc/nginx/sites-available/${VHOST}.conf"

# MIGRATION #3117 : les vhosts étaient livrés sous le nom de gk2. Idempotent.
#   $1 ancien nom de fichier (sans chemin)  $2 nouveau nom  $3 ancien filtre
#   d'exposition (nom de fichier)           $4 nouveau filtre
# Le lien d'activation ancien part ; l'ancien fichier part s'il est celui que
# le paquet avait livré (somme dpkg), sinon il est archivé dans /var/backups/nginx (0600), le fichier livré fait foi,
# avec un avertissement. Retourne 0 si l'ancien
# vhost était activé.
sbx_migrer_vhost() {
    _o="$1"; _n="$2"; _os="$3"; _ns="$4"; _act=1
    _av=/etc/nginx/sites-available; _en=/etc/nginx/sites-enabled
    _sn=/etc/nginx/snippets/exposure
    if [ -e "$_en/$_o" ] || [ -L "$_en/$_o" ]; then
        rm -f "$_en/$_o"; _act=0
    fi
    if [ -f "$_av/$_o" ]; then
        _livre=$(dpkg-query -W -f='${Conffiles}\n' secubox-waf-ng 2>/dev/null \
                 | awk -v f="$_av/$_o" '$1 == f { print $2 }')
        _actuel=$(md5sum "$_av/$_o" | cut -d' ' -f1)
        if [ "$_livre" != "$_actuel" ]; then
            # Retouché par l'administrateur (ou origine inconnue) : ses lignes
            # sont ARCHIVÉES, jamais recopiées sur le fichier livré — elles
            # citeraient l'ancien nom du filtre d'exposition et nginx -t
            # échouerait. Le fichier livré fait foi.
            _arch="/var/backups/nginx/$_o.$(date +%Y%m%d-%H%M%S)"
            mkdir -p /var/backups/nginx
            if cp -p "$_av/$_o" "$_arch" && chmod 0600 "$_arch"; then
                echo "secubox-waf-ng : l'ancien vhost $_o avait été modifié ; archivé dans $_arch, le fichier livré $_n est utilisé. Reportez-y vos retouches si besoin." >&2
            fi
        fi
        rm -f "$_av/$_o"
    fi
    # Le filtre d'exposition de l'opérateur suit le vhost.
    if [ -n "$_os" ] && [ -f "$_sn/$_os" ]; then
        if [ ! -f "$_sn/$_ns" ]; then mv -f "$_sn/$_os" "$_sn/$_ns"; else rm -f "$_sn/$_os"; fi
    fi
    return $_act
}
MIGRE=0
if [ "$1" = "configure" ]; then
    sbx_migrer_vhost waf.gk2.secubox.in.conf waf.conf waf.gk2.secubox.in.conf waf.conf && MIGRE=1 || true
fi

if [ -f "$SITE" ]; then
    # 1. Le filtre, a « lan » — jamais ecrase s'il existe deja : l'operateur a
    #    pu l'ouvrir volontairement, et le reinstaller le refermerait dans son
    #    dos.
    if [ ! -f "$SNIP" ]; then
        mkdir -p "$(dirname "$SNIP")"
        cat > "$SNIP" <<'EXPO'
# Filtre d'exposition — semé à « lan » par secubox-waf (#1227).
# Édité par le module secubox-exposure, qui fait autorité une fois le fichier
# créé. Ce tableau de bord livre les adresses des attaquants, la liste des
# bannis et l'état de chaque protection : ouvert au monde, c'est une carte du
# dispositif offerte à qui l'attaque.
allow 127.0.0.1;
allow 10.0.0.0/8;
allow 172.16.0.0/12;
allow 192.168.0.0/16;
deny all;
EXPO
    fi

    # 2. L'activation.
    ln -sf "$SITE" "/etc/nginx/sites-enabled/${VHOST}.conf"

    # 3. Le rechargement, SEULEMENT si la configuration passe le test : une
    #    conf fautive couperait tous les autres vhosts de la box.
    if NT=$(nginx -t 2>&1); then
        systemctl reload nginx >/dev/null 2>&1 || true
    elif [ "$MIGRE" = 1 ]; then
        # Lien migré à l'instant (#3117) : on ne le retire pas, le prochain
        # rechargement réussi le prendra.
        echo "secubox-waf: nginx -t a echoue, vhost ${VHOST} laisse active (migration) : ${NT}" >&2
    else
        echo "secubox-waf: nginx -t a echoue — vhost ${VHOST} depose mais non active" >&2
        rm -f "/etc/nginx/sites-enabled/${VHOST}.conf"
    fi
    # RÈGLES DU WAF : LES LIVRÉES PASSENT, LES GÉNÉRÉES RESTENT (#1858). Le
    # fichier lu par sbxwaf n'est pas un conffile : sans ceci, chaque correction
    # de règle exigeait une édition à la main sur chaque box. L'outil sauvegarde
    # (`.avant-<version>`), ne touche pas aux catégories tenues par wafgen, et ne
    # redémarre le moteur que si le fichier a vraiment changé.
    if [ -x /usr/sbin/waf-rules-sync ]; then
        rc=0
        /usr/sbin/waf-rules-sync --version "${2:-nouveau}" || rc=$?
        if [ "$rc" = "10" ] && systemctl is-active --quiet secubox-waf-ng 2>/dev/null; then
            systemctl restart secubox-waf-ng || true
        fi
    fi
    # ROUTE SBXWAF — POSEE PAR CE PAQUET (#1323), comme son vhost et son unite.
    # Sans elle, sbxwaf recoit un nom qu'il ne connait pas et rend 421, meme si
    # HAProxy dirige bien et que nginx sert bien. Cette table n'appartenait a
    # aucun paquet : 275 routes posees a la main, invisibles tant qu'elles
    # tiennent, fatales le jour ou l'une saute (vu sur podcaster).
    # L'outil vient de secubox-core, dont ce paquet depend deja ; le garde
    # `command -v` couvre l'ordre de configuration a la premiere installation.
    if command -v secubox-waf-route >/dev/null 2>&1; then
      secubox-waf-route "$(secubox-domaine waf)" 9080 || true
    fi

fi

exit 0
