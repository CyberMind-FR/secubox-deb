[Unit]
Description=SecuBox Waf API
After=network.target secubox-core.service
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/waf
# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on
# possede. Une socket laissee par un autre utilisateur rendrait le
# demarrage impossible, en boucle et en silence. Le prefixe `+` execute en
# root malgre User= — sans lui la ligne echouerait comme le demon.
ExecStartPre=+/bin/rm -f /run/secubox/waf.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/waf.sock --log-level warning
Restart=on-failure
RestartSec=5
# UMask=0002 (#1416) : jamais d'écriture « autres » ; les lectures restent.
UMask=0002
# NoNewPrivileges=false (#3716) : l'API passe par `sudo -n` (droits exacts de /etc/sudoers.d/secubox-waf) pour
# lire l'ensemble nft waf_ban, le bouton Ban et les gestes /ai/* (wafctl ban/unban, ban-bloc via systemd-run, blocs).
# NoNewPrivileges=true désarme sudo (bit setuid ignoré) : gk2 ne tenait que par un drop-in posé à la main
# (allow-sudo.conf). Même choix que secubox-aggregator (#498) : les sudoers bornés sont la vraie défense.
NoNewPrivileges=false
# RuntimeDirectory=secubox RETIRE (#1022) : /run/secubox est partage par ~95
# unites, et systemd EFFACE le contenu d'un RuntimeDirectory au redemarrage —
# une seule unite qui le declare emporte les sockets de toutes les autres, et
# la board rend des 502 sur des modules qui n'avaient rien demande. Le parent
# reste root:root 1777, cree hors des unites.
RuntimeDirectoryMode=0775

ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox /var/log/secubox

[Install]
WantedBy=multi-user.target
