# #3795 : crée la clé locale du HMAC des mots de passe tentés sur les leurres (32 octets aléatoires, 0600) SI ELLE
# MANQUE ; ne la tourne jamais. Sortie 0 si la clé existe (déjà là ou créée), 1 sinon (message sur stderr).
# SECUBOX_LEURRES_CLE : chemin de la clé (tests seulement ; défaut /etc/secubox/secrets/leurres-hmac.key).
set -u
CLE="${SECUBOX_LEURRES_CLE:-/etc/secubox/secrets/leurres-hmac.key}"
[ -s "$CLE" ] && exit 0
TMP="$CLE.tmp.$$"
umask 077
if head -c 32 /dev/urandom > "$TMP" && [ "$(wc -c < "$TMP")" -eq 32 ] && chmod 0600 "$TMP" && mv -f "$TMP" "$CLE"; then
    exit 0
fi
rm -f "$TMP"
echo "secubox-waf-leurres-cle: ERREUR, clé $CLE non créée : secubox-waf.service ne démarrera pas (LoadCredential)" >&2
exit 1
