"""
SecuBox-Deb :: waf-profils-fusion — ajoute à la copie de la box les services et
vhosts LIVRÉS qui lui manquent (#3193).

/etc/secubox/waf/vhost_profiles.json est un conffile que la box MODIFIE à
l'exécution (cases anti-robots du panneau Vhost via `wafctl anti-robots`, vhosts
ajoutés par l'opérateur). dpkg le voit donc « modifié localement » et, avec
--force-confold, n'installe jamais la nouvelle version : un service livré (le
`livekit` de la Visio, #3193) n'atteignait jamais la box.

Règle : on AJOUTE les services et les vhosts de la copie livrée
(/usr/share/secubox/waf/vhost_profiles.json) ABSENTS de la box. On ne remplace
jamais une clé existante, on ne touche ni à `suppress_categories`, ni à
`anti_robots`, ni aux commentaires. Un vhost livré déjà présent sous une autre
casse (sbxwaf normalise) n'est pas ajouté ; un vhost livré dont le service
n'existe pas n'est pas ajouté (sbxwaf refuserait tout le fichier).

Écriture : fichier temporaire dans le même dossier, mêmes propriétaire et mode,
fsync, puis rename atomique ; tout passe par le descripteur du dossier, ouvert
sans suivre de lien symbolique — une cible ou un dossier lien symbolique est
refusé. Une ligne au journal d'audit quand quelque chose est ajouté ; rien du
tout (ni écriture, ni audit) quand rien ne manque.

sbxwaf ne lit ce fichier qu'au démarrage : c'est à l'appelant (postinst) de le
faire relire, le code de sortie le lui dit.

Usage : waf-profils-fusion [--dry-run] [--livre F] [--vivant F] [--audit F]
Codes : 0 rien à faire, 10 fichier modifié (le moteur doit relire),
        1 refus ou erreur (fichier laissé intact).
"""
import argparse
import copy
import errno
import json
import os
import secrets
import stat
import sys
from datetime import datetime, timezone
from pathlib import Path

LIVRE = Path("/usr/share/secubox/waf/vhost_profiles.json")
VIVANT = Path("/etc/secubox/waf/vhost_profiles.json")
AUDIT = Path("/var/log/secubox/audit.log")

TAILLE_MAX = 4 * 1024 * 1024    # un profil fait quelques Ko ; au-delà, on refuse
MODIFIE = 10


class Refus(Exception):
    """La fusion ne peut pas se faire sans risque : rien n'est écrit."""


def normaliser_hote(hote: str) -> str:
    """Même normalisation que sbxwaf (normaliserHote) : minuscules, sans port."""
    hote = hote.strip().lower()
    i = hote.rfind(":")
    return hote[:i] if i >= 0 else hote


def _objet(doc: dict, cle: str, origine: str) -> dict:
    val = doc.get(cle, {})
    if not isinstance(val, dict):
        raise Refus(f"{origine} : « {cle} » n'est pas un objet JSON")
    return val


def fusionne(livre: dict, vivant: dict) -> tuple[dict, list[str], list[str]]:
    """Copie de la box + services et vhosts livrés absents. Rien d'existant ne change.

    Rend (nouvelle copie, services ajoutés, vhosts ajoutés)."""
    if not isinstance(livre, dict):
        raise Refus("copie livrée : pas un objet JSON")
    if not isinstance(vivant, dict):
        raise Refus("copie de la box : pas un objet JSON")
    services_l = _objet(livre, "services", "copie livrée")
    vhosts_l = _objet(livre, "vhosts", "copie livrée")
    _objet(vivant, "services", "copie de la box")
    _objet(vivant, "vhosts", "copie de la box")

    neuf = copy.deepcopy(vivant)
    services = neuf.setdefault("services", {})
    vhosts = neuf.setdefault("vhosts", {})

    services_ajoutes = []
    for nom, profil in services_l.items():
        if nom not in services:
            services[nom] = copy.deepcopy(profil)
            services_ajoutes.append(nom)

    connus = {normaliser_hote(h) for h in vhosts if isinstance(h, str)}
    vhosts_ajoutes = []
    for hote, service in vhosts_l.items():
        if not isinstance(hote, str) or not isinstance(service, str):
            continue
        if normaliser_hote(hote) in connus:
            continue                     # présent (peut-être autrement écrit) : intouché
        if service not in services:
            print(f"waf-profils-fusion: vhost livré {hote} ignoré, service {service} introuvable",
                  file=sys.stderr)
            continue
        vhosts[hote] = service
        connus.add(normaliser_hote(hote))
        vhosts_ajoutes.append(hote)
    return neuf, services_ajoutes, vhosts_ajoutes


def _lire_livre(chemin: Path):
    try:
        brut = chemin.read_bytes()
    except FileNotFoundError:
        return None
    if len(brut) > TAILLE_MAX:
        raise Refus(f"{chemin} : trop volumineux")
    try:
        return json.loads(brut.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as exc:
        raise Refus(f"{chemin} : JSON illisible ({exc})") from exc


def _ouvrir_dossier(dossier: Path) -> int:
    try:
        return os.open(dossier, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.ENOTDIR):
            raise Refus(f"{dossier} : lien symbolique ou pas un dossier — refusé") from exc
        raise


def _lire_vivant(dfd: int, nom: str):
    """Rend (document, octets, stat) ou None si absent. Jamais à travers un lien."""
    try:
        fd = os.open(nom, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
    except FileNotFoundError:
        return None
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise Refus(f"{nom} : lien symbolique — refusé") from exc
        raise
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Refus(f"{nom} : pas un fichier ordinaire — refusé")
        if st.st_size > TAILLE_MAX:
            raise Refus(f"{nom} : trop volumineux")
        with os.fdopen(fd, "rb", closefd=False) as f:
            brut = f.read(TAILLE_MAX + 1)
    finally:
        os.close(fd)
    try:
        return json.loads(brut.decode("utf-8")), brut, st
    except (UnicodeDecodeError, ValueError) as exc:
        raise Refus(f"{nom} : JSON illisible ({exc}) — laissé intact") from exc


def _ecrire_atomique(dfd: int, nom: str, texte: str, st: os.stat_result) -> None:
    """Temporaire dans le même dossier, mêmes propriétaire et mode, puis rename."""
    tmp = f".{nom}.fusion-{secrets.token_hex(6)}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                 0o600, dir_fd=dfd)
    try:
        try:
            os.fchown(fd, st.st_uid, st.st_gid)
            os.fchmod(fd, stat.S_IMODE(st.st_mode))
            donnees = texte.encode("utf-8")
            while donnees:
                donnees = donnees[os.write(fd, donnees):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, nom, src_dir_fd=dfd, dst_dir_fd=dfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dfd)
        except FileNotFoundError:
            pass
        raise
    os.fsync(dfd)


def _auditer(chemin: Path, detail: str) -> None:
    """Une ligne JSON append-only. Un journal inaccessible n'annule pas la
    fusion déjà faite : on le dit."""
    ligne = json.dumps({
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "module": "waf",
        "action": "profils-fusion",
        "acteur": "root",
        "detail": detail,
    }, ensure_ascii=False) + "\n"
    try:
        fd = os.open(chemin, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o640)
        try:
            os.write(fd, ligne.encode("utf-8"))
        finally:
            os.close(fd)
    except OSError as exc:
        print(f"waf-profils-fusion: journal d'audit inaccessible ({chemin}) : {exc}", file=sys.stderr)


def executer(livre_p: Path, vivant_p: Path, audit_p: Path, essai: bool) -> int:
    livre = _lire_livre(livre_p)
    if livre is None:
        print(f"waf-profils-fusion: {livre_p} absent — rien à faire")
        return 0
    dfd = _ouvrir_dossier(vivant_p.parent)
    try:
        lu = _lire_vivant(dfd, vivant_p.name)
        if lu is None:
            # Le conffile est posé par dpkg : sans lui, il n'y a rien à compléter.
            print(f"waf-profils-fusion: {vivant_p} absent — rien à faire")
            return 0
        vivant, _, st = lu
        neuf, services, vhosts = fusionne(livre, vivant)
        if not services and not vhosts:
            print("waf-profils-fusion: profils à jour")
            return 0
        detail = (f"services ajoutés : {', '.join(services) or 'aucun'} ; "
                  f"vhosts ajoutés : {', '.join(vhosts) or 'aucun'} "
                  f"(depuis {livre_p}, dans {vivant_p})")
        print(f"waf-profils-fusion: {detail}")
        if essai:
            return MODIFIE
        texte = json.dumps(neuf, ensure_ascii=False, indent=2) + "\n"
        json.loads(texte)                                   # jamais d'écriture invalide
        _ecrire_atomique(dfd, vivant_p.name, texte, st)
    finally:
        os.close(dfd)
    _auditer(audit_p, detail)
    return MODIFIE


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--dry-run", action="store_true", help="dire ce qui manque, sans rien écrire")
    ap.add_argument("--livre", type=Path, default=LIVRE)
    ap.add_argument("--vivant", type=Path, default=VIVANT)
    ap.add_argument("--audit", type=Path, default=AUDIT)
    a = ap.parse_args()
    try:
        return executer(a.livre, a.vivant, a.audit, a.dry_run)
    except Refus as exc:
        print(f"waf-profils-fusion: REFUS — {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"waf-profils-fusion: ÉCHEC — {exc} ; fichier laissé intact", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
