#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: secubox-waf-ng — postinst (#744)
set -e

case "$1" in
  configure)

    # ── 1. Dedicated unprivileged user + group (CSPN privilege separation) ──
    if ! getent passwd secubox-waf >/dev/null 2>&1; then
      adduser --system --group --no-create-home \
              --home /nonexistent --shell /usr/sbin/nologin \
              --gecos "SecuBox WAF-NG" secubox-waf
    fi

    # #1070 D : le module `secubox` (API WAF, metrics, agrégateur) LIT les données
    # que le WAF écrit en 0640 secubox-waf (journal des menaces, visits-stats).
    # Sans appartenance au groupe, /visits, /history et /bans/history renvoyaient
    # vide ou 500 — les onglets Visites/Historique/Attaquants restaient muets.
    # On ajoute `secubox` au groupe secubox-waf (lecture par le groupe).
    if getent passwd secubox >/dev/null 2>&1 \
       && ! id -nG secubox 2>/dev/null | tr ' ' '\n' | grep -qx secubox-waf; then
      usermod -aG secubox-waf secubox || true
      # le module tourne déjà : il faut le relancer pour prendre le nouveau groupe.
      systemctl try-restart secubox-metrics.service 2>/dev/null || true
    fi

    # ── 2. Config directories ─────────────────────────────────────────────────
    # IMPORTANT: NEVER chmod the SHARED PARENTS /etc/secubox to 0750 — that
    # breaks traversal for every other secubox-* daemon (#474/#620 lessons).
    # Create leaf dirs under /etc/secubox/waf/ without re-moding the parent.
    # The parent /etc/secubox MUST stay 0755 (traversable by all service users).

    # Ensure shared parent exists and is traversable (idempotent, safe to repeat).
    [ -d /etc/secubox ] && chmod 0755 /etc/secubox 2>/dev/null || true
    mkdir -p /etc/secubox/waf
    chown root:secubox-waf /etc/secubox/waf
    chmod 0750 /etc/secubox/waf

    mkdir -p /etc/secubox/waf/ca
    chown root:secubox-waf /etc/secubox/waf/ca
    chmod 0750 /etc/secubox/waf/ca

    # Secrets dir: the secubox-waf JWT file lives here. Parent 0750 is correct
    # (root:secubox-toolbox owns the parent on the board, so we only ensure
    # our JWT file will be readable by secubox-waf when created by the operator).
    # Do NOT re-mode /etc/secubox/secrets to 0750 — the parent /etc/secubox
    # must stay 0755 (traversal constraint above). Just ensure the dir exists.
    mkdir -p /etc/secubox/secrets
    # The JWT file itself (/etc/secubox/secrets/waf-crowdsec.jwt) is operator-
    # created; its perms are set when the operator generates it. We do NOT
    # touch it here.

    # ── 3. Log directories ────────────────────────────────────────────────────
    # /var/log/secubox is a SHARED parent traversed by many service users
    # (aggregator, WAF, SOC dashboards). It MUST be 0755 — a 0750 owned by
    # any single user silently breaks all others (#511, board-wide regression
    # 2026-06-10). Per-module subdirs keep their own restricted perms.

    # Ensure shared log parent exists and stays traversable.
    mkdir -p /var/log/secubox
    chmod 0755 /var/log/secubox 2>/dev/null || true

    # WAF threat log leaf dir (restricted to secubox-waf, not the shared parent).
    # Default threat log path: /var/log/secubox/waf/waf-threats.log (M1 fix).
    mkdir -p /var/log/secubox/waf
    chown secubox-waf:secubox-waf /var/log/secubox/waf
    chmod 0750 /var/log/secubox/waf

    # Cookie-audit JSONL ledger (leaf dir — restricted to secubox-waf).
    mkdir -p /var/log/secubox/cookie-audit
    chown secubox-waf:secubox-waf /var/log/secubox/cookie-audit
    chmod 0750 /var/log/secubox/cookie-audit
    # The ledger FILE must be writable by the non-root sbxwaf that appends to it.
    # A pre-existing file owned by another user (e.g. secubox from an old addon)
    # makes sbxwaf panic on open → crash-loop (#896 reconcile). Chown if present.
    if [ -e /var/log/secubox/cookie-audit/server.jsonl ]; then
      chown secubox-waf:secubox-waf /var/log/secubox/cookie-audit/server.jsonl || true
    fi

    # haproxy-routes.json must be READABLE by the non-root sbxwaf (#896 reconcile):
    # root-only 0600 makes it load 0 routes → 421 everything. Routes are
    # [host,port] pairs, not secret → 0644 (the norm; the profiles actuator
    # preserves this mode on its atomic writes).
    if [ -e /etc/secubox/waf/haproxy-routes.json ]; then
      chmod 0644 /etc/secubox/waf/haproxy-routes.json || true
    fi

    # ── 4. Cache directories ──────────────────────────────────────────────────
    # Same shared-parent pattern: /var/cache/secubox must stay 0755.
    mkdir -p /var/cache/secubox
    chmod 0755 /var/cache/secubox 2>/dev/null || true

    mkdir -p /var/cache/secubox/waf
    chown secubox-waf:secubox-waf /var/cache/secubox/waf
    chmod 0750 /var/cache/secubox/waf

    mkdir -p /var/cache/secubox/waf/media
    chown secubox-waf:secubox-waf /var/cache/secubox/waf/media
    chmod 0750 /var/cache/secubox/waf/media

    # ── 5. AppArmor profile ───────────────────────────────────────────────────
    # Load and enforce the profile if AppArmor is present and active.
    if command -v aa-enforce >/dev/null 2>&1 && \
       [ -f /etc/apparmor.d/usr.sbin.sbxwaf ] && \
       [ -d /sys/kernel/security/apparmor ]; then
      aa-enforce /etc/apparmor.d/usr.sbin.sbxwaf 2>/dev/null || true
    fi

    # ── 6. Systemd: single hardened unit (#896 reconcile) ────────────────────
    # The crash-looping worker@ fan-out is retired. Retire any leftover worker@
    # instances, drop the hand-created /etc override that shadowed the packaged
    # unit, then enable + (re)start the single hardened secubox-waf-ng.service.
    if [ -d /run/systemd/system ]; then
      # Disable + stop any surviving worker@ instances (they re-chowned the
      # shared /run/secubox and broke sibling sockets — see the unit header).
      for unit in secubox-waf-ng-worker@1.service secubox-waf-ng-worker@2.service; do
        systemctl disable --now "$unit" 2>/dev/null || true
      done

      # A previous cutover left a hand-created override at
      # /etc/systemd/system/secubox-waf-ng.service that shadows this packaged
      # /lib unit. Remove it so the packaged (hardened) unit takes effect. Only
      # a plain file (not a symlink an operator may have set deliberately).
      if [ -f /etc/systemd/system/secubox-waf-ng.service ] && \
         [ ! -L /etc/systemd/system/secubox-waf-ng.service ]; then
        rm -f /etc/systemd/system/secubox-waf-ng.service
      fi

      systemctl daemon-reload || true
      systemctl enable secubox-waf-ng.service 2>/dev/null || true
      # Fresh install starts it; upgrade restarts it (dpkg SIGTERMs the unit
      # before this postinst runs, so `restart` — not `try-restart` — is needed
      # to bring it back). HAProxy srv0 → 127.0.0.1:8085 keeps pointing at it.
      systemctl restart secubox-waf-ng.service 2>/dev/null || true
      # #1070 D : activer le timer de corrélation des campagnes + une première
      # passe immédiate pour que le tableau de bord ait des données tout de suite.
      systemctl enable --now secubox-waf-campaigns.timer 2>/dev/null || true
      systemctl start secubox-waf-campaigns.service 2>/dev/null || true
    fi

    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

#DEBHELPER#

exit 0
