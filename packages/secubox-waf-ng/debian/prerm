#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# SecuBox-Deb :: secubox-waf-ng — prerm (#744)
set -e

case "$1" in
  remove|upgrade|deconfigure)
    if [ -d /run/systemd/system ]; then
      for unit in secubox-waf-ng-worker@1.service \
                  secubox-waf-ng-worker@2.service; do
        systemctl stop "$unit" 2>/dev/null || true
        systemctl disable "$unit" 2>/dev/null || true
      done
    fi
    ;;

  failed-upgrade)
    ;;
esac

#DEBHELPER#
# Composants absorbés (#2050) : leurs scripts de maintenance, mêmes arguments.
for _s in /usr/lib/secubox/waf-ng/maintscripts/*.prerm; do
  [ -f "$_s" ] && { sh "$_s" "$@" || echo "waf-ng : prerm de $(basename "$_s") en échec" >&2; }
done
exit 0
