# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# AppArmor enforce profile for /usr/sbin/sbxwaf (secubox-waf-ng, #744)
#
# Installed by dpkg to /etc/apparmor.d/usr.sbin.sbxwaf and loaded in enforce
# mode by the postinst (aa-enforce /etc/apparmor.d/usr.sbin.sbxwaf).
#
# Surface minimisation:
#   - r    : /var/log/secubox/            (traverse shared parent only — L1 fix)
#   - rw   : /var/log/secubox/waf/**      (threat log)
#   - rw   : /var/log/secubox/cookie-audit/** (cookie-audit JSONL)
#   - rw   : /var/cache/secubox/waf/**    (media response cache)
#   - rw   : /run/secubox/**              (Unix sockets, PID files)
#   - r    : /etc/secubox/waf/**          (routes, rules, CA cert)
#   - r    : /etc/secubox/secrets/**      (JWT / secret files — read-only)
#   - r    : /usr/sbin/sbxwaf             (binary)
#   - r    : /proc/self/maps, /proc/self/status, /sys/kernel/mm/transparent*
#             (Go runtime internals; read-only, kernel-granted)
#   - ix   : /usr/sbin/nft (ban natif --nft-ban, #1693)
#   - rw   : /var/lib/secubox/waf/**      (journal des bans)
#   - r    : /usr/share/GeoIP/**          (pays d'origine)
#   - network inet, inet6 : upstream TCP connections + listener
#   - network netlink raw + capability net_admin : nft (#1693)
#
# Everything else is denied by the default-deny profile.

#include <tunables/global>

/usr/sbin/sbxwaf {
  #include <abstractions/base>

  # Binary
  /usr/sbin/sbxwaf r,

  # ── Config (read-only) ────────────────────────────────────────────────────
  /etc/secubox/waf/           r,
  /etc/secubox/waf/**         r,
  # Secrets dir: the JWT file is read once at startup.
  # /etc/secubox/ traversal is public (0755), only the leaf is restricted.
  /etc/secubox/secrets/       r,
  /etc/secubox/secrets/**     r,

  # ── Log output (read/write, append) ──────────────────────────────────────
  # L1 fix: shared parent needs only traverse (r), not write.
  # WAF-owned leaf dirs get rw so the binary can create + append log files.
  /var/log/secubox/                    r,
  /var/log/secubox/waf/                rw,
  /var/log/secubox/waf/**              rw,
  /var/log/secubox/cookie-audit/       rw,
  /var/log/secubox/cookie-audit/**     rw,

  # ── Media cache (read/write) ──────────────────────────────────────────────
  /var/cache/secubox/         r,
  /var/cache/secubox/waf/     rw,
  /var/cache/secubox/waf/**   rw,

  # ── Runtime (Unix sockets, PID files) ────────────────────────────────────
  # #896: the blanket /run/secubox/** rw below already covers egress to
  # /run/secubox/waker.sock (the on-demand scale-to-zero waker) — no separate
  # rule was needed; verified against the shipped profile before this feature
  # was added.
  /run/secubox/               rw,
  /run/secubox/**             rw,

  # ── Networking ───────────────────────────────────────────────────────────
  network inet  stream,
  network inet6 stream,
  network unix  stream,
  # Vérification DNS des robots d'indexation (FCrDNS, crawlers.go, #2240) : le résolveur parle en UDP et lit les fichiers du système. Sans ces règles
  # elle échouait en silence — aucun robot n'était reconnu, Googlebot restait banni.
  network inet  dgram,
  network inet6 dgram,
  /etc/resolv.conf           r,
  /etc/nsswitch.conf         r,
  /etc/hosts                 r,
  /etc/host.conf             r,

  # ── Ban nft natif (#1070 B, #1218, #1693) ────────────────────────────────
  # --nft-ban exécute `nft` pour poser et réparer la table inet secubox. Ajouté
  # sans ce profil : sur une box où AppArmor est actif (gk3), nft était refusé
  # (« fork/exec /usr/sbin/nft: permission denied ») et AUCUN ban natif n'était
  # posé ; gk2, sans AppArmor, ne le voyait pas. nft hérite de ce profil (ix) :
  # netlink brut + CAP_NET_ADMIN (déjà bornée par l'unité), et les deux tables
  # de noms d'iproute2 qu'il lit. Relevé en mode complain, pas deviné.
  /usr/sbin/nft              ix,
  capability net_admin,
  network netlink raw,
  /etc/iproute2/             r,
  /etc/iproute2/*            r,
  /usr/share/iproute2/       r,
  /usr/share/iproute2/*      r,
  # Journal des bans (persistance + ré-application après un rechargement du
  # pare-feu) : --ban-store /var/lib/secubox/waf/bans.jsonl.
  /var/lib/secubox/          r,
  /var/lib/secubox/waf/      rw,
  /var/lib/secubox/waf/**    rw,

  # ── Géolocalisation (pays d'origine des menaces) ────────────────────────
  /usr/share/GeoIP/          r,
  /usr/share/GeoIP/**        r,

  # ── Go runtime ───────────────────────────────────────────────────────────
  /proc/self/maps            r,
  /proc/self/status          r,
  /proc/self/smaps           r,
  /proc/sys/kernel/ngroups_max r,
  /proc/sys/net/core/somaxconn r,
  /sys/kernel/mm/transparent_hugepage/enabled r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,

  # Deny everything else (default-deny profile — no explicit deny rules
  # needed; any path not listed above is implicitly denied by AppArmor).
}
