#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
#
# Replace la socket d'ingestion d'Actor Intelligence dans le groupe dédié
# `actord-ingest`, afin que sbxwaf (qui tourne en `secubox-waf`) puisse y écrire.
#
# POURQUOI UN FICHIER PLUTÔT QU'UN ExecStart EN LIGNE. Cette correction a échoué
# DEUX FOIS en restant invisible, à cause de l'analyseur de systemd :
#   · avec un seul `$`, systemd développait `$S` et `$i` en chaîne VIDE ;
#   · avec `$$`, il les passait littéralement et le shell lisait `$$` = son PID.
# Dans les deux cas l'unité sortait en 0 : un échec silencieux et vert, le pire
# qui soit. Un script dans un fichier n'a aucun de ces pièges.
#
# POURQUOI UNE BOUCLE ET PAS UN SEUL chgrp. Au redémarrage d'actord, l'ANCIENNE
# socket existe encore quand cette unité démarre : on changerait le groupe d'un
# inode que le démon s'apprête à remplacer. On insiste donc jusqu'à ce que le
# groupe TIENNE deux vérifications consécutives.
set -u
SOCKET="${1:-/run/secubox/actord.sock}"
GROUPE="${2:-actord-ingest}"

# LA SOCKET QU'ON CORRIGE N'EST PAS FORCEMENT LA BONNE, ET ELLE PEUT ARRIVER TRÈS TARD. actord reconstruit son graphe avant d'ouvrir la
# nouvelle socket : quelques secondes d'ordinaire, ~4 MINUTES quand la base est grosse (incident 2026-10-05 : fenêtre fixe de 12 s dépassée,
# socket restée au groupe `secubox`, ingestion muette près de deux jours). Un fichier de socket n'est pas une socket en écoute : l'ancienne
# socket d'un run précédent existe encore sans personne derrière.
#
# On ATTEND donc, jusqu'à ATTENTE secondes, qu'un processus écoute vraiment sur ce chemin (`ss -xl`), puis on applique pendant une courte
# fenêtre de stabilisation. Le coût est nul : l'unité est un oneshot qui ne retient personne.
ATTENTE=900         # 900 s : bien au-delà d'une reconstruction lente
STABILISATION=12    # 12 x 0,5 s une fois la socket en écoute
pose=0
i=0
while [ "$i" -lt $((ATTENTE * 2)) ]; do
    if [ -S "$SOCKET" ] && ss -xlH 2>/dev/null | grep -qF -- "$SOCKET"; then
        break
    fi
    i=$((i + 1))
    sleep 0.5
done
j=0
while [ "$j" -lt "$STABILISATION" ]; do
    if [ -S "$SOCKET" ]; then
        chgrp "$GROUPE" "$SOCKET" 2>/dev/null
        chmod 0660 "$SOCKET" 2>/dev/null
        [ "$(stat -c %G "$SOCKET" 2>/dev/null)" = "$GROUPE" ] && pose=1
    fi
    j=$((j + 1))
    sleep 0.5
done

if [ "$pose" = 1 ] && [ "$(stat -c %G "$SOCKET" 2>/dev/null)" = "$GROUPE" ]; then
    echo "socket $SOCKET : groupe $GROUPE posé"
    exit 0
fi

# On n'échoue PAS : une ingestion muette vaut mieux qu'un service bloqué. Mais on
# le DIT, pour que ça ne redevienne jamais un échec silencieux.
echo "socket $SOCKET : groupe $GROUPE NON posé après l'attente — l'ingestion Actor" \
     "Intelligence restera muette (sbxwaf ne pourra pas écrire)" >&2
exit 0
