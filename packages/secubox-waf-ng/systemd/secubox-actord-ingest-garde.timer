[Unit]
Description=SecuBox — garde du groupe de la socket d'ingestion Actor Intelligence, toutes les 5 min (#3880)

[Timer]
OnBootSec=10min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
