#
# sbx-actord — moteur Actor Intelligence (RFC-0013), 100 % SHADOW en Phase 0/1 :
# il ingère les Event Envelopes des capteurs, corrèle en acteurs/campagnes et
# expose une API read-only. Il ne décide ni n'applique RIEN. Consommateur
# best-effort : s'il tombe, sbxwaf/DPI continuent de protéger (émission fire-and-
# forget côté capteurs). Unité durcie (RFC-0013 §15).

[Unit]
Description=SecuBox Actor Intelligence — sbx-actord (shadow)
Documentation=file:///usr/share/doc/secubox/actor-intelligence-rfc-pack.md
After=network.target
# N'est PAS une dépendance de sbxwaf : l'intelligence est désactivable sans
# réduire la protection WAF (critère d'acceptation RFC-0013 §10).

[Service]
Type=simple
ExecStart=/usr/sbin/sbx-actord --shadow \
  --db /var/lib/secubox/actor/actord.db \
  --ledger /var/lib/secubox/actor/evidence.db \
  --ingest-socket /run/secubox/actord.sock \
  --api-socket /run/secubox/actor.sock
# INGESTION : groupe DEDIE, et lui seul (#1240). La socket naissait en groupe
# `secubox` — le groupe primaire de l'unite — et sbxwaf, qui tourne en
# `secubox-waf` sans y appartenir, ne pouvait pas y ecrire. L'emission etant
# fire-and-forget, l'echec etait MUET des deux cotes : le WAF croyait emettre,
# actord n'entendait rien, et la carte Renseignement affichait 0 acteur alors
# que le WAF comptait 15 000 menaces par jour.
#
# On ne touche PAS au groupe primaire : la socket d'API /run/secubox/actor.sock
# doit rester lisible par `secubox`, dont nginx fait partie — la changer
# couperait actor.gk2. D'ou un groupe dedie applique a la SEULE ingestion.
#
# `+` : execute en root, hors des restrictions d'identite de l'unite. La petite
# attente couvre la course avec la creation de la socket par le demon (Type=simple,
# ExecStartPost part des le fork).
ExecStartPost=+/bin/sh -c 'i=0; while [ $i -lt 25 ] && [ ! -S /run/secubox/actord.sock ]; do sleep 0.2; i=$((i+1)); done; if [ -S /run/secubox/actord.sock ]; then chgrp actord-ingest /run/secubox/actord.sock && chmod 0660 /run/secubox/actord.sock; fi'
Restart=on-failure
RestartSec=3

# Identité non privilégiée dédiée ; groupe partagé secubox pour les sockets.
User=secubox-actord
Group=secubox
UMask=0007

# Répertoire d'état (créé/possédé automatiquement) : /var/lib/secubox/actor.
StateDirectory=secubox/actor
StateDirectoryMode=0750

# Durcissement (RFC-0013 §15).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Le socket partagé /run/secubox est écrit hors StateDirectory.
ReadWritePaths=/run/secubox
# Plafond mémoire : borne la carte des acteurs en mémoire.
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
# Alias « actor » : le catalogue (metacatalog) détecte un module par la présence
# de son unité secubox-<id>.service. On expose secubox-actor.service pour que le
# module apparaisse sous l'id « actor » (menu Système du Hall → admin.gk2/actor/).
Alias=secubox-actor.service
