# Table nft des bans de bloc /24 (#3716), rejouée au démarrage ET après chaque
# rechargement du pare-feu : `systemctl reload nftables` relance un
# `flush ruleset` qui emporte la table ; sans ce rejeu, un ban « actif » au
# journal ne bloquerait plus rien. Chaque bloc revient avec son temps RESTANT
# (fin enregistrée dans /var/lib/secubox-waf-blocs/blocs.json), jamais remis à
# sa durée d'origine ; un bloc échu, forgé ou désormais protégé n'est pas rejoué.
[Unit]
Description=SecuBox WAF — bans de bloc /24, table nft rejouée (#3716)
After=nftables.service
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/waf-blocs reappliquer
ExecReload=/usr/sbin/waf-blocs reappliquer
# root : nft exige CAP_NET_ADMIN ; l'état et protegees.env appartiennent à root.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/secubox-waf-blocs /var/log/secubox
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_NETLINK AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
