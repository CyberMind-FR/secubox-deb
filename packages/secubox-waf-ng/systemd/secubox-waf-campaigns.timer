# SecuBox-Deb :: secubox-waf-ng — cadence de corrélation des campagnes (#1070)
[Unit]
Description=SecuBox WAF — corréler les campagnes d'attaque toutes les 5 min

[Timer]
OnBootSec=3min
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=3min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
