# SecuBox-Deb :: secubox-waf-ng — cadence des indicateurs d'adresses reçus des pairs (#3723)
[Unit]
Description=SecuBox WAF — indicateurs d'adresses des pairs toutes les 5 min

[Timer]
# #3355 : décalage aléatoire stable par box, pour que les minuteries ne partent pas toutes ensemble
RandomizedDelaySec=60s
FixedRandomDelay=true
AccuracySec=30s
OnBootSec=4min
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redéclenche pas après une réactivation.
OnActiveSec=4min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
