# #3795 : crée /etc/secubox/secrets/leurres-hmac.key (root:secubox 0640) avant secubox-waf.service, qui la LIT
# directement. Jamais bloquant : le drop-in ne fait que Wants=/After= ; un échec ici laisse l'API démarrer (HMAC null).
# Crée la clé si elle manque, ne la tourne jamais ; sortie 0 si elle existe déjà.
[Unit]
Description=SecuBox WAF — clé locale du HMAC des leurres (#3795)
Before=secubox-waf.service
DefaultDependencies=yes

[Service]
Type=oneshot
RemainAfterExit=no
User=root
ExecStart=/usr/sbin/secubox-waf-leurres-cle
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/etc/secubox/secrets
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=secubox-waf.service
