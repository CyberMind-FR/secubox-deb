#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma
set -e

if [ "$1" = "configure" ]; then
    # #319 /data migration. Move legacy /srv/<dir> → /data/<dir> and leave a
    # symlink behind for back-compat. Idempotent.
    for _d in mitmproxy-waf mitmproxy mitmproxy-in; do
      if [ -d "/srv/$_d" ] && [ ! -L "/srv/$_d" ] && [ ! -e "/data/$_d" ]; then
        mkdir -p /data
        _was_active=""
        if systemctl is-active --quiet secubox-waf; then
          systemctl stop secubox-waf || true
          _was_active=1
        fi
        mv "/srv/$_d" "/data/$_d" && ln -s "/data/$_d" "/srv/$_d" \
          && echo "secubox-waf: migrated /srv/$_d → /data/$_d"
        [ -n "$_was_active" ] && systemctl start secubox-waf || true
      fi
    done


    # Create log directory
    mkdir -p /var/log/secubox/waf
    # LE PROPRIETAIRE EST CELUI QUI ECRIT (ref #1039). Cette ligne posait
    # `secubox:secubox` alors que `sbxwaf` tourne sous `secubox-waf` : le
    # repertoire etant en 0750, le demon se retrouvait VERROUILLE DEHORS de son
    # propre journal (« sbxwaf/threatlog: open ...: permission denied »), et
    # chaque reinstallation du paquet reintroduisait la panne.
    #
    # Groupe `secubox` : c'est sous ce compte que l'agregateur sert le panneau
    # du WAF et lit ce journal. Le setgid (2750) fait heriter ce groupe aux
    # fichiers crees, sans quoi le demon les creerait dans SON groupe et le
    # lecteur perdrait l'acces au fichier suivant.
    chown secubox-waf:secubox /var/log/secubox/waf 2>/dev/null || true
    chmod 2750 /var/log/secubox/waf 2>/dev/null || true

    # Enable the WAF API service
    systemctl daemon-reload
    systemctl enable secubox-waf.service || true
    systemctl start secubox-waf.service || true

    # Reminder about LXC container
    echo "=============================================="
    echo "SecuBox WAF installed."
    echo ""
    echo "To install the mitmproxy LXC container, run:"
    echo "  wafctl install"
    echo ""
    echo "To start the WAF after container install:"
    echo "  wafctl start"
    echo ""
    echo "To add routes for HAProxy backends:"
    echo "  wafctl add-route <domain> <ip> <port>"
    echo "=============================================="
fi
#DEBHELPER#
exit 0
