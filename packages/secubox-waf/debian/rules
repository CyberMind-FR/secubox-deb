#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -D -m 0644 logrotate.d/secubox-waf \
		debian/secubox-waf/etc/logrotate.d/secubox-waf
	# API backend
	install -d debian/secubox-waf/usr/lib/secubox/waf
	cp -r api debian/secubox-waf/usr/lib/secubox/waf/
	# Web frontend
	install -d debian/secubox-waf/usr/share/secubox/www/waf
	cp -r www/waf/. debian/secubox-waf/usr/share/secubox/www/waf/
	# Menu integration
	install -d debian/secubox-waf/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-waf/usr/share/secubox/menu.d/ || true
	# WAF rules and config
	install -d debian/secubox-waf/usr/share/secubox/waf
	[ -d config ] && cp -r config/. debian/secubox-waf/usr/share/secubox/waf/ || true
	# #1080 phase G — profils de service par vhost, livrés en CONFFILE /etc
	# (dpkg conserve les éditions de l'opérateur ; le fichier est possédé par le
	# paquet, contrairement à waf-rules.json qui reste opérateur-seedé). Le
	# daemon (sbxwaf, unité secubox-waf-ng) le lit via --vhost-profiles.
	install -d debian/secubox-waf/etc/secubox/waf
	[ -f config/vhost_profiles.json ] && install -m 0644 config/vhost_profiles.json \
		debian/secubox-waf/etc/secubox/waf/vhost_profiles.json || true
	# Mitmproxy addon for LXC container
	install -d debian/secubox-waf/usr/share/secubox/waf/mitmproxy
	[ -d mitmproxy ] && cp -r mitmproxy/. debian/secubox-waf/usr/share/secubox/waf/mitmproxy/ || true
	# wafctl control script
	install -d debian/secubox-waf/usr/sbin
	[ -f scripts/wafctl ] && install -m 755 scripts/wafctl debian/secubox-waf/usr/sbin/ || true
	# Sudoers : `secubox` peut purger le cache média du WAF (wafctl purge-cache).
	# Conffile /etc/sudoers.d (0440) — permet aux tâches de contenu tournant sous
	# `secubox` (metablog-sync) de rafraîchir le cache après une synchro git.
	install -d debian/secubox-waf/etc/sudoers.d
	install -m 0440 sudoers/secubox-waf debian/secubox-waf/etc/sudoers.d/secubox-waf
	# Log directory
	install -d debian/secubox-waf/var/log/secubox/waf
	# Modular nginx config
	install -d debian/secubox-waf/etc/nginx/secubox.d
	[ -f nginx/waf.conf ] && cp nginx/waf.conf debian/secubox-waf/etc/nginx/secubox.d/ || true
	# Example haproxy-routes.json
	install -d debian/secubox-waf/usr/share/doc/secubox-waf/examples
	[ -f config/haproxy-routes.json.example ] && cp config/haproxy-routes.json.example debian/secubox-waf/usr/share/doc/secubox-waf/examples/ || true
	# Systemd service for mitmproxy in container
	install -d debian/secubox-waf/usr/share/secubox/waf/systemd
	[ -f systemd/mitmproxy.service ] && cp systemd/mitmproxy.service debian/secubox-waf/usr/share/secubox/waf/systemd/ || true
