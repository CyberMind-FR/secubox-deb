# Mitmproxy service for SecuBox WAF LXC container
# Install this in the mitmproxy LXC container at /etc/systemd/system/

[Unit]
Description=SecuBox WAF - Mitmproxy Inspection Proxy
After=network.target

[Service]
Type=simple
User=mitmproxy
Group=mitmproxy
WorkingDirectory=/data/mitmproxy
# WARNING (#603): any ExecStart override (drop-in) MUST keep
# `--set confdir=/data/mitmproxy`. Without it mitmdump falls back to
# ~/.mitmproxy, which ProtectHome=true makes inaccessible → PermissionError
# crash-loop. A cookie_audit drop-in once dropped this flag and downed the WAF.
ExecStart=/opt/mitmproxy/bin/mitmdump \
    --mode regular \
    --listen-host 0.0.0.0 \
    --listen-port 8080 \
    --set confdir=/data/mitmproxy \
    -s /data/mitmproxy/secubox_waf.py \
    -s /data/mitmproxy/media_cache.py
Restart=on-failure
RestartSec=5

# Phase 7 follow-up (#498) — memory hygiene. mitmproxy under heavy long-
# running traffic accumulates connection / SSL session state ; on gk2 the
# unit ran 1 d 16 h with 200 MB RSS, 934 ESTAB conns and 51 % response-
# error rate on the HAProxy backend. RuntimeMaxSec lets systemd cycle the
# process every 6 h with a clean restart — matches the host mitm-wg /
# mitm captive Phase 6.P drop-ins (10-runtime-max.conf).
RuntimeMaxSec=21600

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/mitmproxy /var/log/mitmproxy

# Phase 7 (#498) — memory bound. mitmproxy can balloon under attack
# traffic ; OOM-killing it is cleaner than swap thrash.
MemoryHigh=400M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
