{
  "manifest_version": 3,
  "name": "SecuBox Companion",
  "version": "0.1.0",
  "description": "Status, quick access, and PeerTube YouTube cookie relay for a SecuBox appliance.",
  "browser_specific_settings": {
    "gecko": {
      "id": "secubox-webext@cybermind.fr",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage", "cookies", "alarms"],
  "host_permissions": [
    "*://*.secubox.in/*",
    "https://*.youtube.com/*",
    "https://youtube.com/*"
  ],
  "action": {
    "default_title": "SecuBox Companion",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/yt-capture.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/yt-hook.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
