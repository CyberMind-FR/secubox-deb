# Profils AppArmor ENFORCE de secubox-webfilter (#1962) : l'API (socket Unix), le démon d'alimentation (journal d'Unbound) et la synchronisation
# (téléchargement https). Tout ce qui n'est pas listé est refusé. Posés dans /etc/apparmor.d/secubox-webfilter, chargés par le postinst.

#include <tunables/global>

/usr/sbin/secubox-webfilter-api {
  #include <abstractions/base>
  #include <abstractions/python>

  /usr/sbin/secubox-webfilter-api r,
  /usr/bin/python3* rix,
  /usr/lib/secubox/webfilter/** r,
  /usr/lib/secubox/ r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /usr/local/lib/python3*/** r,

  # Configuration et authentification : fichiers nommés, jamais /etc/secubox/** (le dossier des secrets reste interdit).
  /etc/secubox/ r,
  /etc/secubox/secubox.conf r,
  /etc/secubox/webfilter.toml r,
  /etc/secubox/users.json r,
  /etc/secubox/appareils.json r,
  /etc/secubox/auth.toml r,
  deny /etc/secubox/secrets/** r,
  /etc/nsswitch.conf r,
  # Registre des sessions : sans lui, toute garde d'API voit un registre vide et refuse (401 partout, #942) ; trace de délégation.
  /var/lib/secubox/auth/ r,
  /var/lib/secubox/auth/sessions.json r,
  /var/log/secubox/delegation.log w,

  /var/lib/secubox/webfilter/ r,
  /var/lib/secubox/webfilter/** rwk,

  /run/secubox/ r,
  /run/secubox/webfilter.sock rwk,
  /run/secubox/webfilter.sock.lock rwk,

  network unix stream,
  network unix dgram,
  /proc/sys/net/core/somaxconn r,
}

/usr/sbin/secubox-webfilter-feed {
  #include <abstractions/base>
  #include <abstractions/python>

  /usr/sbin/secubox-webfilter-feed r,
  /usr/bin/python3* rix,
  /usr/lib/secubox/webfilter/** r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,

  /etc/secubox/webfilter.toml r,

  /var/lib/secubox/webfilter/ r,
  /var/lib/secubox/webfilter/** rwk,
  # #3005 : pas de demande d'application pendant une compilation de secubox-dns-listes (état 0644, lecture seule)
  /var/lib/secubox-dns-listes/etat.json r,

  # Journal d'Unbound (lecture seule) et adresses de la box
  /usr/bin/journalctl rix,
  /usr/sbin/ip rix,
  /usr/bin/ip rix,
  /var/log/journal/ r,
  /var/log/journal/** r,
  /run/log/journal/ r,
  /run/log/journal/** r,
  /etc/machine-id r,
  /proc/sys/kernel/random/boot_id r,
  /proc/*/stat r,
  /proc/*/cgroup r,
  /sys/fs/cgroup/** r,
  /run/systemd/journal/ r,
  /run/systemd/journal/** r,

  network netlink raw,
  network unix stream,
}

/usr/sbin/secubox-webfilter-sync {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/ssl_certs>

  /usr/sbin/secubox-webfilter-sync r,
  /usr/bin/python3* rix,
  /usr/lib/secubox/webfilter/** r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,

  /etc/secubox/webfilter.toml r,

  /var/lib/secubox/webfilter/ r,
  /var/lib/secubox/webfilter/** rwk,
  /var/log/secubox/audit.log w,

  network inet stream,
  network inet6 stream,
  network unix stream,
}

/usr/sbin/secubox-webfilter-ctl {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>      # compte secubox-webfilter (passwd, nsswitch)

  /usr/sbin/secubox-webfilter-ctl r,
  /usr/bin/python3* rix,
  /usr/lib/secubox/webfilter/** r,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,

  # Lecture : configuration, état du service (config.json, listes, connus), drop-in d'ad-guard (adresses déjà liées à une vue)
  /etc/secubox/webfilter.toml r,
  /var/lib/secubox/webfilter/ r,
  /var/lib/secubox/webfilter/config.json r,
  owner /var/lib/secubox/webfilter/config.json w,   # #3172 : fchown/fchmod par descripteur, permis seulement tant que root le possède
  /var/lib/secubox/webfilter/listes/ r,
  /var/lib/secubox/webfilter/listes/** r,
  /var/lib/secubox/webfilter/remanence.json r,      # #3005 : adresses rémanentes, écrites par le démon, relues comme une entrée hostile
  /etc/unbound/unbound.conf.d/ r,
  /etc/unbound/unbound.conf.d/94-secubox-adguard-tv.conf r,

  # Écriture : la SEULE source de webfilter pour secubox-dns-listes (#3205), ses résultats, son état racine et l'audit
  /var/lib/secubox-dns-listes/sources/ r,
  /var/lib/secubox-dns-listes/sources/93-secubox-webfilter.conf rw,
  /var/lib/secubox-dns-listes/sources/.sbx-* rw,
  /var/lib/secubox/webfilter/resultat.json rw,
  /var/lib/secubox/webfilter/carte.json rw,
  /var/lib/secubox/webfilter/appliquer.demande rw,   # consommée (effacée) dès le début d'une application (#2441)
  /var/lib/secubox/webfilter/application.en-cours rw,   # #3005 : marqueur pendant l'application (le démon ne redemande pas)
  /var/lib/secubox/webfilter/.wf-* rw,
  /var/lib/secubox-webfilter-ctl/ rw,
  /var/lib/secubox-webfilter-ctl/** rwk,
  /var/log/secubox/audit.log w,

  # Table de voisinage et adresses de la box. Unbound n'est plus touché : secubox-dns-listes vérifie et recharge (#3205).
  /usr/sbin/ip rix,
  /usr/bin/ip rix,
  /usr/share/iproute2/** r,

  capability chown,
  capability dac_override,
  capability fowner,
  network netlink raw,
  network unix stream,
}
