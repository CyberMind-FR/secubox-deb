#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
set -e

case "$1" in
  remove|purge)
    if command -v apparmor_parser >/dev/null 2>&1; then
      apparmor_parser -R /etc/apparmor.d/secubox-webfilter >/dev/null 2>&1 || true
    fi
    ;;
esac

case "$1" in
  purge)
    # L'historique de navigation par appareil ne survit pas au paquet (rétention 30 jours, jamais exporté).
    rm -rf /var/lib/secubox/webfilter
    ;;
esac

#DEBHELPER#

exit 0
