#!/bin/sh
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
set -e

case "$1" in
  remove)
    systemctl stop secubox-webfilter-apply.path secubox-webfilter-apply.timer secubox-webfilter-apply.service secubox-webfilter-sync.path \
      secubox-webfilter-sync.timer secubox-webfilter-sync.service secubox-webfilter-feed.service secubox-webfilter.service >/dev/null 2>&1 || true
    # Le blocage ne survit pas au paquet : sans lui, plus aucun moyen de l'annuler depuis l'interface. La source est retirée (et l'ancien fichier
    # d'avant #3205 s'il reste) ; secubox-dns-listes recompile sans webfilter, vérifie et recharge Unbound (jamais lors d'une simple mise à jour :
    # seul « remove » arrive ici).
    SOURCE=/var/lib/secubox-dns-listes/sources/93-secubox-webfilter.conf
    ANCIEN=/etc/unbound/unbound.conf.d/93-secubox-webfilter.conf
    if [ -f "$SOURCE" ] || [ -f "$ANCIEN" ]; then
      rm -f /var/lib/secubox-dns-listes/sources/93-secubox-webfilter.conf /etc/unbound/unbound.conf.d/93-secubox-webfilter.conf
      systemctl start --no-block secubox-dns-listes.service >/dev/null 2>&1 || true
      printf '{"ts": "%s", "module": "webfilter-ctl", "action": "retrait", "detail": "paquet retiré : source retirée, secubox-dns-listes recompile"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> /var/log/secubox/audit.log 2>/dev/null || true
    fi
    ;;
esac

#DEBHELPER#

exit 0
