"""SecuBox-Deb :: secubox-webfilter-ctl — applique les profils de webfilter à Unbound (root, déclenché par fichier, jamais par sudo) (#1962)."""
import sys

sys.path.insert(0, "/usr/lib/secubox/webfilter")

from webfilter.ctl import principal  # noqa: E402

if __name__ == "__main__":
    sys.exit(principal())
