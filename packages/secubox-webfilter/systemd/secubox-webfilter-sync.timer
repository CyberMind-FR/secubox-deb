# SPDX-License-Identifier: LicenseRef-CMSD-1.0
[Unit]
Description=SecuBox WebFilter — synchronisation périodique des listes

[Timer]
OnBootSec=10min
# #2919 : depuis l'activation de la minuterie ; OnUnitActiveSec seul ne se redeclenche pas apres une reactivation.
OnActiveSec=10min
OnUnitActiveSec=6h
RandomizedDelaySec=15min
Persistent=true
Unit=secubox-webfilter-sync.service

[Install]
WantedBy=timers.target
