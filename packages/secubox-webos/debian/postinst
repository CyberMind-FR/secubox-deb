#!/bin/bash
set -e
if [ "$1" = "configure" ]; then
    # nginx (www-data) doit pouvoir lire /run/secubox/webos.sock (owner secubox).
    if getent group secubox >/dev/null 2>&1 && id www-data >/dev/null 2>&1; then
        adduser www-data secubox >/dev/null 2>&1 || usermod -aG secubox www-data || true
    fi
    # COFFRE DES ACCES DELEGUES (#1288). 0700 : le dossier lui-meme ne se
    # liste pas — un secret dont on connait l'existence est deja a moitie
    # trouve. Il vit sous /etc/secubox/secrets, dont le parent est deja
    # restreint ; on pose donc AUSSI l'entree ACL et son MASQUE, sans quoi
    # tout chmod d'un autre paquet neutraliserait l'entree en silence (#1255).
    install -d -o secubox -g secubox -m 0700 /etc/secubox/secrets/webos-acces || true
    if [ -d /etc/secubox/secrets ] && command -v setfacl >/dev/null 2>&1; then
        setfacl -m u:secubox:--x,m::x /etc/secubox/secrets 2>/dev/null || true
    fi
    systemctl daemon-reload || true
    systemctl enable --now secubox-webos.service || true
fi

# CE BLOC EST APRES LE JETON DEBHELPER, ET C'EST TOUT L'INTERET. C'est la que
# dpkg-maintscript-helper execute le `mv_conffile` qui deplace le vhost de
# sites-enabled/ vers sites-available/ : pose avant, le lien d'activation
# voyait encore l'ancien fichier en place, ne faisait rien, et le deplacement
# laissait le Hall SANS lien — nginx gardait sa configuration chargee et le
# premier reload venu l'aurait perdu. Vu sur gk2 le 2026-09-22.
#DEBHELPER#

if [ "$1" = "configure" ]; then
    # Activation du vhost : lien sites-enabled -> sites-available, pose une
    # seule fois. Un lien deja present (ou pointant ailleurs) est RESPECTE, et
    # une absence deliberee n'est pas retablie de force au `dpkg -i` suivant :
    # desactiver un site est une decision d'exploitation.
    if [ -f /etc/nginx/sites-available/hall.gk2.net.conf ] && \
       [ ! -e /etc/nginx/sites-enabled/hall.gk2.net.conf ] && \
       [ ! -L /etc/nginx/sites-enabled/hall.gk2.net.conf ]; then
        ln -s ../sites-available/hall.gk2.net.conf \
              /etc/nginx/sites-enabled/hall.gk2.net.conf
    fi
    # Filet : un `.dpkg-dist`/`.dpkg-new` laisse dans sites-enabled par une
    # version anterieure (qui y livrait le conffile) reste charge par le glob
    # de nginx et le fait echouer. On l'ecarte plutot que de le supprimer.
    for _f in /etc/nginx/sites-enabled/hall.gk2.net.conf.dpkg-*; do
        [ -e "$_f" ] || continue
        mkdir -p /var/backups/nginx
        mv -f "$_f" /var/backups/nginx/ 2>/dev/null || true
    done

    # ROUTE SBXWAF — POSEE PAR CE PAQUET (#1323), comme son vhost et son unite.
    # Sans elle, sbxwaf recoit un nom qu'il ne connait pas et rend 421, meme si
    # HAProxy dirige bien et que nginx sert bien. Cette table n'appartenait a
    # aucun paquet : 275 routes posees a la main, invisibles tant qu'elles
    # tiennent, fatales le jour ou l'une saute (vu sur podcaster).
    # L'outil vient de secubox-core, dont ce paquet depend deja ; le garde
    # `command -v` couvre l'ordre de configuration a la premiere installation.
    if command -v secubox-waf-route >/dev/null 2>&1; then
      secubox-waf-route hall.gk2.secubox.in 9080 || true
      secubox-waf-route hall.gk2.net 9080 || true
    fi
    # Recharge nginx SEULEMENT si la configuration valide — et maintenant que
    # le lien est pose, ce reload sert le vhost depuis son nouvel emplacement.
    if [ -x /usr/sbin/nginx ] && nginx -t 2>/dev/null; then
        systemctl reload nginx || true
    fi
fi
