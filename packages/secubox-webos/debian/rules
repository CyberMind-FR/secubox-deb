#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d $(CURDIR)/debian/secubox-webos/usr/lib/secubox/webos/api
	install -d $(CURDIR)/debian/secubox-webos/etc/nginx/secubox.d
	# VHOST DANS sites-available, JAMAIS sites-enabled (#1322). nginx charge
	# `include sites-enabled/*` : un conffile livre LA fait atterrir le
	# `.dpkg-dist` de dpkg dans le glob, et nginx refuse de demarrer sur
	# « duplicate upstream ». Constate sur gk2 le 2026-09-22 — nginx a tenu
	# uniquement parce qu'il tournait deja ; le prochain redemarrage echouait.
	# Le lien d'activation est pose par postinst, et respecte s'il est retire.
	install -d $(CURDIR)/debian/secubox-webos/etc/nginx/sites-available
	install -d $(CURDIR)/debian/secubox-webos/etc/secubox
	install -d $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/fonts
	cp -r api/* $(CURDIR)/debian/secubox-webos/usr/lib/secubox/webos/api/
	install -m 0644 nginx/webos.conf $(CURDIR)/debian/secubox-webos/etc/nginx/secubox.d/webos.conf
	install -m 0644 nginx/hall.vhost.conf $(CURDIR)/debian/secubox-webos/etc/nginx/sites-available/hall.gk2.net.conf
	install -m 0644 etc/webos.toml.example $(CURDIR)/debian/secubox-webos/etc/secubox/webos.toml.example
	# LE HALL DÉCLARE SA CAPACITÉ DE VOLUME GÉNÉRAL (#1349). Sans ce manifeste,
	# ZIA refuserait l'action faute de la connaître — le Hall l'exécute
	# nativement, mais c'est le registre qui dit ce qui est PERMIS.
	install -D -m 0644 capabilities.d/hall.json \
	  $(CURDIR)/debian/secubox-webos/usr/share/secubox/capabilities.d/hall.json
	install -d $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/cardlets
	install -m 0644 www/hall/cardlets/*.html $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/cardlets/
	install -m 0644 www/hall/index.html $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/index.html
	install -m 0644 www/hall/acces.html $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/acces.html
	install -m 0644 www/hall/relais.html $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/relais.html
	install -m 0644 www/hall/hall-logo.svg $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/hall-logo.svg
	install -m 0644 www/hall/render-ref.html $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/render-ref.html
	install -m 0644 www/hall/slicebar.css $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/slicebar.css
	# Lexie (#1287) — la fenetre vocale. Les fichiers de ce repertoire sont
	# listes UN PAR UN : un oubli ici ne casse pas la construction, il produit
	# un 404 a l'execution, ce qui se voit bien plus tard.
	install -m 0644 www/hall/lexie.js $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/lexie.js
	install -m 0644 www/hall/slicebar.js $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/slicebar.js
	install -m 0644 www/hall/aide.js $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/aide.js
	install -m 0644 www/hall/sonde.js $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/sonde.js
	install -m 0644 www/hall/spicy.css $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/spicy.css
	install -m 0644 www/hall/hls.min.js $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/hls.min.js
	install -d $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/medaillons
	install -m 0644 www/hall/medaillons/*.webp $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/medaillons/
	install -m 0644 www/hall/fonts/*.woff2 $(CURDIR)/debian/secubox-webos/usr/share/secubox/www/hall/fonts/
