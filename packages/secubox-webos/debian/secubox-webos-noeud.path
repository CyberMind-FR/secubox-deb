[Unit]
Description=SecuBox WebOS : demandes de l API sur le relais du nom de noeud (#3824)
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/3824

[Path]
# L API webos (secubox, NoNewPrivileges) depose <id>.demande ici ; cette unite root la traite.
DirectoryNotEmpty=/run/secubox/webos-noeud
Unit=secubox-webos-noeud.service

[Install]
WantedBy=paths.target
