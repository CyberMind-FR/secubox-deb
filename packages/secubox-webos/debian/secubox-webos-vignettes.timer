[Unit]
Description=SecuBox WebOS — une vignette de module toutes les 3 minutes (une par semaine et par module)

[Timer]
OnBootSec=3min
OnUnitActiveSec=3min
RandomizedDelaySec=30s
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
