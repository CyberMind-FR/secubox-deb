# /etc/secubox/webos.toml
[webos]
enabled = false
registry_enabled = true
# Coque « vue maître » du Hall (#2996) : false = Hall classique. Prévisualisation
# par navigateur sans toucher ce fichier : https://hall.<domaine>/?hall=v2
hall_v2 = false

# Accueil du nom de nœud (#3821) : <nœud>.<zone> (ex. gk2.secubox.in) montre le dé SecuBox en plein écran sur « / ».
# false = rien n'est posé (et ce qui l'avait été est retiré) ; appliquer : webos-noeud appliquer
[noeud]
accueil = true
# Relais des AUTRES chemins de ce nom vers l'ancienne cible de sa route (#3824 ; sur gk2 : l'API admin, metrics…).
# FERMÉ par défaut : le nom public ne sert que le dé (« / », /_noeud/) et /api/v1/health, tout le reste rend 404.
# À ouvrir ou fermer depuis la page Système (panneau « Nom du nœud »), ou : webos-noeud relais activer|desactiver
relais_api = false
