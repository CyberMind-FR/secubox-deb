# /etc/secubox/webos.toml
[webos]
enabled = false
registry_enabled = true
# Coque « vue maître » du Hall (#2996) : false = Hall classique. Prévisualisation
# par navigateur sans toucher ce fichier : https://hall.<domaine>/?hall=v2
hall_v2 = false

# L'accueil du nom de nœud ([noeud] accueil, relais_api) n'est plus ici : /etc/secubox/noeud.toml, géré par
# secubox-core depuis #3883 (repris une fois de cette section si elle existait).
