# See LICENCE-CMSD-1.0.md for terms.
"""
SecuBox-Deb :: webos — accueil du NOM DE NŒUD (#3821), API fermées sur ce nom (#3824)
CyberMind — https://cybermind.fr

Le nom nu d'une box, `<nœud>.<zone>` (`secubox-domaine`, ex. gk2.secubox.in), est celui que son frontal expose en
premier. Il ne servait rien : sur gk2 une route posée à la main l'envoyait vers un serveur nginx sans nom (:8000) qui
rend 404 à « / » ; ailleurs il n'avait pas de route du tout. Ce script lui donne, PAR DÉFAUT et sur chaque box, une page
d'accueil : le dé SecuBox en plein écran (moteur et faces du Hall, partagés).

    webos-noeud appliquer   (postinst) déclare le vhost nginx, la route sbxwaf et le vhost HAProxy
    webos-noeud retirer     (postrm)   retire le vhost et rend à la route son ancienne cible si on l'avait reprise
    webos-noeud etat        ce qui est en place, en JSON
    webos-noeud relais activer|desactiver [acteur]   ouvre / ferme le relais des autres chemins (#3824)
    webos-noeud relais etat                          l'état du relais, en JSON
    webos-noeud prepare | traite   (secubox-webos-noeud.service, root) dépôt des demandes de l'API et leur traitement

RÈGLES, dans l'ordre :
  1. `[noeud] accueil = false` dans /etc/secubox/webos.toml : rien n'est posé, ce qui l'avait été est retiré.
  2. CE QUI EST EXPLICITE GAGNE. Un serveur nginx qui nomme déjà ce domaine (server_name exact ou `.domaine`) : rien.
     Une route sbxwaf vers une autre cible que 9080 qui SERT quelque chose à « / » : rien. Seule une ancienne cible
     qui répond 404 à « / » est reprise.
  3. LE NOM PUBLIC NE SERT QUE LE DÉ (#3824, décision du propriétaire). Le vhost généré sert « / » exact, ses
     ressources sous /_noeud/ et `/api/v1/health` (relayé à l'ancienne cible s'il y en a une, sinon un 200 JSON local) ;
     TOUT LE RESTE rend 404. Relayer les autres chemins à l'ancienne cible (sur gk2 : l'API admin, metrics,
     metablogizer…) est une OPTION, fermée par défaut : `[noeud] relais_api = true`, que l'administrateur ouvre ou
     ferme depuis la page Système (API webos, require_jwt) ; chaque bascule est auditée. L'ouvrir est refusé tant que
     le mot de passe admin par défaut n'est pas prouvé changé (#3401).
  4. LE WAF RESTE SUR LE CHEMIN. La route va vers nginx :9080 par sbxwaf comme tout vhost ; jamais de contournement.
  5. Aucune NOUVELLE exposition publique tant que le mot de passe admin par défaut n'est pas prouvé changé (#3401) :
     le vhost nginx est posé, la route et le vhost HAProxy attendent (refus audité).
Chaque décision est écrite dans /var/log/secubox/audit.log. nginx n'est rechargé qu'après `nginx -t` réussi ; un
échec remet le fichier précédent.
"""
from __future__ import annotations

import http.client
import ipaddress
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

MODULE = "webos-noeud"
PORT = 9080
WWW = "/usr/share/secubox/www"
# Racine substituée (tests seulement) : honorée HORS root uniquement.
R = ""
if os.geteuid() != 0 and os.environ.get("SBX_NOEUD_ESSAI"):
    R = os.environ["SBX_NOEUD_ESSAI"].rstrip("/")

CONF = R + "/etc/nginx/conf.d/secubox-noeud.conf"
DOSSIERS_NGINX = (R + "/etc/nginx/sites-enabled", R + "/etc/nginx/conf.d")
FORMAT_HOTES = R + "/etc/nginx/conf.d/secubox-hosts-log.conf"   # log_format sbx_host (secubox-metrics)
ROUTES = os.environ.get("SBX_WAF_ROUTES", R + "/etc/secubox/waf/haproxy-routes.json")
REGLAGES = R + "/etc/secubox/webos.toml"
HAPROXY_TOML = R + "/etc/secubox/haproxy.toml"
ETAT_DIR = R + "/var/lib/secubox-webos-noeud"
ETAT = ETAT_DIR + "/etat.json"
AUDIT = R + "/var/log/secubox/audit.log"
MDP_DEFAUT_PY = "/usr/lib/python3/dist-packages/secubox_core/mot_de_passe_defaut.py"
# Demandes de l'API webos (#3824) : dépôt root:secubox 1770 (l'API dépose), résultats root:secubox 0750 (l'API lit).
# Créés par `prepare`, en root, jamais par tmpfiles (#3172) ; un lien à leur place est retiré, jamais suivi.
DEMANDES = R + "/run/secubox/webos-noeud"
RESULTATS = R + "/run/secubox/webos-noeud-resultats"
TAILLE_DEMANDE = 512
NOM_DEMANDE = re.compile(r"^[a-f0-9]{16}\.demande$")
ACTEUR = re.compile(r"^[A-Za-z0-9_.@-]{1,64}$")
# Dans l'unité root (bac à sable, réseau IP fermé) `nginx -t` passe par PID 1, comme le pilotage (#3126).
NGINX_T_PAR_SYSTEMD = os.environ.get("SBX_NOEUD_UNITE") == "1"

DOMAINE = re.compile(r"^(?=.{4,253}$)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$")
SERVER_NAME = re.compile(r"\bserver_name\s+([^;]+);")
ENTETE = "# GÉNÉRÉ par /usr/sbin/webos-noeud (secubox-webos, #3821)"


def log(msg: str) -> None:
    print(f"{MODULE}: {msg}", file=sys.stderr)


def executer(argv: list[str], delai: int = 60) -> subprocess.CompletedProcess:
    """Toutes les commandes passent ici (substituable par les tests). Liste d'arguments, jamais de shell."""
    return subprocess.run(argv, check=True, timeout=delai, capture_output=True, text=True)


def audit(action: str, resultat: str, detail: str = "") -> None:
    ligne = json.dumps({"ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "module": MODULE,
                        "action": action, "result": resultat, "detail": detail[:300]}, ensure_ascii=False)
    try:
        fd = os.open(AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o640)
        try:
            os.write(fd, (ligne + "\n").encode())
        finally:
            os.close(fd)
    except OSError as e:
        log(f"audit.log non écrit ({e.__class__.__name__}) : {ligne}")


# ── Entrées ──────────────────────────────────────────────────────────────────────────────────────────────────

def domaine() -> str:
    """Le nom du nœud, celui de `secubox-domaine` ; vide si inconnu ou invalide (alors rien n'est posé)."""
    brut = os.environ.get("SECUBOX_DOMAINE", "") if R else ""
    if not brut:
        try:
            brut = executer(["secubox-domaine"], delai=30).stdout
        except (OSError, subprocess.SubprocessError) as e:
            log(f"domaine de la box inconnu ({e.__class__.__name__})")
            return ""
    dom = brut.strip().lower().rstrip(".")
    return dom if DOMAINE.match(dom) else ""


def accueil_voulu() -> bool:
    """`[noeud] accueil` de webos.toml, vrai par défaut. Un fichier illisible ne désactive rien."""
    try:
        import tomllib
        with open(REGLAGES, "rb") as fh:
            val = tomllib.load(fh).get("noeud", {}).get("accueil", True)
    except FileNotFoundError:
        return True
    except (OSError, ValueError) as e:
        log(f"{REGLAGES} illisible ({e.__class__.__name__}) : réglage par défaut (accueil actif)")
        return True
    return val is not False


def relais_voulu() -> bool:
    """`[noeud] relais_api` de webos.toml, FAUX par défaut (#3824) : seul `true` ouvre. Illisible : fermé."""
    try:
        import tomllib
        with open(REGLAGES, "rb") as fh:
            val = tomllib.load(fh).get("noeud", {}).get("relais_api", False)
    except FileNotFoundError:
        return False
    except (OSError, ValueError) as e:
        log(f"{REGLAGES} illisible ({e.__class__.__name__}) : relais des autres chemins FERMÉ")
        return False
    return val is True


def noms_explicites(dom: str) -> list[str]:
    """Fichiers nginx (hors le nôtre) dont un server_name nomme ce domaine exactement, ou `.domaine`."""
    trouves = []
    for dossier in DOSSIERS_NGINX:
        try:
            noms = sorted(os.listdir(dossier))
        except OSError:
            continue
        for nom in noms:
            chemin = os.path.join(dossier, nom)
            if os.path.abspath(chemin) == os.path.abspath(CONF) or not os.path.isfile(chemin):
                continue
            if dossier.endswith("conf.d") and not nom.endswith(".conf"):
                continue   # nginx n'inclut que conf.d/*.conf
            try:
                with open(chemin, encoding="utf-8", errors="replace") as fh:
                    texte = "\n".join(ligne.split("#", 1)[0] for ligne in fh.read(1 << 20).splitlines())
            except OSError:
                continue
            for m in SERVER_NAME.finditer(texte):
                if any(t.lower() in (dom, "." + dom) for t in m.group(1).split()):
                    trouves.append(chemin)
                    break
    return trouves


def lire_table():
    """La table des routes sbxwaf ; None si absente (sbxwaf non installé). Illisible : ValueError (on abandonne)."""
    try:
        with open(ROUTES) as fh:
            table = json.load(fh)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        raise ValueError(f"table des routes illisible ({e.__class__.__name__})") from e
    if not isinstance(table, dict):
        raise ValueError("table des routes : pas un objet")
    return table


def cible(valeur) -> tuple[str, int] | None:
    if isinstance(valeur, list) and len(valeur) == 2 and isinstance(valeur[1], int) and 0 < valeur[1] < 65536:
        try:
            return str(ipaddress.ip_address(str(valeur[0]))), valeur[1]
        except ValueError:
            return None
    return None


def sonder(ip: str, port: int, dom: str) -> int | None:
    """Code HTTP de `GET /` pour ce nom sur l'ancienne cible ; None si elle ne répond pas."""
    try:
        cnx = http.client.HTTPConnection(ip, port, timeout=5)
        try:
            cnx.request("GET", "/", headers={"Host": dom, "User-Agent": MODULE})
            return cnx.getresponse().status
        finally:
            cnx.close()
    except (OSError, http.client.HTTPException):
        return None


def lire_etat() -> dict:
    try:
        with open(ETAT) as fh:
            e = json.load(fh)
        return e if isinstance(e, dict) else {}
    except (OSError, ValueError):
        return {}


def ecrire_atomique(chemin: str, texte: str, mode: int, proprio: tuple[int, int] | None = None) -> None:
    dossier = os.path.dirname(chemin)
    fd, tmp = tempfile.mkstemp(dir=dossier, prefix=".noeud-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(texte)
        os.chmod(tmp, mode)
        if proprio is not None and os.geteuid() == 0:
            os.chown(tmp, *proprio)
        os.replace(tmp, chemin)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def ecrire_etat(etat: dict) -> None:
    os.makedirs(ETAT_DIR, mode=0o700, exist_ok=True)
    ecrire_atomique(ETAT, json.dumps(etat, indent=2, sort_keys=True) + "\n", 0o600)


def mot_de_passe_change() -> bool:
    """La garde #3401 : vrai seulement si le mot de passe admin par défaut est PROUVÉ changé (code 10)."""
    if R:
        return os.environ.get("SBX_NOEUD_MDP_CHANGE") == "1"
    try:
        subprocess.run(["python3", "-I", MDP_DEFAUT_PY], check=True, timeout=30, capture_output=True, cwd="/")
    except subprocess.CalledProcessError as e:
        return e.returncode == 10
    except (OSError, subprocess.SubprocessError):
        return False
    return False   # code 0 : défaut actif


# ── Le vhost nginx ───────────────────────────────────────────────────────────────────────────────────────────

def rendre(dom: str, repli: tuple[str, int] | None, journal_hotes: bool, relais: bool = False) -> str:
    """Le vhost : « / » exact, /_noeud/, /api/v1/health ; le reste 404, ou relayé à l'ancienne cible si `relais`."""
    entetes = ("        proxy_http_version 1.1;\n"
               "        proxy_set_header Host $host;\n"
               "        proxy_set_header X-Real-IP $remote_addr;\n"
               "        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n")
    amont = ""
    if repli:
        ip, port = repli
        amont = f"http://{f'[{ip}]' if ':' in ip else ip}:{port}"
    # Santé : la seule API publique de ce nom. Relayée à l'ancienne cible s'il y en a une, sinon rendue ici.
    if amont:
        sante = f"    location = /api/v1/health {{\n        proxy_pass {amont};\n{entetes}    }}\n"
    else:
        sante = ("    location = /api/v1/health {\n"
                 "        default_type application/json;\n"
                 "        add_header Cache-Control \"no-store\" always;\n"
                 "        return 200 '{\"status\": \"ok\"}';\n"
                 "    }\n")
    if relais and amont:
        reste = ("    # [noeud] relais_api = true (#3824) : l'administrateur a OUVERT le relais des autres chemins.\n"
                 f"    location / {{\n        proxy_pass {amont};\n{entetes}    }}\n")
    else:
        reste = ("    # Rien d'autre n'est servi sur ce nom (#3824) : aucune API d'administration publique.\n"
                 "    location / {\n        return 404;\n    }\n")
    journal = "    access_log /var/log/nginx/secubox-hosts.log sbx_host;\n" if journal_hotes else ""
    csp = ("default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self'; "
           "base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
    return f"""{ENTETE} — ne pas éditer : réécrit à chaque configuration du paquet.
# Accueil du nom de nœud : le dé SecuBox en plein écran sur « / » EXACT, sa santé, rien d'autre (#3824).
# Désactiver : [noeud] accueil = false dans /etc/secubox/webos.toml, puis `webos-noeud appliquer`.
# Relais des autres chemins vers l'ancienne cible : page Système, ou `webos-noeud relais activer|desactiver`.
server {{
    listen {PORT};
    server_name {dom};
{journal}
    location = / {{
        root {WWW}/noeud;
        rewrite ^ /index.html break;
        add_header Content-Security-Policy "{csp}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-cache" always;
    }}
    # Le moteur et les six faces du Hall, partagés (jamais recopiés).
    location = /_noeud/sbx-dice.js {{
        alias {WWW}/hall/sbx-dice.js;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-cache" always;
    }}
    location ^~ /_noeud/dice/ {{
        alias {WWW}/hall/dice/;
        add_header X-Content-Type-Options "nosniff" always;
    }}
{sante}{reste}}}
"""


def nginx_valide_et_recharge() -> bool:
    try:
        argv = ["nginx", "-t"]
        if NGINX_T_PAR_SYSTEMD:
            argv = ["systemd-run", "--wait", "--pipe", "--collect", "--quiet", "/usr/sbin/nginx", "-t"]
        executer(argv, delai=60)
    except subprocess.CalledProcessError as e:
        log(f"nginx -t refuse la configuration : {(e.stderr or '').strip()[-400:]}")
        return False
    except (OSError, subprocess.SubprocessError) as e:
        log(f"nginx -t impossible ({e.__class__.__name__})")
        return False
    try:
        executer(["systemctl", "reload", "nginx"], delai=60)
    except (OSError, subprocess.SubprocessError) as e:
        log(f"rechargement de nginx impossible ({e.__class__.__name__}) : pris au prochain rechargement")
    return True


def lire_conf() -> str | None:
    try:
        with open(CONF, encoding="utf-8") as fh:
            return fh.read()
    except FileNotFoundError:
        return None


def poser_conf(texte: str) -> bool:
    """Écrit le vhost, le valide, recharge. Refusé : l'ancien fichier revient (ou aucun)."""
    avant = lire_conf()
    if avant == texte:
        return True
    ecrire_atomique(CONF, texte, 0o644)
    if nginx_valide_et_recharge():
        return True
    if avant is None:
        os.unlink(CONF)
    else:
        ecrire_atomique(CONF, avant, 0o644)
    return False


def retirer_conf() -> bool:
    try:
        with open(CONF, encoding="utf-8") as fh:
            if not fh.readline().startswith(ENTETE):
                log(f"{CONF} n'est pas le nôtre : laissé tel quel")
                return False
    except FileNotFoundError:
        return False
    os.unlink(CONF)
    nginx_valide_et_recharge()
    return True


# ── Route sbxwaf et vhost HAProxy ────────────────────────────────────────────────────────────────────────────

def poser_route(dom: str) -> bool:
    """La route vers nginx :9080, par l'outil commun de secubox-core (adresse prise aux voisines du même port)."""
    try:
        executer(["secubox-waf-route", dom, str(PORT)], delai=60)
        return True
    except (OSError, subprocess.SubprocessError) as e:
        log(f"route sbxwaf de {dom} non posée ({e.__class__.__name__})")
        return False


def rendre_route(dom: str, ancienne: list) -> bool:
    """Retour arrière : la route reprend EXACTEMENT son ancienne cible, si elle est toujours la nôtre (:9080)."""
    try:
        table = lire_table()
    except ValueError as e:
        log(f"{e} — ABANDON, la route n'est pas rendue")
        return False
    if table is None or not (cible(table.get(dom)) or ("", 0))[1] == PORT:
        return False
    table[dom] = ancienne
    ecrire_atomique(ROUTES, json.dumps(table, indent=2, sort_keys=True) + "\n", 0o644)
    return True


def declarer_haproxy(dom: str) -> None:
    """Le vhost HAProxy derrière sbxwaf_inspector, s'il n'est pas déjà déclaré (sa déclaration existante gagne)."""
    try:
        with open(HAPROXY_TOML, encoding="utf-8") as fh:
            if f'"{dom}"' in fh.read():
                return
    except FileNotFoundError:
        return   # pas de frontal HAProxy sur cette box
    except OSError as e:
        log(f"{HAPROXY_TOML} illisible ({e.__class__.__name__}) : vhost HAProxy non déclaré")
        return
    try:
        executer(["haproxyctl", "vhost", "add", dom, "sbxwaf_inspector", "true"], delai=300)
        executer(["systemctl", "reload", "haproxy"], delai=60)
        audit("vhost-haproxy", "pose", f"{dom} -> sbxwaf_inspector")
    except (OSError, subprocess.SubprocessError) as e:
        log(f"vhost HAProxy de {dom} non déclaré ({e.__class__.__name__})")


# ── Verbes ───────────────────────────────────────────────────────────────────────────────────────────────────

def retirer(raison: str) -> int:
    etat = lire_etat()
    retire = retirer_conf()
    rendue = False
    if etat.get("route_reprise") and etat.get("domaine") and isinstance(etat.get("route_precedente"), list):
        rendue = rendre_route(etat["domaine"], etat["route_precedente"])
    if retire or rendue:
        audit("retirer", "fait", f"{etat.get('domaine', '?')} : {raison}" + (" ; route rendue" if rendue else ""))
    if etat:
        ecrire_etat({})
    return 0


def appliquer() -> int:
    dom = domaine()
    if not dom:
        log("domaine de la box inconnu : rien n'est posé")
        return 0
    if not accueil_voulu():
        return retirer("désactivé ([noeud] accueil = false)")
    explicites = noms_explicites(dom)
    if explicites:
        log(f"{dom} déjà servi par {', '.join(explicites)} : l'existant gagne")
        if retirer_conf():
            audit("appliquer", "conserve", f"{dom} servi par {explicites[0]}")
        return 0
    try:
        table = lire_table()
    except ValueError as e:
        log(f"{e} — ABANDON, rien n'est posé")
        return 1
    etat = lire_etat()
    if etat.get("domaine") != dom:
        etat = {}
    actuelle = table.get(dom) if table is not None else None
    port_actuel = (cible(actuelle) or ("", 0))[1]
    # Ancienne cible reprise lors d'un passage précédent : sa santé lui est relayée, le reste seulement si relais_api.
    repli = cible(etat.get("route_precedente")) if etat.get("route_reprise") else None
    route_a_poser = nouvelle = False
    if table is None:
        pass                                    # pas de sbxwaf : le vhost seul, joignable du seul nginx local
    elif actuelle is None:
        route_a_poser = nouvelle = True         # nom jamais routé : NOUVELLE exposition
    elif port_actuel != PORT:
        ancienne = cible(actuelle)
        code = sonder(*ancienne, dom) if ancienne else None
        if code != 404:
            log(f"route explicite {dom} -> {actuelle} (« / » rend {code}) : l'existant gagne")
            if retirer_conf():
                audit("appliquer", "conserve", f"{dom} -> {actuelle}")
            return 0
        repli, route_a_poser = ancienne, True   # exposition EXISTANTE dont « / » ne sert rien : reprise
        etat = {"domaine": dom, "route_reprise": True, "route_precedente": [ancienne[0], ancienne[1]]}
    bloque = nouvelle and not mot_de_passe_change()
    if bloque:
        route_a_poser = False
        audit("exposition_refusee", "refus", f"{dom} : mot de passe admin par défaut actif ou inconnu (#3401)")
        log("mot de passe admin par défaut actif ou inconnu : route et vhost HAProxy en attente (#3401)")
    relais = relais_voulu()
    avant = lire_conf()
    texte = rendre(dom, repli, os.path.isfile(FORMAT_HOTES), relais)
    if not poser_conf(texte):
        audit("appliquer", "echec", f"{dom} : nginx -t refuse le vhost, rien n'a changé")
        return 1
    if avant is not None and avant != texte:
        # Montée de 1.21.0 (#3824) : un vhost qui relayait tout est réécrit FERMÉ, sauf relais_api = true.
        audit("vhost", "regenere", f"{dom} : relais des autres chemins {'OUVERT' if relais and repli else 'fermé'}")
    if route_a_poser:
        if not poser_route(dom):
            audit("appliquer", "echec", f"{dom} : vhost posé, route sbxwaf non posée")
            return 1
        detail = f"{dom} -> :{PORT}"
        if repli is not None:
            detail += (f" (santé relayée à {repli[0]}:{repli[1]} ; autres chemins "
                       f"{'relayés' if relais else 'fermés, relais_api = false'})")
        audit("route", "reprise" if repli is not None else "pose", detail)
    if table is not None and not bloque:
        declarer_haproxy(dom)
    etat["domaine"] = dom
    ecrire_etat(etat)
    return 0


def afficher_etat() -> int:
    dom = domaine()
    try:
        table = lire_table()
    except ValueError:
        table = None
    print(json.dumps({"domaine": dom or None, "accueil": accueil_voulu(), "relais_api": relais_voulu(),
                      "vhost": os.path.isfile(CONF), "route": (table or {}).get(dom) if dom else None,
                      "etat": lire_etat()}, ensure_ascii=False, indent=2))
    return 0


# ── Relais des autres chemins (#3824) : l'option de l'administrateur ─────────────────────────────────────────

SECTION = re.compile(r"^\s*\[\s*noeud\s*\]\s*(#.*)?$")
TABLE_TOML = re.compile(r"^\s*\[")
CLE_RELAIS = re.compile(r"^\s*relais_api\s*=")


def reglage_avec_relais(texte: str, valeur: bool) -> str:
    """Le texte de webos.toml avec `[noeud] relais_api = valeur`, le reste intact (commentaires compris)."""
    ligne = f"relais_api = {'true' if valeur else 'false'}"
    lignes = texte.splitlines()
    debut = next((i for i, x in enumerate(lignes) if SECTION.match(x)), None)
    if debut is None:
        sep = "" if not texte or texte.endswith("\n\n") else ("\n" if texte.endswith("\n") else "\n\n")
        return f"{texte}{sep}[noeud]\n{ligne}\n"
    fin = next((i for i in range(debut + 1, len(lignes)) if TABLE_TOML.match(lignes[i])), len(lignes))
    cle = next((i for i in range(debut + 1, fin) if CLE_RELAIS.match(lignes[i])), None)
    if cle is None:
        lignes.insert(debut + 1, ligne)
    else:
        lignes[cle] = ligne
    return "\n".join(lignes) + "\n"


def ecrire_reglage_relais(valeur: bool) -> tuple[str, int, tuple[int, int] | None] | None:
    """Pose `relais_api` dans webos.toml, atomiquement (mode et propriétaire gardés). Rend de quoi le remettre :
    (ancien texte, "" s'il n'existait pas ; mode ; propriétaire) ; None si refus (rien n'est écrit)."""
    import tomllib
    try:
        fd = os.open(REGLAGES, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_size > (1 << 20):
                log(f"{REGLAGES} : pas un fichier ordinaire, ou trop grand — inchangé")
                return None
            avant = os.read(fd, st.st_size + 1).decode("utf-8")
        finally:
            os.close(fd)
        mode, proprio = stat.S_IMODE(st.st_mode) & 0o644, (st.st_uid, st.st_gid)
    except FileNotFoundError:
        avant, mode, proprio = "", 0o644, None
    except (OSError, UnicodeDecodeError) as e:
        log(f"{REGLAGES} illisible ({e.__class__.__name__}) — inchangé")
        return None
    try:
        ancien = tomllib.loads(avant)
        apres = reglage_avec_relais(avant, valeur)
        nouveau = tomllib.loads(apres)
    except ValueError as e:
        log(f"{REGLAGES} n'est pas un TOML valide ({e}) — inchangé, rien n'est écrit")
        return None
    # Contrôle : seule la clé voulue a changé, et elle vaut bien ce qu'on a demandé.
    attendu = dict(ancien)
    attendu["noeud"] = {**ancien.get("noeud", {}), "relais_api": valeur}
    if nouveau != attendu:
        log(f"{REGLAGES} : la réécriture changerait autre chose que relais_api — inchangé")
        return None
    if apres != avant:
        ecrire_atomique(REGLAGES, apres, mode or 0o644, proprio)
    return avant, mode or 0o644, proprio


def chemins_cible(ip: str, port: int) -> dict:
    """Les `location` d'un serveur nginx de CETTE box qui écoute sur ip:port (ce que le relais exposerait)."""
    ecoute = re.compile(r"\blisten\s+(?:(?:" + re.escape(ip) + r"|\*|0\.0\.0\.0|\[::\])\:)?" + str(port) + r"\b")
    for dossier in DOSSIERS_NGINX:
        try:
            noms = sorted(os.listdir(dossier))
        except OSError:
            continue
        for nom in noms:
            chemin = os.path.join(dossier, nom)
            if os.path.abspath(chemin) == os.path.abspath(CONF) or not os.path.isfile(chemin):
                continue
            if dossier.endswith("conf.d") and not nom.endswith(".conf"):
                continue
            try:
                with open(chemin, encoding="utf-8", errors="replace") as fh:
                    texte = "\n".join(x.split("#", 1)[0] for x in fh.read(1 << 20).splitlines())
            except OSError:
                continue
            if not ecoute.search(texte):
                continue
            vus = []
            for m in re.finditer(r"\blocation\s+(?:(?:=|\^~|~\*?)\s+)?([^\s{]+)\s*\{", texte):
                if m.group(1) not in vus:
                    vus.append(m.group(1))
            return {"source": chemin, "chemins": vus[:50]}
    return {"source": None, "chemins": []}


def etat_relais() -> dict:
    etat = lire_etat()
    dom = etat.get("domaine") if isinstance(etat.get("domaine"), str) and DOMAINE.match(etat["domaine"]) else None
    repli = cible(etat.get("route_precedente")) if etat.get("route_reprise") else None
    conf = lire_conf()
    a_nous = conf is not None and conf.startswith(ENTETE)
    voulu = relais_voulu()
    vu = chemins_cible(*repli) if repli else {"source": None, "chemins": []}
    return {
        "domaine": dom,
        "relais_api": voulu,                                       # le réglage
        "relais_actif": bool(a_nous and voulu and repli),          # ce que sert le vhost
        "vhost": a_nous,
        "cible": f"{repli[0]}:{repli[1]}" if repli else None,
        "chemins_cible": vu["chemins"],
        "source_chemins": vu["source"],
        "servis": ["/", "/_noeud/sbx-dice.js", "/_noeud/dice/", "/api/v1/health"],
        "mot_de_passe_defaut": not mot_de_passe_change(),
    }


def regenerer() -> bool:
    """Réécrit le vhost (s'il est le nôtre) selon le réglage courant ; ne touche ni la route ni HAProxy."""
    conf = lire_conf()
    if conf is None or not conf.startswith(ENTETE):
        return True                     # rien en place : le réglage vaudra au prochain `appliquer`
    etat = lire_etat()
    dom = etat.get("domaine") if isinstance(etat.get("domaine"), str) and DOMAINE.match(etat["domaine"]) else ""
    dom = dom or domaine()
    if not dom:
        return False
    repli = cible(etat.get("route_precedente")) if etat.get("route_reprise") else None
    return poser_conf(rendre(dom, repli, os.path.isfile(FORMAT_HOTES), relais_voulu()))


def relais(geste: str, acteur: str) -> int:
    """activer | desactiver : réglage écrit atomiquement, vhost régénéré (nginx -t, retour arrière), audit.
    Codes : 0 fait, 1 échec (rien n'a changé), 2 usage, 3 refus (mot de passe admin par défaut actif, #3401)."""
    acteur = acteur if ACTEUR.match(acteur or "") else "inconnu"
    valeur = geste == "activer"
    if valeur and not mot_de_passe_change():
        audit("relais_api", "refus", f"ouvrir demandé par {acteur} : mot de passe admin par défaut actif ou inconnu (#3401)")
        log("mot de passe admin par défaut actif ou inconnu : le relais reste fermé (#3401)")
        return 3
    sauve = ecrire_reglage_relais(valeur)
    if sauve is None:
        audit("relais_api", "echec", f"{geste} par {acteur} : webos.toml non modifiable, rien n'a changé")
        return 1
    if not regenerer():
        avant, mode, proprio = sauve
        try:
            if avant:
                ecrire_atomique(REGLAGES, avant, mode, proprio)
            else:
                os.unlink(REGLAGES)
        except OSError as e:
            log(f"{REGLAGES} non remis ({e.__class__.__name__})")
        audit("relais_api", "echec", f"{geste} par {acteur} : nginx -t refuse le vhost, réglage remis")
        return 1
    e = etat_relais()
    if not valeur:
        detail = f"{e['domaine'] or '?'} : relais des autres chemins FERMÉ par {acteur}"
    elif e["relais_actif"]:
        detail = f"{e['domaine']} : relais des autres chemins OUVERT vers {e['cible']} par {acteur}"
        if e["chemins_cible"]:
            detail += " (" + ", ".join(e["chemins_cible"][:8]) + ")"
    else:
        detail = (f"{e['domaine'] or '?'} : relais_api = true posé par {acteur}, rien à relayer "
                  "(pas de vhost du nœud, ou pas d'ancienne cible)")
    audit("relais_api", "ouvert" if valeur else "ferme", detail)
    return 0


# ── Demandes de l'API webos (secubox-webos-noeud.path → .service, root) ──────────────────────────────────────

def _gid_secubox() -> int:
    import grp
    try:
        return grp.getgrnam("secubox").gr_gid
    except KeyError:
        return -1


def prepare() -> int:
    """Dépôt 1770 et résultats 0750, root:secubox. Un lien ou un fichier à leur place est retiré, jamais suivi."""
    gid = -1 if R else _gid_secubox()
    for chemin, mode in ((DEMANDES, 0o1770), (RESULTATS, 0o750)):
        try:
            st = os.lstat(chemin)
            if not stat.S_ISDIR(st.st_mode):
                os.unlink(chemin)
                raise FileNotFoundError
            if not R and st.st_uid != 0:
                log(f"{chemin} n'appartient pas à root : refusé")
                return 1
        except FileNotFoundError:
            os.mkdir(chemin, 0o700)
        if not R:
            os.chown(chemin, 0, gid, follow_symlinks=False)
        os.chmod(chemin, mode)
    return 0


def lire_demande(dfd: int, nom: str) -> dict | None:
    """Une lecture par descripteur relatif au dépôt : sans suivre de lien, non bloquante, fichier ordinaire, 512 o."""
    try:
        fd = os.open(nom, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > TAILLE_DEMANDE:
            return None
        d = json.loads(os.read(fd, TAILLE_DEMANDE + 1))
    except (OSError, ValueError):
        return None
    finally:
        os.close(fd)
    if not isinstance(d, dict) or d.get("geste") not in ("etat", "activer", "desactiver"):
        return None
    acteur = d.get("acteur", "")
    if not isinstance(acteur, str) or (acteur and not ACTEUR.match(acteur)):
        return None
    return {"geste": d["geste"], "acteur": acteur or "inconnu"}


def ecrire_resultat(ident: str, corps: dict) -> None:
    fd, tmp = tempfile.mkstemp(dir=RESULTATS, prefix=".r.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(corps, fh, ensure_ascii=False)
        os.chmod(tmp, 0o640)
        if not R:
            os.chown(tmp, 0, _gid_secubox())
        os.replace(tmp, os.path.join(RESULTATS, ident + ".json"))
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def traite() -> int:
    """Chaque `<id>.demande` = {"geste": etat|activer|desactiver, "acteur": ...} ; résultat `<id>.json` =
    {"code": int, "etat": {...}}. Les « .tmp.* » de l'API (en cours d'écriture) sont laissés ; tout autre nom est retiré."""
    if prepare() != 0:
        return 1
    maintenant = datetime.now(timezone.utc).timestamp()
    for nom in os.listdir(RESULTATS):                       # résultats non relus : purgés après 5 min
        try:
            if maintenant - os.lstat(os.path.join(RESULTATS, nom)).st_mtime > 300:
                os.unlink(os.path.join(RESULTATS, nom))
        except OSError:
            continue
    dfd = os.open(DEMANDES, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for nom in sorted(os.listdir(dfd))[:32]:
            if nom.startswith(".tmp."):
                # écriture de l'API en cours ; abandonnée depuis plus d'une minute, elle relancerait l'unité sans fin
                try:
                    if maintenant - os.stat(nom, dir_fd=dfd, follow_symlinks=False).st_mtime > 60:
                        os.unlink(nom, dir_fd=dfd)
                except OSError:
                    pass
                continue
            if not NOM_DEMANDE.match(nom):
                os.unlink(nom, dir_fd=dfd)
                continue
            demande = lire_demande(dfd, nom)
            os.unlink(nom, dir_fd=dfd)
            if demande is None:
                ecrire_resultat(nom[:16], {"code": 2, "detail": "demande illisible (lien, FIFO, trop grande, JSON)"})
                continue
            code = 0 if demande["geste"] == "etat" else relais(demande["geste"], demande["acteur"])
            ecrire_resultat(nom[:16], {"code": code, "etat": etat_relais()})
    finally:
        os.close(dfd)
    return 0


USAGE = "usage: webos-noeud appliquer|retirer|etat|prepare|traite | relais activer|desactiver [acteur] | relais etat"


def main(argv: list[str]) -> int:
    verbe = argv[1] if len(argv) > 1 else ""
    if verbe == "relais":
        geste = argv[2] if len(argv) > 2 else ""
        if geste == "etat" and len(argv) == 3:
            print(json.dumps(etat_relais(), ensure_ascii=False, indent=2))
            return 0
        if geste in ("activer", "desactiver") and len(argv) in (3, 4):
            if os.geteuid() != 0 and not R:
                print(f"{MODULE}: root requis", file=sys.stderr)
                return 1
            acteur = argv[3] if len(argv) == 4 else (os.environ.get("SUDO_USER") or "root")
            return relais(geste, acteur)
        print(USAGE, file=sys.stderr)
        return 2
    if len(argv) != 2 or verbe not in ("appliquer", "retirer", "etat", "prepare", "traite"):
        print(USAGE, file=sys.stderr)
        return 2
    if os.geteuid() != 0 and not R and verbe != "etat":
        print(f"{MODULE}: root requis", file=sys.stderr)
        return 1
    if verbe == "etat":
        return afficher_etat()
    if verbe == "retirer":
        return retirer("paquet retiré")
    if verbe == "prepare":
        return prepare()
    if verbe == "traite":
        return traite()
    return appliquer()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
