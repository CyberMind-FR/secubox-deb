[Unit]
Description=SecuBox WireGuard API
After=network.target secubox-core.service
Requires=secubox-core.service

[Service]
UMask=0000
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/wireguard
ExecStart=/usr/bin/python3 -m uvicorn api.main:app \
    --uds /run/secubox/wireguard.sock \
    --log-level warning
Restart=on-failure
RestartSec=5

# API runs as `secubox` but reads live WireGuard state via `sudo -n wgctl`
# (wg show all dump needs root for private keys); NoNewPrivileges must be off
# so sudo can elevate. Elevation is constrained to the wgctl allow-list in
# /etc/sudoers.d/secubox-wireguard.
NoNewPrivileges=false
RuntimeDirectory=secubox
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0775

ReadWritePaths=/run/secubox /var/lib/secubox /etc/wireguard /var/log/secubox

[Install]
WantedBy=multi-user.target
