#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	# Create directories
	install -d $(CURDIR)/debian/secubox-yggdrasil/usr/lib/secubox/mesh/api
	install -d $(CURDIR)/debian/secubox-yggdrasil/usr/share/secubox/www/mesh
	install -d $(CURDIR)/debian/secubox-yggdrasil/etc/nginx/secubox.d
	install -d $(CURDIR)/debian/secubox-yggdrasil/usr/share/secubox/menu.d
	install -d $(CURDIR)/debian/secubox-yggdrasil/etc/secubox

	# Install API
	install -m 644 api/__init__.py $(CURDIR)/debian/secubox-yggdrasil/usr/lib/secubox/mesh/api/
	install -m 644 api/main.py $(CURDIR)/debian/secubox-yggdrasil/usr/lib/secubox/mesh/api/

	# Install web frontend
	cp -r www/mesh/* $(CURDIR)/debian/secubox-yggdrasil/usr/share/secubox/www/mesh/

	# Install nginx config
	install -m 644 nginx/mesh.conf $(CURDIR)/debian/secubox-yggdrasil/etc/nginx/secubox.d/
	# Route AUSSI installee dans secubox-routes.d/ : c est le seul repertoire
	# que le vhost principal inclut (#989). Livree dans secubox.d/ uniquement,
	# elle n etait jamais lue.
	install -d $(CURDIR)/debian/secubox-yggdrasil/etc/nginx/secubox-routes.d
	install -m 644 nginx/mesh.conf $(CURDIR)/debian/secubox-yggdrasil/etc/nginx/secubox-routes.d/mesh.conf

	# Install menu entry
	install -m 644 menu.d/580-mesh.json $(CURDIR)/debian/secubox-yggdrasil/usr/share/secubox/menu.d/

override_dh_installsystemd:
	dh_installsystemd --name=secubox-yggdrasil
