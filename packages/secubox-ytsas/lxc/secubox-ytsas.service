[Unit]
Description=SecuBox YouTube SAS (yt-dlp fetch + FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/secubox-ytsas/app
EnvironmentFile=-/opt/secubox-ytsas/ytsas.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
