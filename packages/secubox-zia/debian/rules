#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -d debian/secubox-zia/usr/share/secubox/zia/
	cp -r api debian/secubox-zia/usr/share/secubox/zia/
	install -d debian/secubox-zia/usr/share/secubox/www
	[ -d www ] && cp -r www/. debian/secubox-zia/usr/share/secubox/www/ || true
	install -d debian/secubox-zia/usr/share/secubox/menu.d
	[ -d menu.d ] && cp -r menu.d/. debian/secubox-zia/usr/share/secubox/menu.d/ || true
	[ -f conf/zia.toml ] && cp conf/zia.toml debian/secubox-zia/usr/share/secubox/zia/ || true
	install -d debian/secubox-zia/etc/nginx/secubox-routes.d
	install -d debian/secubox-zia/etc/nginx/secubox.d
	[ -f nginx/zia.conf ] && cp nginx/zia.conf debian/secubox-zia/etc/nginx/secubox-routes.d/ || true
	[ -f nginx/zia.conf ] && cp nginx/zia.conf debian/secubox-zia/etc/nginx/secubox.d/ || true
	install -d debian/secubox-zia/usr/lib/systemd/system
	cp systemd/secubox-zia.service debian/secubox-zia/usr/lib/systemd/system/
	# P0 (matériel) : unité llama-server (ne démarre que si binaire+modèle présents).
	[ -f systemd/secubox-zia-llm.service ] && cp systemd/secubox-zia-llm.service debian/secubox-zia/usr/lib/systemd/system/ || true
	# Outils P0 : bench + installateur (llama.cpp ARM64 + GGUF), à lancer sur la MOCHAbin.
	install -d debian/secubox-zia/usr/sbin
	[ -d sbin ] && install -m0755 sbin/* debian/secubox-zia/usr/sbin/ || true

override_dh_installsystemd:
	true
