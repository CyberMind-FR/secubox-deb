#!/usr/bin/env bash
# SPDX-License-Identifier: LicenseRef-CMSD-1.0
# Copyright (c) 2026 CyberMind — Gérald Kerma <devel@cybermind.fr>
# secubox-zia-p0-install — installe llama.cpp (ARM64) + un GGUF ultra-lite,
# branche llama-server et pointe ZIA dessus. A LANCER SUR LA MOCHAbin.
#
# Prudence RAM : sur une box chargee, ~1 Go dispo -> UNIQUEMENT un ultra-lite
# (~0.5-1B Q4). Le service llama a MemoryMax=1400M pour proteger le parc.
set -euo pipefail
DEST=/data/zia; MODELS=/data/models
MODEL_URL="${MODEL_URL:-}"     # obligatoire : URL d'un .gguf ultra-lite Q4
PORT="${ZIA_PORT:-8091}"; THREADS="${ZIA_THREADS:-$(nproc)}"; CTX="${ZIA_CTX:-2048}"

[ "$(id -u)" = 0 ] || { echo "root requis"; exit 1; }
[ -n "$MODEL_URL" ] || { echo "MODEL_URL=<url .gguf ultra-lite Q4> requis (ex. Qwen2.5-0.5B-Instruct Q4_K_M)"; exit 1; }
AVAIL=$(free -m | awk '/Mem:/{print $7}')
echo "🦊 P0 install — RAM dispo: ${AVAIL}Mi (ultra-lite conseille si < 1500)"
mkdir -p "$DEST" "$MODELS"; chown -R secubox:secubox "$DEST" "$MODELS"

if [ ! -x "$DEST/llama-server" ]; then
  echo "── build llama.cpp (ARM64) ──"
  apt-get install -y --no-install-recommends build-essential cmake git libcurl4-openssl-dev >/dev/null
  T=$(mktemp -d); git clone --depth 1 https://github.com/ggml-org/llama.cpp "$T/llama.cpp"
  cmake -S "$T/llama.cpp" -B "$T/build" -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=ON >/dev/null
  # Parallelisme BORNE (defaut 2) : sur une box a ~1 Go dispo, -j4 peut faire
  # deborder la RAM pendant la compilation. Regler via ZIA_BUILD_JOBS.
  cmake --build "$T/build" -j"${ZIA_BUILD_JOBS:-2}" --target llama-server llama-cli >/dev/null
  install -m0755 "$T/build/bin/llama-server" "$T/build/bin/llama-cli" "$DEST/"
  rm -rf "$T"
fi

if ! ls "$MODELS"/*.gguf >/dev/null 2>&1; then
  echo "── telechargement du modele ──"
  curl -fL "$MODEL_URL" -o "$MODELS/model.gguf"
  chown secubox:secubox "$MODELS/model.gguf"
fi

cat > /etc/secubox/zia-llm.env <<ENV
ZIA_MODEL=$(ls -1 "$MODELS"/*.gguf | head -1)
ZIA_THREADS=$THREADS
ZIA_CTX=$CTX
ZIA_PORT=$PORT
ENV

echo "── benchmark ──"; LLAMA="$DEST/llama-cli" secubox-zia-bench || true
echo "── demarrage llama-server ──"; systemctl daemon-reload; systemctl enable --now secubox-zia-llm.service
sleep 4
# On pointe ZIA sur le serveur local et on redemarre.
sed -i 's#^llm_url = .*#llm_url = "http://127.0.0.1:'"$PORT"'"#' /etc/secubox/zia.toml || echo "llm_url = \"http://127.0.0.1:$PORT\"" >> /etc/secubox/zia.toml
sed -i 's#^model_name = .*#model_name = "GGUF local"#' /etc/secubox/zia.toml || true
systemctl restart secubox-zia
echo "✅ P0 en place. Verifier : curl --unix-socket /run/secubox/zia.sock http://x/api/v1/zia/health"
