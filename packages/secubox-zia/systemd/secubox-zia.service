[Unit]
Description=SecuBox ZIA — local AI, interface to the Hall object bus [#1245]
After=network.target secubox-runtime.service
Requires=secubox-runtime.service
Documentation=https://github.com/CyberMind-FR/secubox-deb/issues/1245

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/share/secubox/zia
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONUNBUFFERED=1"

# /run/secubox est PARTAGE et colle (1777) : on n'y delie que ce qu'on possede.
# Le prefixe `+` execute en root malgre User=.
ExecStartPre=+/bin/rm -f /run/secubox/zia.sock
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/zia.sock --workers 1 --log-level warning
# nginx (www-data, groupe secubox) doit joindre la socket.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 150); do [ -S /run/secubox/zia.sock ] && break; sleep 0.1; done; chmod 660 /run/secubox/zia.sock'
Restart=on-failure
RestartSec=5

# Hardening. ZIA lit d'autres sockets du bus (/run/secubox) et son etat ; pas de
# reseau au P1 (le remote, plus tard, sera soumis a politique).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/secubox /var/lib/secubox /var/log/secubox

[Install]
WantedBy=multi-user.target
