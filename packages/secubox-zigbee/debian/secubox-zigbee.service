[Unit]
Description=SecuBox Zigbee — host control plane API
Documentation=file:///usr/share/doc/secubox-zigbee/README
After=network.target secubox-core.service secubox-mqtt.service
Wants=secubox-core.service

# /run/secubox N'EST PAS UN RuntimeDirectory (#1022).
#
# Il est PARTAGE par une centaine de modules. `RuntimeDirectory=` est concu pour
# un repertoire PROPRE a un service : systemd le recree a chaque demarrage avec
# le mode de l'unite, donc le dernier service demarre imposait le sien. Huit
# unites le posaient en 0755, ce qui privait tous les autres du droit d'y creer
# leur socket — « bind: permission denied », et un 502 dont la cause etait le
# redemarrage d'un module sans rapport, survenu entre-temps.
#
# Le meme mecanisme effacait le repertoire a l'arret d'un service, emportant les
# sockets des quatre-vingt-dix autres.
#
# Il est desormais declare une seule fois, en 1777, par le tmpfiles.d de
# secubox-core — un seul proprietaire, une seule verite.
[Service]
UMask=0007
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/zigbee
ExecStartPre=+/bin/mkdir -p /etc/secubox
ExecStartPre=+/bin/chown secubox:secubox /etc/secubox
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/zigbee.sock --log-level warning
Restart=on-failure
RestartSec=5
# v2.6.0: NoNewPrivileges relaxed — the FastAPI invokes `sudo -n
# /usr/sbin/zigbee-backup` (NOPASSWD-gated per /etc/sudoers.d/
# secubox-zigbee) to trigger host-side state snapshots. With
# NoNewPrivileges=true, sudo refuses to escalate (PR_SET_NO_NEW_PRIVS
# kernel flag). The attack surface stays gated by nginx + Authelia
# SSO at the front end, the sudoers grant is whitelisted to two
# specific scripts, and ProtectSystem + ReadWritePaths still apply
# to the python process itself.
NoNewPrivileges=false
LogsDirectory=secubox
LogsDirectoryMode=0755
ReadWritePaths=/run/secubox /var/lib/secubox /etc/secubox /var/log/secubox

[Install]
WantedBy=multi-user.target
