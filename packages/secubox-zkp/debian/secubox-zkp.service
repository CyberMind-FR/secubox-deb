[Unit]
Description=SecuBox ZKP API Service
After=network.target
Wants=secubox-core.service

[Service]
Type=simple
User=secubox
Group=secubox
WorkingDirectory=/usr/lib/secubox/zkp
RuntimeDirectory=secubox
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --uds /run/secubox/zkp.sock
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes

ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/secubox /var/lib/secubox/zkp

[Install]
WantedBy=multi-user.target
