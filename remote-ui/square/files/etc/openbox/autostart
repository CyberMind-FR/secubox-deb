# /etc/openbox/autostart — runs after openbox starts
# Disable screen blanking + DPMS so the kiosk stays awake
xset s off -dpms s noblank

# Hide cursor when idle, but keep visible on mouse/touchpad/touchscreen events
unclutter -idle 99999 -root &

# Chromium and right-panel services bring up their windows; Openbox places them per rc.xml
