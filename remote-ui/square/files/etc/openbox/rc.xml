<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Clearlooks</name>
  </theme>
  <applications>
    <!-- Chromium app window: pin to (0,0,480,480). Chromium reports two
         WM_CLASS strings: "chromium" and "Chromium" (capitalised). Openbox
         matches on the second one. NOTE: must NOT use --kiosk in the
         systemd unit's chromium command — kiosk overrides window-size and
         forces fullscreen, covering the right panel. -->
    <application class="Chromium">
      <decor>no</decor>
      <position force="yes"><x>0</x><y>0</y></position>
      <size><width>480</width><height>480</height></size>
      <fullscreen>no</fullscreen>
      <maximized>no</maximized>
    </application>
    <!-- Right panel: pin to (480,0,320,480), layer above so a chromium
         focus-grab doesn't cover it. Class is "app.py" (Qt sets class
         from script name); we match by WM_NAME instead. -->
    <application name="SecuBox Eye Square">
      <decor>no</decor>
      <position force="yes"><x>480</x><y>0</y></position>
      <size><width>320</width><height>480</height></size>
      <fullscreen>no</fullscreen>
      <maximized>no</maximized>
      <layer>above</layer>
    </application>
  </applications>
</openbox_config>
