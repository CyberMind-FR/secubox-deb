# Redonne à gpg-agent la phrase de passe de la clé de signature du dépôt apt.
#
# POURQUOI. reprepro signe les index (SignWith: default). La clé est protégée par une
# phrase de passe que gpg-agent garde en mémoire ; un redémarrage de la machine la perd,
# et reprepro échoue alors avec « Pinentry: Inappropriate ioctl for device » — sans
# invite possible, puisqu'il tourne en non interactif.
#
# La phrase est lue dans /etc/secubox/secrets/apt-gpg-passphrase (0600, root), créé PAR
# LE PROPRIÉTAIRE. Aucun agent ni aucun paquet ne la fabrique ni ne la lit en clair
# ailleurs ; ce script l'envoie à gpg-agent par l'entrée standard, jamais en argument.
set -euo pipefail

KEYGRIP="CFE714A3A5CAF30BA69EECDD81124F01E4FFF098"      # clé du dépôt 44E50F0178E8BC7E
KEYID="44E50F0178E8BC7E"
PASS="/etc/secubox/secrets/apt-gpg-passphrase"
PRESET="/usr/lib/gnupg/gpg-preset-passphrase"

[ -f "$PASS" ] || { echo "secubox-apt-gpg-preset : $PASS absent (voir docs/DEPOT-APT-SIGNATURE.md)" >&2; exit 1; }
perm="$(stat -c %a "$PASS")"; owner="$(stat -c %U "$PASS")"
[ "$perm" = "600" ] && [ "$owner" = "root" ] || { echo "secubox-apt-gpg-preset : $PASS doit être 0600 root (actuel : $perm $owner)" >&2; exit 1; }

gpgconf --launch gpg-agent
"$PRESET" --preset "$KEYGRIP" < "$PASS"

# Vérification : signer un message vide sans aucune invite. Échoue si la phrase est fausse.
echo "test" | gpg --batch --yes --pinentry-mode error --local-user "$KEYID" --clearsign >/dev/null 2>&1 \
  || { echo "secubox-apt-gpg-preset : la phrase de passe a été présentée mais la signature échoue (phrase erronée ?)" >&2; exit 1; }
echo "secubox-apt-gpg-preset : clé $KEYID déverrouillée, signature vérifiée"
